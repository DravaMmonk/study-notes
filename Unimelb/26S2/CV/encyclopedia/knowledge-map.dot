digraph Course {
graph [rankdir=LR, bgcolor="white", pad=0.4, nodesep=0.24, ranksep=0.55];
node [shape=box, style="rounded,filled", fontname="PingFang SC", fontsize=13, color="#a5afba", margin="0.12,0.09"];
edge [color="#8795a1", arrowsize=0.6];
"attention" [label="Query、Key、Value 与\n自注意力",fillcolor="#ece5f2"];
"autoencoder" [label="自编码器与瓶颈",fillcolor="#f2e2e5"];
"box-regression" [label="边界框回归",fillcolor="#e7e8ec"];
"calibration" [label="相机内参、外参与标定",fillcolor="#f5e9d7"];
"channels" [label="多通道卷积与参数共享",fillcolor="#ece5f2"];
"convolution" [label="卷积与互相关",fillcolor="#e1eaf5"];
"detection-matching" [label="检测评估的一对一匹配",fillcolor="#e7e8ec"];
"detr" [label="DETR、对象查询与集合预测",fillcolor="#e7e8ec"];
"disparity" [label="校正双目的视差与深度",fillcolor="#f5e9d7"];
"encoder-decoder" [label="编码解码与空间分辨率",fillcolor="#dfeeee"];
"epipolar" [label="极平面、极点与极线",fillcolor="#f5e9d7"];
"fcn" [label="逐像素分类与全卷积网络",fillcolor="#dfeeee"];
"forward-diffusion" [label="前向扩散与累计信号",fillcolor="#f2e2e5"];
"fourier" [label="二维频谱与傅里叶变换",fillcolor="#e1eaf5"];
"frequency-filter" [label="卷积定理与频率滤波",fillcolor="#e1eaf5"];
"fundamental" [label="本质矩阵与基础矩阵",fillcolor="#f5e9d7"];
"gaussian-noise" [label="高斯噪声与方差相加",fillcolor="#f2e2e5"];
"gradient" [label="偏导数、梯度与边缘",fillcolor="#e1eaf5"];
"harris" [label="结构张量与 Harris 角点",fillcolor="#f5e9d7"];
"homogeneous" [label="齐次点、直线与叉积",fillcolor="#f5e9d7"];
"homography" [label="平面单应变换",fillcolor="#f5e9d7"];
"iou" [label="交并比 IoU",fillcolor="#e7e8ec"];
"keypoint" [label="关键点、检测器与描述子",fillcolor="#f5e9d7"];
"latent-diffusion" [label="潜空间扩散",fillcolor="#f2e2e5"];
"map" [label="AP、mAP 与评价协议",fillcolor="#e7e8ec"];
"nms" [label="非极大值抑制 NMS",fillcolor="#e7e8ec"];
"noise-prediction" [label="时间条件与噪声预测训练",fillcolor="#f2e2e5"];
"outlier" [label="噪声、外点与几何一致性",fillcolor="#f5e9d7"];
"patches" [label="归纳偏置与图块 token",fillcolor="#ece5f2"];
"pixels" [label="像素、坐标与通道",fillcolor="#e0eee9"];
"pooling" [label="最大池化与平均池化",fillcolor="#ece5f2"];
"precision-recall" [label="精确率、召回率与 P–R 曲线",fillcolor="#e7e8ec"];
"probability" [label="概率密度与条件生成",fillcolor="#f2e2e5"];
"projection" [label="针孔投影与深度歧义",fillcolor="#e0eee9"];
"proposals" [label="候选区域与\n Selective Search",fillcolor="#e7e8ec"];
"rag" [label="区域邻接图与合并",fillcolor="#dfeeee"];
"ransac" [label="RANSAC 与采样次数",fillcolor="#f5e9d7"];
"rcnn" [label="R-CNN 的区域分类与训练",fillcolor="#e7e8ec"];
"residual" [label="残差连接",fillcolor="#ece5f2"];
"reverse-diffusion" [label="反向生成与采样器边界",fillcolor="#f2e2e5"];
"roi-pooling" [label="共享特征与\n RoI pooling",fillcolor="#e7e8ec"];
"rpn" [label="Faster R-CNN、锚框与\n RPN",fillcolor="#e7e8ec"];
"sam" [label="SAM 的提示与候选掩码",fillcolor="#dfeeee"];
"segmentation" [label="区域、语义与实例分割",fillcolor="#dfeeee"];
"set-matching" [label="集合匹配损失",fillcolor="#e7e8ec"];
"sift" [label="SIFT 描述与尺度方向对齐",fillcolor="#f5e9d7"];
"sinusoid" [label="频率、幅度与相位",fillcolor="#e1eaf5"];
"superpixels" [label="超像素与过分割",fillcolor="#dfeeee"];
"transpose-conv" [label="转置卷积与重叠求和",fillcolor="#dfeeee"];
"unet" [label="U-Net 的跨尺度特征拼接",fillcolor="#dfeeee"];
"unpooling" [label="最大反池化",fillcolor="#dfeeee"];
"weighted-sum" [label="像素算子与局部加权和",fillcolor="#e1eaf5"];
"pixels" -> "projection";
"pixels" -> "weighted-sum";
"weighted-sum" -> "gradient";
"weighted-sum" -> "convolution";
"convolution" -> "channels";
"sinusoid" -> "fourier";
"fourier" -> "frequency-filter";
"channels" -> "pooling";
"channels" -> "residual";
"patches" -> "attention";
"gradient" -> "keypoint";
"keypoint" -> "harris";
"keypoint" -> "sift";
"sift" -> "outlier";
"outlier" -> "ransac";
"ransac" -> "homography";
"projection" -> "disparity";
"homogeneous" -> "calibration";
"calibration" -> "epipolar";
"epipolar" -> "fundamental";
"probability" -> "gaussian-noise";
"gaussian-noise" -> "forward-diffusion";
"forward-diffusion" -> "noise-prediction";
"noise-prediction" -> "reverse-diffusion";
"autoencoder" -> "latent-diffusion";
"reverse-diffusion" -> "latent-diffusion";
"segmentation" -> "superpixels";
"superpixels" -> "rag";
"rag" -> "proposals";
"channels" -> "fcn";
"pooling" -> "unpooling";
"fcn" -> "encoder-decoder";
"encoder-decoder" -> "transpose-conv";
"transpose-conv" -> "unet";
"attention" -> "sam";
"proposals" -> "box-regression";
"box-regression" -> "rcnn";
"rcnn" -> "roi-pooling";
"roi-pooling" -> "rpn";
"iou" -> "nms";
"attention" -> "detr";
"detr" -> "set-matching";
"detection-matching" -> "precision-recall";
"precision-recall" -> "map";
}
