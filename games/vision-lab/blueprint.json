                "zh": "交换图像的红色与蓝色通道，保留绿色。输入 r、g、b 是对应的通道编号。",
                "en": "Exchange red and blue channels while retaining green. Inputs r, g, b identify the channels."
              },
              "role": "foundation",
              "uses": ["pixels", "channelidea", "composeidea", "channel", "compose"],
              "adds": ["compose"],
              "teaches": "composeidea"
            },
            {
              "id": "1C5",
              "title": { "zh": "交换颜色通道", "en": "Reorder colour channels" },
