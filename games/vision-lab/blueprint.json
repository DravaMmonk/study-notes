{
  "topic": { "zh": "计算机视觉", "en": "Computer vision" },
  "learner": { "zh": "没有计算机视觉基础的学习者", "en": "Learners new to computer vision" },
  "endpoint": {
    "zh": "构造并检验处理、识别、测量和生成图像的视觉系统。",
    "en": "Build and test systems that process, recognise, measure and generate images."
  },
  "scope": {
    "zh": "先制作第 0、1 章：视觉任务、数字图像和基础成像。",
    "en": "Chapters 0 and 1: visual tasks, digital images and basic image formation."
  },
  "sources": [
    "docs/Unimelb/26S2/CV/vision-game-specs/chapters-0-1.md",
    "docs/Unimelb/26S2/CV/lecture/COMP90086-01-Introduction.pdf",
    "docs/Unimelb/26S2/CV/lecture/COMP90086-02-Basics.pdf"
  ],
  "mechanisms": [
    {
      "id": "table",
      "where": { "zh": "视觉任务和像素", "en": "Visual tasks and pixels" },
      "why": { "zh": "填写并比较结构化答案。", "en": "Enter and compare structured answers." }
    },
    {
      "id": "circuit",
      "where": { "zh": "图像操作", "en": "Image operations" },
      "why": { "zh": "从低层操作搭出可复用流程。", "en": "Build reusable flows from lower-level operations." }
    },
    {
      "id": "bench",
      "where": { "zh": "成像", "en": "Image formation" },
      "why": { "zh": "通过改变参数探索成像。", "en": "Explore image formation by changing parameters." }
    }
  ],
  "abilities": [
    { "id": "query", "about": { "zh": "任务与答案", "en": "Tasks and answers" } },
    { "id": "scene", "about": { "zh": "控制场景", "en": "Controlled scenes" } },
    { "id": "pixels", "about": { "zh": "读取图像", "en": "Inspect images" } },
    { "id": "circuit", "about": { "zh": "搭建图像流程", "en": "Build image flows" } },
    { "id": "optics", "about": { "zh": "光学实验", "en": "Optical experiments" } }
  ],
  "machines": [
    {
      "id": "station",
      "title": { "zh": "视觉测试台", "en": "Visual test station" },
      "can": ["query", "scene"],
      "lacks": { "zh": "还不能构建图像处理流程。", "en": "Cannot yet build image-processing flows." }
    },
    {
      "id": "camera",
      "title": { "zh": "相机与图像工作台", "en": "Camera and image workbench" },
      "can": ["query", "scene", "pixels", "circuit", "optics"],
      "lacks": { "zh": "还不能利用邻域做滤波或学习。", "en": "Cannot yet perform neighbourhood filtering or learning." }
    }
  ],
  "primitives": [
    {
      "part": "lookup",
      "about": { "zh": "读取像素", "en": "Pixel lookup" },
      "why": { "zh": "取样是图像工作台读取图像的基本能力。", "en": "Reading a pixel is a primitive image-workbench capability." }
    },
    {
      "part": "channel",
      "about": { "zh": "选择通道", "en": "Select a channel" },
      "why": {
        "zh": "单通道数值运算无法拆开彩色图的表示。",
        "en": "Arithmetic on scalar planes does not decompose an RGB value."
      }
    },
    {
      "part": "compose",
      "about": { "zh": "合成通道", "en": "Compose channels" },
      "why": { "zh": "数值运算无法从三张灰度图构造彩色图类型。", "en": "Arithmetic cannot form a colour image from three planes." }
    },
    {
      "part": "grid",
      "about": { "zh": "生成坐标", "en": "Generate coordinates" },
      "why": { "zh": "必须由工作台提供每个输出位置。", "en": "Output positions must be provided by the workbench." }
    },
    {
      "part": "const",
      "about": { "zh": "常数", "en": "Constant" },
      "why": {
        "zh": "无输入时不能仅由运算产生固定数值。",
        "en": "A fixed number cannot be made from operations with no inputs."
      }
    },
    {
      "part": "add",
      "about": { "zh": "相加", "en": "Add" },
      "why": { "zh": "这是数值计算的基础运算。", "en": "Addition is a basic numeric operation." }
    },
    {
      "part": "sub",
      "about": { "zh": "相减", "en": "Subtract" },
      "why": { "zh": "需要从已有数值求差。", "en": "A primitive operation is needed to form differences." }
    },
    {
      "part": "size",
      "about": { "zh": "图像尺寸", "en": "Image size" },
      "why": { "zh": "仅靠像素数值无法得到输入宽高。", "en": "Pixel values alone do not expose the image dimensions." }
    },
    {
      "part": "less",
      "about": { "zh": "比较", "en": "Compare" },
      "why": { "zh": "数值计算需要基础的顺序比较。", "en": "A basic ordering comparison is needed." }
    },
    {
      "part": "select",
      "about": { "zh": "选择数值", "en": "Select a value" },
      "why": { "zh": "比较结果必须能控制输出。", "en": "A comparison must be able to control the output." }
    },
    {
      "part": "mul",
      "about": { "zh": "相乘", "en": "Multiply" },
      "why": { "zh": "缩放坐标需要乘法。", "en": "Coordinate scaling needs multiplication." }
    },
    {
      "part": "div",
      "about": { "zh": "相除", "en": "Divide" },
      "why": { "zh": "缩放坐标需要除法。", "en": "Coordinate scaling needs division." }
    },
    {
      "part": "floor",
      "about": { "zh": "向下取整", "en": "Floor" },
      "why": { "zh": "连续位置转为索引需要基本取整。", "en": "Continuous coordinates need a basic integer conversion." }
    }
  ],
  "built": [
    { "part": "crop", "about": { "zh": "裁剪", "en": "Crop" }, "from": ["grid", "add", "lookup"] },
    {
      "part": "translate",
      "about": { "zh": "平移", "en": "Translate" },
      "from": ["size", "grid", "sub", "lookup"]
    },
    {
      "part": "resizeNearest",
      "about": { "zh": "最近邻缩放", "en": "Nearest resize" },
      "from": ["const", "size", "grid", "sampleAxis", "add", "floor", "lookup"]
    },
    {
      "part": "resizeLinear",
      "about": { "zh": "双线性缩放", "en": "Bilinear resize" },
      "from": ["const", "size", "grid", "sampleAxis", "floor", "sub", "add", "lookup", "mul"]
    },
    {
      "part": "quantise",
      "about": { "zh": "量化器", "en": "Quantiser" },
      "from": ["const", "larger", "smaller", "sub", "mul", "add", "floor", "div"]
    },
    { "part": "larger", "about": { "zh": "较大值", "en": "Larger value" }, "from": ["less", "select"] },
    { "part": "smaller", "about": { "zh": "较小值", "en": "Smaller value" }, "from": ["less", "select"] },
    {
      "part": "sampleAxis",
      "about": { "zh": "采样坐标", "en": "Sampling coordinates" },
      "from": ["const", "sub", "less", "larger", "div", "mul", "select"]
    }
  ],
  "eras": [
    {
      "id": 0,
      "machine": "station",
      "title": { "zh": "让机器看见问题", "en": "What is the question?" },
      "question": { "zh": "机器要回答什么？", "en": "What must the machine answer?" },
      "why": { "zh": "从视觉问题与证据开始。", "en": "Start with visual questions and evidence." },
      "series": [
        {
          "id": "task_output",
          "title": { "zh": "输出规格", "en": "Output specifications" },
          "kind": "foundation",
          "slots": [
            {
              "id": "0A1",
              "title": { "zh": "一张图，不同的问题", "en": "One picture, different questions" },
              "task": {
                "zh": "每题选出刚好包含所需信息的输出。",
                "en": "For each question choose the output containing just the required information."
              },
              "role": "foundation",
              "uses": ["query", "outputs"],
              "teaches": "outputs"
            },
            {
              "id": "0A2",
              "title": { "zh": "类别之外", "en": "Beyond the class" },
              "task": {
                "zh": "每题选择刚好包含所需信息的输出。",
                "en": "For each question choose the output containing just the required information."
              },
              "role": "practice",
              "uses": ["query", "outputs"]
            },
            {
              "id": "0A3",
              "title": { "zh": "区域和物体", "en": "Regions and objects" },
              "task": {
                "zh": "每题选出刚好满足要求的输出图。",
                "en": "For each question choose the output map with just the required information."
              },
              "role": "practice",
              "uses": ["query", "outputs"],
              "dimension": "depth"
            },
            {
              "id": "0A4",
              "title": { "zh": "一份输出能回答什么", "en": "What an output can answer" },
              "task": {
                "zh": "每题至少选择一种足以回答问题的输出。",
                "en": "For each question choose at least one output sufficient to answer it."
              },
              "role": "practice",
              "uses": ["query", "outputs"],
              "dimension": "combine"
            }
          ]
        },
        {
          "id": "variation",
          "title": { "zh": "外观变化", "en": "Changes in appearance" },
          "kind": "foundation",
          "slots": [
            {
              "id": "0B1",
              "title": { "zh": "换个角度", "en": "A different view" },
              "task": { "zh": "选出所有只改变相机的候选。", "en": "Select every candidate that changes only the camera." },
              "role": "foundation",
              "uses": ["scene", "viewpoint"],
              "teaches": "viewpoint"
            },
            {
              "id": "0B2",
              "title": { "zh": "换一盏光", "en": "Change the light" },
              "task": { "zh": "选出所有只改变光照的候选。", "en": "Select every candidate that changes only the lighting." },
              "role": "practice",
              "uses": ["scene", "viewpoint"]
            },
            {
              "id": "0B3",
              "title": { "zh": "屏幕后面", "en": "Behind the screen" },
              "task": { "zh": "根据给出的候选场景判断每句话。", "en": "Judge each claim against the candidate scenes." },
              "role": "practice",
              "uses": ["scene", "viewpoint"],
              "dimension": "depth"
            },
            {
              "id": "0B4",
              "title": { "zh": "设计测试", "en": "Choose a test set" },
              "task": { "zh": "选择能覆盖所有指定变化的图片。", "en": "Choose images covering every specified change." },
              "role": "practice",
              "uses": ["scene", "viewpoint"],
              "dimension": "combine"
            }
          ],
          "parallel": "scene_paths"
        },
        {
          "id": "evidence_path",
          "title": { "zh": "证据与歧义", "en": "Evidence and ambiguity" },
          "kind": "foundation",
          "slots": [
            {
              "id": "0C1",
              "title": { "zh": "场景与图", "en": "Scene and image" },
              "task": { "zh": "为每样东西选择它的角色。", "en": "Choose the role of each item." },
              "role": "foundation",
              "uses": ["scene", "evidence"],
              "teaches": "evidence"
            },
            {
              "id": "0C2",
              "title": { "zh": "一样大的像", "en": "The same apparent size" },
              "task": { "zh": "根据给出的候选场景判断每句话。", "en": "Judge each claim against the candidate scenes." },
              "role": "practice",
              "uses": ["scene", "evidence"]
            },
            {
              "id": "0C3",
              "title": { "zh": "核对预测", "en": "Check the predictions" },
              "task": {
                "zh": "选择一条错误记录；没有错误时选择“没有错误”。",
                "en": "Choose one erroneous record, or “No errors shown” if none is wrong."
              },
              "role": "practice",
              "uses": ["scene", "evidence"],
              "dimension": "direction"
            },
            {
              "id": "0C4",
              "title": { "zh": "找反例", "en": "Find a counterexample" },
              "task": { "zh": "选择能反驳这句话的记录。", "en": "Choose a record that refutes the claim." },
              "role": "practice",
              "uses": ["scene", "evidence"],
              "dimension": "false"
            }
          ],
          "parallel": "scene_paths"
        },
        {
          "id": "station_join",
          "title": { "zh": "完成任务规格", "en": "Specify and test a task" },
          "kind": "foundation",
          "slots": [
            {
              "id": "0D1",
              "title": { "zh": "给检查系统定任务", "en": "Specify an inspection task" },
              "task": { "zh": "选择满足任务要求的输出类型。", "en": "Choose an output type that meets the task." },
              "role": "foundation",
              "uses": ["query", "outputs", "viewpoint", "evidence"]
            },
            {
              "id": "0D2",
              "title": { "zh": "该拿什么来比", "en": "What should be compared?" },
              "task": {
                "zh": "为每项预测选择可比较的参考数据。",
                "en": "Choose comparable reference data for each prediction."
              },
              "role": "foundation",
              "uses": ["query", "outputs", "viewpoint", "evidence"]
            },
            {
              "id": "0D3",
              "title": { "zh": "一张图片的边界", "en": "The limits of one picture" },
              "task": { "zh": "根据给出的候选场景判断每句话。", "en": "Judge each claim against the candidate scenes." },
              "role": "foundation",
              "uses": ["query", "outputs", "viewpoint", "evidence"]
            }
          ]
        }
      ]
    },
    {
      "id": 1,
      "machine": "camera",
      "keeps": [],
      "title": { "zh": "从场景到像素", "en": "From scene to pixels" },
      "question": { "zh": "图像怎样形成和存储？", "en": "How are images formed and stored?" },
      "why": { "zh": "测试台需要图像与成像模型。", "en": "The test station needs images and a camera model." },
      "series": [
        {
          "id": "image_intro",
          "title": { "zh": "观察数字图像", "en": "Observe a digital image" },
          "kind": "foundation",
          "slots": [
            {
              "id": "1A1",
              "title": { "zh": "一格格的数", "en": "A grid of numbers" },
              "task": { "zh": "把图中的值填入空格。", "en": "Copy the values into the empty grid." },
              "role": "foundation",
              "uses": ["pixels", "pixel"],
              "teaches": "pixel"
            },
            {
              "id": "1A2",
              "title": { "zh": "选出像素", "en": "Find a pixel" },
              "task": { "zh": "选出坐标 (2, 0) 的像素。", "en": "Select the pixel at (2, 0)." },
              "role": "practice",
              "uses": ["pixels", "pixel"],
              "dimension": "direction"
            },
            {
              "id": "1A3",
              "title": { "zh": "三个通道", "en": "Three channels" },
              "task": { "zh": "把右边的像素设为蓝色 (0, 0, 1)。", "en": "Set the pixel on the right to blue (0, 0, 1)." },
              "role": "practice",
              "uses": ["pixels", "pixel"]
            },
            {
              "id": "1A4",
              "title": { "zh": "数值如何变化", "en": "How values change" },
              "task": { "zh": "把每张图和变化方式配对。", "en": "Match each image to the kind of change." },
              "role": "practice",
              "uses": ["pixels", "pixel"],
              "dimension": "combine"
            }
          ]
        },
        {
          "id": "projection_path",
          "title": { "zh": "针孔相机", "en": "Pinhole camera" },
          "kind": "foundation",
          "slots": [
            {
              "id": "1B1",
              "title": { "zh": "穿过小孔", "en": "Through the opening" },
              "task": { "zh": "移动物点，使投影落在目标上。", "en": "Move the point so its projection reaches the target." },
              "role": "foundation",
              "uses": ["optics", "projection"],
              "teaches": "projection"
            },
            {
              "id": "1B2",
              "title": { "zh": "移动物体", "en": "Move the object" },
              "task": { "zh": "调整距离，让像高为 1。", "en": "Adjust depth until the image height is 1." },
              "role": "practice",
              "uses": ["optics", "projection"]
            },
            {
              "id": "1B3",
              "title": { "zh": "移动像平面", "en": "Move the image plane" },
              "task": {
                "zh": "调整像平面距离，让像高为 2。",
                "en": "Adjust the image plane distance until the image height is 2."
              },
              "role": "practice",
              "uses": ["optics", "projection"],
              "dimension": "direction"
            },
            {
              "id": "1B4",
              "title": { "zh": "相同的像", "en": "The same image" },
              "task": {
                "zh": "选出至少两组像高为 1、距离不同的组合。",
                "en": "Choose at least two pairs with image height 1 at different depths."
              },
              "role": "practice",
              "uses": ["optics", "projection"],
              "dimension": "combine"
            }
          ],
          "parallel": "foundations"
        },
        {
          "id": "array_path",
          "title": { "zh": "图像数组", "en": "Image arrays" },
          "kind": "foundation",
          "slots": [
            {
              "id": "1C1",
              "title": { "zh": "行和列", "en": "Rows and columns" },
              "task": { "zh": "抄下数组的值。", "en": "Copy the values of the array." },
              "role": "foundation",
              "uses": ["pixels", "coordinate"],
              "teaches": "coordinate"
            },
            {
              "id": "1C2",
              "title": { "zh": "读取像素", "en": "Read a pixel" },
              "task": { "zh": "交出图在 (x, y) 处的值。", "en": "Give the image value at (x, y)." },
              "role": "foundation",
              "uses": ["pixels", "coordinate", "lookupidea", "lookup"],
              "adds": ["lookup"],
              "teaches": "lookupidea"
            },
            {
              "id": "1C2a",
              "title": { "zh": "读取另一处", "en": "Read another position" },
              "task": { "zh": "读出图像在 (x, y) 的值。", "en": "Read the image value at (x, y)." },
              "role": "practice",
              "uses": ["circuit", "lookupidea", "lookup"]
            },
            {
              "id": "1C3",
