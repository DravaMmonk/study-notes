                "zh": "将蓝、红、绿通道依次作为输出的红、绿、蓝通道。",
                "en": "Use the blue, red, and green channels as the output red, green, and blue channels, respectively."
              },
              "role": "practice",
              "uses": ["pixels", "composeidea", "channelidea", "channel", "compose"],
              "dimension": "combine"
            }
          ],
          "parallel": "foundations"
        },
        {
          "id": "lens_path",
          "title": { "zh": "透镜和对焦", "en": "Lens and focus" },
          "kind": "foundation",
          "slots": [
            {
              "id": "1G1",
              "title": { "zh": "进光量", "en": "Collecting light" },
              "task": { "zh": "调整光圈，使进光量为 4。", "en": "Adjust the aperture until collected light is 4." },
              "role": "foundation",
              "uses": ["optics", "projection", "lensidea"],
              "teaches": "lensidea"
            },
            {
              "id": "1G2",
              "title": { "zh": "远处清晰", "en": "Focus on the far object" },
