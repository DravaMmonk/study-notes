              "role": "foundation",
              "uses": ["circuit", "selectidea", "lessidea", "less", "select"],
              "adds": ["select"],
              "teaches": "selectidea"
            },
            {
              "id": "1E1f",
              "title": { "zh": "不低于一", "en": "At least one" },
              "task": { "zh": "交出 a 和 b 中较大的数。", "en": "Output the larger of a and b." },
              "role": "foundation",
              "uses": ["circuit", "selectidea", "largeridea", "lessidea", "less", "select"],
              "builds": "larger",
              "teaches": "largeridea"
            },
            {
              "id": "1E1h",
              "title": { "zh": "坐标从哪里取", "en": "Find source positions" },
              "task": {
                "zh": "原轴有 m 个位置，新轴有 n 个位置；交出新位置 i 对应的原坐标。首尾对齐；n 为 1 时取原轴中心。",
                "en": "Given m source positions and n output positions, map output i to a source coordinate. Align endpoints; for n = 1 use the source centre."
              },
              "role": "foundation",
              "uses": [
                "circuit",
                "axisidea",
                "const",
                "sub",
                "less",
                "larger",
                "div",
                "mul",
                "select",
                "subidea",
                "constidea",
                "mulidea",
                "dividea",
                "lessidea",
                "selectidea",
                "largeridea"
              ],
              "builds": "sampleAxis",
              "teaches": "axisidea"
            },
            {
              "id": "1E1i",
              "title": { "zh": "整张坐标图", "en": "Map a coordinate grid" },
              "task": {
                "zh": "把宽为 n 的输出坐标映射到宽为 m 的原图。输出为一行。",
                "en": "Map n output positions to source width m. Output one row."
              },
              "role": "practice",
              "uses": ["circuit", "axisidea", "const", "grid", "sampleAxis", "grididea", "constidea"]
            },
            {
              "id": "1E2",
              "title": { "zh": "最近的像素", "en": "Nearest pixel" },
              "task": {
                "zh": "用最近邻把图缩放到 w × h。首尾对齐；只有一个位置时取原图中心。等距时取较大坐标。",
                "en": "Resize to w × h using nearest neighbours. Align endpoints; for one sample use the source centre. Break ties towards the larger index."
              },
              "role": "foundation",
              "uses": [
                "circuit",
                "nearestidea",
                "dividea",
                "flooridea",
                "largeridea",
                "lookupidea",
                "grididea",
                "arithidea",
                "sizeidea",
                "constidea",
                "axisidea",
                "const",
                "size",
                "grid",
                "sampleAxis",
                "add",
                "floor",
                "lookup"
              ],
              "builds": "resizeNearest",
              "teaches": "nearestidea"
            },
            {
              "id": "1E3",
              "title": { "zh": "像素之间", "en": "Between pixels" },
              "task": {
                "zh": "用双线性插值缩放到 w × h；首尾对齐，单个输出位置取原图中心。",
                "en": "Resize to w × h using bilinear interpolation; align endpoints and use the source centre for a single output position."
              },
              "role": "foundation",
              "uses": [
                "circuit",
                "nearestidea",
                "linearidea",
                "lookupidea",
                "grididea",
                "arithidea",
                "sizeidea",
                "subidea",
                "constidea",
                "mulidea",
                "flooridea",
                "axisidea",
                "const",
                "size",
                "grid",
                "sampleAxis",
                "floor",
                "sub",
                "add",
                "lookup",
                "mul"
              ],
              "builds": "resizeLinear",
              "teaches": "linearidea"
            },
            {
              "id": "1E4",
              "title": { "zh": "比较放大结果", "en": "Compare enlargements" },
              "task": {
                "zh": "分别交出最近邻和双线性缩放结果。",
                "en": "Output the nearest-neighbour and bilinear resize results."
              },
              "role": "practice",
              "uses": ["circuit", "nearestidea", "linearidea", "resizeNearest", "resizeLinear"],
              "dimension": "combine"
            },
            {
              "id": "1F1",
              "title": { "zh": "数值和显示", "en": "Values and display" },
              "task": {
                "zh": "显示把小于 0 的亮度画为 0，大于 1 的画为 1。填出显示亮度。",
                "en": "Display maps brightness below 0 to 0 and above 1 to 1. Fill in the displayed brightness."
              },
              "role": "foundation",
              "uses": ["pixels", "displayidea"],
              "teaches": "displayidea"
            },
            {
              "id": "1F1a",
              "title": { "zh": "不高于一", "en": "At most one" },
              "task": { "zh": "交出 a 和 b 中较小的数。", "en": "Output the smaller of a and b." },
              "role": "foundation",
              "uses": ["circuit", "displayidea", "smalleridea", "lessidea", "selectidea", "less", "select"],
              "builds": "smaller",
              "teaches": "smalleridea"
            },
            {
              "id": "1F2",
              "title": { "zh": "有限的亮度", "en": "Finite brightness levels" },
              "task": {
                "zh": "把 0 至 1 均匀分为 L 个亮度，取最近值；等距时取较大值。范围外先限制到 0 至 1。",
                "en": "Use L evenly spaced brightness levels from 0 to 1; choose the nearest, breaking ties upwards. Clamp values outside the range."
              },
              "role": "foundation",
              "uses": [
                "circuit",
                "displayidea",
                "quantidea",
                "arithidea",
                "subidea",
                "constidea",
                "mulidea",
                "dividea",
                "flooridea",
                "largeridea",
                "smalleridea",
                "const",
                "larger",
                "smaller",
                "sub",
                "mul",
                "add",
                "floor",
                "div"
              ],
              "builds": "quantise",
              "teaches": "quantidea"
            },
            {
              "id": "1F3",
              "title": { "zh": "还能找回吗", "en": "Can it be recovered?" },
              "task": { "zh": "将输入量化为 3 个等级。", "en": "Quantise the input to 3 levels." },
              "role": "practice",
              "uses": ["circuit", "constidea", "quantidea", "const", "quantise"],
              "dimension": "false"
            },
            {
              "id": "1Z1",
              "title": { "zh": "图像处理台", "en": "Image processing station" },
              "task": {
                "zh": "裁剪指定区域，双线性缩放到目标宽高，再量化到 L 个等级。",
                "en": "Crop the given region, resize it bilinearly, then quantise it to L levels."
              },
              "role": "foundation",
              "uses": ["circuit", "linearidea", "cropidea", "quantidea", "crop", "resizeLinear", "quantise"]
            }
          ],
          "parallel": "applications"
        },
        {
          "id": "crop_challenge",
          "title": { "zh": "缩放裁剪区域", "en": "Resize a crop" },
          "kind": "challenge",
          "slots": [
            {
              "id": "1X1",
              "title": { "zh": "放大裁剪区域", "en": "Resize a crop" },
              "task": {
                "zh": "截取指定区域，然后用最近邻缩放到目标宽高。",
                "en": "Crop the given region, then resize it using nearest-neighbour sampling."
              },
              "role": "challenge",
              "uses": ["circuit", "nearestidea", "cropidea", "crop", "resizeNearest"],
              "naive": {
                "zh": "先缩放整幅图再按旧坐标裁剪。",
                "en": "Resize the full image before applying the original crop coordinates."
              }
            }
          ],
          "after": "1E4"
        }
      ]
    }
  ],
  "parallel": [
    {
      "id": "scene_paths",
      "why": { "zh": "外观变化与证据判断互不依赖。", "en": "Appearance variation and evidence do not depend on one another." }
    },
    {
      "id": "foundations",
      "why": {
        "zh": "针孔投影与数组坐标各自建立。",
        "en": "Pinhole projection and array coordinates can be learned independently."
      }
    },
    {
      "id": "applications",
      "why": {
        "zh": "图像运算与透镜实验互不依赖。",
        "en": "Image operations and lens experiments do not depend on one another."
      }
    }
  ],
  "requests": [],
  "deferred": [
    {
      "about": { "zh": "空间滤波及后续视觉专题", "en": "Spatial filtering and later vision topics" },
      "why": { "zh": "本次只制作第 0、1 章。", "en": "This scope covers chapters 0 and 1." }
    }
  ],
  "knowledge": [
    {
      "id": "outputs",
      "about": { "zh": "输出规格", "en": "Output specifications" },
      "wall": { "zh": "不同视觉问题要求不同形状的答案。", "en": "Different questions require different kinds of output." }
    },
    {
      "id": "viewpoint",
      "about": { "zh": "视角变化", "en": "Viewpoint changes" },
      "wall": { "zh": "相同物体可能产生不同图像。", "en": "The same object can produce different images." }
    },
    {
      "id": "evidence",
      "about": { "zh": "证据与反例", "en": "Evidence and counterexamples" },
      "wall": {
        "zh": "一张图不能保证唯一场景或模型总是正确。",
        "en": "An image need not identify one world or establish universal correctness."
      }
    },
    {
      "id": "pixel",
      "about": { "zh": "像素与通道", "en": "Pixels and channels" },
      "wall": {
        "zh": "图像的数值、位置和颜色需要区分。",
        "en": "A picture has numerical values, positions and colour channels."
      }
    },
    {
      "id": "projection",
      "about": { "zh": "针孔投影", "en": "Pinhole projection" },
      "wall": {
        "zh": "真实场景中的距离不能直接从图像位置读出。",
        "en": "A scene point’s depth is not directly available from its image location."
      }
    },
    {
      "id": "coordinate",
      "about": { "zh": "数组坐标", "en": "Array coordinates" },
      "wall": {
        "zh": "行列与图像中的水平和竖直坐标容易混淆。",
        "en": "Image coordinates and array rows and columns are easy to confuse."
      }
    },
    {
      "id": "lookupidea",
      "about": { "zh": "读取像素", "en": "Pixel lookup" },
      "wall": { "zh": "知道坐标还不能自动读取该处的值。", "en": "Knowing a coordinate does not yet read its value." }
    },
    {
      "id": "channelidea",
      "about": { "zh": "选择颜色通道", "en": "Select a channel" },
      "wall": { "zh": "一个颜色像素包含多个数。", "en": "A colour pixel contains several values." }
    },
    {
      "id": "composeidea",
      "about": { "zh": "合成颜色通道", "en": "Compose colour channels" },
      "wall": { "zh": "独立的通道需要重新成为一张彩色图。", "en": "Separate channels need to become one colour image." }
    },
    {
      "id": "grididea",
      "about": { "zh": "坐标网格", "en": "Coordinate grids" },
      "wall": { "zh": "需要为输出的每个位置确定读取源的位置。", "en": "Each output position needs a source position." }
    },
    {
      "id": "arithidea",
      "about": { "zh": "坐标运算", "en": "Coordinate arithmetic" },
      "wall": { "zh": "输出和来源的位置可以不同。", "en": "The output position can differ from its source." }
    },
    {
      "id": "cropidea",
      "about": { "zh": "裁剪", "en": "Cropping" },
      "wall": { "zh": "需要从图像中提取指定窗口。", "en": "A specified window must be extracted from an image." }
    },
    {
      "id": "sizeidea",
      "about": { "zh": "尺寸", "en": "Image dimensions" },
      "wall": { "zh": "平移输出需要与输入尺寸一致。", "en": "A translation must preserve the input dimensions." }
    },
    {
      "id": "moveidea",
      "about": { "zh": "平移", "en": "Translation" },
      "wall": { "zh": "裁剪窗口本身不能移动画面。", "en": "A crop does not move content within the image." }
    },
    {
      "id": "nearestidea",
      "about": { "zh": "最近邻重采样", "en": "Nearest-neighbour resampling" },
      "wall": { "zh": "新网格位置可能不落在原有样本上。", "en": "New positions may lie between existing samples." }
    },
    {
      "id": "linearidea",
      "about": { "zh": "双线性插值", "en": "Bilinear interpolation" },
      "wall": { "zh": "最近邻会产生阶梯。", "en": "Nearest-neighbour interpolation gives step-like transitions." }
    },
    {
      "id": "displayidea",
      "about": { "zh": "数值与显示", "en": "Values and display" },
      "wall": { "zh": "显示亮度与存储值可能不同。", "en": "Displayed brightness can differ from stored values." }
    },
    {
      "id": "quantidea",
      "about": { "zh": "量化", "en": "Quantisation" },
      "wall": {
        "zh": "有限取值无法区分任意接近的数。",
        "en": "Finitely many levels cannot distinguish arbitrarily close values."
      }
    },
    {
      "id": "lensidea",
      "about": { "zh": "透镜与焦点", "en": "Lenses and focus" },
      "wall": { "zh": "理想针孔没有刻画透镜的聚焦和光圈。", "en": "An ideal pinhole does not describe lens focus and aperture." }
    },
    {
      "id": "subidea",
      "about": { "zh": "坐标差", "en": "Coordinate differences" },
      "wall": { "zh": "位置和位移不能只靠相加表示。", "en": "A source coordinate may require subtracting an offset." }
    },
    {
      "id": "constidea",
      "about": { "zh": "常数", "en": "Constants" },
      "wall": { "zh": "某些任务需要输入中没有的固定数。", "en": "Some tasks require a fixed number not supplied as an input." }
    },
    {
      "id": "mulidea",
      "about": { "zh": "比例", "en": "Scaling" },
      "wall": { "zh": "坐标差可能需要乘以比例。", "en": "A coordinate difference may need scaling." }
    },
    {
      "id": "dividea",
      "about": { "zh": "均分", "en": "Division" },
      "wall": { "zh": "需要在指定范围分配样本。", "en": "Samples must be distributed over a given range." }
    },
    {
      "id": "flooridea",
      "about": { "zh": "取整", "en": "Rounding down" },
      "wall": { "zh": "连续位置还不是整数索引。", "en": "A continuous position is not yet an integer index." }
    },
    {
      "id": "lessidea",
      "about": { "zh": "比较", "en": "Comparison" },
      "wall": { "zh": "选择结果需要区分数值大小。", "en": "A choice needs a way to distinguish values." }
    },
    {
      "id": "selectidea",
      "about": { "zh": "按条件选择", "en": "Conditional selection" },
      "wall": { "zh": "比较的结果需要控制一个输出。", "en": "A comparison must be able to control an output." }
    },
    {
      "id": "largeridea",
      "about": { "zh": "较大值", "en": "The larger value" },
      "wall": { "zh": "多处需要选择两个数中较大的数。", "en": "Multiple tasks need the larger of two values." }
    },
    {
      "id": "smalleridea",
      "about": { "zh": "较小值", "en": "The smaller value" },
      "wall": { "zh": "多处需要选择两个数中较小的数。", "en": "Multiple tasks need the smaller of two values." }
    },
    {
      "id": "axisidea",
      "about": { "zh": "采样坐标映射", "en": "Sampling coordinate mapping" },
      "wall": {
        "zh": "不同尺寸的网格需要一致的坐标对应。",
        "en": "Grids of different sizes need a consistent coordinate mapping."
      }
    }
  ]
}
