              "role": "practice",
              "uses": ["optics", "lensidea", "projection"],
              "dimension": "combine"
            }
          ],
          "parallel": "applications"
        },
        {
          "id": "image_ops",
          "title": { "zh": "裁剪、缩放与表示", "en": "Crop, resize and representation" },
          "kind": "foundation",
          "slots": [
            {
              "id": "1D0",
              "title": { "zh": "标出坐标", "en": "Mark coordinates" },
              "task": {
                "zh": "读取从左上角开始、大小为 w × h 的区域。",
                "en": "Read a w × h region starting at the upper-left corner."
              },
              "role": "foundation",
              "uses": ["circuit", "grididea", "grid", "lookup", "lookupidea"],
              "adds": ["grid"],
              "teaches": "grididea"
            },
            {
              "id": "1D0a",
              "title": { "zh": "从另一个起点出发", "en": "Start elsewhere" },
              "task": { "zh": "把一行坐标全部增加起点 x0。", "en": "Offset each coordinate in a row by x0." },
              "role": "foundation",
