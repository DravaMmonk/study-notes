              "uses": ["circuit", "mulidea", "grididea", "constidea", "const", "grid", "mul"],
              "adds": ["mul"],
              "teaches": "mulidea"
            },
            {
              "id": "1E1c",
              "title": { "zh": "平均分布", "en": "Even spacing" },
              "task": {
                "zh": "把 length 按 scale 放大，再均分为 n 段；交出每段长度。",
