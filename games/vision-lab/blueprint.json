            {
              "id": "1D4",
              "title": { "zh": "截取移动的图", "en": "Crop a moving picture" },
              "task": { "zh": "先移动图像，再截取指定区域。", "en": "Translate the image, then crop the specified region." },
              "role": "practice",
              "uses": ["circuit", "cropidea", "moveidea", "translate", "crop"],
              "dimension": "combine"
