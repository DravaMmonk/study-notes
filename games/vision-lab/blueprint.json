              "role": "foundation",
              "uses": ["circuit", "lessidea", "flooridea", "floor", "less"],
              "adds": ["less"],
              "teaches": "lessidea"
            },
            {
              "id": "1E1g",
              "title": { "zh": "选择一个值", "en": "Select a value" },
              "task": {
                "zh": "当 a 小于 b 时交出 a，否则交出 b。",
