              "role": "foundation",
              "uses": ["circuit", "flooridea", "dividea", "div", "floor"],
              "adds": ["floor"],
              "teaches": "flooridea"
            },
            {
              "id": "1E1e",
              "title": { "zh": "比较位置", "en": "Compare positions" },
              "task": {
                "zh": "将 a 向下取整；如果结果小于 b 交出 1，否则交出 0。",
                "en": "Round a down; output 1 if the result is less than b and 0 otherwise."
