{
  "domain": "vision",
  "vocabulary": 1,
  "title": {
    "zh": "视觉实验室",
    "en": "Vision Lab"
  },
  "kicker": {
    "zh": "开发中",
    "en": "In development"
  },
  "lede": {
    "zh": "一章一章造出视觉的机器。先造一台相机：把场景投影到<wiki-ref to=\"pixel\"></wiki-ref>坐标、在任意位置取值；再造一台卷积器：把邻居加权合起来，搭出模糊器和边缘检测器。每个部件都会在后面直接复用。",
    "en": "Build the machines of vision chapter by chapter. First a camera: project a scene into <wiki-ref to=\"pixel\"></wiki-ref> coordinates and read it at any position; then a convolver: weigh neighbours together into a blur and an edge detector. Every part is reused later."
  },
  "primitives": [
    "mul",
    "div",
    "add",
    "const",
    "sub",
    "lookup",
    "grid",
    "floor",
    "size",
    "sqrt",
    "channel",
    "compose"
  ],
  "concept": {
    "mul": "projection",
    "div": "projection",
    "add": "pixels",
    "const": "pixels",
    "sub": "pixels",
    "lookup": "pixels",
    "grid": "pixels",
    "floor": "pixels",
    "size": "filters",
    "sqrt": "filters",
    "channel": "channels",
    "compose": "channels"
  },
  "eras": [
    {
      "id": 1,
      "title": { "zh": "相机：从场景到像素", "en": "The camera: from scene to pixels" },
      "question": {
        "zh": "场景怎样变成一张数表，数表又怎样在任意位置取值？",
        "en": "How does a scene become a table of numbers, and how is the table read at any position?"
      },
      "foundation": [
        {
          "parallel": [
            {
              "id": "camera-geometry",
              "title": { "zh": "投影与成像几何", "en": "Projection geometry" },
              "levels": ["1A1", "1A2"]
            },
            {
              "id": "camera-array",
              "title": { "zh": "数表与定位", "en": "Arrays and positions" },
              "levels": ["1A4"]
            }
          ]
        },
        "1A3",
        "1A5",
        "1A6",
        "1A7"
      ],
      "topics": [
        {
          "id": "workshop-camera",
          "title": { "zh": "Workshop：相机的工程细节", "en": "Workshop: camera practice" },
          "levels": ["1W1", "1W2"],
          "after": "1A7"
        },
        {
          "id": "framing",
          "title": { "zh": "可选：画面与视野", "en": "Optional: framing and field of view" },
          "levels": ["1F1"],
          "after": "1A1"
        }
      ]
    },
    {
      "id": 2,
      "keeps": "all",
      "title": { "zh": "卷积器：局部加权", "en": "The convolver: weighted neighbourhoods" },
      "question": {
        "zh": "怎样把一个像素和它的邻居合起来算，造出模糊器和边缘检测器？",
        "en": "How is a pixel combined with its neighbours, to build a blur and an edge detector?"
      },
      "foundation": [
        "2B1",
        "2B2",
        {
          "parallel": [
            {
              "id": "filter-orientation",
              "title": { "zh": "权重方向", "en": "Weight orientation" },
              "levels": ["2B3"]
            },
            {
              "id": "filter-column",
              "title": { "zh": "竖直邻域", "en": "Vertical neighbourhoods" },
              "levels": ["2B4"]
            }
          ]
        },
        "2B5",
        {
          "parallel": [
            { "id": "filter-smooth", "title": { "zh": "平滑路线", "en": "Smoothing" }, "levels": ["2B6"] },
            { "id": "filter-edge", "title": { "zh": "变化路线", "en": "Changes" }, "levels": ["2B7", "2B8"] }
          ]
        },
        "2B9"
      ],
      "topics": [
        {
          "id": "colour-workshop",
          "title": { "zh": "Workshop：颜色顺序与溢出", "en": "Workshop: channel order and overflow" },
          "levels": ["2W1"],
          "after": "2B9"
        }
      ]
    }
  ],
