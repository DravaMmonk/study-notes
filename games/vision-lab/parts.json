{
  "presets": {
    "outside": {
      "control": "select",
      "label": { "zh": "图外", "en": "Outside" },
      "options": [
        {
          "value": "zero",
          "label": { "zh": "取 0", "en": "Zero" },
          "about": { "zh": "图外读作 0。", "en": "Outside reads as 0." }
        },
        {
          "value": "clamp",
          "label": { "zh": "延续边缘", "en": "Edge continued" },
          "about": { "zh": "图外读最近的边上那一格。", "en": "Outside reads the nearest edge cell." }
        },
        {
          "value": "wrap",
          "label": { "zh": "循环", "en": "Wrap around" },
          "about": { "zh": "图外接着另一边。", "en": "Outside continues from the opposite side." }
        },
        {
          "value": "reflect",
          "label": { "zh": "镜像", "en": "Mirror" },
          "about": { "zh": "图外照着边缘镜像，边上那一格也算一次。", "en": "Outside mirrors the edge, the edge cell included." }
        }
      ],
      "default": "clamp"
    },
    "axis": {
      "control": "buttons",
      "label": { "zh": "方向", "en": "Direction" },
      "options": [
        { "value": "x", "label": { "zh": "横", "en": "Across" } },
        { "value": "y", "label": { "zh": "竖", "en": "Down" } }
      ],
      "default": "x"
    }
  },
  "parts": {
    "shift": {
      "name": { "zh": "平移", "en": "Shift" },
      "desc": {
        "zh": "把整张图沿横向或竖向挪一格：挪完以后，每格上放的是它旁边那一格的读数。",
        "en": "Move the whole picture one cell across or down: afterwards each cell holds its neighbour’s reading."
      },
      "icon": "Move",
      "family": "image",
      "inputs": [{ "name": "image", "label": { "zh": "照片", "en": "Photo" } }],
      "settings": [
        { "key": "axis", "use": "axis" },
        {
          "key": "by",
          "control": "buttons",
          "label": { "zh": "往哪挪", "en": "Which way" },
          "options": [
            { "value": "forward", "label": { "zh": "往右（往下）", "en": "Right (down)" } },
            { "value": "backward", "label": { "zh": "往左（往上）", "en": "Left (up)" } }
          ],
          "default": "forward"
        },
        { "key": "outside", "use": "outside" }
      ],
      "compute": "match $axis { x: match $by { forward: shift(image, vector2(-1, 0), outside=$outside), backward: shift(image, vector2(1, 0), outside=$outside) }, y: match $by { forward: shift(image, vector2(0, -1), outside=$outside), backward: shift(image, vector2(0, 1), outside=$outside) } }"
    },
    "arithmetic": {
      "name": { "zh": "四则运算", "en": "Arithmetic" },
      "desc": {
        "zh": "a 和 b 逐格运算；一个数和一张图运算时，这个数用在每一格上。",
        "en": "a and b cell by cell; a number with an image applies to every cell."
      },
      "icon": "Plus",
      "family": "value",
      "inputs": [{ "name": "a" }, { "name": "b" }],
      "settings": [
        {
          "key": "op",
          "control": "buttons",
          "options": [
            { "value": "add", "label": "+", "about": { "zh": "加。", "en": "Add." } },
            { "value": "sub", "label": "−", "about": { "zh": "减。", "en": "Subtract." } },
            { "value": "mul", "label": "×", "about": { "zh": "乘。", "en": "Multiply." } },
            {
              "value": "div",
              "label": "÷",
              "about": { "zh": "除；除以 0 报错。", "en": "Divide; dividing by 0 stops." }
            }
          ],
          "default": "add"
        }
      ],
      "compute": "match $op { add: add(a, b), sub: sub(a, b), mul: mul(a, b), div: div(a, b) }",
      "views": { "tile": [{ "show": "value" }, { "show": "setting", "key": "op", "as": "label" }] }
    },
    "const": {
      "name": { "zh": "常数", "en": "Constant" },
      "desc": {
        "zh": "一个固定的数；可以写成分数，比如 1/9。",
        "en": "A fixed number; it can be written as a fraction, such as 1/9."
      },
      "icon": "Hash",
      "family": "value",
      "inputs": [],
      "settings": [
        { "key": "value", "control": "number", "label": { "zh": "数", "en": "Value" }, "default": 0 }
      ],
      "compute": "$value"
    },
    "kernel": {
      "name": { "zh": "核", "en": "Kernel" },
      "desc": {
        "zh": "一张 3×3 的核：九个权重按邻居的位置排，整张除以「÷」。",
        "en": "A 3×3 kernel: nine weights laid out where the neighbours are, the whole divided by “÷”."
      },
      "icon": "Grid3x3",
      "family": "value",
      "inputs": [],
      "settings": [
        { "key": "k1", "control": "number", "about": { "zh": "上左", "en": "top left" }, "default": 0 },
        { "key": "k2", "control": "number", "about": { "zh": "上中", "en": "top" }, "default": 0 },
        { "key": "k3", "control": "number", "about": { "zh": "上右", "en": "top right" }, "default": 0 },
        { "key": "k4", "control": "number", "about": { "zh": "中左", "en": "left" }, "default": 0 },
        { "key": "k5", "control": "number", "about": { "zh": "中间", "en": "centre" }, "default": 1 },
        { "key": "k6", "control": "number", "about": { "zh": "中右", "en": "right" }, "default": 0 },
        { "key": "k7", "control": "number", "about": { "zh": "下左", "en": "bottom left" }, "default": 0 },
        { "key": "k8", "control": "number", "about": { "zh": "下中", "en": "bottom" }, "default": 0 },
        { "key": "k9", "control": "number", "about": { "zh": "下右", "en": "bottom right" }, "default": 0 },
        { "key": "divide", "control": "number", "label": "÷", "default": 1 }
      ],
      "compute": "div(kernel3($k1, $k2, $k3, $k4, $k5, $k6, $k7, $k8, $k9), $divide)",
      "views": {
        "card": [
          {
            "show": "row",
            "blocks": [
              { "show": "setting", "key": "k1" },
              { "show": "setting", "key": "k2" },
              { "show": "setting", "key": "k3" }
            ]
          },
          {
            "show": "row",
            "blocks": [
              { "show": "setting", "key": "k4" },
              { "show": "setting", "key": "k5" },
              { "show": "setting", "key": "k6" }
            ]
          },
          {
            "show": "row",
            "blocks": [
              { "show": "setting", "key": "k7" },
              { "show": "setting", "key": "k8" },
              { "show": "setting", "key": "k9" }
            ]
          },
          { "show": "setting", "key": "divide" }
        ],
        "detail": [
          { "show": "desc" },
          {
            "show": "row",
            "blocks": [
              { "show": "setting", "key": "k1" },
              { "show": "setting", "key": "k2" },
              { "show": "setting", "key": "k3" }
            ]
          },
          {
            "show": "row",
            "blocks": [
              { "show": "setting", "key": "k4" },
              { "show": "setting", "key": "k5" },
              { "show": "setting", "key": "k6" }
            ]
          },
          {
            "show": "row",
            "blocks": [
              { "show": "setting", "key": "k7" },
              { "show": "setting", "key": "k8" },
              { "show": "setting", "key": "k9" }
            ]
          },
          { "show": "setting", "key": "divide" }
        ],
        "tile": [
          {
            "show": "row",
            "blocks": [
              { "show": "setting", "key": "k1", "as": "label" },
              { "show": "setting", "key": "k2", "as": "label" },
              { "show": "setting", "key": "k3", "as": "label" }
            ]
          },
          {
            "show": "row",
            "blocks": [
              { "show": "setting", "key": "k4", "as": "label" },
              { "show": "setting", "key": "k5", "as": "label" },
              { "show": "setting", "key": "k6", "as": "label" }
            ]
          },
          {
            "show": "row",
            "blocks": [
              { "show": "setting", "key": "k7", "as": "label" },
              { "show": "setting", "key": "k8", "as": "label" },
              { "show": "setting", "key": "k9", "as": "label" }
            ]
          },
          { "show": "summary", "text": { "zh": "÷ {divide}", "en": "÷ {divide}" } }
        ]
      }
    },
    "split3": {
      "name": { "zh": "拆成三个数", "en": "Split in three" },
      "desc": {
        "zh": "一行三个权重拆成前、中、后三个数。",
        "en": "A row of three weights taken apart into first, centre and last."
      },
      "icon": "Split",
      "family": "value",
      "inputs": [{ "name": "row", "label": { "zh": "一行三个", "en": "Row of three" } }],
      "outputs": [
        { "name": "first", "label": { "zh": "前", "en": "First" } },
        { "name": "centre", "label": { "zh": "中", "en": "Centre" } },
        { "name": "last", "label": { "zh": "后", "en": "Last" } }
      ],
      "compute": { "first": "lookup(row, 0, 0)", "centre": "lookup(row, 1, 0)", "last": "lookup(row, 2, 0)" }
    },
    "rows3": {
      "name": { "zh": "拆成三行", "en": "Split into rows" },
      "desc": {
        "zh": "3×3 的核拆成上、中、下三行，每行三个权重。",
        "en": "A 3×3 kernel taken apart into its top, middle and bottom rows of three weights."
      },
      "icon": "Layers",
      "family": "value",
      "inputs": [{ "name": "kernel", "label": { "zh": "核", "en": "Kernel" } }],
      "outputs": [
        { "name": "top", "label": { "zh": "上", "en": "Top" } },
        { "name": "middle", "label": { "zh": "中", "en": "Middle" } },
        { "name": "bottom", "label": { "zh": "下", "en": "Bottom" } }
      ],
      "compute": { "top": "rowOf(kernel, 0)", "middle": "rowOf(kernel, 1)", "bottom": "rowOf(kernel, 2)" }
    },
    "filter": {
      "name": { "zh": "滤波器", "en": "Filter" },
      "desc": {
        "zh": "每格换成它周围九格按核加权的和：核的中间乘这一格，左上角乘左上方的邻居。",
        "en": "Each cell replaced by the nine around it weighted by the kernel: the kernel’s centre weighs the cell itself, its top left the neighbour above left."
      },
      "icon": "Blend",
      "family": "image",
      "inputs": [
        { "name": "image", "label": { "zh": "图", "en": "Image" } },
        { "name": "kernel", "label": { "zh": "核", "en": "Kernel" } }
      ],
      "settings": [{ "key": "outside", "use": "outside" }],
      "compute": "filter(image, kernel, outside=$outside)"
    },
    "turn180": {
      "name": { "zh": "转 180°", "en": "Turn 180°" },
      "desc": {
        "zh": "把一张图（或一张核）转半圈：左上角到了右下角。",
        "en": "Turn an image (or a kernel) half a circle: the top left goes to the bottom right."
      },
      "icon": "RotateCw",
      "family": "image",
      "inputs": [{ "name": "image", "label": { "zh": "图", "en": "Image" } }],
      "compute": "reverse(image)"
    },
    "magnitude": {
      "name": { "zh": "向量长度", "en": "Vector length" },
      "desc": {
        "zh": "把 x、y 当成箭头的横竖两个分量，给出箭头的长度 √(x² + y²)。",
        "en": "Taking x and y as an arrow’s two parts, the arrow’s length √(x² + y²)."
      },
      "icon": "Radical",
      "family": "value",
      "inputs": [{ "name": "x" }, { "name": "y" }],
      "compute": "hypot(x, y)"
    },
    "angle": {
      "name": { "zh": "方向", "en": "Direction" },
      "desc": {
        "zh": "把 x、y 当成箭头的横竖两个分量，给出箭头指的方向，以周为单位：往右 0，往下 1/4，往上 −1/4。",
        "en": "Taking x and y as an arrow’s two parts, the way it points, in turns: right 0, down 1/4, up −1/4."
      },
      "icon": "ArrowRight",
      "family": "value",
      "inputs": [{ "name": "x" }, { "name": "y" }],
      "compute": "angleTurns(y, x)"
    },
    "less": {
      "name": { "zh": "比较", "en": "Compare" },
      "desc": { "zh": "a 小于 b 的格子给 1，其余给 0。", "en": "1 where a is less than b, else 0." },
      "icon": "Scale",
      "family": "logic",
      "inputs": [{ "name": "a" }, { "name": "b" }],
      "compute": "less(a, b)"
    }
  }
}
