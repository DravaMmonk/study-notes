{
  "title": { "zh": "截取窗口", "en": "A window into an image" },
  "intro": [
    {
      "t": {
        "zh": "读取一个像素还不够：现在要从不同起点截出一整片区域。",
        "en": "Reading one pixel is not enough: extract a region starting at a supplied position."
      }
    }
  ],
  "tasks": [
    {
      "id": "1D1",
      "kind": "circuit",
      "brief": { "zh": "截取左上角为 (x0, y0)、大小为 w × h 的区域。", "en": "Crop a w × h region starting at (x0, y0)." },
      "inputs": [
        { "name": "image", "label": "image" },
        { "name": "x0", "label": "x0" },
        { "name": "y0", "label": "y0" },
        { "name": "w", "label": "w" },
        { "name": "h", "label": "h" }
      ],
      "outputs": [{ "name": "out", "label": { "zh": "结果", "en": "Result" } }],
      "tests": [
        {
          "inputs": { "image": [[1, 2, 3], [4, 5, 6], [7, 8, 9]], "x0": 1, "y0": 0, "w": 2, "h": 2 },
          "expect": { "out": [[2, 3], [5, 6]] }
        },
        {
          "inputs": { "image": [[1, 2, 3], [4, 5, 6], [7, 8, 9]], "x0": 0, "y0": 1, "w": 3, "h": 2 },
          "expect": { "out": [[4, 5, 6], [7, 8, 9]] }
        }
      ],
      "solution": [
        "g = grid(w, h)",
        "sx = add(g.x, x0)",
        "sy = add(g.y, y0)",
        "r = lookup(image, sx, sy)",
        "out <- r"
      ],
      "hidden": [
        {
          "inputs": { "image": [[1, 2, 3, 4], [5, 6, 7, 8]], "x0": 3, "y0": 1, "w": 1, "h": 1 },
          "expect": { "out": [[8]] }
        },
        {
          "inputs": {
            "image": [[[0.1, 0.2, 0.3], [0.7, 0.8, 0.9]], [[0.4, 0.5, 0.6], [0.2, 0.3, 0.4]]],
            "x0": 1,
            "y0": 0,
            "w": 1,
            "h": 2
          },
          "expect": { "out": [[[0.7, 0.8, 0.9]], [[0.2, 0.3, 0.4]]] }
        }
      ]
    }
  ],
  "builds": {
    "type": "crop",
    "name": { "zh": "裁剪", "en": "Crop" },
    "desc": {
      "zh": "从指定起点截取指定大小的图像区域。",
      "en": "Extracts an image region of the given size from the given origin."
    }
  }
}
