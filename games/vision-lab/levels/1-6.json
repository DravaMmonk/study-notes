{
  "title": { "zh": "噪声里的边", "en": "Edges in noise" },
  "intro": [
    {
      "t": {
        "zh": "<level-ref to=\"1-5\"></level-ref>的电路放到带噪点的图上，满屏都是假边。",
        "en": "Put the circuit of <level-ref to=\"1-5\"></level-ref> on a noisy image and false edges are everywhere."
      }
    }
  ],
  "after": {
    "zh": "相减把噪点放大了。先沿边的方向用 1、2、1 平滑，再垂直于边相减，合成一张核：<wiki-ref to=\"sobel\"></wiki-ref>。",
    "en": "Subtracting amplified the noise. Smooth along the edge with 1, 2, 1 first, then subtract across it, all in one kernel: the <wiki-ref to=\"sobel\"></wiki-ref>."
  },
  "tray": "main",
  "builds": {
    "type": "gradient",
    "name": { "zh": "求梯度", "en": "Gradient" },
    "desc": { "zh": "一张图的横向和竖向变化（Sobel）。", "en": "An image’s change across and change down (Sobel)." }
  },
  "tasks": [
    {
      "id": "sobel",
      "kind": "circuit",
      "carry": "1-5",
      "brief": { "zh": "让输出和目标一样：只剩真正的边。", "en": "Match the target: only the real edges left." },
      "hint": [
        {
          "zh": "相减时，噪点也被减了出来。先压一压噪点再相减。",
          "en": "Subtracting brings the noise out too. Calm the noise before subtracting."
        },
        {
          "zh": "只沿着边的方向平滑，边就不会被抹宽；中间那行重一些，1、2、1。",
          "en": "Smooth only along the edge so it does not widen; weigh the middle row more, 1, 2, 1."
        }
      ],
      "inputs": [{ "name": "photo", "label": { "zh": "图", "en": "Image" } }],
      "outputs": [
        { "name": "dx", "label": { "zh": "横向变化", "en": "Change across" } },
