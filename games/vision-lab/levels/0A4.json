{
  "title": { "zh": "一份输出能回答什么", "en": "What an output can answer" },
  "intro": [
    {
      "t": {
        "zh": "同一结果有时能回答不止一个问题；有些量则不在结果里。",
        "en": "One output may answer more than one question, while some quantities are absent."
      }
    }
  ],
  "tasks": [
    {
      "id": "0A4",
      "kind": "choice",
      "brief": {
        "zh": "每题至少选择一种足以回答问题的输出。",
        "en": "For each question choose at least one output sufficient to answer it."
      },
      "hint": [{ "zh": "检查结果是否包含问题要的量。", "en": "Check whether the result contains the requested quantity." }],
      "judge": { "fields": { "mode": "enough" } },
      "rounds": [
        {
          "items": [
            {
              "prompt": { "zh": "指出属于物体的像素。", "en": "Identify the pixels belonging to the objects." },
              "needs": ["class", "region"]
            },
            {
              "prompt": { "zh": "读取画面中心的距离。", "en": "Read the distance at the centre." },
              "needs": ["depth", "region"]
            }
          ],
          "options": [
            { "id": "label", "label": { "zh": "一张类别标签", "en": "One class label" }, "gives": ["class"] },
            { "id": "box", "label": { "zh": "一个位置框", "en": "One bounding box" }, "gives": ["location"] },
            {
              "id": "detect",
              "label": { "zh": "每个物体的类别和位置框", "en": "A class and box for each object" },
              "gives": ["class", "location", "instance"]
            },
            {
              "id": "sem",
              "label": { "zh": "每个像素的类别", "en": "A class per pixel" },
              "gives": ["class", "region", "location"]
            },
            {
              "id": "inst",
              "label": { "zh": "每个像素的类别和物体编号", "en": "A class and object ID per pixel" },
              "gives": ["class", "region", "instance", "location"]
            },
            {
              "id": "depth",
              "label": { "zh": "每个像素的距离", "en": "A distance at each pixel" },
              "gives": ["depth", "region"]
            }
          ],
          "reference": {
            "size": [32, 24],
            "camera": { "yaw": 0, "pitch": 10, "distance": 6, "f": 1 },
            "light": { "azimuth": 30, "elevation": 60 },
            "floor": "grey",
            "objects": [
              {
                "id": "person1",
                "class": "block",
                "colour": "blue",
                "boxes": [
                  { "at": [-0.5, 0.35, 0], "size": [0.55, 0.55, 0.42] },
                  { "at": [-0.5, 0.75, 0], "size": [0.35, 0.3, 0.35] }
                ]
              }
            ]
          }
        },
        {
          "items": [
            {
              "prompt": { "zh": "分开每个几何物体的像素。", "en": "Separate the pixels of individual geometric objects." },
              "needs": ["class", "region", "instance"]
            },
            {
              "prompt": { "zh": "读取每个位置的距离。", "en": "Read distance at every position." },
              "needs": ["depth", "region"]
            }
          ],
          "options": [
            {
              "id": "depth",
              "label": { "zh": "每个像素的距离", "en": "A distance at each pixel" },
              "gives": ["depth", "region"]
            },
            {
              "id": "inst",
              "label": { "zh": "每个像素的类别和物体编号", "en": "A class and object ID per pixel" },
              "gives": ["class", "region", "instance", "location"]
            },
            {
              "id": "sem",
              "label": { "zh": "每个像素的类别", "en": "A class per pixel" },
              "gives": ["class", "region", "location"]
            },
            {
              "id": "detect",
              "label": { "zh": "每个物体的类别和位置框", "en": "A class and box for each object" },
              "gives": ["class", "location", "instance"]
            },
            { "id": "box", "label": { "zh": "一个位置框", "en": "One bounding box" }, "gives": ["location"] },
            { "id": "label", "label": { "zh": "一张类别标签", "en": "One class label" }, "gives": ["class"] }
          ],
          "reference": {
            "size": [32, 24],
            "camera": { "yaw": 0, "pitch": 10, "distance": 6, "f": 1 },
            "light": { "azimuth": 30, "elevation": 60 },
            "floor": "grey",
            "objects": [
              {
                "id": "person1",
                "class": "block",
                "colour": "blue",
                "boxes": [
                  { "at": [-0.6, 0.35, 0], "size": [0.55, 0.55, 0.42] },
                  { "at": [-0.6, 0.75, 0], "size": [0.35, 0.3, 0.35] }
                ]
              },
              {
                "id": "person2",
                "class": "block",
                "colour": "blue",
                "boxes": [
                  { "at": [0.6, 0.35, 0], "size": [0.55, 0.55, 0.42] },
                  { "at": [0.6, 0.75, 0], "size": [0.35, 0.3, 0.35] }
                ]
              }
            ]
          }
        }
      ]
    }
  ]
}
