      "solution": [
        "sx = const[kind=weights,first=1,centre=2,last=1]()",
        "sy = transpose(sx)",
        "smooth = spatialProcessor[form=separable,outside=clamp](image,kx,ky)",
        "v = spatialProcessor[form=separable,outside=clamp](smooth,dx,sy)",
        "vY = spatialProcessor[form=separable,outside=clamp](smooth,sx,dy)",
        "m = magnitude(v,vY)",
        "mark = less(threshold,m)",
        "strength <- m",
        "mask <- mark"
      ],
      "naive": [
        "sx = const[kind=weights,first=1,centre=2,last=1]()",
        "sy = transpose(sx)",
        "v = spatialProcessor[form=separable,outside=clamp](image,dx,sy)",
        "vY = spatialProcessor[form=separable,outside=clamp](image,sx,dy)",
        "m = magnitude(v,vY)",
        "mark = less(threshold,m)",
        "strength <- m",
        "mask <- mark"
      ],
      "naiveWhy": {
        "zh": "阈值不能代替输入尺度的控制。没有前置平滑时，细碎变化也会进入方向响应。",
        "en": "Thresholding does not replace scale control: fine variation reaches the directional response without preprocessing."
      },
