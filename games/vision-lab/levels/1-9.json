{
  "title": { "zh": "噪声里的边", "en": "Edges in noise" },
  "intro": [
    {
      "t": {
        "zh": "把找边的电路放到夜里拍的单据上：真边还在，满屏都是一对对正负的假边。",
        "en": "Run the edge finder on a night photo: the real edges are there, but so are pairs of false ones everywhere."
      }
    }
  ],
  "after": {
    "zh": "相减把每个噪点都放大成一对假边。先沿着边的方向用 [1 2 1] 平滑，再垂直于边相减，噪声就压下去了，这就是 <wiki-ref to=\"sobel\"></wiki-ref>。",
    "en": "Subtracting turns every speck of noise into a pair of false edges. Smoothing along the edge with [1 2 1] before subtracting across it keeps the noise down: the <wiki-ref to=\"sobel\"></wiki-ref>."
  },
  "tasks": [
    {
      "id": "sobel",
      "kind": "circuit",
      "carry": "1-7",
      "brief": {
        "zh": "让两张变化图只剩真边，和目标一样。",
        "en": "Leave only the real edges in both change maps, matching the target."
      },
      "hint": [
        {
          "zh": "找横向变化时，上下两行的邻居说的是同一道竖边。",
          "en": "When finding the change across, the rows above and below see the same upright edge."
        },
        {
          "zh": "目标里，正中那一行比上下两行重一倍。",
          "en": "In the target, the middle row counts twice as much as the rows above and below."
        }
      ],
      "inputs": [{ "name": "photo", "label": { "zh": "照片", "en": "Photo" } }],
      "outputs": [
        { "name": "gx", "label": { "zh": "横向变化", "en": "Change across" } },
        { "name": "gy", "label": { "zh": "竖向变化", "en": "Change down" } }
      ],
      "tests": [
        {
          "inputs": {
