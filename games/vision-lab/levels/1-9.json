        }
      ],
      "solution": [
        "w = const[kind=row3,first=-1,centre=0,last=1]()",
        "s = const[kind=row3,first=1,centre=2,last=1]()",
        "sy = line3[axis=y](photo,s)",
        "x = line3[axis=x](sy,w)",
        "sx = line3[axis=x](photo,s)",
        "y = line3[axis=y](sx,w)",
        "gx <- x",
        "gy <- y"
      ],
      "naive": [
        "w = const[kind=row3,first=-1,centre=0,last=1]()",
        "x = line3[axis=x](photo,w)",
        "y = line3[axis=y](photo,w)",
        "gx <- x",
        "gy <- y"
      ],
      "naiveWhy": {
        "zh": "没有先平滑：每个噪点都成了一对假边。",
        "en": "No smoothing first: each speck of noise became a pair of false edges."
      },
      "sample": {
        "inputs": {
          "photo": {
            "size": [48, 36],
            "base": 0.15,
            "layers": [
              {
                "shape": "quad",
                "corners": [[5.76, 3.6], [43.2, 5.76], [41.28, 33.120000000000005], [3.84, 30.96]],
                "v": 0.85
              },
              { "shape": "text", "v": 0.3, "gap": 4, "seed": 3, "x": 9, "y": 9, "w": 26, "h": 18 }
            ],
            "noise": { "seed": 9, "amp": 0.12 }
          }
        }
      }
