{
  "title": { "zh": "交换颜色通道", "en": "Reorder colour channels" },
  "intro": [
    {
      "t": {
        "zh": "已经可以拆开和合成通道。现在重新安排每个通道。",
        "en": "The channels can be separated and combined. Now put them back in a different order."
      }
    }
  ],
  "tasks": [
    {
      "id": "1C5",
      "kind": "circuit",
      "brief": {
        "zh": "将蓝、红、绿通道依次作为输出的红、绿、蓝通道。",
        "en": "Use the blue, red, and green channels as the output red, green, and blue channels, respectively."
      },
      "inputs": [
        { "name": "image", "label": "image" },
        { "name": "r", "label": "r" },
        { "name": "g", "label": "g" },
        { "name": "b", "label": "b" }
      ],
      "outputs": [{ "name": "out", "label": { "zh": "结果", "en": "Result" } }],
      "tests": [
        {
          "inputs": { "image": [[[1, 0.4, 0.2], [0.3, 0.7, 0.9]]], "r": 0, "g": 1, "b": 2 },
          "expect": { "out": [[[0.2, 1, 0.4], [0.9, 0.3, 0.7]]] }
        }
      ],
      "solution": [
        "rr = channel(image, r)",
        "gg = channel(image, g)",
        "bb = channel(image, b)",
        "p = compose(bb, rr, gg)",
        "out <- p"
      ],
      "hidden": [
        {
          "inputs": { "image": [[[0.2, 0.4, 0.9]]], "r": 0, "g": 1, "b": 2 },
          "expect": { "out": [[[0.9, 0.2, 0.4]]] }
        }
      ]
    }
  ]
}
