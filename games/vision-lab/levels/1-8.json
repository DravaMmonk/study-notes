        "dy = transpose(dx)",
        "v = spatialProcessor[form=dense,outside=clamp](image,dx)",
        "vY = spatialProcessor[form=dense,outside=clamp](image,dy)",
        "m = magnitude(v,vY)",
        "gx <- v",
        "gy <- vY",
        "strength <- m"
      ],
      "naiveWhy": {
        "zh": "Sobel 在求导的垂直方向平滑。沿求导方向再次平滑会改变你要测量的响应。",
        "en": "Sobel smooths perpendicular to differentiation. Smoothing along the derivative axis changes the intended measurement."
      },
      "adds": [],
      "carries": true,
      "sample": {
        "inputs": {
          "image": {
            "size": [32, 24],
            "base": 0.15,
            "layers": [
              { "shape": "disc", "cx": 10, "cy": 12, "r": 6, "v": 0.8 },
              { "shape": "rect", "x": 21, "y": 4, "w": 8, "h": 15, "v": 0.55 },
              { "shape": "checker", "cell": 2, "lo": 0.25, "hi": 0.65, "x": 3, "y": 19, "w": 13, "h": 5 }
            ],
            "noise": { "seed": 17, "amp": 0.04 }
          }
        }
      },
      "starter": ["sx = const[kind=weights,first=1,centre=2,last=1]()", "sy = transpose(sx)"],
      "hint": [
        {
          "zh": "分开检查两个方向。对比台阶延伸的方向与亮度突变的方向，哪一种平滑会跨过台阶？",
          "en": "Inspect the directions separately. Compare the direction the edge extends with the direction brightness changes. Which smoothing would cross the step?"
