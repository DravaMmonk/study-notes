{
  "title": { "zh": "黑框", "en": "Black frame" },
  "intro": [
    {
      "t": {
        "zh": "一块别人搭的去噪电路，输出四周一圈发黑。图的边上，滤波器要读的邻居有一些在图外。",
        "en": "Someone else’s denoising circuit leaves a dark band round the edge of every output. At the edge, some of the neighbours the filter reads lie outside the picture."
      }
    }
  ],
  "after": {
    "zh": "图外没有观测，滤波器只能假设那里是什么：补 0、延续边缘、循环、镜像，各是一种<wiki-ref to=\"border\"></wiki-ref>。对不对，看图外实际是什么。",
    "en": "Nothing was observed outside the picture, so the filter can only assume what is there: zero, the edge continued, wrapped around, or mirrored, each a <wiki-ref to=\"border\"></wiki-ref>. Which is right depends on what really lies outside."
  },
  "tasks": [
    {
      "id": "paper",
      "kind": "circuit",
      "step": { "zh": "单据", "en": "A document" },
      "brief": {
        "zh": "单据四周是同样的纸。去掉黑框。",
        "en": "The document is surrounded by more of the same paper. Remove the dark band."
      },
      "inputs": [{ "name": "photo", "label": { "zh": "照片", "en": "Photo" } }],
      "outputs": [
        { "name": "out", "label": { "zh": "去噪", "en": "Denoised" } }
      ],
      "starter": [
        "k = const[kind=kernel3,k1=0.1111111111111111,k2=0.1111111111111111,k3=0.1111111111111111,k4=0.1111111111111111,k5=0.1111111111111111,k6=0.1111111111111111,k7=0.1111111111111111,k8=0.1111111111111111,k9=0.1111111111111111]()",
        "f = filter3[outside=zero](photo,k)",
        "out <- f"
      ],
      "tests": [
        {
          "inputs": {
            "photo": [
              [0.15, 0.15, 0.15, 0.15, 0.15, 0.15],
              [0.15, 0.85, 0.85, 0.85, 0.85, 0.15],
              [0.15, 0.85, 0.3, 0.3, 0.85, 0.15],
              [0.15, 0.85, 0.85, 0.85, 0.85, 0.15],
              [0.15, 0.15, 0.15, 0.15, 0.15, 0.15]
            ]
          },
          "expect": {
            "out": [
              [
                0.22777777777777777,
                0.3055555555555555,
                0.3833333333333333,
                0.3833333333333333,
                0.3055555555555555,
                0.22777777777777777
              ],
              [
                0.3055555555555555,
                0.39999999999999997,
                0.4944444444444444,
                0.4944444444444444,
                0.39999999999999997,
                0.3055555555555555
              ],
              [
                0.3833333333333333,
                0.5555555555555556,
                0.7277777777777777,
                0.7277777777777777,
                0.5555555555555556,
                0.3833333333333333
              ],
              [
                0.3055555555555555,
                0.39999999999999997,
                0.4944444444444444,
                0.4944444444444444,
                0.39999999999999997,
                0.3055555555555555
              ],
              [
                0.22777777777777777,
                0.3055555555555555,
                0.3833333333333333,
                0.3833333333333333,
                0.3055555555555555,
                0.22777777777777777
              ]
            ]
          }
        }
      ],
      "hidden": [],
      "solution": [
        "k = const[kind=kernel3,k1=0.1111111111111111,k2=0.1111111111111111,k3=0.1111111111111111,k4=0.1111111111111111,k5=0.1111111111111111,k6=0.1111111111111111,k7=0.1111111111111111,k8=0.1111111111111111,k9=0.1111111111111111]()",
        "f = filter3[outside=clamp](photo,k)",
        "out <- f"
      ],
      "naive": [
        "k = const[kind=kernel3,k1=0.1111111111111111,k2=0.1111111111111111,k3=0.1111111111111111,k4=0.1111111111111111,k5=0.1111111111111111,k6=0.1111111111111111,k7=0.1111111111111111,k8=0.1111111111111111,k9=0.1111111111111111]()",
        "f = filter3[outside=zero](photo,k)",
        "out <- f"
      ],
      "naiveWhy": {
        "zh": "图外取 0，等于假设纸外面是黑的。",
        "en": "Reading zero outside assumes the paper is black beyond the edge."
      },
      "configurations": { "*.outside": ["zero", "clamp", "wrap", "reflect"] }
    },
    {
      "id": "tiles",
      "kind": "circuit",
      "step": { "zh": "花砖", "en": "Tiles" },
      "brief": {
        "zh": "地砖的花纹一块块重复，照片正好拍下一整块。让边上和中间一样。",
        "en": "The floor tiles repeat block after block, and the photo holds exactly one block. Make the edge match the middle."
      },
      "inputs": [{ "name": "photo", "label": { "zh": "照片", "en": "Photo" } }],
      "outputs": [{ "name": "out", "label": { "zh": "去噪", "en": "Denoised" } }],
      "starter": [
        "k = const[kind=kernel3,k1=0.1111111111111111,k2=0.1111111111111111,k3=0.1111111111111111,k4=0.1111111111111111,k5=0.1111111111111111,k6=0.1111111111111111,k7=0.1111111111111111,k8=0.1111111111111111,k9=0.1111111111111111]()",
        "f = filter3[outside=zero](photo,k)",
        "out <- f"
      ],
      "tests": [
        {
          "inputs": {
            "photo": [[0.2, 0.8, 0.5, 0.8], [0.8, 0.2, 0.8, 0.5], [0.5, 0.8, 0.2, 0.8], [0.8, 0.5, 0.8, 0.2]]
          },
          "expect": {
            "out": [
              [0.5333333333333333, 0.6, 0.5666666666666667, 0.6],
              [0.6, 0.5333333333333333, 0.6, 0.5666666666666667],
              [0.5666666666666667, 0.6, 0.5333333333333333, 0.6],
              [0.6, 0.5666666666666667, 0.6, 0.5333333333333333]
            ]
          }
        }
      ],
      "hidden": [],
      "solution": [
        "k = const[kind=kernel3,k1=0.1111111111111111,k2=0.1111111111111111,k3=0.1111111111111111,k4=0.1111111111111111,k5=0.1111111111111111,k6=0.1111111111111111,k7=0.1111111111111111,k8=0.1111111111111111,k9=0.1111111111111111]()",
        "f = filter3[outside=wrap](photo,k)",
        "out <- f"
      ],
      "naive": [
        "k = const[kind=kernel3,k1=0.1111111111111111,k2=0.1111111111111111,k3=0.1111111111111111,k4=0.1111111111111111,k5=0.1111111111111111,k6=0.1111111111111111,k7=0.1111111111111111,k8=0.1111111111111111,k9=0.1111111111111111]()",
        "f = filter3[outside=zero](photo,k)",
        "out <- f"
      ],
      "naiveWhy": {
        "zh": "花纹是重复的：图外接着的是另一边。",
        "en": "The pattern repeats: beyond one edge comes the other side."
      }
    }
  ]
}
