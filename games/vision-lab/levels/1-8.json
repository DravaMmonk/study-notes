      "solution": [
        "dx = const[kind=weights,first=0.5,centre=0,last=-0.5]()",
        "dy = transpose(dx)",
        "sx = const[kind=weights,first=1,centre=2,last=1]()",
        "sy = transpose(sx)",
        "v = spatialProcessor[form=separable,outside=clamp](image,dx,sy)",
        "vY = spatialProcessor[form=separable,outside=clamp](image,sx,dy)",
        "m = magnitude(v,vY)",
        "gx <- v",
        "gy <- vY",
        "strength <- m"
