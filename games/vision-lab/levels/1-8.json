          "expect": {
            "gx": [[0, 0, 0], [0, 0, 0], [0, 0, 0]],
            "gy": [[0, 0, 0], [0, 0, 0], [0, 0, 0]],
            "strength": [[0, 0, 0], [0, 0, 0], [0, 0, 0]]
