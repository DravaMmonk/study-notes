                  "boxes": [{ "at": [1, 0.35, 0], "size": [0.6, 0.6, 0.6] }]
                }
              ]
            },
            {
              "size": [32, 24],
              "camera": { "yaw": 0, "pitch": 10, "distance": 6, "f": 1 },
