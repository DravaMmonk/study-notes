              "camera": { "yaw": 0, "pitch": 10, "distance": 6, "f": 1 },
              "light": { "azimuth": 30, "elevation": 60 },
              "floor": "white",
              "objects": [
                {
                  "id": "cube",
                  "class": "cube",
                  "colour": "red",
