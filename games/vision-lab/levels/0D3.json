              "floor": "white",
              "objects": [
                {
                  "id": "cube",
                  "class": "cube",
                  "colour": "red",
                  "boxes": [{ "at": [-0.9, 0.5, 0], "size": [1, 1, 1] }]
                },
                {
                  "id": "screen",
                  "class": "screen",
                  "colour": "grey",
                  "boxes": [{ "at": [1, 0.8, 1.2], "size": [1.6, 1.6, 0.1] }]
