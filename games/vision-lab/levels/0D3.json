{
  "title": { "zh": "一张图片的边界", "en": "The limits of one picture" },
  "intro": [
    {
      "t": {
        "zh": "这道题明确给出全部候选：屏后的物体在一个场景中是蓝色，在另一个场景中是绿色；两者的正面图相同。",
        "en": "For this puzzle the candidates are exhaustive: the object behind the screen is blue in one scene and green in the other, and both have the same front view."
      }
    }
  ],
  "tasks": [
    {
      "id": "0D3",
      "kind": "choice",
