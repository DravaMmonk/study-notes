              [0.52, 0.52, 0.52, 0.52],
              [0.34, 0.34, 0.34, 0.34],
              [0.33999999999999997, 0.33999999999999997, 0.33999999999999997, 0.33999999999999997]
            ]
          }
        }
      ],
      "solution": [
        "zero = const[value=0]()",
        "z = arithmetic[op=mul](image,zero)",
        "s = spectrum2D(image,z)",
        "r = arithmetic[op=mul](s.re,gain)",
        "i = arithmetic[op=mul](s.im,gain)",
        "v = synthesise2D(r,i)",
        "base = convolve[outside=wrap](image,kernel)",
        "out <- v.out",
        "imaginary <- v.imaginary",
        "local <- base",
        "rows = frequencyFilter(image,rowGain)",
        "rowOnly <- rows"
      ],
      "naive": [
        "zero = const[value=0]()",
        "base = convolve[outside=wrap](image,kernel)",
        "z = arithmetic[op=mul](image,zero)",
        "out <- base",
        "imaginary <- z",
        "local <- base",
        "rows = frequencyFilter(image,rowGain)",
        "rowOnly <- rows"
      ],
      "naiveWhy": {
        "zh": "局部平滑会同时削弱有用细节。这里已知干扰集中在指定频率，对应频域处理可以保留其他分量；不声称可自动识别任意干扰。",
        "en": "Local smoothing also suppresses useful detail. Known interference at selected frequencies can be removed while retaining other components; this does not automatically identify arbitrary interference."
      },
      "hint": [
        {
          "zh": "频谱的两分量使用同一增益。先检查重建闭环和虚部残差，再比较局部平滑保留了什么。",
          "en": "Apply the same gain to both components. Check reconstruction and imaginary residual before comparing retained details against local smoothing."
        },
        {
          "zh": "横向频率处理能去掉沿 x 变化的条纹；沿 y 变化的干扰在每行都可能表现为 DC，不能在保留行均值的同时只删掉那部分。",
          "en": "Row filtering can remove variation along x. Variation along y may appear as DC in each row; preserving row means cannot selectively remove that part."
        }
      ],
      "adds": []
    }
