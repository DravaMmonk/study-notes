      },
      "bench": {
        "model": "pinhole",
        "setup": { "H": 3, "f": 2, "object": "arrow", "target": { "of": "h", "value": 1 } },
        "knobs": { "Z": { "label": "Z", "min": 1, "max": 9, "step": 1, "start": 3 } },
        "goal": [{ "of": "h", "label": "h", "near": 1, "atMost": 0.001 }],
        "layout": { "main": ["pinholeRays"], "foot": [{ "panel": ["knobs"] }, { "row": ["goals"] }] }
      },
      "naive": [
        { "set": { "Z": 1 }, "why": { "zh": "这个设置没有达到目标。", "en": "This setting does not meet the goal." } }
      ]
    }
  ]
