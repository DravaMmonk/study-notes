{
  "title": { "zh": "移动物体", "en": "Move the object" },
  "intro": [
    {
      "t": {
        "zh": "针孔相机已经能投影；同一物体距离改变时，像的大小也会变化。",
        "en": "The pinhole projects an object. Moving the same object changes its projected size."
      }
    }
  ],
  "tasks": [
    {
      "id": "1B2",
      "kind": "bench",
      "brief": { "zh": "调整距离，让像高为 1。", "en": "Adjust depth until the image height is 1." },
      "bench": {
        "model": "pinhole",
        "setup": { "H": 2, "f": 2, "object": "arrow", "target": { "of": "h", "value": 1 } },
        "knobs": { "Z": { "label": "Z", "min": 1, "max": 8, "step": 1, "start": 2 } },
        "goal": [{ "of": "h", "label": "h", "near": 1, "atMost": 0.001 }],
        "layout": { "main": ["pinholeRays"], "foot": [{ "panel": ["knobs"] }, { "row": ["goals"] }] }
      },
      "naive": [
        { "set": { "Z": 1 }, "why": { "zh": "这个设置没有达到目标。", "en": "This setting does not meet the goal." } }
      ]
    },
    {
      "id": "1B2_2",
      "kind": "bench",
      "brief": {
        "zh": "调整另一物体的距离，让像高为 1。",
