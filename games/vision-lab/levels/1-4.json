          ]
        }
      }
    },
    {
      "id": "v1_valid",
      "kind": "circuit",
      "step": { "zh": "有效内部", "en": "Valid interior" },
      "adds": ["trim"],
      "brief": {
        "zh": "另一台仪器只接收有完整邻域的结果。按给定半径确定哪些位置可以交付，并匹配输出宽高。",
        "en": "Another instrument accepts results only where the whole neighbourhood is present. Use the supplied radii to identify the usable positions and match the output dimensions."
      },
      "inputs": [
        { "name": "image", "label": { "zh": "图", "en": "Image" } },
        { "name": "kernel", "label": { "zh": "核", "en": "Kernel" } },
        { "name": "r", "type": "vector", "label": { "zh": "有效半径 r", "en": "Valid radii r" } }
      ],
      "outputs": [{ "name": "out", "label": { "zh": "有效结果", "en": "Valid result" } }],
      "tests": [
        {
          "inputs": {
            "image": [[0.6, 0.6, 0.6, 0.6], [0.6, 0.6, 0.6, 0.6], [0.6, 0.6, 0.6, 0.6]],
            "kernel": [
              [0.1111111111111111, 0.1111111111111111, 0.1111111111111111],
              [0.1111111111111111, 0.1111111111111111, 0.1111111111111111],
              [0.1111111111111111, 0.1111111111111111, 0.1111111111111111]
            ],
            "r": { "x": 1, "y": 1 }
          },
          "expect": { "out": [[0.6, 0.6]] }
        },
        {
          "inputs": {
            "image": [[0.1, 0.4, 0.9], [0.7, 0.3, 0.5], [0.2, 0.8, 0.6]],
            "kernel": [[0, 0, 0], [0.25, 0.5, 0.25], [0, 0, 0]],
            "r": { "x": 1, "y": 1 }
          },
          "expect": { "out": [[0.44999999999999996]] }
        }
      ],
      "hidden": [],
      "solution": [
        "k = reverse(kernel)",
        "table = windowTable[outside=zero,axis=x](image,k)",
        "weighted = arithmetic[op=mul](table.samples,table.weights)",
        "summed = reduceRows[mode=sum](weighted)",
        "v = restore(summed,image)",
        "t = trim(v,r)",
        "out <- t"
      ],
      "naive": [
        "k = reverse(kernel)",
        "table = windowTable[outside=zero,axis=x](image,k)",
        "weighted = arithmetic[op=mul](table.samples,table.weights)",
        "summed = reduceRows[mode=sum](weighted)",
        "v = restore(summed,image)",
        "out <- v"
      ],
      "naiveWhy": {
        "zh": "有效输出的尺寸会缩小。换一种补边规则并不能产生这个更小的输出域。",
        "en": "Valid output is smaller. Changing padding alone does not produce that output domain."
      },
      "hint": [
        {
          "zh": "比较输入和目标的左上角。它们是否仍然代表同一个位置？",
          "en": "Compare the upper-left cell of the input and target. Do they still represent the same position?"
        }
      ],
      "carries": true,
      "sample": {
        "inputs": {
          "image": {
            "size": [32, 24],
            "base": 0.15,
            "layers": [
              { "shape": "rect", "x": 0, "y": 0, "w": 9, "h": 14, "v": 0.85 },
              { "shape": "ramp", "axis": "x", "from": 0.8, "to": 0.1 },
              { "shape": "rect", "x": 0, "y": 6, "w": 3, "h": 9, "v": 0.2 },
              { "shape": "rect", "x": 27, "y": 17, "w": 5, "h": 7, "v": 0.9 }
            ]
          },
          "kernel": [
            [0.04, 0.04, 0.04, 0.04, 0.04],
            [0.04, 0.04, 0.04, 0.04, 0.04],
            [0.04, 0.04, 0.04, 0.04, 0.04],
            [0.04, 0.04, 0.04, 0.04, 0.04],
            [0.04, 0.04, 0.04, 0.04, 0.04]
          ],
          "r": { "x": 2, "y": 2 }
        }
      }
    }
  ],
  "builds": {
    "type": "spatialProcessor",
    "name": { "zh": "邻域处理器", "en": "Spatial processor" },
    "desc": {
      "zh": "运行所选形态的已通关电路，对图像应用给定核。",
      "en": "Apply the supplied kernel using the passed board of the selected form."
    },
    "form": "dense",
    "formLabel": { "zh": "通用", "en": "Dense" },
    "task": "v1_border_reflect",
    "settings": ["outside"],
    "defaults": { "outside": "zero" }
  }
}
