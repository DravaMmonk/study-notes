        {
          "inputs": {
            "image": [[0.5, 0.5, 0.5, 0.5], [0.5, 0.5, 0.5, 0.5], [0.5, 0.5, 0.5, 0.5]],
            "amount": 1.4,
            "weights": [[0.274068619061197, 0.45186276187760605, 0.274068619061197]]
