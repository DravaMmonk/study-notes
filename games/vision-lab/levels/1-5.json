{
  "title": { "zh": "把能分解的核分两次算", "en": "Apply a factorable kernel in two passes" },
  "intro": [
    {
      "t": {
        "zh": "<level-ref to=\"1-4\"></level-ref>的处理器已经能处理图边。现在产线要求在同一幅图上跑三种核，逐个检查 5×5 的每一项会超出乘法预算。先用两组权重复现一个例子，再判断哪几种核可以减少计算而保留原结果。",
        "en": "The processor now handles borders. The station needs three filters on the same scan, and checking every entry of each 5×5 kernel exceeds its multiplication budget. First match one example from two weight arrays, then decide which production kernels can save work while keeping the same output. <level-ref to=\"1-4\"></level-ref>"
      }
    }
  ],
  "after": {
    "zh": "\\[K=k_y k_x,\\qquad Y=k_y*(k_x*I)\\] 两次读取采用同一边界规则。5×5 的外积核只需要每像素 5+5 次乘法。",
    "en": "\\[K=k_y k_x,\\qquad Y=k_y*(k_x*I)\\] Use the same boundary rule for both passes. A 5×5 outer-product kernel takes 5+5 products per pixel."
  },
  "builds": {
    "type": "spatialProcessor",
    "name": { "zh": "邻域处理器", "en": "Spatial processor" },
    "desc": {
      "zh": "运行所选形态的已通关电路，对图像应用给定核。",
      "en": "Apply the supplied kernel using the passed board of the selected form."
    },
    "form": "separable",
    "formLabel": { "zh": "可分离", "en": "Separable" },
    "settings": ["outside"],
    "defaults": { "outside": "zero" },
    "task": "v1_separable"
  },
