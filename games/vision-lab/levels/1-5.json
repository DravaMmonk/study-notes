      ],
      "hidden": [],
      "solution": [
        "horizontal = const[kind=direction,x=1,y=0]()",
        "vertical = const[kind=direction,x=0,y=1]()",
        "h = weightedLine[outside=clamp](image,weights,horizontal)",
        "v = weightedLine[outside=clamp](h,weights,vertical)",
        "detail = arithmetic[op=sub](image,v)",
        "scaled = arithmetic[op=mul](detail,amount)",
        "e = arithmetic[op=add](image,scaled)",
        "d = difference(image,v)",
        "smooth <- v",
        "enhanced <- e",
        "change <- d"
      ],
      "naive": [
        "horizontal = const[kind=direction,x=1,y=0]()",
        "vertical = const[kind=direction,x=0,y=1]()",
        "h = weightedLine[outside=clamp](image,weights,horizontal)",
        "v = weightedLine[outside=clamp](h,weights,vertical)",
        "detail = arithmetic[op=sub](image,v)",
        "scaled = arithmetic[op=mul](detail,amount)",
        "e = arithmetic[op=add](v,scaled)",
        "d = difference(image,v)",
        "smooth <- v",
        "enhanced <- e",
        "change <- d"
      ],
      "naiveWhy": {
        "zh": "加到平滑图上只是把抹掉的部分补回来：强度为 1 时得到的正是原图，没有任何增强。",
        "en": "Adding to the smoothed image only restores what was removed: at strength 1 it gives back the original, with no enhancement."
      },
      "hint": [
        {
          "zh": "比较纹理、边缘和常量图。改动大小与要加回的带符号细节承担不同职责。",
          "en": "Compare texture, edges and constants. Change magnitude and the signed detail to add back serve different purposes."
        }
      ],
      "adds": [],
      "intro": [
        {
          "t": {
            "zh": "带符号的细节已经取出。现在按给定强度用它增强图像，并另外输出平滑改动的大小，区分“被移除的变化”和“改动有多大”。 <wiki-ref to=\"smoothing-detail\"></wiki-ref>",
            "en": "The signed detail is now separated. Use it to enhance the image at the supplied strength, and also report the magnitude of the smoothing change, distinguishing the removed variation from how much changed. <wiki-ref to=\"smoothing-detail\"></wiki-ref>"
          }
        }
      ],
      "sample": {
        "inputs": {
          "image": {
            "size": [64, 64],
            "base": 0.25,
            "layers": [
              { "shape": "disc", "cx": 20, "cy": 22, "r": 13, "v": 0.8 },
              { "shape": "rect", "x": 38, "y": 8, "w": 18, "h": 34, "v": 0.55 },
              { "shape": "stripes", "period": 4, "lo": 0.2, "hi": 0.7, "x": 6, "y": 44, "w": 26, "h": 14 },
              { "shape": "checker", "cell": 2, "lo": 0.35, "hi": 0.6, "x": 40, "y": 46, "w": 16, "h": 12 }
            ],
            "noise": { "seed": 7, "amp": 0.06 }
          }
        }
      },
      "carries": true
    }
  ]
}
