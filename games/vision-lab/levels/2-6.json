    {
      "id": "v2_phase",
      "kind": "circuit",
      "step": {
        "zh": "交换幅度与相位",
        "en": "Mix magnitude/phase"
      },
      "brief": {
        "zh": "重建时保留 B 的相位关系，使用 A 的频谱幅度。把 B 的两分量一起缩放到 A 的系数长度；零长度使用给定安全下限 10⁻¹²。 B 中的零系数保留为零。",
        "en": "Reconstruct using B’s phase relationships and A’s magnitudes. Scale both B components together to A’s coefficient lengths; use the supplied 10⁻¹² floor for zero lengths. Zero coefficients in B remain zero."
      },
      "intro": [
        {
          "t": {
            "zh": "系数缩放已能保留方向。现在把它接在两台频谱仪之后：从一张图取得目标幅度，从另一张图保留相位关系，再交给已验证的重建器。 <wiki-ref to=\"phase-structure\"></wiki-ref>",
            "en": "Coefficient rescaling now retains direction. Apply it after two spectrum analysers: take desired magnitudes from one image, preserve phase relationships from the other, and use the earned synthesiser. <wiki-ref to=\"phase-structure\"></wiki-ref>"
          }
        }
      ],
      "inputs": [
        { "name": "amplitudeImage", "label": { "zh": "幅度来源 A", "en": "Magnitude source A" } },
        { "name": "phaseImage", "label": { "zh": "相位来源 B", "en": "Phase source B" } }
      ],
      "outputs": [{ "name": "out", "label": { "zh": "混合重建", "en": "Mixed reconstruction" } }],
      "tests": [
        {
          "inputs": { "amplitudeImage": [[0.2, 0.8, 0.3, 0.5]], "phaseImage": [[0.5, 0.2, 0.8, 0.3]] },
          "expect": { "out": [[0.5, 0.19999999999999996, 0.8, 0.3]] }
        },
        {
          "inputs": {
            "amplitudeImage": [
              [
                0.5,
                0.5414213562373095,
                0.3,
                0.05857864376269048,
                0.09999999999999995,
                0.25857864376269046,
                0.3,
                0.3414213562373095
              ]
            ],
            "phaseImage": [
              [
                0.5474873734152916,
                0.44999999999999996,
                0.05251262658470842,
                -0.19999999999999998,
                0.05251262658470828,
                0.44999999999999996,
                0.5474873734152915,
                0.4999999999999999
              ]
            ]
          },
          "expect": {
            "out": [
              [
                0.44142135623730955,
                0.4000000000000001,
                0.1585786437626906,
                -1.17975505660906e-16,
                0.1585786437626902,
                0.4,
                0.44142135623730955,
                0.4000000000000002
              ]
            ]
          }
        }
      ],
      "hidden": [],
      "solution": [
        "epsilon = const[value=1e-12]()",
        "a = spectrum(amplitudeImage)",
        "b = spectrum(phaseImage)",
        "safe = max(b.mag,epsilon)",
        "scale = arithmetic[op=div](a.mag,safe)",
        "r = arithmetic[op=mul](b.re,scale)",
        "i = arithmetic[op=mul](b.im,scale)",
        "v = synthesise(r,i)",
        "out <- v"
      ],
      "naive": [
        "a = spectrum(amplitudeImage)",
        "zero = const[value=0]()",
        "z = arithmetic[op=mul](a.mag,zero)",
        "v = synthesise(a.mag,z)",
        "out <- v"
      ],
      "views": { "grid": ["plot", "numbers", "pixels"] },
      "naiveWhy": {
        "zh": "把幅度当作全部实部并把虚部设零，会人为指定所有相位，而不是保留 B 的空间关系。",
        "en": "Using magnitudes as real components and zero imaginary components imposes phases instead of retaining B’s spatial relationships."
      },
      "hint": [
