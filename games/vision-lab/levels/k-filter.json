{
  "title": { "zh": "拆开滤波器", "en": "The filter taken apart" },
  "intro": [
    {
      "t": {
        "zh": "有的核拆不成先横后竖，比如锐化。用三点加权搭出能装任意 3×3 核的滤波器。",
        "en": "Some kernels cannot be split into across-then-down, sharpening for one. Build a filter for any 3×3 kernel from three-point weighting."
      }
    }
  ],
  "after": {
    "zh": "核的每一行交给一个三点加权，先把图上下挪好对上那一行，三者相加：和预设的滤波器逐格一样。",
    "en": "Give each row of the kernel to a three-point weighting, with the image moved up or down to meet that row, and add the three: cell for cell the preset filter."
  },
  "tray": "apart",
  "tasks": [
    {
      "id": "filter",
      "kind": "circuit",
      "brief": {
        "zh": "输出和预设的滤波器一样（核的左上角乘左上方的邻居）。",
        "en": "Output the same as the preset filter (the kernel’s top left weighs the neighbour above left)."
      },
      "adds": ["rows3"],
      "configurations": { "shift.axis": ["y"] },
      "inputs": [
        { "name": "photo", "label": { "zh": "图", "en": "Image" } },
        { "name": "kernel", "label": { "zh": "核", "en": "Kernel" } }
      ],
      "outputs": [{ "name": "out", "label": { "zh": "滤波", "en": "Filtered" } }],
      "tests": [
        {
          "inputs": {
            "photo": [
              [0.68, 0.09, 0.62, 0.84, 0.83, 0.52],
              [0.63, 0.37, 0.53, 0.11, 0.68, 0.6],
              [0.28, 0.38, 0.74, 0.44, 0.96, 0.97],
              [0.84, 0.09, 0.08, 0.29, 0.36, 0.7],
              [0.83, 0.56, 0.64, 0.57, 0.03, 0.53]
            ],
            "kernel": [[0, -1, 0], [-1, 5, -1], [0, -1, 0]]
          },
          "expect": {
            "out": [
              [1.3200000000000003, -1.31, 1.02, 1.8000000000000003, 1.2799999999999994, 0.13000000000000012],
              [1.19, 0.22000000000000006, 0.8100000000000004, -1.94, 0.9000000000000005, 0.22999999999999998],
              [
                -0.7299999999999999,
                0.41999999999999993,
                2.27,
                0.10000000000000024,
                2.3499999999999996,
                1.6199999999999997
              ],
              [
                2.16,
                -1.4100000000000001,
                -1.3599999999999999,
                1.3877787807814457e-17,
                -0.18000000000000008,
                0.9400000000000001
              ],
              [
                1.0899999999999994,
                0.6800000000000003,
                1.35,
                1.3199999999999996,
                -1.3399999999999999,
                0.8600000000000003
              ]
            ]
          }
        },
        {
          "inputs": {
            "photo": [
              [0.68, 0.09, 0.62, 0.84, 0.83, 0.52],
              [0.63, 0.37, 0.53, 0.11, 0.68, 0.6],
              [0.28, 0.38, 0.74, 0.44, 0.96, 0.97],
              [0.84, 0.09, 0.08, 0.29, 0.36, 0.7],
              [0.83, 0.56, 0.64, 0.57, 0.03, 0.53]
            ],
            "kernel": [[0.0625, 0.125, 0.0625], [0.125, 0.25, 0.125], [0.0625, 0.125, 0.0625]]
          },
          "expect": {
            "out": [
              [0.540625, 0.39625, 0.503125, 0.67625, 0.6956249999999999, 0.603125],
              [0.491875, 0.44125000000000003, 0.471875, 0.535625, 0.655625, 0.70125],
              [0.45687500000000003, 0.41, 0.4175, 0.475625, 0.6525, 0.7925],
              [0.593125, 0.410625, 0.361875, 0.401875, 0.494375, 0.650625],
              [0.735, 0.5543750000000001, 0.48562500000000003, 0.40312499999999996, 0.32437499999999997, 0.4575]
            ]
          }
        },
        {
          "inputs": {
            "photo": [
              [0.68, 0.09, 0.62, 0.84, 0.83, 0.52],
              [0.63, 0.37, 0.53, 0.11, 0.68, 0.6],
              [0.28, 0.38, 0.74, 0.44, 0.96, 0.97],
              [0.84, 0.09, 0.08, 0.29, 0.36, 0.7],
              [0.83, 0.56, 0.64, 0.57, 0.03, 0.53]
            ],
            "kernel": [[0.3, 0, 0], [0, 0.5, 0], [0, 0, 0.2]]
          },
          "expect": {
            "out": [
              [0.618, 0.35500000000000004, 0.359, 0.742, 0.7869999999999999, 0.629],
              [0.595, 0.537, 0.38, 0.433, 0.786, 0.743],
              [0.34700000000000003, 0.395, 0.539, 0.451, 0.653, 0.829],
              [0.616, 0.257, 0.26799999999999996, 0.373, 0.41800000000000004, 0.744],
              [0.779, 0.66, 0.461, 0.315, 0.20800000000000002, 0.47900000000000004]
            ]
          }
        }
      ],
      "solution": [
        "k = rows3(kernel)",
        "down = shift[axis=y,by=forward](photo)",
        "up = shift[axis=y,by=backward](photo)",
        "t = line3[axis=x](down,k.top)",
        "m = line3[axis=x](photo,k.middle)",
        "b = line3[axis=x](up,k.bottom)",
        "s1 = arithmetic[op=add](t,m)",
        "s2 = arithmetic[op=add](s1,b)",
        "out <- s2"
      ],
      "naive": [
        "k = rows3(kernel)",
        "a = line3[axis=x](photo,k.middle)",
        "b = line3[axis=y](a,k.middle)",
        "out <- b"
      ],
      "naiveWhy": {
        "zh": "用中间那行先横后竖：锐化这种核拆不开，四角和上下的权重都对不上。",
        "en": "The middle row across then down: a kernel like sharpening does not split, so the corners and the top and bottom rows come out wrong."
      }
    }
  ]
}
