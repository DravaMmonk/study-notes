                  "boxes": [{ "at": [0, 0.6, 1], "size": [2, 1.6, 0.1] }]
                },
                {
                  "id": "crate",
                  "class": "crate",
                  "colour": "yellow",
                  "boxes": [{ "at": [-1.6, 0.3, 0], "size": [0.4, 0.6, 0.4] }]
                },
                {
                  "id": "pet",
