{
  "title": { "zh": "取较小值", "en": "Take the smaller value" },
  "intro": [
    {
      "t": {
        "zh": "显示限制也有上限。搭出比较任意两个值的元件，才能处理不同的上限。",
        "en": "The display range also has an upper bound. Build a part that compares any two values so different bounds can be handled."
      }
    }
  ],
  "tasks": [
    {
      "id": "1F1a_hand",
      "kind": "choice",
      "brief": { "zh": "选择每组中较小的数。", "en": "Choose the smaller value in each pair." },
      "judge": "match",
      "rounds": [
        {
          "items": [
            { "prompt": { "zh": "0.7 和 1 中较小的是？", "en": "Which is smaller, 0.7 or 1?" }, "is": "a" },
            { "prompt": { "zh": "1.3 和 1 中较小的是？", "en": "Which is smaller, 1.3 or 1?" }, "is": "b" }
          ],
          "options": [
            { "id": "a", "label": "0.7", "is": "a" },
            { "id": "b", "label": "1", "is": "b" },
            { "id": "c", "label": "1.3", "is": "c" }
          ]
        }
      ]
    },
    {
      "id": "1F1a",
      "kind": "circuit",
      "brief": { "zh": "交出 a 和 b 中较小的数。", "en": "Output the smaller of a and b." },
      "inputs": [{ "name": "a", "label": "a" }, { "name": "b", "label": "b" }],
      "outputs": [{ "name": "out", "label": { "zh": "结果", "en": "Result" } }],
      "tests": [
        { "inputs": { "a": 0, "b": 1 }, "expect": { "out": 0 } },
        { "inputs": { "a": 3, "b": 2 }, "expect": { "out": 2 } },
        { "inputs": { "a": 2, "b": 2 }, "expect": { "out": 2 } }
      ],
      "solution": ["c = less(a, b)", "p = select(c, a, b)", "out <- p"],
      "hidden": [
        { "inputs": { "a": -2, "b": -5 }, "expect": { "out": -5 } },
        { "inputs": { "a": [[2, 5]], "b": [[4, 3]] }, "expect": { "out": [[2, 3]] } }
      ]
    }
  ],
  "builds": {
    "type": "smaller",
    "name": { "zh": "取较小值", "en": "Take the smaller value" },
    "desc": { "zh": "取两个输入中较小的值。", "en": "Returns the smaller of two input values." }
  }
}
