{
  "title": { "zh": "清晰的范围", "en": "Depth of field" },
  "intro": [
    {
      "t": {
        "zh": "对焦距离固定时，光圈大小也影响清晰的深度范围。",
        "en": "At a fixed focus distance, aperture also affects the range judged sharp."
      }
    }
  ],
  "tasks": [
    {
      "id": "1G3",
      "kind": "bench",
      "brief": {
        "zh": "保持对焦距离，调整光圈，使清晰深度范围至少为 3000 毫米。",
        "en": "Keep focus fixed and adjust the aperture until the sharp depth range is at least 3000 mm."
      },
      "bench": {
        "model": "lens",
        "setup": {
          "F": 50,
          "A0": 5,
          "cMax": 0.03,
          "objects": [
            { "id": "near", "z": 1000, "label": { "zh": "近处", "en": "Near" } },
            { "id": "far", "z": 4000, "label": { "zh": "远处", "en": "Far" } }
          ]
        },
        "knobs": {
          "A": { "label": "A", "min": 1, "max": 10, "step": 1, "start": 5 },
          "focus": {
            "label": { "zh": "对焦距离", "en": "Focus distance" },
            "min": 2000,
            "max": 2000,
            "step": 1,
            "start": 2000,
            "fixed": true
          }
        },
        "goal": [{ "of": "dof", "label": { "zh": "清晰深度范围", "en": "Sharp depth range" }, "atLeast": 3000 }],
        "layout": { "main": ["lensRays", "blurCurve"], "foot": [{ "panel": ["knobs"] }, { "row": ["goals"] }] }
      },
      "naive": [
        { "set": { "A": 5 }, "why": { "zh": "这个设置没有达到目标。", "en": "This setting does not meet the goal." } }
      ]
    }
  ]
}
