{
  "title": { "zh": "比较放大结果", "en": "Compare enlargements" },
  "intro": [
    {
      "t": {
        "zh": "两种缩放器对新位置作出不同选择。比较它们的输出。",
        "en": "The two resizers treat new positions differently. Compare their outputs."
      }
    }
  ],
  "tasks": [
    {
      "id": "1E4",
      "kind": "circuit",
      "brief": { "zh": "分别交出最近邻和双线性缩放结果。", "en": "Output the nearest-neighbour and bilinear resize results." },
      "inputs": [
        { "name": "image", "label": "image" },
        { "name": "w", "label": "w" },
        { "name": "h", "label": "h" }
      ],
      "outputs": [
        { "name": "nearest", "label": { "zh": "最近邻", "en": "Nearest" } },
        { "name": "linear", "label": { "zh": "双线性", "en": "Bilinear" } }
      ],
      "tests": [
        {
          "inputs": { "image": [[0, 1]], "w": 5, "h": 1 },
          "expect": { "nearest": [[0, 0, 1, 1, 1]], "linear": [[0, 0.25, 0.5, 0.75, 1]] }
        }
      ],
      "hidden": [
        {
          "inputs": { "image": [[1, 0]], "w": 3, "h": 1 },
          "expect": { "nearest": [[1, 0, 0]], "linear": [[1, 0.5, 0]] }
        }
      ],
      "solution": [
        "a = resizeNearest(image, w, h)",
        "b = resizeLinear(image, w, h)",
        "nearest <- a",
        "linear <- b"
      ],
      "naive": ["a = resizeNearest(image, w, h)", "nearest <- a", "linear <- a"]
    }
  ]
}
