{
  "title": { "zh": "坐标从哪里取", "en": "Find source positions" },
  "intro": [
    {
      "t": {
        "zh": "缩放时，输出位置要映射回原图。单个输出位置也需要一个定义明确的来源。",
        "en": "A resized output position must map back to the source. A single output position also needs a well-defined source."
      }
    }
  ],
  "tasks": [
    {
      "id": "1E1h",
      "kind": "circuit",
      "brief": {
        "zh": "原轴有 m 个位置，新轴有 n 个位置；交出新位置 i 对应的原坐标。首尾对齐；n 为 1 时取原轴中心。",
        "en": "Given m source positions and n output positions, map output i to a source coordinate. Align endpoints; for n = 1 use the source centre."
      },
      "inputs": [{ "name": "i", "label": "i" }, { "name": "m", "label": "m" }, { "name": "n", "label": "n" }],
      "outputs": [{ "name": "out", "label": { "zh": "结果", "en": "Result" } }],
      "tests": [
        { "inputs": { "i": [[0, 1, 2, 3, 4]], "m": 3, "n": 5 }, "expect": { "out": [[0, 0.5, 1, 1.5, 2]] } },
        { "inputs": { "i": 0, "m": 4, "n": 1 }, "expect": { "out": 1.5 } }
      ],
      "solution": [
        "one = const[value=1]()",
        "half = const[value=0.5]()",
        "m1 = sub(m, one)",
        "n1 = sub(n, one)",
        "big = less(one, n)",
        "safe = larger(n1, one)",
        "k = div(m1, safe)",
        "step = mul(i, k)",
        "mid = mul(m1, half)",
        "s = select(big, step, mid)",
        "out <- s"
      ],
      "hidden": [{ "inputs": { "i": [[0, 1, 2]], "m": 2, "n": 3 }, "expect": { "out": [[0, 0.5, 1]] } }]
    }
  ],
  "builds": {
    "type": "sampleAxis",
    "name": { "zh": "映射采样坐标", "en": "Map sample coordinates" },
    "desc": {
      "zh": "将输出轴坐标映射到端点对齐的原轴坐标。",
      "en": "Maps output-axis positions to endpoint-aligned source-axis positions."
    }
  }
}
