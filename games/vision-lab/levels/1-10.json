              [0.9650524620306812, 1.5462350698798548, 0.5811905640893933],
              [0.9644167946072555, 1.5462338413996504, 0.581817046792395],
              [0.9650524620306807, 1.5462350698798548, 0.5811905640893936]
            ],
            "mask": [[1, 1, 0], [1, 1, 0], [1, 1, 0]]
          }
        }
      ],
      "solution": [
        "quarter = const[value=0.25]()",
        "half = const[value=0.5]()",
        "gray = channelMeasure(image,quarter,half,quarter)",
        "smooth = separable3[outside=clamp](gray,side,centre,side)",
        "edge = sobel[outside=clamp](smooth,kernel)",
        "mark = less(threshold,edge.strength)",
        "strength <- edge.strength",
        "mask <- mark"
      ],
      "naive": [
        "quarter = const[value=0.25]()",
        "half = const[value=0.5]()",
        "gray = channelMeasure(image,quarter,half,quarter)",
        "edge = sobel[outside=clamp](gray,kernel)",
        "mark = less(threshold,edge.strength)",
        "strength <- edge.strength",
        "mask <- mark"
      ],
      "naiveWhy": {
        "zh": "阈值不能代替输入尺度的控制。没有前置平滑时，细碎变化也会进入方向响应。",
        "en": "Thresholding does not replace scale control: fine variation reaches the directional response without preprocessing."
      },
      "hint": [
        {
          "zh": "分别检查单通道读数、平滑图和方向响应，找出干扰第一次被压低的位置。",
          "en": "Inspect channel measurement, smoothing and directional responses to locate where nuisance is suppressed."
        }
      ],
      "starter": ["quarter = const[value=0.25]()", "half = const[value=0.5]()"],
