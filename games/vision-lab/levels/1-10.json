      "solution": [
        "quarter = const[value=0.25]()",
        "half = const[value=0.5]()",
        "gray = channelMeasure(image,quarter,half,quarter)",
        "smooth = separable3[outside=clamp](gray,weights)",
        "k = reverse(kernel)",
        "table = windowTable[outside=clamp,axis=x](smooth,k)",
        "weighted = arithmetic[op=mul](table.samples,table.weights)",
        "summed = reduceRows[mode=sum](weighted)",
        "v = restore(summed,smooth)",
        "kY = reverse(kernel)",
        "tableY = windowTable[outside=clamp,axis=y](smooth,kY)",
        "weightedY = arithmetic[op=mul](tableY.samples,tableY.weights)",
        "summedY = reduceRows[mode=sum](weightedY)",
        "vY = restore(summedY,smooth)",
        "horizontal = const[kind=direction,x=1,y=0]()",
        "vertical = const[kind=direction,x=0,y=1]()",
        "sobelWeights = const[kind=weights,first=1,centre=2,last=1]()",
        "x = weightedLine[outside=clamp](v,sobelWeights,vertical)",
        "y = weightedLine[outside=clamp](vY,sobelWeights,horizontal)",
        "m = magnitude(x,y)",
        "mark = less(threshold,m)",
        "strength <- m",
        "mask <- mark"
      ],
      "naive": [
        "quarter = const[value=0.25]()",
