{
  "title": { "zh": "类别之外", "en": "Beyond the class" },
  "intro": [
    {
      "t": {
        "zh": "一张类别标签描述整张图，却无法指出多个物体各在何处。",
        "en": "A class label describes the image but does not locate each object."
      }
    }
  ],
  "tasks": [
    {
      "id": "0A2",
      "kind": "choice",
      "brief": {
        "zh": "每题选择刚好包含所需信息的输出。",
        "en": "For each question choose the output containing just the required information."
      },
      "hint": [
        { "zh": "问题是否要求分开多个物体？", "en": "Does the question require individual objects to be distinguished?" }
      ],
      "judge": { "fields": { "mode": "exact" } },
      "rounds": [
        {
          "items": [
            {
              "prompt": { "zh": "图片里有橙色物体吗？需要输出类别。", "en": "Is there an orange object? Give its class." },
              "needs": ["class"]
            },
            {
              "prompt": { "zh": "指出每个橙色物体的类别和位置。", "en": "Give the class and position of each orange object." },
              "needs": ["class", "location", "instance"]
            }
          ],
          "options": [
            { "id": "label", "label": { "zh": "一张类别标签", "en": "One class label" }, "gives": ["class"] },
            { "id": "box", "label": { "zh": "一个位置框", "en": "One bounding box" }, "gives": ["location"] },
            {
              "id": "detect",
              "label": { "zh": "每个物体的类别和位置框", "en": "A class and box for each object" },
              "gives": ["class", "location", "instance"]
            },
            {
              "id": "sem",
              "label": { "zh": "每个像素的类别", "en": "A class per pixel" },
              "gives": ["class", "region", "location"]
            },
            {
              "id": "inst",
              "label": { "zh": "每个像素的类别和物体编号", "en": "A class and object ID per pixel" },
              "gives": ["class", "region", "instance", "location"]
            },
            {
              "id": "depth",
              "label": { "zh": "每个像素的距离", "en": "A distance at each pixel" },
              "gives": ["depth", "region"]
            }
          ],
          "reference": {
            "size": [32, 24],
            "camera": { "yaw": 0, "pitch": 10, "distance": 6, "f": 1 },
            "light": { "azimuth": 30, "elevation": 60 },
            "floor": "white",
            "objects": [
              {
                "id": "cat1",
                "class": "block",
                "colour": "orange",
                "boxes": [
                  { "at": [-0.65, 0.35, 0], "size": [0.55, 0.55, 0.42] },
                  { "at": [-0.65, 0.75, 0], "size": [0.35, 0.3, 0.35] }
                ]
              },
              {
                "id": "cat2",
                "class": "block",
                "colour": "orange",
                "boxes": [
                  { "at": [0.65, 0.35, 0], "size": [0.55, 0.55, 0.42] },
                  { "at": [0.65, 0.75, 0], "size": [0.35, 0.3, 0.35] }
                ]
              }
            ]
          }
        },
        {
          "items": [
            {
              "prompt": { "zh": "指出图中橙色物体的类别和位置。", "en": "Give the class and position of the orange object." },
              "needs": ["class", "location", "instance"]
            }
          ],
          "options": [
            {
              "id": "depth",
              "label": { "zh": "每个像素的距离", "en": "A distance at each pixel" },
              "gives": ["depth", "region"]
            },
            {
              "id": "inst",
              "label": { "zh": "每个像素的类别和物体编号", "en": "A class and object ID per pixel" },
              "gives": ["class", "region", "instance", "location"]
            },
            {
              "id": "sem",
              "label": { "zh": "每个像素的类别", "en": "A class per pixel" },
              "gives": ["class", "region", "location"]
            },
            {
              "id": "detect",
              "label": { "zh": "每个物体的类别和位置框", "en": "A class and box for each object" },
              "gives": ["class", "location", "instance"]
            },
            { "id": "box", "label": { "zh": "一个位置框", "en": "One bounding box" }, "gives": ["location"] },
            { "id": "label", "label": { "zh": "一张类别标签", "en": "One class label" }, "gives": ["class"] }
          ],
          "reference": {
            "size": [32, 24],
            "camera": { "yaw": 0, "pitch": 10, "distance": 6, "f": 1 },
            "light": { "azimuth": 30, "elevation": 60 },
            "floor": "white",
            "objects": [
              {
                "id": "cat1",
                "class": "block",
                "colour": "orange",
                "boxes": [
                  { "at": [0, 0.35, 0], "size": [0.55, 0.55, 0.42] },
                  { "at": [0, 0.75, 0], "size": [0.35, 0.3, 0.35] }
                ]
              }
            ]
          }
        }
      ]
    }
  ]
}
