{
  "title": { "zh": "一张图，不同的问题", "en": "One picture, different questions" },
  "intro": [
    {
      "t": {
        "zh": "机器要回答什么，决定它应当交出什么结果。",
        "en": "What a machine is asked determines what its answer must contain."
      }
    }
  ],
  "tasks": [
    {
      "id": "0A1",
      "kind": "choice",
      "brief": {
        "zh": "每题选出刚好包含所需信息的输出。",
        "en": "For each question choose the output containing just the required information."
      },
      "hint": [{ "zh": "比较问题需要的信息与每个输出。", "en": "Compare what the question needs with each output." }],
      "judge": { "fields": { "mode": "exact" } },
      "rounds": [
        {
          "items": [
            { "prompt": { "zh": "图中是什么类别？", "en": "What class is in the image?" }, "needs": ["class"] },
            {
              "prompt": { "zh": "已知是红色物体，框出它的位置。", "en": "The object is red. Give its location." },
              "needs": ["location"]
            }
          ],
          "options": [
            { "id": "label", "label": { "zh": "一张类别标签", "en": "One class label" }, "gives": ["class"] },
            { "id": "box", "label": { "zh": "一个位置框", "en": "One bounding box" }, "gives": ["location"] },
            {
              "id": "detect",
              "label": { "zh": "每个物体的类别和位置框", "en": "A class and box for each object" },
              "gives": ["class", "location", "instance"]
            },
            {
              "id": "sem",
              "label": { "zh": "每个像素的类别", "en": "A class per pixel" },
              "gives": ["class", "region", "location"]
            },
            {
              "id": "inst",
              "label": { "zh": "每个像素的类别和物体编号", "en": "A class and object ID per pixel" },
              "gives": ["class", "region", "instance", "location"]
            },
            {
              "id": "depth",
              "label": { "zh": "每个像素的距离", "en": "A distance at each pixel" },
              "gives": ["depth", "region"]
            }
          ],
          "reference": {
            "size": [32, 24],
            "camera": { "yaw": 0, "pitch": 10, "distance": 6, "f": 1 },
            "light": { "azimuth": 30, "elevation": 60 },
            "floor": "white",
            "objects": [
              {
                "id": "object",
                "class": "object",
                "colour": "red",
                "boxes": [
                  { "at": [0, 0.35, 0], "size": [0.55, 0.55, 0.42] },
                  { "at": [0, 0.75, 0], "size": [0.35, 0.3, 0.35] }
                ]
              }
            ]
          }
        },
        {
          "items": [
            {
              "prompt": { "zh": "已知是红色物体，指出它的位置。", "en": "The object is red. Give its location." },
              "needs": ["location"]
            },
            { "prompt": { "zh": "图中的物体是什么类别？", "en": "What class is the object?" }, "needs": ["class"] }
          ],
          "options": [
            {
              "id": "depth",
              "label": { "zh": "每个像素的距离", "en": "A distance at each pixel" },
              "gives": ["depth", "region"]
            },
            {
              "id": "inst",
              "label": { "zh": "每个像素的类别和物体编号", "en": "A class and object ID per pixel" },
              "gives": ["class", "region", "instance", "location"]
            },
            {
              "id": "sem",
              "label": { "zh": "每个像素的类别", "en": "A class per pixel" },
              "gives": ["class", "region", "location"]
            },
            {
              "id": "detect",
              "label": { "zh": "每个物体的类别和位置框", "en": "A class and box for each object" },
              "gives": ["class", "location", "instance"]
            },
            { "id": "box", "label": { "zh": "一个位置框", "en": "One bounding box" }, "gives": ["location"] },
            { "id": "label", "label": { "zh": "一张类别标签", "en": "One class label" }, "gives": ["class"] }
          ],
          "reference": {
            "size": [32, 24],
            "camera": { "yaw": 0, "pitch": 10, "distance": 6, "f": 1 },
            "light": { "azimuth": 30, "elevation": 60 },
            "floor": "white",
            "objects": [
              {
                "id": "object",
                "class": "object",
                "colour": "red",
                "boxes": [
                  { "at": [0, 0.35, 0], "size": [0.55, 0.55, 0.42] },
                  { "at": [0, 0.75, 0], "size": [0.35, 0.3, 0.35] }
                ]
              }
            ]
          }
        }
      ]
    }
  ]
}
