{
  "title": { "zh": "质检台", "en": "Inspection station" },
  "intro": [
    {
      "t": {
        "zh": "质检台要处理不同的工件、两个候选位置和各自的容差。对齐之后，控制台只显示需要复查的格子。",
        "en": "The station handles different parts, two candidate positions and a tolerance for each part. After alignment, the console shows only cells that need review."
      }
    }
  ],
  "tasks": [
    {
      "id": "inspection_production",
      "kind": "circuit",
      "brief": {
        "zh": "对每个工件选总差较小的偏移，平手保留甲，再输出严格超过容差的格子。",
        "en": "For each part, choose the lower-error offset, keeping A on ties, and flag cells strictly above tolerance."
      },
      "inputs": [
        { "name": "observed", "label": { "zh": "观测", "en": "Observation" } },
        { "name": "reference", "label": { "zh": "参照", "en": "Reference" } },
        { "name": "first", "label": { "zh": "候选偏移甲", "en": "Candidate offset A" }, "type": "vector" },
        { "name": "second", "label": { "zh": "候选偏移乙", "en": "Candidate offset B" }, "type": "vector" },
        { "name": "tolerance", "label": { "zh": "门槛", "en": "Threshold" } }
      ],
      "outputs": [{ "name": "out", "label": { "zh": "缺陷标记", "en": "Defect mask" } }],
      "tests": [
        {
          "inputs": {
            "observed": [[0, 0.75, 0.375, 0]],
            "reference": [[0.75, 0.5, 0, 0]],
            "first": { "x": 1, "y": 0 },
            "second": { "x": -1, "y": 0 },
            "tolerance": 0.0625
          },
          "expect": { "out": [[0, 1, 0, 0]] }
        },
        {
          "inputs": {
            "observed": [[0, 0], [0.5, 0.375], [0, 0.75]],
            "reference": [[0.5, 0.125], [0, 0.75], [0, 0]],
            "first": { "x": 0, "y": -1 },
            "second": { "x": 0, "y": 1 },
            "tolerance": 0.25
          },
          "expect": { "out": [[0, 0], [0, 0], [0, 0]] }
        }
      ],
      "hidden": [
        {
          "inputs": {
            "observed": [[0.5, 0.125, 0, 0]],
            "reference": [[0, 0.25, 0.125, 0]],
            "first": { "x": 1, "y": 0 },
            "second": { "x": -1, "y": 0 },
            "tolerance": 0.125
          },
          "expect": { "out": [[0, 1, 0, 0]] }
        }
      ],
      "solution": [
        "a = shift(observed,first)",
        "b = shift(observed,second)",
        "da = arithmetic[op=sub](a,reference)",
        "db = arithmetic[op=sub](b,reference)",
        "ma = abs(da)",
        "mb = abs(db)",
        "score_a = totalDifference(ma)",
        "score_b = totalDifference(mb)",
        "prefer_b = less(score_b,score_a)",
        "best = chooseDifference(prefer_b,mb,ma)",
        "m = less(tolerance,best)",
        "out <- m"
      ],
      "naive": [
        "a = shift(observed,first)",
        "b = shift(observed,second)",
        "da = arithmetic[op=sub](a,reference)",
        "db = arithmetic[op=sub](b,reference)",
        "ma = abs(da)",
        "mb = abs(db)",
        "m = less(tolerance,ma)",
        "out <- m"
      ],
      "naiveWhy": {
        "zh": "还没选出更可信的偏移时，门槛可能把整段错位当成缺陷。",
        "en": "With alignment still unresolved, the threshold can mistake an entire displaced edge for a defect."
      },
      "carry": "q-position",
      "hint": [
        {
          "zh": "保留前一张电路里对齐后的差值，把它接给判定环节。",
          "en": "Feed the aligned difference from your carried circuit into the decision stage."
        }
      ]
    }
  ],
  "after": {
    "zh": "先解释整体位移，再判断局部残差，能把夹具位置变化和需要复查的读数分开。 <wiki-ref to=\"alignment-score\"></wiki-ref> <wiki-ref to=\"decision-evidence\"></wiki-ref>",
    "en": "Explaining the global displacement before checking local residuals separates fixture motion from readings that need review. <wiki-ref to=\"alignment-score\"></wiki-ref> <wiki-ref to=\"decision-evidence\"></wiki-ref>"
  }
}
