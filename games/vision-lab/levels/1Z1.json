{
  "title": { "zh": "图像处理台", "en": "Image processing station" },
  "intro": [
    {
      "t": {
        "zh": "裁剪、缩放和量化各自解决了一个问题。组合它们以处理一张图。",
        "en": "Cropping, resizing, and quantisation each solve part of the problem. Combine them to process an image."
      }
    }
  ],
  "tasks": [
    {
      "id": "1Z1",
      "kind": "circuit",
      "brief": {
        "zh": "裁剪指定区域，双线性缩放到目标宽高，再量化到 L 个等级。",
        "en": "Crop the given region, resize it bilinearly, then quantise it to L levels."
      },
      "inputs": [
        { "name": "image", "label": "image" },
        { "name": "x0", "label": "x0" },
        { "name": "y0", "label": "y0" },
        { "name": "cw", "label": "cw" },
        { "name": "ch", "label": "ch" },
        { "name": "w", "label": "w" },
        { "name": "h", "label": "h" },
        { "name": "L", "label": "L" }
      ],
      "outputs": [{ "name": "out", "label": { "zh": "结果", "en": "Result" } }],
      "tests": [
        {
          "inputs": {
            "image": [[0, 0, 0], [0, 1, 0], [0, 0, 0]],
            "x0": 0,
            "y0": 0,
            "cw": 2,
            "ch": 2,
            "w": 3,
            "h": 3,
            "L": 3
          },
          "expect": { "out": [[0, 0, 0], [0, 0.5, 0.5], [0, 0.5, 1]] }
        }
      ],
      "solution": [
        "c = crop(image, x0, y0, cw, ch)",
        "r = resizeLinear(c, w, h)",
        "q = quantise(r, L)",
        "out <- q"
      ],
      "hidden": [
        {
          "inputs": { "image": [[0.2, 0.6]], "x0": 0, "y0": 0, "cw": 2, "ch": 1, "w": 3, "h": 1, "L": 3 },
          "expect": { "out": [[0, 0.5, 0.5]] }
        }
      ]
    }
  ]
}
