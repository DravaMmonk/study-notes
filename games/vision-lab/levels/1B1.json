{
  "title": { "zh": "穿过小孔", "en": "Through the opening" },
  "intro": [
    {
      "t": {
        "zh": "图像来自场景中的光。先用理想针孔观察一个点投到哪里。",
        "en": "An image comes from the scene. Start with an ideal pinhole and a single projected point."
      }
    }
  ],
  "tasks": [
    {
      "id": "1B1",
      "kind": "bench",
      "brief": { "zh": "移动物点，使投影落在目标上。", "en": "Move the point so its projection reaches the target." },
      "bench": {
        "model": "pinhole",
        "setup": { "Z": 4, "f": 2, "object": "point", "target": { "of": "u", "value": 1 } },
        "knobs": { "X": { "label": "X", "min": -4, "max": 4, "step": 1, "start": 0 } },
        "goal": [{ "of": "u", "label": "u", "near": 1, "atMost": 0.001 }],
        "layout": { "main": ["pinholeRays"], "foot": [{ "panel": ["knobs"] }, { "row": ["goals"] }] }
      },
      "naive": [
        { "set": { "X": -2 }, "why": { "zh": "这个设置没有达到目标。", "en": "This setting does not meet the goal." } }
      ]
    },
    {
      "id": "1B1_2",
      "kind": "bench",
      "brief": {
        "zh": "移动物点，使投影落在左侧的目标上。",
        "en": "Move the point so its projection reaches the target on the left."
      },
      "bench": {
        "model": "pinhole",
        "setup": { "Z": 4, "f": 2, "object": "point", "target": { "of": "u", "value": -1 } },
        "knobs": { "X": { "label": "X", "min": -4, "max": 4, "step": 1, "start": 0 } },
        "goal": [{ "of": "u", "label": "u", "near": -1, "atMost": 0.001 }],
        "layout": { "main": ["pinholeRays"], "foot": [{ "panel": ["knobs"] }, { "row": ["goals"] }] }
      },
      "naive": [
        { "set": { "X": 2 }, "why": { "zh": "这个设置没有达到目标。", "en": "This setting does not meet the goal." } }
      ]
    }
  ]
}
