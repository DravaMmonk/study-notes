{
  "title": { "zh": "比较位置", "en": "Compare positions" },
  "intro": [
    { "t": { "zh": "现有流水线需要处理新的数值条件。", "en": "The current pipeline must handle a new numeric condition." } }
  ],
  "tasks": [
    {
      "id": "1E1e",
      "kind": "circuit",
      "brief": {
        "zh": "将 a 向下取整；如果结果小于 b 交出 1，否则交出 0。",
        "en": "Round a down; output 1 if the result is less than b and 0 otherwise."
      },
      "inputs": [{ "name": "a", "label": "a" }, { "name": "b", "label": "b" }],
      "outputs": [{ "name": "out", "label": { "zh": "结果", "en": "Result" } }],
      "tests": [
        { "inputs": { "a": 1.8, "b": 2 }, "expect": { "out": 1 } },
        { "inputs": { "a": 2.2, "b": 2 }, "expect": { "out": 0 } }
      ],
      "solution": ["f = floor(a)", "p = less(f, b)", "out <- p"],
      "hidden": [{ "inputs": { "a": -0.2, "b": 0 }, "expect": { "out": 1 } }]
    }
  ],
  "adds": ["less"]
}
