{
  "title": { "zh": "给检查系统定任务", "en": "Specify an inspection task" },
  "intro": [
    {
      "t": {
        "zh": "检查系统需要指出画面中每个红色几何物体的位置。",
        "en": "An inspection system must locate each red geometric object in the picture."
      }
    }
  ],
  "tasks": [
    {
      "id": "0D1",
      "kind": "choice",
      "brief": { "zh": "选择满足任务要求的输出类型。", "en": "Choose an output type that meets the task." },
      "hint": [{ "zh": "答案需要区分每个人。", "en": "The answer must distinguish individual people." }],
      "judge": { "fields": { "mode": "exact" } },
      "rounds": [
        {
          "items": [
            {
              "prompt": { "zh": "给出每个红色物体的类别与位置。", "en": "Give the class and location of each red object." },
              "needs": ["class", "location", "instance"]
            }
          ],
          "options": [
            { "id": "label", "label": { "zh": "一张类别标签", "en": "One class label" }, "gives": ["class"] },
            { "id": "box", "label": { "zh": "一个位置框", "en": "One bounding box" }, "gives": ["location"] },
            {
              "id": "detect",
              "label": { "zh": "每个物体的类别和位置框", "en": "A class and box for each object" },
              "gives": ["class", "location", "instance"]
            },
            {
              "id": "sem",
              "label": { "zh": "每个像素的类别", "en": "A class per pixel" },
              "gives": ["class", "region", "location"]
            },
            {
              "id": "inst",
              "label": { "zh": "每个像素的类别和物体编号", "en": "A class and object ID per pixel" },
              "gives": ["class", "region", "instance", "location"]
            },
            {
              "id": "depth",
              "label": { "zh": "每个像素的距离", "en": "A distance at each pixel" },
              "gives": ["depth", "region"]
            }
          ],
          "reference": {
            "size": [32, 24],
            "camera": { "yaw": 0, "pitch": 10, "distance": 6, "f": 1 },
            "light": { "azimuth": 30, "elevation": 60 },
            "floor": "white",
            "objects": [
              {
                "id": "person1",
                "class": "block",
                "colour": "red",
                "boxes": [
                  { "at": [-0.6, 0.35, 0], "size": [0.55, 0.55, 0.42] },
                  { "at": [-0.6, 0.75, 0], "size": [0.35, 0.3, 0.35] }
                ]
              },
              {
                "id": "person2",
                "class": "block",
                "colour": "red",
                "boxes": [
                  { "at": [0.6, 0.35, 0], "size": [0.55, 0.55, 0.42] },
                  { "at": [0.6, 0.75, 0], "size": [0.35, 0.3, 0.35] }
                ]
              }
            ]
          }
        },
        {
          "items": [
            {
              "prompt": {
                "zh": "图中没有红色物体：输出允许是空集合。仍需要哪类输出？",
                "en": "There are no red objects: an empty set is allowed. Which output type is needed?"
              },
              "needs": ["class", "location", "instance"]
            }
          ],
          "options": [
            { "id": "label", "label": { "zh": "一张类别标签", "en": "One class label" }, "gives": ["class"] },
            { "id": "box", "label": { "zh": "一个位置框", "en": "One bounding box" }, "gives": ["location"] },
            {
              "id": "detect",
              "label": { "zh": "每个物体的类别和位置框", "en": "A class and box for each object" },
              "gives": ["class", "location", "instance"]
            },
            {
              "id": "sem",
              "label": { "zh": "每个像素的类别", "en": "A class per pixel" },
              "gives": ["class", "region", "location"]
            },
            {
              "id": "inst",
              "label": { "zh": "每个像素的类别和物体编号", "en": "A class and object ID per pixel" },
              "gives": ["class", "region", "instance", "location"]
            },
            {
              "id": "depth",
              "label": { "zh": "每个像素的距离", "en": "A distance at each pixel" },
              "gives": ["depth", "region"]
            }
          ],
          "reference": {
            "size": [32, 24],
            "camera": { "yaw": 0, "pitch": 10, "distance": 6, "f": 1 },
            "light": { "azimuth": 30, "elevation": 60 },
            "floor": "white",
            "objects": []
          }
        }
      ]
    }
  ]
}
