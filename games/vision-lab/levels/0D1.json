              "id": "c",
              "label": { "zh": "一张 48 × 36 的距离网格（米）", "en": "a 48 × 36 grid of distances in metres" },
              "gives": ["depth", "region"]
            }
          ]
        }
      ]
    },
    {
      "id": "0D1_2",
      "kind": "choice",
      "step": { "zh": "配参照", "en": "References" },
      "brief": {
        "zh": "为每一种预测选出能拿来检验它的参照。",
        "en": "For each kind of prediction, choose the reference it can be tested against."
      },
      "hint": [
        {
          "zh": "预测和参照要量同一种东西，才比得出对错。",
          "en": "A prediction and its reference must measure the same kind of thing for one to check the other."
        }
      ],
      "after": {
        "zh": "每种预测都有了检验它的参照。最后看一张图本身能说明多少。",
        "en": "Every prediction has a reference to test it. Last, how much one image can tell."
      },
      "judge": "pair",
      "rounds": [
        {
          "items": [
            {
              "prompt": { "zh": "预测：人 (6, 4)–(12, 20)", "en": "Predicted: person (6, 4)–(12, 20)" },
              "measures": "box"
            },
            {
              "prompt": { "zh": "预测：最近的人 3.1 米", "en": "Predicted: nearest person 3.1 m" },
              "measures": "distance"
            },
            { "prompt": { "zh": "预测：画面里有人", "en": "Predicted: a person is in view" }, "measures": "class" }
          ],
          "options": [
            {
              "id": "a",
              "label": { "zh": "卷尺：这个人身高 1.7 米", "en": "tape measure: this person stands 1.7 m tall" },
              "measures": "height"
            },
            {
              "id": "b",
              "label": { "zh": "人工标注：(5, 4)–(12, 21)", "en": "annotator: (5, 4)–(12, 21)" },
              "measures": "box"
            },
            {
              "id": "c",
              "label": { "zh": "人工标注：画面里 2 个人", "en": "annotator: 2 people in view" },
              "measures": "count"
            },
            {
              "id": "d",
              "label": { "zh": "激光测距：到最近的人 3.4 米", "en": "laser range finder: 3.4 m to the nearest person" },
              "measures": "distance"
            },
            {
              "id": "e",
              "label": { "zh": "人工标注：人的中心在 (9, 12)", "en": "annotator: the person's centre at (9, 12)" },
              "measures": "point"
            },
            { "id": "f", "label": { "zh": "人工标注：人", "en": "annotator: person" }, "measures": "class" }
          ]
        },
        {
          "items": [
            {
              "prompt": { "zh": "预测：门口的人 7.4 米", "en": "Predicted: the person by the door 7.4 m" },
              "measures": "distance"
            },
            {
              "prompt": { "zh": "预测：人 (30, 10)–(36, 22)", "en": "Predicted: person (30, 10)–(36, 22)" },
              "measures": "box"
            }
          ],
          "options": [
            {
              "id": "a",
              "label": { "zh": "卷尺：门宽 0.9 米", "en": "tape measure: the door is 0.9 m wide" },
              "measures": "width"
            },
            {
              "id": "b",
              "label": { "zh": "人工标注：(29, 9)–(36, 23)", "en": "annotator: (29, 9)–(36, 23)" },
              "measures": "box"
            },
            {
              "id": "c",
              "label": {
                "zh": "卷尺：沿地面从机器人量到那个人，7.0 米",
                "en": "tape measure: 7.0 m along the floor from the robot to that person"
              },
              "measures": "distance"
            },
            {
              "id": "d",
              "label": { "zh": "人工标注：脚在 (33, 22)", "en": "annotator: feet at (33, 22)" },
              "measures": "point"
            }
          ]
        }
      ],
      "naive": {
        "picks": [[["e"], ["a"], ["c"]], [["a"], ["d"]]],
        "why": {
          "zh": "这是按单位配的：米配米、像素坐标配像素坐标。身高不是距离，一个点不是一个框，人数也不是类别：参照和预测量的是同一种东西，才检验得了它。",
          "en": "That pairs by unit: metres with metres, pixel coordinates with pixel coordinates. A height is not a distance, one point is not a box, and a head count is not a class: a reference tests a prediction only when both measure the same thing."
        }
      }
    },
    {
      "id": "0D1_3",
      "kind": "choice",
      "step": { "zh": "一张图的局限", "en": "One image's limits" },
      "brief": {
        "zh": "对着机器人拍下的图和候选场景，判断每句话成立、不成立，还是无法确定。",
        "en": "Given the robot's picture and the candidate scenes, judge whether each statement holds, does not hold, or is undetermined."
      },
      "hint": [
        { "zh": "每个候选场景都渲得出机器人拍到的这张图。", "en": "Every candidate scene renders the very picture the robot took." }
      ],
      "judge": "claims",
      "rounds": [
        {
          "items": [
            {
              "prompt": { "zh": "左边那个人离机器人 3 米。", "en": "The person on the left is 3 m from the robot." },
              "claim": { "depth": { "object": "left", "z": 3 } }
            },
            {
              "prompt": { "zh": "场景里正好有两个人。", "en": "There are exactly two people in the scene." },
              "claim": { "count": { "class": "person", "n": 2 } }
            },
            {
              "prompt": { "zh": "场景里有一只狗。", "en": "There is a dog in the scene." },
              "claim": { "exists": { "class": "dog" } }
            },
            {
              "prompt": { "zh": "右边那个人是紫色的。", "en": "The person on the right is purple." },
              "claim": { "colour": { "object": "right", "is": "purple" } }
            },
            {
              "prompt": { "zh": "左边那个人在画面里看得见。", "en": "The person on the left shows in the picture." },
              "claim": { "visible": { "object": "left" } }
            }
          ],
          "scenes": [
