            ]
          ],
          "items": [
            {
              "prompt": {
                "zh": "在这个房间里搜寻机器人要去救的人。",
                "en": "Search this room for the people the robot must reach."
              },
              "needs": ["class", "location", "instance"]
            },
            {
              "prompt": { "zh": "门洞离机器人多远？", "en": "How far is the doorway from the robot?" },
              "needs": ["depth"]
            }
          ],
          "options": [
