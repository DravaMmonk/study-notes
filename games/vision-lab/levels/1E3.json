{
  "title": { "zh": "像素之间", "en": "Between pixels" },
  "intro": [
    {
      "t": {
        "zh": "最近邻只复制旧值。现在让新位置也能反映周围像素的变化。",
        "en": "Nearest-neighbour sampling copies existing values. Now let new positions reflect neighbouring pixels."
      }
    }
  ],
  "tasks": [
    {
      "id": "1E3",
      "kind": "circuit",
      "brief": {
        "zh": "用双线性插值缩放到 w × h；首尾对齐，单个输出位置取原图中心。",
        "en": "Resize to w × h using bilinear interpolation; align endpoints and use the source centre for a single output position."
      },
      "inputs": [
        { "name": "image", "label": "image" },
        { "name": "w", "label": "w" },
        { "name": "h", "label": "h" }
      ],
      "outputs": [{ "name": "out", "label": { "zh": "结果", "en": "Result" } }],
      "tests": [
        { "inputs": { "image": [[0, 1]], "w": 3, "h": 1 }, "expect": { "out": [[0, 0.5, 1]] } },
        {
          "inputs": { "image": [[0, 1], [1, 0]], "w": 3, "h": 3 },
          "expect": { "out": [[0, 0.5, 1], [0.5, 0.5, 0.5], [1, 0.5, 0]] }
        }
      ],
      "solution": [
        "one = const[value=1]()",
        "half = const[value=0.5]()",
        "s = size(image)",
        "g = grid(w, h)",
        "xs = sampleAxis(g.x, s.w, w)",
        "ys = sampleAxis(g.y, s.h, h)",
        "x0 = floor(xs)",
        "fx = sub(xs, x0)",
        "x1 = add(x0, one)",
        "y0 = floor(ys)",
        "fy = sub(ys, y0)",
        "y1 = add(y0, one)",
        "a = lookup[outside=clamp](image, x0, y0)",
        "b = lookup[outside=clamp](image, x1, y0)",
        "c = lookup[outside=clamp](image, x0, y1)",
        "d = lookup[outside=clamp](image, x1, y1)",
        "ab = sub(b, a)",
        "abf = mul(ab, fx)",
        "top = add(a, abf)",
        "cd = sub(d, c)",
        "cdf = mul(cd, fx)",
        "bot = add(c, cdf)",
        "tb = sub(bot, top)",
        "tbf = mul(tb, fy)",
        "v = add(top, tbf)",
        "out <- v"
      ],
      "hidden": [
        { "inputs": { "image": [[1, 2, 3, 4]], "w": 1, "h": 1 }, "expect": { "out": [[2.5]] } },
        {
          "inputs": { "image": [[0, 2], [4, 6]], "w": 3, "h": 3 },
          "expect": { "out": [[0, 1, 2], [2, 3, 4], [4, 5, 6]] }
        },
        {
          "inputs": { "image": [[[1, 0, 0], [0, 0, 1]]], "w": 3, "h": 1 },
          "expect": { "out": [[[1, 0, 0], [0.5, 0, 0.5], [0, 0, 1]]] }
        }
      ],
      "naive": ["r = resizeNearest(image, w, h)", "out <- r"]
    }
  ],
  "builds": {
    "type": "resizeLinear",
    "name": { "zh": "双线性缩放", "en": "Bilinear resize" },
    "desc": {
      "zh": "按指定宽高用双线性插值重采样。",
      "en": "Resamples an image to the given dimensions by bilinear interpolation."
    }
  }
}
