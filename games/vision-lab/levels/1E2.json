{
  "title": { "zh": "最近的像素", "en": "Nearest pixel" },
  "intro": [
    {
      "t": {
        "zh": "新位置不一定落在旧像素上。先尝试从最近的像素取值。",
        "en": "A new position need not fall on an old pixel. First try reading its nearest pixel."
      }
    }
  ],
  "tasks": [
    {
      "id": "1E2",
      "kind": "grid",
      "brief": {
        "zh": "把图缩放成 3 格：新位置与原图首尾对齐，每个位置取最近的像素；等距时取右侧。",
        "en": "Resize to 3 cells: align endpoints and take the nearest source pixel, breaking ties to the right."
      },
      "image": [[0, 1]],
      "ask": { "fill": { "rows": [[0, 1, 1]] } }
    },
    {
      "id": "1E2_2",
      "kind": "circuit",
      "brief": {
        "zh": "用最近邻把图缩放到 w × h。首尾对齐；只有一个位置时取原图中心。等距时取较大坐标。",
        "en": "Resize to w × h using nearest neighbours. Align endpoints; for one sample use the source centre. Break ties towards the larger index."
      },
      "inputs": [
        { "name": "image", "label": "image" },
        { "name": "w", "label": "w" },
        { "name": "h", "label": "h" }
      ],
      "outputs": [{ "name": "out", "label": { "zh": "结果", "en": "Result" } }],
      "tests": [
        { "inputs": { "image": [[0, 1]], "w": 3, "h": 1 }, "expect": { "out": [[0, 1, 1]] } },
        { "inputs": { "image": [[1, 2], [3, 4]], "w": 2, "h": 2 }, "expect": { "out": [[1, 2], [3, 4]] } }
      ],
      "solution": [
        "one = const[value=1]()",
        "half = const[value=0.5]()",
        "s = size(image)",
        "g = grid(w, h)",
        "xs = sampleAxis(g.x, s.w, w)",
        "ys = sampleAxis(g.y, s.h, h)",
        "xr = add(xs, half)",
        "xi = floor(xr)",
        "yr = add(ys, half)",
        "yi = floor(yr)",
        "r = lookup(image, xi, yi)",
        "out <- r"
      ],
      "hidden": [
        { "inputs": { "image": [[1, 2, 3, 4]], "w": 1, "h": 1 }, "expect": { "out": [[3]] } },
        {
          "inputs": { "image": [[1, 2, 3], [4, 5, 6]], "w": 2, "h": 3 },
          "expect": { "out": [[1, 3], [4, 6], [4, 6]] }
        },
        {
          "inputs": { "image": [[[1, 0, 0], [0, 0, 1]]], "w": 3, "h": 1 },
          "expect": { "out": [[[1, 0, 0], [0, 0, 1], [0, 0, 1]]] }
        }
      ]
    }
  ],
  "builds": {
    "type": "resizeNearest",
    "name": { "zh": "最近邻缩放", "en": "Nearest-neighbour resize" },
    "desc": {
      "zh": "按指定宽高用最近邻重采样。",
      "en": "Resamples an image to a given width and height using nearest neighbours."
    }
  }
}
