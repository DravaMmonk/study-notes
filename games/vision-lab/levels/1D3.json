{
  "title": { "zh": "移动图像", "en": "Move the picture" },
  "intro": [
    {
      "t": {
        "zh": "裁剪会改变范围。现在要保持原尺寸，把内容移到新位置。",
        "en": "A crop changes the extent. Now move the content while retaining the original dimensions."
      }
    }
  ],
  "tasks": [
    {
      "id": "1D3",
      "kind": "circuit",
      "brief": {
        "zh": "按 (dx, dy) 移动图像，空出的位置填 0。",
        "en": "Move the image by (dx, dy), filling uncovered cells with 0."
      },
      "inputs": [
        { "name": "image", "label": "image" },
        { "name": "dx", "label": "dx" },
        { "name": "dy", "label": "dy" }
      ],
      "outputs": [{ "name": "out", "label": { "zh": "结果", "en": "Result" } }],
      "tests": [
        {
          "inputs": { "image": [[1, 2, 3], [4, 5, 6]], "dx": 1, "dy": 0 },
          "expect": { "out": [[0, 1, 2], [0, 4, 5]] }
        },
        {
          "inputs": { "image": [[1, 2, 3], [4, 5, 6]], "dx": -1, "dy": 0 },
          "expect": { "out": [[2, 3, 0], [5, 6, 0]] }
        }
      ],
      "solution": [
        "s = size(image)",
        "g = grid(s.w, s.h)",
        "sx = sub(g.x, dx)",
        "sy = sub(g.y, dy)",
        "r = lookup[outside=zero](image, sx, sy)",
        "out <- r"
      ],
      "hidden": [
        {
          "inputs": { "image": [[1, 2, 3], [4, 5, 6]], "dx": 0, "dy": 1 },
          "expect": { "out": [[0, 0, 0], [1, 2, 3]] }
        },
        {
          "inputs": { "image": [[[1, 0, 0], [0, 0, 1]]], "dx": 1, "dy": 0 },
          "expect": { "out": [[[0, 0, 0], [1, 0, 0]]] }
        }
      ],
      "naive": [
        "s = size(image)",
        "g = grid(s.w, s.h)",
        "sx = add(g.x, dx)",
        "sy = add(g.y, dy)",
        "r = lookup[outside=zero](image, sx, sy)",
        "out <- r"
      ]
    }
  ],
  "builds": {
    "type": "translate",
    "name": { "zh": "平移", "en": "Translate" },
    "desc": {
      "zh": "按给定方向移动图像，空出的像素填 0。",
      "en": "Moves an image by the given offset, filling uncovered pixels with 0."
    }
  }
}
