{
  "title": { "zh": "三点加权", "en": "Three-point weighting" },
  "intro": [
    {
      "t": {
        "zh": "滤波器的九格不一定一样重。先让三点平均能给左、中、右不同的权重。",
        "en": "A filter’s nine weights need not be equal. First let the three-point average weigh left, centre and right differently."
      }
    }
  ],
  "after": {
    "zh": "平均只是三个权重都是三分之一的<wiki-ref to=\"weighted-sum\"></wiki-ref>。",
    "en": "An average is just the <wiki-ref to=\"weighted-sum\"></wiki-ref> whose three weights are all a third."
  },
  "tray": "apart",
  "builds": {
    "type": "line3",
    "name": { "zh": "三点加权", "en": "Three-point weighting" },
    "desc": {
      "zh": "每格和它前后两格按三个权重相加。方向可以选横或竖。",
      "en": "Each cell and the two beside it added by three weights, across or down."
    },
    "settings": ["axis", "outside"],
    "defaults": { "axis": "x", "outside": "clamp" }
  },
  "tasks": [
    {
      "id": "weights",
      "kind": "circuit",
      "carry": "k-average",
      "brief": {
        "zh": "每格换成左、中、右三格按「权重」（前、中、后）的加权和。",
        "en": "Replace each cell with left, centre and right weighted by “weights” (first, centre, last)."
      },
      "adds": ["split3"],
      "configurations": { "arithmetic.op": ["mul"] },
      "inputs": [
        { "name": "photo", "label": { "zh": "图", "en": "Image" } },
        { "name": "weights", "label": { "zh": "权重", "en": "Weights" } }
      ],
      "outputs": [{ "name": "out", "label": { "zh": "加权", "en": "Weighted" } }],
      "tests": [
        {
          "inputs": {
            "photo": [
              [0.55, 0.75, 0.75, 0.87, 0.29, 0.97],
              [0.57, 0.75, 0.75, 0.93, 0.27, 0.37],
              [0.72, 0.59, 0.75, 0.36, 0.96, 0.01]
            ],
            "weights": [[0.25, 0.5, 0.25]]
          },
          "expect": {
            "out": [
              [0.6000000000000001, 0.7, 0.78, 0.6950000000000001, 0.605, 0.8],
              [0.615, 0.705, 0.795, 0.7200000000000001, 0.4600000000000001, 0.345],
              [0.6875, 0.6625, 0.6124999999999999, 0.6074999999999999, 0.5724999999999999, 0.2475]
            ]
          }
        },
        {
          "inputs": {
            "photo": [
              [0.55, 0.75, 0.75, 0.87, 0.29, 0.97],
              [0.57, 0.75, 0.75, 0.93, 0.27, 0.37],
              [0.72, 0.59, 0.75, 0.36, 0.96, 0.01]
            ],
            "weights": [[0.1, 0.8, 0.1]]
          },
          "expect": {
            "out": [
              [0.5700000000000001, 0.7300000000000002, 0.762, 0.8000000000000002, 0.41600000000000004, 0.902],
              [0.5879999999999999, 0.732, 0.768, 0.8460000000000002, 0.34600000000000003, 0.36],
              [0.7069999999999999, 0.619, 0.6950000000000001, 0.45899999999999996, 0.805, 0.10500000000000001]
            ]
          }
        },
        {
          "inputs": {
            "photo": [
              [0.55, 0.75, 0.75, 0.87, 0.29, 0.97],
              [0.57, 0.75, 0.75, 0.93, 0.27, 0.37],
              [0.72, 0.59, 0.75, 0.36, 0.96, 0.01]
            ],
            "weights": [[0, 1, 0]]
          },
          "expect": {
            "out": [
              [0.55, 0.75, 0.75, 0.87, 0.29, 0.97],
              [0.57, 0.75, 0.75, 0.93, 0.27, 0.37],
              [0.72, 0.59, 0.75, 0.36, 0.96, 0.01]
            ]
          }
        }
      ],
      "solution": [
        "r = shift[axis=x,by=forward](photo)",
        "l = shift[axis=x,by=backward](photo)",
        "w = split3(weights)",
        "a = arithmetic[op=mul](r,w.first)",
        "b = arithmetic[op=mul](photo,w.centre)",
        "c = arithmetic[op=mul](l,w.last)",
        "s1 = arithmetic[op=add](a,b)",
        "s2 = arithmetic[op=add](s1,c)",
        "out <- s2"
      ],
      "naive": ["w = split3(weights)", "b = arithmetic[op=mul](photo,w.centre)", "out <- b"],
      "naiveWhy": {
        "zh": "只用了中间的权重：左右邻居没算进去。",
        "en": "Only the centre weight: the left and right neighbours are missing."
      }
    }
  ]
}
