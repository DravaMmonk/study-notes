{
  "title": { "zh": "给扫描台装上频率刻度", "en": "Add a frequency scale" },
  "intro": [
    {
      "t": {
        "zh": "扫描器已经能处理局部变化，但规则条纹可能遍布整幅图，靠局部平滑还会损失有用细节。这章要造频率分析仪，先构造能与条纹比较的波形。负值表示围绕零的变化，计算会完整保留。 <wiki-ref to=\"wave-parameters\"></wiki-ref>",
        "en": "The scanner handles local changes, but periodic stripes span the image and local smoothing may remove useful detail. Build a frequency analyser, beginning with waves to compare against stripes. Negative readings represent variation around zero and remain intact in computations. <wiki-ref to=\"wave-parameters\"></wiki-ref>"
      },
      "fig": "frequency-wave"
    }
  ],
  "after": {
    "zh": "频率控制重复次数，相位控制排列关系。数值表保留灰度显示无法呈现的读数。 <wiki-ref to=\"wave-parameters\"></wiki-ref>",
    "en": "Frequency controls repetitions; phase controls alignment. Numeric tables retain readings hidden by grayscale clipping. <wiki-ref to=\"wave-parameters\"></wiki-ref>"
  },
  "tasks": [
    {
      "id": "v2_wave",
      "kind": "circuit",
      "step": {
        "zh": "造波形",
        "en": "Build a wave"
      },
      "brief": {
        "zh": "位置以整行长度为 1，频率是整行的周期数，相位以周计。造一个能够随频率和相位变化的单位幅度余弦波。",
        "en": "Positions span one row length; frequency is cycles per row and phase is in turns. Build a unit-amplitude cosine wave that responds to frequency and phase."
      },
      "inputs": [
        { "name": "position", "label": { "zh": "归一化位置", "en": "Normalised position" } },
        { "name": "frequency", "label": { "zh": "周期数", "en": "Cycles per row" } },
        { "name": "phase", "label": { "zh": "相位（周）", "en": "Phase (turns)" } }
      ],
      "outputs": [{ "name": "out", "label": { "zh": "基波读数", "en": "Basis readings" } }],
      "tests": [
        {
          "inputs": {
            "position": [[0, 0.125, 0.25, 0.375, 0.5, 0.625, 0.75, 0.875]],
            "frequency": 1,
            "phase": 0
          },
          "expect": {
            "out": [
              [
                1,
                0.7071067811865476,
                6.123233995736766e-17,
                -0.7071067811865475,
                -1,
                -0.7071067811865477,
                -1.8369701987210297e-16,
                0.7071067811865474
              ]
            ]
          }
        },
        {
          "inputs": {
            "position": [[0, 0.125, 0.25, 0.375, 0.5, 0.625, 0.75, 0.875]],
            "frequency": 2,
            "phase": 0.25
          },
          "expect": {
            "out": [
              [
                6.123233995736766e-17,
                -1,
                -1.8369701987210297e-16,
                1,
                3.061616997868383e-16,
                -1,
                -4.286263797015736e-16,
                1
              ]
            ]
          }
        },
        {
          "inputs": { "position": [[0, 0.2, 0.4, 0.6, 0.8]], "frequency": 0, "phase": 0.125 },
          "expect": {
            "out": [
              [
                0.7071067811865476,
                0.7071067811865476,
                0.7071067811865476,
                0.7071067811865476,
                0.7071067811865476
              ]
            ]
          }
        }
      ],
      "hidden": [
        {
          "inputs": {
            "position": [
              [0, 0.16666666666666666, 0.3333333333333333, 0.5, 0.6666666666666666, 0.8333333333333334]
            ],
            "frequency": 2,
            "phase": -0.25
          },
          "expect": {
            "out": [
              [
                6.123233995736766e-17,
                0.8660254037844387,
                -0.8660254037844385,
                -1.8369701987210297e-16,
                0.866025403784439,
                -0.8660254037844388
              ]
            ]
          }
        }
      ],
      "solution": [
        "speed = arithmetic[op=mul](position,frequency)",
        "angle = arithmetic[op=add](speed,phase)",
        "v = cosine(angle)",
        "out <- v"
      ],
      "naive": [
        "speed = arithmetic[op=add](position,frequency)",
        "angle = arithmetic[op=add](speed,phase)",
        "v = cosine(angle)",
        "out <- v"
      ],
      "naiveWhy": {
        "zh": "频率改变单位长度内转过的周期数，不是把所有位置一起平移。相位才负责共同的角度偏移。",
        "en": "Frequency changes cycles across the row; it is not a common position shift. Phase supplies the common angular offset."
      },
      "hint": [
        {
          "zh": "先固定相位比较不同周期数，再固定周期数比较不同相位。余弦元件自动完成三角函数计算。",
          "en": "Hold phase fixed to compare cycle counts, then hold frequency fixed to compare phases. Cosine supplies the arithmetic."
        }
      ],
      "adds": ["cosine"]
    }
  ],
  "builds": {
    "type": "wave",
    "name": { "zh": "波形发生器", "en": "Wave generator" },
    "desc": {
      "zh": "按位置、频率和相位输出单位幅度余弦波，角度以周计。",
      "en": "Generate unit-amplitude cosine readings from positions, frequency and phase in turns."
    }
  }
}
