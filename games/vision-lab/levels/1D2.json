{
  "title": { "zh": "保留原来的值", "en": "Keep the samples" },
  "intro": [
    { "t": { "zh": "已有裁剪器可以对不同大小和起点工作。", "en": "The cropper can work with different sizes and origins." } }
  ],
  "tasks": [
    {
      "id": "1D2",
      "kind": "circuit",
      "brief": { "zh": "截取指定区域。", "en": "Crop the specified region." },
      "inputs": [
        { "name": "image", "label": "image" },
        { "name": "x0", "label": "x0" },
        { "name": "y0", "label": "y0" },
        { "name": "w", "label": "w" },
        { "name": "h", "label": "h" }
      ],
      "outputs": [{ "name": "out", "label": { "zh": "结果", "en": "Result" } }],
      "tests": [
        {
          "inputs": { "image": [[1, 2, 3], [4, 5, 6], [7, 8, 9]], "x0": 0, "y0": 1, "w": 3, "h": 2 },
          "expect": { "out": [[4, 5, 6], [7, 8, 9]] }
        },
        {
          "inputs": { "image": [[3, 5, 7, 9], [2, 4, 6, 8]], "x0": 1, "y0": 0, "w": 2, "h": 2 },
          "expect": { "out": [[5, 7], [4, 6]] }
        }
      ],
      "solution": ["c = crop(image, x0, y0, w, h)", "out <- c"],
      "hidden": [
        { "inputs": { "image": [[3, 8, 4]], "x0": 2, "y0": 0, "w": 1, "h": 1 }, "expect": { "out": [[4]] } }
      ]
    }
  ]
}
