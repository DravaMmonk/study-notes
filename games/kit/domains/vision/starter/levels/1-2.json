{
  "title": {
    "zh": "要的是哪一种答案",
    "en": "Which kind of answer"
  },
  "tasks": [
    {
      "id": "1-2",
      "kind": "choice",
      "brief": {
        "zh": "每个问题，选出刚好够回答它的那种输出。",
        "en": "For each question, choose the output that is just enough to answer it."
      },
      "judge": {
        "fields": {
          "mode": "exact"
        }
      },
      "rounds": [
        {
          "items": [
            { "prompt": { "zh": "图里是什么？", "en": "What is in the picture?" }, "needs": ["class"] },
            { "prompt": { "zh": "它在图的哪里？", "en": "Where in the picture is it?" }, "needs": ["class", "location"] }
          ],
          "options": [
            { "id": "classify", "label": { "zh": "一个类别", "en": "A class" }, "gives": ["class"] },
            { "id": "detect", "label": { "zh": "类别和框", "en": "A class and a box" }, "gives": ["class", "location"] },
            { "id": "segment", "label": { "zh": "每个像素的类别", "en": "A class for every pixel" }, "gives": ["class", "location", "region"] }
          ]
        }
      ]
    }
  ]
}
