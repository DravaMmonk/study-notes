{
  "parts": {
    "counter": {
      "name": "@piece.counter.name",
      "desc": "@piece.counter.desc",
      "inside": [
        {
          "id": "base",
          "reference": {
            "mode": "circuit",
            "solution": [
              "k = const[value=1]()",
              "g = pass(facts.start, k)",
              "m = msum(view.up, view.left, g)",
              "cell <- m"
            ],
            "world": "grid",
            "robot": "scout",
            "ports": [
              { "way": { "n": 1, "sensor": "up" } },
              { "way": { "n": 2, "sensor": "left" } },
              { "start": { "sensor": "start" } }
            ],
            "facts": ["start"]
          }
        }
      ]
    }
  }
}
