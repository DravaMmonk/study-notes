{
  "title": { "zh": "落石" },
  "short": { "zh": "在元件外面加一道闸" },
  "intro": [{ "t": { "zh": "路线不能经过石头：石头格的路线数是「—」。" } }],
  "mission": {
    "goal": { "zh": "数出每个路口的路线数，石头格不算。" },
    "how": { "zh": "用路线计数器数，拦截闸在石头格拦下结果。" }
  },
  "robot": "scout",
  "adds": ["block"],
  "debrief": {
    "title": { "zh": "闸在元件外面" },
    "body": [{ "zh": "元件不用改，外面加一道闸就够了。" }]
  },
  "tasks": [
    {
      "id": "rocks",
      "mode": "circuit",
      "hints": [{ "zh": "「是石头」接拦截闸的条件口，路线计数器接数口。" }],
      "world": "grid",
      "facts": ["start", "rock"],
      "tests": [{ "R": 4, "C": 4, "rocks": [[1, 1]] }, { "R": 4, "C": 5, "rocks": [[1, 2], [2, 0]] }],
      "expected": [8, 12],
      "solution": ["c = counter(view.up, view.left, facts.start)", "b = block(facts.rock, c)", "cell <- b"],
      "naive": ["c = counter(view.up, view.left, facts.start)", "cell <- c"]
    }
  ]
}
