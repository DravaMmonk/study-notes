{
  "title": {
    "en": "Count the routes"
  },
  "short": {
    "en": "Merge two ways in, spot the start"
  },
  "intro": [
    {
      "t": {
        "en": "Streets only go right or down. The routes to a crossing = up + left, and the start is 1."
      }
    }
  ],
  "mission": {
    "goal": {
      "en": "Have the robot write 1 on the start and up + left on every other crossing."
    },
    "how": {
      "en": "A Merger takes up and left; a Pass gate lets a 1 in at the start only."
    }
  },
  "robot": "scout",
  "adds": [
    "const",
    "pass"
  ],
  "debrief": {
    "title": {
      "en": "The board is a part"
    },
    "body": [
      {
        "en": "From now on this board is a part: the Route Counter."
      }
    ]
  },
  "tasks": [
    {
      "id": "stamp",
      "mode": "circuit",
      "hints": [
        {
          "en": "Wire “is start” to the Pass gate’s condition and a Constant 1 to its number, then the gate into the Merger."
        }
      ],
      "ports": [
        { "way": { "n": 1, "sensor": "up" } },
        { "way": { "n": 2, "sensor": "left" } },
        { "start": { "sensor": "start" } }
      ],
      "world": "grid",
      "facts": [
        "start"
      ],
      "tests": [
        {
          "R": 3,
          "C": 4
        },
        {
          "R": 4,
          "C": 4
        }
      ],
      "expected": [10, 20],
      "solution": [
        "k = const[value=1]()",
        "g = pass(facts.start, k)",
        "m = msum(view.up, view.left, g)",
        "cell <- m"
      ],
      "naive": [
        "m = msum(view.up, view.left)",
        "cell <- m"
      ]
    }
  ]
}
