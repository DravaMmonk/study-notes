{
  "title": {
    "zh": "数路线"
  },
  "short": {
    "zh": "汇合两条来路，认出起点"
  },
  "intro": [
    {
      "t": {
        "zh": "街道只能往右或往下走。每个路口的路线数 = 上面 + 左边，起点是 1。"
      }
    }
  ],
  "mission": {
    "goal": {
      "zh": "让机器人在起点写 1，其余每个路口 = 上面 + 左边。"
    },
    "how": {
      "zh": "汇合器收上面和左边；放行闸只在起点放一个 1 进去。"
    }
  },
  "robot": "scout",
  "adds": [
    "const",
    "pass"
  ],
  "unlock": "counter",
  "builds": {
    "ports": [
      {
        "way": {
          "n": 1,
          "sensor": "up"
        }
      },
      {
        "way": {
          "n": 2,
          "sensor": "left"
        }
      },
      {
        "start": {
          "sensor": "start"
        }
      }
    ]
  },
  "debrief": {
    "title": {
      "zh": "板成了元件"
    },
    "body": [
      {
        "zh": "这块板从此是一个元件：路线计数器。"
      }
    ]
  },
  "tasks": [
    {
      "id": "stamp",
      "mode": "circuit",
      "hints": [
        {
          "zh": "「是起点」接放行闸的条件口，常数 1 接数口，再把放行闸接进汇合器。"
        }
      ],
      "world": "grid",
      "facts": [
        "start"
      ],
      "tests": [
        {
          "R": 3,
          "C": 4
        },
        {
          "R": 4,
          "C": 4
        }
      ],
      "expected": [10, 20],
      "solution": [
        "k = const[value=1]()",
        "g = pass(facts.start, k)",
        "m = msum(view.up, view.left, g)",
        "cell <- m"
      ],
      "naive": [
        "m = msum(view.up, view.left)",
        "cell <- m"
      ]
    }
  ]
}
