{
  "title": { "zh": "两路汇合" },
  "short": { "zh": "把两个数汇进一个元件" },
  "intro": [{ "t": { "zh": "汇合器把几根线送来的数加起来，「—」不参与。" } }],
  "mission": {
    "goal": { "zh": "起点已经写好 1。让机器人算出每个路口的路线数：上面 + 左边。" },
    "how": { "zh": "把「上面」和「左边」都接进一个汇合器，再接到「本格」。" }
  },
  "robot": "scout",
  "showcase": {
    "zh": "第一次往板上放元件：元件放在输入和输出之间，几条来路收成一个数"
  },
  "adds": ["msum"],
  "debrief": {
    "title": { "zh": "城市交给了机器人" },
    "body": [{ "zh": "你只接了三根线，机器人就把整座城市填满了。" }]
  },
  "tasks": [
    {
      "id": "merge",
      "mode": "circuit",
      "hints": [{ "zh": "两个输入都接进同一个汇合器。" }],
      "world": "grid",
      "tests": [{ "R": 3, "C": 4, "given": { "0,0": 1 } }, { "R": 4, "C": 5, "given": { "0,0": 1 } }],
      "expected": [10, 35],
      "solution": ["m = msum(view.up, view.left)", "cell <- m"]
    }
  ]
}
