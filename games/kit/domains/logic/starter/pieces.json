{
  "settings": {
    "impI_A": { "control": "tree", "label": "@setting.impI_A.label" },
    "orI_other": { "control": "tree", "label": "@setting.orI_other.label" },
    "orI_side": {
      "control": "buttons",
      "label": "@setting.orI_side.label",
      "options": [
        {
          "value": "left",
          "label": "@setting.orI_side.options.0.label"
        },
        {
          "value": "right",
          "label": "@setting.orI_side.options.1.label"
        }
      ],
      "default": "right"
    },
    "botE_C": { "control": "tree", "label": "@setting.botE_C.label" },
    "allI_x": { "control": "select", "label": "@setting.allI_x.label", "from": "names()" },
    "allE_t": { "control": "select", "label": "@setting.allE_t.label", "from": "instances()" },
    "exI_target": { "control": "tree", "label": "@setting.exI_target.label", "optional": true },
    "exE_x": { "control": "select", "label": "@setting.exE_x.label", "from": "names()" },
    "natInd_P": { "control": "tree", "label": "@setting.natInd_P.label" },
    "natInd_x": { "control": "select", "label": "@setting.natInd_x.label", "from": "names()" },
    "refl_t": { "control": "select", "label": "@setting.refl_t.label", "from": "things()" },
    "rewrite_at": { "control": "list", "label": "@setting.rewrite_at.label", "from": "occurrences(eq, p)" },
    "append_ways": {
      "control": "select",
      "label": "@setting.append_ways.label",
      "options": [
        {
          "value": "2",
          "label": "@setting.append_ways.options.0.label"
        },
        {
          "value": "3",
          "label": "@setting.append_ways.options.1.label"
        },
        {
          "value": "4",
          "label": "@setting.append_ways.options.2.label"
        },
        {
          "value": "5",
          "label": "@setting.append_ways.options.3.label"
        },
        {
          "value": "6",
          "label": "@setting.append_ways.options.4.label"
        }
      ],
      "default": "2"
    },
    "search_depth": {
      "control": "select",
      "label": "@setting.search_depth.label",
      "options": [
        {
          "value": "any",
          "label": "@setting.search_depth.options.0.label"
        },
        {
          "value": "2",
          "label": "@setting.search_depth.options.1.label"
        },
        {
          "value": "3",
          "label": "@setting.search_depth.options.2.label"
        },
        {
          "value": "4",
          "label": "@setting.search_depth.options.3.label"
        },
        {
          "value": "5",
          "label": "@setting.search_depth.options.4.label"
        },
        {
          "value": "6",
          "label": "@setting.search_depth.options.5.label"
        },
        {
          "value": "8",
          "label": "@setting.search_depth.options.6.label"
        },
        {
          "value": "10",
          "label": "@setting.search_depth.options.7.label"
        },
        {
          "value": "12",
          "label": "@setting.search_depth.options.8.label"
        }
      ],
      "default": "any"
    },
    "rw_at": {
      "control": "select",
      "label": "@setting.rw_at.label",
      "options": [
        {
          "value": "goal",
          "label": "@setting.rw_at.options.0.label"
        },
        {
          "value": "hyps",
          "label": "@setting.rw_at.options.1.label"
        }
      ],
      "default": "goal"
    },
    "resolve_unit": {
      "control": "select",
      "label": "@setting.resolve_unit.label",
      "options": [
        {
          "value": "any",
          "label": "@setting.resolve_unit.options.0.label"
        },
        {
          "value": "unit",
          "label": "@setting.resolve_unit.options.1.label"
        }
      ],
      "default": "any"
    }
  },
  "parts": {
    "gNot": {
      "name": "@piece.gNot.name",
      "desc": "@piece.gNot.desc",
      "icon": "ToggleLeft",
      "family": "gate",
      "inputs": [{ "name": "a" }],
      "compute": "not(a)"
    },
    "gAnd": {
      "name": "@piece.gAnd.name",
      "desc": "@piece.gAnd.desc",
      "icon": "ToggleLeft",
      "family": "gate",
      "inputs": [{ "name": "a" }, { "name": "b" }],
      "compute": "and(a, b)"
    },
    "mp": {
      "name": "@piece.mp.name",
      "desc": "@piece.mp.desc",
      "icon": "GitFork",
      "family": "rule",
      "inputs": [
        { "name": "imp", "label": "@piece.mp.inputs.0.label" },
        { "name": "a", "label": "@piece.mp.inputs.1.label" }
      ],
      "compute": "mp(imp, a)"
    },
    "impI": {
      "name": "@piece.impI.name",
      "desc": "@piece.impI.desc",
      "icon": "Box",
      "family": "box",
      "inputs": [],
      "settings": [{"key": "A", "setting": "impI_A"}],
      "regions": [{ "name": "body", "label": "@piece.impI.regions.0.label", "opens": true, "closes": true }],
      "compute": "impI(body)"
    },
    "andI": {
      "name": "@piece.andI.name",
      "desc": "@piece.andI.desc",
      "icon": "GitFork",
      "family": "rule",
      "inputs": [
        { "name": "a", "label": "@piece.andI.inputs.0.label" },
        { "name": "b", "label": "@piece.andI.inputs.1.label" }
      ],
      "compute": "andI(a, b)"
    },
    "andE": {
      "name": "@piece.andE.name",
      "desc": "@piece.andE.desc",
      "icon": "GitFork",
      "family": "rule",
      "inputs": [{ "name": "ab", "label": "@piece.andE.inputs.0.label" }],
      "outputs": [
        { "name": "left", "label": "@piece.andE.outputs.0.label" },
        { "name": "right", "label": "@piece.andE.outputs.1.label" }
      ],
      "compute": { "left": "andE(ab)", "right": "andE(ab)" }
    },
    "orI": {
      "name": "@piece.orI.name",
      "desc": "@piece.orI.desc",
      "icon": "GitFork",
      "family": "rule",
      "inputs": [{ "name": "a", "label": "@piece.orI.inputs.0.label" }],
      "settings": [{"key": "other", "setting": "orI_other"}, {"key": "side", "setting": "orI_side"}],
      "compute": "orI(a)"
    },
    "orE": {
      "name": "@piece.orE.name",
      "desc": "@piece.orE.desc",
      "icon": "Box",
      "family": "box",
      "inputs": [{ "name": "ab", "label": "@piece.orE.inputs.0.label" }],
      "regions": [
        { "name": "left", "label": "@piece.orE.regions.0.label", "opens": true, "closes": true },
        { "name": "right", "label": "@piece.orE.regions.1.label", "opens": true, "closes": true }
      ],
      "compute": "orE(ab, left, right)"
    },
    "botE": {
      "name": "@piece.botE.name",
      "desc": "@piece.botE.desc",
      "icon": "GitFork",
      "family": "rule",
      "inputs": [{ "name": "bot", "label": "@piece.botE.inputs.0.label" }],
      "settings": [{"key": "C", "setting": "botE_C"}],
      "compute": "botE(bot)"
    },
    "raa": {
      "name": "@piece.raa.name",
      "desc": "@piece.raa.desc",
      "icon": "GitFork",
      "family": "rule",
      "inputs": [{ "name": "nna", "label": "@piece.raa.inputs.0.label" }],
      "compute": "raa(nna)"
    },
    "allI": {
      "name": "@piece.allI.name",
      "desc": "@piece.allI.desc",
      "icon": "Box",
      "family": "box",
      "inputs": [],
      "settings": [{"key": "x", "setting": "allI_x"}],
      "regions": [{ "name": "body", "label": "@piece.allI.regions.0.label", "closes": true }],
      "compute": "allI(body)"
    },
    "allE": {
      "name": "@piece.allE.name",
      "desc": "@piece.allE.desc",
      "icon": "GitFork",
      "family": "rule",
      "inputs": [{ "name": "all", "label": "@piece.allE.inputs.0.label" }],
      "settings": [{"key": "t", "setting": "allE_t"}],
      "compute": "allE(all)"
    },
    "exI": {
      "name": "@piece.exI.name",
      "desc": "@piece.exI.desc",
      "icon": "GitFork",
      "family": "rule",
      "inputs": [{ "name": "a", "label": "@piece.exI.inputs.0.label" }],
      "settings": [{"key": "target", "setting": "exI_target"}],
      "compute": "exI(a)"
    },
    "exE": {
      "name": "@piece.exE.name",
      "desc": "@piece.exE.desc",
      "icon": "Box",
      "family": "box",
      "inputs": [{ "name": "ex", "label": "@piece.exE.inputs.0.label" }],
      "settings": [{"key": "x", "setting": "exE_x"}],
      "regions": [{ "name": "body", "label": "@piece.exE.regions.0.label", "opens": true, "closes": true }],
      "compute": "exE(ex, body)"
    },
    "natInd": {
      "name": "@piece.natInd.name",
      "desc": "@piece.natInd.desc",
      "icon": "Box",
      "family": "box",
      "inputs": [],
      "settings": [{"key": "P", "setting": "natInd_P"}, {"key": "x", "setting": "natInd_x"}],
      "regions": [
        { "name": "zero", "label": "@piece.natInd.regions.0.label", "closes": true },
        { "name": "step", "label": "@piece.natInd.regions.1.label", "opens": true, "closes": true }
      ],
      "compute": "natInd(zero, step)"
    },
    "refl": {
      "name": "@piece.refl.name",
      "desc": "@piece.refl.desc",
      "icon": "GitFork",
      "family": "rule",
      "inputs": [],
      "settings": [{"key": "t", "setting": "refl_t"}],
      "compute": "refl()"
    },
    "rewrite": {
      "name": "@piece.rewrite.name",
      "desc": "@piece.rewrite.desc",
      "icon": "GitFork",
      "family": "rule",
      "inputs": [
        { "name": "eq", "label": "@piece.rewrite.inputs.0.label" },
        { "name": "p", "label": "@piece.rewrite.inputs.1.label" }
      ],
      "settings": [{"key": "at", "setting": "rewrite_at"}],
      "compute": "rewrite(eq, p)"
    },
    "anyR": {
      "name": "@piece.anyR.name",
      "desc": "@piece.anyR.desc",
      "icon": "Sigma",
      "family": "tactic",
      "inputs": [],
      "compute": "anyR()"
    },
    "swapConcl": {
      "name": "@piece.swapConcl.name",
      "desc": "@piece.swapConcl.desc",
      "icon": "Sigma",
      "family": "tactic",
      "inputs": [
        { "name": "rule", "label": "@piece.swapConcl.inputs.0.label" },
        { "name": "to", "label": "@piece.swapConcl.inputs.1.label" }
      ],
      "compute": "swapConcl(rule, to)"
    },
    "consFront": {
      "name": "@piece.consFront.name",
      "desc": "@piece.consFront.desc",
      "icon": "Sigma",
      "family": "tactic",
      "inputs": [
        { "name": "first", "label": "@piece.consFront.inputs.0.label" },
        { "name": "rest", "label": "@piece.consFront.inputs.1.label" }
      ],
      "compute": "consFront(first, rest)"
    },
    "mkRule": {
      "name": "@piece.mkRule.name",
      "desc": "@piece.mkRule.desc",
      "icon": "Sigma",
      "family": "tactic",
      "inputs": [
        { "name": "premises", "label": "@piece.mkRule.inputs.0.label" },
        { "name": "conclusion", "label": "@piece.mkRule.inputs.1.label" }
      ],
      "compute": "mkRule(premises, conclusion)"
    },
    "eachOf": {
      "name": "@piece.eachOf.name",
      "desc": "@piece.eachOf.desc",
      "icon": "Box",
      "family": "loop",
      "inputs": [{ "name": "in" }],
      "regions": [{ "name": "body", "label": "@piece.eachOf.regions.0.label", "opens": true }],
      "compute": "eachOf(in)"
    },
    "keepBound": {
      "name": "@piece.keepBound.name",
      "desc": "@piece.keepBound.desc",
      "icon": "Box",
      "family": "loop",
      "inputs": [{ "name": "in" }],
      "regions": [
        {
          "name": "body",
          "label": "@piece.keepBound.regions.0.label",
          "opens": true
        }
      ],
      "compute": "keepBound(in)"
    },
    "uDelete": {
      "name": "@piece.uDelete.name",
      "desc": "@piece.uDelete.desc",
      "icon": "Sigma",
      "family": "tactic",
      "inputs": [{ "name": "in" }],
      "compute": "uDelete(in)"
    },
    "uDecompose": {
      "name": "@piece.uDecompose.name",
      "desc": "@piece.uDecompose.desc",
      "icon": "Sigma",
      "family": "tactic",
      "inputs": [{ "name": "in" }],
      "compute": "uDecompose(in)"
    },
    "uConflict": {
      "name": "@piece.uConflict.name",
      "desc": "@piece.uConflict.desc",
      "icon": "Sigma",
      "family": "tactic",
      "inputs": [{ "name": "in" }],
      "compute": "uConflict(in)"
    },
    "uSwap": {
      "name": "@piece.uSwap.name",
      "desc": "@piece.uSwap.desc",
      "icon": "Sigma",
      "family": "tactic",
      "inputs": [{ "name": "in" }],
      "compute": "uSwap(in)"
    },
    "uCheck": {
      "name": "@piece.uCheck.name",
      "desc": "@piece.uCheck.desc",
      "icon": "Sigma",
      "family": "tactic",
      "inputs": [{ "name": "in" }],
      "compute": "uCheck(in)"
    },
    "uEliminate": {
      "name": "@piece.uEliminate.name",
      "desc": "@piece.uEliminate.desc",
      "icon": "Sigma",
      "family": "tactic",
      "inputs": [{ "name": "in" }],
      "compute": "uEliminate(in)"
    },
    "uPattern": {
      "name": "@piece.uPattern.name",
      "desc": "@piece.uPattern.desc",
      "icon": "Sigma",
      "family": "tactic",
      "inputs": [{ "name": "in" }],
      "compute": "uPattern(in)"
    },
    "repeat": {
      "name": "@piece.repeat.name",
      "desc": "@piece.repeat.desc",
      "icon": "Repeat",
      "family": "loop",
      "inputs": [{ "name": "in" }],
      "regions": [
        { "name": "body", "label": "@piece.repeat.regions.0.label", "opens": true, "closes": true }
      ],
      "compute": "repeat(in, body)"
    },
    "rule": {
      "name": "@piece.rule.name",
      "desc": "@piece.rule.desc",
      "icon": "Sigma",
      "family": "tactic",
      "inputs": [{ "name": "in" }, { "name": "rules", "label": "@piece.rule.inputs.1.label" }],
      "compute": "rule(in, rules)"
    },
    "assumption": {
      "name": "@piece.assumption.name",
      "desc": "@piece.assumption.desc",
      "icon": "Sigma",
      "family": "tactic",
      "inputs": [{ "name": "in" }],
      "compute": "assumption(in)"
    },
    "defer": {
      "name": "@piece.defer.name",
      "desc": "@piece.defer.desc",
      "icon": "Sigma",
      "family": "tactic",
      "inputs": [{ "name": "in" }],
      "compute": "defer(in)"
    },
    "append": {
      "name": "@piece.append.name",
      "desc": "@piece.append.desc",
      "icon": "Box",
      "family": "loop",
      "inputs": [{ "name": "in" }],
      "settings": [{"key": "ways", "setting": "append_ways"}],
      "regions": [
        { "name": "first", "label": "@piece.append.regions.0.label", "opens": true },
        { "name": "second", "label": "@piece.append.regions.1.label", "opens": true },
        { "name": "third", "label": "@piece.append.regions.2.label", "opens": true, "when": "ge($ways, 3)" },
        { "name": "fourth", "label": "@piece.append.regions.3.label", "opens": true, "when": "ge($ways, 4)" },
        { "name": "fifth", "label": "@piece.append.regions.4.label", "opens": true, "when": "ge($ways, 5)" },
        { "name": "sixth", "label": "@piece.append.regions.5.label", "opens": true, "when": "ge($ways, 6)" }
      ],
      "compute": "append(in)"
    },
    "search": {
      "name": "@piece.search.name",
      "desc": "@piece.search.desc",
      "icon": "Search",
      "family": "loop",
      "inputs": [{ "name": "in" }],
      "settings": [{"key": "depth", "setting": "search_depth"}],
      "regions": [{ "name": "body", "label": "@piece.search.regions.0.label", "opens": true }],
      "compute": "search(in)"
    },
    "each": {
      "name": "@piece.each.name",
      "desc": "@piece.each.desc",
      "icon": "Rows3",
      "family": "loop",
      "inputs": [{ "name": "in" }],
      "regions": [{ "name": "body", "label": "@piece.each.regions.0.label", "opens": true }],
      "compute": "each(in)"
    },
    "rw": {
      "name": "@piece.rw.name",
      "desc": "@piece.rw.desc",
      "icon": "Sigma",
      "family": "tactic",
      "inputs": [{ "name": "in" }, { "name": "rules", "label": "@piece.rw.inputs.1.label" }],
      "settings": [{"key": "at", "setting": "rw_at"}],
      "compute": "rw(in, rules)"
    },
    "skolem": {
      "name": "@piece.skolem.name",
      "desc": "@piece.skolem.desc",
      "icon": "Sigma",
      "family": "tactic",
      "inputs": [{ "name": "in" }],
      "compute": "skolem(in)"
    },
    "toClauses": {
      "name": "@piece.toClauses.name",
      "desc": "@piece.toClauses.desc",
      "icon": "Sigma",
      "family": "tactic",
      "inputs": [{ "name": "in" }],
      "compute": "toClauses(in)"
    },
    "resolve": {
      "name": "@piece.resolve.name",
      "desc": "@piece.resolve.desc",
      "icon": "Sigma",
      "family": "tactic",
      "inputs": [{ "name": "in" }],
      "settings": [{"key": "unit", "setting": "resolve_unit"}],
      "compute": "resolve(in)"
    },
    "oracle": {
      "name": "@piece.oracle.name",
      "desc": "@piece.oracle.desc",
      "icon": "Sigma",
      "family": "tactic",
      "inputs": [{ "name": "in" }],
      "compute": "oracle(in)"
    },
    "replay": {
      "name": "@piece.replay.name",
      "desc": "@piece.replay.desc",
      "icon": "Sigma",
      "family": "tactic",
      "inputs": [{ "name": "in" }],
      "compute": "replay(in)"
    },
    "gOr": {
      "name": "@piece.gOr.name",
      "desc": "@piece.gOr.desc",
      "family": "gate",
      "inside": [
        {
          "id": "base",
          "reference": {
            "kind": "gates",
            "solution": ["n1 = gNot(Rain)", "n2 = gNot(Wind)", "a = gAnd(n1, n2)", "n3 = gNot(a)", "out <- n3"],
            "target": "Rain ∨ Wind"
          }
        }
      ]
    },
    "formulaNot": {
      "editor": "strip",
      "mark": "formulaNot",
      "icon": "Rows3",
      "name": "¬",
      "desc": "@piece.formulaNot.desc"
    },
    "formulaAnd": {
      "editor": "strip",
      "mark": "formulaAnd",
      "icon": "Rows3",
      "name": "∧",
      "desc": "@piece.formulaAnd.desc"
    },
    "formulaOr": {
      "editor": "strip",
      "mark": "formulaOr",
      "icon": "Rows3",
      "name": "∨",
      "desc": "@piece.formulaOr.desc"
    },
    "formulaImplies": {
      "editor": "strip",
      "mark": "formulaImplies",
      "icon": "Rows3",
      "name": "→",
      "desc": "@piece.formulaImplies.desc"
    },
    "formulaIff": {
      "editor": "strip",
      "mark": "formulaIff",
      "icon": "Rows3",
      "name": "↔",
      "desc": "@piece.formulaIff.desc"
    },
    "formulaFalse": {
      "editor": "strip",
      "mark": "formulaFalse",
      "icon": "Rows3",
      "name": "⊥",
      "desc": "@piece.formulaFalse.desc"
    },
    "formulaForall": {
      "editor": "strip",
      "mark": "formulaForall",
      "icon": "Rows3",
      "name": "∀",
      "desc": "@piece.formulaForall.desc"
    },
    "formulaExists": {
      "editor": "strip",
      "mark": "formulaExists",
      "icon": "Rows3",
      "name": "∃",
      "desc": "@piece.formulaExists.desc"
    }
  }
}
