      "kind": "gates",
      "target": "¬¬Rain",
      "brief": {
        "zh": "接一块电路，算出「不是『不下雨』」在每一行的真值。"
      },
      "hint": [
        {
          "zh": "「不下雨」怎样接？再否定一次呢？"
        }
      ],
      "solution": [
        "n1 = gNot(Rain)",
        "n2 = gNot(n1)",
        "out <- n2"
      ],
      "naive": [
        "n1 = gNot(Rain)",
        "out <- n1"
      ]
    }
