{
  "title": {
    "zh": "相邻两项"
  },
  "intro": [
    {
      "t": {
        "zh": "板上的电路每一拍从头算一遍，算完什么也不留下。要留下一个值到下一拍，用一对新元件：<part-ref to=\"part:keep\"></part-ref>把值存进寄存卡，<part-ref to=\"part:reg\"></part-ref>下一拍读出它。"
      }
    }
  ],
  "after": {
    "zh": "寄存卡让电路记得上一项。"
  },
  "adds": [
    "reg",
    "keep"
  ],
  "tasks": [
    {
      "id": "1-2",
      "brief": {
        "zh": "每一拍交出输入这一项与上一项的和；第一拍的上一项算 0。"
      },
      "inputs": [
        {
          "name": "a",
          "label": {
            "zh": "a"
          }
        }
      ],
      "outputs": [
        {
          "name": "s",
          "label": {
            "zh": "相邻和"
          }
        }
      ],
      "tests": [
        {
          "inputs": {
            "a": [
              4,
              7,
              1,
              9,
              2
            ]
          },
          "want": {
            "s": [
              4,
              11,
              8,
              10,
              11
            ]
          }
        }
      ],
      "solution": [
        "r = reg[reg=A, start=0]()",
        "k = keep[reg=A](a)",
        "p = add(a, r)",
        "s <- p"
      ]
    }
  ]
}
