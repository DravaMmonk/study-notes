{
  "parts": {
    "add": {
      "name": { "zh": "加" },
      "desc": { "zh": "给出 a + b。" },
      "icon": "Plus",
      "family": "value",
      "inputs": [{ "name": "a" }, { "name": "b" }],
      "compute": "add(a, b)"
    },
    "mul": {
      "name": { "zh": "乘" },
      "desc": { "zh": "给出 a × b。" },
      "icon": "X",
      "family": "value",
      "inputs": [{ "name": "a" }, { "name": "b" }],
      "compute": "mul(a, b)"
    },
    "recip": {
      "name": { "zh": "倒数" },
      "desc": { "zh": "给出 1/a；a 为 0 时没有值。" },
      "icon": "Divide",
      "family": "value",
      "inputs": [{ "name": "a" }],
      "compute": "recip(a)"
    },
    "less": {
      "name": { "zh": "比较" },
      "desc": { "zh": "a 小于 b 时给出 1，否则给出 0。" },
      "icon": "ChevronLeft",
      "family": "value",
      "inputs": [{ "name": "a" }, { "name": "b" }],
      "compute": "less(a, b)"
    },
    "const": {
      "name": { "zh": "常数" },
      "desc": { "zh": "每一拍都给出设定的数。" },
      "icon": "Hash",
      "family": "value",
      "inputs": [],
      "settings": [{ "key": "value", "control": "number", "label": { "zh": "数值" }, "default": 0 }],
      "compute": "$value"
    },
    "reg": {
      "name": { "zh": "读寄存卡" },
      "desc": { "zh": "给出同名寄存卡中存的值；尚未存入时，给出初值。" },
      "icon": "ArrowUpFromLine",
      "family": "memory",
      "inputs": [],
      "settings": [
        {
          "key": "reg",
          "control": "select",
          "label": { "zh": "名字" },
          "options": [{ "value": "A" }, { "value": "B" }, { "value": "C" }, { "value": "D" }],
          "default": "A"
        },
        { "key": "start", "control": "number", "label": { "zh": "初值" }, "default": 0, "optional": true }
      ],
      "compute": "held($reg, $start)"
    },
    "keep": {
      "name": { "zh": "存寄存卡" },
      "desc": { "zh": "把接入的值存进同名寄存卡，从下一拍起可以读出。" },
      "icon": "ArrowDownToLine",
      "family": "memory",
      "inputs": [{ "name": "in" }],
      "settings": [
        {
          "key": "reg",
          "control": "select",
          "label": { "zh": "名字" },
          "options": [{ "value": "A" }, { "value": "B" }, { "value": "C" }, { "value": "D" }],
          "default": "A"
        }
      ],
      "keeps": { "input": "in", "register": "reg" }
    }
  }
}
