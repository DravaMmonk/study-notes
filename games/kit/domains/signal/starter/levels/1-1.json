{
  "title": {
    "zh": "放大再叠加"
  },
  "intro": [
    {
      "t": {
        "zh": "板左边是这一关给的一个数和两段<wiki-ref to=\"wave\"></wiki-ref>，右边是要交出的波形。手上的两块元件各做一件事：一块把波形放大，一块把两段波形叠在一起。"
      }
    }
  ],
  "adds": [
    "mix",
    "scale"
  ],
  "builds": {
    "type": "blend",
    "name": {
      "zh": "放大再叠加"
    },
    "desc": {
      "zh": "给出 a 放大 k 倍、再叠上 b 的波形。"
    }
  },
  "tasks": [
    {
      "id": "1-1",
      "brief": {
        "zh": "把 a 放大 k 倍，再叠上 b。"
      },
      "hint": [
        {
          "zh": "一块元件的输出可以接到另一块元件的输入上。"
        }
      ],
      "inputs": [
        {
          "name": "k",
          "label": "k"
        },
        {
          "name": "a",
          "label": "a"
        },
        {
          "name": "b",
          "label": "b"
        }
      ],
      "outputs": [
        {
          "name": "out",
          "label": {
            "zh": "结果"
          }
        }
      ],
      "tests": [
        {
          "inputs": {
            "k": 2,
            "a": [
              1,
              0,
              -1,
              0
            ],
            "b": [
              0,
              1,
              0,
              -1
            ]
          },
          "expect": {
            "out": [
              2,
              1,
              -2,
              -1
            ]
          }
        },
        {
          "inputs": {
            "k": -1,
            "a": [
              1,
              2,
              3,
              4
            ],
            "b": [
              1,
              1,
              1,
              1
            ]
          },
          "expect": {
            "out": [
              0,
              -1,
              -2,
              -3
            ]
          }
        }
      ],
      "hidden": [
        {
          "inputs": {
            "k": 0.5,
            "a": [
              4,
              -2,
              0,
              6
            ],
            "b": [
              1,
              0,
              1,
              0
            ]
          },
          "expect": {
            "out": [
              3,
              -1,
              1,
              3
            ]
          }
        }
      ],
      "solution": [
        "s = scale(k, a)",
        "m = mix(s, b)",
        "out <- m"
      ]
    }
  ]
}
