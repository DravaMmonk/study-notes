{
  "title": {
    "zh": "再叠一段"
  },
  "intro": [
    {
      "t": {
        "zh": "这一关给的波形多了一段。"
      }
    }
  ],
  "tasks": [
    {
      "id": "1-2",
      "brief": {
        "zh": "交出 p 倍的 a、q 倍的 b 和 c 叠在一起的波形。"
      },
      "inputs": [
        {
          "name": "p",
          "label": "p"
        },
        {
          "name": "a",
          "label": "a"
        },
        {
          "name": "q",
          "label": "q"
        },
        {
          "name": "b",
          "label": "b"
        },
        {
          "name": "c",
          "label": "c"
        }
      ],
      "outputs": [
        {
          "name": "out",
          "label": {
            "zh": "结果"
          }
        }
      ],
      "tests": [
        {
          "inputs": {
            "p": 2,
            "a": [
              1,
              0,
              -1,
              0
            ],
            "q": 3,
            "b": [
              0,
              1,
              0,
              -1
            ],
            "c": [
              1,
              1,
              1,
              1
            ]
          },
          "expect": {
            "out": [
              3,
              4,
              -1,
              -2
            ]
          }
        },
        {
          "inputs": {
            "p": 1,
            "a": [
              1,
              2,
              3,
              4
            ],
            "q": -1,
            "b": [
              4,
              3,
              2,
              1
            ],
            "c": [
              0,
              0,
              0,
              0
            ]
          },
          "expect": {
            "out": [
              -3,
              -1,
              1,
              3
            ]
          }
        }
      ],
      "solution": [
        "x = blend(p, a, c)",
        "y = blend(q, b, x)",
        "out <- y"
      ],
      "naive": [
        "x = blend(p, a, c)",
        "y = mix(x, b)",
        "out <- y"
      ]
    }
  ]
}
