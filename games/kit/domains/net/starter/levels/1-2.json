{
  "title": {
    "zh": "晚一拍"
  },
  "intro": [
    {
      "t": {
        "zh": "板上的电路每一拍从头算一遍，算完什么也不留下。要留下一个值到下一拍，用一对新元件：<part-ref to=\"part:keep\"></part-ref>把值存进寄存卡，<part-ref to=\"part:reg\"></part-ref>下一拍读出它。"
      }
    }
  ],
  "after": {
    "zh": "寄存卡让电路记得上一拍。"
  },
  "adds": [
    "reg",
    "keep"
  ],
  "tasks": [
    {
      "id": "1-2",
      "brief": {
        "zh": "每一拍在右线上说出左线上一拍的位；第一拍说 0。"
      },
      "wires": {
        "in": [
          {
            "name": "left",
            "label": {
              "zh": "左线"
            }
          }
        ],
        "out": [
          {
            "name": "right",
            "label": {
              "zh": "右线"
            }
          }
        ]
      },
      "tests": [
        {
          "wires": {
            "left": {
              "send": [
                {
                  "bits": "101100"
                }
              ]
            }
          }
        },
        {
          "wires": {
            "left": {
              "send": [
                {
                  "bits": "01101"
                }
              ]
            }
          }
        }
      ],
      "want": {
        "right": {
          "late": {
            "wire": "left",
            "first": 0
          }
        }
      },
      "solution": [
        "r = reg[reg=A, start=0]()",
        "k = keep[reg=A](left)",
        "right <- r"
      ]
    }
  ]
}
