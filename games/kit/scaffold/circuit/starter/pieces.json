{
  "parts": {
    "add": {
      "name": "@piece.add.name",
      "desc": "@piece.add.desc",
      "icon": "Plus",
      "family": "value",
      "inputs": [{ "name": "a" }, { "name": "b" }],
      "compute": "add(a, b)"
    },
    "sub": {
      "name": "@piece.sub.name",
      "desc": "@piece.sub.desc",
      "icon": "Minus",
      "family": "value",
      "inputs": [{ "name": "a" }, { "name": "b" }],
      "compute": "sub(a, b)"
    },
    "addSub": {
      "name": "@piece.addSub.name",
      "desc": "@piece.addSub.desc",
      "inside": [
        {
          "id": "base",
          "reference": {
            "solution": ["s = add(a, b)", "d = sub(s, c)", "out <- d"],
            "inputs": [
              { "name": "a", "label": "a" },
              { "name": "b", "label": "b" },
              { "name": "c", "label": "c" }
            ],
            "outputs": [{ "name": "out", "label": "out" }]
          }
        }
      ]
    }
  }
}
