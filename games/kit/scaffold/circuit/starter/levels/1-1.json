{
  "title": {
    "zh": "加了再减",
    "en": "Add, then take away"
  },
  "intro": [
    {
      "t": {
        "zh": "板左边是这一关给的三个数，右边是要交出的结果。手上的两块元件各算两个数：一块求和，一块求<wiki-ref to=\"difference\"></wiki-ref>。",
        "en": "The three numbers this level gives are on the left of the board, the result to give on the right. The two parts at hand each work on two numbers: one gives their sum, the other their <wiki-ref to=\"difference\"></wiki-ref>."
      }
    }
  ],
  "adds": [
    "add",
    "sub"
  ],
  "builds": {
    "type": "addSub",
    "name": {
      "zh": "加了再减",
      "en": "Add then subtract"
    },
    "desc": {
      "zh": "给出 a 加 b、再减去 c 的结果。",
      "en": "Gives a plus b, less c."
    }
  },
  "tasks": [
    {
      "id": "1-1",
      "brief": {
        "zh": "交出 a 加 b、再减去 c 的结果。",
        "en": "Give a plus b, less c."
      },
      "hint": [
        {
          "zh": "一块元件的输出可以接到另一块元件的输入上。",
          "en": "One part’s output can go into another part’s input."
        }
      ],
      "inputs": [
        {
          "name": "a",
          "label": "a"
        },
        {
          "name": "b",
          "label": "b"
        },
        {
          "name": "c",
          "label": "c"
        }
      ],
      "outputs": [
        {
          "name": "out",
          "label": {
            "zh": "结果",
            "en": "Result"
          }
        }
      ],
      "tests": [
        {
          "inputs": {
            "a": 1,
            "b": 2,
            "c": 3
          },
          "expect": {
            "out": 0
          }
        },
        {
          "inputs": {
            "a": 10,
            "b": 4,
            "c": 6
          },
          "expect": {
            "out": 8
          }
        }
      ],
      "hidden": [
        {
          "inputs": {
            "a": 7,
            "b": 8,
            "c": -9
          },
          "expect": {
            "out": 24
          }
        }
      ],
      "solution": [
        "s = add(a, b)",
        "d = sub(s, c)",
        "out <- d"
      ]
    }
  ]
}
