{
  "parts": {
    "reg": {
      "name": { "en": "Register" },
      "desc": { "en": "Gives the value held in the register of the same name; before anything is stored, gives its start value (「—」 or the number set)." },
      "icon": "ArrowUpFromLine",
      "family": "memory",
      "inputs": [],
      "settings": [
        {
          "key": "reg",
          "control": "select",
          "label": { "en": "Name" },
          "options": [{ "value": "A" }, { "value": "B" }, { "value": "C" }, { "value": "D" }],
          "default": "A"
        },
        { "key": "start", "control": "number", "label": { "en": "Start" }, "default": null }
      ],
      "compute": "held($reg, $start)"
    },
    "keep": {
      "name": { "en": "Keep" },
      "desc": { "en": "Stores its input in the register of the same name; it can be read from the next tick on." },
      "icon": "ArrowDownToLine",
      "family": "memory",
      "inputs": [{ "name": "in" }],
      "settings": [
        {
          "key": "reg",
          "control": "select",
          "label": { "en": "Name" },
          "options": [{ "value": "A" }, { "value": "B" }, { "value": "C" }, { "value": "D" }],
          "default": "A"
        }
      ],
      "keeps": { "input": "in", "register": "reg" }
    },
    "const": {
      "name": { "en": "Constant" },
      "desc": { "en": "Always gives the number it is set to." },
      "icon": "Hash",
      "family": "value",
      "inputs": [],
      "settings": [
        {
          "key": "value",
          "control": "number",
          "label": { "en": "Value" },
          "min": 0,
          "max": 32,
          "integer": true,
          "default": 0
        }
      ],
      "compute": "$value"
    }
  }
}
