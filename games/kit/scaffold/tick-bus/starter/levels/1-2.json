{
  "title": {
    "en": "A tick late"
  },
  "intro": [
    {
      "t": {
        "en": "The board computes afresh every tick and keeps nothing once done. To keep a value for the next tick there is a new pair of parts: <part-ref to=\"part:keep\"></part-ref> stores a value in a register, and <part-ref to=\"part:reg\"></part-ref> reads it out the next tick."
      }
    }
  ],
  "after": {
    "en": "A register lets a circuit remember the tick before."
  },
  "adds": [
    "reg",
    "keep"
  ],
  "tasks": [
    {
      "id": "1-2",
      "brief": {
        "en": "Every tick, say on the line what the input was the tick before; say 0 on the first tick."
      },
      "talks": true,
      "inputs": [
        {
          "name": "b",
          "label": {
            "en": "Bit"
          }
        }
      ],
      "tests": [
        {
          "line": "......",
          "inputs": {
            "b": [
              1,
              0,
              1,
              1,
              0,
              0
            ]
          }
        },
        {
          "line": ".....",
          "inputs": {
            "b": [
              0,
              1,
              1,
              0,
              1
            ]
          }
        }
      ],
      "want": {
        "say": {
          "delayed": {
            "input": "b",
            "first": 0
          }
        }
      },
      "solution": [
        "r = reg[reg=A, start=0]()",
        "k = keep[reg=A](b)",
        "say <- r"
      ]
    }
  ]
}
