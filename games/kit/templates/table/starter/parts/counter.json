{
  "name": "@part.counter.name",
  "desc": "@part.counter.desc",
  "inside": [
    {
      "id": "base",
      "reference": {
        "mode": "table:circuit",
        "solution": [
          "k = table:const[value=1]()",
          "g = table:pass(facts.start, k)",
          "m = table:msum(view.up, view.left, g)",
          "cell <- m"
        ],
        "world": "table:world-grid",
        "robot": "table:robot-scout",
        "ports": [
          { "table:port-way": { "n": 1, "sensor": "up" } },
          { "table:port-way": { "n": 2, "sensor": "left" } },
          { "table:port-start": { "sensor": "start" } }
        ],
        "facts": ["start"]
      }
    }
  ],
  "inputs": [
    { "name": "up", "type": "circuit:number" },
    { "name": "left", "type": "circuit:number" },
    { "name": "start", "type": "circuit:boolean" }
  ],
  "outputType": "circuit:number"
}
