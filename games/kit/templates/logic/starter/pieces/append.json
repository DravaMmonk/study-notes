{
  "name": "@piece.append.name",
  "desc": "@piece.append.desc",
  "icon": "Box",
  "family": "logic:family-loop",
  "inputs": [{ "name": "in", "type": "logic:machine-value" }],
  "settings": {
    "ways": {
      "control": "select",
      "label": "@piece.append.settings.ways.label",
      "options": [
        { "value": "2", "label": "@piece.append.settings.ways.options.0.label" },
        { "value": "3", "label": "@piece.append.settings.ways.options.1.label" },
        { "value": "4", "label": "@piece.append.settings.ways.options.2.label" },
        { "value": "5", "label": "@piece.append.settings.ways.options.3.label" },
        { "value": "6", "label": "@piece.append.settings.ways.options.4.label" }
      ],
      "default": "2"
    }
  },
  "regions": [
    { "name": "first", "label": "@piece.append.regions.0.label", "opens": true, "type": "logic:machine-value" },
    {
      "name": "second",
      "label": "@piece.append.regions.1.label",
      "opens": true,
      "type": "logic:machine-value"
    },
    {
      "name": "third",
      "label": "@piece.append.regions.2.label",
      "opens": true,
      "when": "circuit:ge($ways, 3)",
      "type": "logic:machine-value"
    },
    {
      "name": "fourth",
      "label": "@piece.append.regions.3.label",
      "opens": true,
      "when": "circuit:ge($ways, 4)",
      "type": "logic:machine-value"
    },
    {
      "name": "fifth",
      "label": "@piece.append.regions.4.label",
      "opens": true,
      "when": "circuit:ge($ways, 5)",
      "type": "logic:machine-value"
    },
    {
      "name": "sixth",
      "label": "@piece.append.regions.5.label",
      "opens": true,
      "when": "circuit:ge($ways, 6)",
      "type": "logic:machine-value"
    }
  ],
  "compute": "logic:append(in)",
  "outputType": "logic:machine-value"
}
