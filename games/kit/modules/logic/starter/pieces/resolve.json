{
  "name": "@piece.resolve.name",
  "desc": "@piece.resolve.desc",
  "icon": "Sigma",
  "family": "logic:family-tactic",
  "inputs": [{ "name": "in", "type": "logic:machine-value" }],
  "settings": {
    "unit": {
      "control": "select",
      "label": "@piece.resolve.settings.unit.label",
      "options": [
        { "value": "any", "label": "@piece.resolve.settings.unit.options.0.label" },
        { "value": "unit", "label": "@piece.resolve.settings.unit.options.1.label" }
      ],
      "default": "any"
    }
  },
  "compute": "logic:resolve(in)",
  "outputType": "logic:machine-value"
}
