{
  "name": "@piece.reg.name",
  "desc": "@piece.reg.desc",
  "icon": "ArrowUpFromLine",
  "family": "tick-bus:family-memory",
  "inputs": [],
  "settings": {
    "reg": {
      "control": "select",
      "label": "@piece.reg.settings.reg.label",
      "options": [{ "value": "A" }, { "value": "B" }, { "value": "C" }, { "value": "D" }],
      "default": "A"
    },
    "start": { "control": "number", "label": "@piece.reg.settings.start.label", "default": null }
  },
  "compute": "circuit:held($reg, $start)",
  "outputType": "circuit:number"
}
