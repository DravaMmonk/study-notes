    "addComm": {
      "name": { "zh": "加法交换" },
      "statement": "∀x. ∀y. plus(x, y) = plus(y, x)",
      "desc": {
        "zh": "x + y = y + x：一条规则，也是一条改写规则；放进化简会来回改写，停不下来。"
      }
    },
    "addAssoc": {
      "name": { "zh": "加法结合" },
      "statement": "∀x. ∀y. ∀z. plus(plus(x, y), z) = plus(x, plus(y, z))",
      "desc": {
        "zh": "(x + y) + z = x + (y + z)：一条规则，也是化简的一条改写规则（从左往右）。"
      }
    },
    "appNil": {
      "name": { "zh": "接空列表" },
      "statement": "∀xs. app(xs, nil) = xs",
      "desc": {
        "zh": "xs ++ [] = xs：一条规则，也是化简的一条改写规则（从左往右）。"
      }
    },
    "appAssoc": {
      "name": { "zh": "拼接结合" },
      "statement": "∀xs. ∀ys. ∀zs. app(app(xs, ys), zs) = app(xs, app(ys, zs))",
      "desc": {
        "zh": "(xs ++ ys) ++ zs = xs ++ (ys ++ zs)：一条规则，也是化简的一条改写规则（从左往右）。"
      }
    },
    "revApp": {
      "name": { "zh": "倒过拼接" },
      "statement": "∀xs. ∀ys. rev(app(xs, ys)) = app(rev(ys), rev(xs))",
      "desc": {
        "zh": "rev (xs ++ ys) = rev ys ++ rev xs：一条规则，也是化简的一条改写规则（从左往右）。"
      }
    },
    "inject": {
      "name": { "zh": "一对一" },
      "statement": "∀x. ∀y. s(x) = s(y) → x = y",
      "desc": {
        "zh": "S x = S y → x = y，用作拆分规则：已知中有 S ?x = S ?y 时，换成由 ?x = ?y 继续证。"
      },
      "rule": { "premises": ["s(?x) = s(?y)", "⟦?x = ?y⟧ ⟹ ?C"], "conclusion": "?C" }
    },
    "ifTrue": {
      "name": { "zh": "如果为真" },
      "statement": "∀u. ∀v. ∀w. u = tt → if(u, v, w) = v",
      "desc": {
        "zh": "u = 真 → (若 u 则 v 否则 w) = v：一条规则，也是一条带条件的改写规则。"
      }
    },
    "ifFalse": {
      "name": { "zh": "如果为假" },
      "statement": "∀u. ∀v. ∀w. u = ff → if(u, v, w) = w",
      "desc": {
        "zh": "u = 假 → (若 u 则 v 否则 w) = w：一条规则，也是一条带条件的改写规则。"
      }
    },
    "succNeq": {
      "name": { "zh": "不等于后继" },
      "statement": "∀x. ¬(x = s(x))",
      "desc": { "zh": "x ≠ S x：一条规则。" }
    },
    "insLen": {
      "name": { "zh": "插入长一格" },
      "statement": "∀xs. ∀x. len(ins(x, xs)) = s(len(xs))",
      "desc": {
        "zh": "len (ins x xs) = S (len xs)：一条规则，也是化简的一条改写规则（从左往右）。"
      }
    }
  },
  "gates": {
    "gOr": {
      "name": { "zh": "或 ∨" },
      "desc": {
        "zh": "a ∨ b：两个输入里至少有一个是真，就输出真；都是假，输出假。"
      },
      "ports": ["a", "b"]
    },
    "gImp": {
      "name": { "zh": "若…则… →" },
      "desc": {
        "zh": "a → b：只在 a 是真、b 是假时输出假；其余都输出真。"
      },
      "ports": ["a", "b"]
    },
    "gIff": {
      "name": { "zh": "等价 ↔" },
      "desc": {
        "zh": "a ↔ b：a 和 b 同真或同假时输出真；一真一假时输出假。"
      },
      "ports": ["a", "b"]
    }
  },
  "revisions": {
    "dm": [
