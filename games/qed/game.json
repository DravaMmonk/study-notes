  "lemmas": {
    "axK": {
      "name": { "zh": "K" },
      "desc": {
        "zh": "在元件上选定两句 A、B，输出 A → (B → A)。"
      },
      "statement": "A → (B → A)",
      "metas": ["A", "B"],
      "ports": [],
      "params": { "A": { "zh": "第一句" }, "B": { "zh": "第二句" } }
    },
    "axS": {
      "name": { "zh": "S" },
      "desc": {
        "zh": "在元件上选定三句 A、B、C，输出 (A → (B → C)) → ((A → B) → (A → C))。"
      },
      "statement": "(A → (B → C)) → ((A → B) → (A → C))",
      "metas": ["A", "B", "C"],
      "ports": [],
      "params": {
        "A": { "zh": "第一句" },
        "B": { "zh": "第二句" },
        "C": { "zh": "第三句" }
      }
    },
    "chain": {
      "name": { "zh": "串联" },
      "desc": { "zh": "由 A → B 和 B → C 得到 A → C。" },
      "statement": "A → C",
      "premises": ["A → B", "B → C"],
      "metas": ["A", "B", "C"],
      "ports": ["A → B", "B → C"]
    },
    "swap": {
      "name": { "zh": "交换" },
      "desc": { "zh": "由 A → (B → C) 得到 B → (A → C)。" },
      "statement": "B → (A → C)",
      "premises": ["A → (B → C)"],
      "metas": ["A", "B", "C"],
      "ports": ["A → (B → C)"]
    },
    "merge": {
      "name": { "zh": "合并" },
      "desc": { "zh": "由 A → (A → B) 得到 A → B。" },
      "statement": "A → B",
      "premises": ["A → (A → B)"],
      "metas": ["A", "B"],
      "ports": ["A → (A → B)"]
    },
    "dm": {
      "name": { "zh": "德摩根律" },
      "desc": {
        "zh": "否定与「或者」「并且」互换，四种形状在元件上切换：¬(A ∨ B) 与 ¬A ∧ ¬B 互推，¬(A ∧ B) 与 ¬A ∨ ¬B 互推。"
      },
      "metas": ["A", "B", "P"],
      "forms": [
        { "key": "notOr", "label": "¬(A ∨ B) → ¬A ∧ ¬B", "statement": "¬A ∧ ¬B", "premises": ["¬(A ∨ B)"] },
        { "key": "andNot", "label": "¬A ∧ ¬B → ¬(A ∨ B)", "statement": "¬(A ∨ B)", "premises": ["¬A ∧ ¬B"] },
        { "key": "orNot", "label": "¬A ∨ ¬B → ¬(A ∧ B)", "statement": "¬(A ∧ B)", "premises": ["¬A ∨ ¬B"] },
        { "key": "notAnd", "label": "¬(A ∧ B) → ¬A ∨ ¬B", "statement": "¬A ∨ ¬B", "premises": ["¬(A ∧ B)"] },
        { "key": "notEx", "label": "¬∃x. P → ∀x. ¬P", "statement": "∀x. ¬P", "premises": ["¬∃x. P"] },
        { "key": "allNot", "label": "∀x. ¬P → ¬∃x. P", "statement": "¬∃x. P", "premises": ["∀x. ¬P"] },
        { "key": "exNot", "label": "∃x. ¬P → ¬∀x. P", "statement": "¬∀x. P", "premises": ["∃x. ¬P"] },
        { "key": "notAll", "label": "¬∀x. P → ∃x. ¬P", "statement": "∃x. ¬P", "premises": ["¬∀x. P"] }
      ],
      "ports": ["¬(A ∨ B)"]
    },
    "dneg": {
      "name": { "zh": "双重否定律" },
      "desc": {
        "zh": "两种形状在元件上切换：由 ¬¬A 得到 A；由 A 得到 ¬¬A。"
      },
      "metas": ["A"],
      "forms": [
        { "key": "elim", "label": "¬¬A → A", "statement": "A", "premises": ["¬¬A"] },
        { "key": "intro", "label": "A → ¬¬A", "statement": "¬¬A", "premises": ["A"] }
      ],
      "ports": ["¬¬A"]
    },
    "arrow": {
      "name": { "zh": "蕴涵析取互化" },
      "desc": {
        "zh": "两种形状在元件上切换：由 A → B 得到 ¬A ∨ B；由 ¬A ∨ B 得到 A → B。"
      },
      "metas": ["A", "B"],
      "forms": [
        { "key": "elim", "label": "A → B ⟹ ¬A ∨ B", "statement": "¬A ∨ B", "premises": ["A → B"] },
        { "key": "intro", "label": "¬A ∨ B ⟹ A → B", "statement": "A → B", "premises": ["¬A ∨ B"] }
      ],
      "ports": ["A → B"]
    },
    "dist": {
      "name": { "zh": "分配律" },
      "desc": {
        "zh": "「或者」对「并且」分配，四种形状在元件上切换：A ∨ (B ∧ C) 与 (A ∨ B) ∧ (A ∨ C) 互推，(A ∧ B) ∨ C 与 (A ∨ C) ∧ (B ∨ C) 互推。"
      },
      "metas": ["A", "B", "C"],
      "forms": [
        {
          "key": "orAndR",
          "label": "A ∨ (B ∧ C) ⟹ (A ∨ B) ∧ (A ∨ C)",
          "statement": "(A ∨ B) ∧ (A ∨ C)",
          "premises": ["A ∨ (B ∧ C)"]
        },
        {
          "key": "andOrR",
          "label": "(A ∨ B) ∧ (A ∨ C) ⟹ A ∨ (B ∧ C)",
          "statement": "A ∨ (B ∧ C)",
          "premises": ["(A ∨ B) ∧ (A ∨ C)"]
        },
        {
          "key": "orAndL",
          "label": "(A ∧ B) ∨ C ⟹ (A ∨ C) ∧ (B ∨ C)",
          "statement": "(A ∨ C) ∧ (B ∨ C)",
          "premises": ["(A ∧ B) ∨ C"]
        },
        {
          "key": "andOrL",
          "label": "(A ∨ C) ∧ (B ∨ C) ⟹ (A ∧ B) ∨ C",
          "statement": "(A ∧ B) ∨ C",
          "premises": ["(A ∨ C) ∧ (B ∨ C)"]
        }
      ],
      "ports": ["A ∨ (B ∧ C)"]
    },
    "iff": {
      "name": { "zh": "等价展开" },
      "desc": {
        "zh": "两种形状在元件上切换：由 A ↔ B 得到 (¬A ∨ B) ∧ (¬B ∨ A)，反过来也可以。每种形状也是一条改写规则。"
      },
      "metas": ["A", "B"],
      "forms": [
        {
          "key": "elim",
          "label": "A ↔ B ⟹ (¬A ∨ B) ∧ (¬B ∨ A)",
          "statement": "(¬A ∨ B) ∧ (¬B ∨ A)",
          "premises": ["A ↔ B"]
        },
        {
          "key": "intro",
          "label": "(¬A ∨ B) ∧ (¬B ∨ A) ⟹ A ↔ B",
          "statement": "A ↔ B",
          "premises": ["(¬A ∨ B) ∧ (¬B ∨ A)"]
        }
      ],
      "ports": ["A ↔ B"]
    },
    "res": {
      "name": { "zh": "归结" },
      "card": "res",
      "desc": {
        "zh": "接入两条子句，一条含 A，另一条含 ¬A，位置不限：消去这一对，其余部分用「或者」连起来；什么都不剩时得到矛盾 ⊥。一次只消一对。"
      },
      "statement": "B ∨ C",
      "premises": ["A ∨ B", "¬A ∨ C"],
      "metas": ["A", "B", "C"],
      "ports": ["A ∨ B", "¬A ∨ C"]
    },
    "liar": {
      "name": { "zh": "说谎者悖论" },
      "desc": { "zh": "由 A ↔ ¬A 得到矛盾 ⊥。" },
      "statement": "⊥",
      "premises": ["A ↔ ¬A"],
      "metas": ["A"],
      "ports": ["A ↔ ¬A"]
    },
    "lem": {
      "name": { "zh": "排中律" },
      "desc": { "zh": "在元件上选定一句 A，输出 A ∨ ¬A。" },
      "statement": "A ∨ ¬A",
      "metas": ["A"],
      "ports": []
    }
  },
