        }
      }
    ],
    "mp": [
      {
        "at": "bot",
        "desc": {
          "zh": "由 A → B 和 A 得到 B。¬A 即 A → ⊥，所以由 ¬A 和 A 得到矛盾 ⊥。"
        }
      }
    ],
    "dneg": [
      { "by": "c-dneg", "forms": ["intro"] },
      {
        "at": "sp-rw",
        "desc": {
          "zh": "两种形状在元件上切换：由 ¬¬A 得到 A；由 A 得到 ¬¬A。每种形状也是一条改写规则。"
        }
      }
    ],
    "arrow": [
      { "by": "c-arrow", "forms": ["intro"] },
      {
        "at": "sp-rw",
        "desc": {
          "zh": "两种形状在元件上切换：由 A → B 得到 ¬A ∨ B；由 ¬A ∨ B 得到 A → B。每种形状也是一条改写规则。"
        }
      }
    ],
    "dist": [
      { "by": "c-dist", "forms": ["andOrR", "orAndL", "andOrL"] },
      {
        "at": "sp-rw",
        "desc": {
          "zh": "「或者」对「并且」分配，四种形状在元件上切换：A ∨ (B ∧ C) 与 (A ∨ B) ∧ (A ∨ C) 互推，(A ∧ B) ∨ C 与 (A ∨ C) ∧ (B ∨ C) 互推。每种形状也是一条改写规则。"
        }
      }
    ],
    "iff": [{ "by": "au-iff", "forms": ["intro"] }],
    "andE": [
      {
        "at": "iffUse",
        "desc": {
          "zh": "接入 A ∧ B，两个输出口分别得到 A 和 B。A ↔ B 表示 (A → B) ∧ (B → A)，也可以这样拆解。"
        }
      }
    ],
    "uDecompose": [
      {
        "at": "r-pattern",
        "desc": {
          "zh": "找到两边结构相同的等式，分解为对应部分之间的等式。两边都是「对所有」（或都是「存在」）时，取出两边的主体，用同一个变量 x，并在等式前记上 ⋀x，表示 x 受量词约束。"
        }
      }
    ],
    "uCheck": [
      {
        "at": "r-pattern",
        "desc": {
          "zh": "找到等式 ?A ≐ t，?A 不能取 t 时报告失败：t 含有 ?A 而不是 ?A 本身，或者 t 含有前面 ⋀ 约束的变量。"
        }
      }
    ],
    "unifier": [
      {
        "at": "r-pattern",
        "desc": {
          "zh": "把一组等式解到底：每个等式左边是一个 ?-字母，右边不含这些 ?-字母（最一般合一子）；无法合一时报告失败。?P(x) 这类等式不求解，原样保留。"
        }
      }
    ],
    "append": [
      {
        "at": "s-results",
        "desc": {
          "zh": "每个框收到相同的状态；依次输出第一个框的每一种结果、下一个框的每一种结果……失败的框没有结果。在元件上选定框的数目。"
        }
      }
    ],
    "repeat": [
      {
        "at": "s-results",
        "desc": {
          "zh": "框收到输入，框内的输出接到「结果」后再送回框内，逐轮重复，直到结果不再变化，输出最后一轮的结果；某一轮失败时，停在失败前的一轮。有几种结果时，只沿第一种继续。"
        }
      }
    ],
    "assumption": [
      {
        "at": "s-results",
        "desc": {
          "zh": "第一个目标与它的一条已知合一：成功时这个目标证完。每一条合得上的已知给出一种结果，按从上往下的顺序。"
        }
      }
    ],
    "rw": [
      {
        "at": "au-hyps",
        "desc": {
          "zh": "接入改写规则：在第一个目标中，由外向内、从左到右找到第一处与规则左边相合的位置，换成规则右边，只换这一处。规则带条件时，每个条件成为新目标，排在这个目标之后。接入多条时用第一条相合的；没有一处相合，元件失败。「改哪里」选「已知」时，改写第一个目标中从上往下第一条相合的已知。"
        }
      }
    ],
    "simp": [
      {
        "at": "au-hyps",
        "desc": {
          "zh": "接入改写规则列表：每一轮用第一条相合的规则改写一处，逐轮重复，直到没有规则相合。「改哪里」选「已知」时，改写第一个目标的已知。"
        }
      }
    ],
    "erule": [
      {
        "at": "s-results",
        "desc": {
          "zh": "接入规则：规则的结论与第一个目标合一，第一条前提与它的一条已知合一，这个目标换成其余的前提，每条一个目标。每一条规则、每一条合得上的已知都给出一种结果。"
        }
      }
    ]
  },
