{
  "parts": {
    "gNot": {
      "name": { "zh": "非 ¬" },
      "desc": { "zh": "¬a：输入是真，输出假；输入是假，输出真。" },
      "icon": "ToggleLeft",
      "family": "gate",
      "inputs": [{ "name": "a" }],
      "compute": "not(a)"
    },
    "gAnd": {
      "name": { "zh": "与 ∧" },
      "desc": { "zh": "a ∧ b：两个输入都是真，才输出真；否则输出假。" },
      "icon": "ToggleLeft",
      "family": "gate",
      "inputs": [{ "name": "a" }, { "name": "b" }],
      "compute": "and(a, b)"
    },
    "mp": {
      "name": { "zh": "套用" },
      "desc": { "zh": "由 A → B 和 A 得到 B。" },
      "revisions": [{ "at": "bot", "desc": { "zh": "由 A → B 和 A 得到 B。¬A 即 A → ⊥，所以由 ¬A 和 A 得到矛盾 ⊥。" } }],
      "icon": "GitFork",
      "family": "rule",
      "inputs": [{ "name": "imp", "label": { "zh": "A → B" } }, { "name": "a", "label": { "zh": "A" } }],
      "compute": "mp(imp, a)"
    },
    "impI": {
      "name": { "zh": "假设框" },
      "desc": { "zh": "带一个框，A 在元件上设定。框内可以使用假设 A；框内证出 B 并接到「结论」，元件输出 A → B。" },
      "icon": "Box",
      "family": "box",
      "inputs": [],
      "settings": [{ "key": "A", "control": "tree", "label": { "zh": "假设" } }],
      "regions": [{ "name": "body", "label": { "zh": "框内" }, "opens": true, "closes": true }],
      "compute": "impI(body)"
    },
    "andI": {
      "name": { "zh": "拼接" },
      "desc": { "zh": "接入 A 和 B，得到 A ∧ B。" },
      "icon": "GitFork",
      "family": "rule",
      "inputs": [{ "name": "a", "label": { "zh": "A" } }, { "name": "b", "label": { "zh": "B" } }],
      "compute": "andI(a, b)"
    },
    "andE": {
      "name": { "zh": "拆解" },
      "desc": { "zh": "接入 A ∧ B，两个输出口分别得到 A 和 B。" },
      "revisions": [
        { "at": "iffUse", "desc": { "zh": "接入 A ∧ B，两个输出口分别得到 A 和 B。A ↔ B 表示 (A → B) ∧ (B → A)，也可以这样拆解。" } }
      ],
      "icon": "GitFork",
      "family": "rule",
      "inputs": [{ "name": "ab", "label": { "zh": "A ∧ B" } }],
      "outputs": [{ "name": "left", "label": { "zh": "A" } }, { "name": "right", "label": { "zh": "B" } }],
      "compute": { "left": "andE(ab)", "right": "andE(ab)" }
    },
    "orI": {
      "name": { "zh": "补充" },
      "desc": { "zh": "接入 A，选定另一句 B 和它的位置，得到 A ∨ B 或 B ∨ A；不需要证明 B。" },
      "icon": "GitFork",
      "family": "rule",
      "inputs": [{ "name": "a", "label": { "zh": "A" } }],
      "settings": [
        { "key": "other", "control": "tree", "label": { "zh": "另一边" } },
        {
          "key": "side",
          "control": "buttons",
          "label": { "zh": "另一边放" },
          "options": [
            { "value": "left", "label": { "zh": "左" } },
            { "value": "right", "label": { "zh": "右" } }
          ],
          "default": "right"
        }
      ],
      "compute": "orI(a)"
    },
    "orE": {
      "name": { "zh": "分类讨论" },
      "desc": { "zh": "接入 A ∨ B，在两个框中分别假设 A、B。两个框都证出同一句 C 并接到各自的「结论」时，元件输出 C。" },
      "icon": "Box",
      "family": "box",
      "inputs": [{ "name": "ab", "label": { "zh": "A ∨ B" } }],
      "regions": [
        { "name": "left", "label": { "zh": "情况一" }, "opens": true, "closes": true },
        { "name": "right", "label": { "zh": "情况二" }, "opens": true, "closes": true }
      ],
      "compute": "orE(ab, left, right)"
    },
    "botE": {
      "name": { "zh": "爆炸" },
      "desc": { "zh": "由矛盾 ⊥ 得到元件上选定的任意一句。" },
      "icon": "GitFork",
      "family": "rule",
      "inputs": [{ "name": "bot", "label": { "zh": "⊥" } }],
      "settings": [{ "key": "C", "control": "tree", "label": { "zh": "得出" } }],
      "compute": "botE(bot)"
    },
    "raa": {
      "name": { "zh": "反证法" },
      "desc": { "zh": "由 ¬¬A 得到 A（双重否定消去）。" },
      "icon": "GitFork",
      "family": "rule",
      "inputs": [{ "name": "nna", "label": { "zh": "¬¬A" } }],
      "compute": "raa(nna)"
    },
    "allI": {
      "name": { "zh": "任取框" },
      "desc": { "zh": "在元件上为任意对象取名 a，在框内证明 P(a) 并接到「结论」，框外得到 ∀x. P(x)。a 不能出现在未解除的假设中。" },
      "icon": "Box",
      "family": "box",
      "inputs": [],
      "settings": [{ "key": "x", "control": "select", "label": { "zh": "名字" }, "from": "names()" }],
      "regions": [{ "name": "body", "label": { "zh": "框内" }, "closes": true }],
      "compute": "allI(body)"
    },
    "allE": {
      "name": { "zh": "选定一例" },
      "desc": { "zh": "接入 ∀x. P(x)，选定对象 t，得到 P(t)。" },
      "icon": "GitFork",
      "family": "rule",
      "inputs": [{ "name": "all", "label": { "zh": "∀x. P(x)" } }],
      "settings": [{ "key": "t", "control": "select", "label": { "zh": "哪一样" }, "from": "instances()" }],
      "compute": "allE(all)"
    },
    "exI": {
      "name": { "zh": "概括" },
      "desc": { "zh": "接入 P(t)，以 t 为例得到 ∃x. P(x)。只有一个相符的存在命题时自动输出；有多个时，在元件上选择要得出的命题。" },
      "icon": "GitFork",
      "family": "rule",
      "inputs": [{ "name": "a", "label": { "zh": "P(t)" } }],
      "settings": [{ "key": "target", "control": "tree", "label": { "zh": "要得出" }, "optional": true }],
      "compute": "exI(a)"
    },
    "exE": {
      "name": { "zh": "实例框" },
      "desc": {
        "zh": "接入 ∃x. P(x)，在元件上为存在的对象取名 a。框内可以假设 P(a)；证出 C 并接到「结论」后，框外得到 C。C 中不能出现 a，a 也不能出现在未解除的假设中。"
      },
      "icon": "Box",
      "family": "box",
      "inputs": [{ "name": "ex", "label": { "zh": "∃x. P(x)" } }],
      "settings": [{ "key": "x", "control": "select", "label": { "zh": "见证" }, "from": "names()" }],
      "regions": [{ "name": "body", "label": { "zh": "框内" }, "opens": true, "closes": true }],
      "compute": "exE(ex, body)"
    },
    "natInd": {
      "name": { "zh": "数学归纳法" },
      "desc": {
        "zh": "带两个框，证元件上选定的 ∀x. P(x)。第一个框证 P(0)；第二个框内的数记作 a（在元件上命名，不能出现在未解除的假设中），可以使用假设 P(a)，要证 P(S a)。两个框都证完，元件输出 ∀x. P(x)。"
      },
      "icon": "Box",
      "family": "box",
      "inputs": [],
      "settings": [
        { "key": "P", "control": "tree", "label": { "zh": "要证" } },
        { "key": "x", "control": "select", "label": { "zh": "名字" }, "from": "names()" }
      ],
      "regions": [
        { "name": "zero", "label": { "zh": "0 的情况" }, "closes": true },
        { "name": "step", "label": { "zh": "从 a 到 S a" }, "opens": true, "closes": true }
      ],
      "compute": "natInd(zero, step)"
    },
    "refl": {
      "name": { "zh": "自反律" },
      "desc": { "zh": "在元件上选定一样东西 t，得到 t = t。" },
      "icon": "GitFork",
      "family": "rule",
      "inputs": [],
      "settings": [{ "key": "t", "control": "select", "label": { "zh": "哪一样" }, "from": "things()" }],
      "compute": "refl()"
    },
    "rewrite": {
      "name": { "zh": "等量代换" },
      "desc": { "zh": "接入 s = t 和一句含 s 的话；元件标出这句话里的每一处 s，勾选的几处换成 t。" },
      "icon": "GitFork",
      "family": "rule",
      "inputs": [{ "name": "eq", "label": { "zh": "s = t" } }, { "name": "p", "label": { "zh": "φ(s)" } }],
      "settings": [{ "key": "at", "control": "list", "label": { "zh": "换哪几处" }, "from": "occurrences(eq, p)" }],
      "compute": "rewrite(eq, p)"
    },
    "anyR": {
      "name": { "zh": "任意结论" },
      "desc": { "zh": "输出 ?R：任意一句话。" },
      "icon": "Sigma",
      "family": "tactic",
      "inputs": [],
      "compute": "anyR()"
    },
    "swapConcl": {
      "name": { "zh": "替换结论" },
      "desc": { "zh": "接入一条规则和一句话：保留规则的前提，结论换成这句话。" },
      "icon": "Sigma",
      "family": "tactic",
      "inputs": [{ "name": "rule", "label": { "zh": "规则" } }, { "name": "to", "label": { "zh": "换成" } }],
      "compute": "swapConcl(rule, to)"
    },
    "consFront": {
      "name": { "zh": "添加首项" },
      "desc": { "zh": "把「这一样」放在「一串」的最前面；「一串」接入的不是列表时，把两者组成一个列表。" },
      "icon": "Sigma",
      "family": "tactic",
      "inputs": [{ "name": "first", "label": { "zh": "这一样" } }, { "name": "rest", "label": { "zh": "一串" } }],
      "compute": "consFront(first, rest)"
    },
    "mkRule": {
      "name": { "zh": "构造规则" },
      "desc": { "zh": "由前提（列表或单项）和结论构造规则 ⟦前提⟧ ⟹ 结论。句子直接作为前提；规则成为带自身假设的前提。" },
      "icon": "Sigma",
      "family": "tactic",
      "inputs": [
        { "name": "premises", "label": { "zh": "前提" } },
        { "name": "conclusion", "label": { "zh": "结论" } }
      ],
      "compute": "mkRule(premises, conclusion)"
    },
    "eachOf": {
      "name": { "zh": "逐项处理" },
      "desc": { "zh": "接入列表：框每次收到其中一项，框内的输出接到「结果」；每一项处理一次，结果按原顺序组成列表。" },
      "icon": "Box",
      "family": "loop",
      "inputs": [{ "name": "in" }],
      "regions": [{ "name": "body", "label": { "zh": "每一样" }, "opens": true }],
      "compute": "eachOf(in)"
    },
    "keepBound": {
      "name": { "zh": "保留⋀" },
      "desc": { "zh": "接入一条规则。规则以约束变量开头（⋀x. …）时，框内处理其后的规则，输出时在结果前保留这些约束变量；没有约束变量时，框内直接处理输入。" },
      "icon": "Box",
      "family": "loop",
      "inputs": [{ "name": "in" }],
      "regions": [{ "name": "body", "label": { "zh": "约束变量之后的规则" }, "opens": true }],
      "compute": "keepBound(in)"
    },
    "uDelete": {
      "name": { "zh": "删除" },
      "desc": { "zh": "找到两边相同的等式 t ≐ t，删去它。" },
      "icon": "Sigma",
      "family": "tactic",
      "inputs": [{ "name": "in" }],
      "compute": "uDelete(in)"
    },
    "uDecompose": {
      "name": { "zh": "分解" },
      "desc": {
        "zh": "找到两边结构相同的等式（都是「并且」、都是同一个谓词……），分解为对应部分之间的等式：?A ∧ ?B ≐ 下雨 ∧ 刮风 分解为 ?A ≐ 下雨 和 ?B ≐ 刮风。¬A 按 A → ⊥ 分解。"
      },
      "revisions": [
        {
          "at": "r-pattern",
          "desc": {
            "zh": "找到两边结构相同的等式，分解为对应部分之间的等式。两边都是「对所有」（或都是「存在」）时，取出两边的主体，用同一个变量 x，并在等式前记上 ⋀x，表示 x 受量词约束。"
          }
        }
      ],
      "icon": "Sigma",
      "family": "tactic",
      "inputs": [{ "name": "in" }],
      "compute": "uDecompose(in)"
    },
    "uConflict": {
      "name": { "zh": "冲突" },
      "desc": { "zh": "找到两边都不是 ?-字母、结构却不同的等式（一边是「并且」一边是「或者」，或是两个不同的句子……），报告失败。" },
      "icon": "Sigma",
      "family": "tactic",
      "inputs": [{ "name": "in" }],
      "compute": "uConflict(in)"
    },
    "uSwap": {
      "name": { "zh": "定向" },
      "desc": { "zh": "找到只有右边是 ?-字母的等式 t ≐ ?A，改写为 ?A ≐ t。" },
      "icon": "Sigma",
      "family": "tactic",
      "inputs": [{ "name": "in" }],
      "compute": "uSwap(in)"
    },
    "uCheck": {
      "name": { "zh": "出现检查" },
      "desc": { "zh": "找到等式 ?A ≐ t，t 含有 ?A 而不是 ?A 本身时，报告失败。" },
      "revisions": [
        {
          "at": "r-pattern",
          "desc": { "zh": "找到等式 ?A ≐ t，?A 不能取 t 时报告失败：t 含有 ?A 而不是 ?A 本身，或者 t 含有前面 ⋀ 约束的变量。" }
        }
      ],
      "icon": "Sigma",
      "family": "tactic",
      "inputs": [{ "name": "in" }],
      "compute": "uCheck(in)"
    },
    "uEliminate": {
      "name": { "zh": "消元" },
      "desc": { "zh": "找到等式 ?A ≐ t（t 不含 ?A），而 ?A 还出现在其他等式中：把那些等式中的 ?A 全部换成 t。" },
      "icon": "Sigma",
      "family": "tactic",
      "inputs": [{ "name": "in" }],
      "compute": "uEliminate(in)"
    },
    "uPattern": {
      "name": { "zh": "模式合一" },
      "desc": {
        "zh": "找到等式 ⋀x. ?P(x) ≐ t：?P 的参数是受 ⋀ 约束、互不相同的变量，t 中没有其他 ⋀ 变量。解出 ?P ≐ fun x => t。?P 的参数不是这样的变量时（?P(安)、?P(?t)），保留原等式不变。"
      },
      "icon": "Sigma",
      "family": "tactic",
      "inputs": [{ "name": "in" }],
      "compute": "uPattern(in)"
    },
    "repeat": {
      "name": { "zh": "重复框" },
      "desc": { "zh": "框收到输入，框内的输出接到「结果」后再送回框内，逐轮重复，直到结果不再变化，输出最后一轮的结果；某一轮失败时，停在失败前的一轮。" },
      "revisions": [
        {
          "at": "s-results",
          "desc": { "zh": "框收到输入，框内的输出接到「结果」后再送回框内，逐轮重复，直到结果不再变化，输出最后一轮的结果；某一轮失败时，停在失败前的一轮。有几种结果时，只沿第一种继续。" }
        }
      ],
      "icon": "Repeat",
      "family": "loop",
      "inputs": [{ "name": "in" }],
      "regions": [{ "name": "body", "label": { "zh": "每一轮" }, "opens": true, "closes": true }],
      "compute": "repeat(in, body)"
    },
    "rule": {
      "name": { "zh": "逆用规则" },
      "desc": { "zh": "从「规则」口接入规则，用第一条适用的：第一个目标与规则的结论合一，换成规则的前提（每条前提一个目标，前提自带的假设加入已知）。尚未确定的 ?-字母留在目标中。" },
      "icon": "Sigma",
      "family": "tactic",
      "inputs": [{ "name": "in" }, { "name": "rules", "label": { "zh": "规则" } }],
      "compute": "rule(in, rules)"
    },
    "assumption": {
      "name": { "zh": "由假设得证" },
      "desc": { "zh": "第一个目标与它的一条已知合一：成功时这个目标证完，相应的 ?-字母随之确定。从上往下查找，用第一条合得上的已知。" },
      "revisions": [
        { "at": "s-results", "desc": { "zh": "第一个目标与它的一条已知合一：成功时这个目标证完。每一条合得上的已知给出一种结果，按从上往下的顺序。" } }
      ],
      "icon": "Sigma",
      "family": "tactic",
      "inputs": [{ "name": "in" }],
      "compute": "assumption(in)"
    },
    "defer": {
      "name": { "zh": "目标后移" },
      "desc": { "zh": "把第一个目标移到最后，原来的第二个目标成为第一个。" },
      "icon": "Sigma",
      "family": "tactic",
      "inputs": [{ "name": "in" }],
      "compute": "defer(in)"
    },
    "append": {
      "name": { "zh": "依次尝试" },
      "desc": { "zh": "每个框收到相同的状态；输出第一个没有失败的框的结果。在元件上选定框的数目。" },
      "revisions": [
        { "at": "s-results", "desc": { "zh": "每个框收到相同的状态；依次输出第一个框的每一种结果、下一个框的每一种结果……失败的框没有结果。在元件上选定框的数目。" } }
      ],
      "icon": "Box",
      "family": "loop",
      "inputs": [{ "name": "in" }],
      "settings": [
        {
          "key": "ways",
          "control": "select",
          "label": { "zh": "框" },
          "options": [
            { "value": "2", "label": { "zh": "2 条" } },
            { "value": "3", "label": { "zh": "3 条" } },
            { "value": "4", "label": { "zh": "4 条" } },
            { "value": "5", "label": { "zh": "5 条" } },
            { "value": "6", "label": { "zh": "6 条" } }
          ],
          "default": "2"
        }
      ],
      "regions": [
        { "name": "first", "label": { "zh": "先试" }, "opens": true },
        { "name": "second", "label": { "zh": "再试" }, "opens": true },
        { "name": "third", "label": { "zh": "再试" }, "opens": true, "when": "ge($ways, 3)" },
        { "name": "fourth", "label": { "zh": "再试" }, "opens": true, "when": "ge($ways, 4)" },
        { "name": "fifth", "label": { "zh": "再试" }, "opens": true, "when": "ge($ways, 5)" },
        { "name": "sixth", "label": { "zh": "再试" }, "opens": true, "when": "ge($ways, 6)" }
      ],
      "compute": "append(in)"
    },
    "search": {
      "name": { "zh": "回溯搜索" },
      "desc": {
        "zh": "深度优先搜索：框内的元件对收到的状态走一步，再从得到的每种结果继续；一条路走到底再回溯走下一条，直到没有目标。输出找到的每一个证完的状态。回到原状态的一步（目标没有减少，已知也没有增加）不再继续。可以在元件上设定最大深度。"
      },
      "icon": "Search",
      "family": "loop",
      "inputs": [{ "name": "in" }],
      "settings": [
        {
          "key": "depth",
          "control": "select",
          "label": { "zh": "最多" },
          "options": [
            { "value": "any", "label": { "zh": "不限" } },
            { "value": "2", "label": { "zh": "2 层" } },
            { "value": "3", "label": { "zh": "3 层" } },
            { "value": "4", "label": { "zh": "4 层" } },
            { "value": "5", "label": { "zh": "5 层" } },
            { "value": "6", "label": { "zh": "6 层" } },
            { "value": "8", "label": { "zh": "8 层" } },
            { "value": "10", "label": { "zh": "10 层" } },
            { "value": "12", "label": { "zh": "12 层" } }
          ],
          "default": "any"
        }
      ],
      "regions": [{ "name": "body", "label": { "zh": "每一步" }, "opens": true }],
      "compute": "search(in)"
    },
    "each": {
      "name": { "zh": "逐个目标" },
      "desc": { "zh": "框内的元件对每个目标各执行一次，每次只看到这一个目标；任一目标失败，整个元件失败。" },
      "icon": "Rows3",
      "family": "loop",
      "inputs": [{ "name": "in" }],
      "regions": [{ "name": "body", "label": { "zh": "逐个目标" }, "opens": true }],
      "compute": "each(in)"
    },
    "rw": {
