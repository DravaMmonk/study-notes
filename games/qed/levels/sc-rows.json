{
  "symbolicWords": {
    "Rain": { "zh": "A" },
    "Wet": { "zh": "B" },
    "Slip": { "zh": "C" }
  },
  "title": { "zh": "一句一个元件" },
  "tray": "proof",
  "intro": [
    {
      "t": {
        "zh": "<wiki-ref to=\"provers\"></wiki-ref>里的证明也可以写给人读，这叫<wiki-ref to=\"scripts\"></wiki-ref>。这一章的脚本照 Isabelle 的 Isar 写法：have 证出路上的一句，show 证出要证的那句，by 后面写这一句用的规则或证明助手，using 后面写它用到的事实；proof … qed 是一个块。"
      }
    }
  ],
  "after": { "zh": "脚本和证明电路是同一个证明的两种写法。" },
  "tasks": [
    {
      "id": "sc-rows_1",
      "kind": "script",
      "step": { "zh": "读" },
      "locked": true,
      "brief": {
        "zh": "这段脚本每一句后面的 by 还空着。选出每一句用的规则。"
      },
      "premises": { "p": "Rain → Wet", "q": "Wet → Slip" },
      "goal": "Rain → Wet ∧ Slip",
      "given": [
        { "k": "show", "stmt": "Rain → Wet ∧ Slip", "by": "proof" },
        { "k": "assume", "stmt": "Rain" },
        { "k": "have", "stmt": "Wet", "using": ["p", "a1"], "by": "" },
        { "k": "have", "stmt": "Slip", "using": ["q", "h1"], "by": "" },
        { "k": "show", "stmt": "Wet ∧ Slip", "using": ["h1", "h2"], "by": "" }
      ],
      "answer": [
        { "k": "show", "stmt": "Rain → Wet ∧ Slip", "by": "proof" },
        { "k": "assume", "stmt": "Rain" },
        { "k": "have", "stmt": "Wet", "using": ["p", "a1"], "by": "rule:mp" },
        { "k": "have", "stmt": "Slip", "using": ["q", "h1"], "by": "rule:mp" },
        { "k": "show", "stmt": "Wet ∧ Slip", "using": ["h1", "h2"], "by": "rule:conjI" }
      ],
      "naive": [
        { "k": "show", "stmt": "Rain → Wet ∧ Slip", "by": "proof" },
        { "k": "assume", "stmt": "Rain" },
        { "k": "have", "stmt": "Wet", "using": ["p", "a1"], "by": "rule:conjI" },
        { "k": "have", "stmt": "Slip", "using": ["q", "h1"], "by": "rule:mp" },
        { "k": "show", "stmt": "Wet ∧ Slip", "using": ["h1", "h2"], "by": "rule:conjI" }
      ],
      "hint": [
        {
          "zh": "由「下雨」和「下雨 → 地湿」得出「地湿」，用的是哪一条规则？"
        }
      ]
    },
    {
      "id": "sc-rows_2",
      "kind": "proof",
      "step": { "zh": "接线" },
      "cases": [],
      "brief": { "zh": "在证明板上接出这段脚本写的证明。" },
      "tests": [{ "premises": { "p": "Rain → Wet", "q": "Wet → Slip" }, "goal": "Rain → Wet ∧ Slip" }],
      "script": [
        { "k": "show", "stmt": "Rain → Wet ∧ Slip", "by": "proof" },
        { "k": "assume", "stmt": "Rain" },
        { "k": "have", "stmt": "Wet", "using": ["p", "a1"], "by": "rule:mp" },
        { "k": "have", "stmt": "Slip", "using": ["q", "h1"], "by": "rule:mp" },
        { "k": "show", "stmt": "Wet ∧ Slip", "using": ["h1", "h2"], "by": "rule:conjI" }
      ],
      "hint": [
        {
          "zh": "proof 到 qed 是一个假设框，assume 是框里的假设。"
        }
      ],
      "solution": [
        "f = impI[A=Rain](body: c) {",
        "  body {",
        "    m1 = mp(p, f.body)",
        "    m2 = mp(q, m1)",
        "    c = andI(m1, m2)",
        "  }",
        "}",
        "goal <- f"
      ]
    }
  ]
}
