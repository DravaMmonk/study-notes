{
  "title": { "zh": "在「对所有」底下" },
  "tray": "machine",
  "intro": [
    {
      "t": {
        "zh": "目标前面有「对所有」，化简照样改写它里面的式子。"
      }
    }
  ],
  "tasks": [
    {
      "id": "sp-under",
      "kind": "machine",
      "want": "proved",
      "inputs": [{ "name": "in", "label": { "zh": "目标" } }],
      "backtrack": true,
      "words": ["everyday", "terms"],
      "defs": ["plus"],
      "tests": [
        { "goal": "∀x. plus(zero, plus(zero, x)) = x" },
        { "goal": "∀x. ∀y. plus(s(zero), plus(x, y)) = s(plus(x, y))" }
      ],
      "brief": { "zh": "设计一个证明助手，证完每一个目标。" },
      "hint": [{ "zh": "化简之后还剩几层「对所有」。" }],
      "solution": [
        "c0r0 = math[use=[\"def.0\", \"def.1\"]]()",
        "c3r0 = refl()",
        "c0 = simp(in, c0r0)",
        "c1 = repeat(c0, body: c2) {",
        "  body {",
        "    c2r0 = allI()",
        "    c2 = rule(c1.body, c2r0)",
        "  }",
        "}",
        "c3 = rule(c1, c3r0)",
        "out <- c3"
      ]
    }
  ]
}
