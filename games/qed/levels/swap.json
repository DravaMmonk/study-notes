{
  "title": { "en": "Swap the conditions" },
  "tray": "proof",
  "builds": "swap",
  "intro": [
    {
      "t": {
        "en": "“On a Saturday, if it rains I rest” and “if it rains, on a Saturday I rest” say the same thing, but the kernel only accepts what is proved."
      }
    }
  ],
  "tasks": [
    {
      "id": "swap",
      "kind": "proof",
      "tests": [{ "premises": { "p": "A → (B → C)" }, "goal": "B → (A → C)" }],
      "cases": [{ "A": "Sat", "B": "Rain", "C": "Rest" }, { "A": "Exam", "B": "Study", "C": "Pass" }],
      "hint": [
        { "en": "How many →s are in the goal?" },
        { "en": "Inside the innermost box, both conditions are visible." }
      ],
      "solution": [
        "f = impI[A=B](body: g) {",
        "  body {",
        "    g = impI[A=A](body: m2) {",
        "      body {",
        "        m1 = mp(p, g.body)",
        "        m2 = mp(m1, f.body)",
        "      }",
        "    }",
        "  }",
        "}",
        "goal <- f"
      ]
    }
  ]
}
