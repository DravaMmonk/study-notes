{
  "title": { "zh": "换一换条件的顺序" },
  "tray": "proof",
  "intro": [
    {
      "t": {
        "zh": "「周六的话，下雨我就休息」和「下雨的话，周六我就休息」说的是一回事，可证明核只认证出来的东西。"
      }
    }
  ],
  "tasks": [
    {
      "id": "swap",
      "kind": "proof",
      "tests": [{ "premises": { "p": "A → (B → C)" }, "goal": "B → (A → C)" }],
      "cases": [{ "A": "Sat", "B": "Rain", "C": "Rest" }, { "A": "Exam", "B": "Study", "C": "Pass" }],
      "hint": [
        { "zh": "目标里有几个 →？" },
        { "zh": "最里面的框里，两个条件都看得见。" }
      ],
      "solution": [
        "f = impI[A=B](body: g) {",
        "  body {",
        "    g = impI[A=A](body: m2) {",
        "      body {",
        "        m1 = mp(p, g.body)",
        "        m2 = mp(m1, f.body)",
        "      }",
        "    }",
        "  }",
        "}",
        "goal <- f"
      ]
    }
  ]
}
