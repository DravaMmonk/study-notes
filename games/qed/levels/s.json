{
  "title": { "zh": "在条件下套用" },
  "tray": "proof",
  "intro": [
    {
      "t": {
        "zh": "下雨的时候，只要刮风，就地湿；下雨的时候，一定刮风。那么下雨的时候，就地湿：这是在「下雨」这个条件下套用。这句话叫 <part-ref to=\"lemma:axS\"></part-ref>。"
      }
    }
  ],
  "tasks": [
    {
      "id": "s",
      "kind": "proof",
      "tests": [{ "goal": "(A → (B → C)) → ((A → B) → (A → C))" }],
      "cases": [{ "A": "Rain", "B": "Wind", "C": "Wet" }, { "A": "Exam", "B": "Study", "C": "Pass" }],
      "hint": [
        { "zh": "数一数最外层有几个 →。" },
        { "zh": "最里面的框里，三个假设都看得见。" }
      ],
      "solution": [
        "f = impI[A=\"A -> (B -> C)\"](body: g) {",
        "  body {",
        "    g = impI[A=\"A -> B\"](body: h) {",
        "      body {",
        "        h = impI[A=A](body: m3) {",
        "          body {",
        "            m1 = mp(f.body, h.body)",
        "            m2 = mp(g.body, h.body)",
        "            m3 = mp(m1, m2)",
        "          }",
        "        }",
        "      }",
        "    }",
        "  }",
        "}",
        "goal <- f"
      ]
    }
  ]
}
