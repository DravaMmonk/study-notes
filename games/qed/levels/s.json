{
  "title": { "en": "Apply under a condition" },
  "tray": "proof",
  "builds": "axS",
  "intro": [
    {
      "t": {
        "en": "When it rains, if it is windy the ground is wet; when it rains, it is windy. So when it rains, the ground is wet: Apply under the condition “it rains”. This sentence is called <part-ref to=\"lemma:axS\"></part-ref>."
      }
    }
  ],
  "tasks": [
    {
      "id": "s",
      "kind": "proof",
      "tests": [{ "goal": "(A → (B → C)) → ((A → B) → (A → C))" }],
      "cases": [{ "A": "Rain", "B": "Wind", "C": "Wet" }, { "A": "Exam", "B": "Study", "C": "Pass" }],
      "hint": [
        { "en": "Count the outermost →s." },
        { "en": "Inside the innermost box, all three assumptions are visible." }
      ],
      "solution": [
        "f = impI[A=\"A -> (B -> C)\"](body: g) {",
        "  body {",
        "    g = impI[A=\"A -> B\"](body: h) {",
        "      body {",
        "        h = impI[A=A](body: m3) {",
        "          body {",
        "            m1 = mp(f.body, h.body)",
        "            m2 = mp(g.body, h.body)",
        "            m3 = mp(m1, m2)",
        "          }",
        "        }",
        "      }",
        "    }",
        "  }",
        "}",
        "goal <- f"
      ]
    }
  ]
}
