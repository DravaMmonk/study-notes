{
  "adds": ["introRules", "elimRules"],
  "tray": "machine",
  "title": { "en": "Your own auto" },
  "intro": [
    {
      "t": {
        "en": "These four sentences were all wired one by one on the proof board. This time one proof assistant must prove them all. The proof assistant you design becomes a new part, <part-ref to=\"lemma:auto\"></part-ref>."
      }
    }
  ],
  "tasks": [
    {
      "id": "s-auto",
      "kind": "machine",
      "want": "proved",
      "inputs": [{ "name": "in", "label": { "en": "Goal" } }],
      "backtrack": true,
      "tests": [
        { "goal": "Rain ∧ (Wind ∨ Wet) → (Rain ∧ Wind) ∨ (Rain ∧ Wet)" },
        { "goal": "(Rain → Wet) → ((Wet → Slip) → (Rain → Slip))" },
        { "goal": "(∃x. Human(x) ∧ Likes(x, i)) → ∃x. Likes(x, i)" },
        { "goal": "(∀x. Human(x) ∧ Bird(x)) → ∀x. Bird(x)" }
      ],
      "brief": { "en": "Design a proof assistant that proves every goal." },
      "hint": [
        { "en": "What can one step do?" },
        { "en": "How many steps it takes is not known beforehand." }
      ],
      "solution": [
        "c0 = search(in, body: c1) {",
        "  body {",
        "    c1 = append[ways=\"3\"](c0.body, first: c2, second: c3, third: c4) {",
        "      first {",
        "        c2 = assumption(c1.first)",
        "      }",
        "      second {",
        "        c3 = introRules(c1.second)",
        "      }",
        "      third {",
        "        c4 = elimRules(c1.third)",
        "      }",
        "    }",
        "  }",
        "}",
        "out <- c0"
      ]
    }
  ]
}
