{
  "adds": ["introRules", "elimRules"],
  "tray": "machine",
  "title": { "zh": "自建 auto" },
  "intro": [
    {
      "t": {
        "zh": "这四句都在证明板上逐个接过。这一次，要一个证明助手把它们全部证完。设计出的证明助手会成为新元件<part-ref to=\"lemma:auto\"></part-ref>。"
      }
    }
  ],
  "tasks": [
    {
      "id": "s-auto",
      "kind": "machine",
      "want": "proved",
      "inputs": [{ "name": "in", "label": { "zh": "目标" } }],
      "backtrack": true,
      "tests": [
        { "goal": "Rain ∧ (Wind ∨ Wet) → (Rain ∧ Wind) ∨ (Rain ∧ Wet)" },
        { "goal": "(Rain → Wet) → ((Wet → Slip) → (Rain → Slip))" },
        { "goal": "(∃x. Human(x) ∧ Likes(x, i)) → ∃x. Likes(x, i)" },
        { "goal": "(∀x. Human(x) ∧ Bird(x)) → ∀x. Bird(x)" }
      ],
      "brief": { "zh": "设计一个证明助手，证完每一个目标。" },
      "hint": [
        { "zh": "一步里能做的事有哪几样？" },
        { "zh": "要走几步，事先不知道。" }
      ],
      "solution": [
        "c0 = search(in, body: c1) {",
        "  body {",
        "    c1 = append[ways=\"3\"](c0.body, first: c2, second: c3, third: c4) {",
        "      first {",
        "        c2 = assumption(c1.first)",
        "      }",
        "      second {",
        "        c3 = introRules(c1.second)",
        "      }",
        "      third {",
        "        c4 = elimRules(c1.third)",
        "      }",
        "    }",
        "  }",
        "}",
        "out <- c0"
      ]
    }
  ]
}
