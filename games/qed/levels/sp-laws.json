{
  "title": { "en": "More rewrite rules" },
  "tray": "machine",
  "intro": [
    {
      "t": {
        "en": "<part-ref to=\"lemma:arrow\"></part-ref> and <part-ref to=\"lemma:dist\"></part-ref> are equivalences proved both ways too."
      }
    }
  ],
  "tasks": [
    {
      "id": "sp-laws_1",
      "kind": "machine",
      "want": "becomes",
      "inputs": [{ "name": "in", "label": { "en": "Goal" } }],
      "backtrack": true,
      "step": { "en": "Arrow away" },
      "tests": [
        { "goal": "(Rain → Wet) ∧ Wind", "becomes": [["(¬Rain ∨ Wet) ∧ Wind"]] },
        { "goal": "¬(Alarm → Up)", "becomes": [["¬(¬Alarm ∨ Up)"]] },
        { "goal": "Wind ∨ (Rain → Slip)", "becomes": [["Wind ∨ (¬Rain ∨ Slip)"]] }
      ],
      "brief": {
        "en": "Design a proof assistant that turns the “if … then …” in each goal into an “or”."
      },
      "hint": [
        {
          "en": "Look at the two shapes of <part-ref to=\"lemma:arrow\"></part-ref>."
        }
      ],
      "solution": ["c0r0 = arrow[use=[\"arrow.elim\"]]()", "c0 = rw(in, c0r0)", "out <- c0"]
    },
    {
      "id": "sp-laws_2",
      "kind": "machine",
      "want": "becomes",
      "inputs": [{ "name": "in", "label": { "en": "Goal" } }],
      "backtrack": true,
      "step": { "en": "Distribute" },
      "tests": [
        { "goal": "Rain ∨ (Wind ∧ Wet)", "becomes": [["(Rain ∨ Wind) ∧ (Rain ∨ Wet)"]] },
        { "goal": "(Sat ∧ Rest) ∨ Happy", "becomes": [["(Sat ∨ Happy) ∧ (Rest ∨ Happy)"]] }
      ],
      "brief": {
        "en": "Design a proof assistant that distributes the “or” in each goal over the “and”."
      },
      "hint": [
        { "en": "In one goal the “and” is on the right, in the other on the left." },
        {
          "en": "One rewrite rule fits only one shape; to try both, see <part-ref to=\"part:append\"></part-ref>."
        }
      ],
      "solution": [
        "c0 = append(in, first: c1, second: c2) {",
        "  first {",
        "    c1r0 = dist[use=[\"dist.orAndR\"]]()",
        "    c1 = rw(c0.first, c1r0)",
        "  }",
        "  second {",
        "    c2r0 = dist[use=[\"dist.orAndL\"]]()",
        "    c2 = rw(c0.second, c2r0)",
        "  }",
        "}",
        "out <- c0"
      ]
    }
  ]
}
