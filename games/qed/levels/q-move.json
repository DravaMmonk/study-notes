{
  "title": { "en": "Moving a quantifier out" },
  "tray": "proof",
  "intro": [
    {
      "t": {
        "en": "Is “whoever is late, the teacher is cross” the same as “if anyone is late, the teacher is cross”?"
      }
    }
  ],
  "tasks": [
    {
      "id": "q-move_1",
      "kind": "proof",
      "step": { "en": "One direction" },
      "tests": [{ "premises": { "p": "∀x. P(x) → Q" }, "goal": "(∃x. P(x)) → Q" }],
      "cases": [{ "P": "IsLate", "Q": "Angry" }, { "P": "Cries", "Q": "Woken" }],
      "hint": [
        { "en": "Assume someone is late, take them out, and take them from the given." }
      ],
      "solution": [
        "g = impI[A=\"exists x. P(x)\"](body: f) {",
        "  body {",
        "    f = exE[x=a](g.body, body: m) {",
        "      body {",
        "        e = allE[t=a](p)",
        "        m = mp(e, f.body)",
        "      }",
        "    }",
        "  }",
        "}",
        "goal <- g"
      ]
    },
    {
      "id": "q-move_2",
      "kind": "proof",
      "step": { "en": "The other direction" },
      "tests": [{ "premises": { "p": "(∃x. P(x)) → Q" }, "goal": "∀x. P(x) → Q" }],
      "cases": [{ "P": "IsLate", "Q": "Angry" }, { "P": "Cries", "Q": "Woken" }],
      "hint": [
        { "en": "Take any a and assume they are late: they are the “someone”." }
      ],
      "solution": [
        "g = allI[x=a](body: h) {",
        "  body {",
        "    h = impI[A=\"P(a)\"](body: m) {",
        "      body {",
        "        i = exI(h.body)",
        "        m = mp(p, i)",
        "      }",
        "    }",
        "  }",
        "}",
        "goal <- g"
      ]
    }
  ]
}
