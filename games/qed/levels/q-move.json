{
  "title": { "zh": "量词挪出来" },
  "tray": "proof",
  "intro": [
    {
      "t": {
        "zh": "「谁迟到，老师都会生气」和「只要有人迟到，老师就生气」是一回事吗？"
      }
    }
  ],
  "tasks": [
    {
      "id": "q-move_1",
      "kind": "proof",
      "step": { "zh": "一个方向" },
      "tests": [{ "premises": { "p": "∀x. P(x) → Q" }, "goal": "(∃x. P(x)) → Q" }],
      "cases": [{ "P": "IsLate", "Q": "Angry" }, { "P": "Cries", "Q": "Woken" }],
      "hint": [
        { "zh": "假设有人迟到了，把他拿出来，从已知里取他。" }
      ],
      "solution": [
        "g = impI[A=\"exists x. P(x)\"](body: f) {",
        "  body {",
        "    f = exE[x=a](g.body, body: m) {",
        "      body {",
        "        e = allE[t=a](p)",
        "        m = mp(e, f.body)",
        "      }",
        "    }",
        "  }",
        "}",
        "goal <- g"
      ]
    },
    {
      "id": "q-move_2",
      "kind": "proof",
      "step": { "zh": "另一个方向" },
      "tests": [{ "premises": { "p": "(∃x. P(x)) → Q" }, "goal": "∀x. P(x) → Q" }],
      "cases": [{ "P": "IsLate", "Q": "Angry" }, { "P": "Cries", "Q": "Woken" }],
      "hint": [
        { "zh": "任取一个 a，假设他迟到了：他就是那个「有人」。" }
      ],
      "solution": [
        "g = allI[x=a](body: h) {",
        "  body {",
        "    h = impI[A=\"P(a)\"](body: m) {",
        "      body {",
        "        i = exI(h.body)",
        "        m = mp(p, i)",
        "      }",
        "    }",
        "  }",
        "}",
        "goal <- g"
      ]
    }
  ]
}
