{
  "title": { "en": "The first place" },
  "tray": "machine",
  "intro": [
    {
      "t": {
        "en": "<part-ref to=\"part:rw\"></part-ref> changes one place. When more than one place fits, it changes the first, going outside in and left to right."
      }
    }
  ],
  "tasks": [
    {
      "id": "sp-where",
      "kind": "machine",
      "want": "becomes",
      "inputs": [{ "name": "in", "label": { "en": "Goal" } }],
      "backtrack": true,
      "tests": [
        { "goal": "¬¬Rain ∧ ¬¬Wind", "becomes": [["Rain ∧ Wind"]] },
        { "goal": "¬¬(¬¬Rain → Wet)", "becomes": [["Rain → Wet"]] },
        { "goal": "¬¬¬¬Wind", "becomes": [["Wind"]] }
      ],
      "brief": { "en": "Design a proof assistant that transforms each goal into the required form." },
      "hint": [{ "en": "Each goal has two ¬¬s." }],
      "solution": [
        "c0r0 = dneg[use=[\"dneg.elim\"]]()",
        "c1r0 = dneg[use=[\"dneg.elim\"]]()",
        "c0 = rw(in, c0r0)",
        "c1 = rw(c0, c1r0)",
        "out <- c1"
      ]
    }
  ]
}
