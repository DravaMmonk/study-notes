{
  "title": { "en": "Only what is forced" },
  "intro": [
    {
      "t": {
        "en": "Each round the saturator cancels every pair, and most new clauses go unused. In these clauses each has at most one literal without ¬: they are <b>Horn clauses</b>."
      }
    }
  ],
  "adds": ["resolve"],
  "tray": "machine",
  "after": {
    "en": "In a SAT solver this is called <wiki-ref to=\"unit\"></wiki-ref>."
  },
  "tasks": [
    {
      "id": "au-horn",
      "kind": "machine",
      "want": "refuted",
      "inputs": [{ "name": "in", "label": { "en": "clause" } }],
      "backtrack": true,
      "tests": [
        {
          "clauses": [
            "Alarm",
            "¬Alarm ∨ Up",
            "¬Up ∨ Coffee",
            "¬Coffee ∨ Awake",
            "¬Awake ∨ OnTime",
            "¬OnTime",
            "¬Rain ∨ Wet",
            "¬Wet ∨ Slip",
            "¬Slip ∨ Late",
            "¬Bus ∨ ¬Bike ∨ Late"
          ],
          "budget": 17
        },
        {
          "clauses": [
            "Exam",
            "¬Exam ∨ Study",
            "¬Study ∨ Pass",
            "¬Pass ∨ Happy",
            "¬Happy",
            "¬Hungry ∨ Eat",
            "¬Eat ∨ Full",
            "¬Full ∨ Rest",
            "¬Rest ∨ Sat"
          ],
          "budget": 16
        }
      ],
      "brief": {
        "en": "Design a proof assistant that reaches ⊥ without making more clauses than each test allows."
      },
      "hint": [
        { "en": "Some clauses have a single literal from the start." },
        { "en": "A one-literal clause is something already forced." }
      ],
      "solution": [
        "c0 = repeat(in, body: c1) {",
        "  body {",
        "    c1 = resolve[unit=unit](c0.body)",
        "  }",
        "}",
        "out <- c0"
      ],
      "naive": ["c0 = saturate(in)", "out <- c0"]
    }
  ]
}
