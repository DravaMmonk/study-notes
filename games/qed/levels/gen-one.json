{
  "builds": "elimGen",
  "title": { "zh": "拆开它" },
  "adds": ["anyR", "swapConcl", "consFront", "mkRule"],
  "tray": "machine",
  "intro": [
    {
      "t": {
        "zh": "每声明一样东西，证明核都由它的引入规则生成<wiki-ref to=\"elim-rule\"></wiki-ref>。这条支线把证明核里做这一步的部分亲手搭出来。"
      }
    },
    {
      "t": {
        "zh": "这块板上，线上传的是规则本身。两个输入：声明的那句话（字母换成了 ?A、?B，生成的规则要对任何句子都成立），和它的<wiki-ref to=\"intro-rule\"></wiki-ref>。托盘里的元件把规则拆开、拼起来。每组测试是一份只有一条引入规则的声明，和要生成的消去规则。"
      }
    }
  ],
  "tasks": [
    {
      "id": "gen-one",
      "kind": "machine",
      "want": "elim",
      "inputs": [
        { "name": "it", "label": { "zh": "它" } },
        { "name": "ways", "label": { "zh": "引入规则" } }
      ],
      "single": true,
      "tests": [
        { "it": "?A ∧ ?B", "ways": ["⟦?A; ?B⟧ ⟹ ?A ∧ ?B"], "elim": ["?A ∧ ?B", "⟦?A; ?B⟧ ⟹ ?R"] },
        {
          "it": "?A ∧ (?B ∧ ?C)",
          "ways": ["⟦?A; ?B; ?C⟧ ⟹ ?A ∧ (?B ∧ ?C)"],
          "elim": ["?A ∧ (?B ∧ ?C)", "⟦?A; ?B; ?C⟧ ⟹ ?R"]
        },
        { "it": "?A ↔ ?B", "ways": ["⟦?A → ?B; ?B → ?A⟧ ⟹ ?A ↔ ?B"], "elim": ["?A ↔ ?B", "⟦?A → ?B; ?B → ?A⟧ ⟹ ?R"] },
        { "it": "Truth", "ways": ["Truth"], "elim": ["Truth", "?R"] }
      ],
      "brief": {
        "zh": "设计一个证明助手：由只有一条引入规则的声明，生成它的消去规则。"
      },
      "hint": [
        {
          "zh": "比一比引入规则和要生成的消去规则：哪一部分原样搬过去了，哪一部分换掉了？"
        }
      ],
      "solution": ["r = anyR()", "s = swapConcl(ways, r)", "c = consFront(it, s)", "m = mkRule(c, r)", "out <- m"]
    }
  ]
}
