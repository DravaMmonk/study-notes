{
  "title": { "zh": "回溯搜索" },
  "adds": ["search"],
  "tray": "machine",
  "intro": [
    {
      "t": {
        "zh": "「或者」层层嵌套，每一层都要选一边，要走几步事先不知道。重复框只顺着第一种结果走，进了死胡同就停下。"
      }
    },
    {
      "t": {
        "zh": "新元件<part-ref to=\"part:search\"></part-ref>：框里的元件做一步，得到的每一种结果再接着做；一条路走到头（证完，或者做不下去），再退回来换下一条。这叫<wiki-ref to=\"dfs\"></wiki-ref>。它送出找到的每一个证完的状态。"
      }
    }
  ],
  "tasks": [
    {
      "id": "s-search",
      "kind": "machine",
      "want": "proved",
      "inputs": [{ "name": "in", "label": { "zh": "目标" } }],
      "backtrack": true,
      "tests": [
        { "goal": "Rain ∨ (Wind ∨ Wet)", "hyps": ["Wet"] },
        { "goal": "Rain ∨ (Wind ∨ Wet)", "hyps": ["Wind"] },
        { "goal": "(Rain ∨ Wind) ∨ Wet", "hyps": ["Wind"] }
      ],
      "brief": { "zh": "设计一个证明助手，证完每一个目标。" },
      "hint": [
        { "zh": "每一步有哪几种做法？" },
        { "zh": "走几步，交给搜索。" }
      ],
      "solution": [
        "c0 = search(in, body: c1) {",
        "  body {",
        "    c1 = append[ways=\"3\"](c0.body, first: c2, second: c3, third: c4) {",
        "      first {",
        "        c2 = assumption(c1.first)",
        "      }",
        "      second {",
        "        c3r0 = orI[use=[disjI1]]()",
        "        c3 = rule(c1.second, c3r0)",
        "      }",
        "      third {",
        "        c4r0 = orI[use=[disjI2]]()",
        "        c4 = rule(c1.third, c4r0)",
        "      }",
        "    }",
        "  }",
        "}",
        "out <- c0"
      ]
    }
  ]
}
