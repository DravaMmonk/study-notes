{
  "title": { "en": "One way or the other" },
  "tray": "proof",
  "intro": [
    {
      "t": {
        "en": "If it rains I take the bus; if not, I cycle. I do not know whether it will rain, but it will be one or the other."
      }
    }
  ],
  "tasks": [
    {
      "id": "c-either",
      "kind": "proof",
      "tests": [{ "premises": { "p": "A → B", "q": "¬A → C" }, "goal": "B ∨ C" }],
      "cases": [{ "A": "Rain", "B": "Bus", "C": "Bike" }, { "A": "Exam", "B": "Study", "C": "Rest" }],
      "hint": [
        { "en": "Rain or no rain: take both sides." },
        { "en": "When taking cases, both sides must prove the same sentence." }
      ],
      "solution": [
        "l = lem[A=A]()",
        "e = orE(l, left: i1, right: i2) {",
        "  left {",
        "    m1 = mp(p, e.left)",
        "    i1 = orI[other=C, side=right](m1)",
        "  }",
        "  right {",
        "    m2 = mp(q, e.right)",
        "    i2 = orI[other=B, side=left](m2)",
        "  }",
        "}",
        "goal <- e"
      ]
    }
  ]
}
