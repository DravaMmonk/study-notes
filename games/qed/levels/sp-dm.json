{
  "title": { "zh": "推进否定" },
  "tray": "machine",
  "intro": [
    {
      "t": {
        "zh": "<part-ref to=\"lemma:dm\"></part-ref>有八个形状，每一个都可以当改写规则。"
      }
    }
  ],
  "tasks": [
    {
      "id": "sp-dm_1",
      "kind": "machine",
      "want": "becomes",
      "inputs": [{ "name": "in", "label": { "zh": "目标" } }],
      "backtrack": true,
      "step": { "zh": "推进括号" },
      "tests": [
        { "goal": "¬(Rain ∨ Wind) → Wet", "becomes": [["¬Rain ∧ ¬Wind → Wet"]] },
        { "goal": "Wet ∧ ¬(Sat ∧ Sun)", "becomes": [["Wet ∧ (¬Sat ∨ ¬Sun)"]] }
      ],
      "brief": {
        "zh": "设计一个证明助手，把每个目标里的否定推进括号里。"
      },
      "hint": [
        { "zh": "一个目标里是 ¬(… ∨ …)，另一个里是 ¬(… ∧ …)。" },
        {
          "zh": "一条改写规则只对得上一种样子；两种都要试，见<part-ref to=\"part:append\"></part-ref>。"
        }
      ],
      "solution": [
        "c0 = append(in, first: c1, second: c2) {",
        "  first {",
        "    c1r0 = dm[use=[\"dm.notOr\"]]()",
        "    c1 = rw(c0.first, c1r0)",
        "  }",
        "  second {",
        "    c2r0 = dm[use=[\"dm.notAnd\"]]()",
        "    c2 = rw(c0.second, c2r0)",
        "  }",
        "}",
        "out <- c0"
      ]
    },
    {
      "id": "sp-dm_2",
      "kind": "machine",
      "want": "becomes",
      "inputs": [{ "name": "in", "label": { "zh": "目标" } }],
      "backtrack": true,
      "step": { "zh": "推过量词" },
      "tests": [
        { "goal": "¬∀x. Drinks(x)", "becomes": [["∃x. ¬Drinks(x)"]] },
        { "goal": "Wet ∧ ¬∃x. Sings(x)", "becomes": [["Wet ∧ (∀x. ¬Sings(x))"]] }
      ],
      "brief": {
        "zh": "设计一个证明助手，把每个目标里的否定推过量词。"
      },
      "hint": [{ "zh": "一个目标里是 ¬∀，另一个里是 ¬∃。" }],
      "solution": [
        "c0 = append(in, first: c1, second: c2) {",
        "  first {",
        "    c1r0 = dm[use=[\"dm.notAll\"]]()",
        "    c1 = rw(c0.first, c1r0)",
        "  }",
        "  second {",
        "    c2r0 = dm[use=[\"dm.notEx\"]]()",
        "    c2 = rw(c0.second, c2r0)",
        "  }",
        "}",
        "out <- c0"
      ]
    }
  ]
}
