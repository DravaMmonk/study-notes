{
  "title": { "en": "Distribute" },
  "tray": "proof",
  "tasks": [
    {
      "id": "dist",
      "kind": "proof",
      "tests": [{ "premises": { "p": "A ∧ (B ∨ C)" }, "goal": "(A ∧ B) ∨ (A ∧ C)" }],
      "cases": [{ "A": "Sat", "B": "Rain", "C": "Wind" }, { "A": "Exam", "B": "Coffee", "C": "Tea" }],
      "hint": [
        {
          "en": "Split the ∧ first, then take cases on the “it rains ∨ it is windy” it gives."
        },
        {
          "en": "In each case, join “today is Saturday” with that case’s assumption, then put it on the matching side of the ∨."
        }
      ],
      "solution": [
        "s = andE(p)",
        "e = orE(s.right, left: o1, right: o2) {",
        "  left {",
        "    l1 = andI(s.left, e.left)",
        "    o1 = orI[other=\"A & C\", side=right](l1)",
        "  }",
        "  right {",
        "    l2 = andI(s.left, e.right)",
        "    o2 = orI[other=\"A & B\", side=left](l2)",
        "  }",
        "}",
        "goal <- e"
      ]
    }
  ]
}
