{
  "title": { "zh": "定义加法" },
  "intro": [
    {
      "t": {
        "zh": "数有了，还没有加法。定义一个函数，就是按要拆开的那个数，每个构造子写一行：0 + y 等于什么，S x + y 等于什么。右边可以再用加法，但要拆的数必须变小，否则算不完。"
      }
    }
  ],
  "after": {
    "zh": "Lean 把这样的定义编译成自然数的递推子 Nat.rec。"
  },
  "tasks": [
    {
      "id": "def-plus",
      "kind": "define",
      "words": ["everyday", "terms"],
      "fn": "plus",
      "on": 0,
      "rows": [
        { "lhs": "plus(zero, y)", "choices": ["y", "zero", "s(y)"] },
        { "lhs": "plus(s(x), y)", "choices": ["s(plus(x, y))", "plus(x, y)", "s(plus(s(x), y))", "s(y)"] }
      ],
      "tests": [
        { "term": "plus(s(zero), s(zero))", "value": "s(s(zero))" },
        { "term": "plus(s(s(zero)), s(zero))", "value": "s(s(s(zero)))" },
        { "term": "plus(zero, s(zero))", "value": "s(zero)" }
      ],
      "solution": ["y", "s(plus(x, y))"],
      "naive": ["y", "s(plus(s(x), y))"],
      "brief": { "zh": "给每一行写出右边，让每个测试都算对。" },
      "hint": [{ "zh": "S x + y 比 x + y 多一。" }]
    }
  ]
}
