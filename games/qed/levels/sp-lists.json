{
  "title": { "zh": "列表也一样" },
  "tray": "machine",
  "intro": [
    {
      "t": {
        "zh": "<level-ref to=\"def-list\"></level-ref>定义的 ++ 和 len，也交给化简去算。"
      }
    }
  ],
  "tasks": [
    {
      "id": "sp-lists",
      "kind": "machine",
      "want": "proved",
      "inputs": [{ "name": "in", "label": { "zh": "目标" } }],
      "backtrack": true,
      "words": ["everyday", "terms"],
      "types": ["list"],
      "defs": ["app", "len"],
      "tests": [
        { "goal": "len(app(cons(i, nil), cons(j, nil))) = s(s(zero))" },
        { "goal": "app(cons(i, nil), app(cons(j, nil), cons(k, nil))) = cons(i, cons(j, cons(k, nil)))" },
        { "goal": "len(app(cons(i, cons(j, nil)), nil)) = s(s(zero))" }
      ],
      "brief": { "zh": "设计一个证明助手，证完每一个目标。" },
      "hint": [{ "zh": "四条定义都要用。" }],
      "solution": [
        "c0r0 = math[use=[\"def.0\", \"def.1\", \"def.2\", \"def.3\"]]()",
        "c1r0 = refl()",
        "c0 = simp(in, c0r0)",
        "c1 = rule(c0, c1r0)",
        "out <- c1"
      ]
    }
  ]
}
