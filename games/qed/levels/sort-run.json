  "after": {
    "zh": "测试只说明这几个例子排对了；要说每个列表都排得对，需要证明。"
  },
  "tasks": [
    {
      "id": "sort-run",
      "kind": "machine",
      "want": "proved",
      "inputs": [{ "name": "in", "label": { "zh": "目标" } }],
      "backtrack": true,
      "words": ["everyday", "terms"],
      "types": ["list"],
      "defs": ["le", "if", "ins", "sort", "len"],
      "tests": [
        {
          "goal": "sort(cons(s(s(zero)), cons(zero, cons(s(zero), nil)))) = cons(zero, cons(s(zero), cons(s(s(zero)), nil)))"
        },
        { "goal": "sort(cons(s(zero), cons(s(zero), cons(zero, nil)))) = cons(zero, cons(s(zero), cons(s(zero), nil)))" }
      ],
      "brief": { "zh": "设计一个证明助手，证完每一个目标。" },
      "hint": [{ "zh": "还是化简。" }],
      "solution": [
        "c0r0 = math[use=[\"def.0\", \"def.1\", \"def.2\", \"def.3\", \"def.4\", \"def.5\", \"def.6\", \"def.7\", \"def.8\", \"def.9\", \"def.10\"]]()",
        "c1r0 = refl()",
        "c0 = simp(in, c0r0)",
        "c1 = rule(c0, c1r0)",
        "out <- c1"
      ]
    }
  ]
}
