{
  "title": { "en": "One for each" },
  "builds": "elimGen",
  "adds": ["anyR", "swapConcl", "consFront", "mkRule", "eachOf"],
  "tray": "machine",
  "intro": [
    {
      "t": {
        "en": "The board holds the generator you built in <level-ref to=\"gen-one\"></level-ref>; change it there. This time the intro rules come as a list, of any length, even empty. The new part For each is a frame: it runs once on each item of a list, and what it outputs inside forms a new list."
      }
    }
  ],
  "after": {
    "en": "The <part-ref to=\"lemma:elimGen\"></part-ref> now runs this board. Lean’s kernel likewise makes a type’s <wiki-ref to=\"recursor\"></wiki-ref> from its constructors, which is why it never lets you write an elimination rule."
  },
  "tasks": [
    {
      "id": "gen-each",
      "kind": "machine",
      "want": "elim",
      "inputs": [
        { "name": "it", "label": { "en": "It" } },
        { "name": "ways", "label": { "en": "Intro rules (a list)" } }
      ],
      "tests": [
        { "it": "?A ∧ ?B", "ways": ["⟦?A; ?B⟧ ⟹ ?A ∧ ?B"], "elim": ["?A ∧ ?B", "⟦?A; ?B⟧ ⟹ ?R"] },
        { "it": "?A ∨ ?B", "ways": ["⟦?A⟧ ⟹ ?A ∨ ?B", "⟦?B⟧ ⟹ ?A ∨ ?B"], "elim": ["?A ∨ ?B", "⟦?A⟧ ⟹ ?R", "⟦?B⟧ ⟹ ?R"] },
        {
          "it": "?A ∧ (?B ∧ ?C)",
          "ways": ["⟦?A; ?B; ?C⟧ ⟹ ?A ∧ (?B ∧ ?C)"],
          "elim": ["?A ∧ (?B ∧ ?C)", "⟦?A; ?B; ?C⟧ ⟹ ?R"]
        },
        {
          "it": "?A ∨ (?B ∨ ?C)",
          "ways": ["⟦?A⟧ ⟹ ?A ∨ (?B ∨ ?C)", "⟦?B⟧ ⟹ ?A ∨ (?B ∨ ?C)", "⟦?C⟧ ⟹ ?A ∨ (?B ∨ ?C)"],
          "elim": ["?A ∨ (?B ∨ ?C)", "⟦?A⟧ ⟹ ?R", "⟦?B⟧ ⟹ ?R", "⟦?C⟧ ⟹ ?R"]
        },
        { "it": "?A ↔ ?B", "ways": ["⟦?A → ?B; ?B → ?A⟧ ⟹ ?A ↔ ?B"], "elim": ["?A ↔ ?B", "⟦?A → ?B; ?B → ?A⟧ ⟹ ?R"] },
        { "it": "Truth", "ways": ["Truth"], "elim": ["Truth", "?R"] },
        { "it": "⊥", "ways": [], "elim": ["⊥"] }
      ],
      "hidden": [
        {
          "it": "Motion",
          "ways": ["⟦AnnYes; BoYes⟧ ⟹ Motion", "⟦BoYes; CyYes⟧ ⟹ Motion", "⟦AnnYes; CyYes⟧ ⟹ Motion"],
          "elim": ["Motion", "⟦AnnYes; BoYes⟧ ⟹ ?R", "⟦BoYes; CyYes⟧ ⟹ ?R", "⟦AnnYes; CyYes⟧ ⟹ ?R"]
        }
      ],
      "brief": {
        "en": "Design a proof assistant that makes a declaration’s elimination rule from its list of intro rules."
      },
      "hint": [
        {
          "en": "How many items does the list of intro rules have, and how many the elimination rule to make?"
        }
      ],
      "solution": [
        "r = anyR()",
        "e = eachOf(ways, body: s) {",
        "  body {",
        "    s = swapConcl(e.body, r)",
        "  }",
        "}",
        "c = consFront(it, e)",
        "m = mkRule(c, r)",
        "out <- m"
      ]
    }
  ]
}
