{
  "title": { "zh": "生成器遇上自然数" },
  "tray": "machine",
  "intro": [
    {
      "t": {
        "zh": "把自然数的声明交给<part-ref to=\"lemma:elimGen\"></part-ref>，看它生成什么，再和声明给出的归纳法比一比。"
      }
    }
  ],
  "after": {
    "zh": "生成器给出的只是按情况分，少了归纳假设：要生成归纳规则，得先认出哪条引入规则要的正是声明的那种东西。"
  },
  "tasks": [
    {
      "id": "gen-nat",
      "kind": "machine",
      "want": "elim",
      "inputs": [
        { "name": "it", "label": { "zh": "它" } },
        { "name": "ways", "label": { "zh": "引入规则（一串）" } }
      ],
      "tests": [{ "it": "Nat", "ways": ["Nat", "⟦Nat⟧ ⟹ Nat"], "elim": ["Nat", "?R", "⟦Nat⟧ ⟹ ?R"] }],
      "brief": {
        "zh": "设计一个证明助手：生成自然数的消去规则。"
      },
      "hint": [{ "zh": "生成器已经在元件箱里。" }],
      "solution": ["g = elimGen(it, ways)", "out <- g"]
    }
  ]
}
