{
  "title": { "en": "A search that never stops" },
  "tray": "machine",
  "intro": [
    {
      "t": {
        "en": "Ann is older than Bo and Bo older than Cy, so Ann is older than Cy; that Cy is older than Ann follows from nothing. When there is no proof, the proof assistant must still stop and report failure."
      }
    }
  ],
  "tasks": [
    {
      "id": "s-loop",
      "kind": "machine",
      "want": "proved",
      "inputs": [{ "name": "in", "label": { "en": "Goal" } }],
      "backtrack": true,
      "rules": {
        "trans": {
          "name": { "en": "Older passes on" },
          "premises": ["Older(?x, ?y)", "Older(?y, ?z)"],
          "conclusion": "Older(?x, ?z)"
        }
      },
      "tests": [
        { "goal": "Older(i, k)", "hyps": ["Older(i, j)", "Older(j, k)"] },
        { "goal": "Older(j, l)", "hyps": ["Older(j, k)", "Older(k, l)"] },
        { "goal": "Older(k, i)", "hyps": ["Older(i, j)", "Older(j, k)"], "want": "fails" }
      ],
      "brief": {
        "en": "Design a proof assistant that proves the goals that can be proved, and reports failure on the one that cannot."
      },
      "hint": [
        { "en": "On the sentence that cannot be proved, where does the search fail to stop?" },
        {
          "en": "Each step brings a new ?-letter, so the search cannot tell it is going round."
        }
      ],
      "solution": [
        "c0 = search[depth=\"3\"](in, body: c1) {",
        "  body {",
        "    c1 = append(c0.body, first: c2, second: c3) {",
        "      first {",
        "        c2 = assumption(c1.first)",
        "      }",
        "      second {",
        "        c3r0 = trans()",
        "        c3 = rule(c1.second, c3r0)",
        "      }",
        "    }",
        "  }",
        "}",
        "out <- c0"
      ],
      "naive": [
        "c0 = search(in, body: c1) {",
        "  body {",
        "    c1 = append(c0.body, first: c2, second: c3) {",
        "      first {",
        "        c2 = assumption(c1.first)",
        "      }",
        "      second {",
        "        c3r0 = trans()",
        "        c3 = rule(c1.second, c3r0)",
        "      }",
        "    }",
        "  }",
        "}",
        "out <- c0"
      ]
    }
  ]
}
