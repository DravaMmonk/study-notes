{
  "title": { "en": "Givens that contradict" },
  "tray": "machine",
  "intro": [
    {
      "t": {
        "en": "The goal has nothing to do with the givens, yet among the givens is a pair that contradict each other."
      }
    }
  ],
  "tasks": [
    {
      "id": "r-false",
      "kind": "machine",
      "want": "proved",
      "inputs": [{ "name": "in", "label": { "en": "Goal" } }],
      "tests": [{ "goal": "Pigs", "hyps": ["Rain", "¬Rain"] }, { "goal": "Moon", "hyps": ["¬Wet", "Wet"] }],
      "brief": { "en": "Design a proof assistant that proves every goal." },
      "hint": [
        { "en": "Going backwards, what should the goal become first?" },
        { "en": "Apply as an elimination rule: which given does it fit?" }
      ],
      "solution": [
        "c0r0 = botE()",
        "c1r0 = mp[use=[mp]]()",
        "c0 = rule(in, c0r0)",
        "c1 = erule(c0, c1r0)",
        "c2 = assumption(c1)",
        "out <- c2"
      ]
    }
  ]
}
