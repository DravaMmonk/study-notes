{
  "title": { "zh": "酒鬼悖论" },
  "tray": "proof",
  "intro": [
    {
      "t": {
        "zh": "酒吧里至少有一个人。「∃x. x在喝酒 → ∀y. y在喝酒」说的是：有这么一个人，只要他喝酒，大家就都在喝。"
      }
    }
  ],
  "after": {
    "zh": "听着荒唐，却是经典逻辑的定理：证明说有这么一个人，却不指出是谁。"
  },
  "tasks": [
    {
      "id": "drinker",
      "kind": "proof",
      "tests": [{ "goal": "∃x. D(x) → ∀y. D(y)" }],
      "cases": [{ "D": "Drinks" }, { "D": "Sings" }],
      "hint": [
        { "zh": "别急着找那个人。先问：是不是大家都在喝？" },
        {
          "zh": "不是大家都在喝时，<part-ref to=\"lemma:dm\"></part-ref>能给出什么？"
        }
      ],
      "solution": [
        "l = lem[A=\"forall y. D(y)\"]()",
        "e = orE(l, left: i1, right: f) {",
        "  left {",
        "    h = impI[A=\"D(a)\"](body: e.left)",
        "    i1 = exI(h)",
        "  }",
        "  right {",
        "    q = dm[form=notAll](e.right)",
        "    f = exE[x=a](q, body: i2) {",
        "      body {",
        "        h2 = impI[A=\"D(a)\"](body: b) {",
        "          body {",
        "            m3 = mp(f.body, h2.body)",
        "            b = botE[C=\"forall y. D(y)\"](m3)",
        "          }",
        "        }",
        "        i2 = exI(h2)",
        "      }",
        "    }",
        "  }",
        "}",
        "goal <- e"
      ],
      "naive": ["h = impI[A=\"D(a)\"](body: h.body)", "i = exI(h)", "goal <- i"]
    }
  ]
}
