{
  "title": { "en": "The drinker paradox" },
  "tray": "proof",
  "intro": [
    {
      "t": {
        "en": "There is at least one person in the pub. “∃x. x is drinking → ∀y. y is drinking” says: there is someone such that, if they drink, everyone drinks."
      }
    }
  ],
  "after": {
    "en": "It sounds absurd, yet it is a theorem of classical logic: the proof says such a person exists without saying who."
  },
  "tasks": [
    {
      "id": "drinker",
      "kind": "proof",
      "tests": [{ "goal": "∃x. D(x) → ∀y. D(y)" }],
      "cases": [{ "D": "Drinks" }, { "D": "Sings" }],
      "hint": [
        { "en": "Do not look for that person yet. Ask first: is everyone drinking?" },
        {
          "en": "If not everyone is drinking, what does <part-ref to=\"lemma:dm\"></part-ref> give?"
        }
      ],
      "solution": [
        "l = lem[A=\"forall y. D(y)\"]()",
        "e = orE(l, left: i1, right: f) {",
        "  left {",
        "    h = impI[A=\"D(a)\"](body: e.left)",
        "    i1 = exI(h)",
        "  }",
        "  right {",
        "    q = dm[form=notAll](e.right)",
        "    f = exE[x=a](q, body: i2) {",
        "      body {",
        "        h2 = impI[A=\"D(a)\"](body: b) {",
        "          body {",
        "            m3 = mp(f.body, h2.body)",
        "            b = botE[C=\"forall y. D(y)\"](m3)",
        "          }",
        "        }",
        "        i2 = exI(h2)",
        "      }",
        "    }",
        "  }",
        "}",
        "goal <- e"
      ],
      "naive": ["h = impI[A=\"D(a)\"](body: h.body)", "i = exI(h)", "goal <- i"]
    }
  ]
}
