{
  "title": { "zh": "归结" },
  "tray": "proof",
  "builds": "res",
  "intro": [
    {
      "t": {
        "zh": "子句之间只用一条规则。一条子句里有「下雨」，另一条里有「¬下雨」：下不下雨，总有一条去掉这一项后剩下的部分成立。"
      }
    }
  ],
  "after": {
    "zh": "这条规则叫<wiki-ref to=\"resolution\"></wiki-ref>。"
  },
  "tasks": [
    {
      "id": "au-resolve",
      "kind": "proof",
      "tests": [{ "premises": { "p": "A ∨ B", "q": "¬A ∨ C" }, "goal": "B ∨ C" }],
      "cases": [{ "A": "Rain", "B": "Bus", "C": "Wet" }, { "A": "Exam", "B": "Rest", "C": "Study" }],
      "hint": [
        { "zh": "对第一句分情况。" },
        { "zh": "下雨的那一边，再对第二句分情况。" }
      ],
      "solution": [
        "e = orE(p, left: e2, right: o2) {",
        "  left {",
        "    e2 = orE(q, left: b, right: o) {",
        "      left {",
        "        m = mp(e2.left, e.left)",
        "        b = botE[C=\"B | C\"](m)",
        "      }",
        "      right {",
        "        o = orI[other=B, side=left](e2.right)",
        "      }",
        "    }",
        "  }",
        "  right {",
        "    o2 = orI[other=C, side=right](e.right)",
        "  }",
        "}",
        "goal <- e"
      ]
    }
  ]
}
