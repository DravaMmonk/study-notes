{
  "title": { "en": "Resolve" },
  "tray": "proof",
  "intro": [
    {
      "t": {
        "en": "Between clauses one rule is enough. One clause has “it rains”, the other “¬it rains”: rain or not, one of them still holds with that literal taken away."
      }
    }
  ],
  "after": {
    "en": "This rule is called <wiki-ref to=\"resolution\"></wiki-ref>."
  },
  "tasks": [
    {
      "id": "au-resolve",
      "kind": "proof",
      "tests": [{ "premises": { "p": "A ∨ B", "q": "¬A ∨ C" }, "goal": "B ∨ C" }],
      "cases": [{ "A": "Rain", "B": "Bus", "C": "Wet" }, { "A": "Exam", "B": "Rest", "C": "Study" }],
      "hint": [
        { "en": "Take cases on the first." },
        { "en": "On the rain side, take cases on the second." }
      ],
      "solution": [
        "e = orE(p, left: e2, right: o2) {",
        "  left {",
        "    e2 = orE(q, left: b, right: o) {",
        "      left {",
        "        m = mp(e2.left, e.left)",
        "        b = botE[C=\"B | C\"](m)",
        "      }",
        "      right {",
        "        o = orI[other=B, side=left](e2.right)",
        "      }",
        "    }",
        "  }",
        "  right {",
        "    o2 = orI[other=C, side=right](e.right)",
        "  }",
        "}",
        "goal <- e"
      ]
    }
  ]
}
