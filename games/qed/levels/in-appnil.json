{
  "title": { "en": "Appending nothing" },
  "tray": "machine",
  "fact": "appNil",
  "intro": [
    {
      "t": {
        "en": "The list = [] | x :: xs declared in <level-ref to=\"decl-list\"></level-ref> gives the same kinds of rule; its induction steps from xs to x :: xs."
      }
    }
  ],
  "tasks": [
    {
      "id": "in-appnil",
      "kind": "machine",
      "want": "proved",
      "inputs": [{ "name": "in", "label": { "en": "Goal" } }],
      "backtrack": true,
      "words": ["everyday", "terms"],
      "types": ["list"],
      "defs": ["app", "len"],
      "tests": [{ "goal": "∀xs. app(xs, nil) = xs" }],
      "brief": { "en": "Design a proof assistant that proves every goal." },
      "hint": [{ "en": "The “Rule book of numbers” has an induction rule for list." }],
      "solution": [
        "c0r0 = math[use=[\"list.induct\"]]()",
        "c0 = rule(in, c0r0)",
        "c1 = each(c0, body: c3) {",
        "  body {",
        "    c2r0 = math[use=[\"def.0\", \"def.1\"]]()",
        "    c3r0 = refl()",
        "    c2r2 = hyp(c2r0)",
        "    c2 = simp(c1.body, c2r2)",
        "    c3 = rule(c2, c3r0)",
        "  }",
        "}",
        "out <- c1"
      ]
    }
  ]
}
