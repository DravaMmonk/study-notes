{
  "title": { "zh": "换个顺序" },
  "intro": [
    {
      "t": {
        "zh": "<level-ref to=\"decl-and\"></level-ref>里的「并且」先要「下雨」、再要「刮风」。反过来写行不行？检验条例分得出来吗？"
      }
    },
    {
      "t": {
        "zh": "声明 1 先要「下雨」，声明 2 先要「刮风」。请从引入和使用两个方向各写一条预期为可推导的条例，检验两份声明。"
      }
    }
  ],
  "after": {
    "zh": "检验条例只看推得出什么，看不出规则的写法；证明核却只认写下来的那一条。"
  },
  "tasks": [
    {
      "id": "decl-order",
      "kind": "iso",
      "declare": { "zh": "并且" },
      "target": "Rain ∧ Wind",
      "sentences": ["Rain", "Wind"],
      "tests": [
        { "given": ["Rain", "Wind"], "make": true },
        { "given": ["Rain"], "make": false },
        { "given": ["Wind"], "make": false },
        { "given": ["Rain ∧ Wind"], "goal": "Rain", "make": true },
        { "given": ["Rain ∧ Wind"], "goal": "Wet", "make": false }
      ],
      "play": "audit",
      "want": "agree",
      "boards": [
        { "rules": [{ "binds": [], "needs": ["Rain", "Wind"] }] },
        { "rules": [{ "binds": [], "needs": ["Wind", "Rain"] }] }
      ],
      "slots": [
        { "make": true, "fixed": ["goal", "make"] },
        { "given": ["Rain ∧ Wind"], "keep": ["Rain ∧ Wind"], "make": true, "fixed": ["make"] }
      ],
      "answer": [{ "given": ["Rain", "Wind"], "make": true }, { "given": ["Rain ∧ Wind"], "goal": "Rain", "make": true }],
      "naive": [{ "given": ["Rain"], "make": true }, { "given": ["Rain ∧ Wind"], "goal": "Rain", "make": true }],
      "brief": {
        "zh": "需求：「下雨并且刮风」只在「下雨」和「刮风」都已证出时才能引入。编写两条检验条例，使预期符合需求，两份声明的结果都和预期相符。"
      },
      "hint": [
        { "zh": "引入「并且」要哪几样？有了「并且」，能拆出哪几句？" }
      ],
      "solution": [{ "binds": [], "needs": ["Rain", "Wind"] }]
    }
  ]
}
