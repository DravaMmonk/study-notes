{
  "title": { "en": "Take both sides" },
  "tray": "proof",
  "intro": [
    {
      "t": {
        "en": "If it rains I drink coffee; if it does not, I drink coffee too. So I drank coffee."
      }
    }
  ],
  "tasks": [
    {
      "id": "lemCases",
      "kind": "proof",
      "tests": [{ "premises": { "p": "A → B", "q": "¬A → B" }, "goal": "B" }],
      "cases": [{ "A": "Rain", "B": "Coffee" }, { "A": "Bus", "B": "OnTime" }],
      "hint": [
        { "en": "Rain and no rain: take both cases." },
        { "en": "Taking cases needs an “or”, and none is given." }
      ],
      "solution": [
        "l = lem[A=A]()",
        "e = orE(l, left: m1, right: m2) {",
        "  left {",
        "    m1 = mp(p, e.left)",
        "  }",
        "  right {",
        "    m2 = mp(q, e.right)",
        "  }",
        "}",
        "goal <- e"
      ]
    }
  ]
}
