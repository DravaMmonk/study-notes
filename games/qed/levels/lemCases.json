{
  "title": { "zh": "两边都讨论" },
  "tray": "proof",
  "intro": [
    {
      "t": {
        "zh": "下雨我喝咖啡，不下雨我也喝咖啡，所以我喝了咖啡。"
      }
    }
  ],
  "tasks": [
    {
      "id": "lemCases",
      "kind": "proof",
      "tests": [{ "premises": { "p": "A → B", "q": "¬A → B" }, "goal": "B" }],
      "cases": [{ "A": "Rain", "B": "Coffee" }, { "A": "Bus", "B": "OnTime" }],
      "hint": [
        { "zh": "下雨和不下雨，两种情况都讨论。" },
        { "zh": "分情况要一句「或者」，已知里没有。" }
      ],
      "solution": [
        "l = lem[A=A]()",
        "e = orE(l, left: m1, right: m2) {",
        "  left {",
        "    m1 = mp(p, e.left)",
        "  }",
        "  right {",
        "    m2 = mp(q, e.right)",
        "  }",
        "}",
        "goal <- e"
      ]
    }
  ]
}
