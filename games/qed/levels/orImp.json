{
  "title": { "en": "Whichever it is" },
  "tray": "proof",
  "intro": [
    {
      "t": {
        "en": "In <level-ref to=\"cases\"></level-ref>, “I take the bus ∨ I cycle” was given; now it sits inside the “if … then …” to be proved."
      }
    }
  ],
  "tasks": [
    {
      "id": "orImp",
      "kind": "proof",
      "tests": [{ "premises": { "p": "A → C", "q": "B → C" }, "goal": "A ∨ B → C" }],
      "cases": [{ "A": "Bus", "B": "Bike", "C": "OnTime" }, { "A": "Sat", "B": "Sun", "C": "Rest" }],
      "hint": [
        {
          "en": "The goal is an “if … then …”: open an assumption box first; with an ∨ inside it, split into cases."
        }
      ],
      "solution": [
        "f = impI[A=\"A | B\"](body: e) {",
        "  body {",
        "    e = orE(f.body, left: m1, right: m2) {",
        "      left {",
        "        m1 = mp(p, e.left)",
        "      }",
        "      right {",
        "        m2 = mp(q, e.right)",
        "      }",
        "    }",
        "  }",
        "}",
        "goal <- f"
      ]
    }
  ]
}
