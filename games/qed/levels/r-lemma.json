{
  "title": { "en": "Lemmas are rules too" },
  "tray": "machine",
  "intro": [
    {
      "t": {
        "en": "A lemma you proved is itself a rule: <part-ref to=\"lemma:chain\"></part-ref> is ⟦?A → ?B; ?B → ?C⟧ ⟹ ?A → ?C. It can be used backwards just like the kernel’s rules, and the part offers it too."
      }
    }
  ],
  "tasks": [
    {
      "id": "r-lemma_1",
      "kind": "machine",
      "want": "proved",
      "inputs": [{ "name": "in", "label": { "en": "Goal" } }],
      "step": { "en": "Chain" },
      "tests": [
        { "goal": "Rain → Slip", "hyps": ["Rain → Wet", "Wet → Slip"] },
        { "goal": "Alarm → Awake", "hyps": ["Alarm → Coffee", "Coffee → Awake"] }
      ],
      "brief": {
        "en": "Design a proof assistant that proves every goal with <part-ref to=\"lemma:chain\"></part-ref>."
      },
      "hint": [
        {
          "en": "The middle sentence of <part-ref to=\"lemma:chain\"></part-ref> cannot be read off the goal."
        }
      ],
      "solution": ["c0r0 = chain()", "c0 = rule(in, c0r0)", "c1 = assumption(c0)", "c2 = assumption(c1)", "out <- c2"]
    },
    {
      "id": "r-lemma_2",
      "kind": "machine",
      "want": "proved",
      "inputs": [{ "name": "in", "label": { "en": "Goal" } }],
      "step": { "en": "Swap" },
      "tests": [
        { "goal": "Wind → (Rain → Wet)", "hyps": ["Rain → (Wind → Wet)"] },
        { "goal": "Coffee → (Alarm → Awake)", "hyps": ["Alarm → (Coffee → Awake)"] }
      ],
      "brief": {
        "en": "Now prove every goal with <part-ref to=\"lemma:swap\"></part-ref>."
      },
      "hint": [
        {
          "en": "<part-ref to=\"lemma:swap\"></part-ref> has one premise."
        }
      ],
      "solution": ["c0r0 = swap()", "c0 = rule(in, c0r0)", "c1 = assumption(c0)", "out <- c1"]
    },
    {
      "id": "r-lemma_3",
      "kind": "machine",
      "want": "proved",
      "inputs": [{ "name": "in", "label": { "en": "Goal" } }],
      "step": { "en": "Merge" },
      "tests": [
        { "goal": "Rain → Wet", "hyps": ["Rain → (Rain → Wet)"] },
        { "goal": "Hungry → Eat", "hyps": ["Hungry → (Hungry → Eat)"] }
      ],
      "brief": {
        "en": "Now prove every goal with <part-ref to=\"lemma:merge\"></part-ref>."
      },
      "hint": [
        {
          "en": "Once <part-ref to=\"lemma:merge\"></part-ref>’s conclusion fits the goal, what is left to prove?"
        }
      ],
      "solution": ["c0r0 = merge()", "c0 = rule(in, c0r0)", "c1 = assumption(c0)", "out <- c1"]
    }
  ]
}
