{
  "title": { "zh": "证出的引理也是规则" },
  "tray": "machine",
  "intro": [
    {
      "t": {
        "zh": "证出的引理本身就是一条规则：<part-ref to=\"lemma:chain\"></part-ref>是 ⟦?A → ?B; ?B → ?C⟧ ⟹ ?A → ?C。它和证明核的规则一样能倒着用，元件上都能选到。"
      }
    }
  ],
  "tasks": [
    {
      "id": "r-lemma_1",
      "kind": "machine",
      "want": "proved",
      "inputs": [{ "name": "in", "label": { "zh": "目标" } }],
      "step": { "zh": "串联" },
      "tests": [
        { "goal": "Rain → Slip", "hyps": ["Rain → Wet", "Wet → Slip"] },
        { "goal": "Alarm → Awake", "hyps": ["Alarm → Coffee", "Coffee → Awake"] }
      ],
      "brief": {
        "zh": "设计一个证明助手，用<part-ref to=\"lemma:chain\"></part-ref>证完每一个目标。"
      },
      "hint": [
        {
          "zh": "目标里读不出<part-ref to=\"lemma:chain\"></part-ref>的中间那一句。"
        }
      ],
      "solution": ["c0r0 = chain()", "c0 = rule(in, c0r0)", "c1 = assumption(c0)", "c2 = assumption(c1)", "out <- c2"]
    },
    {
      "id": "r-lemma_2",
      "kind": "machine",
      "want": "proved",
      "inputs": [{ "name": "in", "label": { "zh": "目标" } }],
      "step": { "zh": "交换" },
      "tests": [
        { "goal": "Wind → (Rain → Wet)", "hyps": ["Rain → (Wind → Wet)"] },
        { "goal": "Coffee → (Alarm → Awake)", "hyps": ["Alarm → (Coffee → Awake)"] }
      ],
      "brief": {
        "zh": "再用<part-ref to=\"lemma:swap\"></part-ref>证完每一个目标。"
      },
      "hint": [
        {
          "zh": "<part-ref to=\"lemma:swap\"></part-ref>只有一条前提。"
        }
      ],
      "solution": ["c0r0 = swap()", "c0 = rule(in, c0r0)", "c1 = assumption(c0)", "out <- c1"]
    },
    {
      "id": "r-lemma_3",
      "kind": "machine",
      "want": "proved",
      "inputs": [{ "name": "in", "label": { "zh": "目标" } }],
      "step": { "zh": "合并" },
      "tests": [
        { "goal": "Rain → Wet", "hyps": ["Rain → (Rain → Wet)"] },
        { "goal": "Hungry → Eat", "hyps": ["Hungry → (Hungry → Eat)"] }
      ],
      "brief": {
        "zh": "再用<part-ref to=\"lemma:merge\"></part-ref>证完每一个目标。"
      },
      "hint": [
        {
          "zh": "<part-ref to=\"lemma:merge\"></part-ref>的结论对上目标以后，还剩什么要证？"
        }
      ],
      "solution": ["c0r0 = merge()", "c0 = rule(in, c0r0)", "c1 = assumption(c0)", "out <- c1"]
    }
  ]
}
