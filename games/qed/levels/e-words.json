{
  "title": { "zh": "翻译成与或非" },
  "tray": "gates",
  "intro": [
    {
      "t": {
        "zh": "岛上有两个人，a 和 b，每人要么是骑士，要么不是。「a 是骑士」「b 是骑士」的真假组成真值表的四行。"
      }
    },
    {
      "t": {
        "zh": "日常的话先要译成与、或、非，才能接成电路。这一关不给出目标那一列。"
      }
    }
  ],
  "tasks": [
    {
      "id": "e-words",
      "kind": "gates",
      "target": "¬(KA ∧ KB)",
      "blind": true,
      "brief": {
        "zh": "「a 和 b 不都是骑士。」把这句话译成与、或、非，接成电路，算出它在每一行的真值。"
      },
      "hint": [
        { "zh": "「不都是」和「都不是」意思一样吗？" },
        { "zh": "否定管的是哪一部分？" }
      ],
      "solution": ["a = gAnd(KA, KB)", "n = gNot(a)", "out <- n"],
      "naive": ["na = gNot(KA)", "nb = gNot(KB)", "a = gAnd(na, nb)", "out <- a"]
    }
  ]
}
