{
  "title": { "en": "negation normal form", "zh": "否定范式" },
  "tray": "machine",
  "intro": [
    {
      "t": {
        "en": "<wiki-ref to=\"nnf\"></wiki-ref>: no → in the sentence, and every ¬ on a smallest sentence.",
        "zh": "<wiki-ref to=\"nnf\"></wiki-ref>：句子里没有 →，¬ 只贴在最小的句子上。"
      }
    }
  ],
  "tasks": [
    {
      "id": "sp-nnf",
      "kind": "machine",
      "want": "becomes",
      "inputs": [{ "name": "in", "label": { "en": "Goal", "zh": "目标" } }],
      "backtrack": true,
      "tests": [
        { "goal": "¬(Rain → Wet)", "becomes": [["Rain ∧ ¬Wet"]] },
        { "goal": "¬(Rain ∧ (Wind → Wet))", "becomes": [["¬Rain ∨ (Wind ∧ ¬Wet)"]] },
        { "goal": "¬∀x. Human(x) → Mortal(x)", "becomes": [["∃x. Human(x) ∧ ¬Mortal(x)"]] },
        { "goal": "¬∃x. Bird(x) ∧ ¬Flies(x)", "becomes": [["∀x. ¬Bird(x) ∨ Flies(x)"]] }
      ],
      "brief": {
        "en": "Design a proof assistant that transforms each goal into the required form.",
        "zh": "设计一个证明助手，把每个目标变成要的样子。"
      },
      "hint": [
        { "en": "Get rid of → first.", "zh": "先去掉 →。" },
        {
          "en": "Then see in front of which connectives and quantifiers a ¬ can stand.",
          "zh": "再看 ¬ 会出现在哪些连接词和量词前面。"
        }
      ],
      "solution": [
        "c0r0 = arrow[use=[\"arrow.elim\"]]()",
        "c0r1 = dneg[use=[\"dneg.elim\"]](c0r0)",
        "c0r2 = dm[use=[\"dm.notOr\", \"dm.notAnd\", \"dm.notEx\", \"dm.notAll\"]](c0r1)",
        "c0 = simp(in, c0r2)",
        "out <- c0"
      ]
    }
  ]
}
