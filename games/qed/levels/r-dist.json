{
  "title": { "en": "Distribute" },
  "tray": "machine",
  "intro": [
    {
      "t": {
        "en": "In <level-ref to=\"dist\"></level-ref> this sentence took several boxes on the proof board. This time, reason back from the goal."
      }
    }
  ],
  "after": { "en": "A row of parts like this is a proof script, one part to a line." },
  "tasks": [
    {
      "id": "r-dist",
      "kind": "machine",
      "want": "proved",
      "inputs": [{ "name": "in", "label": { "en": "Goal" } }],
      "tests": [
        { "goal": "Rain ∧ (Wind ∨ Wet) → (Rain ∧ Wind) ∨ (Rain ∧ Wet)" },
        { "goal": "Sat ∧ (Bus ∨ Bike) → (Sat ∧ Bus) ∨ (Sat ∧ Bike)" }
      ],
      "brief": { "en": "Design a proof assistant that proves every goal." },
      "hint": [
        { "en": "First take apart every given that comes apart." },
        { "en": "Then split into two cases, and in each choose a side of the “or”." }
      ],
      "solution": [
        "c0r0 = impI()",
        "c1r0 = andE[use=[conjE]]()",
        "c2r0 = orE()",
        "c3r0 = orI[use=[disjI1]]()",
        "c4r0 = andI()",
        "c7r0 = orI[use=[disjI2]]()",
        "c8r0 = andI()",
        "c0 = rule(in, c0r0)",
        "c1 = erule(c0, c1r0)",
        "c2 = erule(c1, c2r0)",
        "c3 = rule(c2, c3r0)",
        "c4 = rule(c3, c4r0)",
        "c5 = assumption(c4)",
        "c6 = assumption(c5)",
        "c7 = rule(c6, c7r0)",
        "c8 = rule(c7, c8r0)",
        "c9 = assumption(c8)",
        "c10 = assumption(c9)",
        "out <- c10"
      ]
    }
  ]
}
