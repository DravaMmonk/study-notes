{
  "title": { "zh": "还没定下来的 ?A" },
  "tray": "machine",
  "intro": [
    {
      "t": {
        "zh": "套用写成规则是 ⟦?A → ?B; ?A⟧ ⟹ ?B。结论 ?B 对上目标「地湿」，?A 却无法从目标读出，原样留在两个新目标里。之后什么确定了 ?A，两个目标里的 ?A 就一起确定。"
      }
    }
  ],
  "tasks": [
    {
      "id": "r-meta",
      "kind": "machine",
      "want": "proved",
      "inputs": [{ "name": "in", "label": { "zh": "目标" } }],
      "tests": [
        { "goal": "Wet", "hyps": ["Rain → Wet", "Rain"] },
        { "goal": "Slip", "hyps": ["Wind", "Wet → Slip", "Wet"] },
        { "goal": "Wind ∧ Wet", "hyps": ["Rain → Wind ∧ Wet", "Rain"] }
      ],
      "brief": { "zh": "设计一个证明助手，证完每一个目标。" },
      "hint": [{ "zh": "倒着用套用。?A 先留着，交给已知去定。" }],
      "solution": [
        "c0r0 = mp[use=[mp]]()",
        "c0 = rule(in, c0r0)",
        "c1 = assumption(c0)",
        "c2 = assumption(c1)",
        "out <- c2"
      ]
    }
  ]
}
