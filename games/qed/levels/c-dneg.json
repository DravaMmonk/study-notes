{
  "title": { "en": "Double negation" },
  "tray": "proof",
  "builds": "dneg",
  "intro": [
    {
      "t": {
        "en": "Two sentences that each give the other say the same thing: they are in <wiki-ref to=\"equivalence\"></wiki-ref>. “¬¬it rains” and “it rains” are such a pair."
      }
    },
    {
      "t": {
        "en": "Once both directions are proved, they make one part that switches between the two."
      }
    }
  ],
  "tasks": [
    {
      "id": "c-dneg_1",
      "kind": "proof",
      "step": { "en": "Two ¬s off" },
      "tests": [{ "premises": { "p": "¬¬A" }, "goal": "A" }],
      "cases": [{ "A": "Rain" }, { "A": "Locked" }],
      "hint": [{ "en": "One rule you hold takes exactly two ¬s off." }],
      "solution": ["r = raa(p)", "goal <- r"]
    },
    {
      "id": "c-dneg_2",
      "kind": "proof",
      "step": { "en": "Two ¬s on" },
      "tests": [{ "premises": { "p": "A" }, "goal": "¬¬A" }],
      "cases": [{ "A": "Rain" }, { "A": "Locked" }],
      "hint": [{ "en": "“¬¬it rains” is “¬it rains → ⊥”." }],
      "solution": ["f = impI[A=\"~A\"](body: m) {", "  body {", "    m = mp(f.body, p)", "  }", "}", "goal <- f"]
    }
  ]
}
