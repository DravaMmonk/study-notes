{
  "title": { "en": "Exactly one" },
  "tray": "gates",
  "after": { "en": "This connective is <b>exclusive or</b> (XOR)." },
  "tasks": [
    {
      "id": "g-xor",
      "kind": "gates",
      "target": "(Rain ∨ Wind) ∧ ¬(Rain ∧ Wind)",
      "blind": true,
      "budget": 4,
      "brief": {
        "en": "“Either it rains or it is windy, but not both.” Wire a board that computes it, with at most 4 gates."
      },
      "hint": [
        {
          "en": "No need to piece it together row by row. Read the sentence as it is said: what parts is it made of?"
        }
      ],
      "solution": ["o = gOr(Rain, Wind)", "a = gAnd(Rain, Wind)", "n = gNot(a)", "b = gAnd(o, n)", "out <- b"],
      "naive": [
        "n1 = gNot(Wind)",
        "n2 = gNot(Rain)",
        "a1 = gAnd(Rain, n1)",
        "a2 = gAnd(n2, Wind)",
        "o = gOr(a1, a2)",
        "out <- o"
      ]
    }
  ]
}
