{
  "title": { "zh": "只有一样" },
  "tray": "gates",
  "after": { "zh": "这个连接词叫<b>异或</b>（XOR）。" },
  "tasks": [
    {
      "id": "g-xor",
      "kind": "gates",
      "target": "(Rain ∨ Wind) ∧ ¬(Rain ∧ Wind)",
      "blind": true,
      "budget": 4,
      "brief": {
        "zh": "「要么下雨，要么刮风，但不会两样都有。」接一块电路算出它，最多用 4 个门。"
      },
      "hint": [
        {
          "zh": "不必按行拼。照这句话的字面看，它由哪几部分组成？"
        }
      ],
      "solution": ["o = gOr(Rain, Wind)", "a = gAnd(Rain, Wind)", "n = gNot(a)", "b = gAnd(o, n)", "out <- b"],
      "naive": [
        "n1 = gNot(Wind)",
        "n2 = gNot(Rain)",
        "a1 = gAnd(Rain, n1)",
        "a2 = gAnd(n2, Wind)",
        "o = gOr(a1, a2)",
        "out <- o"
      ]
    }
  ]
}
