{
  "title": { "en": "Reversing an append" },
  "tray": "machine",
  "fact": "revApp",
  "intro": [
    {
      "t": {
        "en": "rev reverses a list. Define it first, then see how it relates to append."
      }
    }
  ],
  "tasks": [
    {
      "id": "in-revapp_1",
      "kind": "define",
      "words": ["everyday", "terms"],
      "step": { "en": "Defining reverse" },
      "fn": "rev",
      "on": 0,
      "defs": ["app"],
      "rows": [
        { "lhs": "rev(nil)", "choices": ["nil"] },
        {
          "lhs": "rev(cons(x, xs))",
          "choices": [
            "app(rev(xs), cons(x, nil))",
            "cons(x, rev(xs))",
            "app(cons(x, nil), rev(xs))",
            "rev(app(xs, cons(x, nil)))"
          ]
        }
      ],
      "tests": [
        { "term": "rev(cons(i, cons(j, cons(k, nil))))", "value": "cons(k, cons(j, cons(i, nil)))" },
        { "term": "rev(cons(i, nil))", "value": "cons(i, nil)" }
      ],
      "solution": ["nil", "app(rev(xs), cons(x, nil))"],
      "naive": ["nil", "cons(x, rev(xs))"],
      "brief": {
        "en": "Write a right side for every row."
      },
      "hint": [{ "en": "In x :: xs reversed, x comes last." }]
    },
    {
      "id": "in-revapp_2",
      "kind": "machine",
      "want": "proved",
      "inputs": [{ "name": "in", "label": { "en": "Goal" } }],
      "backtrack": true,
      "words": ["everyday", "terms"],
      "step": { "en": "Reversing an append" },
      "types": ["list"],
      "defs": ["app", "len", "rev"],
      "tests": [{ "goal": "∀xs. ∀ys. rev(app(xs, ys)) = app(rev(ys), rev(xs))" }],
      "brief": { "en": "Design a proof assistant that proves every goal." },
      "hint": [
        {
          "en": "The [] case needs rev ys = rev ys ++ []; the other needs two ++ grouped the other way."
        },
        { "en": "The “Rule book of numbers” has equations proved for both." }
      ],
      "solution": [
        "c0r0 = math[use=[\"list.induct\"]]()",
        "c0 = rule(in, c0r0)",
        "c1 = each(c0, body: c4) {",
        "  body {",
        "    c2r0 = allI()",
        "    c3r0 = math[use=[\"def.0\", \"def.1\", \"def.4\", \"def.5\", appNil, appAssoc]]()",
        "    c4r0 = refl()",
        "    c3r6 = hyp(c3r0)",
        "    c2 = rule(c1.body, c2r0)",
        "    c3 = simp(c2, c3r6)",
        "    c4 = rule(c3, c4r0)",
        "  }",
        "}",
        "out <- c1"
      ],
      "naive": [
        "c0r0 = math[use=[\"list.induct\"]]()",
        "c0 = rule(in, c0r0)",
        "c1 = each(c0, body: c4) {",
        "  body {",
        "    c2r0 = allI()",
        "    c3r0 = math[use=[\"def.0\", \"def.1\", \"def.4\", \"def.5\"]]()",
        "    c4r0 = refl()",
        "    c3r4 = hyp(c3r0)",
        "    c2 = rule(c1.body, c2r0)",
        "    c3 = simp(c2, c3r4)",
        "    c4 = rule(c3, c4r0)",
        "  }",
        "}",
        "out <- c1"
      ]
    }
  ]
}
