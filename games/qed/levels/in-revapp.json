{
  "title": { "zh": "倒过来拼" },
  "tray": "machine",
  "intro": [
    {
      "t": {
        "zh": "rev 把列表倒过来。先定义它，再看它和拼接的关系。"
      }
    }
  ],
  "tasks": [
    {
      "id": "in-revapp_1",
      "kind": "define",
      "words": ["everyday", "terms"],
      "step": { "zh": "定义倒过来" },
      "fn": "rev",
      "on": 0,
      "defs": ["app"],
      "rows": [
        { "lhs": "rev(nil)", "choices": ["nil"] },
        {
          "lhs": "rev(cons(x, xs))",
          "choices": [
            "app(rev(xs), cons(x, nil))",
            "cons(x, rev(xs))",
            "app(cons(x, nil), rev(xs))",
            "rev(app(xs, cons(x, nil)))"
          ]
        }
      ],
      "tests": [
        { "term": "rev(cons(i, cons(j, cons(k, nil))))", "value": "cons(k, cons(j, cons(i, nil)))" },
        { "term": "rev(cons(i, nil))", "value": "cons(i, nil)" }
      ],
      "solution": ["nil", "app(rev(xs), cons(x, nil))"],
      "naive": ["nil", "cons(x, rev(xs))"],
      "brief": {
        "zh": "给每一行写出右边。"
      },
      "hint": [{ "zh": "x :: xs 倒过来，x 在最后。" }]
    },
    {
      "id": "in-revapp_2",
      "kind": "machine",
      "want": "proved",
      "inputs": [{ "name": "in", "label": { "zh": "目标" } }],
      "backtrack": true,
      "words": ["everyday", "terms"],
      "step": { "zh": "倒过来拼" },
      "types": ["list"],
      "defs": ["app", "len", "rev"],
      "tests": [{ "goal": "∀xs. ∀ys. rev(app(xs, ys)) = app(rev(ys), rev(xs))" }],
      "brief": { "zh": "设计一个证明助手，证完每一个目标。" },
      "hint": [
        {
          "zh": "[] 的情况要 rev ys = rev ys ++ []；另一种情况，两个 ++ 要换一种结合方式。"
        },
        { "zh": "这两件事，「数理规则书」里都有证出的等式。" }
      ],
      "solution": [
        "c0r0 = math[use=[\"list.induct\"]]()",
        "c0 = rule(in, c0r0)",
        "c1 = each(c0, body: c4) {",
        "  body {",
        "    c2r0 = allI()",
        "    c3r0 = math[use=[\"def.0\", \"def.1\", \"def.4\", \"def.5\", appNil, appAssoc]]()",
        "    c4r0 = refl()",
        "    c3r6 = hyp(c3r0)",
        "    c2 = rule(c1.body, c2r0)",
        "    c3 = simp(c2, c3r6)",
        "    c4 = rule(c3, c4r0)",
        "  }",
        "}",
        "out <- c1"
      ],
      "naive": [
        "c0r0 = math[use=[\"list.induct\"]]()",
        "c0 = rule(in, c0r0)",
        "c1 = each(c0, body: c4) {",
        "  body {",
        "    c2r0 = allI()",
        "    c3r0 = math[use=[\"def.0\", \"def.1\", \"def.4\", \"def.5\"]]()",
        "    c4r0 = refl()",
        "    c3r4 = hyp(c3r0)",
        "    c2 = rule(c1.body, c2r0)",
        "    c3 = simp(c2, c3r4)",
        "    c4 = rule(c3, c4r0)",
        "  }",
        "}",
        "out <- c1"
      ]
    }
  ]
}
