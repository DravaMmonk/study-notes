{
  "adds": ["defer"],
  "tray": "machine",
  "title": { "zh": "先问谁" },
  "intro": [
    {
      "t": {
        "zh": "这一回，「多代」那条规则倒过来写：先找 ?x 的祖先 ?y，再看 ?y 是不是 ?z 的父母。意思不变。"
      }
    }
  ],
  "after": { "zh": "这类问题叫左递归。" },
  "tasks": [
    {
      "id": "pl-order",
      "kind": "machine",
      "want": "answers",
      "inputs": [{ "name": "in", "label": { "zh": "问题" } }],
      "backtrack": true,
      "rules": {
        "anc1": {
          "name": { "zh": "祖先·一代" },
          "premises": ["Parent(?x, ?y)"],
          "conclusion": "Anc(?x, ?y)"
        },
        "anc3": {
          "name": { "zh": "祖先·往上数" },
          "premises": ["Anc(?x, ?y)", "Parent(?y, ?z)"],
          "conclusion": "Anc(?x, ?z)"
        }
      },
      "tests": [
        {
          "goal": "Anc(i, ?w)",
          "hyps": ["Parent(i, j)", "Parent(j, k)", "Parent(j, l)", "Parent(l, m)", "Parent(n, m)"],
          "answers": ["j", "k", "l", "m"]
        },
        {
          "goal": "Anc(j, ?w)",
          "hyps": ["Parent(i, j)", "Parent(j, k)", "Parent(j, l)", "Parent(l, m)", "Parent(n, m)"],
          "answers": ["k", "l", "m"]
        }
      ],
      "brief": { "zh": "设计一个证明助手，找出每个问题的所有答案。" },
      "hint": [
        { "zh": "倒着用「往上数」以后，第一个目标又是一个「祖先」。" },
        { "zh": "先证哪个子目标，?y 就能先定下来？" }
      ],
      "solution": [
        "c0 = search(in, body: c1) {",
        "  body {",
        "    c1 = append[ways=\"3\"](c0.body, first: c2, second: c3, third: c5) {",
        "      first {",
        "        c2 = assumption(c1.first)",
        "      }",
        "      second {",
        "        c3r0 = anc1()",
        "        c3 = rule(c1.second, c3r0)",
        "      }",
        "      third {",
        "        c4r0 = anc3()",
        "        c4 = rule(c1.third, c4r0)",
        "        c5 = defer(c4)",
        "      }",
        "    }",
        "  }",
        "}",
        "out <- c0"
      ],
      "naive": [
        "c0 = search(in, body: c1) {",
        "  body {",
        "    c1 = append[ways=\"3\"](c0.body, first: c2, second: c3, third: c4) {",
        "      first {",
        "        c2 = assumption(c1.first)",
        "      }",
        "      second {",
        "        c3r0 = anc1()",
        "        c3 = rule(c1.second, c3r0)",
        "      }",
        "      third {",
        "        c4r0 = anc3()",
        "        c4 = rule(c1.third, c4r0)",
        "      }",
        "    }",
        "  }",
        "}",
        "out <- c0"
      ]
    }
  ]
}
