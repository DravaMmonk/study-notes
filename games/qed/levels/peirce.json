{
  "title": { "en": "Peirce’s law" },
  "tray": "proof",
  "intro": [
    {
      "t": {
        "en": "This sentence has nothing but →. It looks strange, yet it is true on every row."
      }
    }
  ],
  "after": {
    "en": "This is Peirce’s law. Added to a language of → alone, it gives classical logic."
  },
  "tasks": [
    {
      "id": "peirce",
      "kind": "proof",
      "tests": [{ "goal": "((A → B) → A) → A" }],
      "cases": [{ "A": "Rain", "B": "Wet" }, { "A": "Exam", "B": "Pass" }],
      "hint": [
        { "en": "Rain or no rain: take both sides." },
        {
          "en": "On the side where it does not rain, find a way to get “it rains → the ground is wet”."
        }
      ],
      "solution": [
        "f = impI[A=\"(A -> B) -> A\"](body: e) {",
        "  body {",
        "    l = lem[A=A]()",
        "    e = orE(l, left: e.left, right: m2) {",
        "      right {",
        "        g = impI[A=A](body: b) {",
        "          body {",
        "            m = mp(e.right, g.body)",
        "            b = botE[C=B](m)",
        "          }",
        "        }",
        "        m2 = mp(f.body, g)",
        "      }",
        "    }",
        "  }",
        "}",
        "goal <- f"
      ],
      "naive": ["f = impI[A=\"(A -> B) -> A\"](body: f.body)", "goal <- f"]
    }
  ]
}
