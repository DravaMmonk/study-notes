{
  "title": { "zh": "皮尔士律" },
  "tray": "proof",
  "intro": [
    {
      "t": {
        "zh": "这句话只有 →，看着古怪，真值表上每一行却都真。"
      }
    }
  ],
  "after": {
    "zh": "这是皮尔士律。在只有 → 的语言里，加上它就得到经典逻辑。"
  },
  "tasks": [
    {
      "id": "peirce",
      "kind": "proof",
      "tests": [{ "goal": "((A → B) → A) → A" }],
      "cases": [{ "A": "Rain", "B": "Wet" }, { "A": "Exam", "B": "Pass" }],
      "hint": [
        { "zh": "下不下雨，两边都讨论。" },
        {
          "zh": "不下雨的那一边，要设法得到「下雨 → 地湿」。"
        }
      ],
      "solution": [
        "f = impI[A=\"(A -> B) -> A\"](body: e) {",
        "  body {",
        "    l = lem[A=A]()",
        "    e = orE(l, left: e.left, right: m2) {",
        "      right {",
        "        g = impI[A=A](body: b) {",
        "          body {",
        "            m = mp(e.right, g.body)",
        "            b = botE[C=B](m)",
        "          }",
        "        }",
        "        m2 = mp(f.body, g)",
        "      }",
        "    }",
        "  }",
        "}",
        "goal <- f"
      ],
      "naive": ["f = impI[A=\"(A -> B) -> A\"](body: f.body)", "goal <- f"]
    }
  ]
}
