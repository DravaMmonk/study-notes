{
  "title": { "zh": "先假设，再套用" },
  "tray": "proof",
  "intro": [
    { "t": { "zh": "周六的话，下雨我就在家休息。今天下雨了。" } }
  ],
  "tasks": [
    {
      "id": "box",
      "kind": "proof",
      "tests": [{ "premises": { "p": "A → (B → C)", "q": "B" }, "goal": "A → C" }],
      "cases": [{ "A": "Sat", "B": "Rain", "C": "Rest" }, { "A": "Alarm", "B": "Coffee", "C": "Awake" }],
      "briefNote": { "zh": "用假设框。" },
      "hint": [
        { "zh": "目标「若」后面的是什么？" },
        {
          "zh": "先点一下框里的空白，再放元件，元件就落在框里。"
        }
      ],
      "solution": [
        "f = impI[A=A](body: m2) {",
        "  body {",
        "    m1 = mp(p, f.body)",
        "    m2 = mp(m1, q)",
        "  }",
        "}",
        "goal <- f"
      ]
    }
  ]
}
