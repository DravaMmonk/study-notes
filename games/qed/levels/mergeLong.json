{
  "title": { "zh": "绕一大圈" },
  "tray": "proof",
  "intro": [
    {
      "t": {
        "zh": "三句已知首尾相接，最后又绕回起点「闹钟响了」。"
      }
    }
  ],
  "tasks": [
    {
      "id": "mergeLong",
      "kind": "proof",
      "tests": [{ "premises": { "p": "A → B", "q": "B → C", "r": "C → (D → (A → E))", "d": "D" }, "goal": "A → E" }],
      "cases": [
        { "A": "Alarm", "B": "Up", "C": "Coffee", "D": "Bus", "E": "OnTime" },
        { "A": "Rain", "B": "Wet", "C": "Slip", "D": "Bike", "E": "Fall" }
      ],
      "hint": [
        {
          "zh": "接成一段以后，「我坐公交」卡在两遍「闹钟响了」中间。"
        }
      ],
      "solution": ["c1 = chain(p, q)", "c2 = chain(c1, r)", "w = swap(c2)", "m = mp(w, d)", "g = merge(m)", "goal <- g"]
    }
  ]
}
