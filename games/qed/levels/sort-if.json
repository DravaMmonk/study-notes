{
  "title": { "zh": "如果就分情况" },
  "tray": "machine",
  "intro": [
    {
      "t": {
        "zh": "if 的定义只认写明的真、假。条件是 c ≤ a 这样的式子时，化简不知道它的真假，就会卡住。从定义证出两条带条件的规则：条件等于真，取「则」那一边；等于假，取「否则」那一边。"
      }
    }
  ],
  "after": { "zh": "两条规则进了「数理规则书」。" },
  "tasks": [
    {
      "id": "sort-if_1",
      "kind": "machine",
      "want": "proved",
      "inputs": [{ "name": "in", "label": { "zh": "目标" } }],
      "backtrack": true,
      "words": ["everyday", "terms"],
      "step": { "zh": "条件为真" },
      "types": ["bool"],
      "defs": ["if"],
      "tests": [{ "goal": "∀u. ∀v. ∀w. u = tt → if(u, v, w) = v" }],
      "brief": { "zh": "设计一个证明助手，证完每一个目标。" },
      "hint": [
        { "zh": "u = 真 要先进已知。" },
        { "zh": "已知里的等式能把 u 换掉。" }
      ],
      "solution": [
        "c2r0 = impI()",
        "c3r0 = math[use=[\"def.0\", \"def.1\"]]()",
        "c4r0 = refl()",
        "c0 = repeat(in, body: c1) {",
        "  body {",
        "    c1r0 = allI()",
        "    c1 = rule(c0.body, c1r0)",
        "  }",
        "}",
        "c3r2 = hyp(c3r0)",
        "c2 = rule(c0, c2r0)",
        "c3 = simp(c2, c3r2)",
        "c4 = rule(c3, c4r0)",
        "out <- c4"
      ],
      "naive": [
        "c2r0 = impI()",
        "c3r0 = math[use=[\"def.0\", \"def.1\"]]()",
        "c4r0 = refl()",
        "c0 = repeat(in, body: c1) {",
        "  body {",
        "    c1r0 = allI()",
        "    c1 = rule(c0.body, c1r0)",
        "  }",
        "}",
        "c2 = rule(c0, c2r0)",
        "c3 = simp(c2, c3r0)",
        "c4 = rule(c3, c4r0)",
        "out <- c4"
      ]
    },
    {
      "id": "sort-if_2",
