{
  "title": { "zh": "谁是安的孩子" },
  "intro": [
    {
      "t": {
        "zh": "一句话里留一个自由的 x，就成了<wiki-ref to=\"query\"></wiki-ref>：世界里哪些东西代入 x 能让这句话成立，哪些就是答案。数据库的查询语言 SQL，核心就是这样的一阶逻辑。"
      }
    },
    {
      "t": {
        "zh": "这里有两家人。同一句查询要在两家里都选对，靠记名字不行。"
      }
    }
  ],
  "tasks": [
    {
      "id": "q-children",
      "kind": "query",
      "consts": ["h", "i", "j", "k", "l", "m", "n"],
      "worlds": [
        {
          "title": { "zh": "第一家" },
          "things": ["i", "j", "k", "l", "m"],
          "preds": { "Parent": [["i", "j"], ["i", "k"], ["j", "l"], ["k", "m"]], "School": ["l"] }
        },
        {
          "title": { "zh": "第二家" },
          "things": ["i", "j", "k", "l", "m", "n"],
          "preds": {
            "Parent": [["j", "i"], ["i", "k"], ["i", "l"], ["k", "m"], ["l", "n"]],
            "School": ["k", "l", "m", "n"]
          }
        }
      ],
      "say": { "zh": "x 是安的孩子。" },
      "target": "Parent(i, x)",
      "decoys": ["School(x)"],
      "brief": {
        "zh": "拼一句带着 x 的话，在每一家里，让它正好选中安的孩子。"
      },
      "hint": [{ "zh": "「安是 x 的父母」。" }]
    }
  ]
}
