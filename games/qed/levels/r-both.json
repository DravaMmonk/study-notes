{
  "title": { "zh": "两边都有 ?" },
  "adds": ["uSwap", "uDecompose", "uConflict", "uEliminate"],
  "tray": "machine",
  "intro": [
    {
      "t": {
        "zh": "到这里，?-字母都在等式左边。可要对上的两句都可能带着 ?，这时会出现「下雨 ≐ ?B」这样 ? 在右边的等式，而现有的元件只认左边的 ?。新元件「定向」把它翻成 ?B ≐ 下雨。"
      }
    }
  ],
  "tasks": [
    {
      "id": "r-both",
      "kind": "machine",
      "want": "unify",
      "inputs": [{ "name": "in", "label": { "zh": "等式" } }],
      "tests": [
        { "eqs": ["?A ∧ Wind ≐ Rain ∧ ?B"] },
        { "eqs": ["Rain → ?B ≐ ?A"] },
        { "eqs": ["?A → ?A ≐ ?B → Rain"] },
        { "eqs": ["Rain ∧ ?B ≐ ?A ∨ Wind"] }
      ],
      "brief": {
        "zh": "设计一个证明助手：把每组等式解到底；对不上的，说「失败」。"
      },
      "hint": [{ "zh": "?-字母在右边的等式，先翻过来。" }],
      "solution": [
        "r = repeat(in, body: c3) {",
        "  body {",
        "    c0 = uDecompose(r.body)",
        "    c1 = uSwap(c0)",
        "    c2 = uEliminate(c1)",
        "    c3 = uConflict(c2)",
        "  }",
        "}",
        "out <- r"
      ]
    }
  ]
}
