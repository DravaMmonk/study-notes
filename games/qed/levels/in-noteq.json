{
  "title": { "en": "Never the one after itself" },
  "tray": "machine",
  "fact": "succNeq",
  "intro": [{ "t": { "en": "No number is the one after itself: x ≠ S x." } }],
  "tasks": [
    {
      "id": "in-noteq",
      "kind": "machine",
      "want": "proved",
      "inputs": [{ "name": "in", "label": { "en": "Goal" } }],
      "backtrack": true,
      "words": ["everyday", "terms"],
      "types": ["nat"],
      "tests": [{ "goal": "∀x. ¬(x = s(x))" }],
      "brief": { "en": "Design a proof assistant that proves every goal." },
      "hint": [
        { "en": "Induction." },
        { "en": "The two cases need the declaration’s rules and the one-to-one proved." }
      ],
      "solution": [
        "c0r0 = math[use=[\"nat.induct\"]]()",
        "c1r0 = impI()",
        "c2r0 = math[use=[\"nat.distinct1\"]]()",
        "c3r0 = impI()",
        "c4r0 = math[use=[inject]]()",
        "c5r0 = mp[use=[mp]]()",
        "c0 = rule(in, c0r0)",
        "c1 = rule(c0, c1r0)",
        "c2 = erule(c1, c2r0)",
        "c3 = rule(c2, c3r0)",
        "c4 = erule(c3, c4r0)",
        "c5 = erule(c4, c5r0)",
        "c6 = assumption(c5)",
        "out <- c6"
      ]
    }
  ]
}
