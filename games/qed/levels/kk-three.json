{
  "title": { "en": "Knights and knaves" },
  "tasks": [
    {
      "id": "kk-three_1",
      "kind": "gates",
      "tray": "gates",
      "step": { "en": "Translate" },
      "blind": true,
      "target": "KA ↔ ¬KA ∨ KB",
      "brief": {
        "en": "Two islanders, a and b; a says: “I am a knave, or b is a knight.” Wire it as a circuit: it outputs true on the rows where what a says fits what a is."
      },
      "hint": [{ "en": "What a says is “¬a is a knight ∨ b is a knight”." }],
      "solution": ["na = gNot(KA)", "o = gOr(na, KB)", "e = gIff(KA, o)", "out <- e"]
    },
    {
      "id": "kk-three_2",
      "kind": "proof",
      "tray": "proof",
      "step": { "en": "Proof" },
      "tests": [{ "premises": { "p": "A ↔ ¬A ∨ B" }, "goal": "A ∧ B" }],
      "cases": [{ "A": "KA", "B": "KB" }, { "A": "KC", "B": "KD" }],
      "hint": [
        { "en": "First prove “a is a knight”: take both sides of whether he is." },
        { "en": "If a is a knight, his statement is true; then take cases on it." }
      ],
      "solution": [
        "l = lem[A=A]()",
        "e = andE(p)",
        "o = orE(l, left: o.left, right: m) {",
        "  right {",
        "    i = orI[other=B, side=right](o.right)",
        "    m = mp(e.right, i)",
        "  }",
        "}",
        "says = mp(e.left, o)",
        "c = orE(says, left: no, right: c.right) {",
        "  left {",
        "    m2 = mp(c.left, o)",
        "    no = botE[C=B](m2)",
        "  }",
        "}",
        "both = andI(o, c)",
        "goal <- both"
      ]
    }
  ]
}
