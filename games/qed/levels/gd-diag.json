{
  "title": { "zh": "对角线是一次计算" },
  "tray": "machine",
  "intro": [
    {
      "t": {
        "zh": "第三步要造一句说「我证不出」的话。难处在于一句话写不进自己的编码：编码比句子长。哥德尔的办法是<wiki-ref to=\"diagonal\"></wiki-ref>：先写一句带空位 □ 的话 D：「对角 □ 证不出」。取对角是一次计算：把一句带空位的话自己的编码 ⌜…⌝ 填进它的空位。"
      }
    },
    {
      "t": {
        "zh": "G 是 D 的对角。第一个目标算出 G；第二个目标算出 G 说到的那句话（对角 ⌜D⌝ 的值）。"
      }
    }
  ],
  "after": {
    "zh": "这就是<b>对角线引理</b>：对任何说法 P(□)，都有一句 G 和 P(⌜G⌝) 等价。"
  },
  "tasks": [
    {
      "id": "gd-diag",
      "kind": "machine",
      "want": "proved",
      "inputs": [{ "name": "in", "label": { "zh": "目标" } }],
      "backtrack": true,
      "words": ["everyday", "terms", "codes"],
      "stated": [
        "diag(x) = sub(x, qt(x))",
        "sub(nprov(x), y) = nprov(subt(x, y))",
        "subt(vx, y) = y",
        "subt(dg(x), y) = dg(subt(x, y))",
        "subt(qt(x), y) = qt(x)",
        "val(qt(x)) = x",
        "val(dg(x)) = diag(val(x))"
      ],
      "tests": [
        { "goal": "diag(nprov(dg(vx))) = nprov(dg(qt(nprov(dg(vx)))))" },
        { "goal": "val(dg(qt(nprov(dg(vx))))) = nprov(dg(qt(nprov(dg(vx)))))" }
      ],
      "brief": { "zh": "设计一个证明助手，证完每一个目标。" },
      "hint": [{ "zh": "七条定义都要用。" }],
      "solution": [
        "c0r0 = math[use=[\"def.0\", \"def.1\", \"def.2\", \"def.3\", \"def.4\", \"def.5\", \"def.6\"]]()",
        "c1r0 = refl()",
        "c0 = simp(in, c0r0)",
        "c1 = rule(c0, c1r0)",
        "out <- c1"
      ]
    }
  ]
}
