{
  "kind": "machine",
  "want": "proved",
  "inputs": [{ "name": "in", "label": { "zh": "目标", "en": "Goal" } }],
  "backtrack": true,
  "words": ["everyday", "terms"],
  "title": { "zh": "长度相加", "en": "Lengths add up" },
  "types": ["list"],
  "defs": ["app", "len", "plus"],
  "tests": [{ "goal": "∀xs. ∀ys. len(app(xs, ys)) = plus(len(xs), len(ys))" }],
  "brief": { "zh": "设计一个证明助手，证完每一个目标。", "en": "Design a proof assistant that proves every goal." },
  "hint": [{ "zh": "列表的定义和加法的定义都要用。", "en": "Both the list definitions and addition’s are needed." }],
  "solution": [
    "c0r0 = math[use=[\"list.induct\"]]()",
    "c0 = rule(in, c0r0)",
    "c1 = each(c0, body: c4) {",
    "  body {",
    "    c2r0 = allI()",
    "    c3r0 = math[use=[\"def.0\", \"def.1\", \"def.2\", \"def.3\", \"def.4\", \"def.5\"]]()",
    "    c4r0 = refl()",
    "    c3r6 = hyp(c3r0)",
    "    c2 = rule(c1.body, c2r0)",
    "    c3 = simp(c2, c3r6)",
    "    c4 = rule(c3, c4r0)",
    "  }",
    "}",
    "out <- c1"
  ]
}
