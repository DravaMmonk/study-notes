{
  "title": { "en": "Apply" },
  "tray": "proof",
  "intro": [
    {
      "t": {
        "en": "The new part <part-ref to=\"part:mp\"></part-ref> is a proof rule: one input takes A → B, the other A, and it outputs B."
      }
    },
    {
      "t": {
        "en": "Parts go onto the board from the tray above. When an input does not fit, the part shows what it wants and what it got."
      }
    }
  ],
  "after": { "en": "Logicians call this rule <b>modus ponens</b>." },
  "tasks": [
    {
      "id": "mp_1",
      "kind": "proof",
      "step": { "en": "Apply" },
      "tests": [{ "premises": { "p": "A → B", "q": "B → C", "r": "A" }, "goal": "C" }],
      "cases": [{ "A": "Rain", "B": "Wet", "C": "Slip" }, { "A": "Alarm", "B": "Up", "C": "OnTime" }],
      "adds": ["mp"],
      "hint": [
        { "en": "Look first at just “it rains → the ground is wet” and “it rains”." },
        { "en": "An Apply’s output, like a given, can go into another part." }
      ],
      "solution": ["m1 = mp(p, r)", "m2 = mp(q, m1)", "goal <- m2"]
    },
    {
      "id": "mp_2",
      "kind": "proof",
      "step": { "en": "A given you do not need" },
      "tests": [{ "premises": { "p": "A → B", "q": "C → B", "r": "C", "s": "B → D" }, "goal": "D" }],
      "cases": [
        { "A": "Bus", "B": "OnTime", "C": "Bike", "D": "Happy" },
        { "A": "Coffee", "B": "Awake", "C": "Tea", "D": "Pass" }
      ],
      "hint": [{ "en": "Work back from the goal: which sentence can give “I am happy”?" }],
      "intro": [{ "t": { "en": "Not every given is needed." } }],
      "solution": ["m1 = mp(q, r)", "m2 = mp(s, m1)", "goal <- m2"]
    }
  ]
}
