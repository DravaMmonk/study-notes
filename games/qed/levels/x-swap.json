{
  "title": { "zh": "不用框换顺序" },
  "tray": "proof",
  "without": ["impI", "chain", "swap", "merge"],
  "tasks": [
    {
      "id": "x-swap",
      "sentences": ["(A → B) → (A → C)"],
      "kind": "proof",
      "tests": [{ "premises": { "p": "A → (B → C)" }, "goal": "B → (A → C)" }],
      "cases": [{ "A": "Sat", "B": "Rain", "C": "Rest" }, { "A": "Exam", "B": "Study", "C": "Pass" }],
      "briefNote": { "zh": "不用假设框。" },
      "hint": [
        { "zh": "已知能接进哪一种 S？套用以后得到什么？" },
        {
          "zh": "还缺的一段，K 能不能补上？两段首尾相接以后，照<level-ref to=\"x-chain\"></level-ref>接起来。"
        }
      ],
      "solution": [
        "s = axS[A=A, B=B, C=C]()",
        "k = axK[A=B, B=A]()",
        "k2 = axK[A=\"(A -> B) -> (A -> C)\", B=B]()",
        "s2 = axS[A=B, B=\"A -> B\", C=\"A -> C\"]()",
        "m1 = mp(s, p)",
        "m2 = mp(k2, m1)",
        "m3 = mp(s2, m2)",
        "m4 = mp(m3, k)",
        "goal <- m4"
      ]
    }
  ]
}
