{
  "title": { "en": "conjunctive normal form" },
  "tray": "machine",
  "intro": [
    {
      "t": {
        "en": "<wiki-ref to=\"cnf\"></wiki-ref>: negation normal form, with every “or” under the “and”s, a few strings of “or” joined by “and”. Each string of “or” is a <wiki-ref to=\"clause\"></wiki-ref>."
      }
    }
  ],
  "after": {
    "en": "Automatic provers usually bring a sentence to conjunctive normal form before anything else."
  },
  "tasks": [
    {
      "id": "sp-cnf",
      "kind": "machine",
      "want": "becomes",
      "inputs": [{ "name": "in", "label": { "en": "Goal" } }],
      "backtrack": true,
      "tests": [
        { "goal": "Rain ∨ (Wind ∧ Wet)", "becomes": [["(Rain ∨ Wind) ∧ (Rain ∨ Wet)"]] },
        { "goal": "¬(Rain ∧ Wind) ∨ (Wet ∧ Slip)", "becomes": [["(¬Rain ∨ ¬Wind ∨ Wet) ∧ (¬Rain ∨ ¬Wind ∨ Slip)"]] },
        {
          "goal": "(Rain → Wet) ∧ (Wind ∨ (Rain ∧ Slip))",
          "becomes": [["(¬Rain ∨ Wet) ∧ ((Wind ∨ Rain) ∧ (Wind ∨ Slip))"]]
        }
      ],
      "brief": { "en": "Design a proof assistant that transforms each goal into the required form." },
      "hint": [
        { "en": "Start from negation normal form." },
        { "en": "What is left is to bring every “or” under the “and”s." }
      ],
      "solution": [
        "c0r0 = arrow[use=[\"arrow.elim\"]]()",
        "c0r1 = dneg[use=[\"dneg.elim\"]](c0r0)",
        "c0r2 = dm[use=[\"dm.notOr\", \"dm.notAnd\", \"dm.notEx\", \"dm.notAll\"]](c0r1)",
        "c0r6 = dist[use=[\"dist.orAndR\", \"dist.orAndL\"]](c0r2)",
        "c0 = simp(in, c0r6)",
        "out <- c0"
      ]
    }
  ]
}
