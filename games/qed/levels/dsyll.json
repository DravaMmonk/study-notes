{
  "title": { "zh": "排除一个，剩下那个" },
  "tray": "proof",
  "intro": [{ "t": { "zh": "要么坐公交，要么骑车；没坐公交，那就是骑车。" } }],
  "after": {
    "zh": "这叫<wiki-ref to=\"dsyll\"></wiki-ref>，「排除法」靠的就是它。"
  },
  "tasks": [
    {
      "id": "dsyll",
      "kind": "proof",
      "tests": [{ "premises": { "p": "A ∨ B", "q": "¬A" }, "goal": "B" }],
      "cases": [{ "A": "Bus", "B": "Bike" }, { "A": "Coffee", "B": "Tea" }],
      "hint": [
        {
          "zh": "分情况。「我坐公交」那一边撞上「¬我坐公交」，得到 ⊥；矛盾推出一切。"
        }
      ],
      "solution": [
        "e = orE(p, left: b, right: e.right) {",
        "  left {",
        "    m = mp(q, e.left)",
        "    b = botE[C=B](m)",
        "  }",
        "}",
        "goal <- e"
      ]
    }
  ]
}
