{
  "title": { "zh": "比大小，取大的" },
  "intro": [
    {
      "t": {
        "zh": "<level-ref to=\"decl-bool\"></level-ref>带来了真和假。先定义比大小，再用它定义取大的。"
      }
    }
  ],
  "tasks": [
    {
      "id": "def-max_1",
      "kind": "define",
      "words": ["everyday", "terms"],
      "step": { "zh": "比大小" },
      "fn": "le",
      "on": 0,
      "rows": [
        { "lhs": "le(zero, y)", "choices": ["tt", "ff"] },
        { "lhs": "le(s(x), zero)", "choices": ["ff", "tt"] },
        { "lhs": "le(s(x), s(y))", "choices": ["le(x, y)", "tt", "le(s(x), s(y))"] }
      ],
      "tests": [
        { "term": "le(s(zero), s(s(zero)))", "value": "tt" },
        { "term": "le(s(s(zero)), s(zero))", "value": "ff" },
        { "term": "le(zero, zero)", "value": "tt" }
      ],
      "solution": ["tt", "ff", "le(x, y)"],
      "naive": ["tt", "ff", "tt"],
      "brief": {
        "zh": "给每一行选一个右边，让每个测试都算对。"
      },
      "hint": [{ "zh": "两边各去掉一个 S，大小关系不变。" }],
      "intro": [
        {
          "t": {
            "zh": "x ≤ y 的值是真或假。两个数都要拆开，所以有三行：0 和任何数比，S x 和 0 比，S x 和 S y 比。"
          }
        }
      ]
    },
    {
      "id": "def-max_2",
      "kind": "define",
      "words": ["everyday", "terms"],
      "step": { "zh": "取大的" },
      "fn": "max",
      "on": null,
      "defs": ["le"],
      "rows": [
        { "lhs": "max(x, y)", "when": "le(x, y) = tt", "choices": ["y", "x"] },
        { "lhs": "max(x, y)", "when": "le(x, y) = ff", "choices": ["x", "y"] }
      ],
      "tests": [
        { "term": "max(s(zero), s(s(zero)))", "value": "s(s(zero))" },
        { "term": "max(s(s(zero)), zero)", "value": "s(s(zero))" }
      ],
      "solution": ["y", "x"],
      "naive": ["x", "y"],
      "brief": {
        "zh": "给每一行选一个右边，让每个测试都算对。"
      },
      "hint": [{ "zh": "看哪一行的条件说 x 不比 y 大。" }],
      "intro": [
        {
          "t": {
            "zh": "max 不拆数，而看 x ≤ y 的真假：真假各一行，每行带一个<b>条件</b>。"
          }
        }
      ]
    }
  ]
}
