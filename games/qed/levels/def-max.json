{
  "title": { "en": "Comparing, and the larger" },
  "intro": [
    {
      "t": {
        "en": "<level-ref to=\"decl-bool\"></level-ref> brought true and false. Define comparison first, then the larger of two with it."
      }
    }
  ],
  "tasks": [
    {
      "id": "def-max_1",
      "kind": "define",
      "words": ["everyday", "terms"],
      "step": { "en": "Comparing" },
      "fn": "le",
      "on": 0,
      "rows": [
        { "lhs": "le(zero, y)", "choices": ["tt", "ff"] },
        { "lhs": "le(s(x), zero)", "choices": ["ff", "tt"] },
        { "lhs": "le(s(x), s(y))", "choices": ["le(x, y)", "tt", "le(s(x), s(y))"] }
      ],
      "tests": [
        { "term": "le(s(zero), s(s(zero)))", "value": "tt" },
        { "term": "le(s(s(zero)), s(zero))", "value": "ff" },
        { "term": "le(zero, zero)", "value": "tt" }
      ],
      "solution": ["tt", "ff", "le(x, y)"],
      "naive": ["tt", "ff", "tt"],
      "brief": {
        "en": "Write a right side for every row."
      },
      "hint": [{ "en": "Taking one S off each side leaves the comparison as it was." }],
      "intro": [
        {
          "t": {
            "en": "x ≤ y is true or false. Both numbers are taken apart, so there are three rows: 0 against any number, S x against 0, S x against S y."
          }
        }
      ]
    },
    {
      "id": "def-max_2",
      "kind": "define",
      "words": ["everyday", "terms"],
      "step": { "en": "The larger" },
      "fn": "max",
      "on": null,
      "defs": ["le"],
      "rows": [
        { "lhs": "max(x, y)", "when": "le(x, y) = tt", "choices": ["y", "x"] },
        { "lhs": "max(x, y)", "when": "le(x, y) = ff", "choices": ["x", "y"] }
      ],
      "tests": [
        { "term": "max(s(zero), s(s(zero)))", "value": "s(s(zero))" },
        { "term": "max(s(s(zero)), zero)", "value": "s(s(zero))" }
      ],
      "solution": ["y", "x"],
      "naive": ["x", "y"],
      "brief": {
        "en": "Write a right side for every row."
      },
      "hint": [{ "en": "Look for the row whose condition says x is no bigger than y." }],
      "intro": [
        {
          "t": {
            "en": "max takes no number apart; it looks at whether x ≤ y is true: one row for true, one for false, each with a <b>condition</b>."
          }
        }
      ]
    }
  ]
}
