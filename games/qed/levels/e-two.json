{
  "title": { "zh": "两个人说话" },
  "tray": "gates",
  "tasks": [
    {
      "id": "e-two",
      "kind": "gates",
      "target": "(KA ↔ ¬KB) ∧ (KB ↔ KA ∧ KB)",
      "blind": true,
      "brief": {
        "zh": "a 说：「b 是无赖。」b 说：「我们俩都是骑士。」把两人的话译成逻辑，接成电路：两人的话都和身份相符的行，输出真。"
      },
      "hint": [
        { "zh": "每个人的话各译一句。" },
        { "zh": "两句要同时成立。" }
      ],
      "solution": [
        "nb = gNot(KB)",
        "ab = gAnd(KA, KB)",
        "e1 = gIff(KA, nb)",
        "e2 = gIff(KB, ab)",
        "all = gAnd(e1, e2)",
        "out <- all"
      ]
    }
  ]
}
