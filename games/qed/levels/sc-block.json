        { "k": "show", "stmt": "Wind → Wet", "by": "proof" },
        { "k": "assume", "stmt": "Wind" },
        { "k": "have", "stmt": "Rain ∧ Wind", "using": ["a1", "a2"], "by": "rule:conjI" },
        { "k": "show", "stmt": "Wet", "using": ["p", "h1"], "by": "rule:mp" }
      ],
      "naive": [
