{
  "title": { "en": "Who is a grandparent" },
  "tray": "machine",
  "intro": [
    {
      "t": {
        "en": "In <level-ref to=\"q-grand\"></level-ref>, “grandparent” was written as a query. This time it is a rule: ⟦?x is a parent of ?y; ?y is a parent of ?z⟧ ⟹ ?x is a grandparent of ?z. The family tree’s facts are the goal’s givens."
      }
    },
    {
      "t": {
        "en": "The question itself holds a ?-letter: “?w is a grandparent of Cy”. Who ?w is in each way of proving it is an answer."
      }
    }
  ],
  "after": {
    "en": "This is Prolog: a program is a set of rules, and a question is a goal with ?-letters to prove."
  },
  "tasks": [
    {
      "id": "pl-grand",
      "kind": "machine",
      "want": "answers",
      "inputs": [{ "name": "in", "label": { "en": "Question" } }],
      "backtrack": true,
      "rules": {
        "grand": {
          "name": { "en": "Grandparent" },
          "premises": ["Parent(?x, ?y)", "Parent(?y, ?z)"],
          "conclusion": "Grand(?x, ?z)"
        }
      },
      "tests": [
        {
          "goal": "Grand(?w, k)",
          "hyps": ["Parent(i, j)", "Parent(j, k)", "Parent(j, l)", "Parent(l, m)", "Parent(n, m)"],
          "answers": ["i"]
        },
        {
          "goal": "Grand(j, ?w)",
          "hyps": ["Parent(i, j)", "Parent(j, k)", "Parent(j, l)", "Parent(l, m)", "Parent(n, m)"],
          "answers": ["m"]
        },
        {
          "goal": "Grand(i, ?w)",
          "hyps": ["Parent(i, j)", "Parent(j, k)", "Parent(j, l)", "Parent(l, m)", "Parent(n, m)"],
          "answers": ["k", "l"]
        }
      ],
      "brief": { "en": "Design a proof assistant that finds every answer to each question." },
      "hint": [
        { "en": "Use the rule Grandparent backwards." },
        { "en": "Every way of fitting is an answer." }
      ],
      "solution": ["c0r0 = grand()", "c0 = rule(in, c0r0)", "c1 = assumption(c0)", "c2 = assumption(c1)", "out <- c2"]
    }
  ]
}
