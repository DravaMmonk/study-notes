{
  "title": { "en": "One goal becomes several" },
  "tray": "machine",
  "intro": [
    {
      "t": {
        "en": "Join has two premises: used backwards, it turns one goal into two, in a row. A part always works on the first goal; when it is proved, the next moves up."
      }
    }
  ],
  "tasks": [
    {
      "id": "r-subgoals",
      "kind": "machine",
      "want": "proved",
      "inputs": [{ "name": "in", "label": { "en": "Goal" } }],
      "tests": [
        { "goal": "Rain → (Wind → Rain ∧ Wind)" },
        { "goal": "Wet → (Slip → Wet ∧ Slip)" },
        { "goal": "¬Rain → (Wind → ¬Rain ∧ Wind)" }
      ],
      "brief": { "en": "Design a proof assistant that proves every goal." },
      "hint": [{ "en": "Are the two halves of the “and” each among the givens?" }],
      "solution": [
        "c0r0 = impI()",
        "c1r0 = impI()",
        "c2r0 = andI()",
        "c0 = rule(in, c0r0)",
        "c1 = rule(c0, c1r0)",
        "c2 = rule(c1, c2r0)",
        "c3 = assumption(c2)",
        "c4 = assumption(c3)",
        "out <- c4"
      ]
    }
  ]
}
