{
  "title": { "en": "Joining without a box" },
  "tray": "proof",
  "without": ["impI", "chain", "swap", "merge"],
  "after": {
    "en": "Any box can be traded for K, S and Apply: the <wiki-ref to=\"deduction\"></wiki-ref>."
  },
  "tasks": [
    {
      "id": "x-chain",
      "kind": "proof",
      "tests": [{ "premises": { "p": "A → B", "q": "B → C" }, "goal": "A → C" }],
      "cases": [{ "A": "Rain", "B": "Wet", "C": "Slip" }, { "A": "Alarm", "B": "Up", "C": "OnTime" }],
      "briefNote": { "en": "Without the assumption box." },
      "hint": [
        {
          "en": "What does the proof look like with a box? Without one, what does each step inside it?"
        },
        { "en": "The Apply inside the box happens under the condition “it rains”." }
      ],
      "solution": [
        "k = axK[A=\"B -> C\", B=A]()",
        "s = axS[A=A, B=B, C=C]()",
        "m1 = mp(k, q)",
        "m2 = mp(s, m1)",
        "m3 = mp(m2, p)",
        "goal <- m3"
      ]
    }
  ]
}
