{
  "title": { "en": "Two that do not meet" },
  "tray": "proof",
  "tasks": [
    {
      "id": "mergeBoth",
      "kind": "proof",
      "tests": [{ "premises": { "p": "A → (A → B)", "q": "A → (B → C)" }, "goal": "A → C" }],
      "cases": [{ "A": "Rain", "B": "Wet", "C": "Slip" }, { "A": "Hungry", "B": "Eat", "C": "Full" }],
      "hint": [
        { "en": "Both start with “it rains”, so they do not meet end to end." },
        { "en": "Can the second be made to start with “the ground is wet”?" }
      ],
      "solution": ["g1 = merge(p)", "w = swap(q)", "c = chain(g1, w)", "g2 = merge(c)", "goal <- g2"]
    }
  ]
}
