{
  "title": { "zh": "累加器求和" },
  "tray": "machine",
  "intro": [
    {
      "t": {
        "zh": "两种求和：一种从后往前加，一种带着累加器往后走。两者是否相同？"
      }
    }
  ],
  "tasks": [
    {
      "id": "in-itsum_1",
      "kind": "define",
      "words": ["everyday", "terms"],
      "step": { "zh": "求和" },
      "fn": "sum",
      "on": 0,
      "defs": ["plus"],
      "rows": [
        { "lhs": "sum(nil)", "choices": ["zero", "s(zero)"] },
        { "lhs": "sum(cons(x, xs))", "choices": ["plus(x, sum(xs))", "sum(xs)", "plus(x, sum(cons(x, xs)))"] }
      ],
      "tests": [
        { "term": "sum(cons(s(zero), cons(s(s(zero)), nil)))", "value": "s(s(s(zero)))" },
        { "term": "sum(nil)", "value": "zero" }
      ],
      "solution": ["zero", "plus(x, sum(xs))"],
      "naive": ["zero", "sum(xs)"],
      "brief": {
        "zh": "给每一行写出右边。"
      },
      "hint": [{ "zh": "x :: xs 的和里有 x。" }],
      "intro": [{ "t": { "zh": "sum 从后往前加。" } }]
    },
    {
      "id": "in-itsum_2",
      "kind": "define",
      "words": ["everyday", "terms"],
      "step": { "zh": "累加器" },
      "fn": "itsum",
      "on": 0,
      "defs": ["plus"],
      "rows": [
        { "lhs": "itsum(nil, y)", "choices": ["y", "zero"] },
        {
          "lhs": "itsum(cons(x, xs), y)",
          "choices": ["itsum(xs, plus(y, x))", "itsum(xs, y)", "itsum(cons(x, xs), plus(y, x))"]
        }
      ],
      "tests": [
        { "term": "itsum(cons(s(zero), cons(s(s(zero)), nil)), zero)", "value": "s(s(s(zero)))" },
        { "term": "itsum(nil, s(zero))", "value": "s(zero)" }
      ],
      "solution": ["y", "itsum(xs, plus(y, x))"],
      "naive": ["zero", "itsum(xs, plus(y, x))"],
      "brief": {
        "zh": "给每一行写出右边。"
      },
      "hint": [{ "zh": "走到头时，y 里已经是加好的和。" }],
      "intro": [
        {
          "t": {
            "zh": "itsum 一边往后走，一边把元素加到 y 上，走到头 y 就是和。程序员把这种写法叫作尾递归。"
          }
        }
      ]
    },
    {
      "id": "in-itsum_3",
      "kind": "machine",
      "want": "proved",
      "inputs": [{ "name": "in", "label": { "zh": "目标" } }],
      "backtrack": true,
      "words": ["everyday", "terms"],
      "step": { "zh": "一样吗" },
      "types": ["list"],
      "defs": ["plus", "sum", "itsum"],
      "tests": [{ "goal": "∀xs. ∀y. itsum(xs, y) = plus(y, sum(xs))" }],
      "brief": { "zh": "设计一个证明助手，证完每一个目标。" },
      "hint": [
        { "zh": "每往后走一步，y 都在变。" },
        {
          "zh": "[] 的情况要 y + 0 = y；另一种情况，两个 + 要换一种结合方式。"
        }
      ],
      "solution": [
        "c0r0 = math[use=[\"list.induct\"]]()",
        "c0 = rule(in, c0r0)",
        "c1 = each(c0, body: c4) {",
        "  body {",
        "    c2r0 = allI()",
        "    c3r0 = math[use=[\"def.0\", \"def.1\", \"def.2\", \"def.3\", \"def.4\", \"def.5\", addZero, addAssoc]]()",
        "    c4r0 = refl()",
        "    c3r8 = hyp(c3r0)",
        "    c2 = rule(c1.body, c2r0)",
        "    c3 = simp(c2, c3r8)",
        "    c4 = rule(c3, c4r0)",
        "  }",
        "}",
        "out <- c1"
      ],
      "naive": [
        "c0r0 = math[use=[\"list.induct\"]]()",
        "c0 = rule(in, c0r0)",
        "c1 = each(c0, body: c4) {",
        "  body {",
        "    c2r0 = allI()",
        "    c3r0 = math[use=[\"def.0\", \"def.1\", \"def.2\", \"def.3\", \"def.4\", \"def.5\"]]()",
        "    c4r0 = refl()",
        "    c3r6 = hyp(c3r0)",
        "    c2 = rule(c1.body, c2r0)",
        "    c3 = simp(c2, c3r6)",
        "    c4 = rule(c3, c4r0)",
        "  }",
        "}",
        "out <- c1"
      ]
    }
  ]
}
