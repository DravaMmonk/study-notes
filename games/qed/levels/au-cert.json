{
  "adds": ["saturate", "clausify", "res"],
  "title": { "zh": "证书" },
  "intro": [
    {
      "t": {
        "zh": "饱和器推出几十条子句，推出 ⊥ 用到的只有几条。从 ⊥ 顺着来源往回找，得到的就是一份<wiki-ref to=\"certificate\"></wiki-ref>：哪两条消出哪一条。"
      }
    }
  ],
  "after": { "zh": "找证明难，查证明容易。" },
  "tasks": [
    {
      "id": "au-cert_1",
      "kind": "machine",
      "tray": "machine",
      "want": "refuted",
      "inputs": [{ "name": "in", "label": { "zh": "目标" } }],
      "backtrack": true,
      "step": { "zh": "证明助手找" },
      "tests": [{ "goal": "Coffee", "hyps": ["Alarm → Up", "Up → Coffee", "Alarm"] }],
      "brief": {
        "zh": "设计一个证明助手，从「闹钟响了 → 我起床了」「我起床了 → 我喝了咖啡」「闹钟响了」推出 ⊥，看结果里的证书。"
      },
      "hint": [
        {
          "zh": "<level-ref to=\"au-sledge\"></level-ref>的证明助手就够用。"
        }
      ],
      "solution": ["c0 = clausify(in)", "c1 = saturate(c0)", "out <- c1"]
    },
    {
      "id": "au-cert_2",
      "kind": "proof",
      "tray": "resolution",
      "step": { "zh": "照着重放" },
      "tests": [{ "premises": { "p": "¬A ∨ B", "q": "¬B ∨ C", "r": "A", "s": "¬C" }, "goal": "⊥" }],
      "cases": [{ "A": "Alarm", "B": "Up", "C": "Coffee" }],
      "briefNote": { "zh": "按照证明助手的证书，在证明板上重放。" },
      "hint": [{ "zh": "证书里每一条推出的子句都写着它的两条来源。" }],
      "solution": ["r1 = res(p, r)", "r2 = res(q, s)", "r3 = res(r1, r2)", "goal <- r3"]
    }
  ]
}
