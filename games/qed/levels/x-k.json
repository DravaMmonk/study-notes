{
  "title": { "en": "Without the box: K and S" },
  "tray": "proof",
  "without": ["impI", "chain", "swap", "merge"],
  "intro": [
    {
      "t": {
        "en": "This topic takes the box away, leaving Apply and the K and S you proved. Early provers were like this: one rule, and every other starting point an <wiki-ref to=\"axiom\"></wiki-ref>. Such a prover is a <wiki-ref to=\"hilbert\"></wiki-ref>."
      }
    }
  ],
  "tasks": [
    {
      "id": "x-k_1",
      "kind": "proof",
      "step": { "en": "A condition without a box" },
      "tests": [{ "premises": { "p": "A" }, "goal": "B → A" }],
      "cases": [{ "A": "Rain", "B": "Wind" }, { "A": "Coffee", "B": "Late" }],
      "briefNote": { "en": "Without the assumption box." },
      "hint": [{ "en": "What does K say?" }],
      "solution": ["k = axK[A=A, B=B]()", "m = mp(k, p)", "goal <- m"]
    },
    {
      "id": "x-k_2",
      "kind": "proof",
      "step": { "en": "Under a condition without a box" },
      "tests": [{ "premises": { "p": "A → (B → (C → D))", "q": "A → B" }, "goal": "A → (C → D)" }],
      "cases": [
        { "A": "Sat", "B": "Rain", "C": "Hungry", "D": "Eat" },
        { "A": "Exam", "B": "Study", "C": "Coffee", "D": "Awake" }
      ],
      "briefNote": { "en": "Without the assumption box." },
      "hint": [
        { "en": "Apply under a condition is what S does." },
        { "en": "S’s three sentences need not each be a single word." }
      ],
      "solution": ["s = axS[A=A, B=B, C=\"C -> D\"]()", "m1 = mp(s, p)", "m2 = mp(m1, q)", "goal <- m2"]
    }
  ]
}
