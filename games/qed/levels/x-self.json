{
  "title": { "zh": "不用框恒等" },
  "tray": "proof",
  "without": ["impI", "chain", "swap", "merge"],
  "tasks": [
    {
      "id": "x-self",
      "kind": "proof",
      "tests": [{ "goal": "A → A" }],
      "cases": [{ "A": "Rain" }, { "A": "Sat" }],
      "briefNote": { "zh": "不用假设框。" },
      "hint": [
        { "zh": "从 S 开始：S 套用两次之后得到的是什么？" },
        {
          "zh": "S 的第二句不一定是一个词。S 要的两句，都能用 K 造。"
        }
      ],
      "solution": [
        "s = axS[A=A, B=\"A -> A\", C=A]()",
        "k1 = axK[A=A, B=\"A -> A\"]()",
        "k2 = axK[A=A, B=A]()",
        "m1 = mp(s, k1)",
        "m2 = mp(m1, k2)",
        "goal <- m2"
      ]
    }
  ]
}
