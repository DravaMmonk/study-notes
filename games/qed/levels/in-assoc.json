{
  "kind": "machine",
  "want": "proved",
  "inputs": [{ "name": "in", "label": { "zh": "目标", "en": "Goal" } }],
  "backtrack": true,
  "words": ["everyday", "terms"],
  "title": { "zh": "结合", "en": "Associativity" },
  "fact": "addAssoc",
  "types": ["nat"],
  "defs": ["plus"],
  "tests": [{ "goal": "∀x. ∀y. ∀z. plus(plus(x, y), z) = plus(x, plus(y, z))" }],
  "brief": { "zh": "设计一个证明助手，证完每一个目标。", "en": "Design a proof assistant that proves every goal." },
  "hint": [{ "zh": "加法的定义拆的是左边的数。", "en": "Addition’s definition takes apart the number on the left." }],
  "solution": [
    "c0r0 = math[use=[\"nat.induct\"]]()",
    "c0 = rule(in, c0r0)",
    "c1 = each(c0, body: c5) {",
    "  body {",
    "    c2r0 = math[use=[\"def.0\", \"def.1\"]]()",
    "    c5r0 = refl()",
    "    c2r2 = hyp(c2r0)",
    "    c2 = simp(c1.body, c2r2)",
    "    c3 = repeat(c2, body: c4) {",
    "      body {",
    "        c4r0 = allI()",
    "        c4 = rule(c3.body, c4r0)",
    "      }",
    "    }",
    "    c5 = rule(c3, c5r0)",
    "  }",
    "}",
    "out <- c1"
  ]
}
