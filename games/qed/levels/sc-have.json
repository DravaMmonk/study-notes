{
  "title": { "zh": "补一句 have", "en": "A missing have" },
  "intro": [
    {
      "t": {
        "zh": "写脚本时，常常先写最后一句 show，再往前补它用到的事实，一句一句 have 出来。",
        "en": "A script is often written from its last show backwards: the facts it uses are filled in before it, one have at a time."
      }
    }
  ],
  "tasks": [
