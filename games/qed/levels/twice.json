{
  "title": { "en": "The same condition twice" },
  "tray": "proof",
  "intro": [
    {
      "t": {
        "en": "“it rains → (it rains → the ground is wet)” states the condition “it rains” twice. Surely once is enough."
      }
    }
  ],
  "tasks": [
    {
      "id": "twice",
      "kind": "proof",
      "tests": [{ "premises": { "p": "A → (A → B)" }, "goal": "A → B" }],
      "cases": [{ "A": "Rain", "B": "Wet" }, { "A": "Hungry", "B": "Eat" }],
      "hint": [
        { "en": "The goal is “if it rains, then …”." },
        { "en": "How many times can an assumption in a box be used?" }
      ],
      "solution": [
        "f = impI[A=A](body: m2) {",
        "  body {",
        "    m1 = mp(p, f.body)",
        "    m2 = mp(m1, f.body)",
        "  }",
        "}",
        "goal <- f"
      ],
      "naive": ["m = mp(p, p)", "goal <- m"]
    }
  ]
}
