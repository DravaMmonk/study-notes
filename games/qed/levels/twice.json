{
  "title": { "zh": "同一个条件说两遍" },
  "tray": "proof",
  "intro": [
    {
      "t": {
        "zh": "「下雨 → (下雨 → 地湿)」把条件「下雨」说了两遍。直觉上，说一遍就够了。"
      }
    }
  ],
  "builds": "merge",
  "tasks": [
    {
      "id": "twice",
      "kind": "proof",
      "tests": [{ "premises": { "p": "A → (A → B)" }, "goal": "A → B" }],
      "cases": [{ "A": "Rain", "B": "Wet" }, { "A": "Hungry", "B": "Eat" }],
      "hint": [
        { "zh": "目标是一句「若下雨，则…」。" },
        { "zh": "框里的一句假设能用几次？" }
      ],
      "solution": [
        "f = impI[A=A](body: m2) {",
        "  body {",
        "    m1 = mp(p, f.body)",
        "    m2 = mp(m1, f.body)",
        "  }",
        "}",
        "goal <- f"
      ],
      "naive": ["m = mp(p, p)", "goal <- m"]
    }
  ]
}
