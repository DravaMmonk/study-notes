{
  "title": { "zh": "怎样都对，怎样都错" },
  "tray": "gates",
  "intro": [
    {
      "t": {
        "zh": "<wiki-ref to=\"tautology\"></wiki-ref>在电路上是什么样子？接出这句话，看输出那一列。"
      }
    }
  ],
  "tasks": [
    {
      "id": "g-always_1",
      "kind": "gates",
      "step": { "zh": "怎样都对" },
      "target": "(Rain → Wet) ∨ (Wet → Rain)",
      "hideTarget": true,
      "brief": {
        "zh": "接一块电路，算出「（若下雨，则地湿）或者（若地湿，则下雨）」在每一行的真值。"
      },
      "hint": [{ "zh": "这句话由哪几部分组成？" }],
      "solution": ["i1 = gImp(Rain, Wet)", "i2 = gImp(Wet, Rain)", "o = gOr(i1, i2)", "out <- o"]
    },
    {
      "id": "g-always_2",
      "kind": "gates",
      "step": { "zh": "怎样都错" },
      "target": "(Rain → Wet) ∧ (Rain ∧ ¬Wet)",
      "hideTarget": true,
      "brief": {
        "zh": "接一块电路，算出「（若下雨，则地湿）并且（下雨，并且地不湿）」在每一行的真值。"
      },
      "hint": [
        {
          "zh": "它由两半用与门接成，右边一半本身也是一个「并且」。"
        }
      ],
      "intro": [
        {
          "t": {
            "zh": "每一行都为假的话叫<wiki-ref to=\"contradiction\"></wiki-ref>。"
          }
        }
      ],
      "solution": ["i = gImp(Rain, Wet)", "n = gNot(Wet)", "a1 = gAnd(Rain, n)", "a2 = gAnd(i, a1)", "out <- a2"]
    }
  ]
}
