{
  "title": { "en": "Case by case" },
  "tray": "machine",
  "intro": [
    {
      "t": {
        "en": "<part-ref to=\"lemma:erule\"></part-ref> takes apart more than “and”: any elimination rule can be chosen on it. Case analysis as a rule is ⟦?A ∨ ?B; ⟦?A⟧ ⟹ ?C; ⟦?B⟧ ⟹ ?C⟧ ⟹ ?C."
      }
    }
  ],
  "tasks": [
    {
      "id": "r-cases",
      "kind": "machine",
      "want": "proved",
      "inputs": [{ "name": "in", "label": { "en": "Goal" } }],
      "tests": [
        { "goal": "Wind ∨ Rain", "hyps": ["Rain ∨ Wind"] },
        { "goal": "Slip ∨ Wet", "hyps": ["Wet ∨ Slip"] },
        { "goal": "Bike ∨ Bus", "hyps": ["Bus ∨ Bike"] }
      ],
      "brief": { "en": "Design a proof assistant that proves every goal." },
      "hint": [
        { "en": "Take the “or” given apart first." },
        { "en": "In each case, which side of the goal is among the givens?" }
      ],
      "solution": [
        "c0r0 = orE()",
        "c1r0 = orI[use=[disjI2]]()",
        "c3r0 = orI[use=[disjI1]]()",
        "c0 = erule(in, c0r0)",
        "c1 = rule(c0, c1r0)",
        "c2 = assumption(c1)",
        "c3 = rule(c2, c3r0)",
        "c4 = assumption(c3)",
        "out <- c4"
      ]
    }
  ]
}
