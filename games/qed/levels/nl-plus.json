{
  "title": { "zh": "手算 1 + 1" },
  "tray": "proof",
  "intro": [
    {
      "t": {
        "zh": "<level-ref to=\"def-plus\"></level-ref>的两条等式 0 + y = y、S x + y = S (x + y)，在证明板上是两句「对所有」的已知。"
      }
    }
  ],
  "tasks": [
    {
      "id": "nl-plus",
      "kind": "proof",
      "consts": ["zero"],
      "words": ["everyday", "terms"],
      "cases": [],
      "tests": [
        {
          "premises": { "d0": "∀y. plus(zero, y) = y", "d1": "∀x. ∀y. plus(s(x), y) = s(plus(x, y))" },
          "goal": "plus(s(zero), s(zero)) = s(s(zero))"
        }
      ],
      "brief": { "zh": "从加法的两条定义证出 1 + 1 = 2。" },
      "hint": [
        {
          "zh": "先用<part-ref to=\"part:allE\"></part-ref>，把定义里的 x、y 换成具体的数。"
        },
        {
          "zh": "第二条定义给出 S (0 + S 0)；第一条算出 0 + S 0，再用等量代换换进去。"
        }
      ],
      "solution": [
        "e1 = allE[t=zero](d1)",
        "e3 = allE[t=\"s(zero)\"](d0)",
        "e2 = allE[t=\"s(zero)\"](e1)",
        "w = rewrite[at=[0]](e3, e2)",
        "goal <- w"
      ]
    }
  ]
}
