{
  "title": { "zh": "拿已知改写" },
  "adds": ["hyp"],
  "tray": "machine",
  "intro": [
    {
      "t": {
        "zh": "已知里的等式也能当改写规则，把左边换成右边。"
      }
    }
  ],
  "tasks": [
    {
      "id": "sp-hyp",
      "kind": "machine",
      "want": "proved",
      "inputs": [{ "name": "in", "label": { "zh": "目标" } }],
      "backtrack": true,
      "words": ["everyday", "terms"],
      "defs": ["plus", "app", "len"],
      "tests": [
        { "goal": "plus(a, zero) = a → plus(s(a), zero) = s(a)" },
        { "goal": "len(app(l, nil)) = len(l) → len(app(cons(i, l), nil)) = s(len(l))" }
      ],
      "brief": { "zh": "设计一个证明助手，证完每一个目标。" },
      "hint": [
        { "zh": "「若」的那一半要先进已知。" },
        { "zh": "化简的规则里有一条是「已知里的等式」。" }
      ],
      "solution": [
        "c0r0 = impI()",
        "c1r0 = math[use=[\"def.1\", \"def.3\", \"def.5\"]]()",
        "c2r0 = refl()",
        "c0 = rule(in, c0r0)",
        "c1r3 = hyp(c1r0)",
        "c1 = simp(c0, c1r3)",
        "c2 = rule(c1, c2r0)",
        "out <- c2"
      ]
    }
  ]
}
