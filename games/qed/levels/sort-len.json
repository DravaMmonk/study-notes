{
  "title": { "zh": "一个都不少" },
  "tray": "machine",
  "intro": [{ "t": { "zh": "排序前后，列表一样长。" } }],
  "after": {
    "zh": "程序和它的性质写在同一个系统里，一并证明：这叫<b>程序验证</b>。"
  },
  "tasks": [
    {
      "id": "sort-len",
      "kind": "machine",
      "want": "proved",
      "inputs": [{ "name": "in", "label": { "zh": "目标" } }],
      "backtrack": true,
      "words": ["everyday", "terms"],
      "types": ["list"],
      "defs": ["le", "if", "ins", "sort", "len"],
      "tests": [{ "goal": "∀xs. len(sort(xs)) = len(xs)" }],
      "brief": { "zh": "设计一个证明助手，证完每一个目标。" },
      "hint": [{ "zh": "化简卡在 len (ins x …) 上。" }],
      "solution": [
        "c0r0 = math[use=[\"list.induct\"]]()",
        "c0 = rule(in, c0r0)",
        "c1 = each(c0, body: c3) {",
        "  body {",
        "    c2r0 = math[use=[\"def.0\", \"def.1\", \"def.2\", \"def.3\", \"def.4\", \"def.5\", \"def.6\", \"def.7\", \"def.8\", \"def.9\", \"def.10\", insLen]]()",
        "    c3r0 = refl()",
        "    c2r12 = hyp(c2r0)",
        "    c2 = simp(c1.body, c2r12)",
        "    c3 = rule(c2, c3r0)",
        "  }",
        "}",
        "out <- c1"
      ],
      "naive": [
        "c0r0 = math[use=[\"list.induct\"]]()",
        "c0 = rule(in, c0r0)",
        "c1 = each(c0, body: c3) {",
        "  body {",
        "    c2r0 = math[use=[\"def.0\", \"def.1\", \"def.2\", \"def.3\", \"def.4\", \"def.5\", \"def.6\", \"def.7\", \"def.8\", \"def.9\", \"def.10\"]]()",
        "    c3r0 = refl()",
        "    c2r11 = hyp(c2r0)",
        "    c2 = simp(c1.body, c2r11)",
        "    c3 = rule(c2, c3r0)",
        "  }",
        "}",
        "out <- c1"
      ]
    }
  ]
}
