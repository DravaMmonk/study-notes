{
  "title": { "zh": "拼接也结合" },
  "tray": "machine",
  "tasks": [
    {
      "id": "in-appassoc",
      "kind": "machine",
      "want": "proved",
      "inputs": [{ "name": "in", "label": { "zh": "目标" } }],
      "backtrack": true,
      "words": ["everyday", "terms"],
      "types": ["list"],
      "defs": ["app", "len"],
      "tests": [{ "goal": "∀xs. ∀ys. ∀zs. app(app(xs, ys), zs) = app(xs, app(ys, zs))" }],
      "brief": { "zh": "设计一个证明助手，证完每一个目标。" },
      "hint": [{ "zh": "拼接的定义拆的是哪个列表？" }],
      "solution": [
        "c0r0 = math[use=[\"list.induct\"]]()",
        "c0 = rule(in, c0r0)",
        "c1 = each(c0, body: c5) {",
        "  body {",
        "    c2r0 = math[use=[\"def.0\", \"def.1\"]]()",
        "    c5r0 = refl()",
        "    c2r2 = hyp(c2r0)",
        "    c2 = simp(c1.body, c2r2)",
        "    c3 = repeat(c2, body: c4) {",
        "      body {",
        "        c4r0 = allI()",
        "        c4 = rule(c3.body, c4r0)",
        "      }",
        "    }",
        "    c5 = rule(c3, c5r0)",
        "  }",
        "}",
        "out <- c1"
      ]
    }
  ]
}
