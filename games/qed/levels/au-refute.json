{
  "adds": ["res"],
  "tray": "resolution",
  "title": { "en": "Down to the empty clause" },
  "intro": [
    {
      "t": {
        "en": "The empty clause has no literal in it, nothing that could be true: it is the contradiction ⊥."
      }
    }
  ],
  "tasks": [
    {
      "id": "au-refute_1",
      "kind": "proof",
      "step": { "en": "Two steps" },
      "tests": [{ "premises": { "p": "¬A ∨ B", "q": "A", "r": "¬B" }, "goal": "⊥" }],
      "cases": [{ "A": "Rain", "B": "Wet" }, { "A": "Alarm", "B": "Up" }],
      "briefNote": { "en": "With “Resolve” alone." },
      "hint": [{ "en": "“It rains” is itself a clause of one literal." }],
      "solution": ["r1 = res(q, p)", "r2 = res(r1, r)", "goal <- r2"]
    },
    {
      "id": "au-refute_2",
      "kind": "proof",
      "step": { "en": "Three steps" },
      "tests": [{ "premises": { "p": "A ∨ B", "q": "¬A ∨ C", "r": "¬B ∨ C", "s": "¬C" }, "goal": "⊥" }],
      "cases": [{ "A": "Bus", "B": "Bike", "C": "OnTime" }, { "A": "Coffee", "B": "Tea", "C": "Awake" }],
      "brief": {
        "en": "Now prove ⊥ from “I take the bus ∨ I cycle”, “¬I take the bus ∨ I arrive on time”, “¬I cycle ∨ I arrive on time” and “¬I arrive on time”."
      },
      "hint": [{ "en": "Two copies of the same literal merge into one." }],
      "solution": ["r1 = res(p, q)", "r2 = res(r1, r)", "r3 = res(r2, s)", "goal <- r3"]
    }
  ]
}
