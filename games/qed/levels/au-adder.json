{
  "title": { "zh": "半加器" },
  "tray": "machine",
  "intro": [
    {
      "t": {
        "zh": "一块电路可以写成几句等价，每根输出线对应它的输入：和位是「两个输入恰好一个是 1」，进位是「两个输入都是 1」。电路的性质，就是由这几句推得出的话。"
      }
    }
  ],
  "after": {
    "zh": "芯片设计里的<b>形式验证</b>，检查电路也是这个思路。"
  },
  "tasks": [
    {
      "id": "au-adder",
      "kind": "machine",
      "want": "proved",
      "inputs": [{ "name": "in", "label": { "zh": "目标" } }],
      "backtrack": true,
      "tests": [
        { "goal": "¬(Sum ∧ Carry)", "hyps": ["Sum ↔ (InA ∨ InB) ∧ ¬(InA ∧ InB)", "Carry ↔ InA ∧ InB"] },
        { "goal": "Carry → InA", "hyps": ["Sum ↔ (InA ∨ InB) ∧ ¬(InA ∧ InB)", "Carry ↔ InA ∧ InB"] },
        { "goal": "Sum → InA", "hyps": ["Sum ↔ (InA ∨ InB) ∧ ¬(InA ∧ InB)", "Carry ↔ InA ∧ InB"], "want": "fails" },
        { "goal": "InA ∧ InB → Carry ∧ ¬Sum", "hyps": ["Sum ↔ (InA ∨ InB) ∧ ¬(InA ∧ InB)", "Carry ↔ InA ∧ InB"] }
      ],
      "brief": {
        "zh": "设计一个证明助手：推得出的目标证出来，推不出的报告失败。"
      },
      "hint": [{ "zh": "<part-ref to=\"lemma:metis\"></part-ref>。" }],
      "solution": ["c0 = metis(in)", "out <- c0"]
    }
  ]
}
