{
  "title": { "zh": "重复里套着不行就换" },
  "tray": "machine",
  "intro": [
    {
      "t": {
        "zh": "这一回目标层层嵌套，「若…则…」和「并且」混在一起，次序各不相同。"
      }
    }
  ],
  "tasks": [
    {
      "id": "s-mix",
      "kind": "machine",
      "want": "proved",
      "inputs": [{ "name": "in", "label": { "zh": "目标" } }],
      "tests": [
        { "goal": "Rain → (Wind → Rain ∧ Wind)" },
        { "goal": "(Rain → Rain) ∧ (Wind → (Rain → Wind))" },
        { "goal": "Rain → (Wind → Wind ∧ (Rain ∧ Wind))" }
      ],
      "brief": { "zh": "设计一个证明助手，证完每一个目标。" },
      "hint": [
        { "zh": "每一圈要应付哪几种目标？" },
        {
          "zh": "<part-ref to=\"part:append\"></part-ref>上可以选三个框。"
        }
      ],
      "solution": [
        "c0 = repeat(in, body: c1) {",
        "  body {",
        "    c1 = append[ways=\"3\"](c0.body, first: c2, second: c3, third: c4) {",
        "      first {",
        "        c2 = assumption(c1.first)",
        "      }",
        "      second {",
        "        c3r0 = impI()",
        "        c3 = rule(c1.second, c3r0)",
        "      }",
        "      third {",
        "        c4r0 = andI()",
        "        c4 = rule(c1.third, c4r0)",
        "      }",
        "    }",
        "  }",
        "}",
        "out <- c0"
      ]
    }
  ]
}
