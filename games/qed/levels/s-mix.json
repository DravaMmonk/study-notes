{
  "title": { "en": "Or else, repeated" },
  "tray": "machine",
  "intro": [
    {
      "t": {
        "en": "This time goals nest level within level, “if … then …” and “and” mixed, in a different order each time."
      }
    }
  ],
  "tasks": [
    {
      "id": "s-mix",
      "kind": "machine",
      "want": "proved",
      "inputs": [{ "name": "in", "label": { "en": "Goal" } }],
      "tests": [
        { "goal": "Rain → (Wind → Rain ∧ Wind)" },
        { "goal": "(Rain → Rain) ∧ (Wind → (Rain → Wind))" },
        { "goal": "Rain → (Wind → Wind ∧ (Rain ∧ Wind))" }
      ],
      "brief": { "en": "Design a proof assistant that proves every goal." },
      "hint": [
        { "en": "What kinds of goal must each round handle?" },
        {
          "en": "<part-ref to=\"part:append\"></part-ref> can be set to three regions."
        }
      ],
      "solution": [
        "c0 = repeat(in, body: c1) {",
        "  body {",
        "    c1 = append[ways=\"3\"](c0.body, first: c2, second: c3, third: c4) {",
        "      first {",
        "        c2 = assumption(c1.first)",
        "      }",
        "      second {",
        "        c3r0 = impI()",
        "        c3 = rule(c1.second, c3r0)",
        "      }",
        "      third {",
        "        c4r0 = andI()",
        "        c4 = rule(c1.third, c4r0)",
        "      }",
        "    }",
        "  }",
        "}",
        "out <- c0"
      ]
    }
  ]
}
