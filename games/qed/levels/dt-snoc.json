{
  "title": { "zh": "接在后面" },
  "consts": ["zero", "m"],
  "intro": [
    {
      "t": {
        "zh": "snoc 在向量后面接上一个，长度是 x + 1。用它从长 m 的向量造出长 S m 的。"
      }
    }
  ],
  "after": {
    "zh": "在证明助手里写依赖类型的程序，常常是程序本身很短，让类型对上要靠一串等式。"
  },
  "tasks": [
    {
      "id": "dt-snoc_1",
      "kind": "term",
      "step": { "zh": "第一题" },
      "brief": { "zh": "用下面的块，拼出这句话的证明项。" },
      "forms": ["fun", "app", "pair", "fst", "snd", "inl", "inr", "elim", "absurd", "open", "rfl", "subst"],
      "words": ["everyday", "terms", "stars", "vectors"],
      "premises": {
        "v": "Vec(m)",
        "snoc": "∀x. Vec(x) → Vec(plus(x, s(zero)))",
        "addZero": "∀x. plus(x, zero) = x",
        "addSucc": "∀x. ∀y. plus(x, s(y)) = s(plus(x, y))"
      },
      "goal": "Vec(s(m))",
      "defs": ["plus"],
      "answer": "addZero m ▸ addSucc m zero ▸ snoc v",
      "naive": "addSucc m zero ▸ snoc v",
      "hint": [
        { "zh": "snoc v 长 m + 1，也就是 m + S 0。要的是 S m。" },
        {
          "zh": "addSucc m 0 把 m + S 0 换成 S (m + 0)；还剩一步。"
        }
      ]
    }
  ]
}
