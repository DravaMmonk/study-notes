{
  "title": { "zh": "一句里套着一句" },
  "tray": "proof",
  "intro": [
    {
      "t": {
        "zh": "一条条件命题的结论也可以是另一条条件命题。例如，「若今天是周六，则（若下雨，则我休息）」说的是：在今天是周六的条件下，「若下雨，则我休息」成立。"
      }
    },
    {
      "t": {
        "zh": "括号表明哪些话属于同一层。一次套用得到的结论可以是一整条条件命题；这条命题也能像其他已知一样，作为之后推理的前提。"
      }
    }
  ],
  "tasks": [
    {
      "id": "nested_1",
      "kind": "proof",
      "step": { "zh": "一句里套着一句" },
      "tests": [{ "premises": { "p": "A", "q": "A → (B → C)", "r": "B" }, "goal": "C" }],
      "cases": [{ "A": "Sat", "B": "Rain", "C": "Rest" }, { "A": "Exam", "B": "Study", "C": "Pass" }],
      "hint": [{ "zh": "套用的结果本身也可以是一句「若…则…」。" }],
      "solution": ["m1 = mp(q, p)", "m2 = mp(m1, r)", "goal <- m2"]
    },
    {
      "id": "nested_2",
      "kind": "proof",
      "step": { "zh": "推出来的规则" },
      "tests": [{ "premises": { "p": "A", "q": "A → (B → C)", "r": "(B → C) → D" }, "goal": "D" }],
      "cases": [
        { "A": "Sat", "B": "Rain", "C": "Rest", "D": "Happy" },
        { "A": "Alarm", "B": "Coffee", "C": "Awake", "D": "OnTime" }
      ],
      "hint": [{ "zh": "最后一句已知的前件是什么？" }],
      "solution": ["m1 = mp(q, p)", "m2 = mp(r, m1)", "goal <- m2"]
    }
  ]
}
