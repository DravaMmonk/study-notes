{
  "title": { "zh": "三个人说话" },
  "tray": "gates",
  "intro": [{ "t": { "zh": "三个人，表有八行。" } }],
  "after": {
    "zh": "找一行使几句话同时为真，这类问题叫<wiki-ref to=\"satisfiable\"></wiki-ref>问题（SAT）。"
  },
  "tasks": [
    {
      "id": "e-three",
      "kind": "gates",
      "target": "(KA ↔ ¬KB) ∧ (KB ↔ ¬KC) ∧ (KC ↔ ¬KA ∧ ¬KB)",
      "blind": true,
      "brief": {
        "zh": "a 说：「b 是无赖。」b 说：「c 是无赖。」c 说：「a 和 b 都是无赖。」把三人的话译成逻辑，接成电路：三人的话都和身份相符的行，输出真。"
      },
      "hint": [
        { "zh": "c 的话里，否定管的是哪一部分？" },
        { "zh": "三个人的话各译一句，三句要同时成立。" }
      ],
      "solution": [
        "na = gNot(KA)",
        "nb = gNot(KB)",
        "nc = gNot(KC)",
        "e1 = gIff(KA, nb)",
        "e2 = gIff(KB, nc)",
        "c = gAnd(na, nb)",
        "e3 = gIff(KC, c)",
        "b12 = gAnd(e1, e2)",
        "all = gAnd(b12, e3)",
        "out <- all"
      ]
    }
  ]
}
