{
  "title": { "zh": "改到改不动" },
  "tray": "machine",
  "intro": [
    {
      "t": {
        "zh": "这一回，各个目标里 ¬¬ 的个数不一样。改写对不上任何地方时，就失败。"
      }
    }
  ],
  "tasks": [
    {
      "id": "sp-repeat",
      "kind": "machine",
      "want": "becomes",
      "inputs": [{ "name": "in", "label": { "zh": "目标" } }],
      "backtrack": true,
      "tests": [
        { "goal": "¬¬Rain", "becomes": [["Rain"]] },
        { "goal": "¬¬Rain ∧ ¬¬Wind", "becomes": [["Rain ∧ Wind"]] },
        { "goal": "¬¬(¬¬Rain ∨ ¬¬¬¬Wind)", "becomes": [["Rain ∨ Wind"]] }
      ],
      "brief": { "zh": "设计一个证明助手，把每个目标变成要的样子。" },
      "hint": [{ "zh": "改写的次数要随目标而变。" }],
      "solution": [
        "c0 = repeat(in, body: c1) {",
        "  body {",
        "    c1r0 = dneg[use=[\"dneg.elim\"]]()",
        "    c1 = rw(c0.body, c1r0)",
        "  }",
        "}",
        "out <- c0"
      ],
      "naive": [
        "c0r0 = dneg[use=[\"dneg.elim\"]]()",
        "c1r0 = dneg[use=[\"dneg.elim\"]]()",
        "c0 = rw(in, c0r0)",
        "c1 = rw(c0, c1r0)",
        "out <- c1"
      ]
    }
  ]
}
