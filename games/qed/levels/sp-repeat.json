{
  "title": { "en": "Until nothing fits" },
  "tray": "machine",
  "intro": [
    {
      "t": {
        "en": "This time the goals hold different numbers of ¬¬s. A rewrite that fits nowhere fails."
      }
    }
  ],
  "tasks": [
    {
      "id": "sp-repeat",
      "kind": "machine",
      "want": "becomes",
      "inputs": [{ "name": "in", "label": { "en": "Goal" } }],
      "backtrack": true,
      "tests": [
        { "goal": "¬¬Rain", "becomes": [["Rain"]] },
        { "goal": "¬¬Rain ∧ ¬¬Wind", "becomes": [["Rain ∧ Wind"]] },
        { "goal": "¬¬(¬¬Rain ∨ ¬¬¬¬Wind)", "becomes": [["Rain ∨ Wind"]] }
      ],
      "brief": { "en": "Design a proof assistant that transforms each goal into the required form." },
      "hint": [{ "en": "The number of rewrites must depend on the goal." }],
      "solution": [
        "c0 = repeat(in, body: c1) {",
        "  body {",
        "    c1r0 = dneg[use=[\"dneg.elim\"]]()",
        "    c1 = rw(c0.body, c1r0)",
        "  }",
        "}",
        "out <- c0"
      ],
      "naive": [
        "c0r0 = dneg[use=[\"dneg.elim\"]]()",
        "c1r0 = dneg[use=[\"dneg.elim\"]]()",
        "c0 = rw(in, c0r0)",
        "c1 = rw(c0, c1r0)",
        "out <- c1"
      ]
    }
  ]
}
