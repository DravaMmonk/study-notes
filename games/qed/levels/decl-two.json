{
  "title": { "en": "At least two" },
  "intro": [
    {
      "t": {
        "en": "What is declared need not be a connective: whatever holds in ways that can be spelled out can be declared."
      }
    },
    {
      "t": {
        "en": "The declaration of “the motion passes” on the board does not meet the requirement. Write a test case for each direction, introduction and use, to find its fault."
      }
    }
  ],
  "after": {
    "en": "“Exactly one agrees” cannot be declared, though: an introduction rule can say what makes a sentence, never what stops it."
  },
  "tasks": [
    {
      "id": "decl-two",
      "kind": "iso",
      "declare": { "en": "the motion passes" },
      "target": "Motion",
      "sentences": ["AnnYes", "BoYes", "CyYes"],
      "tests": [
        { "given": ["AnnYes", "BoYes"], "make": true },
        { "given": ["BoYes", "CyYes"], "make": true },
        { "given": ["AnnYes", "CyYes"], "make": true },
        { "given": ["AnnYes", "BoYes", "CyYes"], "make": true },
        { "given": ["AnnYes"], "make": false },
        { "given": ["CyYes"], "make": false },
        { "given": ["Motion"], "goal": "AnnYes", "make": false },
        { "given": ["Motion", "AnnYes → Happy", "BoYes → Happy"], "goal": "Happy", "make": true },
        { "given": ["Motion", "AnnYes → Happy"], "goal": "Happy", "make": false },
        { "given": ["Motion", "BoYes → Happy"], "goal": "Happy", "make": false }
      ],
      "play": "audit",
      "want": "expose",
      "boards": [{ "rules": [{ "binds": [], "needs": ["AnnYes", "BoYes"] }, { "binds": [], "needs": ["BoYes", "CyYes"] }] }],
      "slots": [
        { "make": true, "fixed": ["goal", "make"] },
        { "given": ["Motion"], "keep": ["Motion"], "make": false, "fixed": ["make"] }
      ],
      "answer": [
        { "given": ["AnnYes", "CyYes"], "make": true },
        { "given": ["Motion", "BoYes → Happy"], "goal": "Happy", "make": false }
      ],
      "naive": [
        { "given": ["AnnYes", "BoYes"], "make": true },
        { "given": ["Motion", "AnnYes → Happy"], "goal": "Happy", "make": false }
      ],
      "brief": {
        "en": "Requirement: Ann, Bo and Cy vote; “the motion passes” may be introduced only when at least two of them agree. Write two test cases whose expectations meet the requirement and with which this declaration’s results both disagree."
      },
      "hint": [
        { "en": "How many pairs can agree? Which does this declaration write out?" },
        { "en": "Who is in every one of this declaration’s introduction rules?" }
      ],
      "solution": [
        { "binds": [], "needs": ["AnnYes", "BoYes"] },
        { "binds": [], "needs": ["BoYes", "CyYes"] },
        { "binds": [], "needs": ["AnnYes", "CyYes"] }
      ]
    }
  ]
}
