{
  "title": { "zh": "蕴涵析取互化" },
  "tray": "proof",
  "builds": "arrow",
  "intro": [
    {
      "t": {
        "zh": "「下雨，地就湿」和「没下雨，或者地湿」是一回事：两句都只在下雨而地不湿的那一行为假。"
      }
    }
  ],
  "tasks": [
    {
      "id": "c-arrow_1",
      "kind": "proof",
      "step": { "zh": "箭头变成或者" },
      "tests": [{ "premises": { "p": "A → B" }, "goal": "¬A ∨ B" }],
      "cases": [{ "A": "Rain", "B": "Wet" }, { "A": "Alarm", "B": "Up" }],
      "hint": [{ "zh": "已知没说下不下雨。" }],
      "solution": [
        "l = lem[A=A]()",
        "e = orE(l, left: i1, right: i2) {",
        "  left {",
        "    m = mp(p, e.left)",
        "    i1 = orI[other=\"~A\", side=left](m)",
        "  }",
        "  right {",
        "    i2 = orI[other=B, side=right](e.right)",
        "  }",
        "}",
        "goal <- e"
      ]
    },
    {
      "id": "c-arrow_2",
      "kind": "proof",
      "step": { "zh": "或者变回箭头" },
      "tests": [{ "premises": { "p": "¬A ∨ B" }, "goal": "A → B" }],
      "cases": [{ "A": "Rain", "B": "Wet" }, { "A": "Alarm", "B": "Up" }],
      "hint": [
        { "zh": "先假设「下雨」，再对已知分情况。" },
        {
          "zh": "「¬下雨」那种情况和假设矛盾；矛盾推出一切。"
        }
      ],
      "solution": [
        "f = impI[A=A](body: e) {",
        "  body {",
        "    e = orE(p, left: b, right: e.right) {",
        "      left {",
        "        m = mp(e.left, f.body)",
        "        b = botE[C=B](m)",
        "      }",
        "    }",
        "  }",
        "}",
        "goal <- f"
      ]
    }
  ]
}
