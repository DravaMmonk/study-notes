{
  "title": { "en": "Arrow away" },
  "tray": "proof",
  "intro": [
    {
      "t": {
        "en": "“If it rains, the ground is wet” and “it does not rain, or the ground is wet” say the same: each is false only on the row where it rains and the ground is dry."
      }
    }
  ],
  "tasks": [
    {
      "id": "c-arrow_1",
      "kind": "proof",
      "step": { "en": "Arrow to or" },
      "tests": [{ "premises": { "p": "A → B" }, "goal": "¬A ∨ B" }],
      "cases": [{ "A": "Rain", "B": "Wet" }, { "A": "Alarm", "B": "Up" }],
      "hint": [{ "en": "The given does not say whether it rains." }],
      "solution": [
        "l = lem[A=A]()",
        "e = orE(l, left: i1, right: i2) {",
        "  left {",
        "    m = mp(p, e.left)",
        "    i1 = orI[other=\"~A\", side=left](m)",
        "  }",
        "  right {",
        "    i2 = orI[other=B, side=right](e.right)",
        "  }",
        "}",
        "goal <- e"
      ]
    },
    {
      "id": "c-arrow_2",
      "kind": "proof",
      "step": { "en": "Or back to an arrow" },
      "tests": [{ "premises": { "p": "¬A ∨ B" }, "goal": "A → B" }],
      "cases": [{ "A": "Rain", "B": "Wet" }, { "A": "Alarm", "B": "Up" }],
      "hint": [
        { "en": "Assume “it rains” first, then take cases on the given." },
        {
          "en": "The “¬it rains” case contradicts the assumption, and a contradiction gives anything."
        }
      ],
      "solution": [
        "f = impI[A=A](body: e) {",
        "  body {",
        "    e = orE(p, left: b, right: e.right) {",
        "      left {",
        "        m = mp(e.left, f.body)",
        "        b = botE[C=B](m)",
        "      }",
        "    }",
        "  }",
        "}",
        "goal <- f"
      ]
    }
  ]
}
