{
  "title": {
    "zh": "看不见的手"
  },
  "intro": [
    {
      "t": {
        "zh": "现在把调价器放到街上。街上的需求它一个数也读不到，每天只看得到昨天的价格、剩下的和没买到的。"
      }
    }
  ],
  "after": {
    "zh": "没有人告诉它出清价格是多少，它一天天调，自己走到了那里；行情变了，它又跟过去。这种一步步试出来的办法叫<wiki-ref to=\"tatonnement\"></wiki-ref>。"
  },
  "tasks": [
    {
      "id": "street",
      "brief": {
        "zh": "每条街开张 30 天。最后一天，剩下的和没买到的都要不到 1。"
      },
      "inputs": [
        {
          "name": "was",
          "label": {
            "zh": "昨天的价格"
          }
        },
        {
          "name": "left",
          "label": {
            "zh": "剩下"
          }
        },
        {
          "name": "short",
          "label": {
            "zh": "没买到"
          }
        }
      ],
      "outputs": [
        {
          "name": "price",
          "label": {
            "zh": "价格"
          },
          "view": "dots"
        }
      ],
      "tests": [
        {
          "shops": [
            {
              "stock": 20,
              "top": 60,
              "slope": 2,
              "open": 10
            }
          ],
          "ticks": 30
        },
        {
          "shops": [
            {
              "stock": 15,
              "top": 105,
              "slope": 3,
              "open": 10
            }
          ],
          "ticks": 30
        },
        {
          "shops": [
            {
              "stock": 12,
              "top": 40,
              "slope": 4,
              "open": 10
            }
          ],
          "ticks": 30
        }
      ],
      "hidden": [
        {
          "shops": [
            {
              "stock": 20,
              "top": 47,
              "slope": 2,
              "open": 10
            }
          ],
          "ticks": 30
        },
        {
          "shops": [
            {
              "stock": 30,
              "top": 78,
              "slope": 4,
              "open": 10
            }
          ],
          "ticks": 30
        },
        {
          "shops": [
            {
              "stock": 10,
              "top": 60,
              "slope": 1,
              "open": 10
            }
          ],
          "ticks": 60
        }
      ],
      "solution": [
        "a = pricer(was, left, short)",
        "price <- a"
      ],
      "naive": [
        "price <- was"
      ]
    },
    {
      "id": "shift",
      "brief": {
        "zh": "两家店各定各的价，行情中途会变。60 天后，两家都要出清。"
      },
      "inputs": [
        {
          "name": "was1",
          "label": {
            "zh": "甲店昨天的价格"
          }
        },
        {
          "name": "left1",
          "label": {
            "zh": "甲店剩下"
          }
        },
        {
          "name": "short1",
          "label": {
            "zh": "甲店没买到"
          }
        },
        {
          "name": "was2",
          "label": {
            "zh": "乙店昨天的价格"
          }
        },
        {
          "name": "left2",
          "label": {
            "zh": "乙店剩下"
          }
        },
        {
          "name": "short2",
          "label": {
            "zh": "乙店没买到"
          }
        }
      ],
      "outputs": [
        {
          "name": "price1",
          "label": {
            "zh": "甲店价格"
          },
          "view": "dots"
        },
        {
          "name": "price2",
          "label": {
            "zh": "乙店价格"
          },
          "view": "dots"
        }
      ],
      "tests": [
        {
          "shops": [
            {
              "stock": 20,
              "top": 60,
              "slope": 2,
              "open": 10,
              "shifts": [
                {
                  "at": 20,
                  "top": 80
                }
              ]
            },
            {
              "stock": 15,
              "top": 105,
              "slope": 3,
              "open": 10,
              "shifts": [
                {
                  "at": 30,
                  "top": 75
                }
              ]
            }
          ],
          "ticks": 60
        }
      ],
      "hidden": [
        {
          "shops": [
            {
              "stock": 30,
              "top": 78,
              "slope": 4,
              "open": 10,
              "shifts": [
                {
                  "at": 15,
                  "top": 110
                }
              ]
            },
            {
              "stock": 10,
              "top": 60,
              "slope": 1,
              "open": 10,
              "shifts": [
                {
                  "at": 25,
                  "top": 40
                }
              ]
            }
          ],
          "ticks": 60
        }
      ],
      "solution": [
        "a = pricer(was1, left1, short1)",
        "b = pricer(was2, left2, short2)",
        "price1 <- a",
        "price2 <- b"
      ],
      "naive": [
        "price1 <- was1",
        "price2 <- was2"
      ]
    }
  ]
}
