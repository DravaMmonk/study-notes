{
  "parts": {
    "demand": { "name": { "zh": "需求" }, "desc": { "zh": "按价格给出想买的人数。" }, "inside": [{ "task": "want" }] },
    "pricer": {
      "name": { "zh": "调价器" },
      "desc": { "zh": "按昨天剩下的和没买到的调整价格。" },
      "inside": [{ "task": "adjust" }]
    },
    "const": {
      "name": { "zh": "常数" },
      "desc": { "zh": "每一拍都给出设定的数。" },
      "icon": "Hash",
      "family": "value",
      "inputs": [],
      "settings": [{ "key": "value", "control": "number", "label": { "zh": "数值" }, "default": 0 }],
      "compute": "$value"
    },
    "add": {
      "name": { "zh": "加" },
      "desc": { "zh": "给出 a + b。" },
      "icon": "Plus",
      "family": "value",
      "inputs": [{ "name": "a" }, { "name": "b" }],
      "compute": "add(a, b)"
    },
    "sub": {
      "name": { "zh": "减" },
      "desc": { "zh": "给出 a − b。" },
      "icon": "Minus",
      "family": "value",
      "inputs": [{ "name": "a" }, { "name": "b" }],
      "compute": "sub(a, b)"
    },
    "mul": {
      "name": { "zh": "乘" },
      "desc": { "zh": "给出 a × b。" },
      "icon": "X",
      "family": "value",
      "inputs": [{ "name": "a" }, { "name": "b" }],
      "compute": "mul(a, b)"
    },
    "div": {
      "name": { "zh": "除" },
      "desc": { "zh": "给出 a ÷ b；b 为 0 时给出「—」。" },
      "icon": "Divide",
      "family": "value",
      "inputs": [{ "name": "a" }, { "name": "b" }],
      "compute": "div(a, b)"
    },
    "min": {
      "name": { "zh": "取小" },
      "desc": { "zh": "给出 a 和 b 里小的那个。" },
      "icon": "ArrowDownNarrowWide",
      "family": "value",
      "inputs": [{ "name": "a" }, { "name": "b" }],
      "compute": "min(a, b)"
    }
  }
}
