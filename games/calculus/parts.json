{
  "parts": {
    "count": {
      "name": { "zh": "下标 n" },
      "desc": { "zh": "交出这一拍是第几项：0, 1, 2, …" },
      "inside": [{ "task": "count" }]
    },
    "sum": { "name": { "zh": "累加 Σ" }, "desc": { "zh": "交出输入到这一拍为止所有项的和。" }, "inside": [{ "task": "sum" }] },
    "diff": {
      "name": { "zh": "差分 Δ" },
      "desc": { "zh": "交出输入这一项减上一项；第一拍减 0。" },
      "inside": [{ "task": "diff" }]
    },
    "max": { "name": { "zh": "较大者" }, "desc": { "zh": "交出 a、b 里大的那个。" }, "inside": [{ "task": "max" }] },
    "dist": { "name": { "zh": "距离" }, "desc": { "zh": "交出 |a − b|。" }, "inside": [{ "task": "dist" }] },
    "near": {
      "name": { "zh": "邻域" },
      "desc": { "zh": "aₙ 离 L 不到 ε 时为 1，否则为 0。" },
      "inside": [{ "task": "near" }]
    },
    "since": {
      "name": { "zh": "从此一直" },
      "desc": { "zh": "输入最近一段连续为 1 从第几项起；这一拍为 0 时给 n + 1。" },
      "inside": [{ "task": "since" }]
    },
    "add": {
      "name": { "zh": "加" },
      "desc": { "zh": "给出 a + b。" },
      "icon": "Plus",
      "family": "value",
      "inputs": [{ "name": "a" }, { "name": "b" }],
      "compute": "add(a, b)"
    },
    "mul": {
      "name": { "zh": "乘" },
      "desc": { "zh": "给出 a × b。" },
      "icon": "X",
      "family": "value",
      "inputs": [{ "name": "a" }, { "name": "b" }],
      "compute": "mul(a, b)"
    },
    "recip": {
      "name": { "zh": "倒数" },
      "desc": { "zh": "给出 1/a；a 为 0 时没有值。" },
      "icon": "Divide",
      "family": "value",
      "inputs": [{ "name": "a" }],
      "compute": "recip(a)"
    },
    "less": {
      "name": { "zh": "比较" },
      "desc": { "zh": "a 小于 b 时给出 1，否则给出 0。" },
      "icon": "ChevronLeft",
      "family": "value",
      "inputs": [{ "name": "a" }, { "name": "b" }],
      "compute": "less(a, b)"
    },
    "const": {
      "name": { "zh": "常数" },
      "desc": { "zh": "每一拍都给出设定的数。" },
      "icon": "Hash",
      "family": "value",
      "inputs": [],
      "settings": [{ "key": "value", "control": "number", "label": { "zh": "数值" }, "default": 0 }],
      "compute": "$value"
    },
    "reg": {
      "name": { "zh": "读寄存卡" },
      "desc": { "zh": "给出同名寄存卡中存的值；尚未存入时，给出初值。" },
      "icon": "ArrowUpFromLine",
      "family": "memory",
      "inputs": [],
      "settings": [
        {
          "key": "reg",
          "control": "select",
          "label": { "zh": "名字" },
          "options": [{ "value": "A" }, { "value": "B" }, { "value": "C" }, { "value": "D" }],
          "default": "A"
        },
        { "key": "start", "control": "number", "label": { "zh": "初值" }, "default": 0, "optional": true }
      ],
      "compute": "held($reg, $start)"
    },
    "keep": {
      "name": { "zh": "存寄存卡" },
      "desc": { "zh": "把接入的值存进同名寄存卡，从下一拍起可以读出。" },
      "icon": "ArrowDownToLine",
      "family": "memory",
      "inputs": [{ "name": "in" }],
      "settings": [
        {
          "key": "reg",
          "control": "select",
          "label": { "zh": "名字" },
          "options": [{ "value": "A" }, { "value": "B" }, { "value": "C" }, { "value": "D" }],
          "default": "A"
        }
      ],
      "keeps": { "input": "in", "register": "reg" }
    }
  }
}
