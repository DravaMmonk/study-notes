{
  "title": { "zh": "两侧偏差" },
  "intro": [{ "t": { "zh": "只查 f(a+h) 可能把台阶函数在 0 左侧的跳变漏掉。给你左、中、右三个函数值，把偏离中心最远的一侧报出来。" } }],
  "after": { "zh": "<wiki-ref to=\"continuity-gap\"></wiki-ref>取两侧距离的较大者；它为 0 才表示这次取样的两侧都与中心一样。" },
  "builds": { "type": "gap", "name": { "zh": "两侧偏差" }, "desc": { "zh": "左右函数值距中心值的较大距离。" } },
  "tasks": [
    {
      "id": "gap",
      "brief": { "zh": "输入左、中、右三个函数值，交出左右距中心的较大距离。" },
      "inputs": [{ "name": "l", "label": "左" }, { "name": "c", "label": "中" }, { "name": "r", "label": "右" }],
      "outputs": [{ "name": "g", "label": "偏差" }],
      "tests": [
        {
          "inputs": { "l": [0, 0.25, 0.5625, 0.765625], "c": [0, 0, 0, 0], "r": [1, 0.25, 0.0625, 0.015625] },
          "want": { "g": [1, 0.25, 0.5625, 0.765625] }
        },
        { "inputs": { "l": [0, 0, 0, 0], "c": [1, 1, 1, 1], "r": [1, 1, 1, 1] }, "want": { "g": [1, 1, 1, 1] } }
      ],
      "hidden": [
        {
          "inputs": { "l": [3, -2, 0, 9, 4], "c": [0, -1, 0, 2, 4], "r": [-2, 3, 1, -1, 4] },
          "want": { "g": [3, 4, 1, 7, 0] }
        }
      ],
      "solution": ["dl = dist(l, c)", "dr = dist(r, c)", "m = max(dl, dr)", "g <- m"],
      "naive": ["d = dist(r, c)", "g <- d"]
    }
  ]
}
