{
  "title": { "zh": "翻倍的差分", "en": "Differences of doubling" },
  "intro": [
    {
      "t": {
        "zh": "平方数越差越平。翻倍的数列呢？",
        "en": "The squares flatten as they are differenced. What about a doubling sequence?"
      }
    }
  ],
  "after": {
    "zh": "平方数差两次就平了；1, 2, 4, 8, … 却怎么差分都平不下来。",
    "en": "The squares flatten after two differences; 1, 2, 4, 8, … never flattens, however often it is differenced."
  },
  "tasks": [
    {
      "id": "ddouble",
      "brief": { "zh": "交出 1, 2, 4, 8, … 的差分。", "en": "Give the differences of 1, 2, 4, 8, …" },
      "outputs": [{ "name": "d", "label": "Δ(2ⁿ)" }],
      "tests": [{ "want": { "d": [1, 1, 2, 4, 8, 16, 32, 64] } }],
      "hidden": [{ "want": { "d": [1, 1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024] } }],
      "solution": [
        "r = reg[reg=A, start=1]()",
        "c = const[value=2]()",
        "m = mul(r, c)",
        "k = keep[reg=A](m)",
        "e = diff(r)",
        "d <- e"
      ]
    }
  ]
}
