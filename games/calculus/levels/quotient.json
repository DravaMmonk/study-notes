{
  "title": { "zh": "两点的斜率" },
  "intro": [
    { "t": { "zh": "取样机能给出两点的函数值，但只看差值会把横轴距离漏掉。函数值升高 8，若横轴走了 2，平均每单位升高 4。" } },
    { "t": { "zh": "接出 (f(a+h)−f(a))/h。h 可以为负，但不能为 0；这块板将留作后面不同函数的差商器。" } }
  ],
  "after": { "zh": "<wiki-ref to=\"secant\"></wiki-ref>给两点之间的平均斜率。只有继续让非零 h 趋近 0，才会问一点上的导数。" },
  "builds": { "type": "quotient", "name": { "zh": "差商器" }, "desc": { "zh": "由两点的函数值与非零步长算割线斜率。" } },
  "tasks": [
    {
      "id": "quotient",
      "brief": { "zh": "输入 u=f(a)、v=f(a+h) 和非零 h，交出 q=(v−u)/h。" },
      "inputs": [
        { "name": "u", "label": "f(a)" },
        { "name": "v", "label": "f(a+h)" },
        { "name": "h", "label": "h" }
      ],
      "outputs": [{ "name": "q", "label": "q" }],
      "tests": [
        {
          "inputs": { "u": [1, 4, 5, -2, 10], "v": [9, 1, 3, 4, 12], "h": [2, -1, 0.5, -3, 0.25] },
          "want": { "q": [4, 3, -4, -2, 8] }
        }
      ],
      "hidden": [
        {
          "inputs": { "u": [-3, 12, 0, 9], "v": [5, -4, -7, 9.25], "h": [-4, 2, -0.125, 0.5] },
          "want": { "q": [-2, -8, 56, 0.5] }
        }
      ],
      "solution": [
        "neg = const[value=-1]()",
        "minus = mul(u, neg)",
        "diff = add(v, minus)",
        "inv = recip(h)",
        "rate = mul(diff, inv)",
        "q <- rate"
      ],
      "naive": ["q <- v"]
    }
  ]
}
