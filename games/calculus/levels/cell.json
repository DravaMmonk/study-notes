{
  "title": { "zh": "一格的面积" },
  "intro": [
    { "t": { "zh": "斜率把高度差除以横轴距离。面积反过来：把一格的高度 y 乘宽度 h，得到这一格的贡献。" } },
    { "t": { "zh": "高度在横轴下方是负数；h 为负意味着沿横轴反向走。两种情况都保留符号，后面累加才会相互抵消。" } }
  ],
  "after": { "zh": "<wiki-ref to=\"signed-cell\"></wiki-ref>为 yh。它记录有向贡献；取绝对值会丢掉方向。" },
  "builds": { "type": "cell", "name": { "zh": "小格" }, "desc": { "zh": "高度乘有向宽度，得到一格的贡献。" } },
  "tasks": [
    {
      "id": "cell",
      "brief": { "zh": "给高度 y 和有向宽度 h，交出 A=yh。" },
      "inputs": [{ "name": "y", "label": "y" }, { "name": "h", "label": "h" }],
      "outputs": [{ "name": "A", "label": "A" }],
      "tests": [
        {
          "inputs": { "y": [2, -3, 4, -2, 0], "h": [0.5, 0.25, -0.5, -1, 2] },
          "want": { "A": [1, -0.75, -2, 2, 0] }
        }
      ],
      "hidden": [
        {
          "inputs": { "y": [1.5, -0.25, 10, -7], "h": [-2, -0.125, 0.0625, 0.5] },
          "want": { "A": [-3, 0.03125, 0.625, -3.5] }
        }
      ],
      "solution": ["area = mul(y, h)", "A <- area"],
      "naive": ["A <- y"]
    }
  ]
}
