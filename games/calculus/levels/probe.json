            "h": [1, 0.5, 0.25, 0.125, 0.0625, 0.03125, 0.015625, 0.0078125],
            "e": [0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5]
          },
          "want": { "g": [1, 1, 1, 1, 1, 1, 1, 1], "N": [1, 2, 3, 4, 5, 6, 7, 8] }
        },
        {
          "inputs": {
            "a": [1, 1, 1, 1, 1, 1, 1, 1],
            "h": [1, 0.5, 0.25, 0.125, 0.0625, 0.03125, 0.015625, 0.0078125],
            "e": [0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5]
          },
          "want": { "g": [0, 0, 0, 0, 0, 0, 0, 0], "N": [0, 0, 0, 0, 0, 0, 0, 0] }
        }
      ],
      "hidden": [
        {
          "inputs": {
            "a": [-1, -1, -1, -1, -1, -1, -1, -1],
            "h": [1, 0.5, 0.25, 0.125, 0.0625, 0.03125, 0.015625, 0.0078125],
            "e": [0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5]
          },
          "want": { "g": [1, 0, 0, 0, 0, 0, 0, 0], "N": [1, 1, 1, 1, 1, 1, 1, 1] }
        },
        {
          "inputs": {
            "a": [0, 0, 0, 0, 0, 0, 0, 0],
            "h": [1, 0.5, 0.25, 0.125, 0.0625, 0.03125, 0.015625, 0.0078125],
            "e": [1.5, 1.5, 1.5, 1.5, 1.5, 1.5, 1.5, 1.5]
          },
          "want": { "g": [1, 1, 1, 1, 1, 1, 1, 1], "N": [0, 0, 0, 0, 0, 0, 0, 0] }
        }
      ],
      "solution": [
        "neg = const[value=-1]()",
        "nh = mul(h, neg)",
        "xl = add(a, nh)",
        "xr = add(a, h)",
        "yl = jump(xl)",
        "yc = jump(a)",
        "yr = jump(xr)",
        "error = gap(yl, yc, yr)",
        "ok = less(error, e)",
        "start = since(ok)",
        "g <- error",
        "N <- start"
      ],
      "naive": [
        "neg = const[value=-1]()",
        "nh = mul(h, neg)",
        "xl = add(a, nh)",
        "xr = add(a, h)",
        "yl = jump(xl)",
        "yc = jump(a)",
        "yr = jump(xr)",
        "error = gap(yl, yc, yr)",
        "d = dist(yr, yc)",
        "ok = less(d, e)",
        "start = since(ok)",
        "g <- error",
        "N <- start"
      ]
    }
  ]
}
