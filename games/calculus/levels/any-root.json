{
  "title": { "zh": "任意开方" },
  "intro": [
    {
      "t": {
        "zh": "同一台机器换一个数，还能开方吗？把 2 换成测试给出的正数 c。"
      }
    }
  ],
  "after": {
    "zh": "xₙ₊₁ = (xₙ + c/xₙ)/2 从任何正数起都趋于 √c，这就是<wiki-ref to=\"babylonian\"></wiki-ref>。"
  },
  "tasks": [
    {
      "id": "any-root",
      "brief": {
        "zh": "测试给出正数 c：从 x₀ = 1 起，交出 xₙ₊₁ = (xₙ + c/xₙ)/2。"
      },
      "inputs": [{ "name": "c", "label": "c" }],
      "outputs": [{ "name": "x", "label": "xₙ" }],
      "tests": [
        {
          "inputs": { "c": [2, 2, 2, 2, 2, 2, 2] },
          "want": {
            "x": [
              1,
              1.5,
              1.4166666666666665,
              1.4142156862745097,
              1.4142135623746899,
              1.414213562373095,
              1.414213562373095
            ]
          }
        },
        {
          "inputs": { "c": [10, 10, 10, 10, 10, 10, 10, 10] },
          "want": {
            "x": [
              1,
              5.5,
              3.659090909090909,
              3.196005081874647,
              3.1624556228038903,
              3.162277665175675,
              3.162277660168379,
              3.162277660168379
            ]
          }
        }
      ],
      "hidden": [
        {
          "inputs": { "c": [0.25, 0.25, 0.25, 0.25, 0.25, 0.25, 0.25, 0.25] },
          "want": {
            "x": [1, 0.625, 0.5125, 0.5001524390243902, 0.5000000232305737, 0.5000000000000006, 0.5, 0.5]
          }
        }
      ],
      "solution": [
        "r = reg[reg=A, start=1]()",
        "q = recip(r)",
        "t = mul(c, q)",
        "s = add(r, t)",
        "h = const[value=0.5]()",
        "m = mul(s, h)",
        "k = keep[reg=A](m)",
        "x <- r"
      ]
    }
  ]
}
