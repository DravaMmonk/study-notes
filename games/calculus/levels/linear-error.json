{
  "title": { "zh": "差半格" },
  "intro": [
    { "t": { "zh": "对 [0,1] 的直线，N 等分时 h=1/N。左端点高度是 0,h,2h,…,(N−1)h；首尾配对可得总和 1/2−h/2。" } },
    { "t": { "zh": "不必再跑 N 拍：这回让一拍代表一种分割，直接按 h 交出左和及它离 1/2 的距离。" } }
  ],
  "after": { "zh": "<wiki-ref to=\"area-error\"></wiki-ref>恰为 h/2；h 减半，误差也减半。这是直线左矩形法的代数结果。" },
  "tasks": [
    {
      "id": "linear-error",
      "brief": { "zh": "给 h=1/N，交出左和 L=1/2−h/2 与误差 e=|L−1/2|。" },
      "inputs": [{ "name": "h", "label": "h" }],
      "outputs": [{ "name": "L", "label": "L" }, { "name": "e", "label": "e" }],
      "tests": [
        {
          "inputs": { "h": [1, 0.5, 0.25, 0.125, 0.0625] },
          "want": { "L": [0, 0.25, 0.375, 0.4375, 0.46875], "e": [0.5, 0.25, 0.125, 0.0625, 0.03125] }
        }
      ],
      "hidden": [
        {
          "inputs": { "h": [0.0625, 0.03125, 0.015625, 0.0078125] },
          "want": {
            "L": [0.46875, 0.484375, 0.4921875, 0.49609375],
            "e": [0.03125, 0.015625, 0.0078125, 0.00390625]
          }
        }
      ],
      "solution": [
        "half = const[value=0.5]()",
        "error = mul(h, half)",
        "neg = const[value=-1]()",
        "minus = mul(error, neg)",
        "left = add(half, minus)",
        "L <- left",
        "e <- error"
      ],
      "naive": ["half = const[value=0.5]()", "L <- half", "e <- h"]
    }
  ]
}
