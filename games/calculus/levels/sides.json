{
  "title": { "zh": "从两侧走近" },
  "intro": [{ "t": { "zh": "数列可以从左边或右边靠近同一个数 a。测试给出的 h 逐拍缩小；比较平方函数在 a−h、a、a+h 的三个值。" } }],
  "after": { "zh": "<wiki-ref to=\"one-sided\"></wiki-ref>让我们分别观察左右两边。对 f(x)=x²，h 越小，两边的函数值越接近 f(a)。" },
  "tasks": [
    {
      "id": "sides",
      "brief": { "zh": "每拍交出 (a−h)²、a²、(a+h)²。" },
      "inputs": [{ "name": "a", "label": "a" }, { "name": "h", "label": "h" }],
      "outputs": [
        { "name": "L", "label": "f(a−h)" },
        { "name": "C", "label": "f(a)" },
        { "name": "R", "label": "f(a+h)" }
      ],
      "tests": [
        {
          "inputs": { "a": [0, 0, 0, 0, 0, 0], "h": [1, 0.5, 0.25, 0.125, 0.0625, 0.03125] },
          "want": {
            "L": [1, 0.25, 0.0625, 0.015625, 0.00390625, 0.0009765625],
            "C": [0, 0, 0, 0, 0, 0],
            "R": [1, 0.25, 0.0625, 0.015625, 0.00390625, 0.0009765625]
          }
        },
        {
          "inputs": { "a": [1, 1, 1, 1, 1, 1], "h": [1, 0.5, 0.25, 0.125, 0.0625, 0.03125] },
          "want": {
            "L": [0, 0.25, 0.5625, 0.765625, 0.87890625, 0.9384765625],
            "C": [1, 1, 1, 1, 1, 1],
            "R": [4, 2.25, 1.5625, 1.265625, 1.12890625, 1.0634765625]
          }
        }
      ],
      "hidden": [
        {
          "inputs": {
            "a": [-2, -2, -2, -2, -2, -2, -2, -2],
            "h": [2, 1, 0.5, 0.25, 0.125, 0.0625, 0.03125, 0.015625]
          },
          "want": {
            "L": [16, 9, 6.25, 5.0625, 4.515625, 4.25390625, 4.1259765625, 4.062744140625],
            "C": [4, 4, 4, 4, 4, 4, 4, 4],
            "R": [0, 1, 2.25, 3.0625, 3.515625, 3.75390625, 3.8759765625, 3.937744140625]
          }
        }
      ],
      "solution": [
        "m = const[value=-1]()",
        "nh = mul(h, m)",
        "xl = add(a, nh)",
        "xr = add(a, h)",
        "yl = mul(xl, xl)",
        "yc = mul(a, a)",
        "yr = mul(xr, xr)",
        "L <- yl",
        "C <- yc",
        "R <- yr"
      ]
    }
  ]
}
