{
  "title": { "zh": "一半再一半", "en": "Half and half again" },
  "intro": [
    {
      "t": {
        "zh": "1/2 + 1/4 + 1/8 + …：每加一项，离 1 就近一半。可它到底能不能加到 1？",
        "en": "1/2 + 1/4 + 1/8 + …: each term halves the way left to 1. But does it ever reach 1?"
      }
    }
  ],
  "after": {
    "zh": "差距每步减半，却从来不是 0：部分和逼近 1，没有哪一项等于 1。",
    "en": "The gap halves every step and is never 0: the partial sums close in on 1 and none equals it."
  },
  "tasks": [
    {
      "id": "halves",
      "brief": {
        "zh": "交出 1/2 + 1/4 + … 的部分和，和它与 1 的差距。",
        "en": "Give the partial sums of 1/2 + 1/4 + … and their gap from 1."
      },
      "outputs": [{ "name": "S", "label": "Sₙ" }, { "name": "G", "label": "1 − Sₙ" }],
      "tests": [
        {
          "want": {
            "S": [
              0.5,
              0.75,
              0.875,
              0.9375,
              0.96875,
              0.984375,
              0.9921875,
              0.99609375,
              0.998046875,
              0.9990234375
            ],
            "G": [0.5, 0.25, 0.125, 0.0625, 0.03125, 0.015625, 0.0078125, 0.00390625, 0.001953125, 0.0009765625]
          }
        }
      ],
      "hidden": [
        {
          "want": {
            "S": [
              0.5,
              0.75,
              0.875,
              0.9375,
              0.96875,
              0.984375,
              0.9921875,
              0.99609375,
              0.998046875,
              0.9990234375,
              0.99951171875,
              0.999755859375,
              0.9998779296875,
              0.99993896484375
            ],
            "G": [
              0.5,
              0.25,
              0.125,
              0.0625,
              0.03125,
              0.015625,
              0.0078125,
              0.00390625,
              0.001953125,
              0.0009765625,
              0.00048828125,
              0.000244140625,
              0.0001220703125,
              0.00006103515625
            ]
          }
        }
      ],
      "solution": [
        "r = reg[reg=A, start=0.5]()",
        "h = const[value=0.5]()",
        "m = mul(r, h)",
        "k = keep[reg=A](m)",
        "s = sum(r)",
        "c = const[value=-1]()",
        "x = mul(s, c)",
        "o = const[value=1]()",
        "g = add(o, x)",
        "S <- s",
        "G <- g"
      ]
    }
  ]
}
