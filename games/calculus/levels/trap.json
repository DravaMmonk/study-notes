{
  "title": { "zh": "改成梯形" },
  "intro": [
    { "t": { "zh": "左矩形只看小格开头，漏掉直线斜边下的一角。再读右端高度，把两端平均，乘宽度。" } },
    { "t": { "zh": "这块梯形小格以后能接到累加器。先用不同的左右高度、宽度测试它，包括下降的直线。" } }
  ],
  "after": { "zh": "<wiki-ref to=\"trapezoid-rule\"></wiki-ref>对每格内的直线精确；对弯曲函数，它仍只是近似。" },
  "builds": { "type": "trap", "name": { "zh": "梯形小格" }, "desc": { "zh": "左右高度取平均，再乘有向宽度。" } },
  "tasks": [
    {
      "id": "trap",
      "brief": { "zh": "给左高 l、右高 r 与宽度 h，交出 A=h(l+r)/2。" },
      "inputs": [{ "name": "l", "label": "l" }, { "name": "r", "label": "r" }, { "name": "h", "label": "h" }],
      "outputs": [{ "name": "A", "label": "A" }],
      "tests": [
        {
          "inputs": { "l": [0, 1, 3, 4, -2], "r": [1, 3, 1, -2, 2], "h": [1, 0.5, 0.25, -0.5, 2] },
          "want": { "A": [0.5, 1, 0.5, -0.5, 0] }
        }
      ],
      "hidden": [
        {
          "inputs": { "l": [10, -4, 0, 2], "r": [2, 8, -3, -6], "h": [0.125, -0.25, 1, 0.5] },
          "want": { "A": [0.75, -0.5, -1.5, -1] }
        }
      ],
      "solution": [
        "both = add(l, r)",
        "half = const[value=0.5]()",
        "avg = mul(both, half)",
        "area = mul(avg, h)",
        "A <- area"
      ],
      "naive": ["area = cell(l, h)", "A <- area"]
    }
  ]
}
