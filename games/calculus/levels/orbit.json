      "solution": [
        "px = reg[reg=A, start=1]()",
        "py = reg[reg=B, start=0]()",
        "pvx = reg[reg=C, start=0]()",
        "pvy = reg[reg=D, start=1]()",
        "factor = gravity(px, py)",
        "negative = const[value=-1]()",
        "xFactor = mul(px, factor)",
        "yFactor = mul(py, factor)",
        "ax = mul(xFactor, negative)",
        "ay = mul(yFactor, negative)",
        "nextX = eulerStep(px, pvx, h)",
        "nextY = eulerStep(py, pvy, h)",
        "nextVx = eulerStep(pvx, ax, h)",
        "nextVy = eulerStep(pvy, ay, h)",
        "saveX = keep[reg=A](nextX)",
        "saveY = keep[reg=B](nextY)",
        "saveVx = keep[reg=C](nextVx)",
        "saveVy = keep[reg=D](nextVy)",
        "x2 = mul(px, px)",
        "y2 = mul(py, py)",
        "radius2 = add(x2, y2)",
        "x <- px",
        "y <- py",
        "R <- radius2"
      ],
      "naive": [
        "px = reg[reg=A, start=1]()",
        "py = reg[reg=B, start=0]()",
        "pvx = reg[reg=C, start=0]()",
        "pvy = reg[reg=D, start=1]()",
        "negative = const[value=-1]()",
        "ax = mul(px, negative)",
        "ay = mul(py, negative)",
        "nextX = eulerStep(px, pvx, h)",
        "nextY = eulerStep(py, pvy, h)",
        "nextVx = eulerStep(pvx, ax, h)",
        "nextVy = eulerStep(pvy, ay, h)",
        "saveX = keep[reg=A](nextX)",
        "saveY = keep[reg=B](nextY)",
        "saveVx = keep[reg=C](nextVx)",
        "saveVy = keep[reg=D](nextVy)",
        "x2 = mul(px, px)",
        "y2 = mul(py, py)",
        "radius2 = add(x2, y2)",
        "x <- px",
        "y <- py",
        "R <- radius2"
      ]
