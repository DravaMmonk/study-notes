{
  "title": { "zh": "阶乘倒数", "en": "Reciprocal factorials" },
  "intro": [
    {
      "t": {
        "zh": "n! = 1·2·…·n，0! = 1。1/n! 小得极快：1, 1, 1/2, 1/6, 1/24, …。不必先算出 n! 再取倒数：相邻两项只差一个因子。",
        "en": "n! = 1·2·…·n, and 0! = 1. 1/n! shrinks extremely fast: 1, 1, 1/2, 1/6, 1/24, …. There is no need to compute n! first: neighbouring terms differ by a single factor."
      }
    }
  ],
  "tasks": [
    {
      "id": "fact",
      "brief": {
        "zh": "交出 1, 1, 1/2, 1/6, 1/24, …：第 n 项是 1/n!。",
        "en": "Give 1, 1, 1/2, 1/6, 1/24, …: term n is 1/n!."
      },
      "hint": [{ "zh": "1/n! 和 1/(n − 1)! 差一个什么因子？", "en": "What factor separates 1/n! from 1/(n − 1)!?" }],
      "outputs": [{ "name": "t", "label": "1/n!" }],
      "tests": [
        {
          "want": {
            "t": [
              1,
              1,
              0.5,
              0.16666666666666666,
              0.041666666666666664,
              0.008333333333333333,
              0.001388888888888889,
              0.0001984126984126984,
              0.0000248015873015873,
              0.0000027557319223985893
            ]
          }
        }
      ],
      "hidden": [
        {
          "want": {
            "t": [
              1,
              1,
              0.5,
              0.16666666666666666,
              0.041666666666666664,
              0.008333333333333333,
              0.001388888888888889,
              0.0001984126984126984,
              0.0000248015873015873,
              0.0000027557319223985893,
              2.755731922398589e-7,
              2.505210838544172e-8,
              2.08767569878681e-9
            ]
          }
        }
      ],
      "solution": [
        "r = reg[reg=A, start=1]()",
        "n = count()",
        "o = const[value=1]()",
        "m = add(n, o)",
        "q = recip(m)",
        "p = mul(r, q)",
        "k = keep[reg=A](p)",
        "t <- r"
      ]
    }
  ]
}
