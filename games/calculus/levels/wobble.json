  "title": { "zh": "摆动着靠近" },
  "intro": [
    {
      "t": {
        "zh": "1, −1/2, 1/3, −1/4, …：一会儿在 0 的右边，一会儿在左边。它也算趋于 0 吗？"
      }
    }
  ],
  "tasks": [
