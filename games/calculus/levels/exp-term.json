{
  "title": { "zh": "下一项" },
  "intro": [
    { "t": { "zh": "第 1 章算过 1/n!。现在再乘 xⁿ，得到 eˣ 展开的第 n 项。每拍重算幂和阶乘很浪费：相邻两项只有一个比例。" } },
    { "t": { "zh": "从 t₀=1 出发，每拍把 tₙ 乘 x/(n+1) 留给下一拍。测试会换正负 x，不能只记住 e 的旧数列。" } }
  ],
  "after": { "zh": "<wiki-ref to=\"taylor-term\"></wiki-ref>是 xⁿ/n!；递推比例 x/(n+1) 让同一块板适应不同 x。" },
  "builds": { "type": "expTerm", "name": { "zh": "指数项" }, "desc": { "zh": "固定 x，逐拍交出 xⁿ/n!。" } },
  "tasks": [
    {
      "id": "exp-term",
      "brief": { "zh": "给固定 x，每拍交出 tₙ=xⁿ/n!，从 t₀=1 开始。" },
      "inputs": [{ "name": "x", "label": "x" }],
      "outputs": [{ "name": "t", "label": "tₙ" }],
      "tests": [
        {
          "inputs": { "x": [1, 1, 1, 1, 1, 1, 1, 1, 1] },
          "want": {
            "t": [
              1,
              1,
              0.5,
              0.16666666666666666,
              0.041666666666666664,
              0.008333333333333333,
              0.0013888888888888887,
              0.00019841269841269839,
              0.000024801587301587298
            ]
          }
        },
        {
          "inputs": { "x": [-1, -1, -1, -1, -1, -1, -1, -1, -1] },
          "want": {
            "t": [
              1,
              -1,
              0.5,
              -0.16666666666666666,
              0.041666666666666664,
              -0.008333333333333333,
              0.0013888888888888887,
              -0.00019841269841269839,
              0.000024801587301587298
            ]
          }
        }
      ],
      "hidden": [
        {
          "inputs": { "x": [2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2] },
          "want": {
            "t": [
              1,
              2,
              2,
              1.3333333333333333,
              0.6666666666666666,
              0.26666666666666666,
              0.08888888888888888,
              0.025396825396825393,
              0.006349206349206348,
              0.0014109347442680773,
              0.00028218694885361544,
              0.00005130671797338463
            ]
          }
        },
        {
          "inputs": { "x": [0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5] },
          "want": {
            "t": [
              1,
              0.5,
              0.125,
              0.020833333333333332,
              0.0026041666666666665,
              0.00026041666666666666,
              0.000021701388888888886,
              0.0000015500992063492061,
              9.688120039682538e-8,
              5.382288910934743e-9,
              2.6911444554673714e-10,
              1.2232474797578962e-11
            ]
          }
        }
      ],
      "solution": [
        "r = reg[reg=A, start=1]()",
        "n = count()",
        "one = const[value=1]()",
        "nextIndex = add(n, one)",
        "inv = recip(nextIndex)",
        "scaled = mul(r, x)",
        "next = mul(scaled, inv)",
        "k = keep[reg=A](next)",
        "t <- r"
      ],
      "naive": ["t <- x"]
    }
  ]
}
