{
  "title": { "zh": "距离", "en": "Distance" },
  "intro": [
    {
      "t": {
        "zh": "aₙ 和 L 差多少，用 aₙ − L 量，时正时负：在左边差 3 和在右边差 3，一样远。",
        "en": "Measuring how far aₙ is from L by aₙ − L gives sometimes a positive, sometimes a negative number: 3 to the left and 3 to the right are equally far."
      }
    }
  ],
  "after": {
    "zh": "|a − b| 只量隔多远，不看谁在左边。",
    "en": "|a − b| measures only how far apart, never which is on the left."
  },
  "builds": {
    "type": "dist",
    "name": { "zh": "距离", "en": "Distance" },
    "desc": { "zh": "交出 |a − b|。", "en": "Gives |a − b|." }
  },
  "tasks": [
    {
      "id": "dist",
      "brief": { "zh": "每一拍交出两个输入隔多远。", "en": "Each tick give how far apart the two inputs are." },
      "hint": [{ "zh": "a − b 和 b − a，总有一个不是负的。", "en": "Of a − b and b − a, one is never negative." }],
      "inputs": [{ "name": "a", "label": "a" }, { "name": "b", "label": "b" }],
      "outputs": [{ "name": "d", "label": "|a − b|" }],
      "tests": [
        {
          "inputs": { "a": [3, -2, 5, 0.5, 7, -1, 4, 4], "b": [1, 6, 5, 0.25, -7, -3, 9, 2] },
          "want": { "d": [2, 8, 0, 0.25, 14, 2, 5, 2] }
        },
        { "inputs": { "a": [0, 1, 2, 3, 4, 5], "b": [5, 4, 3, 2, 1, 0] }, "want": { "d": [5, 3, 1, 1, 3, 5] } }
      ],
      "hidden": [
        {
          "inputs": {
            "a": [10, -10, 0.1, -0.1, 2.5, 2.5, 100, -100, 8, 1],
            "b": [-10, 10, -0.1, 0.1, 2.5, 3, 99, 0, 9, -1]
          },
          "want": { "d": [20, 20, 0.2, 0.2, 0, 0.5, 1, 100, 1, 2] }
        }
      ],
      "solution": [
        "k = const[value=-1]()",
        "x = mul(b, k)",
        "p = add(a, x)",
        "y = mul(a, k)",
        "q = add(b, y)",
        "z = max(p, q)",
        "d <- z"
      ],
      "naive": ["k = const[value=-1]()", "x = mul(b, k)", "p = add(a, x)", "d <- p"]
    }
  ]
}
