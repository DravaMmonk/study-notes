{
  "title": { "zh": "函数还在，级数没了" },
  "intro": [
    { "t": { "zh": "把几何级数里的 x 换成 -x²：1−x²+x⁴−… 。在 |x|<1，它趋向 1/(1+x²)。" } },
    { "t": { "zh": "函数在 x=2 明明有值 1/5，但这条围绕 0 的展开项为 1,-4,16,-64,…，越来越大。函数有值不等于这条级数在那里可用。" } }
  ],
  "after": { "zh": "<wiki-ref to=\"outside-radius\"></wiki-ref>：x=2 时项不趋于 0，级数必然发散；这不是函数 1/(1+x²) 的故障。" },
  "tasks": [
    {
      "id": "rational-outside",
      "brief": { "zh": "给固定 x，逐拍交出 tₙ=(-x²)ⁿ 和部分和 Sₙ。" },
      "inputs": [{ "name": "x", "label": "x" }],
      "outputs": [{ "name": "t", "label": "tₙ" }, { "name": "S", "label": "Sₙ" }],
      "tests": [
        {
          "inputs": { "x": [0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5] },
          "want": {
            "t": [1, -0.25, 0.0625, -0.015625, 0.00390625, -0.0009765625, 0.000244140625, -0.00006103515625],
            "S": [1, 0.75, 0.8125, 0.796875, 0.80078125, 0.7998046875, 0.800048828125, 0.79998779296875]
          }
        },
        {
          "inputs": { "x": [2, 2, 2, 2, 2, 2, 2, 2] },
          "want": {
            "t": [1, -4, 16, -64, 256, -1024, 4096, -16384],
            "S": [1, -3, 13, -51, 205, -819, 3277, -13107]
          }
        }
      ],
      "hidden": [
        {
          "inputs": { "x": [-0.75, -0.75, -0.75, -0.75, -0.75, -0.75, -0.75, -0.75, -0.75, -0.75] },
          "want": {
            "t": [
              1,
              -0.5625,
              0.31640625,
              -0.177978515625,
              0.1001129150390625,
              -0.056313514709472656,
              0.03167635202407837,
              -0.017817948013544083,
              0.010022595757618546,
              -0.005637710113660432
            ],
            "S": [
              1,
              0.4375,
              0.75390625,
              0.575927734375,
              0.6760406494140625,
              0.6197271347045898,
              0.6514034867286682,
              0.6335855387151241,
              0.6436081344727427,
              0.6379704243590822
            ]
          }
        },
        {
          "inputs": { "x": [-2, -2, -2, -2, -2, -2, -2, -2, -2, -2] },
          "want": {
            "t": [1, -4, 16, -64, 256, -1024, 4096, -16384, 65536, -262144],
            "S": [1, -3, 13, -51, 205, -819, 3277, -13107, 52429, -209715]
          }
        }
      ],
      "solution": [
        "r = reg[reg=A, start=1]()",
        "x2 = mul(x, x)",
        "negative = const[value=-1]()",
        "ratio = mul(x2, negative)",
        "next = mul(r, ratio)",
        "k = keep[reg=A](next)",
        "partial = sum(r)",
        "t <- r",
        "S <- partial"
      ],
      "naive": [
        "one = const[value=1]()",
        "x2 = mul(x, x)",
        "den = add(one, x2)",
        "value = recip(den)",
        "zero = const[value=0]()",
        "t <- zero",
        "S <- value"
      ]
    }
  ]
}
