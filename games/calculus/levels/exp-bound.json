      ],
      "solution": [
        "partial = expSeries(x)",
        "term = expTerm(x)",
        "n = count()",
        "one = const[value=1]()",
        "nextIndex = add(n, one)",
        "inv = recip(nextIndex)",
        "scaled = mul(term, x)",
        "next = mul(scaled, inv)",
        "three = const[value=3]()",
        "bound = mul(next, three)",
        "S <- partial",
        "B <- bound"
      ],
      "naive": ["partial = expSeries(x)", "zero = const[value=0]()", "S <- partial", "B <- zero"]
