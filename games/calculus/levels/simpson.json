{
  "title": { "zh": "三点加权" },
  "intro": [
    { "t": { "zh": "梯形看左右两端，再加一眼中点。辛普森法给左右端点各 1 份、中点 4 份，最后乘整段宽度的六分之一。" } },
    { "t": { "zh": "对平方与三次函数，这一段的结果恰是面积；对四次函数仍留误差。测试也会给普通三点高度，避免背出固定结果。" } }
  ],
  "after": { "zh": "<wiki-ref to=\"simpson-rule\"></wiki-ref>是三点的加权近似；它对三次及以下多项式精确，不意味着任意曲线都能由三个点确定。" },
  "tasks": [
    {
      "id": "simpson",
      "brief": { "zh": "给端点高度 l、r，中点高度 m 与整段宽度 h，交出 A=h(l+4m+r)/6。" },
      "inputs": [
        { "name": "l", "label": "l" },
        { "name": "m", "label": "m" },
        { "name": "r", "label": "r" },
        { "name": "h", "label": "h" }
      ],
      "outputs": [{ "name": "A", "label": "A" }],
      "tests": [
        {
          "inputs": {
            "l": [0, 0, 0, 2, -1],
            "m": [0.25, 0.125, 0.0625, 3, 1],
            "r": [1, 1, 1, 4, 2],
            "h": [1, 1, 1, 0.5, 2]
          },
          "want": { "A": [0.3333333333333333, 0.25, 0.20833333333333334, 1.5, 1.6666666666666667] }
        }
      ],
      "hidden": [
        {
          "inputs": {
            "l": [1, 4, -2, 0],
            "m": [2, 1, 3, 0.5],
            "r": [5, -1, 0, 2],
            "h": [0.25, 0.125, -0.5, 2]
          },
          "want": { "A": [0.5833333333333334, 0.14583333333333334, -0.8333333333333334, 1.3333333333333333] }
        }
      ],
      "solution": [
        "four = const[value=4]()",
        "weighted = mul(m, four)",
        "ends = add(l, r)",
        "total = add(ends, weighted)",
        "sixth = const[value=0.16666666666666666]()",
        "scale = mul(h, sixth)",
        "area = mul(total, scale)",
        "A <- area"
      ],
      "naive": ["area = trap(l, r, h)", "A <- area"]
    }
  ]
}
