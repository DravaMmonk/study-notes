{
  "title": { "zh": "把整台机接起来" },
  "intro": [
    { "t": { "zh": "最后把几章的板接到同一个函数上。测试用系数 p、q、r 给出 f(t)=pt²+qt+r，再给起点 a、一步 h 和状态初值 s。" } },
    { "t": { "zh": "求 f′(a)，用二阶泰勒式算 f(a+h)，并把 f 在这一格的取样积分为 I。对 y′=f(t)、y(a)=s，下一状态就是 s+I；用 RK4 权重搭出它。" } }
  ],
  "after": {
    "zh": "<wiki-ref to=\"quadratic-capstone\"></wiki-ref>导数、泰勒、积分和微分方程接通了。二次函数上，这一步精确；其他函数仍需估计误差。"
  },
  "tasks": [
    {
      "id": "capstone",
      "brief": { "zh": "给 f(t)=pt²+qt+r、a、h、s，交出 D=f′(a)、T=f(a+h) 的二阶泰勒值、I=∫ₐᵃ⁺ʰf(t)dt 和 Y=s+I。" },
      "inputs": [
        { "name": "p", "label": "p" },
        { "name": "q", "label": "q" },
        { "name": "r", "label": "r" },
        { "name": "a", "label": "a" },
        { "name": "h", "label": "h" },
        { "name": "s", "label": "s" }
      ],
      "outputs": [
        { "name": "D", "label": "f′(a)" },
        { "name": "T", "label": "T₂" },
        { "name": "I", "label": "∫f" },
        { "name": "Y", "label": "y(a+h)" }
      ],
      "tests": [
        {
          "inputs": {
            "p": [0, 1, -2, 0.5],
            "q": [2, 0, 1, -1],
            "r": [1, 0, 3, 2],
            "a": [0, 1, -1, 2],
            "h": [0.5, 0.25, 0.5, -0.25],
            "s": [3, 0, 2, -3]
          },
          "want": {
            "D": [2, 2, 5, 1],
            "T": [2, 1.5625, 2, 1.78125],
            "I": [0.75, 0.3177083333333333, 0.5416666666666666, -0.4713541666666667],
            "Y": [3.75, 0.3177083333333333, 2.5416666666666665, -3.4713541666666665]
          }
        }
      ],
      "hidden": [
        {
          "inputs": {
            "p": [3, -1, 0, 2],
            "q": [-2, 0.5, 0, 3],
            "r": [0, -4, 2, 1],
            "a": [-2, 3, 5, -0.5],
            "h": [0.125, 0.5, -0.25, 0.0625],
            "s": [1, 10, -1, 0]
          },
          "want": {
            "D": [-14, -5.5, 0, 1],
            "T": [14.296875, -14.5, 2, 0.0703125],
            "I": [1.892578125, -6.479166666666667, -0.5, 0.0021158854166666713],
            "Y": [2.892578125, 3.520833333333333, -1.5, 0.0021158854166666713]
          }
        }
      ],
      "solution": [
        "a2 = mul(a, a)",
        "pA2 = mul(p, a2)",
        "qA = mul(q, a)",
        "firstA = add(pA2, qA)",
        "fa = add(firstA, r)",
        "twoA = squarePrime(a)",
        "pTwoA = mul(p, twoA)",
        "derivative = add(pTwoA, q)",
        "half = const[value=0.5]()",
        "halfH = mul(h, half)",
        "mid = add(a, halfH)",
        "mid2 = mul(mid, mid)",
        "pMid2 = mul(p, mid2)",
        "qMid = mul(q, mid)",
        "firstMid = add(pMid2, qMid)",
        "fm = add(firstMid, r)",
        "end = add(a, h)",
        "end2 = mul(end, end)",
        "pEnd2 = mul(p, end2)",
        "qEnd = mul(q, end)",
        "firstEnd = add(pEnd2, qEnd)",
        "fb = add(firstEnd, r)",
        "dh = mul(derivative, h)",
        "h2 = mul(h, h)",
        "ph2 = mul(p, h2)",
        "firstTaylor = add(fa, dh)",
        "taylor = add(firstTaylor, ph2)",
        "zero = const[value=0]()",
        "area = rk4Step(zero, h, fa, fm, fm, fb)",
        "nextY = rk4Step(s, h, fa, fm, fm, fb)",
        "D <- derivative",
        "T <- taylor",
        "I <- area",
        "Y <- nextY"
      ],
      "naive": [
        "a2 = mul(a, a)",
        "pA2 = mul(p, a2)",
        "qA = mul(q, a)",
        "firstA = add(pA2, qA)",
        "fa = add(firstA, r)",
        "twoA = squarePrime(a)",
        "pTwoA = mul(p, twoA)",
        "derivative = add(pTwoA, q)",
        "dh = mul(derivative, h)",
        "taylor = add(fa, dh)",
        "area = mul(fa, h)",
        "nextY = add(s, area)",
        "D <- derivative",
        "T <- taylor",
        "I <- area",
        "Y <- nextY"
      ]
    }
  ]
}
