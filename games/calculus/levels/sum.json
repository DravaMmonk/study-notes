{
  "title": { "zh": "累加" },
  "intro": [
    {
      "t": {
        "zh": "项一拍只来一个，而前面所有项的和要用到每一项。寄存卡一次只记得一个数：这个数该是什么？"
      }
    },
    { "t": { "zh": "搭好以后，累加 Σ 成为一件元件。" } }
  ],
  "after": {
    "zh": "Sₙ = a₀ + … + aₙ 叫<wiki-ref to=\"partial-sum\"></wiki-ref>；部分和本身也是数列，由 Sₙ = Sₙ₋₁ + aₙ 递推出来。"
  },
  "tasks": [
    {
      "id": "sum",
      "brief": { "zh": "每一拍交出输入到这一拍为止所有项的和。" },
      "hint": [{ "zh": "第三拍时，第一项还在不在？" }],
      "inputs": [{ "name": "a", "label": "aₙ" }],
      "outputs": [{ "name": "S", "label": "Sₙ" }],
      "tests": [
        { "inputs": { "a": [5, 2, 8, 1, 4, 4, 7, 3] }, "want": { "S": [5, 7, 15, 16, 20, 24, 31, 34] } },
        { "inputs": { "a": [1, -1, 1, -1, 2, -2, 3, -3] }, "want": { "S": [1, 0, 1, 0, 2, 0, 3, 0] } }
      ],
      "hidden": [
        {
          "inputs": { "a": [10, 20, 30, 40, 50, 0, -5, -10, 1, 2] },
          "want": { "S": [10, 30, 60, 100, 150, 150, 145, 135, 136, 138] }
        }
      ],
      "solution": ["r = reg[reg=A, start=0]()", "p = add(r, a)", "k = keep[reg=A](p)", "S <- p"],
      "naive": ["r = reg[reg=A, start=0]()", "k = keep[reg=A](a)", "p = add(a, r)", "S <- p"]
    }
  ]
}
