{
  "title": { "zh": "算出 e", "en": "Computing e" },
  "intro": [
    {
      "t": {
        "zh": "把阶乘倒数一项项加起来：1 + 1 + 1/2 + 1/6 + …。这个和有自己的名字。测试给出它的值和 ε，看部分和几项就稳定下来。",
        "en": "Add the reciprocal factorials term by term: 1 + 1 + 1/2 + 1/6 + …. This sum has a name of its own. The test gives its value and ε: watch how few terms the partial sums need to settle."
      }
    }
  ],
  "after": {
    "zh": "1 + 1/1! + 1/2! + … 趋于 e ≈ 2.71828：阶乘长得飞快，几项就准到小数点后好几位。",
    "en": "1 + 1/1! + 1/2! + … tends to e ≈ 2.71828: factorials grow so fast that a few terms are right to several decimal places."
  },
  "tasks": [
