{
  "title": { "zh": "较大者" },
  "intro": [
    {
      "t": {
        "zh": "要说「够近」，先得会说「哪个大」。板只会加、乘、取倒数，这些运算都平滑地变，接不出「哪个大」这种一下子跳过去的判断。"
      }
    },
    {
      "t": {
        "zh": "新元件<part-ref to=\"part:less\"></part-ref>把这个判断写成数：a < b 时给 1，否则给 0。"
      }
    }
  ],
  "after": {
    "zh": "真假写成 1 和 0，乘上去就能挑选：<wiki-ref to=\"inequality\"></wiki-ref>也成了算术。"
  },
  "adds": ["less"],
  "builds": {
    "type": "max",
    "name": { "zh": "较大者" },
    "desc": { "zh": "交出 a、b 里大的那个。" }
  },
  "tasks": [
    {
      "id": "max",
      "brief": { "zh": "每一拍交出两个输入里大的那个。" },
      "hint": [
        {
          "zh": "比较给出的 1 或 0，乘上 b − a 会怎样？"
        }
      ],
      "inputs": [{ "name": "a", "label": "a" }, { "name": "b", "label": "b" }],
      "outputs": [{ "name": "m", "label": "max(a, b)" }],
      "tests": [
        {
          "inputs": { "a": [3, -2, 5, 0.5, 7, -1, 4, 4], "b": [1, 6, 5, 0.25, -7, -3, 9, 2] },
          "want": { "m": [3, 6, 5, 0.5, 7, -1, 9, 4] }
        },
        { "inputs": { "a": [0, 1, 2, 3, 4, 5], "b": [5, 4, 3, 2, 1, 0] }, "want": { "m": [5, 4, 3, 3, 4, 5] } }
      ],
      "hidden": [
        {
          "inputs": {
            "a": [10, -10, 0.1, -0.1, 2.5, 2.5, 100, -100, 8, 1],
            "b": [-10, 10, -0.1, 0.1, 2.5, 3, 99, 0, 9, -1]
          },
          "want": { "m": [10, 10, 0.1, 0.1, 2.5, 3, 100, 0, 9, 1] }
        }
      ],
      "solution": [
        "c = less(a, b)",
        "k = const[value=-1]()",
        "x = mul(a, k)",
        "d = add(b, x)",
        "p = mul(c, d)",
        "y = add(a, p)",
        "m <- y"
      ]
    }
  ]
}
