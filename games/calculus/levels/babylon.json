{
  "title": { "zh": "巴比伦开方" },
  "intro": [
    {
      "t": {
        "zh": "√2 不是两个整数之比，加、乘、取倒数都给不出它本身。可以一步步猜：猜 x 大了，2/x 就小了，√2 夹在两者之间。"
      }
    }
  ],
  "tasks": [
    {
      "id": "babylon",
      "brief": { "zh": "从 x₀ = 1 起，交出 xₙ₊₁ = (xₙ + 2/xₙ)/2。" },
      "hint": [{ "zh": "下一次的猜测存回同一张寄存卡。" }],
      "outputs": [{ "name": "x", "label": "xₙ" }],
      "tests": [
        {
          "want": {
            "x": [1, 1.5, 1.4166666666666665, 1.4142156862745097, 1.4142135623746899, 1.414213562373095]
          }
        }
      ],
      "hidden": [
        {
          "want": {
            "x": [
              1,
              1.5,
              1.4166666666666665,
              1.4142156862745097,
              1.4142135623746899,
              1.414213562373095,
              1.414213562373095,
              1.414213562373095,
              1.414213562373095
            ]
          }
        }
      ],
      "solution": [
        "r = reg[reg=A, start=1]()",
        "q = recip(r)",
        "w = const[value=2]()",
        "t = mul(q, w)",
        "s = add(r, t)",
        "h = const[value=0.5]()",
        "m = mul(s, h)",
        "k = keep[reg=A](m)",
        "x <- r"
      ]
    }
  ]
}
