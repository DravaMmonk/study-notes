{
  "title": { "zh": "翻倍" },
  "intro": [
    {
      "t": {
        "zh": "3, 6, 12, 24, …：每一项是上一项的两倍。它和等差数列一样由首项和上一项定出，只是从上一项到这一项的那一步换了。"
      }
    }
  ],
  "after": {
    "zh": "每一项是上一项乘同一个数：这叫<wiki-ref to=\"geometric\"></wiki-ref>，那个数叫公比。它比任何等差数列长得都快。"
  },
  "tasks": [
    {
      "id": "double",
      "brief": {
        "zh": "交出首项 3、之后每项是上一项两倍的数列。"
      },
      "hint": [{ "zh": "前两步分别加了 3 和 6；不变的是什么？" }],
      "outputs": [{ "name": "d", "label": "aₙ" }],
      "tests": [{ "want": { "d": [3, 6, 12, 24, 48, 96, 192, 384] } }],
      "hidden": [{ "want": { "d": [3, 6, 12, 24, 48, 96, 192, 384, 768, 1536, 3072, 6144] } }],
      "solution": [
        "r = reg[reg=A, start=3]()",
        "c = const[value=2]()",
        "m = mul(r, c)",
        "k = keep[reg=A](m)",
        "d <- r"
      ],
      "naive": [
        "r = reg[reg=A, start=3]()",
        "c = const[value=3]()",
        "s = add(r, c)",
        "k = keep[reg=A](s)",
        "d <- r"
      ]
    }
  ]
}
