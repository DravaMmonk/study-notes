{
  "title": { "zh": "再差一次" },
  "intro": [{ "t": { "zh": "奇数本身每一步又变了多少？" } }],
  "after": {
    "zh": "平方数的二阶差分从第三项起一直是 2。差分机反过来用它：从常数起一次次累加，只用加法就印出平方表。"
  },
  "tasks": [
    {
      "id": "ddsq",
      "brief": { "zh": "交出 n² 的差分的差分。" },
      "outputs": [{ "name": "e", "label": "Δ²(n²)" }],
      "tests": [{ "want": { "e": [0, 1, 2, 2, 2, 2, 2, 2] } }],
      "hidden": [{ "want": { "e": [0, 1, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2] } }],
      "solution": ["n = count()", "q = mul(n, n)", "d = diff(q)", "f = diff(d)", "e <- f"]
    }
  ]
}
