{
  "title": { "zh": "再看互逆" },
  "intro": [
    { "t": { "zh": "第 0 章用差分和累加还原数列。现在把一串函数取样 y₀,y₁,… 送进去，检查这件事是否仍成立。" } },
    { "t": { "zh": "第一拍的前一项约定为 0。此后每次加回 yₙ−yₙ₋₁，中间的值会一正一负地抵消。" } }
  ],
  "after": { "zh": "<wiki-ref to=\"discrete-telescope\"></wiki-ref>给出 ΣΔy=y；它对任何有限序列都成立，不依赖取样点有多密。" },
  "tasks": [
    {
      "id": "telescope",
      "brief": { "zh": "收到函数值序列 y，每拍交出差分 d，再累加差分得到还原值 r。" },
      "inputs": [{ "name": "y", "label": "yₙ" }],
      "outputs": [{ "name": "d", "label": "Δyₙ" }, { "name": "r", "label": "rₙ" }],
      "tests": [
        {
          "inputs": { "y": [0, 1, 4, 9, 16, 25] },
          "want": { "d": [0, 1, 3, 5, 7, 9], "r": [0, 1, 4, 9, 16, 25] }
        },
        {
          "inputs": { "y": [3, 2, 7, 7, -1, 0] },
          "want": { "d": [3, -1, 5, 0, -8, 1], "r": [3, 2, 7, 7, -1, 0] }
        }
      ],
      "hidden": [
        {
          "inputs": { "y": [-2, 0.5, 0.25, 8, -3, 10, 10, 4] },
          "want": { "d": [-2, 2.5, -0.25, 7.75, -11, 13, 0, -6], "r": [-2, 0.5, 0.25, 8, -3, 10, 10, 4] }
        }
      ],
      "solution": ["change = diff(y)", "restored = sum(change)", "d <- change", "r <- restored"],
      "naive": ["d <- y", "restored = sum(y)", "r <- restored"]
    }
  ]
}
