  "title": { "zh": "视觉完备", "en": "Vision Complete" },
  "kicker": { "zh": "COMP90086 · 计算机视觉", "en": "COMP90086 · Computer Vision" },
  "lede": {
    "zh": "没有讲解，只有元件、测试和一组输入输出。从“把图挪一格”开始，自己搭出模糊、边缘、角点和视差，最后让机器学会看。",
    "en": "No lectures: just parts, tests and a set of inputs and outputs. Start from “move the picture one pixel”, build blur, edges, corners and disparity yourself, and finally teach the machine to see."
  },
  "power": {
    "title": { "zh": "上电", "en": "Power on" },
    "lines": [
      { "zh": "探测器 V-0，视觉芯片已上电。", "en": "Probe V-0, vision chip powered on." },
      {
        "zh": "传感器把世界变成一格格数字，可你还看不懂它们。",
        "en": "Your sensor turns the world into a grid of numbers, but you cannot read them yet."
      },
      {
        "zh": "母舰会给你一系列测试。每通过一个，你就多一个可以用的元件。",
        "en": "The mothership will send you a series of tests. Each one you pass gives you a new part to use."
      },
      {
        "zh": "没有说明书。动手试，看测试图，读数字。",
        "en": "There is no manual. Try things, look at the test pictures, read the numbers."
      }
    ]
  },
