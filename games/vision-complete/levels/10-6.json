{
  "title": { "zh": "一排锚框" },
  "tray": "recognition",
  "after": {
    "zh": "同一套修正，在小锚框上挪得少，在大锚框上挪得多：修正量是相对的。检测器在每个位置都放几种大小、几种宽高比的锚框，一起回归、一起打分。"
  },
  "intro": [
    {
      "t": { "zh": "同一个位置常放好几个锚框，大小不同。" }
    },
    {
      "t": {
        "zh": "这一关你要做的：同一组修正作用到一排锚框上，输出一排框。"
      },
      "fig": { "test": 0, "caption": { "zh": "往右挪" } }
    }
  ],
  "tasks": [
    {
      "id": "10-6",
      "kind": "graph",
      "brief": {
        "zh": "同一处放了大中小三个锚框，排成一行。同一组修正作用到每一个上，输出三个框。"
      },
      "hint": { "zh": "一个数和一整行运算时，这个数用在每一格上。" },
      "inputs": ["cx", "cy", "w", "h", "tx", "ty", "tw", "th"],
      "inputLabels": {
        "cx": { "zh": "锚框中心 x（一排）" },
        "cy": { "zh": "锚框中心 y（一排）" },
        "w": { "zh": "锚框宽（一排）" },
        "h": { "zh": "锚框高（一排）" },
        "tx": { "zh": "修正 tx" },
        "ty": { "zh": "修正 ty" },
        "tw": { "zh": "修正 tw" },
        "th": { "zh": "修正 th" }
      },
      "outputs": ["bx", "by", "bw", "bh"],
      "outputLabels": {
        "bx": { "zh": "框中心 x" },
        "by": { "zh": "框中心 y" },
        "bw": { "zh": "框宽" },
        "bh": { "zh": "框高" }
      },
      "check": { "tolerance": 0.005 },
      "scene": "nudge",
      "tests": [
        {
          "label": { "zh": "往右挪" },
          "anchors": [
            { "cx": 8, "cy": 8, "w": 2, "h": 2 },
            { "cx": 8, "cy": 8, "w": 4, "h": 4 },
            { "cx": 8, "cy": 8, "w": 8, "h": 8 }
          ],
          "t": { "tx": 0.5, "ty": 0, "tw": 0, "th": 0 }
        },
        {
          "label": { "zh": "都变大" },
          "anchors": [
            { "cx": 8, "cy": 8, "w": 2, "h": 2 },
            { "cx": 8, "cy": 8, "w": 4, "h": 4 },
            { "cx": 8, "cy": 8, "w": 8, "h": 8 }
          ],
          "t": { "tx": 0, "ty": 0.2, "tw": 0.3, "th": 0.3 }
        }
      ],
      "hidden": [
        {
          "label": { "zh": "变扁" },
          "anchors": [
            { "cx": 8, "cy": 8, "w": 2, "h": 2 },
            { "cx": 8, "cy": 8, "w": 4, "h": 4 },
            { "cx": 8, "cy": 8, "w": 8, "h": 8 }
          ],
          "t": { "tx": -0.2, "ty": 0.1, "tw": 0.4, "th": -0.4 }
        }
      ],
      "solution": [
        "mx = arith[op=mul](tx, w)",
        "my = arith[op=mul](ty, h)",
        "ew = exp(tw)",
        "eh = exp(th)",
        "ax = arith[op=add](cx, mx)",
        "ay = arith[op=add](cy, my)",
        "sw = arith[op=mul](ew, w)",
        "sh = arith[op=mul](eh, h)",
        "bx <- ax",
        "by <- ay",
        "bw <- sw",
        "bh <- sh"
      ],
      "naive": [
        "mx = arith[op=mul](tx, w)",
        "my = arith[op=mul](ty, h)",
        "sw = arith[op=mul](tw, w)",
        "sh = arith[op=mul](th, h)",
        "ax = arith[op=add](cx, mx)",
        "ay = arith[op=add](cy, my)",
        "bw <- sw",
        "bh <- sh",
        "bx <- ax",
        "by <- ay"
      ]
    }
  ]
}
