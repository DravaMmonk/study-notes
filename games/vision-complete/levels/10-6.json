{
  "kind": "graph",
  "title": { "zh": "一排锚框", "en": "A row of anchors" },
  "brief": {
    "zh": "同一处放了大中小三个锚框，排成一行。同一组修正作用到每一个上，输出三个框。",
    "en": "Three anchors, small, medium and large, sit at the same place in a row. The same corrections apply to each; output the three boxes."
  },
  "hint": { "zh": "一个数和一整行运算时，这个数用在每一格上。", "en": "When a single number meets a whole row, it applies to every cell." },
  "after": {
    "zh": "同一套修正，在小锚框上挪得少，在大锚框上挪得多：修正量是相对的。检测器在每个位置都放几种大小、几种宽高比的锚框，一起回归、一起打分。",
    "en": "The same corrections move a small anchor a little and a large one a lot: the corrections are relative. A detector places anchors of several sizes and aspect ratios at every position, regressing and scoring them all together."
  },
  "intro": [
    {
      "t": { "zh": "同一个位置常放好几个锚框，大小不同。", "en": "Several anchors of different sizes often sit at the same position." }
    },
    {
      "t": {
        "zh": "这一关你要做的：同一组修正作用到一排锚框上，输出一排框。",
        "en": "Your task in this level: apply the same corrections to a row of anchors and output a row of boxes."
      },
      "fig": { "test": 0, "caption": { "zh": "往右挪", "en": "Nudged right" } }
    }
  ],
  "inputs": ["cx", "cy", "w", "h", "tx", "ty", "tw", "th"],
  "inputLabels": {
    "cx": { "zh": "锚框中心 x（一排）", "en": "Anchor centres x (a row)" },
    "cy": { "zh": "锚框中心 y（一排）", "en": "Anchor centres y (a row)" },
    "w": { "zh": "锚框宽（一排）", "en": "Anchor widths (a row)" },
    "h": { "zh": "锚框高（一排）", "en": "Anchor heights (a row)" },
    "tx": { "zh": "修正 tx", "en": "Correction tx" },
    "ty": { "zh": "修正 ty", "en": "Correction ty" },
    "tw": { "zh": "修正 tw", "en": "Correction tw" },
    "th": { "zh": "修正 th", "en": "Correction th" }
  },
  "outputs": ["bx", "by", "bw", "bh"],
  "outputLabels": {
    "bx": { "zh": "框中心 x", "en": "Box centre x" },
    "by": { "zh": "框中心 y", "en": "Box centre y" },
    "bw": { "zh": "框宽", "en": "Box width" },
    "bh": { "zh": "框高", "en": "Box height" }
  },
  "check": { "tolerance": 0.005 },
  "scene": "nudge",
  "tests": [
    {
      "label": { "zh": "往右挪", "en": "Nudged right" },
      "anchors": [
        { "cx": 8, "cy": 8, "w": 2, "h": 2 },
        { "cx": 8, "cy": 8, "w": 4, "h": 4 },
        { "cx": 8, "cy": 8, "w": 8, "h": 8 }
      ],
      "t": { "tx": 0.5, "ty": 0, "tw": 0, "th": 0 }
    },
    {
      "label": { "zh": "都变大", "en": "All bigger" },
      "anchors": [
        { "cx": 8, "cy": 8, "w": 2, "h": 2 },
        { "cx": 8, "cy": 8, "w": 4, "h": 4 },
        { "cx": 8, "cy": 8, "w": 8, "h": 8 }
      ],
      "t": { "tx": 0, "ty": 0.2, "tw": 0.3, "th": 0.3 }
    }
  ],
  "hidden": [
    {
      "label": { "zh": "变扁", "en": "Flattened" },
      "anchors": [
        { "cx": 8, "cy": 8, "w": 2, "h": 2 },
        { "cx": 8, "cy": 8, "w": 4, "h": 4 },
        { "cx": 8, "cy": 8, "w": 8, "h": 8 }
      ],
      "t": { "tx": -0.2, "ty": 0.1, "tw": 0.4, "th": -0.4 }
    }
  ],
  "solution": [
    "mx = arith[op=mul](tx, w)",
    "my = arith[op=mul](ty, h)",
    "ew = exp(tw)",
    "eh = exp(th)",
    "ax = arith[op=add](cx, mx)",
    "ay = arith[op=add](cy, my)",
    "sw = arith[op=mul](ew, w)",
    "sh = arith[op=mul](eh, h)",
    "bx <- ax",
    "by <- ay",
    "bw <- sw",
    "bh <- sh"
  ],
  "naive": [
    "mx = arith[op=mul](tx, w)",
    "my = arith[op=mul](ty, h)",
    "sw = arith[op=mul](tw, w)",
    "sh = arith[op=mul](th, h)",
    "ax = arith[op=add](cx, mx)",
    "ay = arith[op=add](cy, my)",
    "bw <- sw",
    "bh <- sh",
    "bx <- ax",
    "by <- ay"
  ]
}
