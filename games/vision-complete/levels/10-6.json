{
  "title": { "en": "A box that counts" },
  "tray": "recognition",
  "after": {
    "en": "0.5 is the PASCAL VOC standard; COCO computes ten thresholds from 0.5 to 0.95 and averages them, so boxes have to be drawn more precisely to score."
  },
  "intro": [
    {
      "t": {
        "en": "The <part-ref to=\"iou\"></part-ref> in the tray outputs the intersection over union of two box masks: the overlap divided by the area they cover together."
      }
    },
    {
      "t": {
        "en": "Your task in this level: if the IoU is large enough the detection counts as right; output 1."
      },
      "fig": { "test": 3, "caption": { "en": "About the same" } }
    }
  ],
  "tasks": [
    {
      "id": "10-6",
      "kind": "graph",
      "brief": {
        "en": "Output 1 when the IoU of the detected box and the labelled box is above 0.5, otherwise 0."
      },
      "hint": {
        "en": "<level-ref to=\"10-1\"></level-ref>'s <part-ref to=\"iou\"></part-ref>, then a threshold."
      },
      "inputs": ["a", "b"],
      "inputLabels": {
        "a": { "en": "Detected box" },
        "b": { "en": "Labelled box" }
      },
      "outputs": ["ok"],
      "outputLabels": {
        "ok": { "en": "Counts as right" }
      },
      "scene": "boxPair",
      "setup": { "expect": "good" },
      "tests": [
        {
          "label": { "en": "Slightly off" },
          "a": [2, 2, 10, 10],
          "b": [4, 3, 12, 11]
        },
        {
          "label": { "en": "A big box round a small one" },
          "a": [1, 1, 15, 15],
          "b": [5, 5, 10, 10]
        },
        { "label": { "en": "Barely touching" }, "a": [0, 0, 8, 8], "b": [6, 6, 14, 14] },
        { "label": { "en": "About the same" }, "a": [2, 2, 12, 12], "b": [3, 3, 13, 13] }
      ],
      "hidden": [
        {
          "label": { "en": "Identical" },
          "a": [3, 4, 9, 12],
          "b": [3, 4, 9, 12]
        },
        { "label": { "en": "Not overlapping" }, "a": [0, 0, 5, 5], "b": [8, 8, 14, 14] }
      ],
      "solution": [
        "i = iou(a, b)",
        "t = threshold(i)",
        "ok <- t"
      ],
      "naive": [
        "i = iou(a, b)",
        "ok <- i"
      ]
    }
  ]
}
