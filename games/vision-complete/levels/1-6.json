{
  "title": { "zh": "台阶在哪" },
  "tray": "pipeline",
  "after": {
    "zh": "边缘就是相邻像素的差。平坦处差为 0，台阶处差最大。「右边邻居 − 自己」只看得见竖着的边；横着的边，要看「下边邻居 − 自己」。真实的边朝哪个方向都有，两个方向都得量。"
  },
  "intro": [
    {
      "t": {
        "zh": "看一幅画，最先注意到的是轮廓：物体和背景的分界、衣服的褶、文字的笔画。在数字图里，这些地方的共同点是：亮度在很短的距离内突然变了。这就是<b>边缘</b>。"
      }
    },
    {
      "t": {
        "zh": "找边缘是视觉里最基础的一步。扫描软件靠它找纸张的四边，车道保持系统靠它找车道线。"
      }
    },
    {
      "t": {
        "zh": "这一关你要做的：每一格输出「右边邻居 − 自己」。结果可以是负数，看灰度不直观，用地形画法看起伏更清楚。"
      },
      "fig": { "test": 0, "view": "terrain", "caption": { "zh": "第一组测试：台阶，用地形画法看" } }
    }
  ],
  "unlocks": ["diffx"],
  "tasks": [
    {
      "id": "1-6",
      "kind": "graph",
      "brief": {
        "zh": "在亮度突然变化的地方输出变化量：输出 = 右边邻居 − 自己。"
      },
      "views": { "in": "slope", "out": "terrain", "mid": "terrain" },
      "scene": "filter",
      "setup": { "target": "diffx" },
      "tests": [
        { "label": { "zh": "台阶" }, "in": { "stepX": { "edge": 8 } } },
        {
          "label": { "zh": "反过来的台阶" },
          "in": { "stepX": { "edge": 8, "lo": 0.85, "hi": 0.15 } }
        },
        { "label": { "zh": "平坦" }, "in": { "blank": { "v": 0.6 } } },
        { "label": { "zh": "方块" }, "in": "square" },
        { "label": { "zh": "斜坡" }, "in": "rampX" },
        { "label": { "zh": "字母 L" }, "in": { "glyph": { "letter": "L" } } }
      ],
      "hidden": [
        {
          "label": { "zh": "亮到暗的台阶" },
          "in": { "stepX": { "edge": 5, "lo": 0.85, "hi": 0.15 } }
        },
        {
          "label": { "zh": "挪开的字母 F" },
          "in": { "glyph": { "letter": "F", "lo": 0.1, "hi": 0.9, "ox": 6, "oy": 4 } }
        },
        { "label": { "zh": "随机纹理" }, "in": { "noise": { "seed": 17 } } }
      ],
      "solution": ["l = shift[dir=left](in)", "d = arith[op=sub](l, in)", "out <- d"],
      "naive": ["l = shift[dir=right](in)", "d = arith[op=sub](l, in)", "out <- d"]
    }
  ]
}
