{
  "title": { "zh": "分两次缩" },
  "tray": "pipeline",
  "after": {
    "zh": "小模糊、减半，再小模糊、减半：每一层都只做便宜的事，越往下越便宜。这样一层层缩小的图叫图像金字塔，缩略图、多尺度的特征检测都靠它。"
  },
  "intro": [
    {
      "t": {
        "zh": "服务器每天要做成千上万张缩略图，计算量就是电费。这一关开始有预算。"
      }
    },
    {
      "t": {
        "zh": "计算量按输出的每个像素算：同一个元件放在只有四分之一大的图上，只花四分之一。"
      }
    },
    {
      "t": {
        "zh": "这一关你要做的：还是 32×32 缩成 8×8，计算量不超过 18。要想的问题：大的模糊为什么贵？"
      },
      "fig": { "test": 0, "caption": { "zh": "第一组：斑马板" } }
    }
  ],
  "tasks": [
    {
      "id": "2-15",
      "kind": "graph",
      "brief": {
        "zh": "还是 32×32 缩成 8×8，但计算量不能超过 18。在小图上做事比在大图上便宜：图只有四分之一大时，同样的元件只花四分之一。"
      },
      "hint": {
        "zh": "大的模糊很贵。缩小一半以后，图上的一格相当于原来的两格。"
      },
      "check": { "tolerance": 0.1, "mismatches": 3 },
      "constraint": { "cost": { "max": 18 } },
      "scene": "filter",
      "setup": { "target": { "pyramid": { "levels": 2 } } },
      "tests": [
        { "label": { "zh": "斑马板" }, "in": { "zonePlate": { "k": 0.06, "A": 0.4 } } },
        { "label": { "zh": "布纹" }, "in": { "fabric": { "period": 3, "angle": 30 } } },
        {
          "label": { "zh": "字母 F" },
          "in": { "glyph": { "letter": "F", "lo": 0.15, "hi": 0.85, "ox": 4, "oy": 4, "scale": 5, "size": 32 } }
        }
      ],
      "hidden": [
        {
          "label": { "zh": "偏心斑马板" },
          "in": { "zonePlate": { "k": 0.05, "cx": 10, "cy": 20, "A": 0.4 } }
        },
        { "label": { "zh": "细布纹" }, "in": { "fabric": { "period": 2.5, "angle": 75 } } }
      ],
      "solution": [
        "n0 = gauss[border=edge](in)",
        "n1 = downsample(n0)",
        "n2 = gauss[border=edge](n1)",
        "n3 = downsample(n2)",
        "out <- n3"
      ],
      "naive": ["n0 = gauss[sigma=2, border=edge](in)", "n1 = downsample(n0)", "n2 = downsample(n1)", "out <- n2"]
    }
  ]
}
