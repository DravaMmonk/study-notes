{
  "title": { "zh": "两线交点" },
  "tray": "geometry",
  "after": {
    "zh": "两次叉积就找到了交点，不用解方程。三个数 (X, Y, W) 表示点 (X/W, Y/W)；两条线平行时 W = 0，交点在无穷远处，齐次坐标照样写得出来。"
  },
  "intro": [
    {
      "t": {
        "zh": "托盘里的<part-ref to=\"cross\"></part-ref>输出两个三维向量的叉积 a × b。"
      }
    },
    {
      "t": {
        "zh": "这一关你要做的：每条线给出它上面的两个点，输出两条线的交点。"
      },
      "fig": { "test": 0, "caption": { "zh": "第一组：十字" } }
    }
  ],
  "tasks": [
    {
      "id": "7-6",
      "kind": "graph",
      "brief": {
        "zh": "每个点写成 (x, y, 1)。线一过 p、q，线二过 r、s。输出两条线的交点，也写成三个数（不必把第三个数化成 1）。"
      },
      "hint": { "zh": "叉积能从两个点得到一条线。" },
      "inputs": ["p", "q", "r", "s"],
      "inputLabels": {
        "p": { "zh": "线一上的点 p" },
        "q": { "zh": "线一上的点 q" },
        "r": { "zh": "线二上的点 r" },
        "s": { "zh": "线二上的点 s" }
      },
      "scene": "filter",
      "setup": { "target": "meet" },
      "tests": [
        {
          "label": { "zh": "十字" },
          "inputs": {
            "p": { "row": { "values": [0, 2, 1] } },
            "q": { "row": { "values": [4, 2, 1] } },
            "r": { "row": { "values": [1, 0, 1] } },
            "s": { "row": { "values": [1, 5, 1] } }
          }
        },
        {
          "label": { "zh": "两条斜线" },
          "inputs": {
            "p": { "row": { "values": [0, 0, 1] } },
            "q": { "row": { "values": [4, 4, 1] } },
            "r": { "row": { "values": [0, 4, 1] } },
            "s": { "row": { "values": [4, 0, 1] } }
          }
        },
        {
          "label": { "zh": "交在外面" },
          "inputs": {
            "p": { "row": { "values": [0, 0, 1] } },
            "q": { "row": { "values": [1, 2, 1] } },
            "r": { "row": { "values": [3, 0, 1] } },
            "s": { "row": { "values": [4, 1, 1] } }
          }
        }
      ],
      "hidden": [
        {
          "label": { "zh": "一般的" },
          "inputs": {
            "p": { "row": { "values": [1, 1, 1] } },
            "q": { "row": { "values": [3, 2, 1] } },
            "r": { "row": { "values": [0, 5, 1] } },
            "s": { "row": { "values": [2, 1, 1] } }
          }
        }
      ],
      "solution": ["l1 = cross(p, q)", "l2 = cross(r, s)", "x = cross(l1, l2)", "out <- x"],
      "naive": ["l1 = cross(p, q)", "out <- l1"]
    }
  ]
}
