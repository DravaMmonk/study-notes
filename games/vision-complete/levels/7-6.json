{
  "title": { "en": "Where two lines meet" },
  "tray": "geometry",
  "after": {
    "en": "Two cross products find the meeting point with no equations to solve. Three numbers (X, Y, W) stand for the point (X/W, Y/W); when the lines are parallel W = 0 and they meet at infinity, which homogeneous coordinates can still write down."
  },
  "intro": [
    {
      "t": {
        "en": "The <part-ref to=\"cross\"></part-ref> in the tray outputs the cross product a × b of two 3-vectors."
      }
    },
    {
      "t": {
        "en": "Your task in this level: each line is given by two points on it; output where the two lines meet."
      },
      "fig": { "test": 0, "caption": { "en": "Set 1: a cross" } }
    }
  ],
  "tasks": [
    {
      "id": "7-6",
      "kind": "graph",
      "brief": {
        "en": "Each point is written (x, y, 1). Line 1 passes through p and q, line 2 through r and s. Output where the two lines meet, also as three numbers (no need to make the third one 1)."
      },
      "hint": { "en": "The cross product turns two points into a line." },
      "inputs": ["p", "q", "r", "s"],
      "inputLabels": {
        "p": { "en": "Point p on line 1" },
        "q": { "en": "Point q on line 1" },
        "r": { "en": "Point r on line 2" },
        "s": { "en": "Point s on line 2" }
      },
      "scene": "filter",
      "setup": { "target": "meet" },
      "tests": [
        {
          "label": { "en": "A cross" },
          "inputs": {
            "p": { "row": { "values": [0, 2, 1] } },
            "q": { "row": { "values": [4, 2, 1] } },
            "r": { "row": { "values": [1, 0, 1] } },
            "s": { "row": { "values": [1, 5, 1] } }
          }
        },
        {
          "label": { "en": "Two slants" },
          "inputs": {
            "p": { "row": { "values": [0, 0, 1] } },
            "q": { "row": { "values": [4, 4, 1] } },
            "r": { "row": { "values": [0, 4, 1] } },
            "s": { "row": { "values": [4, 0, 1] } }
          }
        },
        {
          "label": { "en": "Meeting outside" },
          "inputs": {
            "p": { "row": { "values": [0, 0, 1] } },
            "q": { "row": { "values": [1, 2, 1] } },
            "r": { "row": { "values": [3, 0, 1] } },
            "s": { "row": { "values": [4, 1, 1] } }
          }
        }
      ],
      "hidden": [
        {
          "label": { "en": "General" },
          "inputs": {
            "p": { "row": { "values": [1, 1, 1] } },
            "q": { "row": { "values": [3, 2, 1] } },
            "r": { "row": { "values": [0, 5, 1] } },
            "s": { "row": { "values": [2, 1, 1] } }
          }
        }
      ],
      "solution": ["l1 = cross(p, q)", "l2 = cross(r, s)", "x = cross(l1, l2)", "out <- x"],
      "naive": ["l1 = cross(p, q)", "out <- l1"]
    }
  ]
}
