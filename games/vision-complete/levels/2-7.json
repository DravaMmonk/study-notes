          "out <- f"
        ],
        [
          "nN = const[c=-1]()",
          "oN = const[c=8]()",
          "scN = const[c=\"pi/8\"]()",
          "hfN = const[c=0.5]()",
          "upN = const[c=0.5]()",
          "n = arith[op=mul](r, nN)",
          "sc = arith[op=mul](r, scN)",
          "o = arith[op=add](n, oN)",
          "cs = cos(sc)",
          "t = threshold[t=0](o)",
          "hf = arith[op=mul](cs, hfN)",
          "up = arith[op=add](hf, upN)",
