          "t = threshold[t=0](o)",
          "f = fqApply(in, t)",
          "out <- f"
        ],
        [
          "nN = const[c=-1]()",
          "oN = const[c=8]()",
          "n = arith[op=mul](r, nN)",
          "o = arith[op=add](n, oN)",
