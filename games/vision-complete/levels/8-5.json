{
  "title": { "en": "Draw a new blob" },
  "tray": "generative",
  "after": {
    "en": "Once trained, generating is just: draw a random z and hand it to the decoder. Each draw is a new picture never seen before; μ and σ decide roughly where the new pictures fall."
  },
  "intro": [
    {
      "t": {
        "en": "The Reparameterization in the tray: μ, σ and ε go in, μ + σ·ε comes out."
      }
    },
    {
      "t": {
        "en": "Your task in this level: draw a z from the μ, σ and noise ε in the input, and draw its blob."
      },
      "fig": { "test": 0, "caption": { "en": "The first draw" } }
    }
  ],
  "tasks": [
    {
      "id": "8-5",
      "kind": "graph",
      "brief": {
        "en": "Draw a z from N(μ, σ²) and hand it to the decoder. Use the noise ε from the input to draw it."
      },
      "hint": {
        "en": "The part you got at the end of <level-ref to=\"8-4\"></level-ref> is exactly \"draw a sample using ε\"."
      },
      "inputs": ["eps", "mu", "sigma"],
      "inputLabels": {
        "eps": { "en": "Noise ε" },
        "mu": { "en": "Centre μ" },
        "sigma": { "en": "Spread σ" }
      },
      "check": { "tolerance": 0.05, "mismatches": 2 },
      "scene": "latent",
      "setup": { "mu": [-0.5, 0.5], "sigma": [0.3, 0.2], "given": true },
      "tests": [
        { "label": { "en": "Draw 1" }, "eps": [0.28973564283829173, 0.820593686981651] },
        { "label": { "en": "Draw 2" }, "eps": [0.26643152109291685, -0.8063291663537127] },
        { "label": { "en": "Draw 3" }, "eps": [0.344640573865604, -1.1584939815703774] }
      ],
      "hidden": [
        { "label": { "en": "Another draw 1" }, "eps": [-0.8284021851297076, 0.1198486162980997] },
        { "label": { "en": "Another draw 2" }, "eps": [-0.7811526515231816, 0.318111758472477] }
      ],
      "solution": ["r = dg_reparam(mu, sigma, eps)", "d = dg_decoder(r)", "out <- d"],
      "naive": ["d = dg_decoder(mu)", "out <- d"]
    }
  ]
}
