      "kind": "graph",
      "brief": {
        "zh": "换了一台双目相机，焦距 f 和基线 b 每组测试都不一样。把视差图换成距离图。"
      },
      "hint": {
        "zh": "<level-ref to=\"7-3\"></level-ref>的 3 是哪两个数相乘来的？"
      },
      "inputs": ["d", "f", "b"],
      "inputLabels": {
        "d": { "zh": "视差（像素）" },
        "f": { "zh": "焦距 f" },
        "b": { "zh": "基线 b" }
      },
      "views": { "in": "terrain", "out": "terrain" },
      "scene": "depth",
      "tests": [
        {
          "label": { "zh": "长焦" },
          "seed": 41,
          "layers": [{ "box": [5, 4, 11, 12], "d": 2 }],
          "f": 4,
          "b": 1.5
        },
        {
          "label": { "zh": "基线窄" },
          "seed": 42,
          "layers": [{ "box": [7, 2, 10, 14], "d": 3 }],
          "f": 2,
          "b": 0.5
        },
        {
          "label": { "zh": "都变了" },
          "seed": 43,
          "layers": [{ "box": [3, 3, 10, 10], "d": 2 }, { "box": [6, 7, 13, 14], "d": 3 }],
          "f": 6,
          "b": 0.75
        }
      ],
      "hidden": [
        {
          "label": { "zh": "广角" },
          "seed": 41,
          "layers": [{ "box": [5, 4, 11, 12], "d": 2 }],
          "f": 1.5,
          "b": 2
        }
      ],
      "solution": ["fb = arith[op=mul](f, b)", "q = arith[op=div](fb, d)", "out <- q"],
      "naive": ["q = arith[op=div](f, d)", "out <- q"]
