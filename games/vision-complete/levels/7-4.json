{
  "title": { "en": "A different camera" },
  "tray": "geometry",
  "after": {
    "en": "Only the product f·b matters: double the focal length and halve the baseline and the distances come out exactly the same. When choosing a camera, this product is what to compare."
  },
  "intro": [
    {
      "t": {
        "en": "Switch to a different stereo camera: both the lens and the distance between the two cameras change."
      }
    },
    {
      "t": {
        "en": "Your task in this level: each test gives the focal length f and the baseline b; turn the disparity map into a distance map."
      },
      "fig": { "test": 0, "view": "terrain", "caption": { "en": "Set 1: a longer lens" } }
    }
  ],
  "tasks": [
    {
      "id": "7-4",
      "kind": "graph",
      "brief": {
        "en": "A different stereo camera: the focal length f and the baseline b change from test to test. Turn the disparity map into a distance map."
      },
      "hint": {
        "en": "Which two numbers multiplied together made <level-ref to=\"7-3\"></level-ref>'s 3?"
      },
      "inputs": ["d", "f", "b"],
      "inputLabels": {
        "d": { "en": "Disparity (pixels)" },
        "f": { "en": "Focal length f" },
        "b": { "en": "Baseline b" }
      },
      "views": { "in": "terrain", "out": "terrain" },
      "scene": "depth",
      "tests": [
        {
          "label": { "en": "A longer lens" },
          "seed": 41,
          "layers": [{ "box": [5, 4, 11, 12], "d": 2 }],
          "f": 4,
          "b": 1.5
        },
        {
          "label": { "en": "A narrow baseline" },
          "seed": 42,
          "layers": [{ "box": [7, 2, 10, 14], "d": 3 }],
          "f": 2,
          "b": 0.5
        },
        {
          "label": { "en": "Both changed" },
          "seed": 43,
          "layers": [{ "box": [3, 3, 10, 10], "d": 2 }, { "box": [6, 7, 13, 14], "d": 3 }],
          "f": 6,
          "b": 0.75
        }
      ],
      "hidden": [
        {
          "label": { "en": "Wide angle" },
          "seed": 41,
          "layers": [{ "box": [5, 4, 11, 12], "d": 2 }],
          "f": 1.5,
          "b": 2
        }
      ],
      "solution": ["fb = arith[op=mul](f, b)", "q = arith[op=div](fb, d)", "out <- q"],
      "naive": ["q = arith[op=div](f, d)", "out <- q"]
    }
  ]
}
