{
  "title": { "en": "Draw it on the side asked for" },
  "tray": "generative",
  "after": {
    "en": "Give the generator one more input, a condition, and it draws what is asked for: this is called conditional generation. Text prompts like \"draw a cat\" or \"in watercolour\" are just more elaborate conditions."
  },
  "intro": [
    {
      "t": {
        "en": "What a generator draws is random. To make it draw what is asked for, it has to be told something more."
      }
    },
    {
      "t": {
        "en": "Your task in this level: when c = 0, draw the blob in the region on the left; when c = 1, on the right."
      },
      "fig": { "test": 0, "caption": { "en": "Set 1: left" } }
    }
  ],
  "tasks": [
    {
      "id": "8-9",
      "kind": "graph",
      "brief": {
        "en": "When c = 0, draw a blob from the region on the left; when c = 1, from the region on the right."
      },
      "hint": {
        "en": "The same sampling, only with a different centre. Can the centre be worked out from c?"
      },
      "inputs": ["eps", "c", "left", "right", "sigma"],
      "inputLabels": {
        "eps": { "en": "Noise ε" },
        "c": { "en": "Which side c (0 left, 1 right)" },
        "left": { "en": "Centre on the left" },
        "right": { "en": "Centre on the right" },
        "sigma": { "en": "Spread σ" }
      },
      "check": { "tolerance": 0.05, "mismatches": 2 },
      "scene": "sides",
      "setup": { "left": [-1, 0], "right": [1, 0], "sigma": [0.3, 0.3] },
      "tests": [
        { "label": { "en": "Left" }, "eps": [0.014608022670355346, 1.023152153693789], "c": 0 },
        { "label": { "en": "Right" }, "eps": [2.6198792344586073, -0.3578478790713314], "c": 1 },
        { "label": { "en": "Right again" }, "eps": [0.9199123669572353, -1.7435470447785244], "c": 1 }
      ],
      "hidden": [{ "label": { "en": "Left again" }, "eps": [0.0390086011845821, 0.9110642857758415], "c": 0 }],
      "solution": [
        "one = const()",
        "oc = arith[op=sub](one, c)",
        "wr = arith[op=mul](right, c)",
        "wl = arith[op=mul](left, oc)",
        "mu = arith[op=add](wl, wr)",
        "r = dg_reparam(mu, sigma, eps)",
        "d = dg_decoder(r)",
        "out <- d"
      ],
      "naive": ["r = dg_reparam(left, sigma, eps)", "d = dg_decoder(r)", "out <- d"]
    }
  ]
}
