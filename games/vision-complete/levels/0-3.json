{
  "title": { "zh": "斜着挪两格" },
  "tray": "pipeline",
  "after": {
    "zh": "元件可以一个接一个地串起来：前一个的输出就是后一个的输入。几个简单的元件串在一起，能做到单个元件做不到的事，这就是电路。"
  },
  "intro": [
    {
      "t": {
        "zh": "平移元件每次只把图挪一格。可要挪的，常常不止一格。"
      }
    },
    {
      "t": {
        "zh": "一个元件的输出，可以接到另一个元件的输入上：前一个算完，后一个接着算。"
      }
    },
    {
      "t": {
        "zh": "这一关你要做的：把整张图往右挪两格、往下挪两格。"
      },
      "fig": { "test": 0, "caption": { "zh": "第一组测试：方块和挪过的方块" } }
    }
  ],
  "tasks": [
    {
      "id": "0-3",
      "kind": "graph",
      "brief": { "zh": "把整张图往右挪两格，再往下挪两格。" },
      "hint": {
        "zh": "一个平移元件只挪一格。它的输出可以接到另一个元件的输入。"
      },
      "scene": "filter",
      "setup": { "target": { "shift": { "dx": 2, "dy": 2 } } },
      "tests": [
        { "label": { "zh": "方块" }, "in": "square" },
        { "label": { "zh": "圆盘" }, "in": "disk" },
        { "label": { "zh": "字母 T" }, "in": { "glyph": { "letter": "T" } } },
        { "label": { "zh": "棋盘" }, "in": "checker" }
      ],
      "hidden": [
        {
          "label": { "zh": "挪开的字母 L" },
          "in": { "glyph": { "letter": "L", "lo": 0.1, "hi": 0.9, "ox": 5, "oy": 2 } }
        },
        { "label": { "zh": "随机纹理" }, "in": { "noise": { "seed": 5 } } }
      ],
      "solution": [
        "a = shift[dir=right](in)",
        "b = shift[dir=right](a)",
        "c = shift[dir=down](b)",
        "d = shift[dir=down](c)",
        "out <- d"
      ],
      "naive": ["a = shift[dir=right](in)", "c = shift[dir=down](a)", "out <- c"]
    }
  ]
}
