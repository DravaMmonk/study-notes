{
  "title": { "en": "The same question" },
  "tray": "pipeline",
  "after": {
    "en": "When every patch asks with the same query (all ones), the score depends only on each patch's total, and they all look at the same patch. ViT puts an extra learnable [CLS] patch in front of the others; its query is trained to ask on behalf of the whole picture, and only its output is read to classify."
  },
  "intro": [
    {
      "t": {
        "en": "In self-attention every patch asks with itself, so each asks its own question."
      }
    },
    {
      "t": {
        "en": "Your task in this level: replace every patch with the brightest patch in the picture, the one whose cells add up to the most."
      },
      "fig": { "test": 0, "caption": { "en": "First set" } }
    }
  ],
  "tasks": [
    {
      "id": "5-6",
      "kind": "graph",
      "brief": {
        "en": "Replace every patch with the brightest patch in the picture (the one whose cells add up to the most)."
      },
      "hint": {
        "en": "In self-attention, each patch asks with itself. What if every patch asked the same question?"
      },
      "scene": "brightest",
      "tests": [
        {
          "label": { "en": "First set" },
          "items": [
            { "tile": "X", "at": [0, 0], "hi": 0.9 },
            { "tile": "C", "at": [1, 2], "hi": 0.6 },
            { "tile": "P", "at": [3, 1], "hi": 0.5 }
          ]
        },
        {
          "label": { "en": "Second set" },
          "items": [
            { "tile": "K", "at": [2, 3], "hi": 0.4 },
            { "tile": "S", "at": [0, 1], "hi": 0.8 },
            { "tile": "R", "at": [3, 3], "hi": 0.7 }
          ]
        },
        {
          "label": { "en": "Third set" },
          "items": [
            { "tile": "C", "at": [1, 1], "hi": 0.9 },
            { "tile": "X", "at": [2, 2], "hi": 0.3 },
            { "tile": "P", "at": [0, 3], "hi": 0.6 },
            { "tile": "R", "at": [3, 0], "hi": 0.5 }
          ]
        }
      ],
      "hidden": [
        {
          "label": { "en": "Fourth set" },
          "items": [
            { "tile": "R", "at": [0, 0], "hi": 0.5 },
            { "tile": "S", "at": [3, 2], "hi": 0.6 },
            { "tile": "X", "at": [1, 3], "hi": 0.9 }
          ]
        }
      ],
      "solution": [
        "zk = const[c=0]()",
        "ok = const()",
        "z = arith[op=mul](in, zk)",
        "o = arith[op=add](z, ok)",
        "a = attention[s=40](o, in, in)",
        "out <- a"
      ],
      "naive": ["a = attention[s=40](in)", "out <- a"]
    }
  ]
