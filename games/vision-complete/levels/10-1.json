{
  "title": { "zh": "重叠多少" },
  "tray": "recognition",
  "after": {
    "zh": "IoU 在 0 到 1 之间：1 是完全重合，0 是不沾边。检测器画的框和标注的框 IoU 够大，才算找对了。"
  },
  "intro": [
    {
      "t": {
        "zh": "检测器的每个结果有三样：类别（是什么）、置信度（有多确定）和边界框（在哪、多大）。框得准不准，要和人标注的框比。"
      }
    },
    {
      "t": {
        "zh": "这一关你要做的：两个框画成掩膜，输出它们的交并比，公式在说明里。"
      },
      "fig": { "test": 0, "caption": { "zh": "第一组：错开一点" } }
    }
  ],
  "packs": {
    "name": { "zh": "IoU" },
    "desc": {
      "zh": "输出两个框掩膜的交并比：重叠面积除以合起来的面积。"
    }
  },
  "tasks": [
    {
      "id": "10-1",
      "kind": "graph",
      "brief": {
        "zh": "两个框画成掩膜（框里是 1）。输出它们的交并比 IoU = 交集的面积 ÷ 并集的面积。"
      },
      "hint": {
        "zh": "交集是两张掩膜逐格相乘。并集 = 两个面积相加，再减去重复算的那部分。<part-ref to=\"mean\"></part-ref>量出的面积都差同一个倍数。"
      },
      "inputs": ["a", "b"],
      "inputLabels": { "a": { "zh": "框 a" }, "b": { "zh": "框 b" } },
      "check": { "tolerance": 0.005 },
      "scene": "boxPair",
      "setup": { "expect": "iou" },
      "tests": [
        { "label": { "zh": "错开一点" }, "a": [2, 2, 10, 10], "b": [4, 3, 12, 11] },
        { "label": { "zh": "大框套小框" }, "a": [1, 1, 15, 15], "b": [5, 5, 10, 10] },
        { "label": { "zh": "只碰到边" }, "a": [0, 0, 8, 8], "b": [6, 6, 14, 14] }
      ],
      "hidden": [
        { "label": { "zh": "一模一样" }, "a": [3, 4, 9, 12], "b": [3, 4, 9, 12] },
        { "label": { "zh": "不重叠" }, "a": [0, 0, 5, 5], "b": [8, 8, 14, 14] }
      ],
      "solution": [
        "i = arith[op=mul](a, b)",
        "ma = fqMean(a)",
        "mb = fqMean(b)",
        "mi = fqMean(i)",
        "s = arith[op=add](ma, mb)",
        "u = arith[op=sub](s, mi)",
        "q = arith[op=div](mi, u)",
        "out <- q"
      ],
      "naive": ["i = arith[op=mul](a, b)", "ma = fqMean(a)", "mi = fqMean(i)", "q = arith[op=div](mi, ma)", "out <- q"]
    }
  ]
}
