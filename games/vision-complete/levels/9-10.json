{
  "title": { "en": "Segmenting cells" },
  "tray": "recognition",
  "after": {
    "en": "An adaptive boundary, a coarse path that removes grain, a skip connection that keeps detail: a small U-Net-style pipeline. Real cell-segmentation networks replace every step with learnt convolutions, but the structure stays the same."
  },
  "intro": [
    {
      "t": {
        "en": "A batch of slides comes from different microscopes and stains: some dark overall, some bright."
      }
    },
    {
      "t": {
        "en": "Your task in this level: mark the cells on every slide, keeping the gaps."
      },
      "fig": { "test": 1, "caption": { "en": "Set 2: a bright slide" } }
    }
  ],
  "tasks": [
    {
      "id": "9-10",
      "kind": "graph",
      "brief": {
        "en": "A batch of microscope slides, each with its own brightness and contrast, with cells touching. Mark the cells, and keep the gaps between them."
      },
      "hint": { "en": "A fixed threshold cannot be right on both dark slides and bright ones." },
      "check": { "tolerance": 0.1, "mismatches": 4 },
      "scene": "cells",
      "tests": [
        {
          "label": { "en": "A dark slide" },
          "rects": [[2, 2, 14, 9]],
          "gapX": [7],
          "seed": 81,
          "cell": 0.5,
          "back": 0.2,
          "grain": 0.1
        },
        {
          "label": { "en": "A bright slide" },
          "rects": [[1, 3, 9, 15], [11, 1, 15, 7]],
          "gapY": [9],
          "seed": 82,
          "cell": 0.95,
          "back": 0.55,
          "grain": 0.1
        },
        {
          "label": { "en": "A row of cells" },
          "rects": [[1, 5, 15, 12]],
          "gapX": [5, 9],
          "seed": 83,
          "cell": 0.7,
          "back": 0.35,
          "grain": 0.1
        }
      ],
      "hidden": [
        {
          "label": { "en": "Low contrast" },
          "rects": [[2, 2, 14, 14]],
          "gapX": [7],
          "gapY": [7],
          "seed": 84,
          "cell": 0.6,
          "back": 0.35,
          "grain": 0.08
        }
      ],
      "solution": [
        "k0 = const[c=0.5]()",
        "a1 = kmeansStep(in, k0)",
        "a2 = kmeansStep(in, a1)",
        "a3 = kmeansStep(in, a2)",
        "n = arith[op=sub](in, a3)",
        "a = kernel3[w=[0, 0, 0, 0, 0.25, 0.25, 0, 0.25, 0.25]](n)",
        "f = threshold[t=0](n)",
        "s = downsample(a)",
        "c = threshold[t=-0.13](s)",
        "u = tconv(c)",
        "m = arith[op=mul](u, f)",
        "out <- m"
      ],
      "naive": [
        "k0 = const[c=0.5]()",
        "n = arith[op=sub](in, k0)",
        "a = kernel3[w=[0, 0, 0, 0, 0.25, 0.25, 0, 0.25, 0.25]](n)",
        "f = threshold[t=0](n)",
        "s = downsample(a)",
        "c = threshold[t=-0.13](s)",
        "u = tconv(c)",
        "m = arith[op=mul](u, f)",
        "out <- m"
      ]
    }
  ]
}
