            { "tile": "P", "at": [1, 0] }
          ]
        },
        {
          "label": { "zh": "右上缺" },
          "items": [
            { "tile": "S", "at": [0, 1], "erased": [[3, 3], [2, 3], [3, 1]] },
            { "tile": "S", "at": [1, 0] },
            { "tile": "K", "at": [0, 0] },
            { "tile": "R", "at": [1, 1] }
          ]
        },
        {
          "label": { "zh": "右下缺" },
          "items": [
