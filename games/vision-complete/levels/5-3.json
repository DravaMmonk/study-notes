{
  "title": { "en": "How big a patch" },
  "tray": "pipeline",
  "after": {
    "en": "The number of patches is the number of pixels ÷ P², and the cost of attention grows with it; but bigger patches are too coarse to see anything but large structure. ViT cuts a 224×224 image into 16×16 patches, exactly 196 of them: a compromise between cost and detail."
  },
  "intro": [
    {
      "t": {
        "en": "In attention, every cell adds up over all the patches. The smaller the patches, the more of them there are, and the more there is to compute."
      }
    },
    {
      "t": {
        "en": "<part-ref to=\"attention\"></part-ref> has gained a setting: the patch size P, which can be 2, 4 or 8."
      }
    },
    {
      "t": {
        "en": "Your task in this level: the patterns are now 8×8, four to a picture, and it is mending across the diagonal again; the cost has a limit."
      },
      "fig": {
        "test": 0,
        "caption": { "en": "Set 1: the top-left pattern is missing a few blocks" }
      }
    }
  ],
  "tasks": [
    {
      "id": "5-3",
      "kind": "graph",
      "brief": {
        "en": "Mending across the diagonal again, this time with 8×8 patterns, four to a picture. The cost must not exceed 10."
      },
      "hint": {
        "en": "Each cell of attention adds up over every patch. The bigger the patches, the fewer there are."
      },
      "constraint": { "cost": { "max": 10 } },
      "scene": "mend",
      "setup": { "scale": 2 },
      "tests": [
        {
          "label": { "en": "Top left erased" },
          "items": [
            { "tile": "X", "at": [0, 0], "erased": [[0, 0], [1, 1]] },
            { "tile": "X", "at": [1, 1] },
            { "tile": "C", "at": [0, 1] },
            { "tile": "P", "at": [1, 0] }
          ]
        },
        {
          "label": { "en": "Top right erased" },
          "items": [
            { "tile": "S", "at": [0, 1], "erased": [[3, 3], [2, 3], [3, 1]] },
            { "tile": "S", "at": [1, 0] },
            { "tile": "K", "at": [0, 0] },
            { "tile": "R", "at": [1, 1] }
          ]
        },
        {
          "label": { "en": "Bottom right erased" },
          "items": [
            { "tile": "R", "at": [0, 0] },
            { "tile": "R", "at": [1, 1], "erased": [[1, 0], [0, 1]] },
            { "tile": "X", "at": [0, 1] },
            { "tile": "C", "at": [1, 0] }
          ]
        }
      ],
      "hidden": [
        {
          "label": { "en": "Bottom left erased" },
          "items": [
            { "tile": "K", "at": [1, 0], "erased": [[0, 0], [1, 1], [3, 3]] },
            { "tile": "K", "at": [0, 1] },
            { "tile": "S", "at": [0, 0] },
            { "tile": "P", "at": [1, 1] }
          ]
        },
        {
          "label": { "en": "Nothing erased" },
          "items": [
            { "tile": "C", "at": [0, 0] },
            { "tile": "C", "at": [1, 1] },
            { "tile": "R", "at": [0, 1] },
            { "tile": "X", "at": [1, 0] }
          ]
        }
      ],
      "solution": ["a = attention[s=8, P=8](in)", "t = threshold[t=0.3](a)", "out <- t"],
      "naive": ["a = attention[s=8](in)", "t = threshold[t=0.3](a)", "out <- t"],
      "alsoFails": [["a = attention[s=8, P=2](in)", "t = threshold[t=0.3](a)", "out <- t"]]
    }
  ]
}
