{
  "title": { "zh": "两个头", "en": "Two heads" },
  "after": {
    "zh": "每个注意力只能按一种相似去找。多头注意力并排放几个注意力，各自用自己的 Q、K 找一种关系，再把结果拼在一起。Transformer 的每一层都有好几个头。",
    "en": "Each attention can only look for one kind of likeness. Multi-head attention puts several side by side, each finding one kind of relation with its own Q and K, and then puts their results together. Every layer of a Transformer has several heads."
  },
  "intro": [
    {
      "t": {
        "zh": "一个注意力按一种「像」去找：Q 和 K 从哪张图来，它就按那张图比。",
        "en": "One attention looks for one kind of likeness: whichever picture Q and K come from, that is the picture it compares by."
      }
    },
    {
      "t": {
        "zh": "这一关你要做的：两张图各有一个图案被擦掉几格，孪生图案在各自图里的别处。两个输出分别补好两张图。",
        "en": "Your task in this level: each of two pictures has a pattern with a few pixels erased, and its twin is elsewhere in the same picture. The two outputs are the two pictures mended."
      },
      "fig": { "test": 0, "caption": { "zh": "第一组", "en": "Set 1" } }
    }
  ],
  "tasks": [
    {
      "id": "5-4",
      "kind": "graph",
      "brief": {
        "zh": "两张图各有一个图案被擦掉几格，它的孪生图案在同一张图的别处。两个输出分别是补好的两张图。",
        "en": "Each of two pictures has one pattern with a few pixels erased; its twin is elsewhere in the same picture. The two outputs are the two pictures mended."
      },
      "hint": {
        "zh": "一个注意力只按一种「像」去找。两张图里的孪生关系一样吗？",
        "en": "One attention looks for one kind of likeness. Do the twins pair up the same way in both pictures?"
      },
      "inputs": ["shape", "mark"],
      "inputLabels": { "shape": { "zh": "图一", "en": "Picture 1" }, "mark": { "zh": "图二", "en": "Picture 2" } },
      "outputs": ["so", "mo"],
      "outputLabels": { "so": { "zh": "补好的图一", "en": "Picture 1 mended" }, "mo": { "zh": "补好的图二", "en": "Picture 2 mended" } },
      "scene": "mendTwo",
      "tests": [
        {
          "label": { "zh": "第一组", "en": "Set 1" },
          "shape": [
            { "tile": "X", "at": [0, 0], "erased": [[0, 0], [1, 1], [3, 3]] },
            { "tile": "X", "at": [3, 3] },
            { "tile": "C", "at": [0, 3] },
            { "tile": "P", "at": [2, 1] }
          ],
          "mark": [
            { "tile": "R", "at": [1, 1] },
            { "tile": "R", "at": [2, 2], "erased": [[1, 0], [0, 1], [2, 3]] },
            { "tile": "K", "at": [0, 2] },
            { "tile": "S", "at": [3, 1] }
          ]
        },
        {
          "label": { "zh": "第二组", "en": "Set 2" },
          "shape": [
            { "tile": "S", "at": [0, 3], "erased": [[0, 3], [1, 3], [2, 2]] },
            { "tile": "S", "at": [3, 0] },
            { "tile": "X", "at": [1, 1] },
            { "tile": "R", "at": [2, 3] }
          ],
          "mark": [
            { "tile": "C", "at": [0, 0] },
            { "tile": "C", "at": [3, 3], "erased": [[0, 0], [3, 0]] },
            { "tile": "P", "at": [1, 2] },
            { "tile": "X", "at": [2, 0] }
          ]
        },
        {
          "label": { "zh": "第三组", "en": "Set 3" },
          "shape": [
            { "tile": "K", "at": [1, 0] },
            { "tile": "K", "at": [2, 3], "erased": [[0, 1], [3, 3], [2, 2]] },
            { "tile": "R", "at": [0, 0] },
            { "tile": "C", "at": [3, 2] }
          ],
          "mark": [
            { "tile": "P", "at": [0, 1], "erased": [[1, 1], [1, 3]] },
            { "tile": "P", "at": [3, 2] },
            { "tile": "S", "at": [1, 3] },
            { "tile": "K", "at": [2, 0] }
          ]
        }
      ],
      "hidden": [
        {
          "label": { "zh": "第四组", "en": "Set 4" },
          "shape": [
            { "tile": "R", "at": [0, 2], "erased": [[1, 0], [0, 1]] },
            { "tile": "R", "at": [3, 1] },
            { "tile": "P", "at": [1, 0] },
            { "tile": "S", "at": [2, 2] }
          ],
          "mark": [
            { "tile": "X", "at": [1, 1] },
            { "tile": "X", "at": [2, 3], "erased": [[0, 0], [1, 1]] },
            { "tile": "C", "at": [0, 3] },
            { "tile": "K", "at": [3, 0] }
          ]
        }
      ],
      "solution": [
        "hs = attention[s=8](shape)",
        "hm = attention[s=8](mark)",
        "ts = threshold[t=0.3](hs)",
        "tm = threshold[t=0.3](hm)",
        "so <- ts",
        "mo <- tm"
      ],
      "naive": [
        "hs = attention[s=8](shape)",
        "hm = attention[s=8](shape, shape, mark)",
        "ts = threshold[t=0.3](hs)",
        "tm = threshold[t=0.3](hm)",
        "so <- ts",
        "mo <- tm"
      ]
    }
  ]
}
