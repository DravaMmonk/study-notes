{
  "title": { "zh": "潜空间走一走" },
  "tray": "generative",
  "after": {
    "zh": "像素空间里的中间是两张图叠在一起；潜空间里的中间才是「一个斑点在中间」。训练好的编码器把图放进一个平滑的空间，在里面走直线，解码出来就是一串自然的过渡：人脸变老、换发型都是这么做的。"
  },
  "intro": [
    {
      "t": {
        "zh": "托盘里有训练好的编码器和解码器：编码器把一个斑点变成两个数，解码器把两个数画成斑点。"
      }
    },
    {
      "t": {
        "zh": "这一关你要做的：画出从斑点 a 往斑点 b 走了 t 的那个斑点。"
      },
      "fig": { "test": 0, "caption": { "zh": "第一组：一半" } }
    }
  ],
  "tasks": [
    {
      "id": "8-2",
      "kind": "graph",
      "brief": {
        "zh": "画出 a 和 b 「中间」的那个斑点：从 a 往 b 走了 t（0 是 a，1 是 b）。"
      },
      "hint": {
        "zh": "两张图逐格按比例混合，得到的是两个淡斑点。<level-ref to=\"8-1\"></level-ref>的两个数呢？"
      },
      "inputs": ["a", "b", "t"],
      "inputLabels": {
        "a": { "zh": "斑点 a" },
        "b": { "zh": "斑点 b" },
        "t": { "zh": "走到哪 t" }
      },
      "check": { "tolerance": 0.05, "mismatches": 2 },
      "scene": "walk",
      "tests": [
        { "label": { "zh": "一半" }, "a": [4, 4], "b": [12, 10], "t": 0.5 },
        { "label": { "zh": "走了四分之一" }, "a": [11, 4], "b": [4, 11], "t": 0.25 },
        { "label": { "zh": "快到了" }, "a": [3, 9], "b": [12, 6], "t": 0.8 }
      ],
      "hidden": [{ "label": { "zh": "又一半" }, "a": [12, 12], "b": [4, 6], "t": 0.5 }],
      "solution": [
        "one = const()",
        "ea = dg_encoder(a)",
        "eb = dg_encoder(b)",
        "om = arith[op=sub](one, t)",
        "wa = arith[op=mul](ea, om)",
        "wb = arith[op=mul](eb, t)",
        "z = arith[op=add](wa, wb)",
        "d = dg_decoder(z)",
        "out <- d"
      ],
      "naive": [
        "one = const()",
        "om = arith[op=sub](one, t)",
        "wb = arith[op=mul](b, t)",
        "wa = arith[op=mul](a, om)",
        "s = arith[op=add](wa, wb)",
        "out <- s"
      ]
    }
  ]
}
