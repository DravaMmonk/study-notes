{
  "title": { "en": "Only the metre in front" },
  "tray": "geometry",
  "after": {
    "en": "The floor is always in front, so counting it would keep the robot stopped for ever; only the region where obstacles can be is checked. Real obstacle avoidance also uses the camera's height and angle to work out how high above the floor each point is."
  },
  "intro": [
    {
      "t": {
        "en": "The floor has no texture, so the distances worked out on those rows jump about. The robot only cares about things above the floor that are very close."
      }
    },
    {
      "t": {
        "en": "Your task in this level: mark the pixels above the floor that are close enough to stop for."
      },
      "fig": { "test": 0, "view": "terrain", "caption": { "en": "Set 1: a box" } }
    }
  ],
  "tasks": [
    {
      "id": "7-11",
      "kind": "graph",
      "brief": {
        "en": "Output 1 for pixels closer than 1.2 m that are above the floor, otherwise 0."
      },
      "hint": { "en": "A threshold keeps the \"greater than\" side." },
      "inputs": ["z", "region"],
      "inputLabels": { "z": { "en": "Distance (m)" }, "region": { "en": "Above the floor" } },
      "outputs": ["stop"],
      "outputLabels": { "stop": { "en": "Stop" } },
      "views": { "in": "terrain" },
      "scene": "roomDepth",
      "tests": [
        {
          "label": { "en": "A box" },
          "seed": 61,
          "obstacles": [{ "box": [4, 3, 10, 12], "d": 3 }],
          "floorSeed": 70
        },
        {
          "label": { "en": "A far box" },
          "seed": 62,
          "obstacles": [{ "box": [6, 2, 12, 12], "d": 2 }],
          "floorSeed": 71
        },
        {
          "label": { "en": "One far, one near" },
          "seed": 63,
          "obstacles": [{ "box": [1, 4, 7, 12], "d": 2 }, { "box": [9, 5, 14, 12], "d": 3 }],
          "floorSeed": 72
        }
      ],
      "hidden": [
        {
          "label": { "en": "A thin chair leg" },
          "seed": 64,
          "obstacles": [{ "box": [7, 1, 10, 12], "d": 3 }],
          "floorSeed": 70
        }
      ],
      "solution": [
        "k = const[c=1.2]()",
        "g = arith[op=sub](k, z)",
        "t = threshold[t=0](g)",
        "m = arith[op=mul](t, region)",
        "stop <- m"
      ],
      "naive": ["k = const[c=1.2]()", "g = arith[op=sub](k, z)", "t = threshold[t=0](g)", "stop <- t"]
    }
  ]
}
