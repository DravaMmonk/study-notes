      "fig": { "test": 0, "caption": { "en": "Set 1: a zone plate" } }
    }
  ],
  "tasks": [
    {
      "id": "2-14",
      "kind": "graph",
      "brief": {
        "en": "Shrink 32×32 to 8×8. It should look like the original, only smaller."
      },
      "hint": { "en": "Halving the size needed a blur first. How much blur for a quarter?" },
      "check": { "tolerance": 0.1, "mismatches": 3 },
      "scene": "filter",
      "setup": { "target": { "shrink": { "sigma": 2, "halvings": 2 } } },
      "tests": [
        { "label": { "en": "Zone plate" }, "in": { "zonePlate": { "k": 0.06, "A": 0.4 } } },
        { "label": { "en": "Fabric" }, "in": { "fabric": { "period": 3, "angle": 30 } } },
        {
          "label": { "en": "Letter F" },
          "in": { "glyph": { "letter": "F", "lo": 0.15, "hi": 0.85, "ox": 4, "oy": 4, "scale": 5, "size": 32 } }
        }
      ],
      "hidden": [
        {
          "label": { "en": "Off-centre zone plate" },
          "in": { "zonePlate": { "k": 0.05, "cx": 10, "cy": 20, "A": 0.4 } }
        },
        { "label": { "en": "Fine fabric" }, "in": { "fabric": { "period": 2.5, "angle": 75 } } }
      ],
      "solution": ["n0 = gauss[sigma=2, border=edge](in)", "n1 = downsample(n0)", "n2 = downsample(n1)", "out <- n2"],
      "naive": ["n0 = gauss[border=edge](in)", "n1 = downsample(n0)", "n2 = downsample(n1)", "out <- n2"],
      "alsoFails": [["n0 = downsample(in)", "n1 = downsample(n0)", "out <- n1"]]
    }
  ]
}
