{
  "title": { "zh": "一格一个标签" },
  "tray": "recognition",
  "intro": [
    {
      "t": {
        "zh": "分割给图上每个像素一个标签。这里做二值分割：亮细胞是前景，暗底是背景。接线之前，先找出两块亮区域之间哪一列应该是背景。"
      }
    }
  ],
  "after": {
    "zh": "二值掩膜和原图同样大，每格的 0 或 1 记录类别。它保留前景的形状和位置；亮度分布重叠时，单个阈值就会误分。"
  },
  "tasks": [
    {
      "id": "binary-foreground-mask",
      "kind": "graph",
      "scene": "cells",
      "brief": {
        "zh": "把亮度严格高于 0.5 的像素标成 1，其余标成 0。对照有窄缝和没有窄缝的两组图。"
      },
      "outputLabels": { "out": { "zh": "前景掩膜" } },
      "tests": [
        {
          "label": { "zh": "一列暗缝" },
          "rects": [[2, 3, 13, 12]],
          "seed": 61,
          "cell": 0.9,
          "back": 0.2,
          "grain": 0,
          "gapX": [7]
        },
        {
          "label": { "zh": "相连的前景" },
          "rects": [[2, 3, 13, 12]],
          "seed": 62,
          "cell": 0.66,
          "back": 0.4,
          "grain": 0
        }
      ],
      "hidden": [
        {
          "label": { "zh": "暗一些的细胞" },
          "rects": [[3, 4, 12, 14]],
          "seed": 63,
          "cell": 0.52,
          "back": 0.5,
          "grain": 0,
          "gapX": [9]
        }
      ],
      "solution": ["mask = threshold[t=0.5](in)", "out <- mask"],
      "naive": ["out <- in"]
    }
  ]
}
