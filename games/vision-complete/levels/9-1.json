{
  "title": { "zh": "放大一倍" },
  "after": {
    "zh": "先补零放大、再用一个核走一遍，就是步幅为 2 的转置卷积：核决定空出来的格子从哪些邻居、按什么比例取数。分割网络的解码器靠它把小特征图一层层放大回原图大小。"
  },
  "intro": [
    {
      "t": {
        "zh": "前几章的网络越往后图越小：池化、隔点取样一层层把 16×16 缩成几个数，最后回答「这是什么」。可要是问「每个像素是什么」，答案得和原图一样大。"
      }
    },
    {
      "t": {
        "zh": "新原件<part-ref to=\"part:zeroUp\"></part-ref>把图放大一倍：每个像素放在 2×2 的左上角，另外三格补 0。"
      },
      "fig": { "part": "zeroUp", "caption": { "zh": "一个亮点补零放大" }, "input": "impulse" }
    },
    {
      "t": {
        "zh": "这一关你要做的：把 8×8 的图放大成 16×16，每个像素变成一样的 2×2 一块。"
      },
      "fig": { "test": 0, "caption": { "zh": "第一组：方块" } }
    }
  ],
  "adds": ["zeroUp"],
  "tray": "recognition",
  "unlocks": ["tconv"],
  "tasks": [
    {
      "id": "9-1",
      "kind": "graph",
      "brief": {
        "zh": "把 8×8 的图放大成 16×16：每个像素变成 2×2 的一小块，四格都一样。"
      },
      "hint": {
        "zh": "<part-ref to=\"part:zeroUp\"></part-ref>把每个像素放在 2×2 的左上角。剩下三格从哪里取数？"
      },
      "scene": "filter",
      "setup": { "target": { "upsample": { "kernel": [1, 1, 0, 1, 1, 0, 0, 0, 0] } } },
      "tests": [
        { "label": { "zh": "方块" }, "in": { "rect": { "x0": 2, "y0": 2, "w": 4, "h": 4, "size": 8 } } },
        { "label": { "zh": "对角" }, "in": { "diagonal": { "size": 8 } } },
        { "label": { "zh": "斜坡" }, "in": { "rampX": { "size": 8 } } }
      ],
      "hidden": [{ "label": { "zh": "一个亮点" }, "in": { "impulse": { "x": 3, "y": 5, "size": 8 } } }],
      "solution": ["z = zeroUp(in)", "k = kernel3[w=[1, 1, 0, 1, 1, 0, 0, 0, 0]](z)", "out <- k"],
      "naive": ["z = zeroUp(in)", "out <- z"]
    }
  ]
}
