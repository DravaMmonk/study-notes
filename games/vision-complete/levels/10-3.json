{
  "title": { "en": "A row of anchors" },
  "tray": "recognition",
  "after": {
    "en": "The same corrections move a small anchor a little and a large one a lot: the corrections are relative. A detector places anchors of several sizes and aspect ratios at every position, regressing and scoring them all together."
  },
  "intro": [
    {
      "t": {
        "en": "Several anchors of different sizes often sit at the same position."
      }
    },
    {
      "t": {
        "en": "Your task in this level: apply the same corrections to a row of anchors and output a row of boxes."
      },
      "fig": { "test": 0, "caption": { "en": "Nudged right" } }
    }
  ],
  "tasks": [
    {
      "id": "10-3",
      "kind": "graph",
      "brief": {
        "en": "Three anchors, small, medium and large, sit at the same place in a row. The same corrections apply to each; output the three boxes."
      },
      "hint": {
        "en": "When a single number meets a whole row, it applies to every cell."
      },
      "inputs": ["cx", "cy", "w", "h", "tx", "ty", "tw", "th"],
      "inputLabels": {
        "cx": { "en": "Anchor centres x (a row)" },
        "cy": { "en": "Anchor centres y (a row)" },
        "w": { "en": "Anchor widths (a row)" },
        "h": { "en": "Anchor heights (a row)" },
        "tx": { "en": "Correction tx" },
        "ty": { "en": "Correction ty" },
        "tw": { "en": "Correction tw" },
        "th": { "en": "Correction th" }
      },
      "outputs": ["bx", "by", "bw", "bh"],
      "outputLabels": {
        "bx": { "en": "Box centre x" },
        "by": { "en": "Box centre y" },
        "bw": { "en": "Box width" },
        "bh": { "en": "Box height" }
      },
      "check": { "tolerance": 0.005 },
      "scene": "nudge",
      "tests": [
        {
          "label": { "en": "Nudged right" },
          "anchors": [
            { "cx": 8, "cy": 8, "w": 2, "h": 2 },
            { "cx": 8, "cy": 8, "w": 4, "h": 4 },
            { "cx": 8, "cy": 8, "w": 8, "h": 8 }
          ],
          "t": { "tx": 0.5, "ty": 0, "tw": 0, "th": 0 }
        },
        {
          "label": { "en": "All bigger" },
          "anchors": [
            { "cx": 8, "cy": 8, "w": 2, "h": 2 },
            { "cx": 8, "cy": 8, "w": 4, "h": 4 },
            { "cx": 8, "cy": 8, "w": 8, "h": 8 }
          ],
          "t": { "tx": 0, "ty": 0.2, "tw": 0.3, "th": 0.3 }
        }
      ],
      "hidden": [
        {
          "label": { "en": "Flattened" },
          "anchors": [
            { "cx": 8, "cy": 8, "w": 2, "h": 2 },
            { "cx": 8, "cy": 8, "w": 4, "h": 4 },
            { "cx": 8, "cy": 8, "w": 8, "h": 8 }
          ],
          "t": { "tx": -0.2, "ty": 0.1, "tw": 0.4, "th": -0.4 }
        }
      ],
      "solution": [
        "mx = arith[op=mul](tx, w)",
        "my = arith[op=mul](ty, h)",
        "ew = exp(tw)",
        "eh = exp(th)",
        "ax = arith[op=add](cx, mx)",
        "ay = arith[op=add](cy, my)",
        "sw = arith[op=mul](ew, w)",
        "sh = arith[op=mul](eh, h)",
        "bx <- ax",
        "by <- ay",
        "bw <- sw",
        "bh <- sh"
      ],
      "naive": [
        "mx = arith[op=mul](tx, w)",
        "my = arith[op=mul](ty, h)",
        "sw = arith[op=mul](tw, w)",
        "sh = arith[op=mul](th, h)",
        "ax = arith[op=add](cx, mx)",
        "ay = arith[op=add](cy, my)",
        "bw <- sw",
        "bh <- sh",
        "bx <- ax",
        "by <- ay"
      ]
    }
  ]
}
