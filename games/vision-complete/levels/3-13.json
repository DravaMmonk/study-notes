{
  "title": { "zh": "朝向光的表面" },
  "tray": "pipeline",
  "intro": [
    {
      "t": {
        "zh": "照片的明暗从哪里来？先从一块白色哑光表面开始：灯从相机方向照来，表面不同位置的倾斜程度会影响收到的光。"
      },
      "fig": { "figure": "surface-bump" }
    },
    {
      "t": {
        "zh": "表面每一点都有一根垂直于表面的单位法线，表示它的朝向。把这根方向分成三个分量：x 指向右，y 指向下，z 指向相机；正负表示沿轴的哪个方向，大小表示朝那个方向的程度。这三张分量图已经作为输入给出。"
      }
    }
  ],
  "after": {
    "zh": "正面光下，法线的 z 分量给出表面朝向光的程度：正对光的地方最亮，倾斜的地方较暗。"
  },
  "tasks": [
    {
      "id": "3-13",
      "kind": "graph",
      "brief": {
        "zh": "灯从正面照来，方向是 (0, 0, 1)。白色表面各点的亮度等于法线与灯方向夹角的余弦。用给出的法线分量画出亮度图；这一关不需要添加任何元件。"
      },
      "hint": {
        "zh": "灯的方向只有 z 分量；两个单位方向夹角的余弦，是对应分量相乘后相加。"
      },
      "inputs": ["nx", "ny", "nz", "albedo"],
      "inputLabels": {
        "nx": { "zh": "法线 x" },
        "ny": { "zh": "法线 y" },
        "nz": { "zh": "法线 z" },
        "albedo": { "zh": "反射率" }
      },
      "inputDescriptions": {
        "nx": {
          "zh": "法线在左右方向上的分量。鼓包两侧的朝向相反，所以图中一边暗、一边亮。"
        },
        "ny": {
          "zh": "法线在上下方向上的分量。鼓包上下两侧的朝向相反。"
        },
        "nz": {
          "zh": "法线朝向相机的分量。鼓包顶部和平板正对相机，图中较亮；鼓包斜坡较暗。"
        },
        "albedo": {
          "zh": "表面反射多少光。这里整块表面都是白色，反射率为 1，所以图中全白。"
        }
      },
      "views": { "in": "pixels", "out": "pixels", "mid": "pixels" },
      "scene": "surface",
      "setup": { "lamp": [0, 0, 1] },
      "tests": [
        {
          "label": { "zh": "白色鼓包" },
          "height": [{ "dome": [8, 8, 6, 3] }],
          "paint": { "blank": { "v": 1 } }
        },
        {
          "label": { "zh": "白色斜板" },
          "height": [{ "tilt": [0.5, 0] }],
          "paint": { "blank": { "v": 1 } }
        }
      ],
      "hidden": [
        {
          "label": { "zh": "白色横梁" },
          "height": [{ "ridge": [8, 5, 2.5] }],
          "paint": { "blank": { "v": 1 } }
        }
      ],
      "solution": ["out <- nz"],
      "naive": ["out <- albedo"]
    }
  ]
}
