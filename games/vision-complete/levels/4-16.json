        { "label": { "en": "Another square" }, "in": { "square": { "x0": 8, "y0": 3, "s": 4 } } }
      ],
      "solution": [
        "a = lrnConv[w=[0.1111111111111111,0.1111111111111111,0.1111111111111111,0.1111111111111111,0.1111111111111111,0.1111111111111111,0.1111111111111111,0.1111111111111111,0.1111111111111111]](in)",
        "b = lrnConv[w=[0.1111111111111111,0.1111111111111111,0.1111111111111111,0.1111111111111111,0.1111111111111111,0.1111111111111111,0.1111111111111111,0.1111111111111111,0.1111111111111111]](a)",
        "out <- b"
