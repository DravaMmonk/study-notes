{
  "title": { "zh": "投票" },
  "tray": "geometry",
  "after": {
    "zh": "Hough 把“找一条线”变成“在累加器里找峰”。分箱太细，噪声把一条线的票拆成许多小峰；太粗，相近的两条线合成一个峰。合适的分箱取决于噪声和线的间距。"
  },
  "intro": [
    {
      "t": {
        "zh": "很多时候要找的是一条线：车道线、纸张的边、楼房的轮廓。边缘检测给的只是一堆零散的点，还夹着噪声和不相干的点。怎样从中认出直线？"
      }
    },
    {
      "t": {
        "zh": "Hough 变换让点来投票。一条直线可以用两个数记下：方向 θ，和它离中心的距离 ρ。每个点给所有穿过它的直线投票，真有的那条线会收到很多票。"
      }
    },
    {
      "t": {
        "zh": "票要落进格子里才能数：(θ, ρ) 的平面被切成一格格，这叫分箱。台上右边就是这些格子，颜色越浓票越多，标出的 1、2 是票最多的两个峰。"
      }
    },
    {
      "t": {
        "zh": "这一关你要调分箱的大小，让三组图里票最多的两个峰正好是那两条线。动手前想想：格子的大小，会影响票怎样聚在一起？"
      }
    }
  ],
  "unlocks": ["hough"],
  "tasks": [
    {
      "id": "6-9",
      "kind": "board",
      "brief": {
        "zh": "每个边缘点给所有经过它的直线 (θ, ρ) 各投一票。调分箱大小，让三张图里票数最高的两个峰正好是那两条线。"
      },
      "hint": {
        "zh": "格子太细，同一条线带噪声的票落不进同一格；太粗，两条相近的线挤进同一个峰。"
      },
      "bench": {
        "model": "hough",
        "setup": { "rhoMax": 34, "tol": { "theta": 4, "rho": 1.5 } },
        "knobs": {
          "bin": {
            "label": { "zh": "分箱大小" },
            "values": [[1, 0.25], [1.5, 0.5], [2, 0.75], [3, 1], [4.5, 1.5], [6, 2], [9, 3], [12, 4], [18, 6]],
            "start": 1,
            "ends": [{ "zh": "细" }, { "zh": "粗" }]
          }
        },
        "cases": [
          {
            "label": { "zh": "两条轨道" },
            "seed": 6,
            "lines": [{ "theta": 60, "rho": -2, "n": 32 }, { "theta": 63, "rho": 3, "n": 24 }],
            "outliers": 16
          },
          {
            "label": { "zh": "一长一短" },
            "seed": 22,
            "lines": [
              { "theta": 150, "rho": 9, "n": 34 },
              { "theta": 100, "rho": -15, "n": 20, "from": -14, "to": 14 }
            ],
            "outliers": 16
          },
          {
            "label": { "zh": "挨得很近" },
            "seed": 4,
            "lines": [{ "theta": 15, "rho": 4, "n": 30 }, { "theta": 10, "rho": 13, "n": 22 }],
            "outliers": 18
          }
        ],
        "goal": [
          { "of": "matched", "label": { "zh": "已匹配" }, "atLeast": 2, "format": "outOf" }
        ],
        "layout": {
          "head": [{ "cases": { "passed": { "zh": "张图通过" } } }],
          "main": ["houghPlanes"],
          "foot": [
            {
              "row": [
                {
                  "panel": [
                    { "text": { "text": { "zh": "分箱大小" }, "look": "label" } },
                    "knobs",
                    {
                      "stats": {
                        "of": [
                          { "of": "dTheta", "label": "Δθ" },
                          { "of": "dRho", "label": "Δρ" },
                          { "of": "cells", "label": { "zh": "格" } }
                        ],
                        "phone": "line"
                      }
                    }
                  ],
                  "dock": true
                },
                {
                  "panel": [
                    {
                      "text": {
                        "text": { "zh": "目标 · 前两个峰分别匹配 A 和 B" },
                        "look": "label"
                      }
                    },
                    "goals"
                  ]
                },
                {
                  "panel": [
                    { "text": { "of": "peaksTitle", "look": "label" } },
                    { "table": { "of": "peaks" } },
                    { "text": { "of": "tolerance", "look": "note" } }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ]
}
