{
  "title": { "zh": "书封面" },
  "tray": "geometry",
  "after": {
    "zh": "匹配、RANSAC 选内点、解单应、变形贴图：这条流水线就是 AR 书封面、全景拼接和文档扫描 App 的核心。每一步你都亲手做过一遍。"
  },
  "intro": [
    {
      "t": {
        "zh": "真实的点对来自匹配器，桌面的花纹一格格重复，难免配错几对。"
      }
    },
    {
      "t": {
        "zh": "这一关你要做的：用这些点对把封面贴回照片。"
      },
      "fig": { "test": 0, "caption": { "zh": "第一组：两对错配" } }
    }
  ],
  "tasks": [
    {
      "id": "6-13",
      "kind": "graph",
      "brief": {
        "zh": "手机斜着拍了桌上的书。匹配器给出了封面和照片之间的点对，其中有几对是桌面花纹造成的错配。把清楚的封面贴回照片里书的位置。"
      },
      "hint": {
        "zh": "错配只要混进一对，用全部点对解出的 H 就会歪。"
      },
      "inputs": ["photo", "cover", "pairs"],
      "inputLabels": {
        "photo": { "zh": "照片" },
        "cover": { "zh": "封面" },
        "pairs": { "zh": "匹配的点对（每 4 个数一对）" }
      },
      "scene": "coverPairs",
      "tests": [
        {
          "label": { "zh": "两对错配" },
          "quad": [[9, 5], [21, 7], [23, 27], [7, 25]],
          "seed": 51,
          "wrong": 2
        },
        {
          "label": { "zh": "四对错配" },
          "quad": [[11, 6], [20, 6], [25, 26], [5, 26]],
          "seed": 52,
          "wrong": 4
        },
        {
          "label": { "zh": "转了一下" },
          "quad": [[6, 9], [18, 4], [25, 21], [12, 27]],
          "seed": 53,
          "wrong": 3
        }
      ],
      "hidden": [
        {
          "label": { "zh": "小一点、错配多" },
          "quad": [[13, 10], [21, 11], [21, 22], [12, 21]],
          "seed": 54,
          "wrong": 5
        }
      ],
      "solution": [
        "zk = const[c=0]()",
        "ok = const()",
        "hs = homography[k=100](pairs)",
        "z = arith[op=mul](cover, zk)",
        "w = warp(cover, hs, photo)",
        "one = arith[op=add](z, ok)",
        "m = warp(one, hs, photo)",
        "inv = invert(m)",
        "keep = arith[op=mul](photo, inv)",
        "sum = arith[op=add](keep, w)",
        "out <- sum"
      ],
      "naive": [
        "zk = const[c=0]()",
        "ok = const()",
        "hs = homography(pairs)",
        "z = arith[op=mul](cover, zk)",
        "w = warp(cover, hs, photo)",
        "one = arith[op=add](z, ok)",
        "m = warp(one, hs, photo)",
        "inv = invert(m)",
        "keep = arith[op=mul](photo, inv)",
        "sum = arith[op=add](keep, w)",
        "out <- sum"
      ]
    }
  ]
}
