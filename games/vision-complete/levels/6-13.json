{
  "title": { "en": "Book cover" },
  "tray": "geometry",
  "after": {
    "en": "Match, choose inliers with RANSAC, solve the homography, warp and paste: this pipeline is the core of AR book covers, panorama stitching and document-scanning apps, and you have built every step of it yourself."
  },
  "intro": [
    {
      "t": {
        "en": "Real pairs come from the matcher, and with a desk pattern that repeats tile after tile, a few are bound to be wrong."
      }
    },
    {
      "t": {
        "en": "Your task in this level: paste the cover back onto the photo using these pairs."
      },
      "fig": { "test": 0, "caption": { "en": "Set 1: two wrong matches" } }
    }
  ],
  "tasks": [
    {
      "id": "6-13",
      "kind": "graph",
      "brief": {
        "en": "A phone photographed the book on the desk at an angle. The matcher has given pairs of points between the cover and the photo, and a few are wrong matches caused by the desk pattern. Paste the crisp cover back over the book in the photo."
      },
      "hint": {
        "en": "Let a single wrong match in, and an H solved from all the pairs comes out crooked."
      },
      "inputs": ["photo", "cover", "pairs"],
      "inputLabels": {
        "photo": { "en": "Photo" },
        "cover": { "en": "Cover" },
        "pairs": { "en": "Matched pairs (4 numbers each)" }
      },
      "scene": "coverPairs",
      "tests": [
        {
          "label": { "en": "Two wrong matches" },
          "quad": [[9, 5], [21, 7], [23, 27], [7, 25]],
          "seed": 51,
          "wrong": 2
        },
        {
          "label": { "en": "Four wrong matches" },
          "quad": [[11, 6], [20, 6], [25, 26], [5, 26]],
          "seed": 52,
          "wrong": 4
        },
        {
          "label": { "en": "Turned a little" },
          "quad": [[6, 9], [18, 4], [25, 21], [12, 27]],
          "seed": 53,
          "wrong": 3
        }
      ],
      "hidden": [
        {
          "label": { "en": "Smaller, many wrong" },
          "quad": [[13, 10], [21, 11], [21, 22], [12, 21]],
          "seed": 54,
          "wrong": 5
        }
      ],
      "solution": [
        "zk = const[c=0]()",
        "ok = const()",
        "hs = homography[k=100](pairs)",
        "z = arith[op=mul](cover, zk)",
        "w = warp(cover, hs, photo)",
        "one = arith[op=add](z, ok)",
        "m = warp(one, hs, photo)",
        "inv = invert(m)",
        "keep = arith[op=mul](photo, inv)",
        "sum = arith[op=add](keep, w)",
        "out <- sum"
      ],
      "naive": [
        "zk = const[c=0]()",
        "ok = const()",
        "hs = homography(pairs)",
        "z = arith[op=mul](cover, zk)",
        "w = warp(cover, hs, photo)",
        "one = arith[op=add](z, ok)",
        "m = warp(one, hs, photo)",
        "inv = invert(m)",
        "keep = arith[op=mul](photo, inv)",
        "sum = arith[op=add](keep, w)",
        "out <- sum"
      ]
    }
  ]
}
