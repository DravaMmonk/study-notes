{
  "title": { "zh": "方向直方图" },
  "tray": "geometry",
  "after": {
    "zh": "SIFT 描述子把关键点周围分成 4×4 个小格，每格做一个 8 个方向的直方图，一共 128 个数。方向按梯度分，幅值当票数：边往哪个方向变亮，这一格就往那个方向投票。"
  },
  "intro": [
    {
      "t": {
        "zh": "一个点光知道「在哪」还不够，还要记下它周围长什么样，才认得出。SIFT 的办法是数一数周围的边都朝哪个方向。"
      }
    },
    {
      "t": {
        "zh": "这一关你要做的：把每一格的梯度幅值分到上下左右四个方向，输出四个方向各自的平均。"
      },
      "fig": {
        "test": 0,
        "caption": {
          "zh": "第一组：竖边"
        }
      }
    }
  ],
  "tasks": [
    {
      "id": "6-8",
      "kind": "graph",
      "brief": {
        "zh": "把每一格的梯度幅值分给它最接近的方向：横向分量更大时，往右变亮算「→」，往左算「←」；纵向分量更大时，往下变亮算「↓」，往上算「↑」。四个输出是四个方向各自的幅值总和除以格数。"
      },
      "hint": {
        "zh": "|gx| 是 gx 和 −gx 里较大的那个。每个方向是两个条件同时成立：哪个分量大，它的正负号。"
      },
      "outputs": ["e", "n", "w", "s"],
      "outputLabels": {
        "e": { "zh": "向右 →" },
        "n": { "zh": "向上 ↑" },
        "w": { "zh": "向左 ←" },
        "s": { "zh": "向下 ↓" }
      },
      "check": { "tolerance": 0.005 },
      "scene": "orientations",
      "tests": [
        { "label": { "zh": "竖边" }, "in": { "stepX": { "edge": 8 } } },
        {
          "label": { "zh": "横边" },
          "in": { "stepY": { "edge": 6, "lo": 0.8, "hi": 0.2 } }
        },
        { "label": { "zh": "方块" }, "in": { "square": { "x0": 3, "y0": 5, "s": 7 } } },
        { "label": { "zh": "字母 F" }, "in": { "glyph": { "letter": "F" } } }
      ],
      "hidden": [
        { "label": { "zh": "斜坡" }, "in": "rampX" },
        { "label": { "zh": "圆盘" }, "in": "disk" }
      ],
      "solution": [
        "neg = const[c=-1]()",
        "gx = sobelx(in)",
        "gy = sobely(in)",
        "m = gradmag(in)",
        "nx = arith[op=mul](gx, neg)",
        "ny = arith[op=mul](gy, neg)",
        "px = threshold[t=0](gx)",
        "py = threshold[t=0](gy)",
        "ax = max(gx, nx)",
        "ay = max(gy, ny)",
        "qx = threshold[t=0](nx)",
        "qy = threshold[t=0](ny)",
        "dxy = arith[op=sub](ax, ay)",
        "dyx = arith[op=sub](ay, ax)",
        "hx = threshold[t=0](dxy)",
        "hy = threshold[t=0](dyx)",
        "mx = arith[op=mul](m, hx)",
        "my = arith[op=mul](m, hy)",
        "be = arith[op=mul](mx, px)",
        "bw = arith[op=mul](mx, qx)",
        "bs = arith[op=mul](my, py)",
        "bn = arith[op=mul](my, qy)",
        "ae = fqMean(be)",
        "aw = fqMean(bw)",
        "as = fqMean(bs)",
        "an = fqMean(bn)",
        "e <- ae",
        "n <- an",
        "w <- aw",
        "s <- as"
      ],
      "naive": ["m = gradmag(in)", "a = fqMean(m)", "e <- a", "n <- a", "w <- a", "s <- a"]
    }
  ]
}
