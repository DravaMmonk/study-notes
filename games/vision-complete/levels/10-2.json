{
  "title": { "zh": "合格的框" },
  "tray": "recognition",
  "after": {
    "zh": "0.5 是 PASCAL VOC 的标准；COCO 把 0.5 到 0.95 的十个门槛都算一遍再平均，框要画得更准才拿得到分。"
  },
  "intro": [
    {
      "t": {
        "zh": "托盘里的<part-ref to=\"own-10-1\"></part-ref>输出两个框掩膜的交并比：重叠面积除以合起来的面积。"
      }
    },
    {
      "t": {
        "zh": "这一关你要做的：IoU 够大就算找对了，输出 1。"
      },
      "fig": { "test": 3, "caption": { "zh": "差不多" } }
    }
  ],
  "tasks": [
    {
      "id": "10-2",
      "kind": "graph",
      "brief": {
        "zh": "检测出的框和标注的框 IoU 大于 0.5 时输出 1，否则 0。"
      },
      "hint": {
        "zh": "<level-ref to=\"10-1\"></level-ref>的<part-ref to=\"own-10-1\"></part-ref>接一个门槛。"
      },
      "inputs": ["a", "b"],
      "inputLabels": { "a": { "zh": "检测出的框" }, "b": { "zh": "标注的框" } },
      "outputs": ["ok"],
      "outputLabels": { "ok": { "zh": "算找对" } },
      "scene": "boxPair",
      "setup": { "expect": "good" },
      "tests": [
        { "label": { "zh": "错开一点" }, "a": [2, 2, 10, 10], "b": [4, 3, 12, 11] },
        { "label": { "zh": "大框套小框" }, "a": [1, 1, 15, 15], "b": [5, 5, 10, 10] },
        { "label": { "zh": "只碰到边" }, "a": [0, 0, 8, 8], "b": [6, 6, 14, 14] },
        { "label": { "zh": "差不多" }, "a": [2, 2, 12, 12], "b": [3, 3, 13, 13] }
      ],
      "hidden": [
        { "label": { "zh": "一模一样" }, "a": [3, 4, 9, 12], "b": [3, 4, 9, 12] },
        { "label": { "zh": "不重叠" }, "a": [0, 0, 5, 5], "b": [8, 8, 14, 14] }
      ],
      "solution": ["i = own-10-1(a, b)", "t = threshold(i)", "ok <- t"],
      "naive": ["i = own-10-1(a, b)", "ok <- i"]
    }
  ]
}
