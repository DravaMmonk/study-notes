{
  "title": { "en": "How far ahead" },
  "tray": "geometry",
  "after": {
    "en": "Search the disparity, convert to distance, keep only what is above the floor: each step was practised on its own earlier, and joined up they make a rangefinder."
  },
  "intro": [
    {
      "t": {
        "en": "A robot vacuum has a pair of stereo cameras and must stop before it bumps into things. First it needs to know how far away everything in front is."
      }
    },
    {
      "t": {
        "en": "Your task in this level: output the distance of every pixel above the floor."
      },
      "fig": { "test": 0, "view": "terrain", "caption": { "en": "Set 1: a box" } }
    }
  ],
  "tasks": [
    {
      "id": "7-10",
      "kind": "graph",
      "brief": {
        "en": "A robot vacuum's stereo camera (f·b = 3). Output the distance in metres of every pixel above the floor, and 0 on the floor rows."
      },
      "hint": { "en": "The steps you have practised, joined up." },
      "inputs": ["left", "right", "region"],
      "inputLabels": {
        "left": { "en": "Left camera" },
        "right": { "en": "Right camera" },
        "region": { "en": "Above the floor" }
      },
      "views": { "out": "terrain" },
      "check": { "tolerance": 0.05, "mismatches": 40 },
      "scene": "room",
      "setup": { "expect": "distance" },
      "tests": [
        { "label": { "en": "A box" }, "seed": 61, "obstacles": [{ "box": [4, 3, 10, 12], "d": 3 }] },
        { "label": { "en": "A far box" }, "seed": 62, "obstacles": [{ "box": [6, 2, 12, 12], "d": 2 }] },
        {
          "label": { "en": "One far, one near" },
          "seed": 63,
          "obstacles": [{ "box": [1, 4, 7, 12], "d": 2 }, { "box": [9, 5, 14, 12], "d": 3 }]
        }
      ],
      "hidden": [
        {
          "label": { "en": "A thin chair leg" },
          "seed": 64,
          "obstacles": [{ "box": [7, 1, 10, 12], "d": 3 }]
        }
      ],
      "solution": [
        "k = const[c=3]()",
        "d = disparity(left, right)",
        "z = arith[op=div](k, d)",
        "m = arith[op=mul](z, region)",
        "out <- m"
      ],
      "naive": ["d = disparity(left, right)", "m = arith[op=mul](d, region)", "out <- m"]
    }
  ]
}
