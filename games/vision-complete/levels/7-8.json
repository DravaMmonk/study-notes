{
  "title": { "zh": "点在线上吗" },
  "tray": "geometry",
  "after": {
    "zh": "一个点在线上，当且仅当 q·l′ = qᵀF p = 0：这就是对极约束。它不告诉你配的是哪个点，只排除不可能的点，所以常用来筛掉错配。"
  },
  "intro": [
    {
      "t": {
        "zh": "托盘里的<part-ref to=\"own-7-7\"></part-ref>读 F 的三列和点 (x, y)，输出极线 F·p。"
      }
    },
    {
      "t": {
        "zh": "这一关你要做的：判断右图的点 q 能不能和左图的点 p 对应。"
      },
      "fig": { "test": 0, "caption": { "zh": "第一组：在线上" } }
    }
  ],
  "tasks": [
    {
      "id": "7-8",
      "kind": "graph",
      "brief": {
        "zh": "右图的点 q 能和左图的点 p 对应吗？q 落在 p 的极线上（|q·l′| < 0.05）输出 1，否则输出 0。"
      },
      "hint": {
        "zh": "点乘就是逐个相乘再加起来；三个数的平均乘 3 就是它们的和。"
      },
      "inputs": ["c1", "c2", "c3", "px", "py", "q"],
      "inputLabels": {
        "c1": { "zh": "F 的第一列" },
        "c2": { "zh": "F 的第二列" },
        "c3": { "zh": "F 的第三列" },
        "px": { "zh": "左图点的 x" },
        "py": { "zh": "左图点的 y" },
        "q": { "zh": "右图的点 q = (x′, y′, 1)" }
      },
      "outputs": ["on"],
      "outputLabels": { "on": { "zh": "配得上" } },
      "scene": "onEpiline",
      "tests": [
        { "label": { "zh": "在线上" }, "x": 2, "y": 3, "q": [5, 1.8181819228593974] },
        { "label": { "zh": "差得远" }, "x": 10, "y": 4, "q": [3, 9] },
        { "label": { "zh": "另一个在线上" }, "x": 6, "y": 12, "q": [9, 3] },
        { "label": { "zh": "差一点" }, "x": 6, "y": 12, "q": [9, 6] }
      ],
      "hidden": [
        { "label": { "zh": "又在线上" }, "x": 14, "y": 1, "q": [2, -0.5000002793967786] },
        { "label": { "zh": "又差得远" }, "x": 14, "y": 1, "q": [8, 1] }
      ],
      "solution": [
        "k = const[c=3]()",
        "n = const[c=-1]()",
        "lim = const[c=0.05]()",
        "l = own-7-7(c1, c2, c3, px, py)",
        "m = arith[op=mul](l, q)",
        "a = fqMean(m)",
        "s = arith[op=mul](a, k)",
        "ns = arith[op=mul](s, n)",
        "ab = max(s, ns)",
        "g = arith[op=sub](lim, ab)",
        "t = threshold[t=0](g)",
        "on <- t"
      ],
      "naive": [
        "k = const[c=3]()",
        "lim = const[c=0.05]()",
        "l = own-7-7(c1, c2, c3, px, py)",
        "m = arith[op=mul](l, q)",
        "a = fqMean(m)",
        "s = arith[op=mul](a, k)",
        "g = arith[op=sub](lim, s)",
        "t = threshold[t=0](g)",
        "on <- t"
      ]
    }
  ]
}
