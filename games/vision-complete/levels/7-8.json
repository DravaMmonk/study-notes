{
  "title": { "en": "Is the point on the line?" },
  "tray": "geometry",
  "after": {
    "en": "A point lies on the line exactly when q·l′ = qᵀF p = 0: this is the epipolar constraint. It does not say which point is the match, only rules out impossible ones, so it is often used to throw out wrong matches."
  },
  "intro": [
    {
      "t": {
        "en": "The <part-ref to=\"epiline\"></part-ref> in the tray reads the three columns of F and a point (x, y), and outputs the epipolar line F·p."
      }
    },
    {
      "t": {
        "en": "Your task in this level: decide whether the right point q can correspond to the left point p."
      },
      "fig": { "test": 0, "caption": { "en": "Set 1: on the line" } }
    }
  ],
  "tasks": [
    {
      "id": "7-8",
      "kind": "graph",
      "brief": {
        "en": "Can the right point q correspond to the left point p? Output 1 if q lies on p's epipolar line (|q·l′| < 0.05), otherwise 0."
      },
      "hint": {
        "en": "A dot product multiplies number by number and adds up; the average of three numbers times 3 is their sum."
      },
      "inputs": ["c1", "c2", "c3", "px", "py", "q"],
      "inputLabels": {
        "c1": { "en": "Column 1 of F" },
        "c2": { "en": "Column 2 of F" },
        "c3": { "en": "Column 3 of F" },
        "px": { "en": "x of the left point" },
        "py": { "en": "y of the left point" },
        "q": { "en": "Right point q = (x′, y′, 1)" }
      },
      "outputs": ["on"],
      "outputLabels": { "on": { "en": "Can match" } },
      "scene": "onEpiline",
      "tests": [
        { "label": { "en": "On the line" }, "x": 2, "y": 3, "q": [5, 1.8181819228593974] },
        { "label": { "en": "Far off" }, "x": 10, "y": 4, "q": [3, 9] },
        { "label": { "en": "Another on the line" }, "x": 6, "y": 12, "q": [9, 3] },
        { "label": { "en": "Just off" }, "x": 6, "y": 12, "q": [9, 6] }
      ],
      "hidden": [
        { "label": { "en": "On the line again" }, "x": 14, "y": 1, "q": [2, -0.5000002793967786] },
        { "label": { "en": "Far off again" }, "x": 14, "y": 1, "q": [8, 1] }
      ],
      "solution": [
        "k = const[c=3]()",
        "n = const[c=-1]()",
        "lim = const[c=0.05]()",
        "l = epiline(c1, c2, c3, px, py)",
        "m = arith[op=mul](l, q)",
        "a = fqMean(m)",
        "s = arith[op=mul](a, k)",
        "ns = arith[op=mul](s, n)",
        "ab = max(s, ns)",
        "g = arith[op=sub](lim, ab)",
        "t = threshold[t=0](g)",
        "on <- t"
      ],
      "naive": [
        "k = const[c=3]()",
        "lim = const[c=0.05]()",
        "l = epiline(c1, c2, c3, px, py)",
        "m = arith[op=mul](l, q)",
        "a = fqMean(m)",
        "s = arith[op=mul](a, k)",
        "g = arith[op=sub](lim, s)",
        "t = threshold[t=0](g)",
        "on <- t"
      ]
    }
  ]
}
