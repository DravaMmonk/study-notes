          "subject": { "glyph": { "letter": "F", "lo": 0.15, "hi": 0.55 } },
          "gain": 0.7,
          "offset": 0.3
        }
      ],
      "hidden": [
        {
          "label": { "zh": "换个物体 · 弱光" },
          "subject": { "glyph": { "letter": "T", "lo": 0.2, "hi": 0.6, "ox": 4, "oy": 3 } },
          "gain": 0.35,
          "offset": 0.02
        },
        {
          "label": { "zh": "换个物体 · 强光" },
          "subject": { "square": { "x0": 3, "y0": 5, "s": 7, "lo": 0.1, "hi": 0.5 } },
          "gain": 1.8,
          "offset": 0.1
        },
        {
          "label": { "zh": "换个物体 · 灰蒙蒙" },
          "subject": { "glyph": { "letter": "L", "lo": 0.15, "hi": 0.55, "ox": 6, "oy": 4 } },
          "gain": 0.5,
          "offset": 0.45
        }
      ],
      "solution": [
        "g = gradmag[border=edge](in)",
        "m = globalMax(g)",
        "d = arith[op=div](g, m)",
        "t = threshold(d)",
        "out <- t"
      ],
      "naive": ["g = gradmag(in)", "t = threshold[t=0.1](g)", "out <- t"]
    }
  ]
