{
  "title": { "zh": "去网纹" },
  "tray": "pipeline",
  "after": {
    "zh": "一组规则的条纹，在频谱里只占一对点；照片本身的内容散在各处。把那对点挖掉，条纹就没了，照片几乎不受影响。修图软件的「去网纹」、去掉扫描件上的摩尔纹，都是这个办法。"
  },
  "intro": [
    {
      "t": {
        "zh": "翻拍印刷的照片，或者扫描报纸上的图，常常带上一层规则的网纹：印刷时的网点和相机的像素格子叠在一起，浮出原来没有的条纹。"
      }
    },
    {
      "t": {
        "zh": "一组规则的条纹，在频谱里是什么样子？照片本身的内容又在频谱的哪里？"
      },
      "fig": {
        "part": "fqSpectrum",
        "caption": { "zh": "第一组测试照片的频谱" },
        "input": "test"
      }
    },
    {
      "t": {
        "zh": "这一关你要做的：按说明里的规则去掉网纹。每张照片的网纹方向和疏密都不一样。"
      },
      "fig": { "test": 0, "caption": { "zh": "第一组：竖网纹" } }
    }
  ],
  "tasks": [
    {
      "id": "2-9",
      "kind": "graph",
      "brief": {
        "zh": "翻拍印刷的照片，常常带上一层规则的网纹。在频谱里，网纹是一对很亮的点。去掉频谱里半径 3 以外、比 0.6 还亮的格子，其余保持不变，输出去掉网纹的照片。每张照片的网纹方向和疏密都不一样。"
      },
      "hint": {
        "zh": "网纹在哪，得从这张照片自己的频谱里找。找到的地方增益为 0，其余为 1。"
      },
      "inputs": ["in", "r"],
      "inputLabels": { "in": { "zh": "照片" }, "r": { "zh": "频率半径" } },
      "check": { "tolerance": 0.02, "mismatches": 4 },
      "scene": "filter",
      "setup": { "target": { "descreen": { "threshold": 0.6, "radius": 3 } }, "given": { "r": "radius" } },
      "tests": [
        {
          "label": { "zh": "竖网纹" },
          "in": {
            "screened": { "of": { "disk": { "cx": 15.5, "cy": 15.5, "r": 9, "lo": 0.25, "hi": 0.75, "size": 32 } }, "fx": 6, "fy": 0 }
          }
        },
        {
          "label": { "zh": "横网纹" },
          "in": {
            "screened": {
              "of": { "glyph": { "letter": "T", "lo": 0.25, "hi": 0.75, "ox": 6, "oy": 6, "scale": 4, "size": 32 } },
              "fx": 0,
              "fy": 5
            }
          }
        },
        {
          "label": { "zh": "斜网纹" },
          "in": {
            "screened": {
              "of": { "rect": { "x0": 8, "y0": 8, "w": 16, "h": 16, "lo": 0.25, "hi": 0.75, "size": 32 } },
              "fx": 4,
              "fy": 4
            }
          }
        }
      ],
      "hidden": [
        {
          "label": { "zh": "另一种斜网纹" },
          "in": {
            "screened": {
              "of": { "glyph": { "letter": "L", "lo": 0.25, "hi": 0.75, "ox": 8, "oy": 5, "scale": 4, "size": 32 } },
              "fx": 7,
              "fy": -3
            }
          }
        },
        {
          "label": { "zh": "细网纹" },
          "in": {
            "screened": { "of": { "disk": { "cx": 12, "cy": 18, "r": 7, "lo": 0.75, "hi": 0.25, "size": 32 } }, "fx": 9, "fy": 0 }
          }
        }
      ],
      "solution": [
        "s = fqSpectrum(in)",
        "o = threshold[t=3](r)",
        "p = threshold[t=0.6](s)",
        "m = arith[op=mul](p, o)",
        "g = invert(m)",
        "f = fqApply(in, g)",
        "out <- f"
      ],
      "naive": ["out <- in"],
      "alsoFails": [["f = fqLowpass[shape=gauss, R=4](in)", "out <- f"]]
    }
  ]
}
