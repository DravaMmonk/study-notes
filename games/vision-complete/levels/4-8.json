{
  "title": { "en": "The larger one" },
  "tray": "pipeline",
  "after": {
    "en": "max(a, b) = b + ReLU(a − b): if a is bigger, add the amount it is bigger by; if b is bigger, add nothing."
  },
  "intro": [
    {
      "t": {
        "en": "The ReLU in the tray turns negatives into 0 and leaves positives as they are."
      }
    },
    {
      "t": {
        "en": "Your task in this level: compare two pictures cell by cell and output the larger value in each. Something to think about: how much bigger is a than b? When is that difference positive?"
      },
      "fig": { "test": 0, "caption": { "en": "Set 1: a square and a disc" } }
    }
  ],
  "unlocks": ["max"],
  "tasks": [
    {
      "id": "4-8",
      "kind": "graph",
      "brief": {
        "en": "Compare two pictures cell by cell and output the larger value in each: max(a, b)."
      },
      "hint": { "en": "ReLU keeps the positive part. How much bigger is a than b?" },
      "inputs": ["a", "b"],
      "inputLabels": { "a": "a", "b": "b" },
      "scene": "filter",
      "setup": { "target": "max" },
      "tests": [
        {
          "label": { "en": "Square and disc" },
          "inputs": { "a": "square", "b": { "disk": { "cx": 9, "cy": 9, "r": 5 } } }
        },
        {
          "label": { "en": "Bars across and down" },
          "inputs": { "a": { "stepY": { "edge": 8 } }, "b": { "stepX": { "edge": 8 } } }
        },
        {
          "label": { "en": "Two textures" },
          "inputs": { "a": { "noise": { "seed": 51 } }, "b": { "noise": { "seed": 52 } } }
        }
      ],
      "hidden": [
        {
          "label": { "en": "Letter and checkerboard" },
          "inputs": { "a": { "glyph": { "letter": "T" } }, "b": { "checker": { "cell": 4, "lo": 0.2, "hi": 0.6 } } }
        },
        {
          "label": { "en": "Ramp and texture" },
          "inputs": { "a": "rampX", "b": { "noise": { "seed": 53 } } }
        }
      ],
      "solution": ["d = arith[op=sub](a, b)", "r = relu(d)", "s = arith[op=add](r, b)", "out <- s"],
      "naive": ["hN = const[c=0.5]()", "s = arith[op=add](a, b)", "h = arith[op=mul](s, hN)", "out <- h"]
    }
  ]
}
