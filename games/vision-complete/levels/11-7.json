{
  "title": { "zh": "体检报告" },
  "tray": "recognition",
  "after": {
    "zh": "热图给人看，一个数给流水线用：上线前把每个模型在一批照片上跑一遍，比例低的先拦下来。这批照片里车和路总在一起，所以分数高不说明模型学对了，要看它为什么高。"
  },
  "intro": [
    {
      "t": {
        "zh": "最后把检查做成一份报告：一张热图给人看，一个数给流水线判断要不要拦下这个模型。"
      }
    },
    {
      "t": {
        "zh": "这一关你要做的：两个输出，热图是灰块遮挡图（3×3）；热图落在车上的比例不到一半就输出 1，否则输出 0。"
      },
      "fig": { "test": 1, "caption": { "zh": "第二组：只看路的分类器" } }
    }
  ],
  "tasks": [
    {
      "id": "11-7",
      "kind": "graph",
      "brief": {
        "zh": "给每个分类器出一份报告：一张灰块遮挡图（3×3），和一个数——热图大于 0 的部分落在车上的不到 0.5，就输出 1（它靠背景认车），否则输出 0。"
      },
      "hint": {
        "zh": "「不到」和<part-ref to=\"threshold\"></part-ref>说的「超过」正好相反。"
      },
      "inputs": ["in", "w", "m"],
      "inputLabels": {
        "in": { "zh": "照片" },
        "w": { "zh": "权重" },
        "m": { "zh": "车的掩膜" }
      },
      "outputs": ["heat", "cheat"],
      "outputLabels": { "heat": { "zh": "热图" }, "cheat": { "zh": "靠背景" } },
      "views": { "in": "pixels", "mid": "terrain" },
      "check": { "tolerance": 0.02 },
      "scene": "classifier",
      "setup": { "check": "checkup" },
      "tests": [
        { "label": { "zh": "老实的分类器" }, "street": { "cx": 5 }, "weights": "car" },
        {
          "label": { "zh": "只看路的分类器" },
          "street": { "cx": 5 },
          "weights": "road"
        },
        {
          "label": { "zh": "车和路都看" },
          "street": { "cx": 4, "house": 12 },
          "weights": "both"
        },
        {
          "label": { "zh": "看车底下的分类器" },
          "street": { "cx": 5 },
          "weights": "shadow"
        },
        { "label": { "zh": "车停得靠右" }, "street": { "cx": 6 }, "weights": "car" },
        { "label": { "zh": "房子旁边的车" }, "street": { "cx": 4, "house": 12 }, "weights": "road" }
      ],
      "hidden": [
        { "label": { "zh": "车开到了左边" }, "street": { "cx": 1 }, "weights": "car" },
        { "label": { "zh": "看得宽一点" }, "street": { "cx": 6, "house": 0 }, "weights": "wide" }
      ],
      "solution": [
        "c = arith[op=mul]()",
        "h = occlusion(in, w)",
        "r = relu(h)",
        "cm = arith[op=mul](r, m)",
        "b = fqMean(r)",
        "a = fqMean(cm)",
        "q = arith[op=div](a, b)",
        "t = threshold(q)",
        "v = invert(t)",
        "heat <- h",
        "cheat <- v"
      ],
      "naive": [
        "c = arith[op=mul]()",
        "h = occlusion(in, w)",
        "r = relu(h)",
        "cm = arith[op=mul](r, m)",
        "b = fqMean(r)",
        "a = fqMean(cm)",
        "q = arith[op=div](a, b)",
        "t = threshold(q)",
        "heat <- h",
        "cheat <- t"
      ]
    }
  ]
}
