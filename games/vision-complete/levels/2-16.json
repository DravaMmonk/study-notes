{
  "title": { "en": "Thumbnail service" },
  "tray": "pipeline",
  "after": {
    "en": "A thumbnail service handles thousands of photos a day: low-pass before sampling against aliasing, and shrinking level by level to save work. Assignment 1, comparing the speed of direct convolution, separable convolution and the FFT, does the same accounting."
  },
  "intro": [
    {
      "t": {
        "en": "The thumbnail service goes live: the album wants 4×4 icons, and the photos include zone plates, fabric, fine stripes and text."
      }
    },
    {
      "t": {
        "en": "Your task in this level: shrink 32×32 to 4×4 with no moiré and a cost of no more than 19."
      },
      "fig": { "test": 0, "caption": { "en": "Set 1: a zone plate" } }
    }
  ],
  "tasks": [
    {
      "id": "2-16",
      "kind": "graph",
      "brief": {
        "en": "The photo album wants a 4×4 icon for every photo: shrink 32×32 to 4×4 with no moiré on zone plates, fabric or text, and a cost of no more than 19."
      },
      "hint": {
        "en": "Each of the last three levels settled one thing: blur before sampling, how much to blur, and working on small pictures being cheaper."
      },
      "check": { "tolerance": 0.1, "mismatches": 1 },
      "constraint": { "cost": { "max": 19 } },
      "scene": "filter",
      "setup": { "target": { "pyramid": { "levels": 3 } } },
      "tests": [
        { "label": { "en": "Zone plate" }, "in": { "zonePlate": { "k": 0.08, "A": 0.4 } } },
        { "label": { "en": "Fabric" }, "in": { "fabric": { "period": 2.5, "angle": 20 } } },
        {
          "label": { "en": "Letter F" },
          "in": { "glyph": { "letter": "F", "lo": 0.15, "hi": 0.85, "ox": 4, "oy": 4, "scale": 5, "size": 32 } }
        },
        {
          "label": { "en": "Fine stripes" },
          "in": { "stripes": { "period": 2.5, "lo": 0.1, "hi": 0.9, "w": 32, "h": 32 } }
        }
      ],
      "hidden": [
        {
          "label": { "en": "Off-centre zone plate" },
          "in": { "zonePlate": { "k": 0.07, "cx": 20, "cy": 12, "A": 0.4 } }
        },
        {
          "label": { "en": "Fine checkerboard" },
          "in": { "checker": { "cell": 1, "lo": 0.15, "hi": 0.85, "size": 32 } }
        }
      ],
      "solution": [
        "n0 = gauss[border=edge](in)",
        "n1 = downsample(n0)",
        "n2 = gauss[border=edge](n1)",
        "n3 = downsample(n2)",
        "n4 = gauss[border=edge](n3)",
        "n5 = downsample(n4)",
        "out <- n5"
      ],
      "naive": [
        "n0 = gauss[sigma=2.5, border=edge](in)",
        "n1 = downsample(n0)",
        "n2 = downsample(n1)",
        "n3 = downsample(n2)",
        "out <- n3"
      ],
      "alsoFails": [["n0 = downsample(in)", "n1 = downsample(n0)", "n2 = downsample(n1)", "out <- n2"]]
    }
  ]
}
