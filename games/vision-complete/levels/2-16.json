{
  "title": { "zh": "缩略图服务" },
  "tray": "pipeline",
  "after": {
    "zh": "缩略图服务每天要处理成千上万张照片：先低通再采样防止混叠，一层层缩小省下计算量。作业 1 比较直接卷积、可分离卷积和 FFT 的速度，比的也是同一笔账。"
  },
  "intro": [
    {
      "t": {
        "zh": "缩略图服务正式上线：相册要 4×4 的小图标，照片里有斑马板、布纹、细条纹和文字。"
      }
    },
    {
      "t": {
        "zh": "这一关你要做的：从 32×32 缩成 4×4，不出莫尔纹，计算量不超过 19。"
      },
      "fig": { "test": 0, "caption": { "zh": "第一组：斑马板" } }
    }
  ],
  "tasks": [
    {
      "id": "2-16",
      "kind": "graph",
      "brief": {
        "zh": "相册要给每张照片做 4×4 的小图标：从 32×32 缩成 4×4，斑马板、布纹、文字都不能出莫尔纹，计算量不能超过 19。"
      },
      "hint": {
        "zh": "前三关各管一件事：先模糊再取样、糊多少、在小图上做事更便宜。"
      },
      "check": { "tolerance": 0.1, "mismatches": 1 },
      "constraint": { "cost": { "max": 19 } },
      "scene": "filter",
      "setup": { "target": { "pyramid": { "levels": 3 } } },
      "tests": [
        { "label": { "zh": "斑马板" }, "in": { "zonePlate": { "k": 0.08, "A": 0.4 } } },
        { "label": { "zh": "布纹" }, "in": { "fabric": { "period": 2.5, "angle": 20 } } },
        {
          "label": { "zh": "字母 F" },
          "in": { "glyph": { "letter": "F", "lo": 0.15, "hi": 0.85, "ox": 4, "oy": 4, "scale": 5, "size": 32 } }
        },
        {
          "label": { "zh": "细条纹" },
          "in": { "stripes": { "period": 2.5, "lo": 0.1, "hi": 0.9, "w": 32, "h": 32 } }
        }
      ],
      "hidden": [
        {
          "label": { "zh": "偏心斑马板" },
          "in": { "zonePlate": { "k": 0.07, "cx": 20, "cy": 12, "A": 0.4 } }
        },
        {
          "label": { "zh": "细棋盘" },
          "in": { "checker": { "cell": 1, "lo": 0.15, "hi": 0.85, "size": 32 } }
        }
      ],
      "solution": [
        "n0 = gauss[border=edge](in)",
        "n1 = downsample(n0)",
        "n2 = gauss[border=edge](n1)",
        "n3 = downsample(n2)",
        "n4 = gauss[border=edge](n3)",
        "n5 = downsample(n4)",
        "out <- n5"
      ],
      "naive": [
        "n0 = gauss[sigma=2.5, border=edge](in)",
        "n1 = downsample(n0)",
        "n2 = downsample(n1)",
        "n3 = downsample(n2)",
        "out <- n3"
      ],
      "alsoFails": [["n0 = downsample(in)", "n1 = downsample(n0)", "n2 = downsample(n1)", "out <- n2"]]
    }
  ]
}
