{
  "title": { "zh": "5×5 平均" },
  "tray": "pipeline",
  "after": {
    "zh": "两格的和挪两格再加一次，就是四格的和；再补一格就是五格。已经算过的部分和，挪一挪就能再用，平移不花计算量。这个「倍增」的想法以后还会出现：要的范围越大，省得越多。"
  },
  "intro": [
    {
      "t": {
        "zh": "这是一道挑战关，可以跳过。它不需要新元件。"
      }
    },
    {
      "t": {
        "zh": "5×5 的平均要把 25 格加起来。像方块模糊那样先横后竖，计算量是 10，这一关只给 8。测试图四周都留着一圈黑边。"
      }
    },
    {
      "t": {
        "zh": "要想的问题：平移不花计算量，只有加法和乘法才花。"
      },
      "fig": { "test": 0, "caption": { "zh": "第一组测试：方块和它的 5×5 平均" } }
    }
  ],
  "tasks": [
    {
      "id": "1-12",
      "kind": "graph",
      "brief": {
        "zh": "每个像素换成它周围 5×5 共 25 格的平均。计算量不能超过 8。"
      },
      "hint": {
        "zh": "先横后竖还不够省。数一数电路里有几次加法；平移不花计算量。"
      },
      "constraint": { "cost": { "max": 8 } },
      "scene": "filter",
      "setup": { "target": { "box": { "size": 5 } } },
      "tests": [
        { "label": { "zh": "方块" }, "in": { "square": { "x0": 4, "y0": 4, "s": 8, "lo": 0, "hi": 0.9 } } },
        { "label": { "zh": "亮点" }, "in": { "impulse": { "x": 7, "y": 7 } } },
        {
          "label": { "zh": "字母 T" },
          "in": { "glyph": { "letter": "T", "lo": 0, "hi": 0.9, "ox": 5, "oy": 5, "scale": 1 } }
        }
      ],
      "hidden": [
        {
          "label": { "zh": "圆盘" },
          "in": { "disk": { "cx": 7.5, "cy": 7.5, "r": 3.5, "lo": 0, "hi": 0.9 } }
        },
        {
          "label": { "zh": "随机纹理" },
          "in": { "margined": { "of": { "noise": { "seed": 24 } }, "width": 4 } }
        }
      ],
      "solution": [
        "hkN = const[c=0.2]()",
        "vkN = const[c=0.2]()",
        "h1 = shift[dir=left](in)",
        "h6 = shift[dir=left](in)",
        "h2 = arith[op=add](in, h1)",
        "h7 = shift[dir=left](h6)",
        "h3 = shift[dir=left](h2)",
        "h8 = shift[dir=left](h7)",
        "h4 = shift[dir=left](h3)",
        "h9 = shift[dir=left](h8)",
        "h5 = arith[op=add](h2, h4)",
        "ha = arith[op=add](h5, h9)",
        "hb = shift[dir=right](ha)",
        "hc = shift[dir=right](hb)",
        "hk = arith[op=mul](hc, hkN)",
        "v1 = shift[dir=up](hk)",
        "v6 = shift[dir=up](hk)",
        "v2 = arith[op=add](hk, v1)",
        "v7 = shift[dir=up](v6)",
        "v3 = shift[dir=up](v2)",
        "v8 = shift[dir=up](v7)",
        "v4 = shift[dir=up](v3)",
        "v9 = shift[dir=up](v8)",
        "v5 = arith[op=add](v2, v4)",
        "va = arith[op=add](v5, v9)",
        "vb = shift[dir=down](va)",
        "vc = shift[dir=down](vb)",
        "vk = arith[op=mul](vc, vkN)",
        "out <- vk"
      ],
      "naive": [
        "hkN = const[c=0.2]()",
        "vkN = const[c=0.2]()",
        "hl1 = shift[dir=left](in)",
        "hr1 = shift[dir=right](in)",
        "hl2 = shift[dir=left](hl1)",
        "hr2 = shift[dir=right](hr1)",
        "ha = arith[op=add](in, hl1)",
        "hb = arith[op=add](ha, hl2)",
        "hc = arith[op=add](hb, hr1)",
        "hd = arith[op=add](hc, hr2)",
        "hk = arith[op=mul](hd, hkN)",
        "vl1 = shift[dir=up](hk)",
        "vr1 = shift[dir=down](hk)",
        "vl2 = shift[dir=up](vl1)",
        "vr2 = shift[dir=down](vr1)",
        "va = arith[op=add](hk, vl1)",
        "vb = arith[op=add](va, vl2)",
        "vc = arith[op=add](vb, vr1)",
        "vd = arith[op=add](vc, vr2)",
        "vk = arith[op=mul](vd, vkN)",
        "out <- vk"
      ],
      "alsoFails": [["a = box3(in)", "b = box3(a)", "out <- b"]]
    }
  ]
}
