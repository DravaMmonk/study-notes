{
  "title": { "en": "A 5×5 average" },
  "tray": "pipeline",
  "after": {
    "en": "The sum of two cells, shifted two along and added again, is the sum of four; one more cell makes five. A partial sum already worked out can be shifted and reused, and shifting costs nothing. This doubling idea will come up again: the bigger the reach, the more it saves."
  },
  "intro": [
    {
      "t": {
        "en": "This is a challenge level, and you can skip it. It needs no new parts."
      }
    },
    {
      "t": {
        "en": "A 5×5 average adds up 25 cells. Splitting it into across and down, as with the box blur, costs 10, and this level allows only 8. Every test picture has a dark margin all round."
      }
    },
    {
      "t": {
        "en": "Something to think about: shifting costs nothing; only additions and multiplications do."
      },
      "fig": { "test": 0, "caption": { "en": "Set 1: a square and its 5×5 average" } }
    }
  ],
  "tasks": [
    {
      "id": "1-12",
      "kind": "graph",
      "brief": {
        "en": "Replace each pixel with the average of the 25 cells in the 5×5 block around it. The cost must not exceed 8."
      },
      "hint": {
        "en": "Splitting into across and down is not cheap enough. Count the additions in your circuit; shifting costs nothing."
      },
      "constraint": { "cost": { "max": 8 } },
      "scene": "filter",
      "setup": { "target": { "box": { "size": 5 } } },
      "tests": [
        { "label": { "en": "Square" }, "in": { "square": { "x0": 4, "y0": 4, "s": 8, "lo": 0, "hi": 0.9 } } },
        { "label": { "en": "Bright dot" }, "in": { "impulse": { "x": 7, "y": 7 } } },
        {
          "label": { "en": "Letter T" },
          "in": { "glyph": { "letter": "T", "lo": 0, "hi": 0.9, "ox": 5, "oy": 5, "scale": 1 } }
        }
      ],
      "hidden": [
        {
          "label": { "en": "Disc" },
          "in": { "disk": { "cx": 7.5, "cy": 7.5, "r": 3.5, "lo": 0, "hi": 0.9 } }
        },
        {
          "label": { "en": "Random texture" },
          "in": { "margined": { "of": { "noise": { "seed": 24 } }, "width": 4 } }
        }
      ],
      "solution": [
        "hkN = const[c=0.2]()",
        "vkN = const[c=0.2]()",
        "h1 = shift[dir=left](in)",
        "h6 = shift[dir=left](in)",
        "h2 = arith[op=add](in, h1)",
        "h7 = shift[dir=left](h6)",
        "h3 = shift[dir=left](h2)",
        "h8 = shift[dir=left](h7)",
        "h4 = shift[dir=left](h3)",
        "h9 = shift[dir=left](h8)",
        "h5 = arith[op=add](h2, h4)",
        "ha = arith[op=add](h5, h9)",
        "hb = shift[dir=right](ha)",
        "hc = shift[dir=right](hb)",
        "hk = arith[op=mul](hc, hkN)",
        "v1 = shift[dir=up](hk)",
        "v6 = shift[dir=up](hk)",
        "v2 = arith[op=add](hk, v1)",
        "v7 = shift[dir=up](v6)",
        "v3 = shift[dir=up](v2)",
        "v8 = shift[dir=up](v7)",
        "v4 = shift[dir=up](v3)",
        "v9 = shift[dir=up](v8)",
        "v5 = arith[op=add](v2, v4)",
        "va = arith[op=add](v5, v9)",
        "vb = shift[dir=down](va)",
        "vc = shift[dir=down](vb)",
        "vk = arith[op=mul](vc, vkN)",
        "out <- vk"
      ],
      "naive": [
        "hkN = const[c=0.2]()",
        "vkN = const[c=0.2]()",
        "hl1 = shift[dir=left](in)",
        "hr1 = shift[dir=right](in)",
        "hl2 = shift[dir=left](hl1)",
        "hr2 = shift[dir=right](hr1)",
        "ha = arith[op=add](in, hl1)",
        "hb = arith[op=add](ha, hl2)",
        "hc = arith[op=add](hb, hr1)",
        "hd = arith[op=add](hc, hr2)",
        "hk = arith[op=mul](hd, hkN)",
        "vl1 = shift[dir=up](hk)",
        "vr1 = shift[dir=down](hk)",
        "vl2 = shift[dir=up](vl1)",
        "vr2 = shift[dir=down](vr1)",
        "va = arith[op=add](hk, vl1)",
        "vb = arith[op=add](va, vl2)",
        "vc = arith[op=add](vb, vr1)",
        "vd = arith[op=add](vc, vr2)",
        "vk = arith[op=mul](vd, vkN)",
        "out <- vk"
      ],
      "alsoFails": [["a = box3(in)", "b = box3(a)", "out <- b"]]
    }
  ]
}
