{
  "title": { "zh": "相册去重" },
  "tray": "pipeline",
  "after": {
    "zh": "编码、算余弦、过门槛：相册去重、以图搜图、人脸验证都是这条流水线，差别在编码器学的是哪种「同一个」。门槛定高了会漏掉重复，定低了会把不同的照片并在一起。"
  },
  "intro": [
    {
      "t": {
        "zh": "相册里常有同一张照片的好几个版本：裁过的、调过色的、压缩出噪点的。整理相册时要把它们并成一张，不同的照片却不能并。"
      }
    },
    {
      "t": {
        "zh": "这一关你要做的：两张照片是同一张就输出 1，否则输出 0。"
      },
      "fig": { "test": 0, "caption": { "zh": "第一组：挪了一格" } }
    }
  ],
  "tasks": [
    {
      "id": "5-9",
      "kind": "graph",
      "brief": {
        "zh": "相册要合并重复的照片：挪了位置、调了颜色、加了噪声的同一张照片输出 1，不同的照片输出 0。"
      },
      "hint": {
        "zh": "找近邻时你比较过相似度。这次没有候选可比，要自己定一条线。"
      },
      "inputs": ["a", "b"],
      "inputLabels": { "a": { "zh": "照片 a" }, "b": { "zh": "照片 b" } },
      "outputs": ["same"],
      "outputLabels": { "same": { "zh": "同一张" } },
      "scene": "duplicate",
      "tests": [
        {
          "label": { "zh": "挪了一格" },
          "a": { "glyph": { "letter": "T" } },
          "b": { "glyph": { "letter": "T", "ox": 4 } },
          "same": true
        },
        {
          "label": { "zh": "调亮了" },
          "a": { "glyph": { "letter": "X" } },
          "b": { "glyph": { "letter": "X", "lo": 0.4, "hi": 1 } },
          "same": true
        },
        {
          "label": { "zh": "对比度低" },
          "a": { "glyph": { "letter": "O", "oy": 4 } },
          "b": { "glyph": { "letter": "O", "lo": 0.4, "hi": 0.6 } },
          "same": true
        },
        {
          "label": { "zh": "加了噪声" },
          "a": { "glyph": { "letter": "F" } },
          "b": { "noisy": { "of": { "glyph": { "letter": "F" } }, "seed": 7, "amp": 0.15 } },
          "same": true
        },
        {
          "label": { "zh": "T 和 L" },
          "a": { "glyph": { "letter": "T" } },
          "b": { "glyph": { "letter": "L" } },
          "same": false
        },
        {
          "label": { "zh": "O 和 X" },
          "a": { "glyph": { "letter": "O", "lo": 0.3, "hi": 1 } },
          "b": { "glyph": { "letter": "X" } },
          "same": false
        }
      ],
      "hidden": [
        {
          "label": { "zh": "挪了又调暗" },
          "a": { "glyph": { "letter": "L" } },
          "b": { "glyph": { "letter": "L", "hi": 0.6, "ox": 2, "oy": 4 } },
          "same": true
        },
        {
          "label": { "zh": "F 和 T" },
          "a": { "glyph": { "letter": "F", "lo": 0.2, "hi": 1 } },
          "b": { "noisy": { "of": { "glyph": { "letter": "T" } }, "seed": 9, "amp": 0.1 } },
          "same": false
        }
      ],
      "solution": [
        "k = const[c=16]()",
        "ea = embed(a)",
        "eb = embed(b)",
        "m = arith[op=mul](ea, eb)",
        "s = fqMean(m)",
        "c = arith[op=mul](s, k)",
        "t = threshold[t=0.8](c)",
        "same <- t"
      ],
      "naive": [
        "k = const[c=16]()",
        "m = arith[op=mul](a, b)",
        "s = fqMean(m)",
        "c = arith[op=mul](s, k)",
        "t = threshold[t=0.8](c)",
        "same <- t"
      ]
    }
  ]
}
