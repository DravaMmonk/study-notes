{
  "title": { "zh": "极点在哪" },
  "tray": "geometry",
  "after": {
    "zh": "极点是另一台相机的光心在这张图里的位置：所有极线都从它发出。它垂直于 F 的每一列，所以是两列的叉积，也就是 Fᵀe′ = 0 的解。"
  },
  "intro": [
    {
      "t": {
        "zh": "左图里不同的点，在右图里有不同的极线。把它们都画出来，会发现一件事：它们都交于同一点。"
      }
    },
    {
      "t": {
        "zh": "这一关你要做的：只用 F 算出这一点，写成 (x, y, 1)。"
      }
    }
  ],
  "tasks": [
    {
      "id": "7-9",
      "kind": "graph",
      "brief": {
        "zh": "右图里所有的极线都交于同一点，叫极点。只用 F 算出它，写成 (x, y, 1)。"
      },
      "hint": {
        "zh": "每条极线都是 F 的列的组合。两条极线交在哪里，你会算。"
      },
      "inputs": ["c1", "c2", "c3", "z"],
      "inputLabels": {
        "c1": { "zh": "F 的第一列" },
        "c2": { "zh": "F 的第二列" },
        "c3": { "zh": "F 的第三列" },
        "z": { "zh": "(0, 0, 1)" }
      },
      "scene": "epipole",
      "tests": [{ "label": { "zh": "这台相机" }, "columns": [0, 1, 2] }],
      "hidden": [{ "label": { "zh": "列换了顺序" }, "columns": [1, 0, 2] }],
      "solution": [
        "k = const[c=3]()",
        "e = own-7-5(c1, c2)",
        "m = arith[op=mul](e, z)",
        "a = fqMean(m)",
        "w = arith[op=mul](a, k)",
        "q = arith[op=div](e, w)",
        "out <- q"
      ],
      "naive": ["e = own-7-5(c1, c2)", "out <- e"]
    }
  ]
}
