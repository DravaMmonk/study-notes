{
  "title": { "zh": "还原 x₀" },
  "tray": "generative",
  "after": {
    "zh": "只要知道噪声，原图一步就能还原。扩散模型要学的正是这件事：看着 x_t 猜出 ε。猜得越准，还原得越好。"
  },
  "intro": [
    {
      "t": {
        "zh": "加噪是往前走。生成一张图要往回走：从噪声里把图找回来。"
      }
    },
    {
      "t": {
        "zh": "这一关你要做的：知道当初加的是哪份噪声，把原图还原出来。"
      },
      "fig": { "test": 1, "caption": { "zh": "第二组：一半" } }
    }
  ],
  "tasks": [
    {
      "id": "8-10",
      "kind": "graph",
      "brief": { "zh": "知道当初加的是哪份噪声 ε，把原图 x₀ 还原出来。" },
      "hint": { "zh": "把加噪的公式倒过来解 x₀。" },
      "inputs": ["xt", "eps", "ab"],
      "inputLabels": {
        "xt": { "zh": "加了噪的 x_t" },
        "eps": { "zh": "当初加的噪声 ε" },
        "ab": { "zh": "剩下多少 ᾱ" }
      },
      "scene": "restoring",
      "tests": [
        { "label": { "zh": "一点点噪声" }, "letter": "T", "seed": 101, "ab": 0.9 },
        { "label": { "zh": "一半" }, "letter": "X", "seed": 102, "ab": 0.5 },
        { "label": { "zh": "几乎全是噪声" }, "letter": "L", "seed": 103, "ab": 0.1 }
      ],
      "hidden": [{ "label": { "zh": "字母 F" }, "letter": "F", "seed": 104, "ab": 0.6 }],
      "solution": [
        "one = const()",
        "s1 = sqrt(ab)",
        "om = arith[op=sub](one, ab)",
        "s2 = sqrt(om)",
        "b = arith[op=mul](eps, s2)",
        "d = arith[op=sub](xt, b)",
        "q = arith[op=div](d, s1)",
        "out <- q"
      ],
      "naive": ["s1 = sqrt(ab)", "q = arith[op=div](xt, s1)", "out <- q"]
    }
  ]
}
