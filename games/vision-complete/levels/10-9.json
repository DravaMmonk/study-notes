{
  "title": { "en": "Where are the X" },
  "tray": "recognition",
  "after": {
    "en": "Grain makes every position's score wobble a little, so the threshold needs a margin: too low and the grain makes false X; too high and a fainter X slips through."
  },
  "intro": [
    {
      "t": {
        "en": "A warehouse robot has to take stock of a shelf: find every box marked X. The photo is grainy."
      }
    },
    {
      "t": { "en": "Your task in this level: output 1 only at the centre of each X." },
      "fig": { "test": 0, "caption": { "en": "One shelf" } }
    }
  ],
  "tasks": [
    {
      "id": "10-9",
      "kind": "graph",
      "brief": {
        "en": "A 24×24 photo of a shelf, with grain. Output 1 only at the very centre of each X mark."
      },
      "hint": {
        "en": "A sliding window and a threshold, high enough that grain cannot add up to it."
      },
      "scene": "shelf",
      "setup": { "expect": "small", "grain": 0.15 },
      "tests": [
        {
          "label": { "en": "One shelf" },
          "marks": [
            { "mark": "X", "at": [4, 4] },
            { "mark": "O", "at": [10, 4] },
            { "mark": "X", "at": [16, 5] },
            { "mark": "O", "at": [20, 18] }
          ],
          "seed": 101
        },
        {
          "label": { "en": "Two shelves" },
          "marks": [
            { "mark": "X", "at": [3, 6] },
            { "mark": "X", "at": [9, 6] },
            { "mark": "O", "at": [15, 17] },
            { "mark": "X", "at": [20, 17] }
          ],
          "seed": 102
        },
        {
          "label": { "en": "All O" },
          "marks": [{ "mark": "O", "at": [5, 5] }, { "mark": "O", "at": [12, 12] }, { "mark": "O", "at": [19, 6] }],
          "seed": 103
        }
      ],
      "hidden": [
        {
          "label": { "en": "Crowded" },
          "marks": [
            { "mark": "X", "at": [4, 12] },
            { "mark": "O", "at": [8, 12] },
            { "mark": "X", "at": [12, 12] },
            { "mark": "X", "at": [19, 19] }
          ],
          "seed": 104
        }
      ],
      "solution": ["k = kernel3[w=[1, -1, 1, -1, 1, -1, 1, -1, 1]](in)", "t = threshold[t=3](k)", "out <- t"],
      "naive": ["k = kernel3[w=[1, -1, 1, -1, 1, -1, 1, -1, 1]](in)", "t = threshold[t=1.5](k)", "out <- t"]
    }
  ]
}
