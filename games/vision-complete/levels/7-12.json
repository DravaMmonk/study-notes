{
  "title": { "zh": "避障警报", "en": "Obstacle alarm" },
  "tray": "geometry",
  "after": {
    "zh": "窗口、距离换算、感兴趣区域，一个都不能少：这是一台最简单的双目避障系统。真实的扫地机器人还会结合激光或结构光，补上没有纹理的地方。",
    "en": "Window, distance conversion, region of interest: none can be left out. This is the simplest stereo obstacle-avoidance system; real robot vacuums also use a laser or structured light to fill in where there is no texture."
  },
  "intro": [
    {
      "t": {
        "zh": "把前面几关接起来：从两台相机的画面，一路算到要停下的区域。",
        "en": "Join the last few levels up: from the two cameras' pictures all the way to the region to stop for."
      }
    },
    {
      "t": { "zh": "这一关你要做的：标出要停下的区域。", "en": "Your task in this level: mark the region to stop for." },
      "fig": { "test": 0, "caption": { "zh": "第一组：一个箱子", "en": "Set 1: a box" } }
    }
  ],
  "tasks": [
    {
      "id": "7-12",
      "kind": "graph",
      "brief": {
        "zh": "扫地机器人的双目相机（f·b = 3，地板没有纹理，画面有噪声）。标出地面以上、近于 1.2 米、要停下来的区域。",
        "en": "A robot vacuum's stereo camera (f·b = 3, a floor with no texture, a noisy picture). Mark the region above the floor, closer than 1.2 m, where it must stop."
      },
      "hint": { "zh": "没有纹理的地方，视差搜索什么也配不上。", "en": "Where there is no texture, disparity search cannot match anything." },
      "inputs": ["left", "right", "region"],
      "inputLabels": {
        "left": { "zh": "左相机", "en": "Left camera" },
        "right": { "zh": "右相机", "en": "Right camera" },
        "region": { "zh": "地面以上", "en": "Above the floor" }
      },
      "outputs": ["stop"],
      "outputLabels": { "stop": { "zh": "要停", "en": "Stop" } },
      "check": { "tolerance": 0.1, "mismatches": 18 },
      "scene": "room",
      "setup": { "expect": "stop" },
      "tests": [
        { "label": { "zh": "一个箱子", "en": "A box" }, "seed": 61, "obstacles": [{ "box": [4, 3, 10, 12], "d": 3 }] },
        { "label": { "zh": "远的箱子", "en": "A far box" }, "seed": 62, "obstacles": [{ "box": [6, 2, 12, 12], "d": 2 }] },
        {
          "label": { "zh": "一远一近", "en": "One far, one near" },
          "seed": 63,
          "obstacles": [{ "box": [1, 4, 7, 12], "d": 2 }, { "box": [9, 5, 14, 12], "d": 3 }]
        }
      ],
      "hidden": [
        {
          "label": { "zh": "细的椅腿", "en": "A thin chair leg" },
          "seed": 64,
          "obstacles": [{ "box": [7, 1, 10, 12], "d": 3 }]
        }
      ],
      "solution": [
        "k = const[c=3]()",
        "n = const[c=1.2]()",
        "d = disparity(left, right)",
        "z = arith[op=div](k, d)",
        "g = arith[op=sub](n, z)",
        "t = threshold[t=0](g)",
        "m = arith[op=mul](t, region)",
        "stop <- m"
      ],
      "naive": [
        "k = const[c=3]()",
        "n = const[c=1.2]()",
        "d = disparity[window=5](left, right)",
        "z = arith[op=div](k, d)",
        "g = arith[op=sub](n, z)",
        "t = threshold[t=0](g)",
        "m = arith[op=mul](t, region)",
        "stop <- m"
      ]
    }
  ]
}
