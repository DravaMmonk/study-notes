{
  "title": { "en": "Obstacle alarm" },
  "tray": "geometry",
  "after": {
    "en": "Window, distance conversion, region of interest: none can be left out. This is the simplest stereo obstacle-avoidance system; real robot vacuums also use a laser or structured light to fill in where there is no texture."
  },
  "intro": [
    {
      "t": {
        "en": "Join the last few levels up: from the two cameras' pictures all the way to the region to stop for."
      }
    },
    {
      "t": { "en": "Your task in this level: mark the region to stop for." },
      "fig": { "test": 0, "caption": { "en": "Set 1: a box" } }
    }
  ],
  "tasks": [
    {
      "id": "7-12",
      "kind": "graph",
      "brief": {
        "en": "A robot vacuum's stereo camera (f·b = 3, a floor with no texture, a noisy picture). Mark the region above the floor, closer than 1.2 m, where it must stop."
      },
      "hint": { "en": "Where there is no texture, disparity search cannot match anything." },
      "inputs": ["left", "right", "region"],
      "inputLabels": {
        "left": { "en": "Left camera" },
        "right": { "en": "Right camera" },
        "region": { "en": "Above the floor" }
      },
      "outputs": ["stop"],
      "outputLabels": { "stop": { "en": "Stop" } },
      "check": { "tolerance": 0.1, "mismatches": 18 },
      "scene": "room",
      "setup": { "expect": "stop" },
      "tests": [
        { "label": { "en": "A box" }, "seed": 61, "obstacles": [{ "box": [4, 3, 10, 12], "d": 3 }] },
        { "label": { "en": "A far box" }, "seed": 62, "obstacles": [{ "box": [6, 2, 12, 12], "d": 2 }] },
        {
          "label": { "en": "One far, one near" },
          "seed": 63,
          "obstacles": [{ "box": [1, 4, 7, 12], "d": 2 }, { "box": [9, 5, 14, 12], "d": 3 }]
        }
      ],
      "hidden": [
        {
          "label": { "en": "A thin chair leg" },
          "seed": 64,
          "obstacles": [{ "box": [7, 1, 10, 12], "d": 3 }]
        }
      ],
      "solution": [
        "k = const[c=3]()",
        "n = const[c=1.2]()",
        "d = disparity(left, right)",
        "z = arith[op=div](k, d)",
        "g = arith[op=sub](n, z)",
        "t = threshold[t=0](g)",
        "m = arith[op=mul](t, region)",
        "stop <- m"
      ],
      "naive": [
        "k = const[c=3]()",
        "n = const[c=1.2]()",
        "d = disparity[window=5](left, right)",
        "z = arith[op=div](k, d)",
        "g = arith[op=sub](n, z)",
        "t = threshold[t=0](g)",
        "m = arith[op=mul](t, region)",
        "stop <- m"
      ]
    }
  ]
}
