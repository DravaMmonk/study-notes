{
  "title": { "en": "Inspection station" },
  "tray": "pipeline",
  "after": {
    "en": "The station does three things: restore the lighting, subtract the reference cell by cell, then threshold each side and combine. Machine-vision inspection in factories often starts out exactly like this: a reference, alignment, a comparison."
  },
  "intro": [
    {
      "t": {
        "en": "The inspection station is about to go live. Besides dents, parts may have scratches, which catch the light and look brighter than the reference."
      }
    },
    {
      "t": {
        "en": "Your task in this level: the lamp is still at 80%. Mark both dents and scratches with 1 and everything else with 0. For a good part the output should be all 0."
      },
      "fig": { "test": 0, "caption": { "en": "Set 1: one dent and one scratch" } }
    }
  ],
  "tasks": [
    {
      "id": "0-12",
      "kind": "graph",
      "brief": {
        "en": "Going live: the lamp is at 80%, and parts have both dents (darker) and shiny scratches (brighter). Mark both kinds of defect with 1 and everything else with 0."
      },
      "hint": {
        "en": "A threshold only looks one way. The two kinds of defect differ in opposite directions."
      },
      "inputs": ["ref", "part"],
      "inputLabels": { "ref": { "en": "Reference" }, "part": { "en": "Part" } },
      "scene": "station",
      "tests": [
        {
          "label": { "en": "A flat sheet" },
          "part": "plate",
          "dents": [[4, 4, 2, 2]],
          "scratches": [[9, 10, 4, 1]],
          "lamp": 0.8
        },
        {
          "label": { "en": "Ring" },
          "part": "ring",
          "scratches": [[2, 7, 1, 3]],
          "dents": [[11, 11, 2, 2]],
          "lamp": 0.8
        },
        {
          "label": { "en": "Bracket" },
          "part": "bracket",
          "scratches": [[3, 5, 1, 4], [8, 12, 4, 1]],
          "lamp": 0.8
        },
        {
          "label": { "en": "Gear" },
          "part": "gear",
          "dents": [[5, 5, 2, 2]],
          "scratches": [[0, 6, 2, 1]],
          "lamp": 0.8
        }
      ],
      "hidden": [
        {
          "label": { "en": "Tiles" },
          "part": "tile",
          "dents": [[2, 2, 2, 2]],
          "scratches": [[12, 5, 1, 3], [6, 13, 3, 1]],
          "lamp": 0.8
        },
        {
          "label": { "en": "Scratches only" },
          "part": "plate",
          "scratches": [[6, 1, 1, 4], [0, 9, 3, 1]],
          "lamp": 0.8
        },
        { "label": { "en": "A good ring" }, "part": "ring", "lamp": 0.8 }
      ],
      "solution": [
        "kN = const[c=1.25]()",
        "k = mul(part, kN)",
        "dn = sub(ref, k)",
        "up = sub(k, ref)",
        "md = threshold[t=0.07](dn)",
        "mu = threshold[t=0.07](up)",
        "a = add(md, mu)",
        "out <- a"
      ],
      "naive": ["kN = const[c=1.25]()", "k = mul(part, kN)", "d = sub(ref, k)", "m = threshold[t=0.07](d)", "out <- m"]
    }
  ]
}
