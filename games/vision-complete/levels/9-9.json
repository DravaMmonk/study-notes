{
  "title": { "en": "The thin line is gone" },
  "tray": "recognition",
  "after": {
    "en": "Combine the coarse result enlarged back with the fine result at full size: the coarse path keeps out the grain, the fine path keeps the detail. This line straight from encoder to decoder is called a skip connection, and U-Net has one at every level."
  },
  "intro": [
    {
      "t": {
        "en": "Cells often crowd together with only a very thin gap between them. When counting, lose the gap and two count as one."
      }
    },
    {
      "t": {
        "en": "Your task in this level: mark the cells, keeping the gaps between them."
      },
      "fig": { "test": 0, "caption": { "en": "Set 1: two touching" } }
    }
  ],
  "tasks": [
    {
      "id": "9-9",
      "kind": "graph",
      "brief": {
        "en": "Touching cells are separated only by a dark gap one pixel wide. Mark the cells, and keep the gaps (0)."
      },
      "hint": {
        "en": "The shrink-then-enlarge path cannot see a one-pixel gap. The original picture still can."
      },
      "check": { "tolerance": 0.1, "mismatches": 3 },
      "scene": "cells",
      "tests": [
        {
          "label": { "en": "Two touching" },
          "rects": [[2, 3, 14, 11]],
          "gapX": [7],
          "seed": 71,
          "grain": 0.2
        },
        {
          "label": { "en": "One above the other" },
          "rects": [[3, 1, 11, 15]],
          "gapY": [7],
          "seed": 72,
          "grain": 0.2
        },
        {
          "label": { "en": "Three in a row" },
          "rects": [[1, 4, 15, 10]],
          "gapX": [5, 11],
          "seed": 73,
          "grain": 0.2
        }
      ],
      "hidden": [
        {
          "label": { "en": "Two in a row, gap elsewhere" },
          "rects": [[0, 2, 14, 8]],
          "gapX": [9],
          "seed": 74,
          "grain": 0.2
        }
      ],
      "solution": [
        "a = kernel3[w=[0, 0, 0, 0, 0.25, 0.25, 0, 0.25, 0.25]](in)",
        "f = threshold(in)",
        "s = downsample(a)",
        "c = threshold[t=0.3](s)",
        "u = tconv(c)",
        "m = arith[op=mul](u, f)",
        "out <- m"
      ],
      "naive": [
        "a = kernel3[w=[0, 0, 0, 0, 0.25, 0.25, 0, 0.25, 0.25]](in)",
        "s = downsample(a)",
        "c = threshold[t=0.3](s)",
        "u = tconv(c)",
        "out <- u"
      ]
    }
  ]
}
