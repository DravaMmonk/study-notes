{
  "title": { "en": "Sliding window" },
  "tray": "recognition",
  "after": {
    "en": "Slide a template over the picture scoring every position, then apply a threshold: this is sliding-window detection. A convolutional network does the same thing, except that the templates are learnt and stacked layer on layer."
  },
  "intro": [
    {
      "t": {
        "en": "The most direct way to detect: move a template over the picture cell by cell, scoring at each place how alike it looks."
      }
    },
    {
      "t": {
        "en": "Your task in this level: the boxes on the shelf carry X or O marks; output 1 only at the centre of each X."
      },
      "fig": { "test": 0, "caption": { "en": "First set" } }
    }
  ],
  "tasks": [
    {
      "id": "10-4",
      "kind": "graph",
      "brief": {
        "en": "The boxes on the shelf carry 3×3 marks, some X and some O. Output 1 only at the very centre of each X."
      },
      "hint": {
        "en": "A 3×3 kernel with positive weights on the X cells and negative elsewhere: wherever looks most like an X gives the most."
      },
      "scene": "marks",
      "tests": [
        {
          "label": { "en": "Two X, one O" },
          "marks": [
            { "mark": "X", "at": [3, 3] },
            { "mark": "X", "at": [11, 6] },
            { "mark": "O", "at": [6, 12] }
          ]
        },
        {
          "label": { "en": "A row" },
          "marks": [
            { "mark": "O", "at": [2, 8] },
            { "mark": "X", "at": [7, 8] },
            { "mark": "O", "at": [12, 8] }
          ]
        },
        {
          "label": { "en": "Spread out" },
          "marks": [
            { "mark": "X", "at": [2, 13] },
            { "mark": "X", "at": [13, 2] },
            { "mark": "O", "at": [8, 7] },
            { "mark": "X", "at": [12, 12] }
          ]
        }
      ],
      "hidden": [
        {
          "label": { "en": "Only O" },
          "marks": [{ "mark": "O", "at": [4, 4] }, { "mark": "O", "at": [11, 10] }]
        },
        {
          "label": { "en": "Near the edge" },
          "marks": [
            { "mark": "X", "at": [1, 1] },
            { "mark": "O", "at": [14, 14] },
            { "mark": "X", "at": [14, 7] }
          ]
        }
      ],
      "solution": [
        "k = kernel3[w=[1, -1, 1, -1, 1, -1, 1, -1, 1]](in)",
        "t = threshold[t=3](k)",
        "out <- t"
      ],
      "naive": ["k = kernel3[w=[1, 0, 1, 0, 1, 0, 1, 0, 1]](in)", "t = threshold[t=3](k)", "out <- t"]
    }
  ]
}
