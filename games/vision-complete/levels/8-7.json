{
  "title": { "zh": "一步加到第 t 步" },
  "tray": "generative",
  "after": {
    "zh": "ᾱ 从 1 慢慢减到 0，图一点点没进噪声里。两个系数的平方加起来是 1，所以不管加到哪一步，图的总「能量」大致不变。这个公式让训练时能直接跳到任意一步，不用一步步加。"
  },
  "intro": [
    {
      "t": {
        "zh": "现在最好的图像生成模型叫扩散模型。它的训练从反方向开始：先把一张图一点点加噪，直到只剩噪声。"
      }
    },
    {
      "t": {
        "zh": "加到哪一步，用一个数 ᾱ 表示图还剩多少：1 是原图，0 是纯噪声。"
      }
    },
    {
      "t": {
        "zh": "这一关你要做的：按说明里的公式，一步算出加到第 t 步的图。"
      },
      "fig": { "test": 1, "caption": { "zh": "第二组：一半" } }
    }
  ],
  "packs": {
    "name": { "zh": "加噪" },
    "desc": {
      "zh": "输出 √ᾱ·x₀ + √(1 − ᾱ)·ε：把 x₀ 一步加噪到第 t 步。"
    }
  },
  "tasks": [
    {
      "id": "8-7",
      "kind": "graph",
      "brief": {
        "zh": "扩散模型给图加噪：x_t = √ᾱ · x₀ + √(1 − ᾱ) · ε。按公式输出 x_t。"
      },
      "hint": {
        "zh": "√ᾱ 和 √(1 − ᾱ) 都是一个数，乘到整张图上。"
      },
      "inputs": ["x0", "eps", "ab"],
      "inputLabels": {
        "x0": { "zh": "原图 x₀" },
        "eps": { "zh": "噪声 ε" },
        "ab": { "zh": "剩下多少 ᾱ" }
      },
      "scene": "noising",
      "tests": [
        { "label": { "zh": "一点点噪声" }, "letter": "T", "seed": 81, "ab": 0.9 },
        { "label": { "zh": "一半" }, "letter": "X", "seed": 82, "ab": 0.5 },
        { "label": { "zh": "几乎全是噪声" }, "letter": "O", "seed": 83, "ab": 0.1 }
      ],
      "hidden": [{ "label": { "zh": "字母 F" }, "letter": "F", "seed": 84, "ab": 0.7 }],
      "solution": [
        "one = const()",
        "s1 = sqrt(ab)",
        "om = arith[op=sub](one, ab)",
        "s2 = sqrt(om)",
        "a = arith[op=mul](x0, s1)",
        "b = arith[op=mul](eps, s2)",
        "x = arith[op=add](a, b)",
        "out <- x"
      ],
      "naive": [
        "one = const()",
        "a = arith[op=mul](x0, ab)",
        "om = arith[op=sub](one, ab)",
        "b = arith[op=mul](eps, om)",
        "x = arith[op=add](a, b)",
        "out <- x"
      ]
    }
  ]
}
