            "en": "right",
            "zh": "右"
          }
        }
      ],
      "settings": [
        {
          "key": "window",
          "label": {
            "en": "Window",
            "zh": "窗口"
          },
          "control": "select",
          "options": [
            {
              "value": "1",
              "label": "1×1"
            },
            {
              "value": "3",
              "label": "3×3"
            },
            {
              "value": "5",
              "label": "5×5"
            },
            {
              "value": "7",
              "label": "7×7"
            }
          ],
          "default": "3"
        }
      ],
      "compute": "image_disparity(left, right, $window)"
    },
    "dg_encoder": {
      "name": {
        "en": "Encoder (trained)",
        "zh": "编码器（已训练）"
      },
      "desc": {
        "en": "One blob → two numbers: where it is left–right and up–down",
        "zh": "一个斑点 → 两个数：它在左右、上下的位置"
      },
      "icon": "Box",
      "family": "other",
      "inputs": [
        {
          "name": "in",
          "label": ""
        }
      ],
      "compute": "image_dg_encoder(in)"
    },
    "dg_decoder": {
      "name": {
        "en": "Decoder (trained)",
        "zh": "解码器（已训练）"
      },
      "desc": {
        "en": "Two numbers → one blob: z₁ moves it left–right, z₂ up–down",
        "zh": "两个数 → 一个斑点：z₁ 管左右，z₂ 管上下"
      },
      "icon": "Activity",
      "family": "learned",
      "inputs": [
        {
          "name": "in",
          "label": ""
        }
      ],
      "compute": "image_dg_decoder(in)"
    },
    "dg_reparam": {
      "name": {
        "en": "Reparameterization μ + σ·ε",
        "zh": "重参数化 μ + σ·ε"
      },
      "desc": {
        "en": "Randomness enters only through ε; μ and σ differentiate as usual",
        "zh": "随机只从 ε 进来，μ、σ 照常求导"
      },
      "icon": "Activity",
      "family": "learned",
      "inputs": [
        {
          "name": "mu",
          "label": "μ"
        },
        {
          "name": "sigma",
          "label": "σ"
        },
        {
          "name": "eps",
          "label": "ε"
        }
      ],
      "compute": "image_dg_reparam(mu, sigma, eps)"
    },
    "tconv": {
      "name": {
        "en": "Transposed convolution (stride 2)",
        "zh": "转置卷积（步幅 2）"
      },
      "desc": {
        "en": "Zero-upsamples to twice the size, then runs a 3×3 kernel over it",
        "zh": "补零放大一倍，再用 3×3 的核走一遍"
      },
      "icon": "Box",
      "family": "other",
      "inputs": [
        {
          "name": "in",
          "label": ""
        }
      ],
      "settings": [
        {
          "key": "w",
          "label": {
            "en": "Weights",
            "zh": "权重"
          },
          "control": "custom",
          "widget": "imageKernel",
          "default": [
            1,
            1,
            0,
            1,
            1,
            0,
            0,
            0,
            0
          ]
        }
      ],
      "compute": "image_tconv(in, $w)"
    },
    "peaks": {
      "name": { "en": "Peak finder", "zh": "找峰" },
      "desc": {
        "en": "Outputs 1 where a cell is no smaller than its 3×3 neighbours and above 0.3, and 0 elsewhere.",
        "zh": "比 3×3 邻居都不小、又大于 0.3 的格子输出 1，其余输出 0。"
      },
      "inside": [{ "task": "6-2" }]
    },
    "matcher": {
      "name": { "en": "Matcher", "zh": "匹配器" },
      "desc": {
        "en": "Outputs the number 1–3 of the nearest when its distance is under 0.8 times the second nearest; otherwise 0.",
        "zh": "最近的距离小于第二近的 0.8 倍时，输出最近那个的编号 1–3；否则输出 0。"
      },
      "inside": [{ "task": "6-4" }]
    },
    "cross": {
      "name": { "en": "Cross product", "zh": "叉积" },
      "desc": { "en": "Outputs the cross product a × b of two 3-vectors.", "zh": "输出两个三维向量的叉积 a × b。" },
      "inside": [{ "task": "7-5" }]
    },
    "epiline": {
      "name": { "en": "Epipolar line", "zh": "极线" },
      "desc": {
        "en": "Reads the three columns of F and a point (x, y), and outputs the epipolar line F·p.",
        "zh": "读 F 的三列和点 (x, y)，输出极线 F·p。"
      },
      "inside": [{ "task": "7-7" }]
    },
    "addNoise": {
      "name": { "en": "Add noise", "zh": "加噪" },
      "desc": {
        "en": "Outputs √ᾱ·x₀ + √(1 − ᾱ)·ε: x₀ noised straight to step t.",
        "zh": "输出 √ᾱ·x₀ + √(1 − ᾱ)·ε：把 x₀ 一步加噪到第 t 步。"
      },
      "inside": [{ "task": "8-7" }]
    },
    "restore": {
      "name": { "en": "Restore", "zh": "还原" },
      "desc": {
        "en": "Outputs (x_t − √(1 − ᾱ)·ε) / √ᾱ: x₀ recovered from x_t and the noise ε.",
        "zh": "输出 (x_t − √(1 − ᾱ)·ε) / √ᾱ：由 x_t 和噪声 ε 还原 x₀。"
      },
      "inside": [{ "task": "8-10" }]
    },
    "kmeansStep": {
      "name": { "en": "One k-means step", "zh": "k 均值一步" },
      "desc": {
        "en": "Splits the values into two classes at the boundary m and outputs halfway between the two class averages.",
        "zh": "按分界 m 把值分成两类，输出两类平均值的正中间。"
      },
      "inside": [{ "task": "9-2" }]
    },
    "unpool": {
      "name": { "en": "Unpool", "zh": "反池化" },
      "desc": {
        "en": "Puts each pooled value back in the cell it came from before pooling; every other cell is 0.",
        "zh": "把池化后的每个值放回池化前它所在的那一格，其余格子为 0。"
      },
      "inside": [{ "task": "9-6" }]
    },
    "iou": {
      "name": { "en": "IoU", "zh": "IoU" },
      "desc": {
        "en": "Outputs the intersection over union of two box masks: the overlap divided by the area they cover together.",
        "zh": "输出两个框掩膜的交并比：重叠面积除以合起来的面积。"
      },
      "inside": [{ "task": "10-1" }]
    },
    "apMeter": {
      "name": { "en": "AP meter", "zh": "AP 计" },
      "desc": {
        "en": "Reads right or wrong in score order, the ranks and the number labelled G, and outputs the AP.",
        "zh": "读按分数排好的对错、名次和标注数 G，输出 AP。"
      },
      "inside": [{ "task": "10-7" }]
    },
    "occlusion": {
      "name": { "en": "Occlusion map", "zh": "遮挡图" },
      "desc": {
        "en": "Covers the 3×3 round every cell with a grey (0.5) block and outputs how far the classifier's score drops. The photo goes into in, the weights into w.",
        "zh": "用灰块（0.5）挡住每一格周围的 3×3，输出分类器的分数掉了多少。照片接 in，权重接 w。"
      },
      "inside": [{ "task": "11-2" }]
    }
  }
}
