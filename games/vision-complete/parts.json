{
  "presets": {
    "dir": {
      "label": {
        "zh": "方向",
        "en": "Direction"
      },
      "control": "buttons",
      "layout": "pad",
      "options": [
        {
          "value": "right",
          "label": "→"
        },
        {
          "value": "left",
          "label": "←"
        },
        {
          "value": "down",
          "label": "↓"
        },
        {
          "value": "up",
          "label": "↑"
        }
      ],
      "default": "right"
    },
    "border": {
      "label": {
        "zh": "边界",
        "en": "Border"
      },
      "control": "select",
      "options": [
        {
          "value": "zero",
          "label": {
            "zh": "补 0",
            "en": "Pad with 0"
          }
        },
        {
          "value": "edge",
          "label": {
            "zh": "复制边缘",
            "en": "Replicate edge"
          }
        }
      ],
      "default": "zero"
    }
  },
  "parts": {
    "const": {
      "name": {
        "zh": "常数",
        "en": "Constant"
      },
      "desc": {
        "zh": "始终输出同一个数。与图相加或相乘时，这个数作用于每一格",
        "en": "Always outputs the same number. Added to or multiplied with a picture, it applies to every cell"
      },
      "icon": "Hash",
      "family": "pixel",
      "inputs": [],
      "settings": [
        {
          "key": "c",
          "label": "=",
          "control": "number",
          "min": -100,
          "max": 100,
          "step": 0.01,
          "default": 1
        }
      ],
      "compute": "image_const($c)"
    },
    "add": {
      "name": {
        "zh": "相加",
        "en": "Add"
      },
      "desc": {
        "zh": "两张图逐像素相加：a + b",
        "en": "Adds two pictures pixel by pixel: a + b"
      },
      "icon": "Calculator",
      "family": "pixel",
      "inputs": [
        {
          "name": "a",
          "label": "a"
        },
        {
          "name": "b",
          "label": "b"
        }
      ],
      "compute": "image_add(a, b)"
    },
    "sub": {
      "name": {
        "zh": "相减",
        "en": "Subtract"
      },
      "desc": {
        "zh": "两张图逐像素相减：a − b",
        "en": "Subtracts two pictures pixel by pixel: a − b"
      },
      "icon": "Calculator",
      "family": "pixel",
      "inputs": [
        {
          "name": "a",
          "label": "a"
        },
        {
          "name": "b",
          "label": "b"
        }
      ],
      "compute": "image_sub(a, b)"
    },
    "mul": {
      "name": {
        "zh": "相乘",
        "en": "Multiply"
      },
      "desc": {
        "zh": "两张图逐像素相乘：a × b",
        "en": "Multiplies two pictures pixel by pixel: a × b"
      },
      "icon": "Calculator",
      "family": "pixel",
      "inputs": [
        {
          "name": "a",
          "label": "a"
        },
        {
          "name": "b",
          "label": "b"
        }
      ],
      "compute": "image_mul(a, b)"
    },
    "arith": {
      "name": {
        "zh": "四则运算",
        "en": "Arithmetic"
      },
      "desc": {
        "zh": "两张图逐像素相加、相减、相乘或相除。可将左侧或右侧设为常数，另一侧接线输入",
        "en": "Adds, subtracts, multiplies or divides two pictures pixel by pixel. Either side can be set to a constant; the other receives a wire"
      },
      "icon": "Plus",
      "family": "pixel",
      "inputs": [
        {
          "name": "a",
          "label": "a"
        },
        {
          "name": "b",
          "label": "b"
        }
      ],
      "settings": [
        {
          "key": "op",
          "label": {
            "zh": "运算",
            "en": "Operation"
          },
          "control": "buttons",
          "layout": "grid",
          "options": [
            {
              "value": "add",
              "label": "+"
            },
            {
              "value": "sub",
              "label": "−"
            },
            {
              "value": "mul",
              "label": "×"
            },
            {
              "value": "div",
              "label": "÷"
            }
          ],
          "default": "add"
        },
        {
          "key": "constantSide",
          "label": {
            "zh": "常数位置",
            "en": "Constant side"
          },
          "control": "select",
          "options": [
            {
              "value": "none",
              "label": {
                "zh": "关闭",
                "en": "Off"
              }
            },
            {
              "value": "a",
              "label": {
                "zh": "左 a",
                "en": "Left"
              }
            },
            {
              "value": "b",
              "label": {
                "zh": "右 b",
                "en": "Right"
              }
            }
          ],
          "default": "none"
        },
        {
          "key": "constant",
          "label": {
            "zh": "常数",
            "en": "Constant"
          },
          "control": "number",
          "min": -100,
          "max": 100,
          "step": 0.01,
          "default": 1,
          "when": "match $constantSide { none: 0, a: 1, b: 1 }"
        }
      ],
      "nulls": "pass",
      "compute": "image_arith(a, b, $op, $constantSide, $constant)"
    },
    "merge": {
      "name": {
        "zh": "汇合器",
        "en": "Merger"
      },
      "desc": {
        "zh": "有三个输入口，将接入的图逐像素相加；空置的输入口不计入",
        "en": "Has three inputs and adds the pictures wired into them pixel by pixel; an empty input is skipped"
      },
      "icon": "Calculator",
      "family": "pixel",
      "inputs": [
        {
          "name": "a",
          "label": "a"
        },
        {
          "name": "b",
          "label": "b"
        },
        {
          "name": "c"
        }
      ],
      "nulls": "pass",
      "compute": "image_merge(a, b, c)"
    },
    "sqrt": {
      "name": {
        "zh": "开方",
        "en": "Square root"
      },
      "desc": {
        "zh": "每个像素开方",
        "en": "Square root of every pixel"
      },
      "icon": "Calculator",
      "family": "pixel",
      "inputs": [
        {
          "name": "in",
          "label": ""
        }
      ],
      "compute": "image_sqrt(in)"
    },
    "exp": {
      "name": "exp",
      "desc": "exp",
      "icon": "Calculator",
      "family": "pixel",
      "inputs": [
        {
          "name": "in",
          "label": ""
        }
      ],
      "compute": "image_exp(in)"
    },
    "globalMax": {
      "name": {
        "zh": "全图最大值",
        "en": "Global max"
      },
      "desc": {
        "zh": "用整张图的最大值填满每一格",
        "en": "Fills every cell with the maximum of the picture"
      },
      "icon": "Network",
      "family": "global",
      "inputs": [
        {
          "name": "in",
          "label": ""
        }
      ],
      "compute": "image_globalMax(in)"
    },
    "fqApply": {
      "name": {
        "zh": "频域相乘",
        "en": "Multiply in frequency"
      },
      "desc": {
        "zh": "把图变到频域，每个频率乘上增益图里对应格子的数，再变回来。增益图和频谱画法一样：中心是频率 (0, 0)",
        "en": "Takes the picture into the frequency domain, multiplies each frequency by the number in the matching cell of the gain picture, and comes back. The gain picture is laid out like a spectrum: its centre is frequency (0, 0)"
      },
      "icon": "Box",
      "family": "other",
      "inputs": [
        {
          "name": "in",
          "label": ""
        },
        {
          "name": "gain"
        }
      ],
      "compute": "image_fqApply(in, gain)"
    },
    "lrnConst": {
      "name": {
        "zh": "可学习常数",
        "en": "Learnable constant"
      },
      "desc": {
        "zh": "一个由训练决定的数。和一张图相加、相乘时，它用在每一格上",
        "en": "A number that training sets. Added to or multiplied with a picture, it applies to every cell"
      },
      "icon": "Activity",
      "family": "learned",
      "inputs": [],
      "settings": [
        {
          "key": "p",
          "label": {
            "zh": "值",
            "en": "Value"
          },
          "control": "custom",
          "widget": "imageKernel",
          "fixed": true,
          "default": [
            1
          ]
        }
      ],
      "compute": "image_lrnConst($p)"
    },
    "learn3": {
      "name": {
        "zh": "可学习 3×3 核",
        "en": "Learnable 3×3 kernel"
      },
      "desc": {
        "zh": "3×3 核，权重由训练决定",
        "en": "3×3 kernel whose weights are set by training"
      },
      "icon": "Activity",
      "family": "learned",
      "inputs": [
        {
          "name": "in",
          "label": ""
        }
      ],
      "settings": [
        {
          "key": "w",
          "label": {
            "zh": "权重",
            "en": "Weights"
          },
          "control": "custom",
          "widget": "imageKernel",
          "fixed": true,
          "default": [
            0,
            0,
            0,
            0,
            0,
            0,
            0,
            0,
            0
          ]
        }
      ],
      "compute": "image_learn3(in, $w)"
    },
    "lrnConv": {
      "name": {
        "zh": "卷积层",
        "en": "Conv layer"
      },
      "desc": {
        "zh": "可学习 3×3 核，从一组很小的随机数开始",
        "en": "Learnable 3×3 kernel, starting from a set of very small random numbers"
      },
      "icon": "Activity",
      "family": "learned",
      "inputs": [
        {
          "name": "in",
          "label": ""
        }
      ],
      "settings": [
        {
          "key": "w",
          "label": {
            "zh": "权重",
            "en": "Weights"
          },
          "control": "custom",
          "widget": "imageKernel",
          "fixed": true,
          "default": [
            0.0076,
            0.0109,
            -0.0112,
            0.0049,
            -0.0166,
            0.0037,
            0.0088,
            -0.0017,
            0.0162
          ]
        }
      ],
      "compute": "image_lrnConv(in, $w)"
    },
    "warp": {
      "name": {
        "zh": "单应变形",
        "en": "Homography warp"
      },
      "desc": {
        "zh": "按 H 把图搬到「画布」那么大的一张图上：画布上每一格取原图里 H⁻¹ 指向的那一格（最近的一格），落在原图外是 0",
        "en": "Carries the picture by H onto a picture the size of the \"canvas\": each cell of the canvas takes the cell of the picture that H⁻¹ points to (the nearest one), and 0 where that falls outside"
      },
      "icon": "Box",
      "family": "other",
      "inputs": [
        {
          "name": "in",
          "label": ""
        },
        {
          "name": "H"
        },
        {
          "name": "onto"
        }
      ],
      "compute": "image_warp(in, H, onto)"
    },
    "zeroUp": {
      "name": {
        "zh": "补零放大",
        "en": "Zero upsample"
      },
      "desc": {
        "zh": "尺寸翻倍：每个像素放在 2×2 的左上角，其余三格补 0",
        "en": "Doubles the size: each pixel goes in the top left of a 2×2 block, the other three are 0"
      },
      "icon": "Minimize2",
      "family": "size",
      "inputs": [
        {
          "name": "in",
          "label": ""
        }
      ],
      "compute": "image_zeroUp(in)"
    },
    "argmin4": {
      "name": {
        "zh": "取最小者编号",
        "en": "Index of minimum"
      },
      "desc": {
        "zh": "逐像素比较几张代价图，输出最小者的编号",
        "en": "Compares cost maps pixel by pixel and outputs the index of the smallest"
      },
      "icon": "Search",
      "family": "search",
      "inputs": [
        {
          "name": "c0",
          "label": "d=0"
        },
        {
          "name": "c1",
          "label": "d=1"
        },
        {
          "name": "c2",
          "label": "d=2"
        },
        {
          "name": "c3",
          "label": "d=3"
        }
      ],
      "nulls": "pass",
      "compute": "image_argmin4(c0, c1, c2, c3)"
    },
    "dg_encode": {
      "name": {
        "zh": "编码器",
        "en": "Encoder"
      },
      "desc": {
        "zh": "把整张图压成一行 k 个数（权重靠训练）",
        "en": "Squeezes the whole image into a row of k numbers (weights come from training)"
      },
      "icon": "Activity",
      "family": "learned",
      "inputs": [
        {
          "name": "in",
          "label": ""
        }
      ],
      "settings": [
        {
          "key": "k",
          "label": {
            "zh": "几个数",
            "en": "How many numbers"
          },
          "control": "select",
          "options": [
            {
              "value": "1",
              "label": {
                "zh": "1 个",
                "en": "1"
              }
            },
            {
              "value": "2",
              "label": {
                "zh": "2 个",
                "en": "2"
              }
            },
            {
              "value": "3",
              "label": {
                "zh": "3 个",
                "en": "3"
              }
            }
          ],
          "default": "1"
        },
        {
          "key": "w",
          "label": {
            "zh": "权重",
            "en": "Weights"
          },
          "control": "custom",
          "widget": "imageKernel",
          "fixed": true,
          "default": [
            0.203,
            -0.112,
            -0.077,
            0.033,
            -0.296,
            -0.183,
            0.278,
            0.217,
            -0.156,
            -0.147,
            -0.274,
            -0.195,
            0.044,
            0.263,
            0.102,
            0.067,
            -0.213,
            -0.128,
            -0.266,
            -0.113,
            -0.254,
            -0.199,
            -0.209,
            0.219,
            0.188,
            0.104,
            -0.023,
            -0.228,
            -0.127,
            0.247,
            -0.251,
            0.058,
            -0.108,
            -0.117,
            0.066,
            -0.024,
            0.024,
            0.064,
            0.205,
            0.055,
            -0.22,
            0.298,
            0.058,
            0.172,
            -0.239,
            0.264,
            -0.054,
            0.097
          ]
        }
      ],
      "compute": "image_dg_encode(in, $k, $w)"
    },
    "dg_decode": {
      "name": {
        "zh": "解码器",
        "en": "Decoder"
      },
      "desc": {
        "zh": "由那几个数画回一张图（权重靠训练）",
        "en": "Draws an image back from those numbers (weights come from training)"
      },
      "icon": "Activity",
      "family": "learned",
      "inputs": [
        {
          "name": "in",
          "label": ""
        }
      ],
      "settings": [
        {
          "key": "w",
          "label": {
            "zh": "权重",
            "en": "Weights"
          },
          "control": "custom",
          "widget": "imageKernel",
          "fixed": true,
          "default": [
            0.155,
            0.201,
            0.015,
            0.083,
            0.003,
            -0.08,
            0,
            0
          ]
        }
      ],
      "compute": "image_dg_decode(in, $w)"
    },
    "dg_mu": {
      "name": "μ",
      "desc": {
        "zh": "两个可训练的数：分布的中心",
        "en": "Two trainable numbers: the centre of the distribution"
      },
      "icon": "Activity",
      "family": "learned",
      "inputs": [],
      "settings": [
        {
          "key": "w",
          "label": "μ",
          "control": "custom",
          "widget": "imageKernel",
          "fixed": true,
          "default": [
            0,
            0
          ]
        }
      ],
      "compute": "image_dg_mu($w)"
    },
    "dg_sigma": {
      "name": "σ",
      "desc": {
        "zh": "两个可训练的数：分布有多散",
        "en": "Two trainable numbers: how spread out the distribution is"
      },
      "icon": "Activity",
      "family": "learned",
      "inputs": [],
      "settings": [
        {
          "key": "w",
          "label": "σ",
          "control": "custom",
          "widget": "imageKernel",
          "fixed": true,
          "default": [
            1,
            1
          ]
        }
      ],
      "compute": "image_dg_sigma($w)"
    },
    "dg_sample": {
      "name": {
        "zh": "采样 z ~ N(μ, σ²)",
        "en": "Sample z ~ N(μ, σ²)"
      },
      "desc": {
        "zh": "每算一次都重新抽一个随机数",
        "en": "Draws a fresh random number every time it runs"
      },
      "icon": "Activity",
      "family": "learned",
      "inputs": [
        {
          "name": "mu",
          "label": "μ"
        },
        {
          "name": "sigma",
          "label": "σ"
        }
      ],
      "compute": "image_dg_sample(mu, sigma)"
    },
    "shift": {
      "name": {
        "zh": "平移",
        "en": "Shift"
      },
      "desc": {
        "zh": "整张图平移一格；从边界移入的格子补 0",
        "en": "Shifts the whole picture by one pixel; cells shifted in from the border are 0"
      },
      "icon": "Move",
      "family": "neighbour",
      "inputs": [
        {
          "name": "in",
          "label": ""
        }
      ],
      "settings": [
        {
          "key": "dir",
          "use": "dir"
        },
        {
          "key": "n",
          "label": {
            "zh": "格数",
            "en": "Steps"
          },
          "control": "number",
          "min": 1,
          "max": 16,
          "step": 1,
          "default": 1
        },
        {
          "key": "border",
          "label": {
            "zh": "边界",
            "en": "Border"
          },
          "control": "select",
          "options": [
            {
              "value": "zero",
              "label": {
                "zh": "补 0",
                "en": "Pad with 0"
              }
            },
            {
              "value": "edge",
              "label": {
                "zh": "复制边缘",
                "en": "Replicate edge"
              }
            },
            {
              "value": "wrap",
              "label": {
                "zh": "循环",
                "en": "Wrap round"
              }
            }
          ],
          "default": "zero"
        }
      ],
      "compute": "image_shift(in, $dir, $n, $border)"
    },
    "invert": {
      "name": {
        "zh": "反相",
        "en": "Invert"
      },
      "desc": {
        "zh": "每个像素变成 1 − 自己：亮的变暗，暗的变亮",
        "en": "Every pixel becomes 1 − itself: light turns dark and dark turns light"
      },
      "icon": "Calculator",
      "family": "pixel",
      "inputs": [
        {
          "name": "in",
          "label": ""
        }
      ],
      "compute": "image_invert(in)"
    },
    "threshold": {
      "name": {
        "zh": "阈值",
        "en": "Threshold"
      },
      "desc": {
        "zh": "大于阈值输出 1，否则输出 0",
        "en": "1 above the threshold, 0 otherwise"
      },
      "icon": "Calculator",
      "family": "pixel",
      "inputs": [
        {
          "name": "in",
          "label": ""
        }
      ],
      "settings": [
        {
          "key": "t",
          "label": ">",
          "control": "number",
          "min": -10,
          "max": 10,
          "step": 0.01,
          "default": 0.5
        }
      ],
      "compute": "image_threshold(in, $t)"
    },
    "blur3h": {
      "name": {
        "zh": "横向三点平均",
        "en": "3-point horizontal average"
      },
      "desc": {
        "zh": "每格换成它和左右两个邻居的平均",
        "en": "Each cell becomes the average of itself and its left and right neighbours"
      },
      "icon": "Grid3x3",
      "family": "neighbour",
      "inputs": [
        {
          "name": "in",
          "label": ""
        }
      ],
      "settings": [
        {
          "key": "border",
          "use": "border"
        }
      ],
      "compute": "image_blur3h(in, $border)"
    },
    "box3": {
      "name": {
        "zh": "3×3 平均",
        "en": "3×3 average"
      },
      "desc": {
        "zh": "每格换成它周围 3×3 九个格子的平均",
        "en": "Each cell becomes the average of the nine cells in the 3×3 block around it"
      },
      "icon": "Grid3x3",
      "family": "neighbour",
      "inputs": [
        {
          "name": "in",
          "label": ""
        }
      ],
      "settings": [
        {
          "key": "border",
          "use": "border"
        }
      ],
      "compute": "image_box3(in, $border)"
    },
    "gauss": {
      "name": {
        "zh": "高斯模糊",
        "en": "Gaussian blur"
      },
      "desc": {
        "zh": "高斯模糊，σ 可调",
        "en": "Gaussian blur, adjustable σ"
      },
      "icon": "Grid3x3",
      "family": "neighbour",
      "inputs": [
        {
          "name": "in",
          "label": ""
        }
      ],
      "settings": [
        {
          "key": "sigma",
          "label": "σ",
          "control": "number",
          "min": 0.5,
          "max": 2.5,
          "step": 0.1,
          "default": 1
        },
        {
          "key": "border",
          "use": "border"
