{
  "presets": {
    "dir": {
      "label": {
        "en": "Direction"
      },
      "control": "buttons",
      "layout": "pad",
      "options": [
        {
          "value": "right",
          "label": "→"
        },
        {
          "value": "left",
          "label": "←"
        },
        {
          "value": "down",
          "label": "↓"
        },
        {
          "value": "up",
          "label": "↑"
        }
      ],
      "default": "right"
    },
    "border": {
      "label": {
        "en": "Border"
      },
      "control": "select",
      "options": [
        {
          "value": "zero",
          "label": {
            "en": "Pad with 0"
          }
        },
        {
          "value": "edge",
          "label": {
            "en": "Replicate edge"
          }
        }
      ],
      "default": "zero"
    }
  },
  "parts": {
    "const": {
      "name": {
        "en": "Constant"
      },
      "desc": {
        "en": "Always outputs the same number. Added to or multiplied with a picture, it applies to every cell"
      },
      "icon": "Hash",
      "family": "pixel",
      "inputs": [],
      "settings": [
        {
          "key": "c",
          "label": "=",
          "control": "number",
          "min": -100,
          "max": 100,
          "step": 0.01,
          "default": 1
        }
      ],
      "compute": "image_const($c)"
    },
    "add": {
      "name": {
        "en": "Add"
      },
      "desc": {
        "en": "Adds two pictures pixel by pixel: a + b"
      },
      "icon": "Calculator",
      "family": "pixel",
      "inputs": [
        {
          "name": "a",
          "label": "a"
        },
        {
          "name": "b",
          "label": "b"
        }
      ],
      "compute": "image_add(a, b)"
    },
    "sub": {
      "name": {
        "en": "Subtract"
      },
      "desc": {
        "en": "Subtracts two pictures pixel by pixel: a − b"
      },
      "icon": "Calculator",
      "family": "pixel",
      "inputs": [
        {
          "name": "a",
          "label": "a"
        },
        {
          "name": "b",
          "label": "b"
        }
      ],
      "compute": "image_sub(a, b)"
    },
    "mul": {
      "name": {
        "en": "Multiply"
      },
      "desc": {
        "en": "Multiplies two pictures pixel by pixel: a × b"
      },
      "icon": "Calculator",
      "family": "pixel",
      "inputs": [
        {
          "name": "a",
          "label": "a"
        },
        {
          "name": "b",
          "label": "b"
        }
      ],
      "compute": "image_mul(a, b)"
    },
    "arith": {
      "name": {
        "en": "Arithmetic"
      },
      "desc": {
        "en": "Adds, subtracts, multiplies or divides two pictures pixel by pixel. Either side can be set to a constant; the other receives a wire"
      },
      "icon": "Plus",
      "family": "pixel",
      "inputs": [
        {
          "name": "a",
          "label": "a"
        },
        {
          "name": "b",
          "label": "b"
        }
      ],
      "settings": [
        {
          "key": "op",
          "label": {
            "en": "Operation"
          },
          "control": "buttons",
          "layout": "grid",
          "options": [
            {
              "value": "add",
              "label": "+"
            },
            {
              "value": "sub",
              "label": "−"
            },
            {
              "value": "mul",
              "label": "×"
            },
            {
              "value": "div",
              "label": "÷"
            }
          ],
          "default": "add"
        },
        {
          "key": "constantSide",
          "label": {
            "en": "Constant side"
          },
          "control": "select",
          "options": [
            {
              "value": "none",
              "label": {
                "en": "Off"
              }
            },
            {
              "value": "a",
              "label": {
                "en": "Left a"
              }
            },
            {
              "value": "b",
              "label": {
                "en": "Right b"
              }
            }
          ],
          "default": "none"
        },
        {
          "key": "constant",
          "label": {
            "en": "Constant"
          },
          "control": "number",
          "min": -100,
          "max": 100,
          "step": 0.01,
          "default": 1,
          "when": "match $constantSide { none: 0, a: 1, b: 1 }"
        }
      ],
      "nulls": "pass",
      "compute": "image_arith(a, b, $op, $constantSide, $constant)"
    },
    "merge": {
      "name": {
        "en": "Merger"
      },
      "desc": {
        "en": "Has three inputs and adds the pictures wired into them pixel by pixel; an empty input is skipped"
      },
      "icon": "Calculator",
      "family": "pixel",
      "inputs": [
        {
          "name": "a",
          "label": "a"
        },
        {
          "name": "b",
          "label": "b"
        },
        {
          "name": "c"
        }
      ],
      "nulls": "pass",
      "compute": "image_merge(a, b, c)"
    },
    "sqrt": {
      "name": {
        "en": "Square root"
      },
      "desc": {
        "en": "Square root of every pixel"
      },
      "icon": "Calculator",
      "family": "pixel",
      "inputs": [
        {
          "name": "in",
          "label": ""
        }
      ],
      "compute": "image_sqrt(in)"
    },
    "exp": {
      "name": "exp",
      "desc": "exp",
      "icon": "Calculator",
      "family": "pixel",
      "inputs": [
        {
          "name": "in",
          "label": ""
        }
      ],
      "compute": "image_exp(in)"
    },
    "globalMax": {
      "name": {
        "en": "Global max"
      },
      "desc": {
        "en": "Fills every cell with the maximum of the picture"
      },
      "icon": "Network",
      "family": "global",
      "inputs": [
        {
          "name": "in",
          "label": ""
        }
      ],
      "compute": "image_globalMax(in)"
    },
    "fqApply": {
      "name": {
        "en": "Multiply in frequency"
      },
      "desc": {
        "en": "Takes the picture into the frequency domain, multiplies each frequency by the number in the matching cell of the gain picture, and comes back. The gain picture is laid out like a spectrum: its centre is frequency (0, 0)"
      },
      "icon": "Box",
      "family": "other",
      "inputs": [
        {
          "name": "in",
          "label": ""
        },
        {
          "name": "gain"
        }
      ],
      "compute": "image_fqApply(in, gain)"
    },
    "lrnConst": {
      "name": {
        "en": "Learnable constant"
      },
      "desc": {
        "en": "A number that training sets. Added to or multiplied with a picture, it applies to every cell"
      },
      "icon": "Activity",
      "family": "learned",
      "inputs": [],
      "settings": [
        {
          "key": "p",
          "label": {
            "en": "Value"
          },
          "control": "custom",
          "widget": "imageKernel",
          "fixed": true,
          "default": [
            1
          ]
        }
      ],
      "compute": "image_lrnConst($p)"
    },
    "learn3": {
      "name": {
        "en": "Learnable 3×3 kernel"
      },
      "desc": {
        "en": "3×3 kernel whose weights are set by training"
      },
      "icon": "Activity",
      "family": "learned",
      "inputs": [
        {
          "name": "in",
          "label": ""
        }
      ],
      "settings": [
        {
          "key": "w",
          "label": {
            "en": "Weights"
          },
          "control": "custom",
          "widget": "imageKernel",
          "fixed": true,
          "default": [
            0,
            0,
            0,
            0,
            0,
            0,
            0,
            0,
            0
          ]
        }
      ],
      "compute": "image_learn3(in, $w)"
    },
    "lrnConv": {
      "name": {
        "en": "Conv layer"
      },
      "desc": {
        "en": "Learnable 3×3 kernel, starting from a set of very small random numbers"
      },
      "icon": "Activity",
      "family": "learned",
      "inputs": [
        {
          "name": "in",
          "label": ""
        }
      ],
      "settings": [
        {
          "key": "w",
          "label": {
            "en": "Weights"
          },
          "control": "custom",
          "widget": "imageKernel",
          "fixed": true,
          "default": [
            0.0076,
            0.0109,
            -0.0112,
            0.0049,
            -0.0166,
            0.0037,
            0.0088,
            -0.0017,
            0.0162
          ]
        }
      ],
      "compute": "image_lrnConv(in, $w)"
    },
    "warp": {
      "name": {
        "en": "Homography warp"
      },
      "desc": {
        "en": "Carries the picture by H onto a picture the size of the \"canvas\": each cell of the canvas takes the cell of the picture that H⁻¹ points to (the nearest one), and 0 where that falls outside"
      },
      "icon": "Box",
      "family": "other",
      "inputs": [
        {
          "name": "in",
          "label": ""
        },
        {
          "name": "H"
        },
        {
          "name": "onto"
        }
      ],
      "compute": "image_warp(in, H, onto)"
    },
    "zeroUp": {
      "name": {
        "en": "Zero upsample"
      },
      "desc": {
        "en": "Doubles the size: each pixel goes in the top left of a 2×2 block, the other three are 0"
      },
      "icon": "Minimize2",
      "family": "size",
      "inputs": [
        {
          "name": "in",
          "label": ""
        }
      ],
      "compute": "image_zeroUp(in)"
    },
    "argmin4": {
      "name": {
        "en": "Index of minimum"
      },
      "desc": {
        "en": "Compares cost maps pixel by pixel and outputs the index of the smallest"
      },
      "icon": "Search",
      "family": "search",
      "inputs": [
        {
          "name": "c0",
          "label": "d=0"
        },
        {
          "name": "c1",
          "label": "d=1"
        },
        {
          "name": "c2",
          "label": "d=2"
        },
        {
          "name": "c3",
          "label": "d=3"
        }
      ],
      "nulls": "pass",
      "compute": "image_argmin4(c0, c1, c2, c3)"
    },
    "dg_encode": {
      "name": {
        "en": "Encoder"
      },
      "desc": {
        "en": "Squeezes the whole image into a row of k numbers (weights come from training)"
      },
      "icon": "Activity",
      "family": "learned",
      "inputs": [
        {
          "name": "in",
          "label": ""
        }
      ],
      "settings": [
        {
          "key": "k",
          "label": {
            "en": "How many numbers"
          },
          "control": "select",
          "options": [
            {
              "value": "1",
              "label": {
                "en": "1"
              }
            },
            {
              "value": "2",
              "label": {
                "en": "2"
              }
            },
            {
              "value": "3",
              "label": {
                "en": "3"
              }
            }
          ],
          "default": "1"
        },
        {
          "key": "w",
          "label": {
            "en": "Weights"
          },
          "control": "custom",
          "widget": "imageKernel",
          "fixed": true,
          "default": [
            0.203,
            -0.112,
            -0.077,
            0.033,
            -0.296,
            -0.183,
            0.278,
            0.217,
            -0.156,
            -0.147,
            -0.274,
            -0.195,
            0.044,
            0.263,
            0.102,
            0.067,
            -0.213,
            -0.128,
            -0.266,
            -0.113,
            -0.254,
            -0.199,
            -0.209,
            0.219,
            0.188,
            0.104,
            -0.023,
            -0.228,
            -0.127,
            0.247,
            -0.251,
            0.058,
            -0.108,
            -0.117,
            0.066,
            -0.024,
            0.024,
            0.064,
            0.205,
            0.055,
            -0.22,
            0.298,
            0.058,
            0.172,
            -0.239,
            0.264,
            -0.054,
            0.097
          ]
        }
      ],
      "compute": "image_dg_encode(in, $k, $w)"
    },
    "dg_decode": {
      "name": {
        "en": "Decoder"
      },
      "desc": {
        "en": "Draws an image back from those numbers (weights come from training)"
      },
      "icon": "Activity",
      "family": "learned",
      "inputs": [
        {
          "name": "in",
          "label": ""
        }
      ],
      "settings": [
        {
          "key": "w",
          "label": {
            "en": "Weights"
          },
          "control": "custom",
          "widget": "imageKernel",
          "fixed": true,
          "default": [
            0.155,
            0.201,
            0.015,
            0.083,
            0.003,
            -0.08,
            0,
            0
          ]
        }
      ],
      "compute": "image_dg_decode(in, $w)"
    },
    "dg_mu": {
      "name": "μ",
      "desc": {
        "en": "Two trainable numbers: the centre of the distribution"
      },
      "icon": "Activity",
      "family": "learned",
      "inputs": [],
      "settings": [
        {
          "key": "w",
          "label": "μ",
          "control": "custom",
          "widget": "imageKernel",
          "fixed": true,
          "default": [
            0,
            0
          ]
        }
      ],
      "compute": "image_dg_mu($w)"
    },
    "dg_sigma": {
      "name": "σ",
      "desc": {
        "en": "Two trainable numbers: how spread out the distribution is"
      },
      "icon": "Activity",
      "family": "learned",
      "inputs": [],
      "settings": [
        {
          "key": "w",
          "label": "σ",
          "control": "custom",
          "widget": "imageKernel",
          "fixed": true,
          "default": [
            1,
            1
          ]
        }
      ],
      "compute": "image_dg_sigma($w)"
    },
    "dg_sample": {
      "name": {
        "en": "Sample z ~ N(μ, σ²)"
      },
      "desc": {
        "en": "Draws a fresh random number every time it runs"
      },
      "icon": "Activity",
      "family": "learned",
      "inputs": [
        {
          "name": "mu",
          "label": "μ"
        },
        {
          "name": "sigma",
          "label": "σ"
        }
      ],
      "compute": "image_dg_sample(mu, sigma)"
    },
    "shift": {
      "name": {
        "en": "Shift"
      },
      "desc": {
        "en": "Shifts the whole picture by one pixel; cells shifted in from the border are 0"
      },
      "icon": "Move",
      "family": "neighbour",
      "inputs": [
        {
          "name": "in",
          "label": ""
        }
      ],
      "settings": [
        {
          "key": "dir",
          "use": "dir"
        },
        {
          "key": "n",
          "label": {
            "en": "Steps"
          },
          "control": "number",
          "min": 1,
          "max": 16,
          "step": 1,
          "default": 1
        },
        {
          "key": "border",
          "label": {
            "en": "Border"
          },
          "control": "select",
          "options": [
            {
              "value": "zero",
              "label": {
                "en": "Pad with 0"
              }
            },
            {
              "value": "edge",
              "label": {
                "en": "Replicate edge"
              }
            },
            {
              "value": "wrap",
              "label": {
                "en": "Wrap round"
              }
            }
          ],
          "default": "zero"
        }
      ],
      "compute": "image_shift(in, $dir, $n, $border)"
    },
    "invert": {
      "name": {
        "en": "Invert"
      },
      "desc": {
        "en": "Every pixel becomes 1 − itself: light turns dark and dark turns light"
      },
      "icon": "Calculator",
      "family": "pixel",
      "inputs": [
        {
          "name": "in",
          "label": ""
        }
      ],
      "compute": "image_invert(in)"
    },
    "threshold": {
      "name": {
        "en": "Threshold"
      },
      "desc": {
        "en": "1 above the threshold, 0 otherwise"
      },
      "icon": "Calculator",
      "family": "pixel",
      "inputs": [
        {
          "name": "in",
          "label": ""
        }
      ],
      "settings": [
        {
          "key": "t",
          "label": ">",
          "control": "number",
          "min": -10,
          "max": 10,
          "step": 0.01,
          "default": 0.5
        }
      ],
      "compute": "image_threshold(in, $t)"
    },
    "blur3h": {
      "name": {
        "en": "3-point horizontal average"
      },
      "desc": {
        "en": "Each cell becomes the average of itself and its left and right neighbours"
      },
      "icon": "Grid3x3",
      "family": "neighbour",
      "inputs": [
        {
          "name": "in",
          "label": ""
        }
      ],
      "settings": [
        {
          "key": "border",
          "use": "border"
        }
      ],
      "compute": "image_blur3h(in, $border)"
    },
    "box3": {
      "name": {
        "en": "3×3 average"
      },
      "desc": {
        "en": "Each cell becomes the average of the nine cells in the 3×3 block around it"
      },
      "icon": "Grid3x3",
      "family": "neighbour",
      "inputs": [
        {
          "name": "in",
          "label": ""
        }
      ],
      "settings": [
        {
          "key": "border",
          "use": "border"
        }
      ],
      "compute": "image_box3(in, $border)"
    },
    "gauss": {
      "name": {
        "en": "Gaussian blur"
      },
      "desc": {
        "en": "Gaussian blur, adjustable σ"
      },
      "icon": "Grid3x3",
      "family": "neighbour",
      "inputs": [
        {
          "name": "in",
          "label": ""
        }
      ],
      "settings": [
        {
          "key": "sigma",
          "label": "σ",
          "control": "number",
          "min": 0.5,
          "max": 2.5,
          "step": 0.1,
          "default": 1
        },
        {
          "key": "border",
          "use": "border"
        }
      ],
      "compute": "image_gauss(in, $sigma, $border)"
    },
    "diffx": {
      "name": {
        "en": "Horizontal difference"
      },
      "desc": {
        "en": "Right neighbour − itself"
      },
      "icon": "Grid3x3",
      "family": "neighbour",
      "inputs": [
        {
          "name": "in",
          "label": ""
        }
      ],
      "compute": "image_diffx(in)"
    },
    "sobelx": {
      "name": "Sobel x",
      "desc": {
        "en": "Differentiates across, smooths down"
      },
      "icon": "Grid3x3",
      "family": "neighbour",
      "inputs": [
        {
          "name": "in",
          "label": ""
        }
      ],
      "settings": [
        {
          "key": "border",
          "use": "border"
        }
      ],
      "compute": "image_sobelx(in, $border)"
    },
    "sobely": {
      "name": "Sobel y",
      "desc": {
        "en": "Differentiates down, smooths across"
      },
      "icon": "Grid3x3",
      "family": "neighbour",
      "inputs": [
        {
          "name": "in",
          "label": ""
        }
      ],
      "settings": [
        {
          "key": "border",
          "use": "border"
        }
      ],
      "compute": "image_sobely(in, $border)"
    },
    "kernel3": {
      "name": {
        "en": "3×3 kernel"
      },
      "desc": {
        "en": "Any 3×3 kernel (weights read as cross-correlation)"
      },
      "icon": "Grid3x3",
      "family": "neighbour",
      "inputs": [
        {
          "name": "in",
          "label": ""
        }
      ],
      "settings": [
        {
          "key": "w",
          "label": {
            "en": "Weights"
          },
          "control": "custom",
          "widget": "imageKernel",
          "default": [
            0,
            0,
            0,
            0,
            1,
            0,
            0,
            0,
            0
          ]
        },
        {
          "key": "border",
          "use": "border"
        }
      ],
      "compute": "image_kernel3(in, $w, $border)"
    },
    "cos": {
      "name": "cos",
      "desc": "cos",
      "icon": "Calculator",
      "family": "pixel",
      "inputs": [
        {
          "name": "in",
          "label": ""
        }
      ],
      "compute": "image_cos(in)"
    },
    "fqWave": {
      "name": {
        "en": "Wave"
      },
      "desc": {
        "en": "A wave of 32 points: cos or sin(2π·k·x/32), swinging between −1 and 1"
      },
      "icon": "Waves",
      "family": "frequency",
      "inputs": [],
      "settings": [
        {
          "key": "k",
          "label": {
            "en": "Frequency k"
          },
          "control": "number",
          "min": 0,
          "max": 16,
          "step": 1,
          "default": 1
        },
        {
          "key": "form",
          "label": {
            "en": "Shape"
          },
          "control": "select",
          "options": [
            {
              "value": "cos",
              "label": "cos"
            },
            {
              "value": "sin",
              "label": "sin"
            }
          ],
          "default": "cos"
        }
      ],
      "compute": "image_fqWave($k, $form)"
    },
    "fqMean": {
      "name": {
        "en": "Compute the average"
      },
      "desc": {
        "en": "Averages a row of numbers into a single number"
      },
      "icon": "Network",
      "family": "global",
      "inputs": [
        {
          "name": "in",
          "label": ""
        }
      ],
      "compute": "image_fqMean(in)"
    },
    "fqSpectrum": {
      "name": {
        "en": "Frequency spectrum"
      },
      "desc": {
        "en": "The centred, log-scaled magnitude spectrum: the centre is the average brightness, and further out means faster change"
      },
      "icon": "Waves",
      "family": "frequency",
      "inputs": [
        {
          "name": "in",
          "label": ""
        }
      ],
      "compute": "image_fqSpectrum(in)"
