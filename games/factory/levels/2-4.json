{
  "title": { "zh": "两处陷阱" },
  "intro": [
    {
      "t": {
        "zh": "和<level-ref to=\"2-3\"></level-ref>一样的机器，多一层：要转更多轮，测试报告里一次失败两处。"
      }
    }
  ],
  "after": {
    "zh": "一份报告列出所有失败，模型每一轮修它看得到的那些。轮数多了，历史也跟着变长。"
  },
  "tasks": [
    {
      "id": "2-4",
      "kind": "board",
      "brief": { "zh": "一个 issue，两处容易写错的修改，在两个文件里。" },
      "tests": [{ "issue": "two-traps" }],
      "solution": [
        "k = concat(issue, history)",
        "m = model(k)",
        "r = read(m)",
        "l = list(m)",
        "t = test(m)",
        "keep = concat(r, l, t.out)",
        "repo <- m",
        "out <- keep",
        "stop <- t.green"
      ]
    }
  ]
}
