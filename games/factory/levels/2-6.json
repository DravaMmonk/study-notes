  "intro": [
    {
      "t": {
        "zh": "只写函数名的、有陷阱的、只说症状的，一块板全部接住。"
      }
    }
  ],
  "after": {
    "zh": "一块板接住了三种 issue：要目录、读文件、跑测试、改到通过。这就是一个完整的编码 agent：一个循环，一个上下文，几个工具，一道检查。"
  },
  "tasks": [
    {
      "id": "2-6",
      "kind": "board",
      "brief": {
        "zh": "三种 issue 混在一起，每个都要在 10 轮内改好并停下。"
      },
      "turns": 10,
      "tests": [{ "issue": "login-case" }, { "issue": "two-traps" }, { "issue": "stuck-session" }],
      "solution": [
        "k = concat(issue, history)",
        "m = model(k)",
        "r = read(m)",
        "l = list(m)",
        "t = test(m)",
        "keep = concat(r, l, t.out)",
        "repo <- m",
        "out <- keep",
        "stop <- t.green"
      ]
    }
  ]
}
