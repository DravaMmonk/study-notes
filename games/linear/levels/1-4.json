{
  "title": { "zh": "线性组合" },
  "intro": [
    {
      "t": {
        "zh": "回头看<level-ref to=\"1-2\"></level-ref>和<level-ref to=\"1-3\"></level-ref>交出的点：每一个都是几支箭头各自乘一个数、再相加。这样拼出的箭头叫这几支箭头的<wiki-ref to=\"linear-combination\"></wiki-ref>。这个形状还会反复出现，这一关把它做成一块元件，乘的数从输入接进来。"
      }
    }
  ],
  "after": {
    "zh": "固定 v、w，让 a、b 取遍所有的数，得到的全部点叫 v 和 w 的<wiki-ref to=\"span\"></wiki-ref>。"
  },
  "builds": {
    "type": "combo",
    "name": { "zh": "线性组合" },
    "desc": {
      "zh": "给出 a·v + b·w：v 伸缩 a 倍、w 伸缩 b 倍，再相加。"
    }
  },
  "tasks": [
    {
      "id": "1-4",
      "brief": { "zh": "交出 a·v + b·w。" },
      "inputs": [
        { "name": "a", "label": "a" },
        { "name": "b", "label": "b" },
        { "name": "v", "label": "v" },
        { "name": "w", "label": "w" }
      ],
      "outputs": [{ "name": "out", "label": { "zh": "组合" } }],
      "tests": [
        { "inputs": { "a": 2, "b": -1, "v": [1, 0], "w": [0, 1] }, "expect": { "out": [2, -1] } },
        { "inputs": { "a": 0.5, "b": 0.5, "v": [4, 0], "w": [0, 2] }, "expect": { "out": [2, 1] } },
        { "inputs": { "a": 3, "b": 0, "v": [1, 2], "w": [5, 5] }, "expect": { "out": [3, 6] } },
        { "inputs": { "a": -1, "b": 2, "v": [2, 1], "w": [1, 1] }, "expect": { "out": [0, 1] } }
      ],
      "hidden": [
        { "inputs": { "a": 1, "b": 1, "v": [1, 2], "w": [2, 4] }, "expect": { "out": [3, 6] } },
        { "inputs": { "a": 2, "b": -1, "v": [1, 0, 1], "w": [0, 1, 1] }, "expect": { "out": [2, -1, 1] } }
      ],
      "solution": ["s = scale(a, v)", "t = scale(b, w)", "c = add(s, t)", "out <- c"],
      "naive": ["s = scale(a, v)", "c = add(s, w)", "out <- c"]
    }
  ]
}
