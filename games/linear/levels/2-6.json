{
  "title": { "zh": "连做三次", "en": "Three times over" },
  "intro": [{ "t": { "zh": "同一个变换连做三次。", "en": "One map, done three times over." } }],
  "after": {
    "zh": "(AA)A 与 A(AA) 相等：矩阵乘法满足结合律，A³ 不必加括号。",
    "en": "(AA)A equals A(AA): the matrix product is associative, so A³ needs no brackets."
  },
  "tasks": [
    {
      "id": "2-6",
      "brief": { "zh": "交出 A 连做三次的矩阵 A³。", "en": "Give A³, the matrix of A done three times." },
      "inputs": [{ "name": "A", "label": "A" }],
      "outputs": [{ "name": "A3", "label": "A³" }],
      "tests": [
        { "inputs": { "A": [[0, -1], [1, 0]] }, "expect": { "A3": [[0, 1], [-1, 0]] } },
        { "inputs": { "A": [[1, 1], [0, 1]] }, "expect": { "A3": [[1, 3], [0, 1]] } },
        { "inputs": { "A": [[0, 1], [1, 0]] }, "expect": { "A3": [[0, 1], [1, 0]] } },
        { "inputs": { "A": [[2, 0], [0, -1]] }, "expect": { "A3": [[8, 0], [0, -1]] } }
      ],
      "solution": ["p = compose(A, A)", "q = compose(p, A)", "A3 <- q"],
      "naive": ["p = compose(A, A)", "A3 <- p"]
    }
  ]
}
