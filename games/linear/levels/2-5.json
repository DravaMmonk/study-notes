{
  "title": { "zh": "谁先谁后" },
  "intro": [
    {
      "t": {
        "zh": "两个数相乘不管先后。两个变换呢？"
      }
    }
  ],
  "after": {
    "zh": "一般 AB ≠ BA：矩阵乘法不满足交换律。两个非零矩阵的乘积也可能是零矩阵。"
  },
  "tasks": [
    {
      "id": "2-5",
      "brief": { "zh": "同时交出 AB 和 BA。" },
      "inputs": [{ "name": "A", "label": "A" }, { "name": "B", "label": "B" }],
      "outputs": [{ "name": "AB", "label": "AB" }, { "name": "BA", "label": "BA" }],
      "tests": [
        {
          "inputs": { "A": [[0, -1], [1, 0]], "B": [[1, 1], [0, 1]] },
          "expect": { "AB": [[0, -1], [1, 1]], "BA": [[1, -1], [1, 0]] }
        },
        {
          "inputs": { "A": [[2, 0], [0, 3]], "B": [[-1, 0], [0, 0.5]] },
          "expect": { "AB": [[-2, 0], [0, 1.5]], "BA": [[-2, 0], [0, 1.5]] }
        },
        {
          "inputs": { "A": [[0, 1], [0, 0]], "B": [[1, 0], [0, 0]] },
          "expect": { "AB": [[0, 0], [0, 0]], "BA": [[0, 1], [0, 0]] }
        },
        {
          "inputs": { "A": [[0, 1], [1, 0]], "B": [[2, 0], [0, 3]] },
          "expect": { "AB": [[0, 3], [2, 0]], "BA": [[0, 2], [3, 0]] }
        }
      ],
      "solution": ["p = compose(A, B)", "q = compose(B, A)", "AB <- p", "BA <- q"],
      "naive": ["p = compose(A, B)", "AB <- p", "BA <- p"]
    }
  ]
}
