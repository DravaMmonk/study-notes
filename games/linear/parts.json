{
  "parts": {
    "add": {
      "name": { "zh": "相加", "en": "Add" },
      "desc": {
        "zh": "把两个形状相同的向量逐个分量相加：画出来，第二支箭头接在第一支的箭头尖上，和从起点指到终点。",
        "en": "Adds two vectors of one shape entry by entry: drawn, the second arrow starts at the tip of the first, and the sum runs from the start to the end."
      },
      "icon": "Plus",
      "family": "vector",
      "inputs": [{ "name": "u" }, { "name": "v" }],
      "compute": "add(u, v)"
    },
    "scale": {
      "name": { "zh": "数乘", "en": "Scale" },
      "desc": {
        "zh": "数 k 乘向量 v 的每个分量：箭头沿自己所在的直线伸缩 k 倍，k 为负时掉头。",
        "en": "Multiplies every entry of the vector v by the number k: the arrow stretches or shrinks k times along its own line, and turns round when k is negative."
      },
      "icon": "Scaling",
      "family": "vector",
      "inputs": [{ "name": "k" }, { "name": "v" }],
      "compute": "scale(k, v)"
    },
    "num": {
      "name": { "zh": "常数", "en": "Constant" },
      "desc": { "zh": "给出设定的那个数。", "en": "Gives the number it is set to." },
      "icon": "Hash",
      "family": "number",
      "inputs": [],
      "settings": [{ "key": "value", "control": "number", "label": { "zh": "数", "en": "Number" }, "step": 0.5, "default": 1 }],
      "compute": "$value"
    },
    "entry": {
      "name": { "zh": "取分量", "en": "Entry" },
      "desc": {
        "zh": "给出向量从上往下数的第 i 个分量，一个数。",
        "en": "Gives entry i of the vector, counting from the top: a number."
      },
      "icon": "ArrowDown",
      "family": "number",
      "inputs": [{ "name": "v" }],
      "settings": [
        {
          "key": "i",
          "control": "buttons",
          "label": { "zh": "第几个", "en": "Which" },
          "options": [{ "value": "1" }, { "value": "2" }, { "value": "3" }],
          "default": "1"
        }
      ],
      "compute": "entry(v, $i)",
      "views": { "tile": [{ "show": "value" }, { "show": "setting", "key": "i", "as": "label" }] }
    },
    "vec": {
      "name": { "zh": "拼向量", "en": "Vector" },
      "desc": {
        "zh": "把接进来的数从上到下排成一个向量；最后一个口可以不接。",
        "en": "Stacks the numbers wired in, top to bottom, into a vector; the last port may be left unwired."
      },
      "icon": "Brackets",
      "family": "vector",
      "inputs": [{ "name": "a" }, { "name": "b" }, { "name": "c", "optional": true }],
      "compute": "vec(a, b, c)"
    },
    "column": {
      "name": { "zh": "取列", "en": "Column" },
      "desc": {
        "zh": "给出矩阵从左往右数的第 j 列，一个向量。",
        "en": "Gives column j of the matrix, counting from the left: a vector."
      },
      "icon": "Split",
      "family": "matrix",
      "inputs": [{ "name": "m" }],
      "settings": [
        {
          "key": "j",
          "control": "buttons",
          "label": { "zh": "第几列", "en": "Which" },
          "options": [{ "value": "1" }, { "value": "2" }, { "value": "3" }],
          "default": "1"
        }
      ],
      "compute": "column(m, $j)"
    },
    "join": {
      "name": { "zh": "并列", "en": "Side by side" },
      "desc": {
        "zh": "把接进来的向量从左到右并排成一个矩阵，每个向量是一列；后两个口可以不接。",
        "en": "Sets the vectors wired in side by side, left to right, as the columns of a matrix; the last two ports may be left unwired."
      },
      "icon": "Merge",
      "family": "matrix",
      "inputs": [{ "name": "a" }, { "name": "b", "optional": true }, { "name": "c", "optional": true }],
      "compute": "join(a, b, c)"
    },
    "arith": {
      "name": { "zh": "算数", "en": "Arithmetic" },
      "desc": { "zh": "对两个数做所选的运算。", "en": "Works out the chosen operation on two numbers." },
      "icon": "Calculator",
      "family": "number",
      "inputs": [{ "name": "a" }, { "name": "b" }],
      "settings": [
        {
          "key": "op",
          "control": "buttons",
          "label": { "zh": "运算", "en": "Operation" },
          "options": [
            { "value": "add", "label": "+", "about": { "zh": "a 加 b。", "en": "a plus b." } },
            { "value": "sub", "label": "−", "about": { "zh": "a 减 b。", "en": "a less b." } },
            { "value": "mul", "label": "×", "about": { "zh": "a 乘 b。", "en": "a times b." } },
            {
              "value": "div",
              "label": "÷",
              "about": { "zh": "a 除以 b；b 为 0 时没有结果。", "en": "a divided by b; there is no result when b is 0." }
            }
          ],
          "default": "mul"
        }
      ],
      "compute": "arith(a, b, op=$op)",
      "views": { "tile": [{ "show": "value" }, { "show": "setting", "key": "op", "as": "label" }] }
    }
  }
}
