{
  "presets": {
    "border": {
      "label": { "en": "Border" },
      "control": "select",
      "options": [
        { "value": "zero", "label": { "en": "Pad with 0" } },
        { "value": "edge", "label": { "en": "Replicate edge" } }
      ],
      "default": "zero"
    }
  },
  "parts": {
    "line3": {
      "name": { "en": "1D 3-point kernel" },
      "desc": { "en": "Take three neighbouring pixels along a row or column, multiply each by its weight, and add them." },
      "icon": "Grid3x3",
      "family": "neighbour",
      "inputs": [{ "name": "in", "label": "" }],
      "settings": [
        {
          "key": "axis",
          "label": { "en": "Direction" },
          "control": "select",
          "options": [{ "value": "x", "label": { "en": "Across" } }, { "value": "y", "label": { "en": "Down" } }],
          "default": "x"
        },
        { "key": "a", "label": "a", "control": "number", "min": -4, "max": 4, "step": 1, "default": 0 },
        { "key": "b", "label": "b", "control": "number", "min": -4, "max": 4, "step": 1, "default": 1 },
        { "key": "c", "label": "c", "control": "number", "min": -4, "max": 4, "step": 1, "default": 0 },
        { "key": "border", "use": "border" }
      ],
      "compute": "image_line3(in, $axis, $a, $b, $c, $border)"
    },
    "add": {
      "name": { "en": "Add" },
      "desc": { "en": "Adds two pictures pixel by pixel: a + b" },
      "icon": "Calculator",
      "family": "pixel",
      "inputs": [{ "name": "a", "label": "a" }, { "name": "b", "label": "b" }],
      "compute": "image_add(a, b)"
    }
  }
}
