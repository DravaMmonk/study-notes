{
  "title": { "en": "Frequency, amplitude and phase" },
  "intro": [],
  "after": {
    "en": "The average moves the whole wave up or down, the amplitude sets how high it swings, the frequency how many cycles fit in the row, and the phase only slides it sideways; half a cycle of phase looks like the swing turned over."
  },
  "tasks": [
    {
      "id": "sinusoid",
      "kind": "board",
      "brief": {
        "en": "Each step’s target differs from your wave in one number. Judge which one and by how much, turn only that one, then check."
      },
      "bench": {
        "model": "wave",
        "setup": { "N": 32 },
        "knobs": {
          "c": {
            "label": { "en": "Average c" },
            "min": 0,
            "max": 1,
            "step": 0.05,
            "format": "auto"
          },
          "A": {
            "label": { "en": "Amplitude A" },
            "min": 0,
            "max": 0.5,
            "step": 0.05,
            "format": "auto"
          },
          "k": {
            "label": { "en": "Frequency k" },
            "min": 0,
            "max": 12,
            "step": 1,
            "format": "auto"
          },
          "phi": {
            "label": { "en": "Phase φ" },
            "min": -4,
            "max": 4,
            "step": 1,
            "format": "quarterPi"
          }
        },
        "check": "submit",
        "goal": [{ "of": "gap", "below": 0.000001 }],
        "stages": [
          {
            "title": { "en": "Moved a little" },
            "note": { "en": "The target sits a little to the left of your wave." },
            "start": { "c": 0.5, "A": 0.3, "k": 2, "phi": 0 },
            "target": { "c": 0.5, "A": 0.3, "k": 2, "phi": 2 }
          },
          {
            "title": { "en": "Turned over" },
            "note": { "en": "The target is light where your wave is dark." },
            "start": { "c": 0.5, "A": 0.3, "k": 3, "phi": 0 },
            "target": { "c": 0.5, "A": 0.3, "k": 3, "phi": 4 }
          }
        ],
        "layout": {
          "main": [
            {
              "plot": {
                "lines": [
                  {
                    "of": "target",
                    "kind": "target",
                    "label": { "en": "target" },
                    "legend": { "en": "target" }
                  },
                  {
                    "of": "yours",
                    "kind": "yours",
                    "label": { "en": "yours" },
                    "legend": { "en": "Your wave" }
                  }
                ],
                "height": [240, 200],
                "legend": true
              }
            },
            {
              "strips": {
                "rows": [
                  { "of": "targetRow", "label": { "en": "target" } },
                  { "of": "row", "label": { "en": "yours" } }
                ]
              }
            }
          ],
          "side": [{ "panel": ["step", "knobs", "verdict"] }, "stages"]
        }
      }
    }
  ]
}
