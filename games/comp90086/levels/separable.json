{
  "title": { "en": "Separable filters and their cost" },
  "intro": [],
  "after": {
    "en": "Only a kernel that is a column times a row runs as a pass across then a pass down; the Laplacian is no product but the sum of two second differences, across and down."
  },
  "adds": ["line3", "add"],
  "tasks": [
    {
      "id": "separable",
      "kind": "graph",
      "scene": "filter",
      "brief": {
        "en": "The Laplacian 0 1 0 / 1 −4 1 / 0 1 0 is no column times a row. Can 1D three-point kernels alone compute it? Make the output match it."
      },
      "setup": { "target": { "correlate": { "kernel": [0, 1, 0, 1, -4, 1, 0, 1, 0] } } },
      "tests": [
        { "label": { "en": "Bright dot" }, "in": { "impulse": { "x": 7, "y": 7 } } },
        { "label": { "en": "Disc" }, "in": "disk" },
        { "label": { "en": "Checkerboard" }, "in": "checker" }
      ],
      "hidden": [{ "label": { "en": "Letter T" }, "in": { "glyph": { "letter": "T" } } }],
      "solution": [
        "h = line3[axis=x,a=1,b=-2,c=1](in)",
        "v = line3[axis=y,a=1,b=-2,c=1](in)",
        "s = add(h, v)",
        "out <- s"
      ],
      "naive": ["h = line3[axis=x,a=1,b=-2,c=1](in)", "v = line3[axis=y,a=1,b=-2,c=1](h)", "out <- v"]
    }
  ]
}
