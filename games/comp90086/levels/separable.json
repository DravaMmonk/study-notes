{
  "title": { "zh": "空间可分离滤波与计算量" },
  "intro": [],
  "after": {
    "zh": "能拆成一列乘一行的核，才能先横后竖地串起来；拉普拉斯不是乘积，而是横竖两个二阶差分的和。"
  },
  "adds": ["line3", "add"],
  "tasks": [
    {
      "id": "separable",
      "kind": "graph",
      "scene": "filter",
      "brief": {
        "zh": "拉普拉斯核 0 1 0 ／ 1 −4 1 ／ 0 1 0 写不成一列乘一行。只用一维三点核，能不能算出它？让输出和它一样。"
      },
      "setup": { "target": { "correlate": { "kernel": [0, 1, 0, 1, -4, 1, 0, 1, 0] } } },
      "tests": [
        { "label": { "zh": "亮点" }, "in": { "impulse": { "x": 7, "y": 7 } } },
        { "label": { "zh": "圆盘" }, "in": "disk" },
        { "label": { "zh": "棋盘" }, "in": "checker" }
      ],
      "hidden": [{ "label": { "zh": "字母 T" }, "in": { "glyph": { "letter": "T" } } }],
      "solution": [
        "h = line3[axis=x,a=1,b=-2,c=1](in)",
        "v = line3[axis=y,a=1,b=-2,c=1](in)",
        "s = add(h, v)",
        "out <- s"
      ],
      "naive": ["h = line3[axis=x,a=1,b=-2,c=1](in)", "v = line3[axis=y,a=1,b=-2,c=1](h)", "out <- v"]
    }
  ]
}
