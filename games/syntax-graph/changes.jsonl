个动词词组，连同助动词（has been shown）。"},{"op":"i18n.set","lang":"en","from":"句子说的是谁、是什么。标出它的名词短语：修饰成分都折起来以后，剩下的那几个词。"},{"op":"game.set","path":["vocabulary"],"value":1},{"op":"game.set","path":["concept"],"value":{"role:subj":"skeleton","role:verb":"skeleton","role:obj":"skeleton","role:comp":"skeleton"}},{"op":"game.set","path":["trays"],"value":{"main":["role:subj","role:verb","role:obj","pp","role:comp","rel"]}},{"op":"level.set","level":"1-5","path":["adds"],"value":["role:comp"]},{"op":"level.set","level":"1-1","path":["adds"],"value":["role:subj","role:verb","role:obj"]},{"op":"piece.remove","piece":"rel"},{"op":"piece.remove","piece":"pp"},{"op":"piece.remove","piece":"comp"},{"op":"piece.remove","piece":"obj"},{"op":"piece.remove","piece":"verb"},{"op":"piece.remove","piece":"subj"}]}
