            { "id": "0,2", "x": 104, "y": 0, "w": 44, "h": 44, "value": 0, "cls": "dimc" },
            { "id": "0,3", "x": 156, "y": 0, "w": 44, "h": 44, "value": 0, "cls": "dimc" },
            { "id": "1,0", "x": 0, "y": 52, "w": 44, "h": 44, "value": 0, "cls": "lit" },
