            { "id": "2,0", "x": 0, "y": 104, "w": 44, "h": 44, "value": 0, "cls": "lit" },
            { "id": "2,1", "x": 52, "y": 104, "w": 44, "h": 44, "value": 2, "cls": "lit" },
            { "id": "2,2", "x": 104, "y": 104, "w": 44, "h": 44, "value": 3, "cls": "lit" },
