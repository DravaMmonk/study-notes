            { "a": "1,2", "b": "2,3", "cls": "dim", "bend": 0, "off": 0 }
          ],
          "texts": [
            { "x": -32, "y": -33, "t": { "zh": "容量" }, "anchor": "end" },
            { "x": -32, "y": 5, "t": { "zh": "不放东西" }, "anchor": "end" },
            { "x": -32, "y": 57, "t": { "zh": "相机 2kg · 3" }, "anchor": "end" },
            { "x": -32, "y": 109, "t": { "zh": "水壶 1kg · 2" }, "anchor": "end" }
          ]
        }
      }
    },
    {
      "t": {
        "zh": "原地改写有个风险：改 dp[w] 时要读 dp[w − 重量]。如果那一格<b>这一轮已经改过</b>，读到的就是「已经拿过这件物品」的值。"
      },
      "fig": {
        "scene": {
          "cells": [
            { "id": "d0", "x": 0, "y": 0, "w": 46, "h": 46, "value": 0, "corner": 0, "cls": "lit" },
            { "id": "d1", "x": 56, "y": 0, "w": 46, "h": 46, "value": 2, "corner": 1, "cls": "bad" },
            { "id": "d2", "x": 112, "y": 0, "w": 46, "h": 46, "value": 4, "corner": 2, "cls": "lit" },
            { "id": "d3", "x": 168, "y": 0, "w": 46, "h": 46, "value": "?", "corner": 3, "cls": "hot" },
            { "id": "d4", "x": 224, "y": 0, "w": 46, "h": 46, "corner": 4 }
          ],
          "edges": [{ "a": "d1", "b": "d3", "cls": "bad", "bend": -36, "off": 0 }]
        }
      }
    },
    {
      "t": {
        "zh": "这一关有两种背包：<b>每件最多拿一次</b>的，和<b>每件可以拿很多次</b>的（比如商店里每种东西都有很多件）。电路板不难：新的 dp[w] = 取较大（旧的 dp[w]，dp[w − 重量] + 价值）。视野里的红框 dp[w] 是写入新值的地方，在视野里点它，读到的是改写前的旧值；dp[w − 重量] 由伸缩臂够到。"
      }
    },
    {
      "t": {
        "zh": "真正的门道在机器的<wiki-ref to=\"dirs\"></wiki-ref>：每件最多拿一次时，它<b>从右往左</b>改写；每件可以拿很多次时，它<b>从左往右</b>改写。同一块电路板，为什么换个方向，答案就不一样？"
      }
    }
  ],
  "mission": {
    "goal": {
      "zh": "一种背包每件最多拿一次，另一种每件可以拿很多次，总重量都不能超过容量。拼好电路，让四个测试都算对。"
    },
    "how": {
      "zh": "黄色是正在改写的格子；红色表示读到了这一轮刚改过的值。"
    }
  },
  "robot": "reach",
  "unlock": "roll",
  "debrief": {
    "title": { "zh": "方向就是含义" },
    "body": [
      {
        "zh": "从右往左改写时，dp[w − 重量] 还没被这件物品改过，读到的是旧值，所以<b>每件最多拿一次</b>。"
      },
      {
        "zh": "从左往右改写时，dp[w − 重量] 可能已经拿过这件物品，再拿一次正好，所以<b>每件可以拿很多次</b>。"
      },
      {
        "zh": "同一块电路板，只是方向不同，解决的就是两个不同的问题。这种只留一行的写法叫<b>滚动数组</b>，能把几千行的表压成一行。"
      }
    ],
    "note": {
      "zh": "一行原地改写：从右往左，每件一次；从左往右，每件无限次。"
    }
  },
  "tasks": [
    {
      "id": "roll",
      "mode": "circuit",
      "naive": ["a = add(view.src, facts.value)", "cell <- a"],
      "diagnose": [
        {
          "when": { "not": { "all": [{ "uses": "old" }, { "uses": "src" }, { "uses": "value" }] } },
          "say": {
            "zh": "电路板：新的 dp[w] = 取较大（旧的 dp[w]，dp[w − 重量] + 价值）。三样都要读进来：旧的 dp[w]、dp[w − 重量] 和物品价值。"
          }
        }
      ],
      "after": "roll",
      "explain": "roll",
      "boardOpt": { "minScale": 0.66, "maxScale": 1.15 },
      "noTrace": true,
      "world": "roll",
      "facts": ["value"],
      "tests": [
        {
          "kind": "01",
          "W": 6,
          "items": [
            { "n": { "zh": "罐头" }, "w": 1, "v": 1 },
            { "n": { "zh": "雨衣" }, "w": 3, "v": 4 },
            { "n": { "zh": "毯子" }, "w": 4, "v": 5 }
          ]
        },
        {
          "kind": "inf",
          "W": 7,
          "items": [
            { "n": { "zh": "苹果" }, "w": 2, "v": 3 },
            { "n": { "zh": "西瓜" }, "w": 3, "v": 5 }
          ]
        },
        {
          "kind": "01",
          "W": 7,
          "items": [
            { "n": { "zh": "相机" }, "w": 3, "v": 4 },
            { "n": { "zh": "水壶" }, "w": 4, "v": 5 },
            { "n": { "zh": "零食" }, "w": 2, "v": 3 }
          ]
        },
        {
          "kind": "inf",
          "W": 9,
          "items": [
            { "n": { "zh": "面粉" }, "w": 5, "v": 9 },
            { "n": { "zh": "大米" }, "w": 3, "v": 5 },
            { "n": { "zh": "白糖" }, "w": 2, "v": 3 }
          ]
        }
      ],
      "expected": [6, 11, 9, 15],
      "solution": ["a = add(view.src, facts.value)", "m = mmax(view.old, a)", "cell <- m"],
      "dirs": { "01": "desc", "inf": "asc" }
    }
  ]
}
