{
  "title": { "zh": "杨辉三角" },
  "short": { "zh": "表换了形状" },
  "intro": [
    {
      "t": {
        "zh": "砖块一层层摆成三角形：第 1 层 1 块，第 2 层 2 块……从最顶上那块出发，每一步走到正下方或右下方的砖。"
      }
    },
    {
      "t": {
        "zh": "表的形状也变成了三角形：每一层只有那么几格。"
      }
    }
  ],
  "mission": {
    "goal": { "zh": "走到最后一层的指定那块砖，一共有几条路？" },
    "how": { "zh": "一层一层、从左往右算。" }
  },
  "robot": "scout",
  "debrief": {
    "title": { "zh": "杨辉三角" },
    "body": [
      {
        "zh": "每块砖的数 = 正上方 + 左上方。这就是杨辉三角，也是「从 n 个里选 k 个」的方法数。"
      },
      {
        "zh": "表不一定是方的：只要每格知道自己的来路，什么形状都能填。"
      }
    ]
  },
  "tasks": [
    {
      "id": "pascal",
      "mode": "circuit",
      "diagnose": [
        {
          "when": { "uses": "left" },
          "say": {
            "zh": "往下走只会到正下方或右下方，所以来路在上一层：正上方和左上方。"
          }
        }
      ],
      "hints": [
        {
          "zh": "只看最后一步：走到这块砖之前，你在哪一块上？"
        },
        {
          "zh": "三角形左边缘和右边缘的砖，只有一块砖能走过来，另一边是「—」。"
        }
      ],
      "world": "tri",
      "facts": ["start"],
      "tests": [{ "R": 5, "k": 2 }, { "R": 7, "k": 3 }, { "R": 6, "k": 1 }],
      "expected": [6, 20, 5],
      "solution": ["c = counter(view.up, view.ul, facts.start)", "cell <- c"]
    }
  ]
}
