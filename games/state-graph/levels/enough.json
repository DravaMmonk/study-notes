{
  "title": { "en": "Just enough?" },
  "short": { "en": "Remember only what affects the future" },
  "intro": [
    {
      "t": {
        "en": "Three keys again. But this level’s state <b>remembers only the red key</b>, so the table has just 2 layers."
      }
    }
  ],
  "mission": {
    "goal": {
      "en": "Work out the number of valid routes, and see whether remembering one key is enough."
    },
    "how": { "en": "Every cell works out both layers." }
  },
  "robot": "stack",
  "debrief": {
    "title": { "en": "Just enough" },
    "body": [
      {
        "en": "The green key has no door; the blue door always comes after the blue key. These two things <b>don’t affect the future</b>, so there’s no need to remember them. Remembering only the red key, 2 layers are enough."
      }
    ]
  },
  "tasks": [
    {
      "id": "enough",
      "mode": "circuit",
      "noTrace": true,
      "world": "keys",
      "facts": ["start", "gain", "lose", "shut"],
      "tests": [
        {
          "R": 4,
          "C": 5,
          "keys": { "red": [2, 0], "blue": [0, 1], "green": [1, 3] },
          "doors": [{ "at": [2, 2], "color": "red" }, { "at": [0, 2], "color": "blue" }]
        },
        {
          "R": 5,
          "C": 5,
          "keys": { "red": [1, 1], "blue": [0, 2], "green": [3, 0] },
          "doors": [{ "at": [3, 3], "color": "red" }, { "at": [0, 3], "color": "blue" }, { "at": [2, 4], "color": "red" }]
        }
      ],
      "expected": [20, 47],
      "solution": [
        "c = counter(view.up, view.left, facts.start)",
        "p = msum(view.upPrev, view.leftPrev)",
        "b1 = block(facts.shut, c)",
        "g = pass(facts.gain, p)",
        "b2 = block(facts.lose, b1)",
        "m = msum(b2, g)",
        "cell <- m"
      ],
      "remember": ["red"]
    }
  ]
}
