{
  "title": { "zh": "有坏台阶的楼梯" },
  "short": { "zh": "路线计数器加一道闸" },
  "intro": [
    {
      "t": {
        "zh": "这段楼梯有几级坏了，<b>踩不得</b>，画成石头的样子。每次还是迈 1 级或 2 级。"
      }
    }
  ],
  "mission": {
    "goal": {
      "zh": "每次迈 1 级或 2 级，不能踩在坏台阶上。算出爬到最上面一级有几种走法。"
    },
    "how": { "zh": "从地面一级一级往上算。" }
  },
  "robot": "ranger",
  "debrief": {
    "title": { "zh": "和落石一样" },
    "body": [
      {
        "zh": "坏台阶上是「—」。上面的台阶加起来时跳过它，经过它的走法自然就不算了。"
      },
      {
        "zh": "<level-ref to=\"rocks\"></level-ref>在棋盘城市里做过同一件事：零件只认结构，不认是路口还是台阶。"
      }
    ]
  },
  "tasks": [
    {
      "id": "brokenstairs",
      "mode": "circuit",
      "diagnose": [
        {
          "when": { "not": { "uses": "broken" } },
          "say": {
            "zh": "有的台阶坏了，踩不得。读一读「是坏台阶」。"
          }
        }
      ],
      "hints": [
        {
          "zh": "元件箱里的<part-ref to=\"counter\"></part-ref>也会数走法：前 1 级、前 2 级就是它的两条来路，是地面就是它的起点。"
        },
        {
          "zh": "坏台阶上要掐断：拦截闸在条件是「是」时输出「—」。"
        }
      ],
      "world": "strip",
      "facts": ["ground", "broken"],
      "tests": [{ "n": 6, "broken": [3] }, { "n": 8, "broken": [2, 5] }, { "n": 10, "broken": [4, 7] }],
      "expected": [4, 2, 6],
      "solution": ["c = counter(view.m1, view.m2, facts.ground)", "b = block(facts.broken, c)", "cell <- b"]
    }
  ]
}
