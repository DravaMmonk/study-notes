{
  "title": { "zh": "一根柱子" },
  "short": { "zh": "能量一路加下来" },
  "intro": [
    {
      "t": {
        "zh": "一张图只有 1 像素宽。每个像素有一个<b>能量</b>，写在格子左上角：越显眼的像素能量越高。"
      }
    },
    {
      "t": {
        "zh": "一条<b>缝</b>从顶走到底，每行经过一个像素。缝的能量是它经过的像素的能量之和。"
      }
    }
  ],
  "mission": {
    "goal": {
      "zh": "这条缝从顶走到底，能量一共是多少？每格存「从顶走到这里的能量」。"
    },
    "how": { "zh": "逐行，从顶行往下算。" }
  },
  "robot": "scout",
  "debrief": {
    "title": { "zh": "一路加下来" },
    "body": [
      {
        "zh": "一根柱子只有一条缝，表只是把能量一格格加下来。"
      }
    ]
  },
  "tasks": [
    {
      "id": "seamline",
      "mode": "circuit",
      "checkAll": true,
      "hints": [
        {
          "zh": "到这一格的能量 = 到上一格的能量 + 这一格自己的能量。"
        },
        { "zh": "顶行上面什么也没有：在顶行送一个 0 进去。" }
      ],
      "world": "pic",
      "facts": ["energy", "top"],
      "tests": [
        { "energy": [[3], [1], [4], [1], [5]], "R": 5, "C": 1 },
        { "energy": [[2], [7], [1], [8]], "R": 4, "C": 1 },
        { "energy": [[6], [0], [2], [9], [1], [3]], "R": 6, "C": 1 }
      ],
      "expected": [14, 18, 21],
      "solution": [
        "z = const[value=0]()",
        "g = pass(facts.top, z)",
        "m = msum(view.up, g)",
        "a = add(m, facts.energy)",
        "cell <- a"
      ]
    }
  ]
}
