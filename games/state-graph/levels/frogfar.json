{
  "title": { "zh": "跳得更远" },
  "short": { "zh": "视野和伸缩臂一起用" },
  "intro": [
    {
      "t": {
        "zh": "这条河里的青蛙更灵活：<b>可以从前一块石头跳过来，也可以从「↶ k」那块跳过来</b>。没写 ↶ 的石头，只能从前一块来。"
      }
    }
  ],
  "mission": {
    "goal": {
      "zh": "算出青蛙从岸边跳到最后一块石头，一共有几种跳法。"
    },
    "how": { "zh": "岸边算 1 种：已经站在那里了。" }
  },
  "robot": "reach",
  "debrief": {
    "title": { "zh": "又是爬楼梯" },
    "body": [
      {
        "zh": "和爬楼梯一样，只是「前 2 级」换成了伸缩臂读到的那一块。来路离得多远都行，结构不变。"
      }
    ]
  },
  "tasks": [
    {
      "id": "frogfar",
      "mode": "circuit",
      "diagnose": [
        {
          "when": { "not": { "uses": "m1" } },
          "say": {
            "zh": "青蛙也能从前一块跳来：前一块在视野里。"
          }
        },
        {
          "when": { "not": { "uses": "back" } },
          "say": { "zh": "长跳的来处要用伸缩臂去读。" }
        }
      ],
      "hints": [
        {
          "zh": "最后一跳从哪来？前一块，或者伸缩臂够到的那块。两种都算上：加起来。"
        },
        { "zh": "岸边算 1 种：放行闸放过一个 1。" }
      ],
      "world": "river",
      "facts": ["bank"],
      "tests": [
        { "k": [0, null, 2, 3, 2, 4, 3] },
        { "k": [0, null, 2, 2, 3, null, 4, 2] },
        { "k": [0, null, 2, 3, 4, 2, 5, 3, 2] }
      ],
      "expected": [9, 10, 20],
      "solution": ["c = counter(view.m1, view.back, facts.bank)", "cell <- c"]
    }
  ]
}
