    {
      "t": {
        "en": "The telescopic arm still reaches as many columns to the left as this kind weighs, one cell on the row above and one on this row."
      }
    }
  ],
  "mission": {
    "goal": {
      "en": "Each kind can be taken as many times as you like, and the total weight can’t exceed the capacity. Build the circuit board and work out the most value each backpack can hold."
    },
    "how": { "en": "Still row by row, left to right." }
  },
  "robot": "reach",
  "debrief": {
    "title": { "en": "Unbounded knapsack" },
    "body": [
      {
        "en": "Make room on <b>this row</b>: this row has already considered this kind, so taking one more from there is simply one more of it."
      },
      {
        "en": "It differs from the 0/1 knapsack in one place only: the cell that makes room moves from the row above to this row. This problem is called the <b>unbounded knapsack</b> (unlimited copies of each item)."
      }
    ]
  },
  "tasks": [
    {
      "id": "knapmany",
      "mode": "circuit",
      "diagnose": [
        {
          "when": { "all": [{ "uses": "upk" }, { "not": { "uses": "rowk" } }] },
          "say": {
            "en": "Making room on the row above takes each kind only once. In this level, you can take several of the same kind."
          }
        }
      ],
      "boardOpt": { "minScale": 0.68, "maxScale": 1.15 },
      "hints": [
        { "en": "Taking none of this kind: the answer is still right above." },
        {
          "en": "After taking one, you may take another: you want the cell that has “already considered this kind”. The row above hasn’t considered it yet; this row has."
        }
      ],
      "world": "knap",
      "facts": ["value"],
      "tests": [
        {
          "W": 7,
          "items": [
            { "n": { "en": "apples" }, "w": 2, "v": 3, "many": true },
            { "n": { "en": "melons" }, "w": 3, "v": 5, "many": true }
          ]
        },
        {
          "W": 10,
          "items": [
            { "n": { "en": "bacon" }, "w": 6, "v": 13, "many": true },
            { "n": { "en": "flour" }, "w": 5, "v": 10, "many": true },
            { "n": { "en": "salt" }, "w": 1, "v": 1, "many": true }
          ]
        },
        {
          "W": 9,
          "items": [
            { "n": { "en": "flour" }, "w": 5, "v": 9, "many": true },
            { "n": { "en": "rice" }, "w": 3, "v": 5, "many": true },
            { "n": { "en": "sugar" }, "w": 2, "v": 3, "many": true }
          ]
        }
      ],
      "expected": [11, 20, 15],
      "solution": ["c = choose(view.up, view.rowk, facts.value)", "cell <- c"]
    }
  ]
}
