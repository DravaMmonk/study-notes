{
  "title": { "zh": "有的词更贵" },
  "short": { "zh": "每一块的代价不同" },
  "intro": [
    {
      "t": {
        "zh": "常见的词便宜，生僻的词贵：词典里每个词标着一个<b>代价</b>。切法的代价是每一块加起来，挑最省的切法。"
      }
    },
    { "t": { "zh": "块数最少的切法，不一定最省。" } }
  ],
  "mission": {
    "goal": { "zh": "算出每串字母最省的切法要花多少代价。" },
    "how": { "zh": "词典和代价写在测试旁边。" }
  },
  "robot": "broom",
  "debrief": {
    "title": { "zh": "代价换了，电路没换" },
    "body": [
      {
        "zh": "在<level-ref to=\"wordbreak\"></level-ref>里，每一块都算 1，所以数的是块数。代价一换，同一块电路板就去找最省的切法。"
      }
    ]
  },
  "tasks": [
    {
      "id": "wordcost",
      "mode": "circuit",
      "testLabel": "{s}",
      "after": "dictionary",
      "hints": [
        {
          "zh": "和<level-ref to=\"wordbreak\"></level-ref>比，变的只有每一块的代价。"
        }
      ],
      "world": "pieces",
      "facts": ["ground"],
      "tests": [
        { "s": "pineapplepen", "dict": { "pine": 2, "apple": 1, "pineapple": 4, "pen": 1 } },
        { "s": "catsanddog", "dict": { "cat": 1, "cats": 3, "and": 1, "sand": 2, "dog": 1 } },
        { "s": "icecreamcone", "dict": { "ice": 1, "cream": 1, "icecream": 3, "cone": 1, "creamcone": 1 } }
      ],
      "expected": [4, 4, 2],
      "solution": [
        "a = add(view.seg, view.cost)",
        "z = const[value=0]()",
        "g = pass(facts.ground, z)",
        "m = mmin(a, g)",
        "cell <- m"
      ]
    }
  ]
}
