{
  "title": { "zh": "改一个字母" },
  "short": { "zh": "只许替换" },
  "intro": [
    {
      "t": {
        "zh": "拼写纠错：输错一个词时，看它离正确的词有多远。这一关只许一种改法：<b>把一个字母换成另一个</b>，每换一个算 1 步。两个词一样长。"
      }
    },
    {
      "t": {
        "zh": "表还是对齐表：上面一个词，左边一个词。只换字母时，左边第 i 个字母只会对上上面第 i 个，所以答案沿着对角线走过来。"
      }
    }
  ],
  "mission": {
    "goal": {
      "zh": "算出把左边的词改成上面的词，最少要换几个字母。"
    },
    "how": { "zh": "左上那一格是「前面的字母都改好了」。" }
  },
  "robot": "ranger",
  "debrief": {
    "title": { "zh": "沿着对角线" },
    "body": [
      {
        "zh": "只看左上：前面都改好了，这一个字母要么不动，要么换掉。"
      }
    ]
  },
  "tasks": [
    {
      "id": "replace",
      "mode": "circuit",
      "diagnose": [
        {
          "when": { "any": [{ "uses": "up" }, { "uses": "left" }] },
          "say": {
            "zh": "这一关只许换字母，用不上上面和左边：只看左上。"
          }
        }
      ],
      "hints": [
        {
          "zh": "字母相同就不用换：左上原样留下。不同就换一个：左上 + 1。取较小。"
        },
        { "zh": "起点是两个空词，0 步。" }
      ],
      "world": "align",
      "facts": ["same", "start"],
      "tests": [{ "left": "CAT", "top": "CUT" }, { "left": "GLOVE", "top": "GRAVE" }, { "left": "PAPER", "top": "TAPES" }],
      "expected": [1, 2, 2],
      "solution": [
        "k = const[value=1]()",
        "g = pass(facts.same, view.ul)",
        "z = const[value=0]()",
        "a = add(view.ul, k)",
        "h = pass(facts.start, z)",
        "m = mmin(a, g, h)",
        "cell <- m"
      ],
      "border0": false
    }
  ]
}
