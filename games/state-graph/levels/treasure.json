{
  "title": { "zh": "往右往下找宝藏" },
  "short": { "zh": "两个方向，打个九折" },
  "intro": [
    {
      "t": {
        "zh": "一张新地图：机器人只能往<b>右</b>或往<b>下</b>走。宝藏 10，地图边上一圈是悬崖，−10。"
      }
    },
    {
      "t": {
        "zh": "每一格的价值 = 往右、往下两格里较好的那个，<b>打个九折</b>。"
      }
    }
  ],
  "mission": {
    "goal": {
      "zh": "算出每一格的价值：往右、往下两格里较好的那个 × 0.9。"
    },
    "how": {
      "zh": "机器人一轮一轮地扫，直到表不再变。答案看起点那一格。"
    }
  },
  "robot": "loop",
  "debrief": {
    "title": { "zh": "格子世界的简化版" },
    "body": [{ "zh": "只有两个方向，每一格都只看右边和下面。" }]
  },
  "tasks": [
    {
      "id": "treasure",
      "mode": "circuit",
      "diagnose": [
        {
          "when": { "any": [{ "uses": "up" }, { "uses": "left" }] },
          "say": {
            "zh": "这张地图上只能往右或往下走：上面和左边走不过去。"
          }
        }
      ],
      "consts": [0, 0.5, 0.8, 0.9, 1],
      "hints": [
        {
          "zh": "只能往右或往下：右边、下面接进「取较大」，再乘 0.9。"
        }
      ],
      "world": "vgrid",
      "tests": [
        {
          "R": 5,
          "C": 6,
          "gold": [3, 4],
          "cliffs": [[4, 0], [4, 1], [4, 2], [4, 3], [4, 4], [4, 5], [0, 5], [1, 5], [2, 5], [3, 5], [1, 2]],
          "rd": true
        },
        {
          "R": 4,
          "C": 5,
          "gold": [2, 3],
          "cliffs": [[3, 0], [3, 1], [3, 2], [3, 3], [3, 4], [0, 4], [1, 4], [2, 4]],
          "rd": true
        }
      ],
      "expected": [4.782969, 5.9049],
      "solution": ["d = value[value=0.9](view.right, view.down)", "cell <- d"],
      "rounds": true,
      "arrows": true
    }
  ]
}
