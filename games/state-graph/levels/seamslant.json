{
  "title": { "zh": "可以斜着走" },
  "short": { "zh": "从顶行任意一格出发" },
  "intro": [
    {
      "t": {
        "zh": "现在图有好几列。缝从顶行<b>任意一个</b>像素出发，每一步走到正下方、左下方或右下方的像素，一直走到底行。"
      }
    }
  ],
  "mission": {
    "goal": {
      "zh": "能量最低的那条缝，能量是多少？答案是底行里最小的数。"
    },
    "how": { "zh": "逐行，从顶行往下算。" }
  },
  "robot": "scout",
  "adds": ["block"],
  "debrief": {
    "title": { "zh": "三条来路" },
    "body": [
      {
        "zh": "和<level-ref to=\"cheapest\"></level-ref>是同一副骨架：取较小，再加上本格。只是来路从两条变成了上一行的三条，起点从一格变成了整个顶行。"
      }
    ]
  },
  "tasks": [
    {
      "id": "seamslant",
      "mode": "circuit",
      "diagnose": [
        {
          "when": { "any": [{ "not": { "uses": "ul" } }, { "not": { "uses": "ur" } }] },
          "say": {
            "zh": "缝每一步可以往左下、正下、右下走：上一行的左上、正上、右上都是来路。"
          }
        }
      ],
      "checkAll": true,
      "hints": [
        {
          "zh": "到这一格之前，缝在上一行的哪几个像素上？"
        },
        { "zh": "挑能量最低的那一个，再加上这一格自己的能量。" }
      ],
      "world": "pic",
      "facts": ["energy", "top"],
      "tests": [
        { "energy": [[3, 1, 4], [1, 5, 9], [2, 6, 5], [3, 5, 8]], "R": 4, "C": 3 },
        { "energy": [[9, 1, 9, 9], [9, 9, 1, 9], [1, 9, 9, 9], [9, 1, 9, 2]], "R": 4, "C": 4 },
        { "energy": [[2, 8, 3, 7, 1], [6, 4, 9, 2, 5], [1, 7, 3, 8, 6], [5, 2, 6, 1, 9]], "R": 4, "C": 5 }
      ],
      "expected": [7, 12, 7],
      "solution": ["c = min(view.ul, view.up, facts.top, facts.energy, view.ur)", "cell <- c"]
    }
  ]
}
