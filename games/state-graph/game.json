{
  "package": "state-graph",
  "domain": "table",
  "vocabulary": 4,
  "title": { "en": "State Graph", "zh": "状态之图" },
  "kicker": { "en": "Dynamic programming puzzles, from scratch", "zh": "从零开始的动态规划解谜" },
  "lede": {
    "en": "No programming or algorithms background needed. Starting from counting routes by hand, you learn to break a big problem into a table and fill it in cell by cell; in the end you wire up the circuit boards that count routes, compare words and pack a backpack, and see why they are so fast.",
    "zh": "不需要任何编程或算法基础。从手数路线开始，学会把一个大问题拆成一张表，一格一格地填出来；最后能亲手拼出数路线、比文字、装背包的电路板，并且明白它们为什么这么快。"
  },
  "primitives": ["msum", "mmin", "mmax", "many", "const", "pass", "block", "add", "not", "mul"],
  "trays": {
    "main": [
      "msum",
      "const",
      "pass",
      "block",
      "counter",
      "many",
      "mmin",
      "mmax",
      "add",
      "min",
      "not",
      "cost",
      "mul",
      "choose",
      "interval",
      "value"
    ]
  },
  "concept": { "const": "pass", "many": "msum" },
  "eras": [
    {
      "id": "paper",
      "machine": null,
      "chapter": {
        "title": { "en": "Pen and paper", "zh": "纸笔" },
        "desc": {
          "en": "Build the answer to a big problem out of the answers to small ones.",
          "zh": "用小问题的答案，拼出大问题的答案。"
        }
      },
      "path": ["trace", "lastStep", "city"]
    },
    {
      "id": "scout",
      "machine": "scout",
      "chapter": {
        "title": { "en": "Build a machine", "zh": "造一台机器" },
        "desc": {
          "en": "On every cell the robot runs the same circuit board, and a finished board becomes a component.",
          "zh": "机器人在每一格上运行同一块电路板；拼好的电路板会变成元件。"
        }
      },
      "path": [
        "copy",
        "confluence",
        "stamp",
        { "parallel": [["rocks", "reach"], ["cheapest", "slantcost"]] },
        { "parallel": [["slant", "pascal"], ["maxcoins"]] },
        "pits"
      ],
      "branches": [
        { "levels": ["seamline", "seamslant", "seam", "carve"], "after": ["slantcost"] },
        { "levels": ["lawn"], "after": ["pascal"] }
      ],
      "optional": ["seamline", "seamslant", "seam", "carve", "lawn"],
      "groups": [
        { "title": { "en": "Rocks", "zh": "石头" }, "levels": ["rocks", "reach"] },
        { "title": { "en": "Costs", "zh": "花费" }, "levels": ["cheapest", "slantcost"] },
        { "title": { "en": "New shapes", "zh": "换形状" }, "levels": ["slant", "pascal"] },
        { "title": { "en": "Coins", "zh": "金币" }, "levels": ["maxcoins"] },
        {
          "title": { "en": "Seams in a picture", "zh": "图里的缝" },
          "levels": ["seamline", "seamslant", "seam", "carve"],
          "code": "S"
        }
      ]
    },
    {
      "id": "ranger",
      "machine": "ranger",
      "chapter": {
        "title": { "en": "Seeing further", "zh": "看得更远" },
        "desc": {
          "en": "It sees further, two cells away; it sees more, the two words a table compares; and it can scan the other way round.",
          "zh": "看得更远：两步之外的格子；看得更全：表头上的两个词；还能换个方向扫。"
        }
      },
      "path": [
        "stairs",
        { "parallel": [["order"], ["nim"]] },
        "link",
        "lcs",
        "palin",
        { "parallel": [["brokenstairs"], ["lps"]] }
      ],
      "branches": [
        { "levels": ["replace", "edit", "spell"], "after": ["lcs"] },
        { "levels": ["parity"], "after": ["nim"] },
        { "levels": ["localalign"], "after": ["lcs"] },
        { "levels": ["piles"], "after": ["nim"] }
      ],
      "optional": ["replace", "edit", "spell", "parity", "localalign", "piles"],
      "groups": [
        { "title": { "en": "Scanning backwards", "zh": "倒着扫" }, "levels": ["order"] },
        { "title": { "en": "Winning", "zh": "输赢" }, "levels": ["nim"] },
        { "title": { "en": "Broken steps", "zh": "坏台阶" }, "levels": ["brokenstairs"] },
        { "title": { "en": "Palindromic subsequences", "zh": "回文子序列" }, "levels": ["lps"] },
        {
          "title": { "en": "Spelling correction", "zh": "拼写纠错" },
          "levels": ["replace", "edit", "spell"],
          "code": "E"
        }
      ]
    },
    {
      "id": "reach",
      "machine": "reach",
      "chapter": {
        "title": { "en": "A longer arm", "zh": "伸长手臂" },
        "desc": { "en": "A telescopic arm reaches a cell however far away.", "zh": "伸缩臂能够到任意远的一格。" }
      },
      "path": ["frog", { "parallel": [["frogfar", "safefrog"], ["tagging", "forward"]] }],
      "branches": [
        { "levels": ["pack", "knaptable", "knapmany", "knapmix"], "after": ["frogfar"] },
        { "levels": ["coinways"], "after": ["knapmany"] },
        { "levels": ["roll"], "after": ["knapmix"] }
      ],
      "optional": ["pack", "knaptable", "knapmany", "knapmix", "coinways", "roll"],
      "groups": [
        { "title": { "en": "Ways to jump", "zh": "跳法" }, "levels": ["frogfar", "safefrog"] },
        { "title": { "en": "Sentences", "zh": "句子" }, "levels": ["tagging", "forward"] },
        {
          "title": { "en": "The backpack", "zh": "背包" },
          "levels": ["pack", "knaptable", "knapmany", "knapmix"],
          "code": "K"
        }
      ]
    },
    {
      "id": "broom",
      "machine": "broom",
      "chapter": {
        "title": { "en": "Many ways in", "zh": "一格多来路" },
        "desc": {
          "en": "The sweep arm passes over a whole run of cells, so the number of ways in is no longer fixed.",
          "zh": "扫描臂扫过一整段格子，来路的数量不再固定。"
        }
      },
      "path": ["prefix", "rising", { "parallel": [["stones", "twoorders", "parse"], ["change"]] }],
      "branches": [
        { "levels": ["wordbreak", "wordcost", "segment"], "after": ["rising"] },
        { "levels": ["maxsub"], "after": ["prefix"] }
      ],
      "optional": ["wordbreak", "wordcost", "segment", "maxsub"],
      "groups": [
        { "title": { "en": "Intervals", "zh": "区间" }, "levels": ["stones", "twoorders", "parse"] },
        { "title": { "en": "Change", "zh": "零钱" }, "levels": ["change"] },
        {
          "title": { "en": "Cutting words", "zh": "切单词" },
          "levels": ["wordbreak", "wordcost", "segment"],
          "code": "W"
        }
      ]
    },
    {
      "id": "stack",
      "machine": "stack",
      "chapter": {
        "title": { "en": "When the state falls short", "zh": "状态不够用" },
        "desc": {
          "en": "When one number can’t remember enough, remember one more thing.",
          "zh": "一个数记不住的时候，就多记一件事。"
        }
      },
      "path": ["robber", "breach", "keydoor", "stock1", "cooldown"],
      "branches": [
        { "levels": ["twokeys", "threekeys", "enough"], "after": ["keydoor"] },
        { "levels": ["ring"], "after": ["robber"] }
      ],
      "optional": ["twokeys", "threekeys", "enough", "ring"],
      "groups": [
        {
          "title": { "en": "Designing the state", "zh": "设计状态" },
          "levels": ["twokeys", "threekeys", "enough"],
          "code": "D"
        }
      ]
    },
    {
      "id": "settle",
      "machine": "loop",
      "chapter": {
        "title": { "en": "Scan until it settles", "zh": "扫到不再变" },
        "desc": { "en": "When the arrows loop round, scan again and again.", "zh": "箭头绕成了圈，就一遍一遍地扫。" }
      },
      "path": ["loop", "value", "arrows"],
      "branches": [{ "levels": ["treasure", "slip", "ice"], "after": ["value"] }],
      "optional": ["treasure", "slip", "ice"],
      "groups": [
        {
          "title": { "en": "The grid world", "zh": "格子世界" },
          "levels": ["treasure", "slip", "ice"],
          "code": "V"
        }
      ]
    }
  ],
  "borrow": { "seam": "seam" }
}
