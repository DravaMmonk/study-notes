{
  "domain": "table",
  "vocabulary": 2,
  "title": { "en": "State Graph" },
  "kicker": { "en": "Dynamic programming puzzles, from scratch" },
  "lede": {
    "en": "No programming or algorithms background needed. Starting from counting routes by hand, you learn to break a big problem into a table and fill it in cell by cell; in the end you wire up the circuit boards that count routes, compare words and pack a backpack, and see why they are so fast."
  },
  "primitives": ["msum", "mmin", "mmax", "many", "const", "pass", "block", "add", "not", "mul"],
  "trays": {
    "main": [
      "msum",
      "const",
      "pass",
      "block",
      "counter",
      "many",
      "mmin",
      "mmax",
      "add",
      "min",
      "not",
      "cost",
      "mul",
      "choose",
      "interval",
      "value"
    ]
  },
  "concept": { "const": "pass", "many": "msum" },
  "eras": [
    {
      "id": "paper",
      "machine": null,
      "foundation": ["trace", "lastStep", "city"],
      "chapter": {
        "title": { "en": "Pen and paper" },
        "desc": {
          "en": "Build the answer to a big problem out of the answers to small ones."
        }
      }
    },
    {
      "id": "scout",
      "machine": "scout",
      "foundation": [
        "copy",
        "confluence",
        "stamp",
        {
          "parallel": [
            { "id": "rocks", "title": { "en": "Rocks" }, "levels": ["rocks", "reach"] },
            { "id": "cost", "title": { "en": "Costs" }, "levels": ["cheapest", "slantcost"] }
          ]
        }
      ],
      "chapter": {
        "title": { "en": "Build a machine" },
        "desc": {
          "en": "On every cell the robot runs the same circuit board, and a finished board becomes a component."
        }
      },
      "practice": [
        {
          "parallel": [
            { "id": "shape", "title": { "en": "New shapes" }, "levels": ["slant", "pascal"] },
            { "id": "coins", "title": { "en": "Coins" }, "levels": ["maxcoins"] }
          ]
        },
        "pits"
      ],
      "topics": [
        {
          "id": "seam",
          "code": "S",
          "after": "slantcost",
          "levels": ["seamline", "seamslant", "seam", "carve"],
          "title": { "en": "Seams in a picture" },
          "desc": { "en": "Find the least noticeable seam in a picture." }
        }
      ],
      "challenges": [{ "level": "lawn", "after": "pascal" }]
    },
    {
      "id": "ranger",
      "machine": "ranger",
      "foundation": [
        "stairs",
        {
          "parallel": [
            { "id": "back", "title": { "en": "Scanning backwards" }, "levels": ["order"] },
            { "id": "win", "title": { "en": "Winning" }, "levels": ["nim"] }
          ]
        },
        "link",
        "lcs",
        "palin"
      ],
      "chapter": {
        "title": { "en": "Seeing further" },
        "desc": {
          "en": "It sees further, two cells away; it sees more, the two words a table compares; and it can scan the other way round."
        }
      },
      "practice": [
        {
          "parallel": [
            { "id": "broken", "title": { "en": "Broken steps" }, "levels": ["brokenstairs"] },
            { "id": "lps", "title": { "en": "Palindromic subsequences" }, "levels": ["lps"] }
          ]
        }
      ],
      "topics": [
        {
          "id": "edit",
          "code": "E",
          "after": "lcs",
          "levels": ["replace", "edit", "spell"],
          "title": { "en": "Spelling correction" },
          "desc": { "en": "A word is mistyped: find the closest one in the dictionary." }
        }
      ],
      "challenges": [
        { "level": "parity", "after": "nim" },
        { "level": "localalign", "after": "lcs" },
        { "level": "piles", "after": "nim" }
      ]
    },
    {
      "id": "reach",
      "machine": "reach",
      "foundation": [
        "frog",
        {
          "parallel": [
            { "id": "jump", "title": { "en": "Ways to jump" }, "levels": ["frogfar", "safefrog"] },
            { "id": "sentence", "title": { "en": "Sentences" }, "levels": ["tagging", "forward"] }
          ]
        }
      ],
      "chapter": {
        "title": { "en": "A longer arm" },
        "desc": { "en": "A telescopic arm reaches a cell however far away." }
      },
      "topics": [
        {
          "id": "knapsack",
          "code": "K",
          "after": "frogfar",
          "levels": ["pack", "knaptable", "knapmany", "knapmix"],
          "title": { "en": "The backpack" },
          "desc": { "en": "With limited room, what is most worth taking?" }
        }
      ],
      "challenges": [{ "level": "coinways", "after": "knapmany" }, { "level": "roll", "after": "knapmix" }]
    },
    {
      "id": "broom",
      "machine": "broom",
      "foundation": ["prefix", "rising"],
      "chapter": {
        "title": { "en": "Many ways in" },
        "desc": {
          "en": "The sweep arm passes over a whole run of cells, so the number of ways in is no longer fixed."
        }
      },
      "practice": [
        {
          "parallel": [
            {
              "id": "interval",
              "title": { "en": "Intervals" },
              "levels": ["stones", "twoorders", "parse"]
            },
            { "id": "change", "title": { "en": "Change" }, "levels": ["change"] }
          ]
        }
      ],
      "topics": [
        {
          "id": "words",
          "code": "W",
          "after": "rising",
          "levels": ["wordbreak", "wordcost", "segment"],
          "title": { "en": "Cutting words" },
          "desc": { "en": "A string with no spaces, cut into dictionary words." }
        }
      ],
      "challenges": [{ "level": "maxsub", "after": "prefix" }]
    },
    {
      "id": "stack",
      "machine": "stack",
      "foundation": ["robber", "breach", "keydoor"],
      "chapter": {
        "title": { "en": "When the state falls short" },
        "desc": { "en": "When one number can’t remember enough, remember one more thing." }
      },
      "practice": ["stock1", "cooldown"],
      "challenges": [{ "level": "ring", "after": "robber" }],
      "topics": [
        {
          "id": "state",
          "code": "D",
          "after": "keydoor",
          "levels": ["twokeys", "threekeys", "enough"],
          "title": { "en": "Designing the state" },
          "desc": { "en": "This time, you decide what to remember." }
        }
      ]
    },
    {
      "id": "settle",
      "machine": "loop",
      "foundation": ["loop"],
      "chapter": {
        "title": { "en": "Scan until it settles" },
        "desc": { "en": "When the arrows loop round, scan again and again." }
      },
      "practice": ["value", "arrows"],
      "topics": [
        {
          "id": "value",
          "code": "V",
          "after": "value",
          "levels": ["treasure", "slip", "ice"],
          "title": { "en": "The grid world" },
          "desc": {
            "en": "The robot hunts for treasure on a grid, and the further it is, the less it is worth."
          }
        }
      ]
    }
  ],
  "borrow": { "seam": "seam" }
}
