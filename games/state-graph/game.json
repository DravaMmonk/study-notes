{
  "domain": "table",
  "vocabulary": 1,
  "title": { "zh": "状态之图" },
  "kicker": { "zh": "从零开始的动态规划解谜" },
  "lede": {
    "zh": "不需要任何编程或算法基础。从手数路线开始，学会把一个大问题拆成一张表，一格一格地填出来；最后能亲手拼出数路线、比文字、装背包的电路板，并且明白它们为什么这么快。"
  },
  "primitives": ["msum", "mmin", "mmax", "many", "const", "pass", "block", "add", "not", "mul"],
  "trays": {
    "main": [
      "msum",
      "const",
      "pass",
      "block",
      "counter",
      "many",
      "mmin",
      "mmax",
      "add",
      "min",
      "not",
      "cost",
      "mul",
      "choose",
      "interval",
      "value"
    ]
  },
  "concept": { "const": "pass", "many": "msum" },
  "parts": {
    "counter": {
      "name": { "zh": "路线计数器" },
      "desc": {
        "zh": "把两条来路的数加起来；「起点」口是「是」时，再加 1。「—」不算在内，什么都没收到时输出「—」。"
      }
    },
    "order": {
      "name": { "zh": "填表顺序" },
      "desc": {
        "zh": "每个格子都要排在它要读的格子之后。顺序反过来，电路读的方向也得跟着反过来。"
      }
    },
    "min": {
      "name": { "zh": "最省格" },
      "desc": {
        "zh": "取最多三条来路里最小的（「起点」口是「是」时，0 也算一条来路），再加上本格代价。来路全是「—」时，输出「—」。"
      }
    },
    "layer": {
      "name": { "zh": "分层" },
      "desc": {
        "zh": "把表复制成几层，让状态多记一件会影响未来的事。"
      }
    },
    "align": {
      "name": { "zh": "对齐表" },
      "desc": {
        "zh": "一个词放上面，一个词放左边。字相同，左上 + 1；否则取上面和左边中较大的。"
      }
    },
    "cost": {
      "name": { "zh": "编辑距离器" },
      "desc": {
        "zh": "输出这几个数里最小的：上面、左边、左上三者中最小的 + 1；字相同时的左上；起点上的 0。"
      }
    },
    "choose": {
      "name": { "zh": "择优器" },
      "desc": { "zh": "输出「不换」和「换来 + 加上」两者中较大的那个。" }
    },
    "roll": {
      "name": { "zh": "滚动数组" },
      "desc": {
        "zh": "只留一行原地改写。改写的方向，决定每件物品能用几次。"
      }
    },
    "judge": {
      "name": { "zh": "输赢判定器" },
      "desc": {
        "zh": "读三个对手局面：只要有一个是「输」，这一格就是「赢」；否则是「输」。"
      }
    },
    "sweep": {
      "name": { "zh": "扫描臂" },
      "desc": {
        "zh": "一次读一整段格子。可每格都从头扫一遍很慢：能用上一格存好的答案，就别重扫。"
      }
    },
    "wordbreak": {
      "name": { "zh": "切词" },
      "desc": {
        "zh": "前面某个位置能切开，而且那一截刚好是个词，这里就能切开。"
      }
    },
    "interval": {
      "name": { "zh": "区间合并器" },
      "desc": {
        "zh": "左段和右段是两串数：按切分点一一相加，取最小的，再加上整段代价。"
      }
    },
    "anyorder": {
      "name": { "zh": "多种顺序" },
      "desc": {
        "zh": "只要每个格子都排在它要读的格子之后，什么顺序都行。"
      }
    },
    "value": {
      "name": { "zh": "打折器" },
      "desc": {
        "zh": "取最多四条来路里最大的，再乘上元件上的数（比如 0.9）。"
      }
    },
    "expect": {
      "name": { "zh": "期望" },
      "desc": {
        "zh": "结果不确定时，把每种结果按可能性加权，再比较。"
      }
    },
    "viterbi": {
      "name": { "zh": "维特比" },
      "desc": {
        "zh": "每一列每一种标签，记下到这里最省的解释：上一列各行加上转移代价，取较小。"
      }
    },
    "local": {
      "name": { "zh": "局部对齐" },
      "desc": {
        "zh": "低于 0 就截成 0：重新开始，比背着负分走下去强。答案在表里最大的那一格。"
      }
    },
    "seam": {
      "name": { "zh": "剪缝" },
      "desc": {
        "zh": "每一格 = 本格能量 + 上面三格里最小的。从最底一行最小的格子倒推，剪掉这条缝。"
      }
    }
  },
  "eras": [
    {
      "id": "paper",
      "machine": null,
      "foundation": ["trace", "lastStep", "city"],
      "chapter": {
        "title": { "zh": "纸笔" },
        "desc": {
          "zh": "用小问题的答案，拼出大问题的答案。"
        }
      }
    },
    {
      "id": "scout",
      "machine": "scout",
      "foundation": [
        "copy",
        "confluence",
        "stamp",
        {
          "parallel": [
            { "id": "rocks", "title": { "zh": "石头" }, "levels": ["rocks", "reach"] },
            { "id": "cost", "title": { "zh": "花费" }, "levels": ["cheapest", "slantcost"] }
          ]
        }
      ],
      "chapter": {
        "title": { "zh": "造一台机器" },
        "desc": {
          "zh": "机器人在每一格上运行同一块电路板；拼好的电路板会变成元件。"
        }
      },
      "practice": [
        {
          "parallel": [
            { "id": "shape", "title": { "zh": "换形状" }, "levels": ["slant", "pascal"] },
            { "id": "coins", "title": { "zh": "金币" }, "levels": ["maxcoins"] }
          ]
        },
        "pits"
      ],
      "topics": [
        {
          "id": "seam",
          "code": "S",
          "after": "slantcost",
          "levels": ["seamline", "seamslant", "seam", "carve"],
          "title": { "zh": "图里的缝" },
          "desc": { "zh": "在一张图里，找一条最不起眼的缝。" }
        }
      ],
      "challenges": [{ "level": "lawn", "after": "pascal" }]
    },
    {
      "id": "ranger",
      "machine": "ranger",
      "foundation": [
        "stairs",
        {
          "parallel": [
            { "id": "back", "title": { "zh": "倒着扫" }, "levels": ["order"] },
            { "id": "win", "title": { "zh": "输赢" }, "levels": ["nim"] }
          ]
        },
        "link",
        "lcs",
        "palin"
      ],
      "chapter": {
        "title": { "zh": "看得更远" },
        "desc": {
          "zh": "看得更远：两步之外的格子；看得更全：表头上的两个词；还能换个方向扫。"
        }
      },
      "practice": [
        {
          "parallel": [
            { "id": "broken", "title": { "zh": "坏台阶" }, "levels": ["brokenstairs"] },
            { "id": "lps", "title": { "zh": "回文子序列" }, "levels": ["lps"] }
          ]
        }
      ],
      "topics": [
        {
          "id": "edit",
          "code": "E",
          "after": "lcs",
          "levels": ["replace", "edit", "spell"],
          "title": { "zh": "拼写纠错" },
          "desc": { "zh": "输错一个词，找出词典里最接近的那个。" }
        }
      ],
      "challenges": [
        { "level": "parity", "after": "nim" },
        { "level": "localalign", "after": "lcs" },
        { "level": "piles", "after": "nim" }
      ]
    },
    {
      "id": "reach",
      "machine": "reach",
      "foundation": [
        "frog",
        {
          "parallel": [
            { "id": "jump", "title": { "zh": "跳法" }, "levels": ["frogfar", "safefrog"] },
            { "id": "sentence", "title": { "zh": "句子" }, "levels": ["tagging", "forward"] }
          ]
        }
      ],
      "chapter": {
        "title": { "zh": "伸长手臂" },
        "desc": { "zh": "伸缩臂能够到任意远的一格。" }
      },
      "topics": [
        {
          "id": "knapsack",
          "code": "K",
          "after": "frogfar",
          "levels": ["pack", "knaptable", "knapmany", "knapmix"],
          "title": { "zh": "背包" },
          "desc": { "zh": "容量有限，拿什么最值钱？" }
        }
      ],
      "challenges": [{ "level": "coinways", "after": "knapmany" }, { "level": "roll", "after": "knapmix" }]
    },
    {
      "id": "broom",
      "machine": "broom",
      "foundation": ["prefix", "rising"],
      "chapter": {
        "title": { "zh": "一格多来路" },
        "desc": {
          "zh": "扫描臂扫过一整段格子，来路的数量不再固定。"
        }
      },
      "practice": [
        {
          "parallel": [
            {
              "id": "interval",
              "title": { "zh": "区间" },
              "levels": ["stones", "twoorders", "parse"]
            },
            { "id": "change", "title": { "zh": "零钱" }, "levels": ["change"] }
          ]
        }
      ],
      "topics": [
        {
          "id": "words",
          "code": "W",
          "after": "rising",
          "levels": ["wordbreak", "wordcost", "segment"],
          "title": { "zh": "切单词" },
          "desc": { "zh": "一串没有空格的字母，切成词典里的词。" }
        }
      ],
      "challenges": [{ "level": "maxsub", "after": "prefix" }]
    },
    {
      "id": "stack",
      "machine": "stack",
      "foundation": ["robber", "breach", "keydoor"],
      "chapter": {
        "title": { "zh": "状态不够用" },
        "desc": { "zh": "一个数记不住的时候，就多记一件事。" }
      },
      "practice": ["stock1", "cooldown"],
      "challenges": [{ "level": "ring", "after": "robber" }],
      "topics": [
        {
          "id": "state",
          "code": "D",
          "after": "keydoor",
          "levels": ["twokeys", "threekeys", "enough"],
          "title": { "zh": "设计状态" },
          "desc": { "zh": "该记住什么，这次由你决定。" }
        }
      ]
    },
    {
      "id": "settle",
      "machine": "loop",
      "foundation": ["loop"],
      "chapter": {
        "title": { "zh": "扫到不再变" },
        "desc": { "zh": "箭头绕成了圈，就一遍一遍地扫。" }
      },
      "practice": ["value", "arrows"],
      "topics": [
        {
          "id": "value",
          "code": "V",
          "after": "value",
          "levels": ["treasure", "slip", "ice"],
          "title": { "zh": "格子世界" },
          "desc": {
            "zh": "机器人在格子里找宝藏，越远的宝藏越不值钱。"
          }
        }
      ]
    }
  ],
  "borrow": { "seam": "seam" }
}
