          "tx": { "id": 291, "data": [165, 85] },
          "txAt": 12,
          "queue": [165, 85],
          "constants": { "id": 291, "length": 2 },
          "pulses": { "start": [12] },
          "peerLow": [64]
        }
      ],
      "want": {
        "send": { "controllerFaultDrive": { "start": "start" } },
        "lost": { "controllerFaultLost": { "start": "start" } },
        "next": { "controllerFaultNext": { "start": "start" } },
        "rewind": { "controllerFaultRewind": { "start": "start" } },
        "attempt": { "controllerFaultAttempts": { "start": "start" } },
        "done": { "controllerFaultDone": { "start": "start" } },
        "tec": { "controllerFaultTec": { "start": "start" } },
        "error": { "controllerFaultError": { "start": "start" } }
      },
      "solution": [
        "zero = const[value=0]()",
        "one = const[value=1]()",
        "two = const[value=2]()",
        "five = const[value=5]()",
        "ten = const[value=10]()",
        "false = compare[form=eq](zero, one)",
        "true = compare[form=eq](one, one)",
        "wait = reg[reg=A, start=0]()",
        "receiving = compare[form=eq](wait, one)",
        "errorwait = compare[form=eq](wait, two)",
        "normal = compare[form=eq](wait, zero)",
        "quiet = counter(line)",
        "long = compare[form=lt](ten, quiet)",
        "readynum = select(long, one, zero)",
        "retry = select(normal, zero, readynum)",
        "fire = select(start, one, retry)",
        "source = select(normal, available, zero)",
        "p = transmitter(id, length, item, source, last, fire)",
        "a = arbiter(line, p.send, p.arb, fire)",
        "s = sniffer(line)",
        "ack = reg[reg=B, start=0]()",
        "good = select(s.ready, s.ok, zero)",
        "acknext = select(receiving, good, zero)",
        "kb = keep[reg=B](acknext)",
        "receivewire = select(ack, zero, one)",
        "slot = select(normal, p.ack, zero)",
        "high = compare[form=eq](line, one)",
        "missing = select(slot, high, false)",
        "same = compare[form=eq](p.send, line)",
        "different = select(same, false, true)",
        "outsideArb = select(p.arb, false, true)",
        "outsideAck = select(p.ack, false, true)",
        "check = select(outsideArb, outsideAck, false)",
        "mismatch = select(check, different, false)",
        "biterror = select(normal, mismatch, false)",
        "errorValue = select(missing, true, biterror)",
        "f = errorflag(errorValue)",
        "errorwire = select(errorwait, f.send, a.send)",
        "waitingwire = select(receiving, receivewire, errorwire)",
        "wire = select(fire, p.send, waitingwire)",
        "send <- wire",
        "witherror = select(errorValue, two, wait)",
        "withloss = select(a.lost, one, witherror)",
        "waitnext = select(fire, zero, withloss)",
        "ka = keep[reg=A](waitnext)",
        "lost <- a.lost",
        "attempt <- fire",
        "take = select(normal, p.next, false)",
        "next <- take",
        "rewind <- errorValue",
        "finished = select(normal, p.done, false)",
        "done <- finished",
        "eofvalid = select(normal, p.eof, zero)",
        "success = select(eofvalid, two, zero)",
        "errorkind = select(missing, five, one)",
        "event = select(errorValue, errorkind, success)",
        "fault = faultcounter(event, start)",
        "tec <- fault.tx",
        "error <- errorValue"
      ],
      "naive": [
        "zero = const[value=0]()",
