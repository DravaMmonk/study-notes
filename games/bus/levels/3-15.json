{
  "title": { "zh": "换一个 CRC 生成式" },
  "intro": [
    { "t": { "zh": "这次只对一个数据字节算游戏定义的 CRC-8：初值为 0，多项式为 0x07，不反射，不做最终异或。每次从最高位开始移出一位；移出的位为 1 时异或 0x07。" } }
  ],
  "after": { "zh": "CRC 算法由多项式、初值和位序等共同决定；不能仅凭名字假定不同系统使用同一套规则。" },
  "builds": {
    "type": "crc8Byte",
    "name": { "zh": "单字节 CRC-8" },
    "desc": { "zh": "按游戏给定的 0x07 多项式计算单字节 CRC-8。" }
  },
  "tasks": [
    {
      "id": "3-15",
      "brief": { "zh": "对每帧的第一个字节计算这套 CRC-8，交出一个字节的结果。" },
      "hint": [{ "zh": "把输入作为寄存值，重复八次：记录最高位，把值左移一位并保留低八位；若移出的位是 1，异或 7。" }],
      "inputs": [{ "name": "payload", "label": { "zh": "数据字节" } }],
      "frameInputs": { "payload": "byte0" },
      "outputs": [{ "name": "crc", "label": { "zh": "CRC-8" } }],
      "tests": [
        {
          "bus": { "frames": [] },
          "frameRequests": [
            { "node": "source0", "at": 10, "id": "0x120", "data": [0, 0, 0] },
            { "node": "source1", "at": 120, "id": "0x120", "data": [2, 14, 1] },
            { "node": "source2", "at": 230, "id": "0x120", "data": [14, 42, 2] }
          ]
        }
      ],
      "hidden": [
        {
          "bus": { "frames": [] },
          "frameRequests": [
            { "node": "source0", "at": 10, "id": "0x120", "data": [1, 7, 0] },
            { "node": "source1", "at": 120, "id": "0x120", "data": [3, 9, 1] },
            { "node": "source2", "at": 230, "id": "0x120", "data": [127, 122, 2] },
            { "node": "source3", "at": 340, "id": "0x120", "data": [128, 137, 3] },
            { "node": "source4", "at": 450, "id": "0x120", "data": [255, 243, 4] }
          ]
        }
      ],
      "want": { "crc": { "crc8Signal": { "input": "payload" } } },
      "solution": [
        "top = const[value=128]()",
        "mask = const[value=255]()",
        "poly = const[value=7]()",
        "top0 = band(payload, top)",
        "high0 = compare[form=eq](top0, top)",
        "double0 = arith[form=add](payload, payload)",
        "bounded0 = band(double0, mask)",
        "xor0 = xor(bounded0, poly)",
        "step0 = select(high0, xor0, bounded0)",
        "top1 = band(step0, top)",
        "high1 = compare[form=eq](top1, top)",
        "double1 = arith[form=add](step0, step0)",
        "bounded1 = band(double1, mask)",
        "xor1 = xor(bounded1, poly)",
        "step1 = select(high1, xor1, bounded1)",
        "top2 = band(step1, top)",
        "high2 = compare[form=eq](top2, top)",
        "double2 = arith[form=add](step1, step1)",
        "bounded2 = band(double2, mask)",
        "xor2 = xor(bounded2, poly)",
        "step2 = select(high2, xor2, bounded2)",
        "top3 = band(step2, top)",
        "high3 = compare[form=eq](top3, top)",
        "double3 = arith[form=add](step2, step2)",
        "bounded3 = band(double3, mask)",
        "xor3 = xor(bounded3, poly)",
        "step3 = select(high3, xor3, bounded3)",
        "top4 = band(step3, top)",
        "high4 = compare[form=eq](top4, top)",
        "double4 = arith[form=add](step3, step3)",
        "bounded4 = band(double4, mask)",
        "xor4 = xor(bounded4, poly)",
        "step4 = select(high4, xor4, bounded4)",
        "top5 = band(step4, top)",
        "high5 = compare[form=eq](top5, top)",
        "double5 = arith[form=add](step4, step4)",
        "bounded5 = band(double5, mask)",
        "xor5 = xor(bounded5, poly)",
        "step5 = select(high5, xor5, bounded5)",
        "top6 = band(step5, top)",
        "high6 = compare[form=eq](top6, top)",
        "double6 = arith[form=add](step5, step5)",
        "bounded6 = band(double6, mask)",
        "xor6 = xor(bounded6, poly)",
        "step6 = select(high6, xor6, bounded6)",
        "top7 = band(step6, top)",
        "high7 = compare[form=eq](top7, top)",
        "double7 = arith[form=add](step6, step6)",
        "bounded7 = band(double7, mask)",
        "xor7 = xor(bounded7, poly)",
        "step7 = select(high7, xor7, bounded7)",
        "crc <- step7"
      ],
      "naive": [
        "top = const[value=128]()",
        "mask = const[value=255]()",
        "poly = const[value=7]()",
        "top0 = band(payload, top)",
        "high0 = compare[form=eq](top0, top)",
        "double0 = arith[form=add](payload, payload)",
        "bounded0 = band(double0, mask)",
        "xor0 = xor(bounded0, poly)",
        "step0 = select(high0, xor0, bounded0)",
        "top1 = band(step0, top)",
        "high1 = compare[form=eq](top1, top)",
        "double1 = arith[form=add](step0, step0)",
        "bounded1 = band(double1, mask)",
        "xor1 = xor(bounded1, poly)",
        "step1 = select(high1, xor1, bounded1)",
        "top2 = band(step1, top)",
        "high2 = compare[form=eq](top2, top)",
        "double2 = arith[form=add](step1, step1)",
        "bounded2 = band(double2, mask)",
        "xor2 = xor(bounded2, poly)",
        "step2 = select(high2, xor2, bounded2)",
        "top3 = band(step2, top)",
        "high3 = compare[form=eq](top3, top)",
        "double3 = arith[form=add](step2, step2)",
        "bounded3 = band(double3, mask)",
        "xor3 = xor(bounded3, poly)",
        "step3 = select(high3, xor3, bounded3)",
        "top4 = band(step3, top)",
        "high4 = compare[form=eq](top4, top)",
        "double4 = arith[form=add](step3, step3)",
        "bounded4 = band(double4, mask)",
        "xor4 = xor(bounded4, poly)",
        "step4 = select(high4, xor4, bounded4)",
        "top5 = band(step4, top)",
        "high5 = compare[form=eq](top5, top)",
        "double5 = arith[form=add](step4, step4)",
        "bounded5 = band(double5, mask)",
        "xor5 = xor(bounded5, poly)",
        "step5 = select(high5, xor5, bounded5)",
        "top6 = band(step5, top)",
        "high6 = compare[form=eq](top6, top)",
        "double6 = arith[form=add](step5, step5)",
        "bounded6 = band(double6, mask)",
        "xor6 = xor(bounded6, poly)",
        "step6 = select(high6, xor6, bounded6)",
        "top7 = band(step6, top)",
        "high7 = compare[form=eq](top7, top)",
        "double7 = arith[form=add](step6, step6)",
        "bounded7 = band(double7, mask)",
        "xor7 = xor(bounded7, poly)",
        "step7 = select(high7, xor7, bounded7)",
        "crc <- bounded7"
      ]
    }
  ]
