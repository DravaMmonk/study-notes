{
  "title": { "zh": "使用广播扫描器" },
  "intro": [{ "t": { "zh": "封装广播扫描器，除了版本列表，还要告诉使用者是否收到了任何回答。" } }],
  "after": { "zh": "空结果、版本为 0 和控制器离线仍是不同情况。" },
  "tasks": [
    {
      "id": "5-21",
      "brief": { "zh": "用广播扫描器发一次请求；结果出现时交出版本列表和是否收到回答。" },
      "hint": [{ "zh": "空版本列表表示没有回答；有一条版本为 0 的记录也不是空列表。" }],
      "inputs": [
        { "name": "source", "label": { "zh": "回答的控制器" } },
        { "name": "reply", "label": { "zh": "控制器回答" } },
        { "name": "ready", "label": { "zh": "收到回答" } }
      ],
      "outputs": [
        { "name": "target", "label": { "zh": "请求目标" } },
        { "name": "request", "label": { "zh": "诊断请求" } },
        { "name": "versions", "label": { "zh": "版本列表" } },
        { "name": "answered", "label": { "zh": "有回答" } }
      ],
      "fleet": {
        "target": "target",
        "request": "request",
        "source": "source",
        "response": "reply",
        "ready": "ready"
      },
      "tests": [
        {
          "bus": { "idle": 8, "frames": [], "tail": 0 },
          "fleet": [
            { "online": true, "version": 1 },
            { "online": false, "version": 2 },
            { "online": true, "version": 3 },
            { "online": true, "version": 4 },
            { "online": false, "version": 5 },
            { "online": true, "version": 6 }
          ]
        },
        {
          "bus": { "idle": 8, "frames": [], "tail": 0 },
          "fleet": [
            { "online": false, "version": 0 },
            { "online": false, "version": 0 },
            { "online": false, "version": 0 },
            { "online": false, "version": 0 },
            { "online": false, "version": 0 },
            { "online": false, "version": 0 }
          ]
        }
      ],
      "hidden": [
        {
          "bus": { "idle": 8, "frames": [], "tail": 0 },
          "fleet": [
            { "online": true, "version": 0 },
            { "online": true, "version": 9 },
            { "online": false, "version": 5 },
            { "online": false, "version": 0 },
            { "online": true, "version": 4 },
            { "online": false, "version": 3 }
          ]
        }
      ],
      "want": {
        "target": "fleetBroadcastTarget",
        "request": "fleetBroadcastRequest",
        "versions": "fleetScanVersions",
        "answered": "fleetScanAny"
      },
      "solution": [
        "scan = broadcastScanner(source, reply, ready)",
        "target <- scan.target",
        "request <- scan.request",
        "versions <- scan.versions",
        "empty = emptyBytes()",
        "size = byteLength(scan.versions)",
        "zero = byteLength(empty)",
        "any = compare[form=lt](zero, size)",
        "answered <- any"
      ]
    }
  ]
}
