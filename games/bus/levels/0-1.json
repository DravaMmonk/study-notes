{
  "title": { "zh": "谁都能拉低" },
  "intro": [{ "t": { "zh": "两个人共用一根线。只要有人说显性 0，线就是 0；两人都说隐性 1，线才是 1。" } }],
  "after": { "zh": "共用总线的值由所有节点共同决定：显性会盖过隐性。" },
  "tasks": [
    {
      "id": "0-1",
      "kind": "paper",
      "mode": "line",
      "brief": { "zh": "对每组节点说的位，逐拍写出总线上的位。直接连续填写 0 和 1，例如 0101。" },
      "hint": [{ "zh": "每一拍分别比较两个节点；只要出现一个 0，就写 0。" }],
      "cases": [
        { "a": [1, 1, 0, 1, 0, 1], "b": [1, 0, 1, 1, 1, 0] },
        { "a": [1, 1, 1, 1, 1, 1], "b": [1, 1, 1, 1, 1, 1] },
        { "a": [0, 0, 0, 1, 0, 1], "b": [1, 1, 1, 0, 0, 0] }
      ],
      "solution": ["100100", "111111", "000000"]
    }
  ]
}
