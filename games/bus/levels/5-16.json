{
  "title": { "zh": "逐个列出已确认故障码" },
  "intro": [{ "t": { "zh": "诊断回答中每条故障记录占四个字节：三个字节的故障码和一个状态字节。每个在线控制器可能有零条或多条记录。" } }],
  "after": { "zh": "每组带有控制器序号和记录条数，因此多条记录和没有故障都能区分。" },
  "builds": { "type": "faultScanner", "name": { "zh": "故障码扫描器" }, "desc": { "zh": "逐个控制器收集已确认故障码及状态。" } },
  "tasks": [
    {
      "id": "5-16",
      "brief": { "zh": "按体检顺序请求版本和已确认故障。交出每个在线控制器的一组 [序号, 条数, 故障码三字节, 状态, …]；零条时也要交出序号和 0。" },
      "hint": [{ "zh": "去掉故障回答的三个字节头部；剩余长度除以四得到条数，再把序号、条数和全部记录拼接。" }],
