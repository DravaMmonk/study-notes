        "high = compare[form=eq](line, one)",
        "missing = select(slot, high, false)",
        "f = errorflag(missing)",
        "waitingwire = select(wait, f.send, p.send)",
        "wire = select(fire, p.send, waitingwire)",
        "send <- wire",
        "hold = select(missing, one, wait)",
        "waitnext = select(fire, zero, hold)",
        "ka = keep[reg=A](waitnext)",
        "take = select(wait, false, p.next)",
        "next <- take",
        "rewind <- missing",
        "attempt <- fire",
        "finished = select(wait, false, p.done)",
        "done <- finished",
        "success = select(finished, two, zero)",
        "event = select(missing, five, success)",
        "fault = faultcounter(event, start)",
        "tec <- fault.tx"
      ]
    }
