{
  "title": { "zh": "缺应答后重发" },
  "intro": [{ "t": { "zh": "如果应答位一直是隐性，发送方报告错误，等错误界定段和帧间隔结束后重新发送同一帧。本关只考虑错误主动状态下的少量缺应答。" } }],
  "after": { "zh": "缺应答会使错误主动的发送方增加发送错误计数，并中断当前帧。错误处理之后，发送方重试原帧。本关不覆盖错误被动时的例外。" },
  "tasks": [
    {
      "id": "2-24",
      "brief": { "zh": "发送一帧；缺应答时发六位显性错误标志，重置队列，等待八位错误界定段及三位帧间隔后重发。输出每次开始、完成及发送错误计数。成功发送后计数减一，最低为零。" },
      "hint": [{ "zh": "组合发送器、错误标志和错误计数器；错误标志后数连续的隐性位。重发需要重新取出原来的字节。" }],
      "listens": true,
      "drives": true,
      "inputs": [
        { "name": "id", "label": { "zh": "标识符" } },
        { "name": "length", "label": { "zh": "数据长度" } },
        { "name": "item", "label": { "zh": "队首" } },
        { "name": "available", "label": { "zh": "有字节" } },
        { "name": "last", "label": { "zh": "最后字节" } },
        { "name": "start", "label": { "zh": "开始" } }
      ],
      "outputs": [
        { "name": "next", "label": { "zh": "取走" } },
        { "name": "rewind", "label": { "zh": "重置队列" } },
        { "name": "attempt", "label": { "zh": "发送开始" } },
        { "name": "done", "label": { "zh": "完成" } },
        { "name": "tec", "label": { "zh": "发送错误计数" } }
      ],
      "pulls": {
        "input": "item",
        "available": "available",
        "last": "last",
        "next": "next",
        "rewind": "rewind"
      },
      "tests": [
        {
          "bus": { "idle": 65, "frames": [], "tail": 0 },
          "tx": { "id": 291, "data": [] },
          "queue": [],
          "constants": { "id": 291, "length": 0 },
          "pulses": { "start": [12] },
          "peerLow": [48]
        },
        {
