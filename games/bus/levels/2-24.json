          "queue": [165],
          "constants": { "id": 291, "length": 1 },
          "pulses": { "start": [12] },
          "peerLow": [57]
        }
      ],
      "want": {
        "send": { "ackRetryDrive": { "start": "start" } },
        "next": { "ackRetryNext": { "start": "start" } },
        "rewind": { "ackRetryRewind": { "start": "start" } },
        "attempt": { "ackRetryAttempts": { "start": "start" } },
        "done": { "ackRetryDone": { "start": "start" } },
        "tec": { "ackRetryTec": { "start": "start" } }
      },
      "solution": [
        "zero = const[value=0]()",
        "one = const[value=1]()",
        "two = const[value=2]()",
        "five = const[value=5]()",
        "ten = const[value=10]()",
        "false = compare[form=eq](zero, one)",
        "wait = reg[reg=A, start=0]()",
        "quiet = counter(line)",
        "long = compare[form=lt](ten, quiet)",
        "ready = select(long, one, zero)",
        "retry = select(wait, ready, zero)",
        "fire = select(start, one, retry)",
        "source = select(wait, zero, available)",
        "p = transmitter(id, length, item, source, last, fire)",
        "slot = select(wait, zero, p.ack)",
        "high = compare[form=eq](line, one)",
        "missing = select(slot, high, false)",
        "f = errorflag(missing)",
        "waitingwire = select(wait, f.send, p.send)",
        "wire = select(fire, p.send, waitingwire)",
        "send <- wire",
        "hold = select(missing, one, wait)",
        "waitnext = select(fire, zero, hold)",
        "ka = keep[reg=A](waitnext)",
        "take = select(wait, false, p.next)",
        "next <- take",
        "rewind <- missing",
        "attempt <- fire",
        "finished = select(wait, false, p.done)",
        "done <- finished",
        "success = select(finished, two, zero)",
        "event = select(missing, five, success)",
        "fault = faultcounter(event, start)",
        "tec <- fault.tx"
      ],
      "naive": [
