            { "online": false, "version": 2 },
            { "online": true, "version": 1 }
          ]
        }
      ],
      "want": { "target": "fleetExamTargets", "request": "fleetExamRequests", "report": "fleetExamReport" },
      "solution": [
        "index = reg[reg=A, start=0]()",
        "phase = reg[reg=B, start=0]()",
        "version = reg[reg=C]()",
        "list = reg[reg=D]()",
        "c0 = const[value=0]()",
        "c1 = const[value=1]()",
        "c2 = const[value=2]()",
        "c3 = const[value=3]()",
        "c4 = const[value=4]()",
        "c5 = const[value=5]()",
        "c6 = const[value=6]()",
        "c8 = const[value=8]()",
        "c16 = const[value=16]()",
        "c25 = const[value=25]()",
        "c34 = const[value=34]()",
        "c98 = const[value=98]()",
        "c127 = const[value=127]()",
        "c136 = const[value=136]()",
        "c241 = const[value=241]()",
        "is0 = compare[form=eq](phase, c0)",
        "is1 = compare[form=eq](phase, c1)",
        "is2 = compare[form=eq](phase, c2)",
        "is3 = compare[form=eq](phase, c3)",
        "is4 = compare[form=eq](phase, c4)",
        "is5 = compare[form=eq](phase, c5)",
        "inRange = compare[form=lt](index, c6)",
        "b16 = byteList(c16)",
        "b3 = byteList(c3)",
        "session = concatBytes(b16, b3)",
        "b34 = byteList(c34)",
        "b241 = byteList(c241)",
        "b136 = byteList(c136)",
        "head = concatBytes(b34, b241)",
        "read = concatBytes(head, b136)",
        "b25 = byteList(c25)",
        "b2 = byteList(c2)",
        "b8 = byteList(c8)",
        "faultHead = concatBytes(b25, b2)",
        "readFault = concatBytes(faultHead, b8)",
        "first = select(inRange, session)",
        "second = select(ready, read)",
        "third = select(is3, readFault)",
        "later = select(is1, second, third)",
        "requestNow = select(is0, first, later)",
        "request <- requestNow",
        "hasRequest = present(requestNow)",
        "targetNow = select(hasRequest, index)",
        "target <- targetNow",
        "service = byteAt(reply, c0)",
        "pending = compare[form=eq](service, c127)",
        "positive = compare[form=eq](service, c98)",
        "notReady = select(ready, c0, c1)",
        "advance = select(is1, notReady, is4)",
        "incIndex = arith[form=inc](index)",
        "nextIndex = select(advance, incIndex, index)",
        "saveIndex = keep[reg=A](nextIndex)",
        "phase0 = select(inRange, c1, c5)",
        "phase1 = select(ready, c2, c0)",
        "phase2 = select(pending, c2, c3)",
        "selectPhase5 = select(is5, c6, phase)",
        "phase4 = select(is4, c0, selectPhase5)",
        "phase3 = select(is3, c4, phase4)",
        "phaseAfter2 = select(is2, phase2, phase3)",
        "phaseAfter1 = select(is1, phase1, phaseAfter2)",
        "nextPhase = select(is0, phase0, phaseAfter1)",
        "savePhase = keep[reg=B](nextPhase)",
        "versionByte = byteAt(reply, c3)",
        "saveVersionNow = select(positive, versionByte, version)",
        "nextVersion = select(is2, saveVersionNow, version)",
        "saveVersion = keep[reg=C](nextVersion)",
        "empty = emptyBytes()",
        "exists = present(list)",
        "base = select(exists, list, empty)",
        "sourceByte = byteList(source)",
        "storedVersion = byteList(version)",
        "length = byteLength(reply)",
        "hasFault = compare[form=lt](c3, length)",
        "flag = select(hasFault, c1, c0)",
        "flagByte = byteList(flag)",
        "pair = concatBytes(sourceByte, storedVersion)",
        "record = concatBytes(pair, flagByte)",
        "appended = concatBytes(base, record)",
        "nextList = select(is4, appended, base)",
        "saveList = keep[reg=D](nextList)",
        "result = select(is5, list)",
        "report <- result"
      ],
