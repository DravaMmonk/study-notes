{
  "title": { "zh": "给模拟车辆做体检" },
  "intro": [
    { "t": { "zh": "逐个进入扩展会话，读取版本，再读取状态位含已确认的故障码。体检报告每条记录为 [控制器序号, 版本, 有已确认故障]。" } },
    { "t": { "zh": "控制器可能离线、要求扩展会话或先回答稍等；本关仍是一次处理一个控制器的消息层模型。" } }
  ],
  "after": { "zh": "体检同时保留在线控制器、软件版本和已确认故障状态；未确认的故障不会被计入。" },
  "builds": { "type": "vehicleExam", "name": { "zh": "模拟车辆体检仪" }, "desc": { "zh": "逐个读取六个模拟控制器的版本与已确认故障状态。" } },
  "tasks": [
    {
      "id": "5-14",
      "brief": { "zh": "依次体检六个控制器：先进入扩展会话，再读版本并等待最终回答，最后用 [0x19, 2, 8] 查已确认故障。交出在线控制器的体检报告。" },
      "hint": [{ "zh": "在版本回答到达后保存版本，再请求故障；故障回答除了三个字节的头部以外有记录时，表示存在已确认故障。" }],
      "inputs": [
        { "name": "source", "label": { "zh": "回答的控制器" } },
        { "name": "reply", "label": { "zh": "控制器回答" } },
        { "name": "ready", "label": { "zh": "收到回答" } }
      ],
      "outputs": [
        { "name": "target", "label": { "zh": "请求目标" } },
        { "name": "request", "label": { "zh": "诊断请求" } },
        { "name": "report", "label": { "zh": "体检报告" } }
      ],
      "fleet": {
        "target": "target",
        "request": "request",
        "source": "source",
        "response": "reply",
        "ready": "ready"
      },
      "tests": [
        {
          "bus": { "idle": 60, "frames": [], "tail": 0 },
          "fleet": [
            {
              "online": true,
              "version": 1,
              "requiresExtended": true,
              "dtcs": [{ "code": "0x123456", "status": 1 }]
            },
            { "online": false, "version": 2 },
            { "online": true, "version": 3 },
            { "online": true, "version": 4, "requiresExtended": true },
            { "online": false, "version": 5 },
            { "online": true, "version": 6 }
          ]
        }
      ],
      "hidden": [
