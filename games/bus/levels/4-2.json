{
  "title": { "zh": "两帧拼回一条消息" },
  "intro": [{ "t": { "zh": "消息超过七个字节时，首帧给出总长度并携带前六个字节，接着的后续帧以序号 1 开始。这里先只处理 8 到 13 字节、恰好需要一个后续帧的消息。" } }],
  "after": { "zh": "首帧携带总长度，后续帧携带序号。接收方要保存片段、检查顺序，再按总长度去掉填充。" },
  "tasks": [
    {
      "id": "4-2",
      "brief": {
        "zh": "每帧固定八字节。首帧第一个字节为 0x10，第二个字节是总长度，后六个字节是消息开头；后续帧第一个字节为 0x21。收到首帧后的正确后续帧时交出完整消息，去掉填充；序号不对时交出「—」并丢弃未完成的消息。"
      },
      "hint": [{ "zh": "先保存首帧的六个字节和总长度；后续帧到来时拼接，再从位置 0 截取总长度。用比较元件检查帧头。" }],
      "inputs": [
        { "name": "data", "label": { "zh": "帧数据" } },
        { "name": "header", "label": { "zh": "第一个数据字节" } },
        { "name": "total", "label": { "zh": "第二个数据字节" } }
      ],
      "frameInputs": { "data": "data", "header": "byte0", "total": "byte1" },
      "outputs": [{ "name": "message", "label": { "zh": "消息字节" } }],
      "tests": [
        {
          "bus": { "frames": [] },
          "frameRequests": [
            { "node": "ecu", "at": 10, "id": "0x7e8", "data": [16, 8, 1, 2, 3, 4, 5, 6] },
            { "node": "ecu", "at": 120, "id": "0x7e8", "data": [33, 7, 8, 170, 170, 170, 170, 170] },
            { "node": "ecu", "at": 230, "id": "0x7e8", "data": [16, 13, 1, 2, 3, 4, 5, 6] },
            { "node": "ecu", "at": 340, "id": "0x7e8", "data": [33, 7, 8, 9, 10, 11, 12, 13] }
          ]
        }
      ],
      "hidden": [
        {
          "bus": { "frames": [] },
          "frameRequests": [
            { "node": "ecu", "at": 10, "id": "0x7e8", "data": [16, 9, 9, 8, 7, 6, 5, 4] },
            { "node": "ecu", "at": 120, "id": "0x7e8", "data": [34, 3, 2, 1, 0, 0, 0, 0] },
            { "node": "ecu", "at": 230, "id": "0x7e8", "data": [33, 3, 2, 1, 0, 0, 0, 0] },
            { "node": "ecu", "at": 340, "id": "0x7e8", "data": [16, 10, 10, 9, 8, 7, 6, 5] },
            { "node": "ecu", "at": 450, "id": "0x7e8", "data": [33, 4, 3, 2, 1, 0, 0, 0] }
          ]
        }
      ],
      "want": { "message": { "twoFrameMessage": { "data": "data" } } },
      "solution": [
        "ffHead = const[value=16]()",
        "cfHead = const[value=33]()",
        "isFirst = compare[form=eq](header, ffHead)",
        "isNext = compare[form=eq](header, cfHead)",
        "two = const[value=2]()",
        "six = const[value=6]()",
        "one = const[value=1]()",
        "seven = const[value=7]()",
        "zero = const[value=0]()",
        "prefix = sliceBytes(data, two, six)",
        "savePrefix = select(isFirst, prefix)",
        "storedPrefix = reg[reg=A]()",
        "saveA = keep[reg=A](savePrefix)",
        "saveLength = select(isFirst, total)",
        "storedLength = reg[reg=B]()",
        "saveB = keep[reg=B](saveLength)",
        "suffix = sliceBytes(data, one, seven)",
        "joined = concatBytes(storedPrefix, suffix)",
        "trimmed = sliceBytes(joined, zero, storedLength)",
        "out = select(isNext, trimmed)",
        "message <- out"
      ],
      "naive": [
        "ffHead = const[value=16]()",
        "cfHead = const[value=33]()",
        "isFirst = compare[form=eq](header, ffHead)",
        "isNext = compare[form=eq](header, cfHead)",
        "two = const[value=2]()",
        "six = const[value=6]()",
        "one = const[value=1]()",
        "seven = const[value=7]()",
        "zero = const[value=0]()",
        "prefix = sliceBytes(data, two, six)",
        "savePrefix = select(isFirst, prefix)",
        "storedPrefix = reg[reg=A]()",
        "saveA = keep[reg=A](savePrefix)",
        "saveLength = select(isFirst, total)",
        "storedLength = reg[reg=B]()",
        "saveB = keep[reg=B](saveLength)",
        "suffix = sliceBytes(data, one, seven)",
        "joined = concatBytes(storedPrefix, suffix)",
        "trimmed = sliceBytes(joined, zero, storedLength)",
        "out = select(isNext, joined)",
        "message <- out"
      ]
    }
  ],
  "adds": ["concatBytes"],
  "showcase": { "zh": "按顺序拼接两段字节。" }
}
