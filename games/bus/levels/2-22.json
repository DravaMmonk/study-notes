      "want": {
        "mode": { "faultMode": { "event": "event", "reset": "reset" } },
        "send": { "faultFlagDrive": { "event": "event", "reset": "reset", "report": "report" } },
        "done": { "faultFlagDone": { "event": "event", "reset": "reset", "report": "report" } }
      },
      "solution": [
        "p = faultcounter(event, reset)",
        "zero = const[value=0]()",
        "one = const[value=1]()",
        "two = const[value=2]()",
        "off = compare[form=eq](p.mode, two)",
        "active = compare[form=eq](p.mode, zero)",
        "allowed = select(off, zero, report)",
        "f = errorflag(allowed)",
        "wire = select(active, f.send, one)",
        "send <- wire",
        "false = compare[form=eq](zero, one)",
        "complete = select(off, false, f.done)",
        "done <- complete",
        "mode <- p.mode"
      ],
      "naive": [
        "p = faultcounter(event, reset)",
        "zero = const[value=0]()",
        "one = const[value=1]()",
        "two = const[value=2]()",
        "off = compare[form=eq](p.mode, two)",
        "active = compare[form=eq](p.mode, zero)",
        "allowed = select(off, zero, report)",
        "f = errorflag(allowed)",
        "wire = select(active, f.send, f.send)",
        "send <- wire",
        "false = compare[form=eq](zero, one)",
        "complete = select(off, false, f.done)",
        "done <- complete",
        "mode <- p.mode"
      ]
    }
