        "window = concatBytes(firstPairs, afterPair)",
        "captureNow = select(startExam, window)",
        "capture <- captureNow",
        "maxPlusOne = const[value=101]()",
        "differenceLimit = const[value=3]()",
        "afterFlag0 = byteAt(flags, c0)",
        "afterFlag1 = byteAt(flags, c1)",
        "fault0Clear = compare[form=eq](afterFlag0, c0)",
        "fault1Clear = compare[form=eq](afterFlag1, c0)",
        "sameVersion = compare[form=eq](firstVersion, versionByte)",
        "speedInRange = compare[form=lt](postSpeed, maxPlusOne)",
        "wheelInRange = compare[form=lt](postWheel, maxPlusOne)",
        "differenceA = subtract(postSpeed, postWheel)",
        "differenceB = subtract(postWheel, postSpeed)",
        "nearA = compare[form=lt](differenceA, differenceLimit)",
        "nearB = compare[form=lt](differenceB, differenceLimit)",
        "falseValue = compare[form=eq](c0, c1)",
        "bothFaultsClear = select(fault0Clear, fault1Clear, falseValue)",
        "versionsAndFaults = select(sameVersion, bothFaultsClear, falseValue)",
        "ranges = select(speedInRange, wheelInRange, falseValue)",
        "closeEnough = select(nearA, nearB, falseValue)",
        "signalsOK = select(ranges, closeEnough, falseValue)",
        "allOK = select(versionsAndFaults, signalsOK, falseValue)",
        "healthyNow = select(post6, allOK)",
        "healthy <- healthyNow"
      ]
    }
  ]
}
