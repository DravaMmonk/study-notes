{
  "title": { "zh": "申请下载空间" },
  "intro": [{ "t": { "zh": "擦除后请求下载。本模拟使用一个地址字节、两个长度字节；要写入四字节时，请求为 [0x34, 0x00, 0x12, 0x00, 0x00, 0x04]。" } }],
  "after": { "zh": "下载回答给出单次传输允许的最大块长度；发送数据前需要遵守这个限制。" },
  "tasks": [
    {
      "id": "6-2",
      "brief": { "zh": "第 0 拍进入编程会话，第 1 拍擦除，第 2 拍申请四字节下载；从肯定回答 [0x74, 0x10, 最大块长度] 中交出最大块长度。" },
      "hint": [{ "zh": "按拍数选择三个请求；回答以 0x74 开头时，读取位置 2 的字节。" }],
      "inputs": [{ "name": "reply", "label": { "zh": "控制器回答" } }],
      "outputs": [
        { "name": "request", "label": { "zh": "诊断请求" } },
        { "name": "maxBlock", "label": { "zh": "最大块长度" } }
      ],
      "ecu": { "request": "request", "response": "reply" },
      "tests": [
        {
          "bus": { "idle": 5, "frames": [], "tail": 0 },
          "ecu": { "did": "0xf190", "value": [], "flash": { "maxBlock": 4, "expectedChecksum": 10 } }
        }
      ],
      "hidden": [
        {
          "bus": { "idle": 5, "frames": [], "tail": 0 },
          "ecu": { "did": "0xf190", "value": [], "flash": { "maxBlock": 5, "expectedChecksum": 10 } }
        }
      ],
      "want": { "request": "ecuFlashDownloadRequests", "maxBlock": "ecuFlashMaxBlock" },
      "solution": [
        "tick = reg[reg=A, start=0]()",
        "next = arith[form=inc](tick)",
        "save = keep[reg=A](next)",
        "c0 = const[value=0]()",
        "b0 = byteList(c0)",
        "c1 = const[value=1]()",
        "b1 = byteList(c1)",
        "c2 = const[value=2]()",
        "b2 = byteList(c2)",
        "c4 = const[value=4]()",
        "b4 = byteList(c4)",
        "c16 = const[value=16]()",
        "b16 = byteList(c16)",
        "c18 = const[value=18]()",
        "b18 = byteList(c18)",
        "c49 = const[value=49]()",
        "b49 = byteList(c49)",
        "c52 = const[value=52]()",
        "b52 = byteList(c52)",
        "c255 = const[value=255]()",
        "b255 = byteList(c255)",
        "t0 = const[value=0]()",
        "is0 = compare[form=eq](tick, t0)",
        "t1 = const[value=1]()",
        "is1 = compare[form=eq](tick, t1)",
        "t2 = const[value=2]()",
        "is2 = compare[form=eq](tick, t2)",
        "m0_0 = concatBytes(b16, b2)",
        "r0 = select(is0, m0_0, r1)",
        "m1_0 = concatBytes(b49, b1)",
        "m1_1 = concatBytes(m1_0, b255)",
        "m1_2 = concatBytes(m1_1, b0)",
        "r1 = select(is1, m1_2, r2)",
        "m2_0 = concatBytes(b52, b0)",
        "m2_1 = concatBytes(m2_0, b18)",
        "m2_2 = concatBytes(m2_1, b0)",
        "m2_3 = concatBytes(m2_2, b0)",
        "m2_4 = concatBytes(m2_3, b4)",
        "r2 = select(is2, m2_4)",
        "request <- r0",
        "zero = const[value=0]()",
        "head = byteAt(reply, zero)",
        "positiveCode = const[value=116]()",
        "positive = compare[form=eq](head, positiveCode)",
        "two = const[value=2]()",
        "block = byteAt(reply, two)",
        "result = select(positive, block)",
        "maxBlock <- result"
      ],
