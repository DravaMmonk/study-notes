      "solution": [
        "p = controller(line, id, length, item, available, last, start, prep, reset, request)",
        "send <- p.send",
        "next <- p.next",
        "rewind <- p.rewind",
        "attempt <- p.attempt",
        "done <- p.done",
        "tec <- p.tec",
        "error <- p.error",
        "mode <- p.mode",
        "rx <- p.rx",
        "kind <- p.kind",
        "ready <- p.ready",
        "accepted <- p.accepted",
        "lost <- p.lost",
        "rxId <- p.rxId",
        "rxLength <- p.rxLength",
        "rxByte <- p.rxByte",
        "storedId = reg[reg=A]()",
        "storedLength = reg[reg=B]()",
        "storedByte = reg[reg=C]()",
        "hasId = present(p.rxId)",
        "hasLength = present(p.rxLength)",
        "hasByte = present(p.rxByte)",
        "nextId = select(hasId, p.rxId, storedId)",
        "nextLength = select(hasLength, p.rxLength, storedLength)",
        "nextByte = select(hasByte, p.rxByte, storedByte)",
        "saveId = keep[reg=A](nextId)",
        "saveLength = keep[reg=B](nextLength)",
        "saveByte = keep[reg=C](nextByte)",
        "zero = const[value=0]()",
        "one = const[value=1]()",
        "target = const[value=677]()",
        "falseValue = compare[form=eq](zero, one)",
        "valid = compare[form=eq](p.kind, zero)",
        "readyValid = select(p.ready, valid, falseValue)",
        "targetMatch = compare[form=eq](storedId, target)",
        "oneByte = compare[form=eq](storedLength, one)",
        "matching = select(targetMatch, oneByte, falseValue)",
        "eligible = select(readyValid, matching, falseValue)",
        "decoded = arith[form=add](storedByte, storedByte)",
        "speedNow = select(eligible, decoded)",
        "speed <- speedNow"
      ]
