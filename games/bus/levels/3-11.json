{
  "title": { "zh": "找出持续不一致" },
  "intro": [{ "t": { "zh": "逐帧比较车速与轮速。一次短暂不一致不一定值得截取；这里把连续三帧不一致定义为持续不一致。" } }],
  "after": { "zh": "把持续条件和只触发一次分开记，才能从一段数据中找到第一次事件。" },
  "builds": {
    "type": "mismatchMonitor",
    "name": { "zh": "持续不一致监视器" },
    "desc": { "zh": "在车速和轮速首次连续三帧不一致时触发一次。" }
  },
  "tasks": [
    {
      "id": "3-11",
      "brief": { "zh": "第一次出现连续三帧车速与轮速不同，恰在第三帧交出「是」；其他帧交出「否」，后续不再重复触发。" },
      "hint": [{ "zh": "用寄存卡数连续不一致的帧，遇到一致就清零；再记住是否已经触发。" }],
      "inputs": [{ "name": "speed", "label": { "zh": "车速" } }, { "name": "wheel", "label": { "zh": "轮速" } }],
      "frameInputs": { "speed": "byte0", "wheel": "byte1" },
      "outputs": [{ "name": "alarm", "label": { "zh": "首次触发" } }],
      "tests": [
        {
          "bus": { "frames": [] },
          "frameRequests": [
            { "node": "sensor", "at": 10, "id": "0x120", "data": [30, 30] },
            { "node": "sensor", "at": 120, "id": "0x120", "data": [30, 31] },
            { "node": "sensor", "at": 230, "id": "0x120", "data": [31, 32] },
            { "node": "sensor", "at": 340, "id": "0x120", "data": [32, 33] },
            { "node": "sensor", "at": 450, "id": "0x120", "data": [33, 33] },
            { "node": "sensor", "at": 560, "id": "0x120", "data": [34, 34] }
          ]
        }
      ],
      "hidden": [
        {
          "bus": { "frames": [] },
          "frameRequests": [
            { "node": "sensor", "at": 10, "id": "0x120", "data": [10, 11] },
            { "node": "sensor", "at": 120, "id": "0x120", "data": [11, 12] },
            { "node": "sensor", "at": 230, "id": "0x120", "data": [12, 12] },
            { "node": "sensor", "at": 340, "id": "0x120", "data": [13, 15] },
            { "node": "sensor", "at": 450, "id": "0x120", "data": [14, 16] },
            { "node": "sensor", "at": 560, "id": "0x120", "data": [15, 17] },
            { "node": "sensor", "at": 670, "id": "0x120", "data": [16, 18] },
            { "node": "sensor", "at": 780, "id": "0x120", "data": [17, 19] },
            { "node": "sensor", "at": 890, "id": "0x120", "data": [18, 18] }
          ]
        }
      ],
      "want": { "alarm": { "sustainedMismatch": { "speed": "speed", "wheel": "wheel" } } },
      "solution": [
        "streak = reg[reg=A, start=0]()",
        "seen = reg[reg=B, start=0]()",
        "zero = const[value=0]()",
        "one = const[value=1]()",
        "three = const[value=3]()",
        "same = compare[form=eq](speed, wheel)",
        "increment = arith[form=inc](streak)",
        "nextStreak = select(same, zero, increment)",
        "saveStreak = keep[reg=A](nextStreak)",
        "atThree = compare[form=eq](nextStreak, three)",
        "falseValue = compare[form=eq](zero, one)",
        "alarmNow = select(seen, falseValue, atThree)",
        "alarm <- alarmNow",
        "nextSeen = select(alarmNow, one, seen)",
        "saveSeen = keep[reg=B](nextSeen)"
      ],
      "naive": [
        "streak = reg[reg=A, start=0]()",
        "zero = const[value=0]()",
        "two = const[value=2]()",
        "same = compare[form=eq](speed, wheel)",
        "increment = arith[form=inc](streak)",
        "nextStreak = select(same, zero, increment)",
        "saveStreak = keep[reg=A](nextStreak)",
        "alarmNow = compare[form=lt](two, nextStreak)",
        "alarm <- alarmNow"
      ]
    }
  ]
}
