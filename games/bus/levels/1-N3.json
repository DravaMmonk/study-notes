      "want": {
        "id": "identifier",
        "length": "dataLength",
        "byte": "dataByte",
        "ok": { "frameStatus": { "bit": "bit" } }
      },
      "solution": [
        "zero = const[value=0]()",
        "one = const[value=1]()",
        "ten = const[value=10]()",
        "quiet = counter(bit)",
        "long = compare[form=lt](ten, quiet)",
        "low = compare[form=eq](bit, zero)",
        "sof = select(long, low, zero)",
        "cap = capture(bit)",
        "d = destuff(bit, sof)",
        "oldactive = reg[reg=C, start=0]()",
        "active = select(sof, one, oldactive)",
        "ka = keep[reg=C](active)",
        "oldpos = reg[reg=A, start=0]()",
        "pos = select(sof, zero, oldpos)",
        "pi = arith[form=inc](pos)",
        "pstep = select(d.valid, pi, pos)",
        "pn = select(active, pstep, zero)",
        "kp = keep[reg=A](pn)",
        "oldlength = reg[reg=B, start=0]()",
        "lenvalue = select(sof, zero, oldlength)",
        "eighteen = const[value=18]()",
        "atlength = compare[form=eq](pos, eighteen)",
        "lengthready = select(d.valid, atlength, zero)",
        "ln = select(lengthready, cap.length, lenvalue)",
        "kl = keep[reg=B](ln)",
        "l2 = arith[form=add](lenvalue, lenvalue)",
        "l4 = arith[form=add](l2, l2)",
        "l8 = arith[form=add](l4, l4)",
        "thirtyfour = const[value=34]()",
        "limit = arith[form=add](thirtyfour, l8)",
        "within = compare[form=lt](pos, limit)",
        "atlimit = compare[form=eq](pos, limit)",
        "crcvalid = select(d.valid, within, zero)",
        "crcgo = select(active, crcvalid, zero)",
        "crc = crc15(d.out, crcgo, sof)",
        "notvalid = select(d.valid, zero, one)",
        "finalstuff = select(atlimit, notvalid, zero)",
        "checkpart = select(within, one, finalstuff)",
        "checkgo = select(active, checkpart, zero)",
        "error = stuffcheck(bit, checkgo, sof)",
        "olderror = reg[reg=D, start=0]()",
        "olderror0 = select(sof, zero, olderror)",
        "firstbad0 = select(olderror0, zero, one)",
        "firstbad = select(error, firstbad0, zero)",
        "ke = keep[reg=D](error)",
        "crcdelimiter = select(d.valid, atlimit, zero)",
        "mayfinish = select(active, crcdelimiter, zero)",
        "finish = select(error, zero, mayfinish)",
        "match = compare[form=eq](crc, zero)",
        "good = select(finish, match)",
        "false = compare[form=eq](zero, one)",
        "result = select(firstbad, false, good)",
        "id <- cap.id",
        "length <- cap.length",
        "byte <- cap.byte",
        "ok <- result"
      ],
