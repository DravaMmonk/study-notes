{
  "title": { "zh": "查出坏帧" },
  "intro": [{ "t": { "zh": "解析字段之后，还要判断这一帧能不能相信：边收原始位边核对 CRC，同时留意填充错误。本关的错误发生在数据、CRC 或填充位，不改变长度字段。" } }],
  "builds": {
    "type": "sniffer",
    "name": { "zh": "校验抓帧器" },
    "desc": { "zh": "在连续总线上读帧的标识符、长度和数据字节；填充错误立即交出否，否则在 CRC 界定位交出校验结果。这里的错误不改变长度字段。" }
  },
  "after": { "zh": "非零 CRC 或填充错误都能让接收方发现问题；校验通过也不意味着所有可能的错误都被排除。" },
  "tasks": [
    {
      "id": "1-N3",
      "brief": { "zh": "持续读取总线，交出每帧的标识符、长度和数据字节。发现填充错误时立即交出「否」；没有填充错误时，在 CRC 界定位交出 CRC 是否相符。其余拍对应输出为「—」。" },
      "hint": [
        { "zh": "帧起始重置去填充器、CRC 和填充检查。CRC 接收从帧起始到 CRC 序列末尾的原始位。" },
        { "zh": "帧长确定 CRC 的结束位置：19 位头部、长度乘八位数据、15 位 CRC。最后一位若触发填充，填充检查还要检查这一位。" },
        { "zh": "一旦发现填充错误先交出「否」，同一帧不要再给第二次结果。" }
      ],
      "inputs": [{ "name": "bit", "label": { "zh": "位" } }],
      "outputs": [
        { "name": "id", "label": { "zh": "标识符" } },
        { "name": "length", "label": { "zh": "数据长度" } },
        { "name": "byte", "label": { "zh": "字节" } },
