{
  "title": { "zh": "清除后再跑一圈" },
  "intro": [
    { "t": { "zh": "清除故障码只删除当前记录，并不证明故障已经修好。模拟行驶循环可以让测试指定的故障重新出现。" } },
    { "t": { "zh": "本关使用游戏定义的行驶例程 [0x31, 1, 0xFE, 0]；它不是任何真实车辆的行驶或诊断过程。" } }
  ],
  "after": { "zh": "清除后的空列表只能说明记录被清除；行驶后再次读取才能观察这个模拟故障是否复现。" },
  "tasks": [
    {
      "id": "5-24",
      "brief": { "zh": "依次读取已确认故障、清除全部故障、再次读取、运行模拟行驶循环并再读一次。交出 [清除前条数, 清除后条数, 行驶后条数]。" },
      "hint": [{ "zh": "故障回答的前三字节是头部，之后每条记录四字节。分别保存前两次的条数，最后拼成报告。" }],
      "inputs": [{ "name": "reply", "label": { "zh": "控制器回答" } }],
      "outputs": [
        { "name": "request", "label": { "zh": "诊断请求" } },
        { "name": "report", "label": { "zh": "故障复查报告" } }
      ],
      "ecu": { "request": "request", "response": "reply" },
      "tests": [
        {
          "bus": { "idle": 6, "frames": [], "tail": 0 },
          "ecu": {
            "did": "0xf190",
            "value": [],
            "dtcs": [{ "code": "0x123456", "status": 8 }],
            "drive": { "recurring": [{ "code": "0x123456", "status": 8 }] }
          }
        }
