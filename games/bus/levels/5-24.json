        "before = reg[reg=B]()",
        "cleared = reg[reg=C]()",
        "next = arith[form=inc](tick)",
        "saveTick = keep[reg=A](next)",
        "c0 = const[value=0]()",
        "c1 = const[value=1]()",
        "c2 = const[value=2]()",
        "c3 = const[value=3]()",
        "c4 = const[value=4]()",
        "c5 = const[value=5]()",
        "c8 = const[value=8]()",
        "c20 = const[value=20]()",
        "c25 = const[value=25]()",
        "c49 = const[value=49]()",
        "c254 = const[value=254]()",
        "c255 = const[value=255]()",
        "b0 = byteList(c0)",
        "b1 = byteList(c1)",
        "b2 = byteList(c2)",
        "b8 = byteList(c8)",
        "b20 = byteList(c20)",
        "b25 = byteList(c25)",
        "b49 = byteList(c49)",
        "b254 = byteList(c254)",
        "b255 = byteList(c255)",
        "at0 = compare[form=eq](tick, c0)",
        "at1 = compare[form=eq](tick, c1)",
        "at2 = compare[form=eq](tick, c2)",
        "at3 = compare[form=eq](tick, c3)",
        "at4 = compare[form=eq](tick, c4)",
        "at5 = compare[form=eq](tick, c5)",
        "readHead = concatBytes(b25, b2)",
        "read = concatBytes(readHead, b8)",
        "clearHead = concatBytes(b20, b255)",
        "clearMid = concatBytes(clearHead, b255)",
        "clear = concatBytes(clearMid, b255)",
        "driveHead = concatBytes(b49, b1)",
        "driveMid = concatBytes(driveHead, b254)",
        "drive = concatBytes(driveMid, b0)",
        "later4 = select(at4, read)",
        "later3 = select(at3, drive, later4)",
        "later2 = select(at2, read, later3)",
        "later1 = select(at1, clear, later2)",
        "requestNow = select(at0, read, later1)",
        "request <- requestNow",
        "length = byteLength(reply)",
        "recordBytes = subtract(length, c3)",
        "count = shiftRight(recordBytes, c2)",
        "nextBefore = select(at1, count, before)",
        "saveBefore = keep[reg=B](nextBefore)",
        "nextCleared = select(at3, count, cleared)",
        "saveCleared = keep[reg=C](nextCleared)",
        "beforeByte = byteList(before)",
        "clearedByte = byteList(cleared)",
        "afterByte = byteList(count)",
        "firstTwo = concatBytes(beforeByte, clearedByte)",
        "reportData = concatBytes(firstTwo, afterByte)",
        "reportNow = select(at5, reportData)",
        "report <- reportNow"
      ],
