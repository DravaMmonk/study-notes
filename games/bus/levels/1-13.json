{
  "title": { "zh": "读出数据" },
  "intro": [
    { "t": { "zh": "一帧能带零到八个字节。长度字段决定数据到哪里结束；每八个原始位组成一个字节，先到的是高位。填充位不属于字节，也不推进字节内的位置。" } },
    { "t": { "zh": "这次从帧起始开始读一帧。把标识符、数据长度和每个字节分别交出来，以后才能把帧交给更高层处理。" } }
  ],
  "builds": {
    "type": "frameparse",
    "name": { "zh": "解析帧" },
    "desc": { "zh": "从帧起始读一帧，在对应字段的最后一位交出标识符、长度和每个数据字节；其他拍交出「—」。不检查 CRC，也不寻找帧起始。" }
  },
  "after": { "zh": "长度为零时没有字节；长度为八时交出八次。填充位只改变到达的拍数，不改变字段位置。" },
  "tasks": [
    {
      "id": "1-13",
      "brief": { "zh": "从第一位开始读一帧：在标识符和长度字段的最后一位分别交出它们；每凑满一个数据字节就交出该字节，其他拍交出「—」。" },
      "hint": [
        { "zh": "只在有效位到达时推进原始位的位置；标识符是位置 1 至 11，长度是位置 15 至 18。" },
        { "zh": "数据从位置 19 开始，长度乘八是数据位数。数到数据结束后，不要把校验字段当成字节。" },
        { "zh": "在数据里另数字节中的 0 至 7，每凑满八位清零，从下一字节重新攒。" }
      ],
      "inputs": [{ "name": "bit", "label": { "zh": "位" } }],
      "outputs": [
        { "name": "id", "label": { "zh": "标识符" } },
        { "name": "length", "label": { "zh": "数据长度" } },
        { "name": "byte", "label": { "zh": "字节" } }
      ],
      "tests": [
        {
          "bus": { "idle": 0, "frames": [{ "id": 291, "data": [] }], "tail": 4 },
          "lineInputs": ["bit"]
        },
        {
          "bus": { "idle": 0, "frames": [{ "id": 2047, "data": [165, 0] }], "tail": 4 },
          "lineInputs": ["bit"]
        }
      ],
      "hidden": [
        {
          "bus": { "idle": 0, "frames": [{ "id": 0, "data": [0, 255, 1, 2, 3, 4, 5, 6] }], "tail": 4 },
          "lineInputs": ["bit"]
        }
      ],
      "want": { "id": "identifier", "length": "dataLength", "byte": "dataByte" },
      "solution": [
        "d = destuff(bit)",
        "p = reg[reg=A, start=0]()",
        "one = const[value=1]()",
        "zero = const[value=0]()",
        "pi = arith[form=inc](p)",
        "pn = select(d.valid, pi, p)",
        "kp = keep[reg=A](pn)",
        "b = reg[reg=B, start=0]()",
        "twelve = const[value=12]()",
        "idlo = compare[form=lt](zero, p)",
        "idhi = compare[form=lt](p, twelve)",
        "idin = select(idlo, idhi, zero)",
        "b2 = arith[form=add](b, b)",
        "idnew = arith[form=add](b2, d.out)",
        "dlc = reg[reg=D, start=0]()",
        "fourteen = const[value=14]()",
        "nineteen = const[value=19]()",
        "dlclo = compare[form=lt](fourteen, p)",
        "dlchi = compare[form=lt](p, nineteen)",
        "dlcin = select(dlclo, dlchi, zero)",
        "dlc2 = arith[form=add](dlc, dlc)",
        "dlcnew = arith[form=add](dlc2, d.out)",
        "dlcmaybe = select(dlcin, dlcnew, dlc)",
        "dlcn = select(d.valid, dlcmaybe, dlc)",
        "kd = keep[reg=D](dlcn)",
        "two = arith[form=add](dlc, dlc)",
        "four = arith[form=add](two, two)",
        "eight = arith[form=add](four, four)",
        "end = arith[form=add](nineteen, eight)",
        "datalo = compare[form=lt](p, nineteen)",
        "datage = select(datalo, zero, one)",
        "datahi = compare[form=lt](p, end)",
        "datain = select(datage, datahi, zero)",
        "seven = const[value=7]()",
        "blast = compare[form=eq](b, seven)",
        "bi = arith[form=inc](b)",
        "bphase = select(blast, zero, bi)",
        "bdata = select(datain, bphase, zero)",
        "bactive = select(idin, idnew, bdata)",
        "bn = select(d.valid, bactive, b)",
        "kb = keep[reg=B](bn)",
        "c = reg[reg=C, start=0]()",
        "bfirst = compare[form=eq](b, zero)",
        "cbase = select(bfirst, zero, c)",
        "c2 = arith[form=add](cbase, cbase)",
        "cnew = arith[form=add](c2, d.out)",
        "cactive = select(datain, cnew, c)",
        "cn = select(d.valid, cactive, c)",
        "kc = keep[reg=C](cn)",
        "eleven = const[value=11]()",
        "idlast = compare[form=eq](p, eleven)",
        "idready = select(d.valid, idlast, zero)",
        "ido = select(idready, bn)",
        "id <- ido",
        "eighteen = const[value=18]()",
        "dlclast = compare[form=eq](p, eighteen)",
        "dlcready = select(d.valid, dlclast, zero)",
        "dlco = select(dlcready, dlcn)",
        "length <- dlco",
        "blastdata = select(datain, blast, zero)",
        "byteready = select(d.valid, blastdata, zero)",
        "byteo = select(byteready, cn)",
        "byte <- byteo"
      ],
      "naive": [
        "d = destuff(bit)",
