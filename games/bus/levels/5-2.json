{
  "title": { "zh": "读懂拒绝回答" },
  "intro": [{ "t": { "zh": "控制器不支持请求的数据标识时，可以返回否定回答 [0x7F, 原服务号, 原因码]。此处的 0x31 表示请求超出支持范围。" } }],
  "after": { "zh": "否定回答保留被拒绝的服务号，原因码解释为什么没有执行请求。" },
  "tasks": [
    {
      "id": "5-2",
      "brief": { "zh": "请求数据标识 0xF191。模拟控制器不支持它；从下一拍回答中取出单字节原因码。尚未收到回答时交出「—」。" },
      "hint": [{ "zh": "先构造 [0x22, 0xF1, 0x91]，再从回答位置 2 截取一个字节。" }],
      "inputs": [{ "name": "reply", "label": { "zh": "控制器回答" } }],
      "outputs": [
        { "name": "request", "label": { "zh": "诊断请求" } },
        { "name": "reason", "label": { "zh": "原因码" } }
      ],
      "ecu": { "request": "request", "response": "reply" },
      "tests": [
        { "bus": { "idle": 3, "frames": [], "tail": 0 }, "ecu": { "did": "0xf190", "value": [65, 66] } }
      ],
      "hidden": [
        { "bus": { "idle": 3, "frames": [], "tail": 0 }, "ecu": { "did": "0xf188", "value": [1, 2, 3] } }
      ],
      "want": { "request": { "ecuRejectedRequest": { "did": 61841 } }, "reason": "ecuRejectReason" },
      "solution": [
        "service = const[value=34]()",
        "hi = const[value=241]()",
        "lo = const[value=145]()",
        "a = byteList(service)",
        "b = byteList(hi)",
        "d = byteList(lo)",
        "ab = concatBytes(a, b)",
        "req = concatBytes(ab, d)",
        "request <- req",
        "two = const[value=2]()",
        "one = const[value=1]()",
        "code = sliceBytes(reply, two, one)",
        "reason <- code"
      ],
      "naive": [
        "service = const[value=34]()",
        "hi = const[value=241]()",
        "lo = const[value=145]()",
        "a = byteList(service)",
        "b = byteList(hi)",
        "d = byteList(lo)",
        "ab = concatBytes(a, b)",
        "req = concatBytes(ab, d)",
        "request <- req",
        "two = const[value=2]()",
        "one = const[value=1]()",
        "code = sliceBytes(reply, one, one)",
        "reason <- code"
      ]
    }
  ]
}
