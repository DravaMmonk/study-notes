        "c136 = const[value=136]()",
        "c241 = const[value=241]()",
        "is0 = compare[form=eq](phase, c0)",
        "is1 = compare[form=eq](phase, c1)",
        "is2 = compare[form=eq](phase, c2)",
        "is3 = compare[form=eq](phase, c3)",
        "inRange = compare[form=lt](index, c6)",
        "b16 = byteList(c16)",
        "b3 = byteList(c3)",
        "session = concatBytes(b16, b3)",
        "b34 = byteList(c34)",
        "b241 = byteList(c241)",
        "b136 = byteList(c136)",
        "head = concatBytes(b34, b241)",
        "read = concatBytes(head, b136)",
        "first = select(inRange, session)",
        "second = select(ready, read)",
        "later = select(is1, second)",
        "requestNow = select(is0, first, later)",
        "request <- requestNow",
        "hasRequest = present(requestNow)",
        "targetNow = select(hasRequest, index)",
        "target <- targetNow",
        "service = byteAt(reply, c0)",
        "pending = compare[form=eq](service, c127)",
        "positive = compare[form=eq](service, c98)",
        "notReady = select(ready, c0, c1)",
        "notPending = select(pending, c0, c1)",
        "advance2 = select(is2, notPending, c0)",
        "advance = select(is1, notReady, advance2)",
        "incIndex = arith[form=inc](index)",
        "nextIndex = select(advance, incIndex, index)",
        "saveIndex = keep[reg=A](nextIndex)",
        "phase0 = select(inRange, c1, c3)",
        "phase1 = select(ready, c2, c0)",
        "phase2 = select(pending, c2, c0)",
        "phase3 = select(is3, c4, phase)",
        "phaseAfter2 = select(is2, phase2, phase3)",
        "phaseAfter1 = select(is1, phase1, phaseAfter2)",
        "nextPhase = select(is0, phase0, phaseAfter1)",
        "savePhase = keep[reg=B](nextPhase)",
        "empty = emptyBytes()",
        "exists = present(list)",
        "base = select(exists, list, empty)",
        "version = byteAt(reply, c3)",
        "sourceByte = byteList(source)",
        "versionByte = byteList(version)",
        "pair = concatBytes(sourceByte, versionByte)",
        "appended = concatBytes(base, pair)",
        "append = select(is2, positive, c0)",
        "nextList = select(append, appended, base)",
        "saveList = keep[reg=C](nextList)",
        "result = select(is3, list)",
        "versions <- result"
      ],
