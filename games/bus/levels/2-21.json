        "tgood = select(otx, tminus, t)",
        "tcalc = select(addtx, tplus, tgood)",
        "tn = select(offbase, t, tcalc)",
        "rinc = arith[form=inc](r)",
        "rpositive = compare[form=lt](zero, r)",
        "rminus0 = subtract(r, one)",
