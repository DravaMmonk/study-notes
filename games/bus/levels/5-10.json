        "c48 = const[value=48]()",
        "b48 = byteList(c48)",
        "c144 = const[value=144]()",
        "b144 = byteList(c144)",
        "c241 = const[value=241]()",
        "b241 = byteList(c241)",
        "first = compare[form=eq](tick, c0)",
        "rq0 = concatBytes(b3, b34)",
        "rq1 = concatBytes(rq0, b241)",
        "request = concatBytes(rq1, b144)",
        "fc0 = concatBytes(b48, b0)",
        "flow = concatBytes(fc0, b0)",
        "header = byteAt(incoming, c0)",
        "low = byteAt(incoming, c1)",
        "kind = shiftRight(header, c4)",
        "firstFrame = compare[form=eq](kind, c1)",
        "grant = select(ready, firstFrame, c0)",
        "sendFlow = select(grant, flow)",
        "out = select(first, request, sendFlow)",
        "outgoing <- out",
        "data = sliceBytes(incoming, c3, c17)",
        "record <- data"
      ]
    }
  ]
