        "c1 = const[value=1]()",
        "b1 = byteList(c1)",
        "c3 = const[value=3]()",
        "b3 = byteList(c3)",
        "c4 = const[value=4]()",
        "b4 = byteList(c4)",
        "c17 = const[value=17]()",
