{
  "title": { "zh": "使用长消息重组" },
  "intro": [{ "t": { "zh": "把搭好的重组电路封装起来，再用另一段帧序列检查它。" } }],
  "after": { "zh": "封装件运行的是你搭建的重组电路，状态属于每一个元件实例。" },
  "tasks": [
    {
      "id": "4-4",
      "brief": { "zh": "使用长消息重组元件，只交出长度大于零的完整消息。" },
      "hint": [{ "zh": "把帧数据接给重组元件，再用字节长度和比较元件检查结果。" }],
      "inputs": [
        { "name": "data", "label": { "zh": "帧数据" } },
        { "name": "header", "label": { "zh": "第一个数据字节" } },
        { "name": "low", "label": { "zh": "第二个数据字节" } },
        { "name": "enable", "label": { "zh": "接收允许" } }
      ],
      "frameInputs": { "data": "data", "header": "byte0", "low": "byte1" },
      "outputs": [{ "name": "message", "label": { "zh": "消息字节" } }],
      "tests": [
        {
          "bus": { "frames": [] },
          "frameRequests": [
            { "node": "ecu", "at": 10, "id": "0x7e8", "data": [16, 20, 1, 2, 3, 4, 5, 6] },
            { "node": "ecu", "at": 210, "id": "0x7e8", "data": [33, 7, 8, 9, 10, 11, 12, 13] },
            { "node": "ecu", "at": 410, "id": "0x7e8", "data": [34, 14, 15, 16, 17, 18, 19, 20] },
            { "node": "ecu", "at": 610, "id": "0x7e8", "data": [16, 8, 1, 2, 3, 4, 5, 6] },
            { "node": "ecu", "at": 810, "id": "0x7e8", "data": [33, 7, 8, 170, 170, 170, 170, 170] }
          ],
          "constants": { "enable": 1 }
        }
      ],
      "hidden": [
        {
          "bus": { "frames": [] },
          "frameRequests": [
            { "node": "ecu", "at": 10, "id": "0x7e8", "data": [16, 9, 99, 98, 97, 96, 95, 94] },
            { "node": "ecu", "at": 210, "id": "0x7e8", "data": [33, 93, 92, 91, 170, 170, 170, 170] }
          ],
          "constants": { "enable": 1 }
        }
      ],
      "want": { "message": { "multiFrameMessage": { "data": "data", "enable": "enable" } } },
      "solution": [
        "r = isorecv(data, header, low, enable)",
        "length = byteLength(r)",
        "zero = const[value=0]()",
        "nonempty = compare[form=lt](zero, length)",
        "out = select(nonempty, r)",
        "message <- out"
      ]
    }
  ]
}
