            "flash": {
              "maxBlock": 3,
              "expectedChecksum": 10,
              "image": [10],
              "versionAfter": [6],
              "fixedDtcs": []
            }
          }
        }
      ],
      "want": { "request": "ecuUpdateRequests", "report": "ecuUpdateReport" },
      "solution": [
        "tick = reg[reg=A, start=0]()",
        "flags = reg[reg=B]()",
        "oldVersion = reg[reg=C]()",
        "post = reg[reg=D, start=0]()",
        "nextTick = arith[form=inc](tick)",
        "saveTick = keep[reg=A](nextTick)",
        "c0 = const[value=0]()",
        "b0 = byteList(c0)",
        "c1 = const[value=1]()",
        "b1 = byteList(c1)",
        "c2 = const[value=2]()",
        "b2 = byteList(c2)",
        "c3 = const[value=3]()",
        "b3 = byteList(c3)",
        "c4 = const[value=4]()",
        "b4 = byteList(c4)",
        "c8 = const[value=8]()",
        "b8 = byteList(c8)",
        "c25 = const[value=25]()",
        "b25 = byteList(c25)",
        "c34 = const[value=34]()",
        "b34 = byteList(c34)",
        "c49 = const[value=49]()",
        "b49 = byteList(c49)",
        "c136 = const[value=136]()",
        "b136 = byteList(c136)",
        "c241 = const[value=241]()",
        "b241 = byteList(c241)",
        "c254 = const[value=254]()",
        "b254 = byteList(c254)",
        "at0 = compare[form=eq](tick, c0)",
        "at1 = compare[form=eq](tick, c1)",
        "at2 = compare[form=eq](tick, c2)",
        "enable = compare[form=lt](c1, tick)",
        "f = flasher(reply, image, enable)",
        "post1 = compare[form=eq](post, c1)",
        "post2 = compare[form=eq](post, c2)",
        "post3 = compare[form=eq](post, c3)",
        "post4 = compare[form=eq](post, c4)",
        "postActive = compare[form=lt](c0, post)",
        "postInc = arith[form=inc](post)",
        "afterStart = select(postActive, postInc, c0)",
        "donePresent = present(f.done)",
        "nextPost = select(donePresent, c1, afterStart)",
        "savePost = keep[reg=D](nextPost)",
        "readHead = concatBytes(b25, b2)",
        "readFault = concatBytes(readHead, b8)",
        "versionHead = concatBytes(b34, b241)",
        "readVersion = concatBytes(versionHead, b136)",
        "cycle0 = concatBytes(b49, b1)",
        "cycle1 = concatBytes(cycle0, b254)",
        "cycle = concatBytes(cycle1, b0)",
        "post3Req = select(post3, readVersion)",
        "post2Req = select(post2, readFault, post3Req)",
        "postReq = select(post1, cycle, post2Req)",
        "afterFirst = select(at1, readVersion, f.request)",
        "preReq = select(at0, readFault, afterFirst)",
        "requestNow = select(postActive, postReq, preReq)",
        "request <- requestNow",
        "size = byteLength(reply)",
        "hasFault = compare[form=lt](c3, size)",
        "flag = select(hasFault, c1, c0)",
        "flagByte = byteList(flag)",
        "firstFlags = select(at1, flagByte, flags)",
        "bothFlags = concatBytes(flags, flagByte)",
        "nextFlags = select(post3, bothFlags, firstFlags)",
        "saveFlags = keep[reg=B](nextFlags)",
        "versionByte = byteAt(reply, c3)",
        "nextVersion = select(at2, versionByte, oldVersion)",
        "saveVersion = keep[reg=C](nextVersion)",
        "oldByte = byteList(oldVersion)",
        "newByte = byteList(versionByte)",
        "versionPair = concatBytes(oldByte, newByte)",
        "reportData = concatBytes(versionPair, flags)",
        "reportNow = select(post4, reportData)",
        "report <- reportNow"
      ],
