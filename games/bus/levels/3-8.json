{
  "title": { "zh": "同一帧里的两种含义" },
  "intro": [{ "t": { "zh": "有些帧复用同一位置：第一个字节是选择值，0 表示第二个字节是温度原始值，1 表示第二个字节是转速原始值。" } }],
  "after": { "zh": "先读选择值，再解释复用的数据位置；同一字节不总是同一种信号。" },
  "tasks": [
    {
      "id": "3-8",
      "brief": { "zh": "选择值为 0 时只交出温度原始值；为 1 时只交出转速原始值。没有对应信号的输出交出「—」。" },
      "hint": [{ "zh": "分别比较选择值与 0、1，再用选择元件把数据送到对应输出。" }],
      "inputs": [{ "name": "tag", "label": { "zh": "选择值" } }, { "name": "raw", "label": { "zh": "第二个数据字节" } }],
      "frameInputs": { "tag": "byte0", "raw": "byte1" },
      "outputs": [
        { "name": "temperature", "label": { "zh": "温度原始值" } },
        { "name": "rpm", "label": { "zh": "转速原始值" } }
      ],
      "tests": [
        {
          "bus": { "frames": [] },
          "frameRequests": [
            { "node": "sensor", "at": 10, "id": "0x123", "data": [0, 30] },
            { "node": "sensor", "at": 120, "id": "0x123", "data": [1, 70] },
            { "node": "sensor", "at": 230, "id": "0x123", "data": [0, 0] }
          ]
        }
      ],
      "hidden": [
        {
          "bus": { "frames": [] },
          "frameRequests": [
            { "node": "sensor", "at": 10, "id": "0x123", "data": [1, 0] },
            { "node": "sensor", "at": 120, "id": "0x123", "data": [0, 255] },
            { "node": "sensor", "at": 230, "id": "0x123", "data": [1, 255] }
          ]
        }
      ],
      "want": {
        "temperature": { "matchingFrameSignal": { "input": "raw", "identifier": "tag", "match": 0 } },
        "rpm": { "matchingFrameSignal": { "input": "raw", "identifier": "tag", "match": 1 } }
      },
      "solution": [
        "zero = const[value=0]()",
        "one = const[value=1]()",
        "isTemp = compare[form=eq](tag, zero)",
        "isRpm = compare[form=eq](tag, one)",
        "t = select(isTemp, raw)",
        "r = select(isRpm, raw)",
        "temperature <- t",
        "rpm <- r"
      ],
      "naive": ["temperature <- raw", "rpm <- raw"]
    }
  ]
}
