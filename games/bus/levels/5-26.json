        "readNegative = concatBytes(readNeg1, b49)",
        "readResult = select(didOK, readPositive, readNegative)",
        "faultHead1 = concatBytes(b89, b2)",
        "faultHead = concatBytes(faultHead1, b255)",
        "faultResult = concatBytes(faultHead, faults)",
        "serviceByte = byteList(service)",
        "unknownHead = concatBytes(b127, serviceByte)",
        "unknownResult = concatBytes(unknownHead, b17)",
        "notRead = select(isFault, faultResult, unknownResult)",
        "result = select(isRead, readResult, notRead)",
        "requested = present(request)",
