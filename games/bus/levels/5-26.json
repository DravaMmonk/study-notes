        "service = byteAt(request, c0)",
        "high = byteAt(request, c1)",
        "low = byteAt(request, c2)",
        "isRead = compare[form=eq](service, c34)",
        "isFault = compare[form=eq](service, c25)",
        "highOK = compare[form=eq](high, c241)",
        "lowOK = compare[form=eq](low, c144)",
        "falseValue = compare[form=eq](c0, c1)",
        "didOK = select(highOK, lowOK, falseValue)",
        "readHead1 = concatBytes(b98, b241)",
        "readHead = concatBytes(readHead1, b144)",
        "readPositive = concatBytes(readHead, value)",
