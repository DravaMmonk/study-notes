      "solution": [
        "zero = const[value=0]()",
        "one = const[value=1]()",
        "two = const[value=2]()",
        "five = const[value=5]()",
        "false = compare[form=eq](zero, one)",
        "wait = reg[reg=A, start=0]()",
        "phase = reg[reg=B, start=0]()",
        "armed = reg[reg=C, start=0]()",
        "c = counter(phase)",
        "third = compare[form=eq](c, two)",
        "end = select(phase, third, false)",
        "ready = suspend(end, fault.mode)",
        "readynum = select(ready, one, zero)",
        "permit = select(armed, readynum, zero)",
        "retry = select(wait, permit, zero)",
        "fire = select(start, one, retry)",
        "source = select(wait, zero, available)",
        "p = transmitter(id, length, item, source, last, fire)",
        "slot = select(wait, zero, p.ack)",
        "high = compare[form=eq](line, one)",
        "missing = select(slot, high, false)",
        "f = errorflag(missing)",
        "queued = select(wait, one, p.send)",
        "wire = select(fire, p.send, queued)",
        "send <- wire",
        "holding = select(missing, one, wait)",
        "waitnext = select(fire, zero, holding)",
        "ka = keep[reg=A](waitnext)",
        "phasehold = select(f.done, one, phase)",
        "phasenext = select(fire, zero, phasehold)",
        "kb = keep[reg=B](phasenext)",
        "arming = select(end, one, armed)",
        "armednext = select(fire, zero, arming)",
        "kc = keep[reg=C](armednext)",
        "take = select(wait, false, p.next)",
        "next <- take",
        "rewind <- missing",
        "attempt <- fire",
        "finished = select(wait, false, p.done)",
        "done <- finished",
        "eofvalid = select(wait, zero, p.eof)",
        "success = select(eofvalid, two, prep)",
        "event = select(missing, five, success)",
        "fault = faultcounter(event, reset)",
        "tec <- fault.tx",
        "mode <- fault.mode"
