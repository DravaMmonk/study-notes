{
  "title": { "zh": "模拟车辆更新与复查" },
  "intro": [
    { "t": { "zh": "先用自己搭的体检仪记录两个在线控制器的版本和已确认故障，再按依赖顺序刷写两个控制器。重启后运行游戏定义的行驶循环，复读故障与版本。" } },
    { "t": { "zh": "这是消息层综合练习：控制器 0 和 1 在线，其余四个离线；所有步骤假定按时成功回答，行驶循环只清除测试指定的故障。它还没有模拟实际道路或物理总线。" } }
  ],
  "after": { "zh": "复查应比较更新前后的结果；修复指定故障后，其他已确认故障仍可能存在。" },
  "tasks": [
    {
      "id": "6-9",
      "brief": {
        "zh": "先体检，再先后刷写控制器 0 和 1；两者重启后分别运行 [0x31, 1, 0xFE, 0]，复查已确认故障和版本。交出 [旧版本 0, 旧版本 1, 新版本 0, 新版本 1, 更新前故障 0, 更新前故障 1, 更新后故障 0, 更新后故障 1]。"
      },
      "hint": [{ "zh": "用体检报告启动刷写器并保存旧结果。第二个刷写器完成后，按顺序发送两个行驶请求、两个故障请求和两个版本请求；寄存卡保存回答。" }],
      "inputs": [
        { "name": "source", "label": { "zh": "回答的控制器" } },
        { "name": "reply", "label": { "zh": "控制器回答" } },
        { "name": "ready", "label": { "zh": "收到回答" } },
        { "name": "image0", "label": { "zh": "控制器 0 软件" } },
        { "name": "image1", "label": { "zh": "控制器 1 软件" } }
      ],
      "outputs": [
        { "name": "target", "label": { "zh": "请求目标" } },
        { "name": "request", "label": { "zh": "诊断请求" } },
        { "name": "report", "label": { "zh": "更新复查报告" } }
      ],
      "fleet": {
        "target": "target",
        "request": "request",
        "source": "source",
        "response": "reply",
        "ready": "ready",
        "images": { "image0": 0, "image1": 1 }
      },
      "tests": [
        {
          "bus": { "idle": 100, "frames": [], "tail": 0 },
          "fleet": [
            {
              "online": true,
              "version": 1,
              "waits": 0,
              "dtcs": [{ "code": "0x123456", "status": 8 }],
              "flash": {
                "maxBlock": 4,
                "expectedChecksum": 10,
                "image": [1, 2, 3, 4],
                "versionAfter": [2],
                "fixedDtcs": ["0x123456"]
              }
            },
            {
              "online": true,
              "version": 1,
              "waits": 0,
              "dtcs": [],
              "flash": {
                "maxBlock": 4,
                "expectedChecksum": 24,
                "image": [9, 8, 7],
                "versionAfter": [2],
                "fixedDtcs": []
              },
              "after": 0
            },
            { "online": false, "version": 0 },
            { "online": false, "version": 0 },
            { "online": false, "version": 0 },
            { "online": false, "version": 0 }
          ]
        }
      ],
      "hidden": [
        {
          "bus": { "idle": 100, "frames": [], "tail": 0 },
          "fleet": [
            {
              "online": true,
              "version": 3,
              "waits": 0,
              "dtcs": [{ "code": "0x123456", "status": 8 }, { "code": "0x654321", "status": 8 }],
              "flash": {
                "maxBlock": 3,
                "expectedChecksum": 4,
                "image": [1, 3],
                "versionAfter": [5],
                "fixedDtcs": ["0x123456"]
              }
