                "image": [4, 5, 6, 7],
                "versionAfter": [6],
                "fixedDtcs": []
              },
              "after": 0
            },
            { "online": false, "version": 0 },
            { "online": false, "version": 0 },
            { "online": false, "version": 0 },
            { "online": false, "version": 0 }
          ]
        }
      ],
      "want": {
        "target": "fleetRecheckTargets",
        "request": "fleetRecheckRequests",
        "report": "fleetRecheckReport"
      },
      "solution": [
        "stage = reg[reg=A, start=0]()",
        "post = reg[reg=B, start=0]()",
        "started = reg[reg=C, start=0]()",
        "before = reg[reg=D]()",
        "flags = reg[reg=E]()",
        "firstVersion = reg[reg=F]()",
        "c0 = const[value=0]()",
        "c1 = const[value=1]()",
        "c2 = const[value=2]()",
        "c3 = const[value=3]()",
        "c4 = const[value=4]()",
        "c5 = const[value=5]()",
        "c6 = const[value=6]()",
        "c7 = const[value=7]()",
        "c8 = const[value=8]()",
        "c25 = const[value=25]()",
        "c34 = const[value=34]()",
        "c49 = const[value=49]()",
        "c136 = const[value=136]()",
        "c241 = const[value=241]()",
        "c254 = const[value=254]()",
        "exam = vehicleExam(source, reply, ready)",
        "examDone = present(exam.report)",
        "active = select(examDone, c1, started)",
        "saveStart = keep[reg=C](active)",
        "nextBefore = select(examDone, exam.report, before)",
        "saveBefore = keep[reg=D](nextBefore)",
        "firstEnableCandidate = select(stage, c0, c1)",
        "secondEnableCandidate = select(stage, c1, c0)",
        "firstEnable = select(active, firstEnableCandidate, c0)",
        "secondEnable = select(active, secondEnableCandidate, c0)",
        "first = flasher(reply, image0, firstEnable)",
        "second = flasher(reply, image1, secondEnable)",
        "firstDone = present(first.done)",
        "secondDone = present(second.done)",
        "nextStage = select(firstDone, c1, stage)",
        "saveStage = keep[reg=A](nextStage)",
        "post1 = compare[form=eq](post, c1)",
        "post2 = compare[form=eq](post, c2)",
        "post3 = compare[form=eq](post, c3)",
        "post4 = compare[form=eq](post, c4)",
        "post5 = compare[form=eq](post, c5)",
        "post6 = compare[form=eq](post, c6)",
        "after6 = select(post6, c7, post)",
        "after5 = select(post5, c6, after6)",
        "after4 = select(post4, c5, after5)",
        "after3 = select(post3, c4, after4)",
        "after2 = select(post2, c3, after3)",
        "after1 = select(post1, c2, after2)",
        "nextPost = select(secondDone, c1, after1)",
        "savePost = keep[reg=B](nextPost)",
        "b0 = byteList(c0)",
        "b1 = byteList(c1)",
        "b2 = byteList(c2)",
        "b8 = byteList(c8)",
        "b25 = byteList(c25)",
        "b34 = byteList(c34)",
        "b49 = byteList(c49)",
        "b136 = byteList(c136)",
        "b241 = byteList(c241)",
        "b254 = byteList(c254)",
        "cycleHead = concatBytes(b49, b1)",
        "cycleMiddle = concatBytes(cycleHead, b254)",
        "cycle = concatBytes(cycleMiddle, b0)",
        "faultHead = concatBytes(b25, b2)",
        "readFault = concatBytes(faultHead, b8)",
        "versionHead = concatBytes(b34, b241)",
        "readVersion = concatBytes(versionHead, b136)",
        "program = select(stage, second.request, first.request)",
        "check5 = select(post5, readVersion, program)",
        "check4 = select(post4, readVersion, check5)",
        "check3 = select(post3, readFault, check4)",
        "check2 = select(post2, readFault, check3)",
        "check1 = select(post1, cycle, check2)",
        "afterDone = select(secondDone, cycle, check1)",
        "requestNow = select(active, afterDone, exam.request)",
        "request <- requestNow",
        "target5 = select(post5, c1, stage)",
        "target4 = select(post4, c0, target5)",
        "target3 = select(post3, c1, target4)",
        "target2 = select(post2, c0, target3)",
        "target1 = select(post1, c1, target2)",
        "targetDone = select(secondDone, c0, target1)",
        "chosenTarget = select(active, targetDone, exam.target)",
        "hasRequest = present(requestNow)",
        "targetNow = select(hasRequest, chosenTarget)",
        "target <- targetNow",
        "length = byteLength(reply)",
        "hasFault = compare[form=lt](c3, length)",
        "flag = select(hasFault, c1, c0)",
        "flagByte = byteList(flag)",
        "bothFlags = concatBytes(flags, flagByte)",
        "secondFlag = select(post4, bothFlags, flags)",
        "nextFlags = select(post3, flagByte, secondFlag)",
        "saveFlags = keep[reg=E](nextFlags)",
        "versionByte = byteAt(reply, c3)",
        "nextFirst = select(post5, versionByte, firstVersion)",
        "saveVersion = keep[reg=F](nextFirst)",
        "old0 = byteAt(before, c1)",
        "old1 = byteAt(before, c4)",
        "oldFlag0 = byteAt(before, c2)",
        "oldFlag1 = byteAt(before, c5)",
        "old0b = byteList(old0)",
        "old1b = byteList(old1)",
        "new0b = byteList(firstVersion)",
        "new1b = byteList(versionByte)",
        "oldFlag0b = byteList(oldFlag0)",
        "oldFlag1b = byteList(oldFlag1)",
        "oldVersions = concatBytes(old0b, old1b)",
        "newVersions = concatBytes(new0b, new1b)",
        "oldFlags = concatBytes(oldFlag0b, oldFlag1b)",
        "versions = concatBytes(oldVersions, newVersions)",
        "prior = concatBytes(versions, oldFlags)",
        "full = concatBytes(prior, flags)",
        "reportNow = select(post6, full)",
        "report <- reportNow"
      ],
