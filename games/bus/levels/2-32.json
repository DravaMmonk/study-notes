{
  "title": { "zh": "输了再发，没应答再发" },
  "intro": [{ "t": { "zh": "控制器可能先在仲裁中落败，听完并应答赢家，再发送自己的帧；重发时也可能等不到应答。现在把这两种不同的等待接在一起。" } }],
  "after": { "zh": "仲裁落败不是错误：它不增加发送错误计数。缺应答会中断当前帧并记账，队列必须从头重读。本练习尚未覆盖位错误、被动节点或其他节点在等待时插入报文。" },
  "tasks": [
    {
      "id": "2-32",
      "brief": {
        "zh": "从开始拍发送数据帧。仲裁落败时停止发送、接收并应答正确的赢家帧，在帧间隔后重试；自己的帧缺应答时发送主动错误标志、重置队列并在错误界定与帧间隔后重试。交出落败、每次尝试、队列取走与重置、完成及发送错误计数。测试只含一次初始竞争、不同标识符、正常赢家帧和少量缺应答。"
      },
      "hint": [
        { "zh": "复用仲裁器和校验抓帧器。赢家 CRC 正确时记下应答，下一拍拉低总线。" },
        { "zh": "用不同状态区分接收赢家与发送错误标志；两种情况都等总线连续 11 位隐性后重新发送。只有缺应答才重置已经取走的队列。" }
      ],
      "listens": true,
      "drives": true,
      "inputs": [
        { "name": "id", "label": { "zh": "标识符" } },
        { "name": "length", "label": { "zh": "数据长度" } },
        { "name": "item", "label": { "zh": "队首" } },
        { "name": "available", "label": { "zh": "有字节" } },
        { "name": "last", "label": { "zh": "最后字节" } },
        { "name": "start", "label": { "zh": "开始" } }
      ],
      "outputs": [
        { "name": "next", "label": { "zh": "取走" } },
        { "name": "rewind", "label": { "zh": "重置队列" } },
        { "name": "attempt", "label": { "zh": "发送开始" } },
        { "name": "done", "label": { "zh": "完成" } },
        { "name": "tec", "label": { "zh": "发送错误计数" } },
        { "name": "lost", "label": { "zh": "落败" } }
      ],
      "pulls": {
        "input": "item",
        "available": "available",
        "last": "last",
        "next": "next",
        "rewind": "rewind"
      },
      "tests": [
        {
