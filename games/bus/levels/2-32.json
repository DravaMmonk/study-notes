      "solution": [
        "zero = const[value=0]()",
        "one = const[value=1]()",
        "two = const[value=2]()",
        "five = const[value=5]()",
        "ten = const[value=10]()",
        "false = compare[form=eq](zero, one)",
        "wait = reg[reg=A, start=0]()",
        "receiving = compare[form=eq](wait, one)",
        "errorwait = compare[form=eq](wait, two)",
        "normal = compare[form=eq](wait, zero)",
        "quiet = counter(line)",
        "long = compare[form=lt](ten, quiet)",
        "readynum = select(long, one, zero)",
        "retry = select(normal, zero, readynum)",
        "fire = select(start, one, retry)",
        "source = select(normal, available, zero)",
        "p = transmitter(id, length, item, source, last, fire)",
        "a = arbiter(line, p.send, p.arb, fire)",
        "s = sniffer(line)",
        "ack = reg[reg=B, start=0]()",
        "good = select(s.ready, s.ok, zero)",
        "acknext = select(receiving, good, zero)",
        "kb = keep[reg=B](acknext)",
        "receivewire = select(ack, zero, one)",
        "slot = select(normal, p.ack, zero)",
        "high = compare[form=eq](line, one)",
        "missing = select(slot, high, false)",
        "f = errorflag(missing)",
        "errorwire = select(errorwait, f.send, a.send)",
        "waitingwire = select(receiving, receivewire, errorwire)",
        "wire = select(fire, p.send, waitingwire)",
        "send <- wire",
        "witherror = select(missing, two, wait)",
        "withloss = select(a.lost, one, witherror)",
        "waitnext = select(fire, zero, withloss)",
        "ka = keep[reg=A](waitnext)",
        "lost <- a.lost",
        "attempt <- fire",
        "take = select(normal, p.next, false)",
        "next <- take",
        "rewind <- missing",
        "finished = select(normal, p.done, false)",
        "done <- finished",
        "eofvalid = select(normal, p.eof, zero)",
        "success = select(eofvalid, two, zero)",
        "event = select(missing, five, success)",
        "fault = faultcounter(event, start)",
        "tec <- fault.tx"
      ],
