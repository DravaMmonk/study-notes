      "want": { "frame": "transportFrames", "received": "transportReceivedMessage" },
      "solution": [
        "zero = const[value=0]()",
        "one = const[value=1]()",
        "eight = const[value=8]()",
        "flowCode = const[value=48]()",
        "flowHead = byteAt(flow, zero)",
        "isContinue = compare[form=eq](flowHead, flowCode)",
        "grant = select(arrived, isContinue, zero)",
        "sender = isosender(message, flow, grant)",
        "frame <- sender",
        "hasFrame = present(sender)",
        "padded = padBytes(sender, eight, zero)",
        "header = byteAt(padded, zero)",
        "low = byteAt(padded, one)",
        "receiver = isorecv(padded, header, low, hasFrame)",
        "received <- receiver"
      ],
      "naive": [
        "zero = const[value=0]()",
        "one = const[value=1]()",
        "eight = const[value=8]()",
        "flowCode = const[value=48]()",
        "flowHead = byteAt(flow, zero)",
        "isContinue = compare[form=eq](flowHead, flowCode)",
        "grant = select(arrived, isContinue, zero)",
        "sender = isosender(message, flow, grant)",
        "frame <- sender",
        "received <- message"
      ]
    }
