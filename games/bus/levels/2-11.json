{
  "title": { "zh": "发一整帧" },
  "intro": [
    {
      "t": {
        "zh": "把起始位、11 位标识符、控制位、4 位数据长度、数据和 15 位 CRC 依次送上总线。填充适用于起始到 CRC 的原始位；之后发送 CRC 界定位、应答位、应答界定位、帧结束和帧间隔。"
      }
    },
    { "t": { "zh": "本关的标识符和长度在整帧期间保持不变；数据由队列逐字节提供，队首标志指出最后一个字节。发送方在应答位放开总线，其他节点可以拉低它。" } }
  ],
  "builds": {
    "type": "transmitter",
    "name": { "zh": "发送帧" },
    "desc": { "zh": "发送一帧标准格式数据帧：标识符与长度需保持到发送完成，数据按队列提供。输出逐拍驱动、取走字节和完成；当前不处理仲裁失败或重传。" }
  },
  "after": { "zh": "发送方在应答位不拉低总线；有没有其他节点应答，要在听的阶段读回实际总线。" },
  "tasks": [
    {
      "id": "2-11",
      "brief": { "zh": "「开始」时发送一帧标准格式数据帧。按协议驱动总线、在每个数据字节最后一个原始位被取走时取走队首，并在最后一个帧间隔位发送的拍让「完成」为是。空闲时说 1。" },
      "hint": [
        { "zh": "分阶段生成原始位：起始、标识符、三个控制位、长度、数据、CRC；用逐位送字段和队列握手复用同一发送链。" },
        { "zh": "CRC 只收起始到数据末尾被取走的原始位。数据最后一位被取走时保存它，随后按 15 位发出去。零字节时在长度末尾保存。" },
        { "zh": "CRC 的最后一位可能还欠一个填充位；先发完它，再按实际拍数发送界定、应答、帧结束和帧间隔。" }
      ],
      "drives": true,
      "inputs": [
        { "name": "id", "label": { "zh": "标识符" } },
        { "name": "length", "label": { "zh": "数据长度" } },
        { "name": "item", "label": { "zh": "队首" } },
        { "name": "available", "label": { "zh": "有字节" } },
        { "name": "last", "label": { "zh": "最后字节" } },
        { "name": "start", "label": { "zh": "开始" } }
      ],
      "outputs": [{ "name": "next", "label": { "zh": "取走" } }, { "name": "done", "label": { "zh": "完成" } }],
      "pulls": { "input": "item", "available": "available", "last": "last", "next": "next" },
