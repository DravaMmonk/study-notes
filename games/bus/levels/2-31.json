{
  "title": { "zh": "恢复上线" },
  "intro": [{ "t": { "zh": "恢复条件和请求都满足后，节点才能重置两个错误计数并回到主动状态。为了让每拍的先后清楚，本关在接受请求的下一拍执行复位。" } }],
  "after": { "zh": "下线时仍可监听总线，但不能影响总线。恢复条件、软件请求和计数清零需要按顺序连接。" },
  "tasks": [
    {
      "id": "2-31",
      "brief": {
        "zh": "按事件更新发送计数、接收计数和状态。下线后从下一拍开始观察输入位；累计 128 组十一位隐性且收到恢复请求时接受请求，并在下一拍清零两项计数、回到主动状态。初始信号用于开始练习。"
      },
      "hint": [{ "zh": "把上一拍的状态接给下线恢复观察元件；请求获准后用寄存卡保存，下一拍复位错误计数元件。" }],
      "inputs": [
        { "name": "event", "label": { "zh": "事件" } },
        { "name": "init", "label": { "zh": "初始化" } },
        { "name": "bit", "label": { "zh": "位" } },
        { "name": "request", "label": { "zh": "恢复请求" } }
      ],
      "outputs": [
        { "name": "tx", "label": { "zh": "发送计数" } },
        { "name": "rx", "label": { "zh": "接收计数" } },
        { "name": "mode", "label": { "zh": "状态" } },
        { "name": "accepted", "label": { "zh": "允许复位" } }
      ],
      "tests": [
        {
          "bus": { "idle": 1444, "frames": [], "tail": 0 },
          "lineInputs": ["bit"],
          "pulses": { "init": [0], "request": [100, 1438, 1439] },
          "peerLow": [],
          "runs": { "event": [{ "value": 1, "ticks": 32 }, { "value": 0, "ticks": 1412 }] }
        },
        {
          "bus": { "idle": 1448, "frames": [], "tail": 0 },
          "lineInputs": ["bit"],
          "pulses": { "init": [0], "request": [1439, 1442] },
          "peerLow": [100],
          "runs": { "event": [{ "value": 1, "ticks": 32 }, { "value": 0, "ticks": 1416 }] }
        }
      ],
      "hidden": [
        {
          "bus": { "idle": 1452, "frames": [], "tail": 0 },
          "lineInputs": ["bit"],
          "pulses": { "init": [0], "request": [1444, 1445] },
          "peerLow": [],
          "runs": {
            "event": [{ "value": 3, "ticks": 6 }, { "value": 1, "ticks": 32 }, { "value": 0, "ticks": 1414 }]
          }
        },
        {
          "bus": { "idle": 100, "frames": [], "tail": 0 },
          "lineInputs": ["bit"],
          "pulses": { "init": [0], "request": [40, 90] },
          "peerLow": [],
          "runs": { "event": [{ "value": 1, "ticks": 10 }, { "value": 0, "ticks": 90 }] }
        }
      ],
      "want": {
        "tx": {
          "recoveryControllerTx": { "event": "event", "init": "init", "bit": "bit", "request": "request" }
        },
        "rx": {
          "recoveryControllerRx": { "event": "event", "init": "init", "bit": "bit", "request": "request" }
        },
        "mode": {
          "recoveryControllerMode": { "event": "event", "init": "init", "bit": "bit", "request": "request" }
        },
        "accepted": {
          "recoveryControllerAccepted": { "event": "event", "init": "init", "bit": "bit", "request": "request" }
        }
      },
      "solution": [
        "zero = const[value=0]()",
        "one = const[value=1]()",
        "two = const[value=2]()",
        "false = compare[form=eq](zero, one)",
        "oldmode = reg[reg=A, start=0]()",
        "off = compare[form=eq](oldmode, two)",
        "watch = recovery(bit, off)",
        "acceptedValue = select(request, watch.ready, false)",
        "pending = reg[reg=B, start=0]()",
        "reset = select(init, one, pending)",
        "p = faultcounter(event, reset)",
        "ka = keep[reg=A](p.mode)",
        "kb = keep[reg=B](acceptedValue)",
        "tx <- p.tx",
        "rx <- p.rx",
        "mode <- p.mode",
        "accepted <- acceptedValue"
      ],
      "naive": [
        "zero = const[value=0]()",
        "one = const[value=1]()",
        "two = const[value=2]()",
        "false = compare[form=eq](zero, one)",
        "oldmode = reg[reg=A, start=0]()",
        "off = compare[form=eq](oldmode, two)",
        "watch = recovery(bit, off)",
        "acceptedValue = select(request, watch.ready, false)",
        "pending = reg[reg=B, start=0]()",
        "reset = select(init, one, zero)",
        "p = faultcounter(event, reset)",
        "ka = keep[reg=A](p.mode)",
        "kb = keep[reg=B](acceptedValue)",
        "tx <- p.tx",
        "rx <- p.rx",
        "mode <- p.mode",
        "accepted <- acceptedValue"
      ]
    }
  ]
}
