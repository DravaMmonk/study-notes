      "solution": [
        "zero = const[value=0]()",
        "one = const[value=1]()",
        "ten = const[value=10]()",
        "quiet = counter(bit)",
        "long = compare[form=lt](ten, quiet)",
        "low = compare[form=eq](bit, zero)",
        "sof = select(long, low, zero)",
        "p = sniffer(bit)",
        "r = reg[reg=A, start=0]()",
        "inc = arith[form=inc](r)",
        "next = select(sof, inc, r)",
        "k = keep[reg=A](next)",
        "c = select(sof, next)",
        "index <- c",
        "ok <- p.ok"
      ],
      "naive": [
        "zero = const[value=0]()",
