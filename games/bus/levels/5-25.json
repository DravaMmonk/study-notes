      "solution": [
        "p = controller(line, id, length, item, available, last, start, prep, reset, request)",
        "send <- p.send",
        "next <- p.next",
        "rewind <- p.rewind",
        "attempt <- p.attempt",
        "done <- p.done",
        "tec <- p.tec",
        "error <- p.error",
        "mode <- p.mode",
        "rx <- p.rx",
        "kind <- p.kind",
        "ready <- p.ready",
        "accepted <- p.accepted",
        "lost <- p.lost",
        "rxId <- p.rxId",
        "rxLength <- p.rxLength",
        "rxByte <- p.rxByte",
        "storedId = reg[reg=A]()",
        "storedLength = reg[reg=B]()",
        "storedBytes = reg[reg=C]()",
        "hasId = present(p.rxId)",
        "hasLength = present(p.rxLength)",
        "hasByte = present(p.rxByte)",
        "hasBuffer = present(storedBytes)",
        "empty = emptyBytes()",
        "oldBuffer = select(hasBuffer, storedBytes, empty)",
        "base = select(hasId, empty, oldBuffer)",
        "oneByte = byteList(p.rxByte)",
        "appended = concatBytes(base, oneByte)",
        "nextBytes = select(hasByte, appended, base)",
        "nextId = select(hasId, p.rxId, storedId)",
        "nextLength = select(hasLength, p.rxLength, storedLength)",
        "saveId = keep[reg=A](nextId)",
        "saveLength = keep[reg=B](nextLength)",
        "saveBytes = keep[reg=C](nextBytes)",
        "c0 = const[value=0]()",
        "c1 = const[value=1]()",
        "c2 = const[value=2]()",
        "c3 = const[value=3]()",
        "c4 = const[value=4]()",
        "c5 = const[value=5]()",
        "c98 = const[value=98]()",
        "c144 = const[value=144]()",
        "c241 = const[value=241]()",
        "c2024 = const[value=2024]()",
        "falseValue = compare[form=eq](c0, c1)",
        "validKind = compare[form=eq](p.kind, c0)",
        "readyValid = select(p.ready, validKind, falseValue)",
        "target = compare[form=eq](storedId, c2024)",
        "correctLength = compare[form=eq](storedLength, c5)",
        "lengthByte = byteAt(storedBytes, c0)",
        "service = byteAt(storedBytes, c1)",
        "didHigh = byteAt(storedBytes, c2)",
        "didLow = byteAt(storedBytes, c3)",
        "lengthOK = compare[form=eq](lengthByte, c4)",
        "serviceOK = compare[form=eq](service, c98)",
        "highOK = compare[form=eq](didHigh, c241)",
        "lowOK = compare[form=eq](didLow, c144)",
        "didOK = select(highOK, lowOK, falseValue)",
        "headerOK = select(serviceOK, didOK, falseValue)",
        "formatOK = select(lengthOK, headerOK, falseValue)",
        "lengthAndFormat = select(correctLength, formatOK, falseValue)",
        "targetAndFormat = select(target, lengthAndFormat, falseValue)",
        "eligible = select(readyValid, targetAndFormat, falseValue)",
        "message = sliceBytes(storedBytes, c1, c4)",
        "recordNow = select(eligible, message)",
        "record <- recordNow"
      ]
    }
