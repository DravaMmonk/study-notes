{
  "topic": {
    "zh": "计算机网络：从一根会出错的线搭到今天的互联网"
  },
  "learner": {
    "zh": "不假设任何 IT 基础：比特、二进制数、「协议」这个词都在游戏里从头讲起。"
  },
  "endpoint": {
    "zh": "在模拟世界里打开一个网页，跑的全是自己搭的东西：网卡、交换机、路由器、路由协议、可靠传输、拥塞控制、解析器、HTTP、TLS、QUIC，并能看清每一层在每一拍做了什么。"
  },
  "scope": {
    "zh": "这份蓝图只写第 1 代「一根线」：两头之间一根逐拍送位、会翻位的线，从传一位走到一块能装到线两头的网卡。第 0 代（纸笔）的内容并进第 1 代用得着它的关，或推迟到用得着它的那一代；第 2–11 代只记一句，留待后续。"
  },
  "sources": ["games/network/DESIGN.md", "games/DESIGN.md"],
  "mechanisms": [
    {
      "id": "tick-bus",
      "where": { "zh": "第 1 代的每一关" },
      "why": {
        "zh": "这一代的内容全是时间里的事：位一拍一拍地到，晚到，要数拍、记住前几拍、在一串位里找开头。板每拍跑一遍，寄存卡跨拍保存，正好就是真实网卡里的移位寄存器和计数器。"
      }
    }
  ],
  "abilities": [
    {
      "id": "wire",
      "about": {
        "zh": "节点接在点对点的线上：每根线从一头把位逐拍送到另一头，过若干拍才到；没人说话时线上是 0。板上每根进来的线一个「线」元件，每根出去的线一个「说」元件。"
      }
    }
  ],
  "machines": [
    {
      "id": "one-wire",
      "title": { "zh": "一根线" },
      "can": ["wire"],
      "lacks": {
        "zh": "线只有两头，一拍只送一位：第三个人没有地方接，整帧也只能一位一位地走，两块网卡之间也存不下一整帧来转发。第 2 代把线换成大家都挂在上面的总线，线两头装上网卡，一拍送一段。"
      }
    }
  ],
  "primitives": [
    {
      "part": "select",
      "about": {
        "zh": "选择：条件为是取一路，否则取另一路。"
      },
      "why": {
        "zh": "传话的板只有线和说；没有任何元件能按条件改变一个值，选择是所有逻辑的起点。"
      }
    },
    {
      "part": "const",
      "about": { "zh": "常数：给出设定的数。" },
      "why": {
        "zh": "线上和输入只给出变化的值；要说一个固定的 0 或 1，只能由常数给出。"
      }
    },
    {
      "part": "reg",
      "about": {
        "zh": "读寄存卡：同名寄存卡里存的值，存入之前给初值。"
      },
      "why": {
        "zh": "板每拍从头算；跨拍的状态只能由寄存卡这一对元件保存，任何组合都接不出来。"
      }
    },
    {
      "part": "keep",
      "about": {
        "zh": "存寄存卡：把接入的值存进同名寄存卡，下一拍读得出。"
      },
      "why": {
        "zh": "同上：它和读寄存卡是一对，写入跨拍的状态。"
      }
    },
    {
      "part": "add",
      "about": {
        "zh": "相加：两个数之和（加一就是加上常数 1）。"
      },
      "why": {
        "zh": "手上的元件只能选、只能存，不能让一个数变大；数拍、把收到的位拼成数都要它。"
      }
    },
    {
      "part": "equal",
      "about": { "zh": "相等：两个数相等为是，否则为否。" },
      "why": {
        "zh": "它来的那一关手上只有选择、常数、寄存卡和相加，没有一样能把一个数拆开，两个数是否相同无从比较。取位到 1-7 才来；那以后虽然能用 16 张取位、8 个异或和 7 个或接出 8 位的相等，可在那之前的每一次比较都已经离不开它，那样重搭一遍只是拼装，没有新想法。"
      }
    },
    {
      "part": "bit",
      "about": {
        "zh": "取位：一个 8 位数从最高位数起的第 i 位。"
      },
      "why": {
        "zh": "加法和相等只能把数变大、比是否相同，不能从一个数里取出某一位；发送一个字节必须一位一位地取。"
      }
    }
  ],
  "built": [
    {
      "part": "counter",
      "about": {
        "zh": "计数器：自「重来」上一次为 1 起过了几拍（那一拍为 0）。"
      },
      "from": ["reg", "keep", "add", "const", "select", "counting"]
    },
    {
      "part": "serializer",
      "about": {
        "zh": "移位发送：从「开始」那一拍起，用 8 拍把那一拍的字节从最高位起逐位说出，送完时报一声。"
      },
      "from": ["counter", "bit", "equal", "select", "binary"]
    },
    {
      "part": "deserializer",
      "about": {
        "zh": "按字节收：从「开始」那一拍起收进线上的 8 位，收满的那一拍给出这个字节。"
      },
      "from": ["counter", "add", "equal", "select", "reg", "keep", "binary"]
    },
    {
      "part": "flagspot",
      "about": {
        "zh": "认旗标：最近收到的 8 位正好是 01111110 的那一拍为 1。"
      },
      "from": ["counter", "equal", "select", "reg", "keep", "flag"]
    },
    {
      "part": "counterhold",
      "about": {
        "zh": "能停的计数器：同计数器，只是「暂停」为 1 的拍不算，计数停在原处；它取代计数器。"
      },
      "from": ["reg", "keep", "add", "const", "select", "counting", "stall"]
    },
    {
      "part": "serializerhold",
      "about": {
        "zh": "能停的移位发送：同移位发送，只是「暂停」为 1 的拍字节停住，该说的那一位留到下一拍；它取代移位发送。"
      },
      "from": ["counterhold", "bit", "equal", "select", "binary", "stall"]
    },
    {
      "part": "framer",
      "about": {
        "zh": "成帧器：从交来的字节里取出一帧送出，前后加旗标，内容里做位填充。"
      },
      "from": ["serializerhold", "counterhold", "equal", "select", "flag", "stuffing"]
    },
    {
      "part": "deserializerhold",
      "about": {
        "zh": "能停的按字节收：同按字节收，只是「暂停」为 1 的拍那一位不收；它取代按字节收。"
      },
      "from": ["counterhold", "add", "equal", "select", "reg", "keep", "binary", "stall"]
    },
    {
      "part": "deframer",
      "about": {
        "zh": "拆帧器：在位流里认出旗标之间的帧，去掉填充的 0，逐个给出内容字节，帧结束时报一声。"
      },
      "from": ["deserializerhold", "flagspot", "counterhold", "equal", "select", "flag", "stuffing"]
    },
    {
      "part": "xor",
      "about": { "zh": "异或：两位不同为 1，相同为 0。" },
      "from": ["select", "const", "choice", "error-detection"]
    },
    {
      "part": "crc",
      "about": {
        "zh": "CRC：到这一拍为止收进的位该跟的校验码（补上 0 后不进位地除以 1011 的余数）；能清零重来。"
      },
      "from": ["xor", "reg", "keep", "select", "poly-division"]
    },
    {
      "part": "crchold",
      "about": {
        "zh": "能停的 CRC：同 CRC，只是「暂停」为 1 的拍那一位不收进去；它取代 CRC。"
      },
      "from": ["xor", "reg", "keep", "select", "poly-division", "stall"]
    },
    {
      "part": "receiver",
      "about": {
        "zh": "收帧器：从线上拆出每一帧，交出内容字节，扣下最后的校验字节和它核对，帧尾说出是否完好。"
      },
      "from": ["deframer", "crchold", "serializerhold", "reg", "keep", "equal", "select", "error-detection"]
    },
    {
      "part": "sender",
      "about": {
        "zh": "发帧器：从交来的字节里取出一帧，边送边算校验码，内容后面跟上校验字节，前后加旗标、做位填充送出。"
      },
      "from": ["framer", "crchold", "serializerhold", "select", "equal", "error-detection"]
    },
    {
      "part": "nic",
      "about": {
        "zh": "网卡：上面交来的帧带上校验字节成帧送到线上；线上收到的帧拆开、核对，逐个字节交给上面，帧尾报好坏。"
      },
      "from": ["sender", "receiver", "layer"]
    }
  ],
