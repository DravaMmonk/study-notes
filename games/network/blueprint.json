      }
    }
  ],
  "knowledge": [
    {
      "id": "tick",
      "about": {
        "zh": "世界按拍推进：每一拍，板读一次进来的线，说一次出去的线；一根线一拍只送一位。"
      },
      "wall": { "zh": "起点：没有它，线上什么也不会发生。" }
    },
    {
      "id": "choice",
      "about": {
        "zh": "按一个条件在两路之间选一路：非、与、或都由选择接出。"
      },
      "wall": {
        "zh": "传话的板只能原样照搬，要把一位反过来、或按另一根线决定说什么，就做不到。"
      }
    },
    {
      "id": "memory",
      "about": { "zh": "寄存卡把一个值留到下一拍。" },
      "wall": {
        "zh": "板每拍从头算，算完什么也不留：「说出上一拍听到的」这样的规格无从满足。"
      }
    },
    {
      "id": "counting",
      "about": {
        "zh": "寄存卡加上加法就是数拍的计数器，能清零重来。"
      },
      "wall": {
        "zh": "要知道这一拍该发一个字节的第几位、已经收了几位，就得知道过了几拍；只记一拍的寄存卡不够。"
      }
    },
    {
      "id": "compare",
      "about": {
        "zh": "相等把一个数变成是或否：计数器数到几，选择就能据此行事。"
      },
      "wall": {
        "zh": "计数器给出的是数，选择要的是是或否：「每到第 8 拍说一次 1」无从判断。"
      }
    },
    {
      "id": "binary",
      "about": {
        "zh": "一个字节是 8 位二进制数，每一位的分量是后一位的两倍：从高位起逐位说出，收的一方每收一位就把已有的数翻倍再加上它。"
      },
      "wall": {
        "zh": "一根线一拍只能送一位，要送的却是 0 到 255 的数：数得先拆成位，到了再拼回去。"
      }
    },
    {
      "id": "start-bit",
      "about": {
        "zh": "线空着时是 0；发送方先说一个 1（起始位）宣布字节开始，每个字节后跟一个 0（停止位）。"
      },
      "wall": {
        "zh": "发送方随时可能开口，以 0 开头的字节和空着的线分不出来：收的一方不知道从哪一拍开始数。"
      }
    },
    {
      "id": "flag",
      "about": {
        "zh": "旗标 01111110 标出一帧的开头和结尾，收的一方在任何时候都能从位流里认出它。"
      },
      "wall": {
        "zh": "一帧有几个字节事先不知道：起始位分得出一个个字节，分不出哪几个字节是一帧。"
      }
    },
    {
      "id": "stall",
      "about": {
        "zh": "停一拍：「暂停」为 1 的拍，计数和手上的字节都停在原处，下一拍接着走。"
      },
      "wall": {
        "zh": "内容里有 01111110 时帧被从中间切断；要在内容里多塞一位把它拆开，别的都得等一拍，可计数器每拍都往前走，正在发的字节也跟着走了一位。"
      }
    },
    {
      "id": "stuffing",
      "about": {
        "zh": "位填充：帧的内容里每连着 5 个 1，发送方就多说一个 0，收的一方再把它去掉，内容里就不会出现旗标。多说的那一拍，内容停一拍不走。"
      },
      "wall": {
        "zh": "内容里本身就有 01111110 时，收的一方把它当成旗标，一帧被从中间切断。"
      }
    },
    {
      "id": "error-detection",
      "about": {
        "zh": "发送方按约好的规则多送几位（最笨的办法是整份再送一遍），收的一方按同一规则核对，就知道数据在线上有没有被改。"
      },
      "wall": {
        "zh": "线开始翻位以后，收到的位错了，收的一方却毫不知情，照样交出去。"
      }
    },
    {
      "id": "poly-division",
      "about": {
        "zh": "把一串位当作一个大数，后面补上几个 0，用不进位的除法（每一步是异或）除以约好的生成式，余数就是校验码；逐拍做时，寄存卡里的几位就是到这一拍为止该跟的校验码（CRC）。"
      },
      "wall": {
        "zh": "奇偶校验位只查得出奇数个错位：恰好翻两位时，校验照样相符。"
      }
    },
    {
      "id": "layer",
      "about": {
        "zh": "分层：网卡对上面只收发整帧的字节，对下面只收发位；上面不必知道旗标、填充和校验字节。"
      },
      "wall": {
        "zh": "发帧、收帧、查错分在几块板上，每一个要用线的节点都得把它们重新接一遍。"
      }
    }
  ]
}
