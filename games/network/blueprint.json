  "deferred": [
    {
      "about": { "zh": "第 0 代「纸笔」的四关手做关" },
      "why": {
        "zh": "逐拍总线领域和盲玩 harness 都不支持手动关。两种状态并进 1-1，二进制数并进逐位发送和接收；字符对照表推迟到第 9 代的文本协议，那里第一次非它不可；长度前缀推迟到第 5 代的字节流分帧，理由同上。"
      }
    },
    {
      "about": {
        "zh": "设计稿里的机关台「晚到」（传播时间和发送时间）"
      },
      "why": {
        "zh": "这一代一拍送一位，发送时间还不是一回事，晚到在 1-1 的时序图里就看得见；它放到第 2 代整帧占线若干拍时。参数台盲玩也还不支持。"
      }
    },
    {
      "about": {
        "zh": "设计稿的挑战「数据里正好有旗标」和网卡系列的前三关"
      },
      "why": {
        "zh": "内容里出现旗标正是位填充撞上的墙，做成挑战就成了新机制；送一句话、送几句话、线会出错只是重做前面的关，没有新维度，网卡一关直接站在已搭出的元件上。"
      }
    },
    {
      "about": {
        "zh": "8 位生成式（校验码本身就是一个字节）和「改回来」的纠错挑战"
      },
      "why": {
        "zh": "8 位的 CRC 要 8 张寄存卡，一块板只有 6 张；拿整字节的算术去凑，教的就不再是除法。所以生成式留在 1-15 搭出的 1011，校验码补成一个整字节送出（请求 check-byte）。纠错要把 7 位的块拼回 4 位数据，又和 8 位一收的按字节收对不上，难在拼凑；挑战改成找出翻的是哪一位，那个跳跃（余数认得出位置）原样保留，真正的纠错留到能存下一整块的第 2 代。"
      }
    },
    {
      "about": {
        "zh": "上一版的「接力」：两块网卡之间逐字节转发，坏帧送出去也不能是好的"
      },
      "why": {
        "zh": "一关里有三件新事：不等整帧收完就转发、在两种步调之间存下几个字节、把坏帧的校验弄坏再送出。在两块网卡之间存字节正是请求 card-ports 推给第 2 代的事，转发帧也正是第 2 代交换机的事，在那里和队列一起讲。第 1 代改由「回一声」用上网卡。"
      }
    },
    {
      "about": { "zh": "第 2 代 · 局域网" },
      "why": {
        "zh": "总线、地址、撞车与退避、交换机（转发帧在这里）、生成树；要整帧的线和网卡收进线里，等第 1 代上线后再写。"
      }
    },
    {
      "about": { "zh": "第 3 代 · 网际" },
      "why": {
        "zh": "分层地址、路由器、报头校验（重复框）、最长前缀、ARP、TTL；要重复框，后续再写。"
      }
    },
    {
      "about": { "zh": "第 4 代 · 自己算路" },
      "why": {
        "zh": "距离向量和链路状态两路并行，再到路径向量；建在第 3 代的路由器上。"
      }
    },
    {
      "about": { "zh": "第 5 代 · 端到端" },
      "why": {
        "zh": "端口、停等、滑动窗口、RTT 估计、握手、字节流分帧（长度前缀在这里）；兑现第 1 代「只查不补」和「回一声」。"
      }
    },
    {
      "about": { "zh": "第 6 代 · 拥挤" },
      "why": {
        "zh": "AIMD、拥塞窗口、慢启动、快重传、队列管理；要曲线视图和代价度量。"
      }
    },
    {
      "about": { "zh": "第 7 代 · 地址" },
      "why": {
        "zh": "DHCP、NAT，可选的 IPv6；建在第 3、5 代上。"
      }
    },
    {
      "about": { "zh": "第 8 代 · 名字" },
      "why": {
        "zh": "分层的名字、逐步解析、缓存与否定缓存，搭出解析器；建在第 5 代上。"
      }
    },
    {
      "about": { "zh": "第 9 代 · 网页" },
      "why": {
        "zh": "文本请求与响应（字符表在这里）、长度与分块、持久连接、Cookie、缓存；建在第 5、8 代上。"
      }
    },
    {
      "about": { "zh": "第 10 代 · 保密" },
      "why": {
        "zh": "一次一密、Diffie–Hellman（模幂）、签名、证书、消息认证、TLS；要乘法与取模。"
      }
    },
    {
      "about": { "zh": "第 11 代 · 现代" },
