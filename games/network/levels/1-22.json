{
  "title": { "zh": "连着几个 1", "en": "Ones in a row" },
  "intro": [
    {
      "t": {
        "zh": "<part-ref to=\"counter\"></part-ref>数的是过了几拍。这一次要数的是线上连着来的 1。",
        "en": "<part-ref to=\"counter\"></part-ref> counts the ticks that pass. This time what must be counted is the 1s in a row on the wire."
      }
    }
  ],
  "tasks": [
    {
      "brief": {
        "zh": "每一拍输出线上已经连着来了几个 1；来的是 0 的那一拍输出 0。",
        "en": "Every tick, output how many 1s in a row have come down the wire; output 0 on a tick a 0 arrives."
      },
      "hint": [{ "zh": "什么时候该从 0 数起？", "en": "When should the count start again from 0?" }],
      "wires": { "in": [{ "name": "line", "label": { "zh": "进线", "en": "Wire in" }, "delay": 1 }] },
      "outputs": [{ "name": "run", "label": { "zh": "连着的 1", "en": "Ones in a row" } }],
      "tests": [
        {
          "wires": { "line": { "send": [{ "bits": "0110111" }] } },
          "expect": { "run": [0, 0, 1, 2, 0, 1, 2, 3, 0, 0] }
        },
        {
          "wires": { "line": { "send": [{ "bits": "11111111" }] } },
          "expect": { "run": [0, 1, 2, 3, 4, 5, 6, 7, 8, 0, 0] }
        },
        { "wires": { "line": { "send": [{ "bits": "0000" }] } }, "expect": { "run": [0, 0, 0, 0, 0, 0, 0] } }
      ],
      "hidden": [
        {
          "wires": { "line": { "send": [{ "bits": "1010101" }] } },
          "expect": { "run": [0, 1, 0, 1, 0, 1, 0, 1, 0, 0] }
        },
        {
          "wires": { "line": { "send": [{ "bits": "111001111" }] } },
          "expect": { "run": [0, 1, 2, 3, 0, 0, 1, 2, 3, 4, 0, 0] }
        }
      ],
      "want": { "run": "given" },
      "solution": [
        "z = const[value=0]()",
        "o = const[value=1]()",
        "nl = select(line, z, o)",
        "c = counter(nl)",
        "run <- c"
      ],
      "naive": ["r = reg[reg=A, start=0]()", "n = add(r, line)", "k = keep[reg=A](n)", "run <- n"]
    }
  ]
}
