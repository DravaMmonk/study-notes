  "want": {
    "byte": { "bytes": { "wire": "line", "format": "flagbyte" } },
    "got": "given",
    "end": "given",
    "ok": { "ends": { "wire": "line", "format": "flagbyte" } }
  },
  "solution": [
    "z = const[value=0]()",
    "o = const[value=1]()",
    "df = deframer(line)",
    "hr = reg[reg=A, start=0]()",
    "vr = reg[reg=B, start=0]()",
    "rl = select(df.got, vr, z)",
    "nh = select(df.got, df.byte, hr)",
    "kh = keep[reg=A](nh)",
    "nv0 = select(df.got, o, vr)",
    "nv = select(df.end, z, nv0)",
    "kv = keep[reg=B](nv)",
    "s = serializerhold(hr, rl, z)",
    "ar = reg[reg=C, start=0]()",
    "act = select(rl, o, ar)",
    "na = select(s.done, z, act)",
    "ka = keep[reg=C](na)",
    "nvr = select(vr, z, o)",
    "fst = select(df.got, nvr, z)",
    "hl = select(act, z, o)",
    "k = crchold(s.line, fst, hl)",
    "eq = equal(hr, k)",
    "okv = select(df.end, eq)",
    "y = select(rl, hr)",
    "byte <- y",
    "got <- rl",
    "end <- df.end",
    "ok <- okv"
  ],
  "naive": [
    "z = const[value=0]()",
    "o = const[value=1]()",
    "df = deframer(line)",
    "hr = reg[reg=A, start=0]()",
    "vr = reg[reg=B, start=0]()",
    "rl = select(df.got, vr, z)",
    "nh = select(df.got, df.byte, hr)",
    "kh = keep[reg=A](nh)",
    "nv0 = select(df.got, o, vr)",
    "nv = select(df.end, z, nv0)",
    "kv = keep[reg=B](nv)",
    "s = serializerhold(hr, rl, z)",
    "ar = reg[reg=C, start=0]()",
    "act = select(rl, o, ar)",
    "na = select(s.done, z, act)",
    "ka = keep[reg=C](na)",
    "nvr = select(vr, z, o)",
    "fst = select(df.got, nvr, z)",
    "hl = select(act, z, o)",
    "k = crchold(s.line, fst, hl)",
    "eq = equal(hr, k)",
    "okv = select(df.end, eq)",
    "y = select(df.got, df.byte)",
    "byte <- y",
    "got <- df.got",
    "end <- df.end",
    "ok <- okv"
  ],
  "builds": {
    "type": "receiver",
    "name": { "zh": "收帧器", "en": "Receiver" },
    "desc": {
      "zh": "从进线上拆出每一帧，扣下最后的校验字节：每个内容字节在它后面那个字节收全的那一拍给出，「收到」为 1；结尾旗标收完的那一拍「帧尾」为 1，「完好」说出这一帧是否完好。其余各拍字节和「完好」是「—」，「收到」「帧尾」为 0。",
      "en": "Unwraps each frame off its wire in and holds back the closing check byte: gives each content byte on the tick the byte after it is complete, with got 1; on the tick the closing flag is complete, end is 1 and intact says whether the frame arrived intact. On every other tick the byte and intact are 「—」, got and end 0."
    }
  }
