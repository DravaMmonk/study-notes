      "want": {
        "byte": { "bytes": { "wire": "line", "format": "flagbyte" } },
        "got": "given",
        "end": "given",
        "ok": { "ends": { "wire": "line", "format": "flagbyte" } }
      },
      "solution": [
        "z = const[value=0]()",
        "o = const[value=1]()",
        "df = deframer(line)",
        "hr = reg[reg=A, start=0]()",
        "vr = reg[reg=B, start=0]()",
        "rl = select(df.got, vr, z)",
        "nh = select(df.got, df.byte, hr)",
        "kh = keep[reg=A](nh)",
        "nv0 = select(df.got, o, vr)",
        "nv = select(df.end, z, nv0)",
        "kv = keep[reg=B](nv)",
        "s = serializerhold(hr, rl, z)",
        "ar = reg[reg=C, start=0]()",
        "act = select(rl, o, ar)",
        "na = select(s.done, z, act)",
        "ka = keep[reg=C](na)",
        "nvr = select(vr, z, o)",
        "fst = select(df.got, nvr, z)",
        "hl = select(act, z, o)",
        "k = crchold(s.line, fst, hl)",
        "eq = equal(hr, k)",
        "okv = select(df.end, eq)",
        "y = select(rl, hr)",
        "byte <- y",
        "got <- rl",
        "end <- df.end",
        "ok <- okv"
      ],
      "naive": [
        "z = const[value=0]()",
        "o = const[value=1]()",
        "df = deframer(line)",
        "hr = reg[reg=A, start=0]()",
        "vr = reg[reg=B, start=0]()",
        "rl = select(df.got, vr, z)",
        "nh = select(df.got, df.byte, hr)",
        "kh = keep[reg=A](nh)",
        "nv0 = select(df.got, o, vr)",
        "nv = select(df.end, z, nv0)",
        "kv = keep[reg=B](nv)",
        "s = serializerhold(hr, rl, z)",
        "ar = reg[reg=C, start=0]()",
        "act = select(rl, o, ar)",
        "na = select(s.done, z, act)",
        "ka = keep[reg=C](na)",
        "nvr = select(vr, z, o)",
        "fst = select(df.got, nvr, z)",
        "hl = select(act, z, o)",
        "k = crchold(s.line, fst, hl)",
        "eq = equal(hr, k)",
        "okv = select(df.end, eq)",
        "y = select(df.got, df.byte)",
        "byte <- y",
        "got <- df.got",
