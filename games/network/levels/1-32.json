{
  "title": { "zh": "奇偶校验位" },
  "intro": [
    {
      "t": {
        "zh": "送两份要把线占去一倍。省得多的办法只附一位：让连它在内的 1 的个数凑成偶数，叫<wiki-ref to=\"parity\"></wiki-ref>。"
      }
    }
  ],
  "tasks": [
    {
      "id": "1-32",
      "brief": {
        "zh": "从第一拍起把交来的字节一个接一个送出，中间不留空：每个字节后面跟一个校验位，字节里有奇数个 1 时为 1。"
      },
      "hint": [
        {
          "zh": "1 的个数是奇是偶，可以一位一位地跟着记。"
        },
        { "zh": "一个字节连同校验位占 9 拍。" }
      ],
      "inputs": [{ "name": "byte", "label": { "zh": "队首" } }],
      "outputs": [{ "name": "next", "label": { "zh": "下一个" } }],
      "pulls": { "input": "byte", "next": "next" },
      "wires": { "out": [{ "name": "line", "label": { "zh": "出线" } }] },
      "tests": [
        { "ticks": 11, "queue": [[65]] },
        { "ticks": 20, "queue": [[1, 254]] },
        { "ticks": 5, "queue": [] }
      ],
      "hidden": [
        { "ticks": 29, "queue": [[7, 128, 170]] },
        { "ticks": 9, "queue": [[1]] },
        { "ticks": 22, "queue": [[255, 0]] }
      ],
      "want": { "line": { "sent": { "format": "parity" } } },
      "solution": [
        "z = const[value=0]()",
        "eight = const[value=8]()",
        "g = reg[reg=A, start=1]()",
        "c = counter(g)",
        "e8 = equal(c, eight)",
        "ka = keep[reg=A](e8)",
        "e0 = equal(c, z)",
        "s = serializer(byte, e0)",
        "pr = reg[reg=B, start=0]()",
        "base = select(e0, z, pr)",
        "x = xor(base, s.line)",
        "kb = keep[reg=B](x)",
        "l = select(e8, pr, s.line)",
        "line <- l",
        "next <- e0"
      ],
      "naive": [
        "z = const[value=0]()",
        "eight = const[value=8]()",
        "g = reg[reg=A, start=1]()",
        "c = counter(g)",
        "e8 = equal(c, eight)",
        "ka = keep[reg=A](e8)",
        "e0 = equal(c, z)",
        "s = serializer(byte, e0)",
        "pr = reg[reg=B, start=0]()",
        "x = xor(pr, s.line)",
        "kb = keep[reg=B](x)",
        "l = select(e8, pr, s.line)",
        "line <- l",
        "next <- e0"
      ]
    }
  ]
}
