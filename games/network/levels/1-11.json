{
  "title": { "zh": "认出旗标" },
  "intro": [
    {
      "t": {
        "zh": "要送的往往不止一个字节，而是一串字节合成的一<wiki-ref to=\"frame\"></wiki-ref>，有几个字节事先不知道。收的一方只看见不停到来的位，分不出一帧从哪里开始、到哪里结束。两头于是约好一个记号 01111110，叫<wiki-ref to=\"flag\"></wiki-ref>，放在每一帧的开头和结尾；收的一方要在位流里随时认出它。"
      }
    }
  ],
  "builds": {
    "type": "flagspot",
    "name": { "zh": "认旗标" },
    "desc": {
      "zh": "进线上最近收到的 8 位正好是 01111110 的那一拍为 1，其余各拍为 0。"
    }
  },
  "tasks": [
    {
      "id": "1-11",
      "brief": {
        "zh": "线上连续送来位；每当到这一拍为止最近 8 位是 01111110，就在那一拍输出 1，其余各拍输出 0。"
      },
      "hint": [
        { "zh": "旗标是一个 0，接着六个 1，再接一个 0。" },
        {
          "zh": "数一数到这一拍为止连着来了几个 1，来了 0 就从头数。"
        },
        {
          "zh": "那六个 1 前面必须真有一个 0：线一开始就来的 1 不算。"
        }
      ],
      "wires": { "in": [{ "name": "line", "label": { "zh": "进线" } }] },
      "outputs": [{ "name": "flag", "label": { "zh": "旗标" } }],
      "tests": [
        { "wires": { "line": { "send": [{ "bits": "01111110" }] } } },
        { "wires": { "line": { "send": [{ "bits": "011111101111110" }] } } },
        { "wires": { "line": { "send": [{ "bits": "0111111100111110" }] } } }
      ],
      "hidden": [
        { "wires": { "line": { "send": [{ "bits": "11111110" }] } } },
        { "wires": { "line": { "send": [{ "bits": "1001111110110" }] } } },
        { "wires": { "line": { "send": [{ "bits": "0000000" }] } } }
      ],
      "want": { "flag": { "pattern": { "wire": "line", "bits": "01111110" } } },
      "solution": [
        "z = const[value=0]()",
        "o = const[value=1]()",
        "six = const[value=6]()",
        "zr = equal(line, z)",
        "c = counter(zr)",
        "p = reg[reg=A, start=0]()",
        "kp = keep[reg=A](c)",
        "sr = reg[reg=B, start=0]()",
        "s = select(zr, o, sr)",
        "ks = keep[reg=B](s)",
        "e6 = equal(p, six)",
        "h = select(e6, sr, z)",
        "f = select(line, z, h)",
        "flag <- f"
      ],
      "naive": [
        "z = const[value=0]()",
        "o = const[value=1]()",
        "six = const[value=6]()",
        "zr = equal(line, z)",
        "c = counter(zr)",
        "p = reg[reg=A, start=0]()",
        "kp = keep[reg=A](c)",
        "e6 = equal(p, six)",
        "h = select(e6, o, z)",
        "f = select(line, z, h)",
        "flag <- f"
      ]
    }
  ]
}
