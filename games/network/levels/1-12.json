      "solution": [
        "z = const[value=0]()",
        "o = const[value=1]()",
        "sv = const[value=7]()",
        "fv = const[value=126]()",
        "g = reg[reg=A, start=1]()",
        "c = counter(g)",
        "e7 = equal(c, sv)",
        "ka = keep[reg=A](e7)",
        "e0 = equal(c, z)",
        "ro = reg[reg=B, start=0]()",
        "rm = reg[reg=C, start=0]()",
        "rk = reg[reg=D, start=0]()",
        "co = select(ro, send, z)",
        "ct = select(rm, o, co)",
        "cn = select(e0, ct, z)",
        "b = select(ct, byte, fv)",
        "s = serializer(b, e0)",
        "nk = select(rk, z, o)",
        "no = select(ct, z, nk)",
        "nl = select(last, z, o)",
        "nm = select(ct, nl, z)",
        "nkk = select(ct, last, z)",
        "o2 = select(e0, no, ro)",
        "m2 = select(e0, nm, rm)",
        "k2 = select(e0, nkk, rk)",
        "kb = keep[reg=B](o2)",
        "kc = keep[reg=C](m2)",
        "kd = keep[reg=D](k2)",
        "line <- s.line",
        "next <- cn"
      ],
