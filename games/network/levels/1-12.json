  "solution": [
    "z = const[value=0]()",
    "o = const[value=1]()",
    "five = const[value=5]()",
    "seven = const[value=7]()",
    "fv = const[value=126]()",
    "ir = reg[reg=A, start=1]()",
    "kr = reg[reg=B, start=0]()",
    "fr = reg[reg=C, start=0]()",
    "pr = reg[reg=D, start=0]()",
    "orr = reg[reg=E, start=0]()",
    "wr = reg[reg=F, start=0]()",
    "os = select(ir, send, z)",
    "busy = select(os, o, fr)",
    "sr = equal(orr, five)",
    "st = select(busy, z, sr)",
    "cs = select(st, z, kr)",
    "fs0 = select(os, o, cs)",
    "inf = select(fs0, o, fr)",
    "f = serializer(fv, fs0)",
    "w = select(fs0, cs, wr)",
    "kw = keep[reg=F](w)",
    "nf = select(f.done, z, inf)",
    "kf = keep[reg=C](nf)",
    "ni0 = select(f.done, w, ir)",
    "ni = select(os, z, ni0)",
    "ki = keep[reg=A](ni)",
    "nw = select(w, z, o)",
    "od = select(f.done, nw, z)",
    "cst = select(st, z, pr)",
    "cc = counter(cst, st)",
    "bv = bit(byte, cc)",
    "e7 = equal(cc, seven)",
    "d1 = select(ir, z, e7)",
    "d2 = select(st, z, d1)",
    "bd = select(inf, z, d2)",
    "ld = select(bd, last, z)",
    "nl = select(last, z, o)",
    "nk0 = select(cs, z, kr)",
    "nk = select(ld, o, nk0)",
    "kk = keep[reg=B](nk)",
    "np0 = select(cst, z, pr)",
    "np1 = select(bd, nl, np0)",
    "np = select(od, o, np1)",
    "kp = keep[reg=D](np)",
    "has = equal(byte, byte)",
    "gf = select(has, f.line)",
    "fo = select(w, f.line, gf)",
    "cb = select(st, z, bv)",
    "bo = select(inf, fo, cb)",
    "idl = select(os, z, ir)",
    "lv = select(idl, z, bo)",
    "zr = equal(lv, z)",
    "oc = counter(zr, z)",
    "ko = keep[reg=E](oc)",
    "line <- lv",
    "next <- bd"
  ],
