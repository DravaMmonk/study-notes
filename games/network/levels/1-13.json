  "want": { "byte": { "bytes": { "wire": "line", "format": "flag" } }, "got": "given", "end": "given" },
  "solution": [
    "z = const[value=0]()",
    "o = const[value=1]()",
    "five = const[value=5]()",
    "six = const[value=6]()",
    "zr = equal(line, z)",
    "c = counter(zr, z)",
    "pr = reg[reg=A, start=0]()",
    "kp = keep[reg=A](c)",
    "sr = reg[reg=B, start=0]()",
    "s = select(zr, o, sr)",
    "ks = keep[reg=B](s)",
    "e6 = equal(pr, six)",
    "h = select(e6, sr, z)",
    "f = select(line, z, h)",
    "hd = equal(pr, five)",
    "rr = reg[reg=C, start=0]()",
    "d = deserializer(line, rr, hd)",
    "nr = select(f, o, d.done)",
    "kr = keep[reg=C](nr)",
    "opr = reg[reg=D, start=0]()",
    "no = select(opr, z, o)",
    "nop = select(f, no, opr)",
    "ko = keep[reg=D](nop)",
    "y = select(opr, d.byte)",
    "g = select(opr, d.done, z)",
    "en = select(f, opr, z)",
    "byte <- y",
    "got <- g",
    "end <- en"
  ],
  "naive": [
    "z = const[value=0]()",
    "o = const[value=1]()",
    "six = const[value=6]()",
    "zr = equal(line, z)",
    "c = counter(zr, z)",
    "pr = reg[reg=A, start=0]()",
    "kp = keep[reg=A](c)",
    "sr = reg[reg=B, start=0]()",
    "s = select(zr, o, sr)",
    "ks = keep[reg=B](s)",
    "e6 = equal(pr, six)",
    "h = select(e6, sr, z)",
    "f = select(line, z, h)",
    "rr = reg[reg=C, start=0]()",
    "d = deserializer(line, rr, z)",
    "nr = select(f, o, d.done)",
    "kr = keep[reg=C](nr)",
    "opr = reg[reg=D, start=0]()",
    "no = select(opr, z, o)",
    "nop = select(f, no, opr)",
    "ko = keep[reg=D](nop)",
    "y = select(opr, d.byte)",
    "g = select(opr, d.done, z)",
    "en = select(f, opr, z)",
    "byte <- y",
    "got <- g",
    "end <- en"
  ],
  "builds": {
    "type": "deframer",
    "name": { "zh": "拆帧器", "en": "Deframer" },
    "desc": {
      "zh": "在进线的位流里认出旗标之间的每一帧，去掉塞进的 0：一个内容字节收全的那一拍给出它，「收到」为 1；结尾旗标收完的那一拍「帧尾」为 1；其余各拍字节是「—」，「收到」「帧尾」为 0。",
      "en": "Finds each frame between flags in the bits on its wire in and takes out the stuffed 0s: gives each content byte on the tick it is complete, with got 1, and makes end 1 on the tick the closing flag is complete; on every other tick the byte is 「—」 and got and end are 0."
    }
  }
