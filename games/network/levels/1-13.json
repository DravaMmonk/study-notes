      "want": { "byte": { "bytes": { "wire": "line", "format": "flag" } }, "got": "given", "end": "given" },
      "solution": [
        "z = const[value=0]()",
        "o = const[value=1]()",
        "f = flagspot(line)",
        "c = counter(f)",
        "e1 = equal(c, o)",
        "pr = reg[reg=A, start=0]()",
        "st = select(e1, o, pr)",
        "d = deserializer(line, st)",
        "kp = keep[reg=A](d.done)",
        "ro = reg[reg=B, start=0]()",
        "no = select(ro, z, o)",
        "o2 = select(f, no, ro)",
        "ko = keep[reg=B](o2)",
        "en = select(f, ro, z)",
        "g0 = select(ro, d.done, z)",
        "g = select(f, z, g0)",
        "y = select(g, d.byte)",
        "byte <- y",
        "got <- g",
        "end <- en"
      ],
      "naive": [
        "z = const[value=0]()",
        "o = const[value=1]()",
        "f = flagspot(line)",
        "c = counter(f)",
        "e1 = equal(c, o)",
        "pr = reg[reg=A, start=0]()",
        "st = select(e1, o, pr)",
        "d = deserializer(line, st)",
        "kp = keep[reg=A](d.done)",
        "ro = reg[reg=B, start=0]()",
        "no = select(ro, z, o)",
        "o2 = select(f, no, ro)",
        "ko = keep[reg=B](o2)",
        "en = select(f, ro, z)",
        "g = select(ro, d.done, z)",
        "y = select(g, d.byte)",
