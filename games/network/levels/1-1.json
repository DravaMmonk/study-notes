{
  "title": {
    "zh": "传话"
  },
  "intro": [
    {
      "t": {
        "zh": "两头之间只有一根线。线上分得出的只有两种状态，记作 0 和 1；两头对它们的约定，就是最初的<wiki-ref to=\"protocol\"></wiki-ref>。线每<wiki-ref to=\"tick\"></wiki-ref>送一<wiki-ref to=\"bit\"></wiki-ref>，从一头说出，过几拍才到另一头，中间隔的拍数叫<wiki-ref to=\"delay\"></wiki-ref>。这块板夹在两根线中间。"
      }
    }
  ],
  "tasks": [
    {
      "id": "1-1",
      "brief": {
        "zh": "每一拍把左线上听到的位说到右线上。"
      },
      "hint": [
        { "zh": "这一关不必放任何元件。" },
        {
          "zh": "从左线的输出口拉一根连线，接到右线上。"
        }
      ],
      "wires": {
        "in": [{ "name": "left", "label": { "zh": "左线" }, "delay": 2 }],
        "out": [{ "name": "right", "label": { "zh": "右线" } }]
      },
      "tests": [
        { "wires": { "left": { "send": [{ "bits": "1011001" }] } } },
        { "wires": { "left": { "send": [{ "bits": "0100111" }] } } }
      ],
      "hidden": [
        { "wires": { "left": { "send": [{ "bits": "1" }] } } },
        { "wires": { "left": { "send": [{ "bits": "0000001" }] } } }
      ],
      "want": { "right": { "echo": { "wire": "left" } } },
      "solution": ["right <- left"]
    }
  ]
}
