        "fr = framer(fb, fl, send)",
        "nx = select(mr, z, fr.next)",
        "lt = select(nx, last, z)",
        "ct = select(mr, fr.next, z)",
        "nm0 = select(ct, z, mr)",
        "nm = select(lt, o, nm0)",
        "km = keep[reg=A](nm)",
        "s = serializerhold(byte, nx, z)",
        "ar = reg[reg=C, start=0]()",
        "act = select(nx, o, ar)",
        "na = select(s.done, z, act)",
        "ka = keep[reg=C](na)",
        "hl = equal(act, z)",
        "k = crchold(s.line, z, hl)",
        "line <- fr.line",
