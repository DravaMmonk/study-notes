  "want": { "line": { "sent": { "format": "flagbyte" } }, "next": "given" },
  "solution": [
    "z = const[value=0]()",
    "o = const[value=1]()",
    "mr = reg[reg=A, start=0]()",
    "fb = select(mr, k, byte)",
    "fl = select(mr, o, z)",
    "fr = framer(fb, fl, send)",
    "nx = select(mr, z, fr.next)",
    "lt = select(nx, last, z)",
    "ct = select(mr, fr.next, z)",
    "nm0 = select(ct, z, mr)",
    "nm = select(lt, o, nm0)",
    "km = keep[reg=A](nm)",
    "pf = reg[reg=B, start=1]()",
    "fst = select(nx, pf, z)",
    "np = select(nx, last, pf)",
    "kp = keep[reg=B](np)",
    "s = serializerhold(byte, nx, z)",
    "ar = reg[reg=C, start=0]()",
    "act = select(nx, o, ar)",
    "na = select(s.done, z, act)",
    "ka = keep[reg=C](na)",
    "hl = equal(act, z)",
    "k = crchold(s.line, fst, hl)",
    "line <- fr.line",
    "next <- nx"
  ],
  "naive": [
    "z = const[value=0]()",
    "o = const[value=1]()",
    "mr = reg[reg=A, start=0]()",
    "fb = select(mr, k, byte)",
    "fl = select(mr, o, z)",
    "fr = framer(fb, fl, send)",
    "nx = select(mr, z, fr.next)",
    "lt = select(nx, last, z)",
    "ct = select(mr, fr.next, z)",
    "nm0 = select(ct, z, mr)",
    "nm = select(lt, o, nm0)",
    "km = keep[reg=A](nm)",
    "s = serializerhold(byte, nx, z)",
    "ar = reg[reg=C, start=0]()",
    "act = select(nx, o, ar)",
    "na = select(s.done, z, act)",
    "ka = keep[reg=C](na)",
    "hl = equal(act, z)",
    "k = crchold(s.line, z, hl)",
    "line <- fr.line",
    "next <- nx"
  ],
  "builds": {
    "type": "sender",
    "name": { "zh": "发帧器", "en": "Sender" },
    "desc": {
      "zh": "把交来的字节一帧一帧地送出：「发送」为 1 时开始新的一帧，内容后面跟一个校验字节（5 个 0 加内容的 3 位校验码），前后各加旗标 01111110，内容和校验字节里每连着 5 个 1 多说一个 0；没有开始新帧时线上说旗标。「下一个」为 1 的那一拍取走眼前的字节。",
      "en": "Sends the bytes handed to it frame by frame: a new frame begins while send is 1, its content followed by a check byte (five 0s, then the content's 3 check bits), with the flag 01111110 at each end and a 0 added after every five 1s in the content and check byte; flags fill the wire between frames. Next is 1 on the tick it takes the byte in front of it."
    }
  }
}
