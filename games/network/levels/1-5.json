{
  "title": { "zh": "听到过 1", "en": "Heard a 1" },
  "brief": {
    "zh": "线上出现 1 之前一直说 0；出现过 1 以后，每一拍都说 1。",
    "en": "Say 0 until a 1 has come down the wire, and 1 on every tick after that."
  },
  "intro": [
    {
      "t": {
        "zh": "寄存卡记住的不必是线上的位：存进去的可以是板上算出的任何值，下一拍再拿来接着算。",
        "en": "A register need not keep the bit off the wire: it can keep anything the board works out, to be worked on again the next tick."
      }
    }
  ],
  "wires": {
    "in": [{ "name": "left", "label": { "zh": "左线", "en": "Left wire" } }],
    "out": [{ "name": "right", "label": { "zh": "右线", "en": "Right wire" } }]
  },
  "tests": [
    { "wires": { "left": { "send": [{ "bits": "0001000" }] } } },
    { "wires": { "left": { "send": [{ "bits": "1000" }] } } },
    { "wires": { "left": { "send": [{ "bits": "0000" }] } } }
  ],
  "hidden": [
    { "wires": { "left": { "send": [{ "bits": "00000001" }] } } },
    { "wires": { "left": { "send": [{ "bits": "0101" }] } } }
  ],
  "want": { "right": { "heard": { "wire": "left" } } },
  "solution": [
    "o = const[value=1]()",
    "r = reg[reg=A, start=0]()",
    "s = select(left, o, r)",
    "k = keep[reg=A](s)",
    "right <- s"
  ],
  "naive": [
    "o = const[value=1]()",
    "r = reg[reg=A, start=0]()",
    "s = select(left, o, r)",
    "k = keep[reg=A](s)",
    "right <- r"
  ]
}
