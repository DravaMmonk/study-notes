{
  "title": { "zh": "一块网卡", "en": "A network adapter" },
  "intro": [
    {
      "t": {
        "zh": "<part-ref to=\"sender\"></part-ref>和<part-ref to=\"receiver\"></part-ref>各管一个方向，每一个要用线的节点都得把两者重新接一遍。把它们装进一块网卡：对上面只收发整帧的字节，对下面只收发线上的位，旗标、填充和校验字节都留在网卡里。这叫<wiki-ref to=\"layering\"></wiki-ref>。",
        "en": "<part-ref to=\"sender\"></part-ref> and <part-ref to=\"receiver\"></part-ref> each handle one direction, and every node that uses a wire would have to wire the two up again. Put them into one network adapter: it deals in the bytes of whole frames with the layer above and in bits on the wire below, and flags, stuffing and the check byte stay inside it. This is <wiki-ref to=\"layering\"></wiki-ref>."
      }
    }
  ],
  "builds": {
    "type": "nic",
    "name": { "zh": "网卡", "en": "Network adapter" },
    "desc": {
      "zh": "往下：交来的帧带上校验字节成帧送到出线上，「发送」为 1 的拍开始一帧，「下一个」为 1 的那一拍取走眼前的字节，「末字节」为 1 的字节是一帧的最后一个。往上：进线上来的帧拆开、核对，每个内容字节在它后面那个字节收全的那一拍给出，「收到」为 1；结尾旗标收完的那一拍「帧尾」为 1，「相符」说出这一帧的校验是否相符。",
      "en": "Down: frames handed to it go out on its wire out, framed with their check byte; a frame begins on a tick send is 1, next is 1 on the tick it takes the byte in front of it, and a byte with last 1 ends its frame. Up: frames off its wire in are unwrapped and checked, each content byte given on the tick the byte after it is complete, with got 1; on the tick the closing flag is complete, end is 1 and fits says whether the frame's check fits."
    }
  },
  "tasks": [
    {
      "brief": {
        "zh": "搭一块网卡，两个方向同时工作。往下：交来的帧带上校验字节成帧，从出线送出，「发送」为 1 时开始，「下一个」取走队首。往上：进线上的帧拆开、核对，输出的时机同<part-ref to=\"receiver\"></part-ref>。",
        "en": "Build a network adapter working both ways at once. Down: frames handed to it go out framed on the wire out with their check byte, starting on a tick send is 1, next taking the byte in front. Up: frames off the wire in are unwrapped and checked, timed as in <part-ref to=\"receiver\"></part-ref>."
      },
      "hint": [{ "zh": "两个方向互不相干，各接各的。", "en": "The two directions do not touch each other." }],
      "wires": {
        "in": [{ "name": "rx", "label": { "zh": "进线", "en": "Wire in" } }],
        "out": [{ "name": "tx", "label": { "zh": "出线", "en": "Wire out" } }]
      },
      "inputs": [
        { "name": "down", "label": { "zh": "队首", "en": "Next byte" } },
        { "name": "last", "label": { "zh": "末字节", "en": "Last byte" } },
        { "name": "send", "label": { "zh": "发送", "en": "Send" } }
      ],
      "outputs": [
        { "name": "next", "label": { "zh": "下一个", "en": "Next" } },
        { "name": "up", "label": { "zh": "字节", "en": "Byte" } },
        { "name": "got", "label": { "zh": "收到", "en": "Got" } },
        { "name": "end", "label": { "zh": "帧尾", "en": "End" } },
        { "name": "ok", "label": { "zh": "相符", "en": "Fits" } }
      ],
      "pulls": { "input": "down", "next": "next", "last": "last" },
