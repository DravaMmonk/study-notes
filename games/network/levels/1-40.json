      "solution": [
        "z = const[value=0]()",
        "o = const[value=1]()",
        "sv = const[value=7]()",
        "five = const[value=5]()",
        "fv = const[value=126]()",
        "g = reg[reg=A, start=1]()",
        "on = reg[reg=E, start=0]()",
        "hd = equal(on, five)",
        "rs = select(hd, z, g)",
        "c = counterhold(rs, hd)",
        "e7 = equal(c, sv)",
        "ka = keep[reg=A](e7)",
        "e0 = equal(c, z)",
        "ro = reg[reg=B, start=0]()",
        "rm = reg[reg=C, start=0]()",
        "rk = reg[reg=D, start=0]()",
        "co = select(ro, send, z)",
        "ct = select(rm, o, co)",
        "cn = select(e0, ct, z)",
        "b = select(ct, byte, fv)",
        "s = serializerhold(b, e0, hd)",
        "nk = select(rk, z, o)",
        "no = select(ct, z, nk)",
        "nl = select(last, z, o)",
        "nm = select(ct, nl, z)",
        "nkk = select(ct, last, z)",
        "o2 = select(e0, no, ro)",
        "m2 = select(e0, nm, rm)",
        "k2 = select(e0, nkk, rk)",
        "kb = keep[reg=B](o2)",
        "kc = keep[reg=C](m2)",
        "kd = keep[reg=D](k2)",
        "cur = select(rm, o, rk)",
        "isc = select(e0, ct, cur)",
        "inc = add(on, o)",
        "n1 = select(s.line, inc, z)",
        "n2 = select(isc, n1, z)",
        "ke = keep[reg=E](n2)",
        "line <- s.line",
        "next <- cn"
      ],
