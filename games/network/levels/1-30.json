  "want": { "byte": { "bytes": { "wire": "line", "format": "flag" } }, "got": "given", "end": "given" },
  "solution": [
    "z = const[value=0]()",
    "o = const[value=1]()",
    "five = const[value=5]()",
    "f = flagspot(line)",
    "zr = equal(line, z)",
    "oc = counterhold(zr, z)",
    "p5 = equal(oc, five)",
    "q = reg[reg=C, start=0]()",
    "kq = keep[reg=C](p5)",
    "hd = select(line, z, q)",
    "c = counterhold(f, z)",
    "e1 = equal(c, o)",
    "pr = reg[reg=A, start=0]()",
    "st = select(e1, o, pr)",
    "d = deserializerhold(line, st, hd)",
    "kp = keep[reg=A](d.done)",
    "ro = reg[reg=B, start=0]()",
    "no = select(ro, z, o)",
    "o2 = select(f, no, ro)",
    "ko = keep[reg=B](o2)",
    "en = select(f, ro, z)",
    "g0 = select(ro, d.done, z)",
    "g = select(f, z, g0)",
    "y = select(g, d.byte)",
    "byte <- y",
    "got <- g",
    "end <- en"
  ],
  "naive": [
    "z = const[value=0]()",
    "o = const[value=1]()",
    "five = const[value=5]()",
    "f = flagspot(line)",
    "zr = equal(line, z)",
    "oc = counterhold(zr, z)",
    "hd = equal(oc, five)",
    "c = counterhold(f, z)",
    "e1 = equal(c, o)",
    "pr = reg[reg=A, start=0]()",
    "st = select(e1, o, pr)",
    "d = deserializerhold(line, st, hd)",
    "kp = keep[reg=A](d.done)",
    "ro = reg[reg=B, start=0]()",
    "no = select(ro, z, o)",
    "o2 = select(f, no, ro)",
    "ko = keep[reg=B](o2)",
    "en = select(f, ro, z)",
    "g0 = select(ro, d.done, z)",
    "g = select(f, z, g0)",
    "y = select(g, d.byte)",
    "byte <- y",
    "got <- g",
    "end <- en"
  ],
  "builds": {
    "type": "deframer",
    "name": { "zh": "拆帧器", "en": "Deframer" },
    "desc": {
      "zh": "在进线的位流里认出旗标之间的每一帧，去掉塞进的 0：一个内容字节收全的那一拍给出它，「收到」为 1；结尾旗标收完的那一拍「帧尾」为 1；其余各拍字节是「—」，「收到」「帧尾」为 0。",
      "en": "Finds each frame between flags in the bits on its wire in and takes out the stuffed 0s: gives each content byte on the tick it is complete, with got 1, and makes end 1 on the tick the closing flag is complete; on every other tick the byte is 「—」 and got and end are 0."
    }
  },
  "carry": "1-13"
}
