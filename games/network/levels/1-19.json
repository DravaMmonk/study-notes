    "n3 = select(p3, L.up, q3)",
    "k1 = keep[reg=B](n1)",
    "k2 = keep[reg=C](n2)",
    "k3 = keep[reg=D](n3)",
    "inc = add(nr, o)",
    "d0 = select(e2, o, two)",
    "dec = select(e1, z, d0)",
    "a0 = select(L.got, nr, dec)",
    "a1 = select(L.got, inc, nr)",
    "nn = select(R.next, a0, a1)",
    "kn = keep[reg=A](nn)",
    "lp = select(R.next, lst, z)",
    "fc = counter(lp, z)",
    "f2 = equal(fc, two)",
    "eb = equal(er, two)",
    "fl = select(f2, eb, z)",
    "xr = xor(R.tx, fl)",
    "bad = select(L.ok, o, two)",
    "ev0 = select(fl, z, er)",
    "eg = select(eb, two, z)",
    "ev1 = select(lp, eg, ev0)",
    "ev = select(L.end, bad, ev1)",
    "ke = keep[reg=E](ev)",
    "right <- xr"
  ],
