    "R = nic(z, q1, lst, snd)",
    "s1 = select(R.next, q2, q1)",
    "s2 = select(R.next, q3, q2)",
    "w1 = select(R.next, e1, e0)",
    "w2 = select(R.next, e2, e1)",
