{
  "title": {
    "zh": "反着说"
  },
  "intro": [
    {
      "t": {
        "zh": "<level-ref to=\"1-1\"></level-ref>的板只能原样照搬：线上来什么，就说什么。要说出和听到的不一样的位，板得能按条件改变一个值。新元件<part-ref to=\"part:select\"></part-ref>按条件在两路之间取一路，<part-ref to=\"part:const\"></part-ref>给出一个固定的数。"
      }
    }
  ],
  "adds": [
    "select",
    "const"
  ],
  "tasks": [
    {
      "id": "1-2",
      "brief": {
        "zh": "每一拍把听到的位反过来说出去：听到 1 说 0，听到 0 说 1。"
      },
      "hint": [
        { "zh": "听到的位本身就可以当作条件。" },
        {
          "zh": "听到 1 时该说什么、听到 0 时该说什么，各由一个常数给出。"
        }
      ],
      "wires": {
        "in": [{ "name": "left", "label": { "zh": "左线" } }],
        "out": [{ "name": "right", "label": { "zh": "右线" } }]
      },
      "tests": [
        { "wires": { "left": { "send": [{ "bits": "0110" }] } } },
        { "wires": { "left": { "send": [{ "bits": "1100101" }] } } }
      ],
      "hidden": [
        { "wires": { "left": { "send": [{ "bits": "1111" }] } } },
        { "wires": { "left": { "send": [{ "bits": "0000" }] } } }
      ],
      "want": { "right": { "opposite": { "wire": "left" } } },
      "solution": ["z = const[value=0]()", "o = const[value=1]()", "s = select(left, z, o)", "right <- s"],
      "naive": ["z = const[value=0]()", "o = const[value=1]()", "s = select(left, o, z)", "right <- s"]
    }
  ]
}
