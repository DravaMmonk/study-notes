{
  "title": { "zh": "晚一拍" },
  "intro": [
    {
      "t": {
        "zh": "板上的电路每一拍从头算一遍，算完什么也不留下：上一拍听到了什么，这一拍无从知道。要把一个值留到下一拍，需要一对新元件：<part-ref to=\"part:keep\"></part-ref>把值存进寄存卡，<part-ref to=\"part:reg\"></part-ref>在下一拍读出它。"
      }
    }
  ],
  "adds": ["reg", "keep"],
  "tasks": [
    {
      "id": "1-4",
      "brief": {
        "zh": "每一拍说出上一拍听到的位；第一拍说 0。"
      },
      "hint": [
        { "zh": "这一拍听到的，要到下一拍才说出去。" },
        {
          "zh": "存和读靠同一个寄存卡名字配对；第一拍读出的是初值。"
        }
      ],
      "wires": {
        "in": [{ "name": "left", "label": { "zh": "左线" } }],
        "out": [{ "name": "right", "label": { "zh": "右线" } }]
      },
      "tests": [
        { "wires": { "left": { "send": [{ "bits": "101100" }] } } },
        { "wires": { "left": { "send": [{ "bits": "01101" }] } } }
      ],
      "hidden": [
        { "wires": { "left": { "send": [{ "bits": "1" }] } } },
        { "wires": { "left": { "send": [{ "bits": "111" }] } } }
      ],
      "want": { "right": { "late": { "wire": "left", "first": 0 } } },
      "solution": ["r = reg[reg=A, start=0]()", "k = keep[reg=A](left)", "right <- r"],
      "naive": ["right <- left"]
    }
  ]
}
