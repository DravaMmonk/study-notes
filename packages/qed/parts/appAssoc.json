{
  "name": "@part.appAssoc.name",
  "desc": "@part.appAssoc.desc",
  "family": "logic:family-rule",
  "inside": [
    {
      "id": "base",
      "reference": {
        "kind": "logic:machine",
        "solution": [
          "c0r0 = math[use=[\"list.induct\"]]()",
          "c0 = rule(in, c0r0)",
          "c1 = each(c0, body: c5) {",
          "  body {",
          "    c2r0 = math[use=[\"def.0\", \"def.1\"]]()",
          "    c5r0 = refl()",
          "    c2r2 = logic:hyp(c2r0)",
          "    c2 = simp(c1.body, c2r2)",
          "    c3 = repeat(c2, body: c4) {",
          "      body {",
          "        c4r0 = allI()",
          "        c4 = rule(c3.body, c4r0)",
          "      }",
          "    }",
          "    c5 = rule(c3, c5r0)",
          "  }",
          "}",
          "out <- c1"
        ],
        "want": "logic:want-proved",
        "defs": ["app", "len"],
        "types": ["list"],
        "inputs": [{ "name": "in", "label": "in" }],
        "tests": [{ "goal": "∀xs. ∀ys. ∀zs. app(app(xs, ys), zs) = app(xs, app(ys, zs))" }]
      }
    }
  ],
  "inputs": [{ "name": "before", "type": "logic:machine-value", "optional": true }],
  "outputType": "logic:machine-value"
}
