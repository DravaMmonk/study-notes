{
  "name": "@part.addComm.name",
  "desc": "@part.addComm.desc",
  "family": "logic:family-rule",
  "inside": [
    {
      "id": "base",
      "reference": {
        "kind": "logic:machine",
        "solution": [
          "c0r0 = math[use=[\"nat.induct\"]]()",
          "c0 = rule(in, c0r0)",
          "c1 = each(c0, body: c4) {",
          "  body {",
          "    c2r0 = allI()",
          "    c3r0 = math[use=[\"def.0\", \"def.1\", addZero, addSucc]]()",
          "    c4r0 = refl()",
          "    c3r4 = logic:hyp(c3r0)",
          "    c2 = rule(c1.body, c2r0)",
          "    c3 = simp(c2, c3r4)",
          "    c4 = rule(c3, c4r0)",
          "  }",
          "}",
          "out <- c1"
        ],
        "want": "logic:want-proved",
        "defs": ["plus"],
        "types": ["nat"],
        "inputs": [{ "name": "in", "label": "in" }],
        "tests": [{ "goal": "∀x. ∀y. plus(x, y) = plus(y, x)" }]
      }
    }
  ],
  "inputs": [{ "name": "before", "type": "logic:machine-value", "optional": true }],
  "outputType": "logic:machine-value"
}
