{
  "name": "@part.merge.name",
  "desc": "@part.merge.desc",
  "family": "logic:family-lemma",
  "settings": { "A": { "control": "tree" }, "B": { "control": "tree" } },
  "inside": [
    {
      "id": "base",
      "reference": {
        "kind": "logic:proof",
        "solution": [
          "f = impI[A=A](body: m2) {",
          "  body {",
          "    m1 = mp(p, f.body)",
          "    m2 = mp(m1, f.body)",
          "  }",
          "}",
          "goal <- f"
        ],
        "tests": [{ "goal": "A → B", "premises": { "p": "A → (A → B)" } }]
      }
    }
  ],
  "inputs": [{ "name": "p0", "type": "logic:judgment" }],
  "outputType": "logic:judgment"
}
