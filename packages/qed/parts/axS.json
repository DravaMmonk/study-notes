{
  "name": "@part.axS.name",
  "desc": "@part.axS.desc",
  "family": "logic:family-lemma",
  "settings": {
    "A": { "control": "tree", "label": "@part.axS.settings.A.label" },
    "B": { "control": "tree", "label": "@part.axS.settings.B.label" },
    "C": { "control": "tree", "label": "@part.axS.settings.C.label" }
  },
  "inside": [
    {
      "id": "base",
      "reference": {
        "kind": "logic:proof",
        "solution": [
          "f = impI[A=\"A -> (B -> C)\"](body: g) {",
          "  body {",
          "    g = impI[A=\"A -> B\"](body: h) {",
          "      body {",
          "        h = impI[A=A](body: m3) {",
          "          body {",
          "            m1 = mp(f.body, h.body)",
          "            m2 = mp(g.body, h.body)",
          "            m3 = mp(m1, m2)",
          "          }",
          "        }",
          "      }",
          "    }",
          "  }",
          "}",
          "goal <- f"
        ],
        "tests": [{ "goal": "(A → (B → C)) → ((A → B) → (A → C))" }]
      }
    }
  ],
  "inputs": [],
  "outputType": "logic:judgment"
}
