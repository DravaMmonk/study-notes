{
  "title": "@level.notI.title",
  "tray": ["proof", "formula"],
  "intro": [
    {
      "t": "@level.notI.intro.0.t"
    }
  ],
  "after": "@level.notI.after",
  "tasks": [
    {
      "id": "notI_1",
      "kind": "proof",
      "step": "@level.notI.tasks.notI_1.step",
      "tests": [{ "premises": { "p": "A → B", "q": "A → ¬B" }, "goal": "¬A" }],
      "cases": [{ "A": "Rain", "B": "Wet" }, { "A": "Exam", "B": "Study" }],
      "hint": [
        "@level.notI.tasks.notI_1.hint.0"
      ],
      "solution": [
        "f = impI[A=A](body: m3) {",
        "  body {",
        "    m1 = mp(p, f.body)",
        "    m2 = mp(q, f.body)",
        "    m3 = mp(m2, m1)",
        "  }",
        "}",
        "goal <- f"
      ]
    },
    {
      "id": "notI_2",
      "kind": "proof",
      "step": "@level.notI.tasks.notI_2.step",
      "tests": [{ "premises": { "p": "A" }, "goal": "¬¬A" }],
      "cases": [{ "A": "Rain" }, { "A": "Locked" }],
      "hint": [
        "@level.notI.tasks.notI_2.hint.0"
      ],
      "intro": [
        { "t": "@level.notI.tasks.notI_2.intro.0.t" }
      ],
      "solution": ["f = impI[A=\"~A\"](body: m) {", "  body {", "    m = mp(f.body, p)", "  }", "}", "goal <- f"]
    }
  ]
}
