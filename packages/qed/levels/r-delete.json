      "inputs": [{ "name": "in", "label": "@level.r-delete.tasks.r-delete.inputs.0.label" }],
      "tests": [
        { "eqs": ["?A ∧ Wind ≐ Rain ∧ Wind"] },
        { "eqs": ["Rain → ?B ≐ Rain → Wet"] },
        { "eqs": ["¬?A ≐ ¬Rain"] },
        { "eqs": ["(?A ∧ Wind) → ?B ≐ (Rain ∧ Wind) → Wet"] }
      ],
      "brief": "@level.r-delete.tasks.r-delete.brief",
      "hint": ["@level.r-delete.tasks.r-delete.hint.0"],
      "solution": [
        "r = repeat(in, body: c1) {",
        "  body {",
        "    c0 = uDecompose(r.body)",
        "    c1 = uDelete(c0)",
        "  }",
        "}",
        "out <- r"
      ]
    }
  ]
