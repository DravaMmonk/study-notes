{
  "title": "@level.x-chain.title",
  "tray": "proof-formula",
  "without": [
    "impI",
    "chain",
    "swap",
    "merge"
  ],
  "after": "@level.x-chain.after",
  "tasks": [
    {
      "id": "x-chain",
      "kind": "logic:proof",
      "tests": [
        {
          "premises": {
            "p": "A → B",
            "q": "B → C"
          },
          "goal": "A → C"
        }
      ],
      "cases": [
        {
          "A": "Rain",
          "B": "Wet",
          "C": "Slip"
        },
        {
          "A": "Alarm",
          "B": "Up",
          "C": "OnTime"
        }
      ],
      "briefNote": "@level.x-chain.tasks.x-chain.briefNote",
      "hint": [
        "@level.x-chain.tasks.x-chain.hint.0",
        "@level.x-chain.tasks.x-chain.hint.1"
      ],
      "solution": [
        "k = axK[A=\"B -> C\", B=A]()",
        "s = axS[A=A, B=B, C=C]()",
        "m1 = mp(k, q)",
        "m2 = mp(s, m1)",
        "m3 = mp(m2, p)",
        "goal <- m3"
      ]
    }
  ]
}
