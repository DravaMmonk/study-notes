{
  "title": "@level.s-search.title",
  "adds": [
    "search"
  ],
  "tray": [
    "#machine",
    "#formula"
  ],
  "intro": [
    {
      "t": "@level.s-search.intro.0.t"
    },
    {
      "t": "@level.s-search.intro.1.t"
    }
  ],
  "tasks": [
    {
      "id": "s-search",
      "kind": "logic:machine",
      "want": "logic:want-proved",
      "inputs": [
        {
          "name": "in",
          "label": "@level.s-search.tasks.s-search.inputs.0.label"
        }
      ],
      "backtrack": true,
      "tests": [
        {
          "goal": "Rain ∨ (Wind ∨ Wet)",
          "hyps": [
            "Wet"
          ]
        },
        {
          "goal": "Rain ∨ (Wind ∨ Wet)",
          "hyps": [
            "Wind"
          ]
        },
        {
          "goal": "(Rain ∨ Wind) ∨ Wet",
          "hyps": [
            "Wind"
          ]
        }
      ],
      "brief": "@level.s-search.tasks.s-search.brief",
      "hint": [
        "@level.s-search.tasks.s-search.hint.0",
        "@level.s-search.tasks.s-search.hint.1"
      ],
      "solution": [
        "c0 = search(in, body: c1) {",
        "  body {",
        "    c1 = append[ways=\"3\"](c0.body, first: c2, second: c3, third: c4) {",
        "      first {",
        "        c2 = assumption(c1.first)",
        "      }",
        "      second {",
        "        c3r0 = orI[use=[disjI1]]()",
        "        c3 = rule(c1.second, c3r0)",
        "      }",
        "      third {",
        "        c4r0 = orI[use=[disjI2]]()",
        "        c4 = rule(c1.third, c4r0)",
        "      }",
        "    }",
        "  }",
        "}",
        "out <- c0"
      ]
    }
  ]
}
