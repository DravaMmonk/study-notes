{
  "adds": ["uDecompose", "uDelete", "uConflict", "uEliminate", "uSwap", "uCheck"],
  "tray": ["#machine", "#formula"],
  "title": "@level.r-unifier.title",
  "intro": [
    {
      "t": "@level.r-unifier.intro.0.t"
    }
  ],
  "after": "@level.r-unifier.after",
  "tasks": [
    {
      "id": "r-unifier",
      "kind": "machine",
      "want": "unify",
      "inputs": [{ "name": "in", "label": "@level.r-unifier.tasks.r-unifier.inputs.0.label" }],
      "tests": [
        { "eqs": ["(?A → ?B) ∧ (?B → ?C) ≐ (Rain → Wet) ∧ (?D → Slip)"] },
        { "eqs": ["?A ∧ (?B ∨ ?A) ≐ Rain ∧ (Wind ∨ Wet)"] },
        { "eqs": ["?A → ?B ≐ ?B → ¬?A"] },
        { "eqs": ["¬¬?A ≐ ¬?B"] }
      ],
      "brief": "@level.r-unifier.tasks.r-unifier.brief",
      "hint": ["@level.r-unifier.tasks.r-unifier.hint.0"],
      "solution": [
        "r = repeat(in, body: c5) {",
        "  body {",
        "    c0 = uDecompose(r.body)",
        "    c1 = uDelete(c0)",
        "    c2 = uSwap(c1)",
        "    c3 = uEliminate(c2)",
        "    c4 = uCheck(c3)",
        "    c5 = uConflict(c4)",
        "  }",
        "}",
        "out <- r"
      ],
      "publishes": [{ "piece": "unifier", "variant": "base" }]
    }
  ]
}
