{
  "title": "@level.s-intro.title",
  "tray": "machine-formula",
  "intro": [
    {
      "t": "@level.s-intro.intro.0.t"
    }
  ],
  "tasks": [
    {
      "id": "s-intro",
      "kind": "logic:machine",
      "want": "logic:want-becomes",
      "inputs": [
        {
          "name": "in",
          "label": "@level.s-intro.tasks.s-intro.inputs.0.label"
        }
      ],
      "backtrack": true,
      "tests": [
        {
          "goal": "Rain ∧ Wind",
          "becomes": [
            [
              "Rain",
              "Wind"
            ]
          ]
        },
        {
          "goal": "Rain → Wet",
          "becomes": [
            [
              "Rain ⊢ Wet"
            ]
          ]
        },
        {
          "goal": "Rain ∨ Wind",
          "becomes": [
            [
              "Rain"
            ],
            [
              "Wind"
            ]
          ]
        },
        {
          "goal": "∀x. Human(x) → Mortal(x)",
          "becomes": [
            [
              "⋀a. Human(a) → Mortal(a)"
            ]
          ]
        },
        {
          "goal": "∃x. Human(x)",
          "becomes": [
            [
              "Human(?t)"
            ]
          ]
        },
        {
          "goal": "Rain",
          "becomes": []
        }
      ],
      "brief": "@level.s-intro.tasks.s-intro.brief",
      "hint": [
        "@level.s-intro.tasks.s-intro.hint.0",
        "@level.s-intro.tasks.s-intro.hint.1"
      ],
      "solution": [
        "c0 = append[ways=\"6\"](in, first: c1, second: c2, third: c3, fourth: c4, fifth: c5, sixth: c6) {",
        "  first {",
        "    c1r0 = andI()",
        "    c1 = rule(c0.first, c1r0)",
        "  }",
        "  second {",
        "    c2r0 = impI()",
        "    c2 = rule(c0.second, c2r0)",
        "  }",
        "  third {",
        "    c3r0 = orI[use=[disjI1]]()",
        "    c3 = rule(c0.third, c3r0)",
        "  }",
        "  fourth {",
        "    c4r0 = orI[use=[disjI2]]()",
        "    c4 = rule(c0.fourth, c4r0)",
        "  }",
        "  fifth {",
        "    c5r0 = allI()",
        "    c5 = rule(c0.fifth, c5r0)",
        "  }",
        "  sixth {",
        "    c6r0 = exI()",
        "    c6 = rule(c0.sixth, c6r0)",
        "  }",
        "}",
        "out <- c0"
      ],
      "publishes": [
        {
          "part": "introRules",
          "variant": "base"
        }
      ]
    }
  ]
}
