{
  "title": "@level.mp.title",
  "tray": ["#proof", "#formula"],
  "intro": [
    {
      "t": "@level.mp.intro.0.t"
    },
    {
      "t": "@level.mp.intro.1.t"
    }
  ],
  "after": "@level.mp.after",
  "tasks": [
    {
      "id": "mp_1",
      "kind": "proof",
      "step": "@level.mp.tasks.mp_1.step",
      "tests": [{ "premises": { "p": "A → B", "q": "B → C", "r": "A" }, "goal": "C" }],
      "cases": [{ "A": "Rain", "B": "Wet", "C": "Slip" }, { "A": "Alarm", "B": "Up", "C": "OnTime" }],
      "adds": ["mp"],
      "hint": [
        "@level.mp.tasks.mp_1.hint.0",
        "@level.mp.tasks.mp_1.hint.1"
      ],
      "solution": ["m1 = mp(p, r)", "m2 = mp(q, m1)", "goal <- m2"]
    },
    {
      "id": "mp_2",
      "kind": "proof",
      "step": "@level.mp.tasks.mp_2.step",
      "tests": [{ "premises": { "p": "A → B", "q": "C → B", "r": "C", "s": "B → D" }, "goal": "D" }],
      "cases": [
        { "A": "Bus", "B": "OnTime", "C": "Bike", "D": "Happy" },
        { "A": "Coffee", "B": "Awake", "C": "Tea", "D": "Pass" }
      ],
      "hint": [
        "@level.mp.tasks.mp_2.hint.0"
      ],
      "intro": [{ "t": "@level.mp.tasks.mp_2.intro.0.t" }],
      "solution": ["m1 = mp(q, r)", "m2 = mp(s, m1)", "goal <- m2"]
    }
  ]
}
