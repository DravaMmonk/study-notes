{
  "title": "@level.twice.title",
  "tray": "proof-formula",
  "intro": [
    {
      "t": "@level.twice.intro.0.t"
    }
  ],
  "tasks": [
    {
      "id": "twice",
      "kind": "logic:proof",
      "tests": [
        {
          "premises": {
            "p": "A → (A → B)"
          },
          "goal": "A → B"
        }
      ],
      "cases": [
        {
          "A": "Rain",
          "B": "Wet"
        },
        {
          "A": "Hungry",
          "B": "Eat"
        }
      ],
      "hint": [
        "@level.twice.tasks.twice.hint.0",
        "@level.twice.tasks.twice.hint.1"
      ],
      "solution": [
        "f = impI[A=A](body: m2) {",
        "  body {",
        "    m1 = mp(p, f.body)",
        "    m2 = mp(m1, f.body)",
        "  }",
        "}",
        "goal <- f"
      ],
      "naive": [
        "m = mp(p, p)",
        "goal <- m"
      ],
      "publishes": [
        {
          "piece": "merge",
          "variant": "base"
        }
      ]
    }
  ]
}
