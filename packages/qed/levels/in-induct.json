{
  "title": "@level.in-induct.title",
  "tray": [
    "#proof",
    "#formula"
  ],
  "consts": [
    "zero"
  ],
  "words": [
    "qed/everyday",
    "qed/terms"
  ],
  "intro": [
    {
      "t": "@level.in-induct.intro.0.t"
    },
    {
      "t": "@level.in-induct.intro.1.t"
    }
  ],
  "after": "@level.in-induct.after",
  "tasks": [
    {
      "id": "in-induct_1",
      "kind": "logic:proof",
      "step": "@level.in-induct.tasks.in-induct_1.step",
      "cases": [],
      "tests": [
        {
          "premises": {
            "ind": "∀P. P(zero) → (∀n. P(n) → P(s(n))) → (∀n. P(n))",
            "z": "plus(zero, zero) = zero",
            "st": "∀n. plus(n, zero) = n → plus(s(n), zero) = s(n)"
          },
          "goal": "∀n. plus(n, zero) = n"
        }
      ],
      "brief": "@level.in-induct.tasks.in-induct_1.brief",
      "hint": [
        "@level.in-induct.tasks.in-induct_1.hint.0",
        "@level.in-induct.tasks.in-induct_1.hint.1"
      ],
      "solution": [
        "i = allE[t=\"plus(x, zero) = x\"](ind)",
        "m1 = mp(i, z)",
        "m2 = mp(m1, st)",
        "goal <- m2"
      ]
    },
    {
      "id": "in-induct_2",
      "kind": "logic:proof",
      "step": "@level.in-induct.tasks.in-induct_2.step",
      "cases": [],
      "tests": [
        {
          "premises": {
            "ind": "∀P. P(zero) → (∀n. P(n) → P(s(n))) → (∀n. P(n))"
          },
          "goal": "∀n. n = zero ∨ (∃m. n = s(m))"
        }
      ],
      "sentences": [
        "∃m. zero = s(m)",
        "s(n) = zero ∨ (∃m. s(n) = s(m))"
      ],
      "brief": "@level.in-induct.tasks.in-induct_2.brief",
      "hint": [
        "@level.in-induct.tasks.in-induct_2.hint.0",
        "@level.in-induct.tasks.in-induct_2.hint.1"
      ],
      "solution": [
        "r = refl[t=zero]()",
        "a = allI[x=a](body: h) {",
        "  body {",
        "    h = impI[A=\"a = zero | (exists m. a = s(m))\"](body: o2) {",
        "      body {",
        "        r2 = refl[t=\"s(a)\"]()",
        "        x = exI[target=\"exists m. s(a) = s(m)\"](r2)",
        "        o2 = orI[other=\"s(a) = zero\", side=left](x)",
        "      }",
        "    }",
        "  }",
        "}",
        "i = allE[t=\"x = zero | (exists m. x = s(m))\"](ind)",
        "o = orI[other=\"exists m. zero = s(m)\"](r)",
        "m1 = mp(i, o)",
        "m2 = mp(m1, a)",
        "goal <- m2"
      ]
    }
  ]
}
