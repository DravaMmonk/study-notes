{
  "title": "@level.x-swap.title",
  "tray": [
    "#proof",
    "#formula"
  ],
  "without": [
    "impI",
    "chain",
    "swap",
    "merge"
  ],
  "tasks": [
    {
      "id": "x-swap",
      "sentences": [
        "(A → B) → (A → C)"
      ],
      "kind": "logic:proof",
      "tests": [
        {
          "premises": {
            "p": "A → (B → C)"
          },
          "goal": "B → (A → C)"
        }
      ],
      "cases": [
        {
          "A": "Sat",
          "B": "Rain",
          "C": "Rest"
        },
        {
          "A": "Exam",
          "B": "Study",
          "C": "Pass"
        }
      ],
      "briefNote": "@level.x-swap.tasks.x-swap.briefNote",
      "hint": [
        "@level.x-swap.tasks.x-swap.hint.0",
        "@level.x-swap.tasks.x-swap.hint.1"
      ],
      "solution": [
        "s = axS[A=A, B=B, C=C]()",
        "k = axK[A=B, B=A]()",
        "k2 = axK[A=\"(A -> B) -> (A -> C)\", B=B]()",
        "s2 = axS[A=B, B=\"A -> B\", C=\"A -> C\"]()",
        "m1 = mp(s, p)",
        "m2 = mp(k2, m1)",
        "m3 = mp(s2, m2)",
        "m4 = mp(m3, k)",
        "goal <- m4"
      ]
    }
  ]
}
