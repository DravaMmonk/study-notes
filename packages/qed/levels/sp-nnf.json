{
  "title": "@level.sp-nnf.title",
  "tray": "machine-formula",
  "intro": [
    {
      "t": "@level.sp-nnf.intro.0.t"
    }
  ],
  "tasks": [
    {
      "id": "sp-nnf",
      "kind": "logic:machine",
      "want": "logic:want-becomes",
      "inputs": [
        {
          "name": "in",
          "label": "@level.sp-nnf.tasks.sp-nnf.inputs.0.label"
        }
      ],
      "backtrack": true,
      "tests": [
        {
          "goal": "¬(Rain → Wet)",
          "becomes": [
            [
              "Rain ∧ ¬Wet"
            ]
          ]
        },
        {
          "goal": "¬(Rain ∧ (Wind → Wet))",
          "becomes": [
            [
              "¬Rain ∨ (Wind ∧ ¬Wet)"
            ]
          ]
        },
        {
          "goal": "¬∀x. Human(x) → Mortal(x)",
          "becomes": [
            [
              "∃x. Human(x) ∧ ¬Mortal(x)"
            ]
          ]
        },
        {
          "goal": "¬∃x. Bird(x) ∧ ¬Flies(x)",
          "becomes": [
            [
              "∀x. ¬Bird(x) ∨ Flies(x)"
            ]
          ]
        }
      ],
      "brief": "@level.sp-nnf.tasks.sp-nnf.brief",
      "hint": [
        "@level.sp-nnf.tasks.sp-nnf.hint.0",
        "@level.sp-nnf.tasks.sp-nnf.hint.1"
      ],
      "solution": [
        "c0r0 = arrow[use=[\"arrow.elim\"]]()",
        "c0r1 = dneg[use=[\"dneg.elim\"]](c0r0)",
        "c0r2 = dm[use=[\"dm.notOr\", \"dm.notAnd\", \"dm.notEx\", \"dm.notAll\"]](c0r1)",
        "c0 = simp(in, c0r2)",
        "out <- c0"
      ]
    }
  ]
}
