{
  "title": "@level.byContra.title",
  "tray": ["#proof", "#formula"],
  "intro": [
    {
      "t": "@level.byContra.intro.0.t"
    }
  ],
  "tasks": [
    {
      "id": "byContra",
      "kind": "proof",
      "tests": [{ "premises": { "p": "¬A → B", "q": "¬A → ¬B" }, "goal": "A" }],
      "cases": [{ "A": "Locked", "B": "Moon" }, { "A": "Rain", "B": "Wet" }],
      "hint": [
        "@level.byContra.tasks.byContra.hint.0",
        "@level.byContra.tasks.byContra.hint.1"
      ],
      "solution": [
        "f = impI[A=\"~A\"](body: m3) {",
        "  body {",
        "    m1 = mp(p, f.body)",
        "    m2 = mp(q, f.body)",
        "    m3 = mp(m2, m1)",
        "  }",
        "}",
        "r = raa(f)",
        "goal <- r"
      ]
    }
  ]
}
