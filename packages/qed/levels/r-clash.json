{
  "title": "@level.r-clash.title",
  "adds": [
    "uConflict",
    "uDecompose"
  ],
  "tray": [
    "#machine",
    "#formula"
  ],
  "intro": [
    {
      "t": "@level.r-clash.intro.0.t"
    }
  ],
  "tasks": [
    {
      "id": "r-clash",
      "kind": "logic:machine",
      "want": "logic:want-unify",
      "inputs": [
        {
          "name": "in",
          "label": "@level.r-clash.tasks.r-clash.inputs.0.label"
        }
      ],
      "tests": [
        {
          "eqs": [
            "?A ∧ ?B ≐ Rain ∨ Wind"
          ]
        },
        {
          "eqs": [
            "?A → ⊥ ≐ Rain → Wet"
          ]
        },
        {
          "eqs": [
            "?A ∨ ?B ≐ Rain ∨ (Wind ∧ Wet)"
          ]
        },
        {
          "eqs": [
            "(?A ∧ ?B) → ?C ≐ (Rain ∨ Wind) → Wet"
          ]
        }
      ],
      "brief": "@level.r-clash.tasks.r-clash.brief",
      "hint": [
        "@level.r-clash.tasks.r-clash.hint.0"
      ],
      "solution": [
        "r = repeat(in, body: c1) {",
        "  body {",
        "    c0 = uDecompose(r.body)",
        "    c1 = uConflict(c0)",
        "  }",
        "}",
        "out <- r"
      ]
    }
  ],
  "local": [
    "uConflict",
    "uDecompose"
  ]
}
