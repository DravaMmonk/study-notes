            ]
          ]
        },
        {
          "goal": "¬(Rain ∧ Wind) ∨ (Wet ∧ Slip)",
          "becomes": [
            [
              "(¬Rain ∨ ¬Wind ∨ Wet) ∧ (¬Rain ∨ ¬Wind ∨ Slip)"
            ]
          ]
        },
        {
          "goal": "(Rain → Wet) ∧ (Wind ∨ (Rain ∧ Slip))",
          "becomes": [
            [
              "(¬Rain ∨ Wet) ∧ ((Wind ∨ Rain) ∧ (Wind ∨ Slip))"
            ]
          ]
        }
      ],
      "brief": "@level.sp-cnf.tasks.sp-cnf.brief",
