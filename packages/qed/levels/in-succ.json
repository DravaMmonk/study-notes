{
  "title": "@level.in-succ.title",
  "tray": "machine-formula",
  "tasks": [
    {
      "id": "in-succ",
      "kind": "logic:machine",
      "want": "logic:want-proved",
      "inputs": [
        {
          "name": "in",
          "label": "@level.in-succ.tasks.in-succ.inputs.0.label"
        }
      ],
      "backtrack": true,
      "words": [
        "qed/everyday",
        "qed/terms"
      ],
      "types": [
        "nat"
      ],
      "defs": [
        "plus"
      ],
      "tests": [
        {
          "goal": "∀x. ∀y. plus(x, s(y)) = s(plus(x, y))"
        }
      ],
      "brief": "@level.in-succ.tasks.in-succ.brief",
      "hint": [
        "@level.in-succ.tasks.in-succ.hint.0",
        "@level.in-succ.tasks.in-succ.hint.1"
      ],
      "solution": [
        "c0r0 = math[use=[\"nat.induct\"]]()",
        "c0 = rule(in, c0r0)",
        "c1 = each(c0, body: c4) {",
        "  body {",
        "    c2r0 = math[use=[\"def.0\", \"def.1\"]]()",
        "    c3r0 = allI()",
        "    c4r0 = refl()",
        "    c2r2 = logic:hyp(c2r0)",
        "    c2 = simp(c1.body, c2r2)",
        "    c3 = rule(c2, c3r0)",
        "    c4 = rule(c3, c4r0)",
        "  }",
        "}",
        "out <- c1"
      ],
      "naive": [
        "c0r0 = allI()",
        "c1r0 = allI()",
        "c2r0 = math[use=[\"def.0\", \"def.1\"]]()",
        "c3r0 = refl()",
        "c0 = rule(in, c0r0)",
        "c2r2 = logic:hyp(c2r0)",
        "c1 = rule(c0, c1r0)",
        "c2 = simp(c1, c2r2)",
        "c3 = rule(c2, c3r0)",
        "out <- c3"
      ],
      "publishes": [
        {
          "piece": "addSucc",
          "variant": "base"
        }
      ]
    }
  ]
}
