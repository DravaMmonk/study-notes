{
  "title": "@level.r-occurs.title",
  "adds": [
    "uCheck",
    "uDecompose",
    "uEliminate"
  ],
  "tray": "machine-formula",
  "intro": [
    {
      "t": "@level.r-occurs.intro.0.t"
    }
  ],
  "after": "@level.r-occurs.after",
  "tasks": [
    {
      "id": "r-occurs",
      "kind": "logic:machine",
      "want": "logic:want-unify",
      "inputs": [
        {
          "name": "in",
          "label": "@level.r-occurs.tasks.r-occurs.inputs.0.label"
        }
      ],
      "tests": [
        {
          "eqs": [
            "?A ≐ ?A → Wet"
          ]
        },
        {
          "eqs": [
            "?A → ?A ≐ ?B → (?B ∧ Rain)"
          ]
        },
        {
          "eqs": [
            "?A ∧ ?B ≐ ?B ∧ Rain"
          ]
        }
      ],
      "brief": "@level.r-occurs.tasks.r-occurs.brief",
      "hint": [
        "@level.r-occurs.tasks.r-occurs.hint.0"
      ],
      "solution": [
        "r = repeat(in, body: c2) {",
        "  body {",
        "    c0 = uDecompose(r.body)",
        "    c1 = uEliminate(c0)",
        "    c2 = uCheck(c1)",
        "  }",
        "}",
        "out <- r"
      ]
    }
  ],
  "local": [
    "uCheck",
    "uDecompose",
    "uEliminate"
  ]
}
