{
  "title": "@level.c-dist.title",
  "tray": ["proof", "formula"],
  "intro": [
    {
      "t": "@level.c-dist.intro.0.t"
    }
  ],
  "tasks": [
    {
      "id": "c-dist_1",
      "kind": "proof",
      "step": "@level.c-dist.tasks.c-dist_1.step",
      "tests": [{ "premises": { "p": "A ∨ (B ∧ C)" }, "goal": "(A ∨ B) ∧ (A ∨ C)" }],
      "cases": [{ "A": "Rain", "B": "Wind", "C": "Wet" }, { "A": "Sat", "B": "Rest", "C": "Happy" }],
      "hint": ["@level.c-dist.tasks.c-dist_1.hint.0"],
      "solution": [
        "e = orE(p, left: c1, right: c2) {",
        "  left {",
        "    i1 = orI[other=B, side=right](e.left)",
        "    i2 = orI[other=C, side=right](e.left)",
        "    c1 = andI(i1, i2)",
        "  }",
        "  right {",
        "    s = andE(e.right)",
        "    j1 = orI[other=A, side=left](s.left)",
        "    j2 = orI[other=A, side=left](s.right)",
        "    c2 = andI(j1, j2)",
        "  }",
        "}",
        "goal <- e"
      ],
      "publishes": [{ "piece": "dist", "variant": "orAndR" }]
    },
    {
      "id": "c-dist_2",
      "kind": "proof",
      "step": "@level.c-dist.tasks.c-dist_2.step",
      "tests": [{ "premises": { "p": "(A ∨ B) ∧ (A ∨ C)" }, "goal": "A ∨ (B ∧ C)" }],
      "cases": [{ "A": "Rain", "B": "Wind", "C": "Wet" }, { "A": "Sat", "B": "Rest", "C": "Happy" }],
      "hint": [
        "@level.c-dist.tasks.c-dist_2.hint.0",
        "@level.c-dist.tasks.c-dist_2.hint.1"
      ],
      "solution": [
        "s = andE(p)",
        "o1 = orE(s.left, left: i1, right: o2) {",
        "  left {",
        "    i1 = orI[other=\"B & C\", side=right](o1.left)",
        "  }",
        "  right {",
        "    o2 = orE(s.right, left: i2, right: i3) {",
        "      left {",
        "        i2 = orI[other=\"B & C\", side=right](o2.left)",
        "      }",
        "      right {",
        "        c = andI(o1.right, o2.right)",
        "        i3 = orI[other=A, side=left](c)",
        "      }",
        "    }",
        "  }",
        "}",
        "goal <- o1"
      ],
      "publishes": [{ "piece": "dist", "variant": "andOrR" }]
    },
    {
      "id": "c-dist_3",
      "kind": "proof",
      "step": "@level.c-dist.tasks.c-dist_3.step",
      "tests": [{ "premises": { "p": "(A ∧ B) ∨ C" }, "goal": "(A ∨ C) ∧ (B ∨ C)" }],
      "cases": [{ "A": "Rain", "B": "Wind", "C": "Wet" }, { "A": "Sat", "B": "Rest", "C": "Happy" }],
      "hint": ["@level.c-dist.tasks.c-dist_3.hint.0"],
      "solution": [
        "e = orE(p, left: c1, right: c2) {",
        "  left {",
        "    s = andE(e.left)",
        "    i1 = orI[other=C, side=right](s.left)",
        "    i2 = orI[other=C, side=right](s.right)",
        "    c1 = andI(i1, i2)",
        "  }",
        "  right {",
        "    j1 = orI[other=A, side=left](e.right)",
        "    j2 = orI[other=B, side=left](e.right)",
        "    c2 = andI(j1, j2)",
        "  }",
        "}",
        "goal <- e"
      ],
      "publishes": [{ "piece": "dist", "variant": "orAndL" }]
    },
    {
      "id": "c-dist_4",
      "kind": "proof",
      "step": "@level.c-dist.tasks.c-dist_4.step",
      "tests": [{ "premises": { "p": "(A ∨ C) ∧ (B ∨ C)" }, "goal": "(A ∧ B) ∨ C" }],
      "cases": [{ "A": "Rain", "B": "Wind", "C": "Wet" }, { "A": "Sat", "B": "Rest", "C": "Happy" }],
      "hint": ["@level.c-dist.tasks.c-dist_4.hint.0"],
      "solution": [
        "s = andE(p)",
        "o1 = orE(s.left, left: o2, right: i3) {",
        "  left {",
        "    o2 = orE(s.right, left: i1, right: i2) {",
        "      left {",
        "        c = andI(o1.left, o2.left)",
        "        i1 = orI[other=C, side=right](c)",
        "      }",
        "      right {",
        "        i2 = orI[other=\"A & B\", side=left](o2.right)",
        "      }",
        "    }",
        "  }",
        "  right {",
        "    i3 = orI[other=\"A & B\", side=left](o1.right)",
        "  }",
        "}",
        "goal <- o1"
      ],
      "publishes": [{ "piece": "dist", "variant": "andOrL" }]
    }
  ]
}
