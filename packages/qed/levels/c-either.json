{
  "title": "@level.c-either.title",
  "tray": ["#proof", "#formula"],
  "intro": [
    {
      "t": "@level.c-either.intro.0.t"
    }
  ],
  "tasks": [
    {
      "id": "c-either",
      "kind": "proof",
      "tests": [{ "premises": { "p": "A → B", "q": "¬A → C" }, "goal": "B ∨ C" }],
      "cases": [{ "A": "Rain", "B": "Bus", "C": "Bike" }, { "A": "Exam", "B": "Study", "C": "Rest" }],
      "hint": [
        "@level.c-either.tasks.c-either.hint.0",
        "@level.c-either.tasks.c-either.hint.1"
      ],
      "solution": [
        "l = lem[A=A]()",
        "e = orE(l, left: i1, right: i2) {",
        "  left {",
        "    m1 = mp(p, e.left)",
        "    i1 = orI[other=C, side=right](m1)",
        "  }",
        "  right {",
        "    m2 = mp(q, e.right)",
        "    i2 = orI[other=B, side=left](m2)",
        "  }",
        "}",
        "goal <- e"
      ]
    }
  ]
}
