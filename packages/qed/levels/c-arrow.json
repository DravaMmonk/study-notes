{
  "title": "@level.c-arrow.title",
  "tray": [
    "#proof",
    "#formula"
  ],
  "intro": [
    {
      "t": "@level.c-arrow.intro.0.t"
    }
  ],
  "tasks": [
    {
      "id": "c-arrow_1",
      "kind": "logic:proof",
      "step": "@level.c-arrow.tasks.c-arrow_1.step",
      "tests": [
        {
          "premises": {
            "p": "A → B"
          },
          "goal": "¬A ∨ B"
        }
      ],
      "cases": [
        {
          "A": "Rain",
          "B": "Wet"
        },
        {
          "A": "Alarm",
          "B": "Up"
        }
      ],
      "hint": [
        "@level.c-arrow.tasks.c-arrow_1.hint.0"
      ],
      "solution": [
        "l = lem[A=A]()",
        "e = orE(l, left: i1, right: i2) {",
        "  left {",
        "    m = mp(p, e.left)",
        "    i1 = orI[other=\"~A\", side=left](m)",
        "  }",
        "  right {",
        "    i2 = orI[other=B, side=right](e.right)",
        "  }",
        "}",
        "goal <- e"
      ],
      "publishes": [
        {
          "piece": "arrow",
          "variant": "elim"
        }
      ]
    },
    {
      "id": "c-arrow_2",
      "kind": "logic:proof",
      "step": "@level.c-arrow.tasks.c-arrow_2.step",
      "tests": [
        {
          "premises": {
            "p": "¬A ∨ B"
          },
          "goal": "A → B"
        }
      ],
      "cases": [
        {
          "A": "Rain",
          "B": "Wet"
        },
        {
          "A": "Alarm",
          "B": "Up"
        }
      ],
      "hint": [
        "@level.c-arrow.tasks.c-arrow_2.hint.0",
        "@level.c-arrow.tasks.c-arrow_2.hint.1"
      ],
      "solution": [
        "f = impI[A=A](body: e) {",
        "  body {",
        "    e = orE(p, left: b, right: e.right) {",
        "      left {",
        "        m = mp(e.left, f.body)",
        "        b = botE[C=B](m)",
        "      }",
        "    }",
        "  }",
        "}",
        "goal <- f"
      ],
      "publishes": [
        {
          "piece": "arrow",
          "variant": "intro"
        }
      ],
      "awards": [
        "arrow-intro"
      ]
    }
  ]
}
