{
  "title": "@level.au-clauses.title",
  "adds": [
    "toClauses",
    "skolem"
  ],
  "tray": [
    "#machine",
    "#formula"
  ],
  "intro": [
    {
      "t": "@level.au-clauses.intro.0.t"
    }
  ],
  "tasks": [
    {
      "id": "au-clauses",
      "kind": "logic:machine",
      "want": "logic:want-clauses",
      "inputs": [
        {
          "name": "in",
          "label": "@level.au-clauses.tasks.au-clauses.inputs.0.label"
        }
      ],
      "backtrack": true,
      "tests": [
        {
          "goal": "Wet",
          "hyps": [
            "Rain → Wet",
            "Rain"
          ],
          "clauses": [
            "¬Rain ∨ Wet",
            "Rain",
            "¬Wet"
          ]
        },
        {
          "goal": "OnTime",
          "hyps": [
            "Bus ∨ Bike",
            "Bus → OnTime",
            "Bike → OnTime"
          ],
          "clauses": [
            "Bus ∨ Bike",
            "¬Bus ∨ OnTime",
            "¬Bike ∨ OnTime",
            "¬OnTime"
          ]
        },
        {
          "goal": "Mortal(h)",
          "hyps": [
            "∀x. Human(x) → Mortal(x)",
            "Human(h)"
          ],
          "clauses": [
            "¬Human(x) ∨ Mortal(x)",
            "Human(h)",
            "¬Mortal(h)"
          ]
        },
        {
          "goal": "∀x. Baby(x) → ¬Tamer(x)",
          "hyps": [
            "∀x. Baby(x) → ¬Logical(x)"
          ],
          "clauses": [
            "¬Baby(x) ∨ ¬Logical(x)",
            "Baby(a)",
            "Tamer(a)"
          ]
        }
      ],
      "brief": "@level.au-clauses.tasks.au-clauses.brief",
      "hint": [
        "@level.au-clauses.tasks.au-clauses.hint.0",
        "@level.au-clauses.tasks.au-clauses.hint.1"
      ],
      "solution": [
        "c0r0 = raa()",
        "c1r0 = impI()",
        "c2r0 = iff[use=[\"iff.elim\"]]()",
        "c0 = rule(in, c0r0)",
        "c2r1 = arrow[use=[\"arrow.elim\"]](c2r0)",
        "c1 = rule(c0, c1r0)",
        "c2r2 = dneg[use=[\"dneg.elim\"]](c2r1)",
        "c2r3 = dm[use=[\"dm.notOr\", \"dm.notAnd\", \"dm.notEx\", \"dm.notAll\"]](c2r2)",
        "c2r7 = dist[use=[\"dist.orAndR\", \"dist.orAndL\"]](c2r3)",
        "c2 = simp[at=hyps](c1, c2r7)",
        "c3 = skolem(c2)",
        "c4 = toClauses(c3)",
        "out <- c4"
      ],
      "naive": [
        "c0r0 = iff[use=[\"iff.elim\"]]()",
        "c0r1 = arrow[use=[\"arrow.elim\"]](c0r0)",
        "c0r2 = dneg[use=[\"dneg.elim\"]](c0r1)",
        "c0r3 = dm[use=[\"dm.notOr\", \"dm.notAnd\", \"dm.notEx\", \"dm.notAll\"]](c0r2)",
        "c0r7 = dist[use=[\"dist.orAndR\", \"dist.orAndL\"]](c0r3)",
        "c0 = simp[at=hyps](in, c0r7)",
        "c1 = skolem(c0)",
        "c2 = toClauses(c1)",
        "out <- c2"
      ],
      "publishes": [
        {
          "piece": "clausify",
          "variant": "base"
        }
      ]
    }
  ]
}
