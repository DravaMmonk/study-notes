      "tests": [{ "premises": { "r": "∃x. ∀y. M(x, c(y)) ↔ L(c(y))", "ls": "∀y. L(c(y)) ↔ ¬M(y, c(y))" }, "goal": "⊥" }],
      "cases": [{ "M": "Accepts", "L": "Ls" }],
      "brief": "@level.u-ls.tasks.u-ls.brief",
      "hint": ["@level.u-ls.tasks.u-ls.hint.0"],
      "solution": [
        "e = exE[x=a](r, body: l) {",
        "  body {",
        "    a2 = allE[t=a](ls)",
        "    a1 = allE[t=a](e.body)",
        "    s2 = andE(a2)",
        "    s1 = andE(a1)",
        "    c1 = chain(s1.left, s2.left)",
        "    c2 = chain(s2.right, s1.right)",
        "    j = andI(c1, c2)",
        "    l = liar(j)",
        "  }",
        "}",
        "goal <- e"
      ]
    }
  ]
