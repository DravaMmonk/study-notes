              "¬Rain ∧ ¬Wind → Wet"
            ]
          ]
        },
        {
          "goal": "Wet ∧ ¬(Sat ∧ Sun)",
          "becomes": [
            [
              "Wet ∧ (¬Sat ∨ ¬Sun)"
