{
  "title": "@level.r-twice.title",
  "adds": [
    "uEliminate",
    "uDecompose",
    "uDelete",
    "uConflict"
  ],
  "tray": [
    "#machine",
    "#formula"
  ],
  "intro": [
    {
      "t": "@level.r-twice.intro.0.t"
    }
  ],
  "tasks": [
    {
      "id": "r-twice",
      "kind": "logic:machine",
      "want": "logic:want-unify",
      "inputs": [
        {
          "name": "in",
          "label": "@level.r-twice.tasks.r-twice.inputs.0.label"
        }
      ],
      "tests": [
        {
          "eqs": [
            "?A → ?A ≐ Rain → Rain"
          ]
        },
        {
          "eqs": [
            "?A ∧ ?A ≐ Rain ∧ Wind"
          ]
        },
        {
          "eqs": [
            "?A → (?B → ?A) ≐ Rain → (Wind → Rain)"
          ]
        },
        {
          "eqs": [
            "(?A → ?B) → (?A → ?B) ≐ (Rain → Wet) → (Rain → Slip)"
          ]
        }
      ],
      "brief": "@level.r-twice.tasks.r-twice.brief",
      "hint": [
        "@level.r-twice.tasks.r-twice.hint.0"
      ],
      "solution": [
        "r = repeat(in, body: c3) {",
        "  body {",
        "    c0 = uDecompose(r.body)",
        "    c1 = uEliminate(c0)",
        "    c2 = uDelete(c1)",
        "    c3 = uConflict(c2)",
        "  }",
        "}",
        "out <- r"
      ]
    }
  ],
  "local": [
    "uEliminate",
    "uDecompose",
    "uDelete",
    "uConflict"
  ]
}
