{
  "title": "@level.r-both.title",
  "adds": ["uSwap", "uDecompose", "uConflict", "uEliminate"],
  "tray": ["machine", "formula"],
  "intro": [
    {
      "t": "@level.r-both.intro.0.t"
    }
  ],
  "tasks": [
    {
      "id": "r-both",
      "kind": "machine",
      "want": "unify",
      "inputs": [{ "name": "in", "label": "@level.r-both.tasks.r-both.inputs.0.label" }],
      "tests": [
        { "eqs": ["?A ∧ Wind ≐ Rain ∧ ?B"] },
        { "eqs": ["Rain → ?B ≐ ?A"] },
        { "eqs": ["?A → ?A ≐ ?B → Rain"] },
        { "eqs": ["Rain ∧ ?B ≐ ?A ∨ Wind"] }
      ],
      "brief": "@level.r-both.tasks.r-both.brief",
      "hint": ["@level.r-both.tasks.r-both.hint.0"],
      "solution": [
        "r = repeat(in, body: c3) {",
        "  body {",
        "    c0 = uDecompose(r.body)",
        "    c1 = uSwap(c0)",
        "    c2 = uEliminate(c1)",
        "    c3 = uConflict(c2)",
        "  }",
        "}",
        "out <- r"
      ]
    }
  ]
}
