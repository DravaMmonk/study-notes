{
  "title": "@level.and.title",
  "tray": [
    "#proof",
    "#formula"
  ],
  "intro": [
    {
      "t": "@level.and.intro.0.t"
    },
    {
      "t": "@level.and.intro.1.t"
    }
  ],
  "after": "@level.and.after",
  "tasks": [
    {
      "id": "and_1",
      "kind": "logic:proof",
      "step": "@level.and.tasks.and_1.step",
      "tests": [
        {
          "premises": {
            "p": "A ∧ B"
          },
          "goal": "B ∧ A"
        }
      ],
      "cases": [
        {
          "A": "Rain",
          "B": "Wind"
        },
        {
          "A": "Hungry",
          "B": "Late"
        }
      ],
      "hint": [
        "@level.and.tasks.and_1.hint.0"
      ],
      "solution": [
        "e = andE(p)",
        "i = andI(e.right, e.left)",
        "goal <- i"
      ]
    },
    {
      "id": "and_2",
      "kind": "logic:proof",
      "step": "@level.and.tasks.and_2.step",
      "tests": [
        {
          "goal": "A ∧ B → B ∧ A"
        }
      ],
      "cases": [
        {
          "A": "Rain",
          "B": "Wind"
        },
        {
          "A": "Hungry",
          "B": "Late"
        }
      ],
      "hint": [
        "@level.and.tasks.and_2.hint.0"
      ],
      "intro": [
        {
          "t": "@level.and.tasks.and_2.intro.0.t"
        }
      ],
      "solution": [
        "f = impI[A=\"A & B\"](body: i) {",
        "  body {",
        "    e = andE(f.body)",
        "    i = andI(e.right, e.left)",
        "  }",
        "}",
        "goal <- f"
      ]
    }
  ]
}
