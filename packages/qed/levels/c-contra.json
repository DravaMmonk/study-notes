      ],
      "solution": [
        "f = impI[A=A](body: r) {",
        "  body {",
        "    g = impI[A=\"~B\"](body: m2) {",
        "      body {",
        "        m1 = mp(p, g.body)",
        "        m2 = mp(m1, f.body)",
        "      }",
        "    }",
        "    r = raa(g)",
        "  }",
        "}",
        "goal <- f"
      ]
    }
  ]
