{
  "title": "@level.curry.title",
  "tray": [
    "#proof",
    "#formula"
  ],
  "intro": [
    {
      "t": "@level.curry.intro.0.t"
    }
  ],
  "tasks": [
    {
      "id": "curry_1",
      "kind": "logic:proof",
      "step": "@level.curry.tasks.curry_1.step",
      "tests": [
        {
          "premises": {
            "p": "A ∧ B → C"
          },
          "goal": "A → (B → C)"
        }
      ],
      "cases": [
        {
          "A": "Rain",
          "B": "Wind",
          "C": "Wet"
        },
        {
          "A": "Exam",
          "B": "Study",
          "C": "Pass"
        }
      ],
      "hint": [
        "@level.curry.tasks.curry_1.hint.0",
        "@level.curry.tasks.curry_1.hint.1"
      ],
      "solution": [
        "f = impI[A=A](body: g) {",
        "  body {",
        "    g = impI[A=B](body: m) {",
        "      body {",
        "        c = andI(f.body, g.body)",
        "        m = mp(p, c)",
        "      }",
        "    }",
        "  }",
        "}",
        "goal <- f"
      ]
    },
    {
      "id": "curry_2",
      "kind": "logic:proof",
      "step": "@level.curry.tasks.curry_2.step",
      "tests": [
        {
          "premises": {
            "p": "A → (B → C)"
          },
          "goal": "A ∧ B → C"
        }
      ],
      "cases": [
        {
          "A": "Sat",
          "B": "Rain",
          "C": "Rest"
        },
        {
          "A": "Alarm",
          "B": "Coffee",
          "C": "Awake"
        }
      ],
      "hint": [
        "@level.curry.tasks.curry_2.hint.0"
      ],
      "solution": [
        "f = impI[A=\"A & B\"](body: m2) {",
        "  body {",
        "    e = andE(f.body)",
        "    m1 = mp(p, e.left)",
        "    m2 = mp(m1, e.right)",
        "  }",
        "}",
        "goal <- f"
      ]
    }
  ]
}
