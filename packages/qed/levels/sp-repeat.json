  "tasks": [
    {
      "id": "sp-repeat",
      "kind": "machine",
      "want": "becomes",
      "inputs": [{ "name": "in", "label": "@level.sp-repeat.tasks.sp-repeat.inputs.0.label" }],
      "backtrack": true,
      "tests": [
        { "goal": "¬¬Rain", "becomes": [["Rain"]] },
        { "goal": "¬¬Rain ∧ ¬¬Wind", "becomes": [["Rain ∧ Wind"]] },
        { "goal": "¬¬(¬¬Rain ∨ ¬¬¬¬Wind)", "becomes": [["Rain ∨ Wind"]] }
      ],
      "brief": "@level.sp-repeat.tasks.sp-repeat.brief",
      "hint": ["@level.sp-repeat.tasks.sp-repeat.hint.0"],
      "solution": [
        "c0 = repeat(in, body: c1) {",
        "  body {",
        "    c1r0 = dneg[use=[\"dneg.elim\"]]()",
        "    c1 = rw(c0.body, c1r0)",
        "  }",
        "}",
        "out <- c0"
      ],
      "naive": [
        "c0r0 = dneg[use=[\"dneg.elim\"]]()",
        "c1r0 = dneg[use=[\"dneg.elim\"]]()",
        "c0 = rw(in, c0r0)",
        "c1 = rw(c0, c1r0)",
        "out <- c1"
      ]
    }
  ]
}
