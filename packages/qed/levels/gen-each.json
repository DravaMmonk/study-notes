{
  "title": "@level.gen-each.title",
  "adds": [
    "anyR",
    "swapConcl",
    "consFront",
    "mkRule",
    "eachOf"
  ],
  "tray": [
    "#machine",
    "#formula"
  ],
  "intro": [
    {
      "t": "@level.gen-each.intro.0.t"
    }
  ],
  "after": "@level.gen-each.after",
  "tasks": [
    {
      "id": "gen-each",
      "kind": "logic:machine",
      "want": "logic:want-elim",
      "inputs": [
        {
          "name": "it",
          "label": "@level.gen-each.tasks.gen-each.inputs.0.label"
        },
        {
          "name": "ways",
          "label": "@level.gen-each.tasks.gen-each.inputs.1.label"
        }
      ],
      "tests": [
        {
          "it": "?A ∧ ?B",
          "ways": [
            "⟦?A; ?B⟧ ⟹ ?A ∧ ?B"
          ],
          "elim": [
            "?A ∧ ?B",
            "⟦?A; ?B⟧ ⟹ ?R"
          ]
        },
        {
          "it": "?A ∨ ?B",
          "ways": [
            "⟦?A⟧ ⟹ ?A ∨ ?B",
            "⟦?B⟧ ⟹ ?A ∨ ?B"
          ],
          "elim": [
            "?A ∨ ?B",
            "⟦?A⟧ ⟹ ?R",
            "⟦?B⟧ ⟹ ?R"
          ]
        },
        {
          "it": "?A ∧ (?B ∧ ?C)",
          "ways": [
            "⟦?A; ?B; ?C⟧ ⟹ ?A ∧ (?B ∧ ?C)"
          ],
          "elim": [
            "?A ∧ (?B ∧ ?C)",
            "⟦?A; ?B; ?C⟧ ⟹ ?R"
          ]
        },
        {
          "it": "?A ∨ (?B ∨ ?C)",
          "ways": [
            "⟦?A⟧ ⟹ ?A ∨ (?B ∨ ?C)",
            "⟦?B⟧ ⟹ ?A ∨ (?B ∨ ?C)",
            "⟦?C⟧ ⟹ ?A ∨ (?B ∨ ?C)"
          ],
          "elim": [
            "?A ∨ (?B ∨ ?C)",
            "⟦?A⟧ ⟹ ?R",
            "⟦?B⟧ ⟹ ?R",
            "⟦?C⟧ ⟹ ?R"
          ]
        },
        {
          "it": "?A ↔ ?B",
          "ways": [
            "⟦?A → ?B; ?B → ?A⟧ ⟹ ?A ↔ ?B"
          ],
          "elim": [
            "?A ↔ ?B",
            "⟦?A → ?B; ?B → ?A⟧ ⟹ ?R"
          ]
        },
        {
          "it": "Truth",
          "ways": [
            "Truth"
          ],
          "elim": [
            "Truth",
            "?R"
          ]
        },
        {
          "it": "⊥",
          "ways": [],
          "elim": [
            "⊥"
          ]
        }
      ],
      "hidden": [
        {
          "it": "Motion",
          "ways": [
            "⟦AnnYes; BoYes⟧ ⟹ Motion",
            "⟦BoYes; CyYes⟧ ⟹ Motion",
            "⟦AnnYes; CyYes⟧ ⟹ Motion"
          ],
          "elim": [
            "Motion",
            "⟦AnnYes; BoYes⟧ ⟹ ?R",
            "⟦BoYes; CyYes⟧ ⟹ ?R",
            "⟦AnnYes; CyYes⟧ ⟹ ?R"
          ]
        }
      ],
      "brief": "@level.gen-each.tasks.gen-each.brief",
      "hint": [
        "@level.gen-each.tasks.gen-each.hint.0"
      ],
      "solution": [
        "r = anyR()",
        "e = eachOf(ways, body: s) {",
        "  body {",
        "    s = swapConcl(e.body, r)",
        "  }",
        "}",
        "c = consFront(it, e)",
        "m = mkRule(c, r)",
        "out <- m"
      ],
      "publishes": [
        {
          "piece": "elimGen",
          "variant": "v2"
        }
      ]
    }
  ],
  "local": [
    "anyR",
    "swapConcl",
    "consFront",
    "mkRule",
    "eachOf"
  ]
}
