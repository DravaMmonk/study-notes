{
  "title": "@level.h-or-make.title",
  "tray": "proof-formula",
  "intro": [
    {
      "t": "@level.h-or-make.intro.0.t"
    }
  ],
  "after": "@level.h-or-make.after",
  "tasks": [
    {
      "id": "h-or-make_1",
      "kind": "logic:proof",
      "step": "@level.h-or-make.tasks.h-or-make_1.step",
      "tests": [
        {
          "premises": {
            "p": "A"
          },
          "goal": "∀R. (A → R) → ((B → R) → R)"
        }
      ],
      "cases": [
        {
          "A": "Bus",
          "B": "Bike",
          "C": "OnTime"
        },
        {
          "A": "Sat",
          "B": "Sun",
          "C": "Rest"
        }
      ],
      "hint": [
        "@level.h-or-make.tasks.h-or-make_1.hint.0"
      ],
      "solution": [
        "s = allI[x=R](body: f) {",
        "  body {",
        "    f = impI[A=\"A -> R\"](body: g) {",
        "      body {",
        "        g = impI[A=\"B -> R\"](body: m) {",
        "          body {",
        "            m = mp(f.body, p)",
        "          }",
        "        }",
        "      }",
        "    }",
        "  }",
        "}",
        "goal <- s"
      ]
    },
    {
      "id": "h-or-make_2",
      "kind": "logic:proof",
      "step": "@level.h-or-make.tasks.h-or-make_2.step",
      "tests": [
        {
          "premises": {
            "p": "∀R. (A → R) → ((B → R) → R)",
            "q": "A → C",
            "r": "B → C"
          },
          "goal": "C"
        }
      ],
      "cases": [
        {
          "A": "Bus",
          "B": "Bike",
          "C": "OnTime"
        },
        {
          "A": "Sat",
          "B": "Sun",
          "C": "Rest"
        }
      ],
      "hint": [
        "@level.h-or-make.tasks.h-or-make_2.hint.0"
      ],
      "solution": [
        "e = allE[t=C](p)",
        "m1 = mp(e, q)",
        "m2 = mp(m1, r)",
        "goal <- m2"
      ]
    }
  ]
}
