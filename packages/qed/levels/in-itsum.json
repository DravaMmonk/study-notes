      "tests": [
        {
          "goal": "∀xs. ∀y. itsum(xs, y) = plus(y, sum(xs))"
        }
      ],
      "brief": "@level.in-itsum.tasks.in-itsum_3.brief",
      "hint": [
        "@level.in-itsum.tasks.in-itsum_3.hint.0",
        "@level.in-itsum.tasks.in-itsum_3.hint.1"
      ],
      "solution": [
        "c0r0 = math[use=[\"list.induct\"]]()",
        "c0 = rule(in, c0r0)",
        "c1 = each(c0, body: c4) {",
        "  body {",
        "    c2r0 = allI()",
        "    c3r0 = math[use=[\"def.0\", \"def.1\", \"def.2\", \"def.3\", \"def.4\", \"def.5\", addZero, addAssoc]]()",
        "    c4r0 = refl()",
        "    c3r8 = logic:hyp(c3r0)",
        "    c2 = rule(c1.body, c2r0)",
        "    c3 = simp(c2, c3r8)",
        "    c4 = rule(c3, c4r0)",
        "  }",
        "}",
        "out <- c1"
      ],
      "naive": [
        "c0r0 = math[use=[\"list.induct\"]]()",
        "c0 = rule(in, c0r0)",
        "c1 = each(c0, body: c4) {",
        "  body {",
        "    c2r0 = allI()",
        "    c3r0 = math[use=[\"def.0\", \"def.1\", \"def.2\", \"def.3\", \"def.4\", \"def.5\"]]()",
        "    c4r0 = refl()",
        "    c3r6 = logic:hyp(c3r0)",
        "    c2 = rule(c1.body, c2r0)",
        "    c3 = simp(c2, c3r6)",
        "    c4 = rule(c3, c4r0)",
        "  }",
        "}",
        "out <- c1"
      ]
    }
