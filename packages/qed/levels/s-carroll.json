{
  "title": "@level.s-carroll.title",
  "tray": ["#proof", "#formula"],
  "intro": [
    {
      "t": "@level.s-carroll.intro.0.t"
    }
  ],
  "tasks": [
    {
      "id": "s-carroll",
      "kind": "proof",
      "tests": [
        {
          "premises": { "p": "∀x. A(x) → ¬B(x)", "q": "∀x. C(x) → D(x)", "r": "∀x. ¬B(x) → ¬D(x)" },
          "goal": "∀x. A(x) → ¬C(x)"
        }
      ],
      "cases": [{ "A": "Baby", "B": "Logical", "C": "Tamer", "D": "Respected" }],
      "hint": [
        "@level.s-carroll.tasks.s-carroll.hint.0",
        "@level.s-carroll.tasks.s-carroll.hint.1"
      ],
      "solution": [
        "g = allI[x=a](body: h) {",
        "  body {",
        "    h = impI[A=\"A(a)\"](body: k) {",
        "      body {",
        "        k = impI[A=\"C(a)\"](body: m4) {",
        "          body {",
        "            e1 = allE[t=a](p)",
        "            e3 = allE[t=a](r)",
        "            e2 = allE[t=a](q)",
        "            m1 = mp(e1, h.body)",
        "            m2 = mp(e2, k.body)",
        "            m3 = mp(e3, m1)",
        "            m4 = mp(m3, m2)",
        "          }",
        "        }",
        "      }",
        "    }",
        "  }",
        "}",
        "goal <- g"
      ]
    }
  ]
}
