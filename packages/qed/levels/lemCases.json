{
  "title": "@level.lemCases.title",
  "tray": ["#proof", "#formula"],
  "intro": [
    {
      "t": "@level.lemCases.intro.0.t"
    }
  ],
  "tasks": [
    {
      "id": "lemCases",
      "kind": "proof",
      "tests": [{ "premises": { "p": "A → B", "q": "¬A → B" }, "goal": "B" }],
      "cases": [{ "A": "Rain", "B": "Coffee" }, { "A": "Bus", "B": "OnTime" }],
      "hint": [
        "@level.lemCases.tasks.lemCases.hint.0",
        "@level.lemCases.tasks.lemCases.hint.1"
      ],
      "solution": [
        "l = lem[A=A]()",
        "e = orE(l, left: m1, right: m2) {",
        "  left {",
        "    m1 = mp(p, e.left)",
        "  }",
        "  right {",
        "    m2 = mp(q, e.right)",
        "  }",
        "}",
        "goal <- e"
      ]
    }
  ]
}
