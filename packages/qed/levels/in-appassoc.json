{
  "title": "@level.in-appassoc.title",
  "tray": "machine-formula",
  "tasks": [
    {
      "id": "in-appassoc",
      "kind": "logic:machine",
      "want": "logic:want-proved",
      "inputs": [
        {
          "name": "in",
          "label": "@level.in-appassoc.tasks.in-appassoc.inputs.0.label"
        }
      ],
      "backtrack": true,
      "words": [
        "qed/everyday",
        "qed/terms"
      ],
      "types": [
        "list"
      ],
      "defs": [
        "app",
        "len"
      ],
      "tests": [
        {
          "goal": "∀xs. ∀ys. ∀zs. app(app(xs, ys), zs) = app(xs, app(ys, zs))"
        }
      ],
      "brief": "@level.in-appassoc.tasks.in-appassoc.brief",
      "hint": [
        "@level.in-appassoc.tasks.in-appassoc.hint.0"
      ],
      "solution": [
        "c0r0 = math[use=[\"list.induct\"]]()",
        "c0 = rule(in, c0r0)",
        "c1 = each(c0, body: c5) {",
        "  body {",
        "    c2r0 = math[use=[\"def.0\", \"def.1\"]]()",
        "    c5r0 = refl()",
        "    c2r2 = logic:hyp(c2r0)",
        "    c2 = simp(c1.body, c2r2)",
        "    c3 = repeat(c2, body: c4) {",
        "      body {",
        "        c4r0 = allI()",
        "        c4 = rule(c3.body, c4r0)",
        "      }",
        "    }",
        "    c5 = rule(c3, c5r0)",
        "  }",
        "}",
        "out <- c1"
      ],
      "publishes": [
        {
          "piece": "appAssoc",
          "variant": "base"
        }
      ]
    }
  ]
}
