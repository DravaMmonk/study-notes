{
  "adds": ["defer"],
  "tray": ["#machine", "#formula"],
  "title": "@level.pl-order.title",
  "intro": [
    {
      "t": "@level.pl-order.intro.0.t"
    }
  ],
  "after": "@level.pl-order.after",
  "tasks": [
    {
      "id": "pl-order",
      "kind": "machine",
      "want": "answers",
      "inputs": [{ "name": "in", "label": "@level.pl-order.tasks.pl-order.inputs.0.label" }],
      "backtrack": true,
      "rules": {
        "anc1": {
          "name": "@level.pl-order.tasks.pl-order.rules.anc1.name",
          "premises": ["Parent(?x, ?y)"],
          "conclusion": "Anc(?x, ?y)"
        },
        "anc3": {
          "name": "@level.pl-order.tasks.pl-order.rules.anc3.name",
          "premises": ["Anc(?x, ?y)", "Parent(?y, ?z)"],
          "conclusion": "Anc(?x, ?z)"
        }
      },
      "tests": [
        {
          "goal": "Anc(i, ?w)",
          "hyps": ["Parent(i, j)", "Parent(j, k)", "Parent(j, l)", "Parent(l, m)", "Parent(n, m)"],
          "answers": ["j", "k", "l", "m"]
        },
        {
          "goal": "Anc(j, ?w)",
          "hyps": ["Parent(i, j)", "Parent(j, k)", "Parent(j, l)", "Parent(l, m)", "Parent(n, m)"],
          "answers": ["k", "l", "m"]
        }
      ],
      "brief": "@level.pl-order.tasks.pl-order.brief",
      "hint": [
        "@level.pl-order.tasks.pl-order.hint.0",
        "@level.pl-order.tasks.pl-order.hint.1"
      ],
      "solution": [
        "c0 = search(in, body: c1) {",
        "  body {",
        "    c1 = append[ways=\"3\"](c0.body, first: c2, second: c3, third: c5) {",
        "      first {",
        "        c2 = assumption(c1.first)",
        "      }",
        "      second {",
        "        c3r0 = anc1()",
        "        c3 = rule(c1.second, c3r0)",
        "      }",
        "      third {",
        "        c4r0 = anc3()",
        "        c4 = rule(c1.third, c4r0)",
        "        c5 = defer(c4)",
        "      }",
        "    }",
        "  }",
        "}",
        "out <- c0"
      ],
      "naive": [
        "c0 = search(in, body: c1) {",
        "  body {",
        "    c1 = append[ways=\"3\"](c0.body, first: c2, second: c3, third: c4) {",
        "      first {",
        "        c2 = assumption(c1.first)",
        "      }",
        "      second {",
        "        c3r0 = anc1()",
        "        c3 = rule(c1.second, c3r0)",
        "      }",
        "      third {",
        "        c4r0 = anc3()",
        "        c4 = rule(c1.third, c4r0)",
        "      }",
        "    }",
        "  }",
        "}",
        "out <- c0"
      ]
    }
  ]
}
