      "solution": [
        "g = allI[x=a](body: h) {",
        "  body {",
        "    h = impI[A=\"A(a)\"](body: m2) {",
        "      body {",
        "        e1 = allE[t=a](p)",
        "        e2 = allE[t=a](q)",
        "        m1 = mp(e1, h.body)",
        "        m2 = mp(e2, m1)",
        "      }",
        "    }",
        "  }",
        "}",
        "goal <- g"
      ]
    }
  ]
