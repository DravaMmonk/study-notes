{
  "title": "@level.iffUse.title",
  "tray": ["#proof", "#formula"],
  "intro": [
    {
      "t": "@level.iffUse.intro.0.t"
    }
  ],
  "tasks": [
    {
      "id": "iffUse_1",
      "kind": "proof",
      "step": "@level.iffUse.tasks.iffUse_1.step",
      "tests": [{ "premises": { "p": "A ↔ B", "q": "A" }, "goal": "B" }],
      "cases": [{ "A": "Sat", "B": "Rest" }, { "A": "Coffee", "B": "Awake" }],
      "hint": [
        "@level.iffUse.tasks.iffUse_1.hint.0"
      ],
      "solution": ["e = andE(p)", "m = mp(e.left, q)", "goal <- m"]
    },
    {
      "id": "iffUse_2",
      "kind": "proof",
      "step": "@level.iffUse.tasks.iffUse_2.step",
      "tests": [{ "premises": { "p": "A ↔ B", "q": "¬A" }, "goal": "¬B" }],
      "cases": [{ "A": "Sat", "B": "Rest" }, { "A": "Coffee", "B": "Awake" }],
      "hint": [
        "@level.iffUse.tasks.iffUse_2.hint.0"
      ],
      "solution": [
        "f = impI[A=B](body: m2) {",
        "  body {",
        "    m1 = mp(e.right, f.body)",
        "    m2 = mp(q, m1)",
        "  }",
        "}",
        "e = andE(p)",
        "goal <- f"
      ]
    }
  ],
  "pieceRevisions": [{ "piece": "andE", "at": true, "desc": "@piece.andE.revisions.0.desc" }]
}
