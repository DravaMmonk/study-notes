      "want": "proved",
      "inputs": [{ "name": "in", "label": "@level.in-distinct.tasks.in-distinct.inputs.0.label" }],
      "backtrack": true,
      "words": ["everyday", "terms"],
      "types": ["nat"],
      "tests": [{ "goal": "¬(zero = s(zero))" }, { "goal": "¬(s(s(zero)) = zero)" }, { "goal": "¬(zero = s(a))" }],
      "brief": "@level.in-distinct.tasks.in-distinct.brief",
      "hint": [
        "@level.in-distinct.tasks.in-distinct.hint.0",
        "@level.in-distinct.tasks.in-distinct.hint.1"
      ],
      "solution": [
        "c0r0 = impI()",
        "c0 = rule(in, c0r0)",
        "c1 = append(c0, first: c2, second: c3) {",
        "  first {",
        "    c2r0 = math[use=[\"nat.distinct1\"]]()",
        "    c2 = erule(c1.first, c2r0)",
        "  }",
        "  second {",
        "    c3r0 = math[use=[\"nat.distinct2\"]]()",
        "    c3 = erule(c1.second, c3r0)",
        "  }",
        "}",
        "out <- c1"
      ]
    }
  ]
