      "step": "@level.in-revapp.tasks.in-revapp_1.step",
      "fn": "rev",
      "on": 0,
      "defs": ["app"],
      "rows": [
        { "lhs": "rev(nil)", "choices": ["nil"] },
        {
          "lhs": "rev(cons(x, xs))",
          "choices": [
            "app(rev(xs), cons(x, nil))",
            "cons(x, rev(xs))",
            "app(cons(x, nil), rev(xs))",
            "rev(app(xs, cons(x, nil)))"
          ]
        }
      ],
      "tests": [
        { "term": "rev(cons(i, cons(j, cons(k, nil))))", "value": "cons(k, cons(j, cons(i, nil)))" },
        { "term": "rev(cons(i, nil))", "value": "cons(i, nil)" }
      ],
      "solution": ["nil", "app(rev(xs), cons(x, nil))"],
      "naive": ["nil", "cons(x, rev(xs))"],
      "brief": "@level.in-revapp.tasks.in-revapp_1.brief",
      "hint": ["@level.in-revapp.tasks.in-revapp_1.hint.0"]
    },
    {
      "id": "in-revapp_2",
      "kind": "machine",
      "want": "proved",
      "inputs": [{ "name": "in", "label": "@level.in-revapp.tasks.in-revapp_2.inputs.0.label" }],
      "backtrack": true,
      "words": ["everyday", "terms"],
      "step": "@level.in-revapp.tasks.in-revapp_2.step",
      "types": ["list"],
      "defs": ["app", "len", "rev"],
      "tests": [{ "goal": "∀xs. ∀ys. rev(app(xs, ys)) = app(rev(ys), rev(xs))" }],
      "brief": "@level.in-revapp.tasks.in-revapp_2.brief",
      "hint": [
        "@level.in-revapp.tasks.in-revapp_2.hint.0",
        "@level.in-revapp.tasks.in-revapp_2.hint.1"
      ],
      "solution": [
        "c0r0 = math[use=[\"list.induct\"]]()",
        "c0 = rule(in, c0r0)",
        "c1 = each(c0, body: c4) {",
        "  body {",
        "    c2r0 = allI()",
        "    c3r0 = math[use=[\"def.0\", \"def.1\", \"def.4\", \"def.5\", appNil, appAssoc]]()",
        "    c4r0 = refl()",
        "    c3r6 = hyp(c3r0)",
        "    c2 = rule(c1.body, c2r0)",
        "    c3 = simp(c2, c3r6)",
        "    c4 = rule(c3, c4r0)",
        "  }",
        "}",
        "out <- c1"
      ],
      "naive": [
        "c0r0 = math[use=[\"list.induct\"]]()",
        "c0 = rule(in, c0r0)",
        "c1 = each(c0, body: c4) {",
        "  body {",
        "    c2r0 = allI()",
        "    c3r0 = math[use=[\"def.0\", \"def.1\", \"def.4\", \"def.5\"]]()",
        "    c4r0 = refl()",
        "    c3r4 = hyp(c3r0)",
        "    c2 = rule(c1.body, c2r0)",
        "    c3 = simp(c2, c3r4)",
        "    c4 = rule(c3, c4r0)",
        "  }",
        "}",
        "out <- c1"
      ],
      "publishes": [{ "piece": "revApp", "variant": "base" }]
