{
  "title": "@level.in-circle.title",
  "tray": [
    "#machine",
    "#formula"
  ],
  "intro": [
    {
      "t": "@level.in-circle.intro.0.t"
    }
  ],
  "after": "@level.in-circle.after",
  "tasks": [
    {
      "id": "in-circle",
      "kind": "logic:machine",
      "want": "logic:want-proved",
      "inputs": [
        {
          "name": "in",
          "label": "@level.in-circle.tasks.in-circle.inputs.0.label"
        }
      ],
      "backtrack": true,
      "words": [
        "everyday",
        "terms"
      ],
      "types": [
        "nat"
      ],
      "defs": [
        "plus"
      ],
      "tests": [
        {
          "goal": "∀x. ∀y. plus(x, s(y)) = s(plus(y, x))"
        },
        {
          "goal": "∀x. ∀y. plus(s(x), y) = plus(y, s(x))"
        },
        {
          "goal": "∀x. plus(x, s(zero)) = s(x)"
        }
      ],
      "brief": "@level.in-circle.tasks.in-circle.brief",
      "hint": [
        "@level.in-circle.tasks.in-circle.hint.0",
        "@level.in-circle.tasks.in-circle.hint.1"
      ],
      "solution": [
        "c2r0 = math[use=[\"def.0\", \"def.1\", addZero, addSucc]]()",
        "c0 = repeat(in, body: c1) {",
        "  body {",
        "    c1r0 = allI()",
        "    c1 = rule(c0.body, c1r0)",
        "  }",
        "}",
        "c2 = simp(c0, c2r0)",
        "c3 = append(c2, first: c4, second: c6) {",
        "  first {",
        "    c4r0 = refl()",
        "    c4 = rule(c3.first, c4r0)",
        "  }",
        "  second {",
        "    c5r0 = math[use=[addComm]]()",
        "    c6r0 = refl()",
        "    c5 = rw(c3.second, c5r0)",
        "    c6 = rule(c5, c6r0)",
        "  }",
        "}",
        "out <- c3"
      ],
      "naive": [
        "c2r0 = math[use=[\"def.0\", \"def.1\", addZero, addSucc, addComm]]()",
        "c3r0 = refl()",
        "c0 = repeat(in, body: c1) {",
        "  body {",
        "    c1r0 = allI()",
        "    c1 = rule(c0.body, c1r0)",
        "  }",
        "}",
        "c2 = simp(c0, c2r0)",
        "c3 = rule(c2, c3r0)",
        "out <- c3"
      ]
    }
  ]
}
