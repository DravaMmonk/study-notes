          "goal": "((A → B) → A) → A"
        }
      ],
      "cases": [
        {
          "A": "Rain",
          "B": "Wet"
        },
        {
          "A": "Exam",
          "B": "Pass"
        }
      ],
      "hint": [
        "@level.peirce.tasks.peirce.hint.0",
        "@level.peirce.tasks.peirce.hint.1"
      ],
      "solution": [
        "f = impI[A=\"(A -> B) -> A\"](body: e) {",
        "  body {",
        "    l = lem[A=A]()",
        "    e = orE(l, left: e.left, right: m2) {",
        "      right {",
        "        g = impI[A=A](body: b) {",
        "          body {",
        "            m = mp(e.right, g.body)",
        "            b = botE[C=B](m)",
        "          }",
        "        }",
        "        m2 = mp(f.body, g)",
        "      }",
        "    }",
        "  }",
        "}",
        "goal <- f"
      ],
      "naive": [
        "f = impI[A=\"(A -> B) -> A\"](body: f.body)",
        "goal <- f"
      ]
    }
  ]
