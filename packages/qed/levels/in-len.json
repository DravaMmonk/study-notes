  ],
  "tasks": [
    {
      "id": "in-len",
      "kind": "logic:machine",
      "want": "logic:want-proved",
      "inputs": [
        {
          "name": "in",
          "label": "@level.in-len.tasks.in-len.inputs.0.label"
        }
      ],
      "backtrack": true,
      "words": [
        "qed/everyday",
        "qed/terms"
      ],
      "types": [
        "list"
      ],
      "defs": [
        "app",
        "len",
        "plus"
      ],
      "tests": [
        {
          "goal": "∀xs. ∀ys. len(app(xs, ys)) = plus(len(xs), len(ys))"
        }
      ],
      "brief": "@level.in-len.tasks.in-len.brief",
      "hint": [
        "@level.in-len.tasks.in-len.hint.0"
      ],
      "solution": [
        "c0r0 = math[use=[\"list.induct\"]]()",
        "c0 = rule(in, c0r0)",
        "c1 = each(c0, body: c4) {",
        "  body {",
        "    c2r0 = allI()",
        "    c3r0 = math[use=[\"def.0\", \"def.1\", \"def.2\", \"def.3\", \"def.4\", \"def.5\"]]()",
        "    c4r0 = refl()",
        "    c3r6 = logic:hyp(c3r0)",
        "    c2 = rule(c1.body, c2r0)",
        "    c3 = simp(c2, c3r6)",
        "    c4 = rule(c3, c4r0)",
        "  }",
        "}",
        "out <- c1"
      ]
    }
  ]
}
