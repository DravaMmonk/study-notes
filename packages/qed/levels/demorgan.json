{
  "title": "@level.demorgan.title",
  "tray": ["proof", "formula"],
  "intro": [
    {
      "t": "@level.demorgan.intro.0.t"
    }
  ],
  "tasks": [
    {
      "id": "demorgan_1",
      "kind": "proof",
      "step": "@level.demorgan.tasks.demorgan_1.step",
      "tests": [{ "premises": { "p": "¬(A ∨ B)" }, "goal": "¬A ∧ ¬B" }],
      "cases": [{ "A": "Sat", "B": "Sun" }, { "A": "Rain", "B": "Wind" }],
      "hint": [
        "@level.demorgan.tasks.demorgan_1.hint.0",
        "@level.demorgan.tasks.demorgan_1.hint.1"
      ],
      "solution": [
        "na = impI[A=A](body: m) {",
        "  body {",
        "    i = orI[other=B, side=right](na.body)",
        "    m = mp(p, i)",
        "  }",
        "}",
        "nb = impI[A=B](body: m2) {",
        "  body {",
        "    i2 = orI[other=A, side=left](nb.body)",
        "    m2 = mp(p, i2)",
        "  }",
        "}",
        "c = andI(na, nb)",
        "goal <- c"
      ]
    },
    {
      "id": "demorgan_2",
      "kind": "proof",
      "step": "@level.demorgan.tasks.demorgan_2.step",
      "tests": [{ "premises": { "p": "¬A ∧ ¬B" }, "goal": "¬(A ∨ B)" }],
      "cases": [{ "A": "Sat", "B": "Sun" }, { "A": "Rain", "B": "Wind" }],
      "hint": [
        "@level.demorgan.tasks.demorgan_2.hint.0",
        "@level.demorgan.tasks.demorgan_2.hint.1"
      ],
      "solution": [
        "f = impI[A=\"A | B\"](body: o) {",
        "  body {",
        "    o = orE(f.body, left: m1, right: m2) {",
        "      left {",
        "        m1 = mp(e.left, o.left)",
        "      }",
        "      right {",
        "        m2 = mp(e.right, o.right)",
        "      }",
        "    }",
        "  }",
        "}",
        "e = andE(p)",
        "goal <- f"
      ]
    },
    {
      "id": "demorgan_3",
      "kind": "proof",
      "step": "@level.demorgan.tasks.demorgan_3.step",
      "tests": [{ "premises": { "p": "¬A ∨ ¬B" }, "goal": "¬(A ∧ B)" }],
      "cases": [{ "A": "Sat", "B": "Sun" }, { "A": "Rain", "B": "Wind" }],
      "hint": [
        "@level.demorgan.tasks.demorgan_3.hint.0",
        "@level.demorgan.tasks.demorgan_3.hint.1"
      ],
      "solution": [
        "f = impI[A=\"A & B\"](body: o) {",
        "  body {",
        "    e = andE(f.body)",
        "    o = orE(p, left: m1, right: m2) {",
        "      left {",
        "        m1 = mp(o.left, e.left)",
        "      }",
        "      right {",
        "        m2 = mp(o.right, e.right)",
        "      }",
        "    }",
        "  }",
        "}",
        "goal <- f"
      ]
    },
    {
      "id": "demorgan_4",
      "kind": "proof",
      "step": "@level.demorgan.tasks.demorgan_4.step",
      "tests": [{ "premises": { "p": "¬(A ∧ B)" }, "goal": "¬A ∨ ¬B" }],
      "cases": [{ "A": "Sat", "B": "Sun" }, { "A": "Rain", "B": "Wind" }],
      "hint": [
        "@level.demorgan.tasks.demorgan_4.hint.0",
        "@level.demorgan.tasks.demorgan_4.hint.1"
      ],
      "solution": [
        "l = lem[A=A]()",
        "e = orE(l, left: i1, right: i2) {",
        "  left {",
        "    g = impI[A=B](body: m) {",
        "      body {",
        "        c = andI(e.left, g.body)",
        "        m = mp(p, c)",
        "      }",
        "    }",
        "    i1 = orI[other=\"~A\", side=left](g)",
        "  }",
        "  right {",
        "    i2 = orI[other=\"~B\", side=right](e.right)",
        "  }",
        "}",
        "goal <- e"
      ]
    }
  ]
}
