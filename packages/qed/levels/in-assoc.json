{
  "title": "@level.in-assoc.title",
  "tray": ["machine", "formula"],
  "tasks": [
    {
      "id": "in-assoc",
      "kind": "machine",
      "want": "proved",
      "inputs": [{ "name": "in", "label": "@level.in-assoc.tasks.in-assoc.inputs.0.label" }],
      "backtrack": true,
      "words": ["everyday", "terms"],
      "types": ["nat"],
      "defs": ["plus"],
      "tests": [{ "goal": "∀x. ∀y. ∀z. plus(plus(x, y), z) = plus(x, plus(y, z))" }],
      "brief": "@level.in-assoc.tasks.in-assoc.brief",
      "hint": ["@level.in-assoc.tasks.in-assoc.hint.0"],
      "solution": [
        "c0r0 = math[use=[\"nat.induct\"]]()",
        "c0 = rule(in, c0r0)",
        "c1 = each(c0, body: c5) {",
        "  body {",
        "    c2r0 = math[use=[\"def.0\", \"def.1\"]]()",
        "    c5r0 = refl()",
        "    c2r2 = hyp(c2r0)",
        "    c2 = simp(c1.body, c2r2)",
        "    c3 = repeat(c2, body: c4) {",
        "      body {",
        "        c4r0 = allI()",
        "        c4 = rule(c3.body, c4r0)",
        "      }",
        "    }",
        "    c5 = rule(c3, c5r0)",
        "  }",
        "}",
        "out <- c1"
      ]
    }
  ]
}
