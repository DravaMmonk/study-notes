      "id": "sp-under",
      "kind": "machine",
      "want": "proved",
      "inputs": [{ "name": "in", "label": "@level.sp-under.tasks.sp-under.inputs.0.label" }],
      "backtrack": true,
      "words": ["everyday", "terms"],
      "defs": ["plus"],
      "tests": [
        { "goal": "∀x. plus(zero, plus(zero, x)) = x" },
        { "goal": "∀x. ∀y. plus(s(zero), plus(x, y)) = s(plus(x, y))" }
      ],
      "brief": "@level.sp-under.tasks.sp-under.brief",
      "hint": ["@level.sp-under.tasks.sp-under.hint.0"],
      "solution": [
        "c0r0 = math[use=[\"def.0\", \"def.1\"]]()",
        "c3r0 = refl()",
        "c0 = simp(in, c0r0)",
        "c1 = repeat(c0, body: c2) {",
        "  body {",
        "    c2r0 = allI()",
        "    c2 = rule(c1.body, c2r0)",
        "  }",
        "}",
        "c3 = rule(c1, c3r0)",
        "out <- c3"
      ]
    }
  ]
}
