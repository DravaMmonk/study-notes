{
  "title": "@level.u-halt.title",
  "tray": ["#proof", "#formula"],
  "after": "@level.u-halt.after",
  "tasks": [
    {
      "id": "u-halt",
      "kind": "proof",
      "tests": [
        {
          "premises": { "con": "(∃x. H(x)) → ∃x. ∀y. T(x, c(y)) ↔ ¬T(y, c(y))", "red": "(∃x. G(x)) → ∃x. H(x)" },
          "goal": "¬∃x. G(x)"
        }
      ],
      "cases": [{ "H": "DecH", "G": "DecA", "T": "Halts" }],
      "brief": "@level.u-halt.tasks.u-halt.brief",
      "hint": [
        "@level.u-halt.tasks.u-halt.hint.0",
        "@level.u-halt.tasks.u-halt.hint.1"
      ],
      "solution": [
        "h = impI[A=\"exists x. G(x)\"](body: e) {",
        "  body {",
        "    m1 = mp(red, h.body)",
        "    m2 = mp(con, m1)",
        "    e = exE[x=a](m2, body: l) {",
        "      body {",
        "        a = allE[t=a](e.body)",
        "        l = liar(a)",
        "      }",
        "    }",
        "  }",
        "}",
        "goal <- h"
      ]
    }
  ]
}
