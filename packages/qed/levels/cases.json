{
  "title": "@level.cases.title",
  "tray": [
    "#proof",
    "#formula"
  ],
  "intro": [
    {
      "t": "@level.cases.intro.0.t"
    },
    {
      "t": "@level.cases.intro.1.t"
    },
    {
      "t": "@level.cases.intro.2.t"
    }
  ],
  "tasks": [
    {
      "id": "cases",
      "kind": "logic:proof",
      "tests": [
        {
          "premises": {
            "p": "A ∨ B",
            "q": "A → C",
            "r": "B → C"
          },
          "goal": "C"
        }
      ],
      "cases": [
        {
          "A": "Bus",
          "B": "Bike",
          "C": "OnTime"
        },
        {
          "A": "Sat",
          "B": "Sun",
          "C": "Rest"
        }
      ],
      "hint": [
        "@level.cases.tasks.cases.hint.0",
        "@level.cases.tasks.cases.hint.1",
        "@level.cases.tasks.cases.hint.2"
      ],
      "solution": [
        "e = orE(p, left: m, right: m2) {",
        "  left {",
        "    m = mp(q, e.left)",
        "  }",
        "  right {",
        "    m2 = mp(r, e.right)",
        "  }",
        "}",
        "goal <- e"
      ]
    }
  ]
}
