      "tests": [{ "premises": { "p": "A → (A → B)" }, "goal": "A → B" }],
      "cases": [{ "A": "Rain", "B": "Wet" }, { "A": "Hungry", "B": "Eat" }],
      "briefNote": "@level.x-merge.tasks.x-merge.briefNote",
      "hint": [
        "@level.x-merge.tasks.x-merge.hint.0",
        "@level.x-merge.tasks.x-merge.hint.1"
      ],
      "solution": [
        "s = axS[A=A, B=A, C=B]()",
        "s2 = axS[A=A, B=\"A -> A\", C=A]()",
        "k1 = axK[A=A, B=\"A -> A\"]()",
        "k2 = axK[A=A, B=A]()",
        "m = mp(s, p)",
        "m1 = mp(s2, k1)",
        "m2 = mp(m1, k2)",
        "m3 = mp(m, m2)",
        "goal <- m3"
      ]
    }
