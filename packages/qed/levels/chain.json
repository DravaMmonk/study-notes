{
  "title": "@level.chain.title",
  "tray": ["#proof", "#formula"],
  "intro": [
    {
      "t": "@level.chain.intro.0.t"
    },
    {
      "t": "@level.chain.intro.1.t"
    }
  ],
  "after": "@level.chain.after",
  "tasks": [
    {
      "id": "chain",
      "kind": "proof",
      "tests": [{ "premises": { "p": "A → B", "q": "B → C" }, "goal": "A → C" }],
      "cases": [{ "A": "Rain", "B": "Wet", "C": "Slip" }, { "A": "Alarm", "B": "Up", "C": "OnTime" }],
      "hint": ["@level.chain.tasks.chain.hint.0"],
      "solution": [
        "f = impI[A=A](body: m2) {",
        "  body {",
        "    m1 = mp(p, f.body)",
        "    m2 = mp(q, m1)",
        "  }",
        "}",
        "goal <- f"
      ],
      "publishes": [{ "piece": "chain", "variant": "base" }]
    }
  ]
}
