{
  "title": "@level.in-comm.title",
  "tray": "machine-formula",
  "tasks": [
    {
      "id": "in-comm",
      "kind": "logic:machine",
      "want": "logic:want-proved",
      "inputs": [
        {
          "name": "in",
          "label": "@level.in-comm.tasks.in-comm.inputs.0.label"
        }
      ],
      "backtrack": true,
      "words": [
        "qed/everyday",
        "qed/terms"
      ],
      "types": [
        "nat"
      ],
      "defs": [
        "plus"
      ],
      "tests": [
        {
          "goal": "∀x. ∀y. plus(x, y) = plus(y, x)"
        }
      ],
      "brief": "@level.in-comm.tasks.in-comm.brief",
      "hint": [
        "@level.in-comm.tasks.in-comm.hint.0",
        "@level.in-comm.tasks.in-comm.hint.1"
      ],
      "solution": [
        "c0r0 = math[use=[\"nat.induct\"]]()",
        "c0 = rule(in, c0r0)",
        "c1 = each(c0, body: c4) {",
        "  body {",
        "    c2r0 = allI()",
        "    c3r0 = math[use=[\"def.0\", \"def.1\", addZero, addSucc]]()",
        "    c4r0 = refl()",
        "    c3r4 = logic:hyp(c3r0)",
        "    c2 = rule(c1.body, c2r0)",
        "    c3 = simp(c2, c3r4)",
        "    c4 = rule(c3, c4r0)",
        "  }",
        "}",
        "out <- c1"
      ],
      "naive": [
        "c0r0 = math[use=[\"nat.induct\"]]()",
        "c0 = rule(in, c0r0)",
        "c1 = each(c0, body: c4) {",
        "  body {",
        "    c2r0 = allI()",
        "    c3r0 = math[use=[\"def.0\", \"def.1\"]]()",
        "    c4r0 = refl()",
        "    c3r2 = logic:hyp(c3r0)",
        "    c2 = rule(c1.body, c2r0)",
        "    c3 = simp(c2, c3r2)",
        "    c4 = rule(c3, c4r0)",
        "  }",
        "}",
        "out <- c1"
      ],
      "publishes": [
        {
          "part": "addComm",
          "variant": "base"
        }
      ]
    }
  ]
}
