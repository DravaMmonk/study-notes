  "tasks": [
    {
      "id": "s-mix",
      "kind": "machine",
      "want": "proved",
      "inputs": [{ "name": "in", "label": "@level.s-mix.tasks.s-mix.inputs.0.label" }],
      "tests": [
        { "goal": "Rain → (Wind → Rain ∧ Wind)" },
        { "goal": "(Rain → Rain) ∧ (Wind → (Rain → Wind))" },
        { "goal": "Rain → (Wind → Wind ∧ (Rain ∧ Wind))" }
      ],
      "brief": "@level.s-mix.tasks.s-mix.brief",
      "hint": [
        "@level.s-mix.tasks.s-mix.hint.0",
        "@level.s-mix.tasks.s-mix.hint.1"
      ],
      "solution": [
        "c0 = repeat(in, body: c1) {",
        "  body {",
        "    c1 = append[ways=\"3\"](c0.body, first: c2, second: c3, third: c4) {",
        "      first {",
        "        c2 = assumption(c1.first)",
        "      }",
        "      second {",
        "        c3r0 = impI()",
        "        c3 = rule(c1.second, c3r0)",
        "      }",
        "      third {",
        "        c4r0 = andI()",
        "        c4 = rule(c1.third, c4r0)",
        "      }",
        "    }",
        "  }",
        "}",
        "out <- c0"
      ]
    }
  ]
}
