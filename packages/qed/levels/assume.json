        "goal <- p"
      ]
    },
    {
      "id": "assume_2",
      "kind": "logic:proof",
      "step": "@level.assume.tasks.assume_2.step",
      "tests": [
        {
          "premises": {
            "p": "A"
          },
          "goal": "B → (C → A)"
        }
      ],
      "cases": [
        {
          "A": "Rain",
          "B": "Sat",
          "C": "Wind"
        },
        {
          "A": "Coffee",
          "B": "Late",
          "C": "Tea"
        }
      ],
      "hint": [
        "@level.assume.tasks.assume_2.hint.0"
      ],
      "intro": [
        {
          "t": "@level.assume.tasks.assume_2.intro.0.t"
        }
      ],
      "solution": [
        "f = impI[A=B](body: g) {",
        "  body {",
        "    g = impI[A=C](body: p)",
        "  }",
        "}",
        "goal <- f"
      ]
    }
  ]
