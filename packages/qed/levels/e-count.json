      "id": "e-count",
      "kind": "gates",
      "target": "(KA ↔ (¬KA ∨ ¬KB ∨ ¬KC)) ∧ (KB ↔ ((KA ∨ KB) ∧ (KA ∨ KC) ∧ (KB ∨ KC))) ∧ (KC ↔ (¬KA ∨ KB ∨ KC))",
      "blind": true,
      "brief": "@level.e-count.tasks.e-count.brief",
      "hint": [
        "@level.e-count.tasks.e-count.hint.0",
        "@level.e-count.tasks.e-count.hint.1",
        "@level.e-count.tasks.e-count.hint.2"
      ],
      "solution": [
        "na = gNot(KA)",
        "nb = gNot(KB)",
        "nc = gNot(KC)",
        "p1 = gOr(KA, KB)",
        "p2 = gOr(KA, KC)",
        "p3 = gOr(KB, KC)",
        "o1 = gOr(na, nb)",
        "q1 = gAnd(p1, p2)",
        "r1 = gOr(na, KB)",
        "o2 = gOr(o1, nc)",
        "q2 = gAnd(q1, p3)",
        "r2 = gOr(r1, KC)",
        "e1 = gIff(KA, o2)",
        "e2 = gIff(KB, q2)",
        "e3 = gIff(KC, r2)",
        "x1 = gAnd(e1, e2)",
        "x2 = gAnd(x1, e3)",
        "out <- x2"
      ]
    }
  ]
}
