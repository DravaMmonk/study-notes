{
  "name": "@piece.axK.name",
  "desc": "@piece.axK.desc",
  "family": "logic:family-lemma",
  "settings": {
    "A": { "control": "tree", "label": "@piece.axK.settings.A.label" },
    "B": { "control": "tree", "label": "@piece.axK.settings.B.label" }
  },
  "inside": [
    {
      "id": "base",
      "reference": {
        "kind": "logic:proof",
        "solution": [
          "f = impI[A=A](body: g) {",
          "  body {",
          "    g = impI[A=B](body: f.body)",
          "  }",
          "}",
          "goal <- f"
        ],
        "tests": [{ "goal": "A → (B → A)" }]
      }
    }
  ],
  "inputs": [],
  "outputType": "logic:judgment"
}
