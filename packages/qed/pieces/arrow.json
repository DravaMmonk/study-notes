{
  "name": "@piece.arrow.name",
  "desc": "@piece.arrow.desc",
  "family": "logic:family-lemma",
  "settings": { "A": { "control": "tree" }, "B": { "control": "tree" } },
  "inside": [
    {
      "id": "elim",
      "form": "elim",
      "label": "A → B ⟹ ¬A ∨ B",
      "reference": {
        "kind": "logic:proof",
        "solution": [
          "l = lem[A=A]()",
          "e = orE(l, left: i1, right: i2) {",
          "  left {",
          "    m = mp(p, e.left)",
          "    i1 = orI[other=\"~A\", side=left](m)",
          "  }",
          "  right {",
          "    i2 = orI[other=B, side=right](e.right)",
          "  }",
          "}",
          "goal <- e"
        ],
        "tests": [{ "goal": "¬A ∨ B", "premises": { "p": "A → B" } }]
      }
    },
    {
      "id": "intro",
      "form": "intro",
      "label": "¬A ∨ B ⟹ A → B",
      "reference": {
        "kind": "logic:proof",
        "solution": [
          "f = impI[A=A](body: e) {",
          "  body {",
          "    e = orE(p, left: b, right: e.right) {",
          "      left {",
          "        m = mp(e.left, f.body)",
          "        b = botE[C=B](m)",
          "      }",
          "    }",
          "  }",
          "}",
          "goal <- f"
        ],
        "tests": [{ "goal": "A → B", "premises": { "p": "¬A ∨ B" } }]
      }
    }
  ],
  "inputs": [{ "name": "p0", "type": "logic:judgment" }],
  "outputType": "logic:judgment"
}
