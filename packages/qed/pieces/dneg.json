{
  "name": "@piece.dneg.name",
  "desc": "@piece.dneg.desc",
  "family": "logic:family-lemma",
  "settings": { "A": { "control": "tree" } },
  "inside": [
    {
      "id": "elim",
      "form": "elim",
      "label": "¬¬A → A",
      "reference": {
        "kind": "logic:proof",
        "solution": ["r = raa(p)", "goal <- r"],
        "tests": [{ "goal": "A", "premises": { "p": "¬¬A" } }]
      }
    },
    {
      "id": "intro",
      "form": "intro",
      "label": "A → ¬¬A",
      "reference": {
        "kind": "logic:proof",
        "solution": [
          "f = impI[A=\"~A\"](body: m) {",
          "  body {",
          "    m = mp(f.body, p)",
          "  }",
          "}",
          "goal <- f"
        ],
        "tests": [{ "goal": "¬¬A", "premises": { "p": "A" } }]
      }
    }
  ],
  "inputs": [{ "name": "p0", "type": "logic:judgment" }],
  "outputType": "logic:judgment"
}
