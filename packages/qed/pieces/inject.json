{
  "name": "@piece.inject.name",
  "desc": "@piece.inject.desc",
  "family": "logic:family-rule",
  "inside": [
    {
      "id": "base",
      "reference": {
        "kind": "logic:proof",
        "solution": [
          "gx = allI[x=a](body: gy) {",
          "  body {",
          "    gy = allI[x=b](body: f) {",
          "      body {",
          "        f = impI[A=\"s(a) = s(b)\"](body: w2) {",
          "          body {",
          "            e1 = allE[t=a](p)",
          "            e2 = allE[t=b](p)",
          "            w1 = rewrite[at=[0]](f.body, e1)",
          "            w2 = rewrite[at=[0]](w1, e2)",
          "          }",
          "        }",
          "      }",
          "    }",
          "  }",
          "}",
          "goal <- gx"
        ],
        "rule": { "premises": ["s(?x) = s(?y)", "⟦?x = ?y⟧ ⟹ ?C"], "conclusion": "?C" },
        "tests": [{ "goal": "∀x. ∀y. s(x) = s(y) → x = y", "premises": { "p": "∀x. pred(s(x)) = x" } }]
      }
    }
  ],
  "inputs": [{ "name": "before", "type": "logic:machine-value", "optional": true }],
  "outputType": "logic:machine-value"
}
