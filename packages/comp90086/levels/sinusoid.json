{
  "title": "@level.sinusoid.title",
  "intro": [],
  "after": "@level.sinusoid.after",
  "tasks": [
    {
      "id": "sinusoid",
      "play": "image:board",
      "brief": "@level.sinusoid.tasks.sinusoid.brief",
      "bench": {
        "model": "image:benchModel-wave",
        "setup": { "N": 32 },
        "knobs": {
          "c": {
            "label": "@level.sinusoid.tasks.sinusoid.bench.knobs.c.label",
            "min": 0,
            "max": 1,
            "step": 0.05,
            "format": "auto"
          },
          "A": {
            "label": "@level.sinusoid.tasks.sinusoid.bench.knobs.A.label",
            "min": 0,
            "max": 0.5,
            "step": 0.05,
            "format": "auto"
          },
          "k": {
            "label": "@level.sinusoid.tasks.sinusoid.bench.knobs.k.label",
            "min": 0,
            "max": 12,
            "step": 1,
            "format": "auto"
          },
          "phi": {
            "label": "@level.sinusoid.tasks.sinusoid.bench.knobs.phi.label",
            "min": -4,
            "max": 4,
            "step": 1,
            "format": "quarterPi"
          }
        },
        "check": "submit",
        "goal": [{ "of": "gap", "below": 0.000001 }],
        "stages": [
          {
            "title": "@level.sinusoid.tasks.sinusoid.bench.stages.0.title",
            "note": "@level.sinusoid.tasks.sinusoid.bench.stages.0.note",
            "start": { "c": 0.5, "A": 0.3, "k": 2, "phi": 0 },
            "target": { "c": 0.5, "A": 0.3, "k": 2, "phi": 2 }
          },
          {
            "title": "@level.sinusoid.tasks.sinusoid.bench.stages.1.title",
            "note": "@level.sinusoid.tasks.sinusoid.bench.stages.1.note",
            "start": { "c": 0.5, "A": 0.3, "k": 3, "phi": 0 },
            "target": { "c": 0.5, "A": 0.3, "k": 3, "phi": 4 }
          }
        ],
        "layout": {
          "main": [
            {
              "image:display-plot": {
                "lines": [
                  {
                    "of": "target",
                    "kind": "target",
                    "label": "@level.sinusoid.tasks.sinusoid.bench.layout.main.0.plot.lines.0.label",
                    "legend": "@level.sinusoid.tasks.sinusoid.bench.layout.main.0.plot.lines.0.legend"
                  },
                  {
                    "of": "yours",
                    "kind": "yours",
                    "label": "@level.sinusoid.tasks.sinusoid.bench.layout.main.0.plot.lines.1.label",
                    "legend": "@level.sinusoid.tasks.sinusoid.bench.layout.main.0.plot.lines.1.legend"
                  }
                ],
                "height": [240, 200],
                "legend": true
              }
            },
            {
              "image:display-strips": {
                "rows": [
                  {
                    "of": "targetRow",
                    "label": "@level.sinusoid.tasks.sinusoid.bench.layout.main.1.strips.rows.0.label"
                  },
                  {
                    "of": "row",
                    "label": "@level.sinusoid.tasks.sinusoid.bench.layout.main.1.strips.rows.1.label"
                  }
                ]
              }
            }
          ],
          "side": [
            { "panel": ["image:display-step", "image:display-knobs", "image:display-verdict"] },
            "image:display-stages"
          ]
        }
      }
    }
  ]
}
