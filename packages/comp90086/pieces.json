{
  "settings": {
    "border": {
      "label": "@setting.border.label",
      "control": "select",
      "options": [
        {
          "value": "zero",
          "label": "@setting.border.options.0.label"
        },
        {
          "value": "edge",
          "label": "@setting.border.options.1.label"
        }
      ],
      "default": "zero"
    },
    "line3_axis": {
      "label": "@setting.line3_axis.label",
      "control": "select",
      "options": [
        {
          "value": "x",
          "label": "@setting.line3_axis.options.0.label"
        },
        {
          "value": "y",
          "label": "@setting.line3_axis.options.1.label"
        }
      ],
      "default": "x"
    },
    "line3_a": {"label": "a", "control": "number", "min": -4, "max": 4, "step": 1, "default": 0},
    "line3_b": {"label": "b", "control": "number", "min": -4, "max": 4, "step": 1, "default": 1},
    "line3_c": {"label": "c", "control": "number", "min": -4, "max": 4, "step": 1, "default": 0}
  },
  "parts": {
    "line3": {
      "name": "@piece.line3.name",
      "desc": "@piece.line3.desc",
      "icon": "Grid3x3",
      "family": "neighbour",
      "inputs": [{ "name": "in", "label": "" }],
      "settings": [{"key": "axis", "setting": "line3_axis"}, {"key": "a", "setting": "line3_a"}, {"key": "b", "setting": "line3_b"}, {"key": "c", "setting": "line3_c"}, {"key": "border", "setting": "border"}],
      "compute": "image_line3(in, $axis, $a, $b, $c, $border)"
    },
    "add": {
      "name": "@piece.add.name",
      "desc": "@piece.add.desc",
      "icon": "Calculator",
      "family": "pixel",
      "inputs": [{ "name": "a", "label": "a" }, { "name": "b", "label": "b" }],
      "compute": "image_add(a, b)"
    }
  }
}
