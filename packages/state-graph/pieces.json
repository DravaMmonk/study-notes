{
  "settings": {
    "value_value": {
      "control": "number",
      "default": 0.9
    }
  },
  "parts": {
    "counter": {
      "name": "@piece.counter.name",
      "desc": "@piece.counter.desc",
      "inside": [
        {
          "id": "base",
          "reference": {
            "mode": "table:circuit",
            "solution": [
              "k = table:const[value=1]()",
              "g = table:pass(facts.start, k)",
              "m = table:msum(view.up, view.left, g)",
              "cell <- m"
            ],
            "world": "table:world-grid",
            "robot": "table:robot-scout",
            "ports": [
              {
                "table:port-way": {
                  "n": 1,
                  "sensor": "up"
                }
              },
              {
                "table:port-way": {
                  "n": 2,
                  "sensor": "left"
                }
              },
              {
                "table:port-start": {
                  "sensor": "start"
                }
              }
            ],
            "facts": [
              "start"
            ]
          }
        }
      ],
      "inputs": [
        {
          "name": "up",
          "type": "circuit:number"
        },
        {
          "name": "left",
          "type": "circuit:number"
        },
        {
          "name": "start",
          "type": "circuit:boolean"
        }
      ],
      "outputType": "circuit:number"
    },
    "order": {
      "name": "@piece.order.name",
      "desc": "@piece.order.desc",
      "inside": [
        {
          "id": "base",
          "reference": {
            "mode": "table:circuit",
            "solution": [
              "c = counter(view.right, view.down, facts.end)",
              "cell <- c"
            ],
            "world": "table:world-grid",
            "robot": "table:robot-ranger",
            "facts": [
              "start",
              "end"
            ]
          }
        }
      ]
    },
    "min": {
      "name": "@piece.min.name",
      "desc": "@piece.min.desc",
      "inside": [
        {
          "id": "base",
          "reference": {
            "mode": "table:circuit",
            "solution": [
              "m = table:mmin(view.left, view.ul, way3)",
              "k = table:const[value=0]()",
              "g = table:pass(facts.start, k)",
              "s = table:mmin(m, g)",
              "a = table:add(s, facts.cost)",
              "cell <- a"
            ],
            "world": "table:world-grid",
            "robot": "table:robot-scout",
            "ports": [
              {
                "table:port-way": {
                  "n": 1,
                  "sensor": "left"
                }
              },
              {
                "table:port-way": {
                  "n": 2,
                  "sensor": "ul"
                }
              },
              {
                "table:port-start": {
                  "sensor": "start"
                }
              },
              {
                "table:port-named": {
                  "label": "cost",
                  "short": "cost",
                  "sensor": "cost"
                }
              },
              {
                "table:port-way": {
                  "n": 3,
                  "input": "way3"
                }
              }
            ],
            "facts": [
              "start",
              "cost"
            ]
          }
        }
      ],
      "inputs": [
        {
          "name": "left",
          "type": "circuit:number"
        },
        {
          "name": "ul",
          "type": "circuit:number"
        },
        {
          "name": "start",
          "type": "circuit:boolean"
        },
        {
          "name": "cost",
          "type": "circuit:number"
        },
        {
          "name": "way3",
          "type": "circuit:number"
        }
      ],
      "outputType": "circuit:number"
    },
    "layer": {
      "name": "@piece.layer.name",
      "desc": "@piece.layer.desc",
      "inside": [
        {
          "id": "base",
          "reference": {
            "mode": "table:circuit",
            "solution": [
              "n = table:mmax(view.pn, view.pr)",
              "a = table:add(view.pn, facts.money)",
              "b = table:mmax(n, a)",
              "no <- n",
              "yes <- a",
              "best <- b"
            ],
            "world": "table:world-rob2",
            "robot": "table:robot-stack",
            "facts": [
              "money"
            ]
          }
        }
      ]
    },
    "align": {
      "name": "@piece.align.name",
      "desc": "@piece.align.desc",
      "inside": [
        {
          "id": "base",
          "reference": {
            "mode": "table:circuit",
            "solution": [
              "k = table:const[value=1]()",
              "a = table:add(view.ul, k)",
              "g = table:pass(facts.same, a)",
              "m = table:mmax(view.up, view.left, g)",
              "cell <- m"
            ],
            "world": "table:world-align",
            "robot": "table:robot-ranger",
            "facts": [
              "same"
            ]
          }
        }
      ]
    },
    "cost": {
      "name": "@piece.cost.name",
      "desc": "@piece.cost.desc",
      "inside": [
        {
          "id": "base",
          "reference": {
            "mode": "table:circuit",
            "solution": [
              "k = table:const[value=1]()",
              "n = table:mmin(view.up, view.left, view.ul)",
              "z = table:const[value=0]()",
              "g1 = table:pass(facts.same, view.ul)",
              "a = table:add(n, k)",
              "g0 = table:pass(facts.start, z)",
              "m = table:mmin(a, g1, g0)",
              "cell <- m"
            ],
            "world": "table:world-align",
            "robot": "table:robot-ranger",
            "ports": [
              {
                "table:port-reads": "ul"
              },
              {
                "table:port-reads": "up"
              },
              {
                "table:port-reads": "left"
              },
              {
                "table:port-reads": "same"
              },
              {
                "table:port-reads": "start"
              }
            ],
            "facts": [
              "same",
              "start"
            ]
          }
        }
      ],
      "inputs": [
        {
          "name": "ul",
          "type": "circuit:number"
        },
        {
          "name": "up",
          "type": "circuit:number"
        },
        {
          "name": "left",
          "type": "circuit:number"
        },
        {
          "name": "same",
          "type": "circuit:boolean"
        },
        {
          "name": "start",
          "type": "circuit:boolean"
        }
      ],
      "outputType": "circuit:number"
    },
    "choose": {
      "name": "@piece.choose.name",
      "desc": "@piece.choose.desc",
      "inside": [
        {
          "id": "base",
          "reference": {
            "mode": "table:circuit",
            "solution": [
              "a = table:add(view.upk, facts.value)",
              "m = table:mmax(view.up, a)",
              "cell <- m"
            ],
            "world": "table:world-knap",
            "robot": "table:robot-reach",
            "ports": [
              {
                "table:port-named": {
                  "label": "up",
                  "short": "up",
                  "sensor": "up"
                }
              },
              {
                "table:port-named": {
                  "label": "upk",
                  "short": "upk",
                  "sensor": "upk"
                }
              },
              {
                "table:port-named": {
                  "label": "value",
                  "short": "value",
                  "sensor": "value"
                }
              }
            ],
            "facts": [
              "value"
            ]
          }
        }
      ],
      "inputs": [
        {
          "name": "up",
          "type": "circuit:number"
        },
        {
          "name": "upk",
          "type": "circuit:number"
        },
        {
          "name": "value",
          "type": "circuit:number"
        }
      ],
      "outputType": "circuit:number"
    },
    "roll": {
      "name": "@piece.roll.name",
      "desc": "@piece.roll.desc",
      "inside": [
        {
          "id": "base",
          "reference": {
            "mode": "table:circuit",
            "solution": [
              "a = table:add(view.src, facts.value)",
              "m = table:mmax(view.old, a)",
              "cell <- m"
            ],
            "world": "table:world-roll",
            "robot": "table:robot-reach",
            "facts": [
              "value"
            ],
            "dirs": {
              "01": "desc",
              "inf": "asc"
            }
          }
        }
      ]
    },
    "judge": {
      "name": "@piece.judge.name",
      "desc": "@piece.judge.desc",
      "inside": [
        {
          "id": "base",
          "reference": {
            "mode": "table:circuit",
            "solution": [
              "a = table:not(view.up)",
              "b = table:not(view.left)",
              "c = table:not(view.ul)",
              "m = table:many(a, b, c)",
              "cell <- m"
            ],
            "world": "table:world-piles",
            "robot": "table:robot-ranger"
          }
        }
      ]
    },
    "sweep": {
      "name": "@piece.sweep.name",
      "desc": "@piece.sweep.desc",
      "inside": [
        {
          "id": "base",
          "reference": {
            "mode": "table:circuit",
            "solution": [
              "a = table:add(view.prev, facts.money)",
              "cell <- a"
            ],
            "world": "table:world-prefix",
            "robot": "table:robot-broom",
            "facts": [
              "money"
            ]
          }
        }
      ]
    },
    "wordbreak": {
      "name": "@piece.wordbreak.name",
      "desc": "@piece.wordbreak.desc",
      "inside": [
        {
          "id": "base",
          "reference": {
            "mode": "table:circuit",
            "solution": [
              "a = table:add(view.seg, view.cost)",
              "z = table:const[value=0]()",
              "g = table:pass(facts.ground, z)",
              "m = table:mmin(a, g)",
              "cell <- m"
            ],
            "world": "table:world-pieces",
            "robot": "table:robot-broom",
            "facts": [
              "ground"
            ]
          }
        }
      ]
    },
    "interval": {
      "name": "@piece.interval.name",
      "desc": "@piece.interval.desc",
      "inside": [
        {
          "id": "base",
          "reference": {
            "mode": "table:circuit",
            "solution": [
              "a = table:add(view.segL, view.segR)",
              "m = table:mmin(a)",
              "b = table:add(m, facts.weight)",
              "cell <- b"
            ],
            "world": "table:world-interval",
            "robot": "table:robot-broom",
            "ports": [
              {
                "table:port-reads": "segL"
              },
              {
                "table:port-reads": "segR"
              },
              {
                "table:port-reads": "weight"
              }
            ],
            "facts": [
              "weight"
            ]
          }
        }
      ],
      "inputs": [
        {
          "name": "segL",
          "type": "table:number-input"
        },
        {
          "name": "segR",
          "type": "table:number-input"
        },
        {
          "name": "weight",
          "type": "circuit:number"
        }
      ],
      "outputType": "circuit:number"
    },
    "anyorder": {
      "name": "@piece.anyorder.name",
      "desc": "@piece.anyorder.desc",
      "inside": [
        {
          "id": "base",
          "reference": {
            "mode": "table:circuit",
            "solution": [
              "c = interval(view.segL, view.segR, facts.weight)",
              "cell <- c"
            ],
            "world": "table:world-interval",
            "robot": "table:robot-broom",
            "facts": [
              "weight"
            ]
          }
        }
      ]
    },
    "value": {
      "name": "@piece.value.name",
      "desc": "@piece.value.desc",
      "inside": [
        {
          "id": "base",
          "reference": {
            "mode": "table:circuit",
            "solution": [
              "a = table:mmax(view.up, view.down, view.left)",
              "k = table:const[value=0.9]()",
              "b = table:mmax(a, view.right)",
              "x = table:mul(b, k)",
              "cell <- x"
            ],
            "world": "table:world-vgrid",
            "robot": "table:robot-loop",
            "ports": [
              {
                "table:port-way": {
                  "n": 1,
                  "sensor": "up"
                }
              },
              {
                "table:port-way": {
                  "n": 2,
                  "sensor": "down"
                }
              },
              {
                "table:port-way": {
                  "n": 3,
                  "sensor": "left"
                }
              },
              {
                "table:port-way": {
                  "n": 4,
                  "sensor": "right"
                }
              }
            ]
          }
        }
      ],
      "settings": [
        {
          "key": "value",
          "setting": "value_value"
        }
      ],
      "inputs": [
        {
          "name": "up",
          "type": "circuit:number"
        },
        {
          "name": "down",
          "type": "circuit:number"
        },
        {
          "name": "left",
          "type": "circuit:number"
        },
        {
          "name": "right",
          "type": "circuit:number"
        }
      ],
      "outputType": "circuit:number"
    },
    "expect": {
      "name": "@piece.expect.name",
      "desc": "@piece.expect.desc",
      "inside": [
        {
          "id": "base",
          "reference": {
            "mode": "table:circuit",
            "solution": [
              "k8 = table:const[value=0.8]()",
              "k2 = table:const[value=0.2]()",
              "k9 = table:const[value=0.9]()",
              "a = table:mul(k8, view.right)",
              "b = table:mul(k2, view.down)",
              "c = table:mul(k8, view.down)",
              "d = table:mul(k2, view.right)",
              "p = table:add(a, b)",
              "q = table:add(c, d)",
              "m = table:mmax(p, q)",
              "x = table:mul(m, k9)",
              "cell <- x"
            ],
            "world": "table:world-vgrid",
            "robot": "table:robot-loop",
            "facts": [
              "slip",
              "grip"
            ]
          }
        }
      ]
    },
    "viterbi": {
      "name": "@piece.viterbi.name",
      "desc": "@piece.viterbi.desc",
      "inside": [
        {
          "id": "base",
          "reference": {
            "mode": "table:circuit",
            "solution": [
              "a = table:add(view.pN, facts.tN)",
              "b = table:add(view.pV, facts.tV)",
              "c = table:add(view.pA, facts.tA)",
              "m = table:mmin(a, b, c)",
              "e = table:add(m, facts.emit)",
              "cell <- e"
            ],
            "world": "table:world-tags",
            "robot": "table:robot-reach",
            "facts": [
              "tN",
              "tV",
              "tA",
              "emit"
            ]
          }
        }
      ]
    },
    "local": {
      "name": "@piece.local.name",
      "desc": "@piece.local.desc",
      "inside": [
        {
          "id": "base",
          "reference": {
            "mode": "table:circuit",
            "solution": [
              "a = table:add(view.ul, facts.score)",
              "k = table:const[value=-1]()",
              "z = table:const[value=0]()",
              "b = table:add(view.up, k)",
              "c = table:add(view.left, k)",
              "m = table:mmax(a, b, c)",
              "n = table:mmax(m, z)",
              "cell <- n"
            ],
            "world": "table:world-local",
            "robot": "table:robot-ranger",
            "facts": [
              "score"
            ]
          }
        }
      ]
    },
    "seam": {
      "name": "@piece.seam.name",
      "desc": "@piece.seam.desc",
      "inside": [
        {
          "id": "base",
          "reference": {
            "mode": "table:seam"
          }
        }
      ]
    }
  }
}
