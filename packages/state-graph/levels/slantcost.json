{
  "title": "@level.slantcost.title",
  "short": "@level.slantcost.short",
  "intro": [
    {
      "t": "@level.slantcost.intro.0.t",
      "fig": {
        "grid": {
          "R": 3,
          "C": 4,
          "moves": [[0, 1], [1, 1]],
          "cells": {
            "0,0": { "corner": 2 },
            "0,1": { "corner": 1 },
            "0,2": { "corner": 3 },
            "0,3": { "corner": 1 },
            "1,0": { "corner": 1 },
            "1,1": { "corner": 4 },
            "1,2": { "corner": 1 },
            "1,3": { "corner": 2 },
            "2,0": { "corner": 1 },
            "2,1": { "corner": 1 },
            "2,2": { "corner": 2 },
            "2,3": { "corner": 1 }
          }
        }
      }
    },
    {
      "t": "@level.slantcost.intro.1.t"
    },
    {
      "t": "@level.slantcost.intro.2.t"
    },
    {
      "t": "@level.slantcost.intro.3.t",
      "fig": {
        "circuit": {
          "taps": [{ "id": "a", "label": "a · —" }, { "id": "b", "label": "b · 4" }],
          "parts": [{ "id": "p", "name": "@level.slantcost.intro.3.fig.circuit.parts.p.name", "tag": "a + b" }],
          "outs": [{ "id": "o", "label": "@level.slantcost.intro.3.fig.circuit.outs.o.label" }],
          "wires": [{ "from": "a", "to": "p", "kind": "off" }, { "from": "b", "to": "p" }, { "from": "p", "to": "o" }]
        }
      }
    }
  ],
  "mission": {
    "goal": "@level.slantcost.mission.goal",
    "how": "@level.slantcost.mission.how"
  },
  "robot": "scout",
  "adds": ["add"],
  "debrief": {
    "title": "@level.slantcost.debrief.title",
    "body": [
      "@level.slantcost.debrief.body.0",
      "@level.slantcost.debrief.body.1"
    ],
    "note": "@level.slantcost.debrief.note"
  },
  "tasks": [
    {
      "id": "slantcost",
      "mode": "circuit",
      "ports": [
        { "way": { "n": 1, "sensor": "left" } },
        { "way": { "n": 2, "sensor": "ul" } },
        { "start": { "sensor": "start" } },
        {
          "named": {
            "label": "@level.slantcost.tasks.slantcost.ports.3.named.label",
            "short": "@level.slantcost.tasks.slantcost.ports.3.named.short",
            "sensor": "cost"
          }
        },
        { "way": { "n": 3, "input": "way3" } }
      ],
      "diagnose": [
        {
          "when": { "uses": "up" },
          "say": "@level.slantcost.tasks.slantcost.diagnose.0.say"
        }
      ],
      "hints": [
        "@level.slantcost.tasks.slantcost.hints.0",
        "@level.slantcost.tasks.slantcost.hints.1",
        "@level.slantcost.tasks.slantcost.hints.2",
        "@level.slantcost.tasks.slantcost.hints.3"
      ],
      "world": "grid",
      "facts": ["start", "cost"],
      "tests": [
        { "R": 3, "C": 3, "costs": [[2, 1, 3], [1, 4, 1], [1, 1, 2]] },
        { "R": 3, "C": 4, "costs": [[2, 1, 1, 1], [1, 4, 9, 9], [1, 1, 5, 1]] },
        {
          "R": 4,
          "C": 6,
          "costs": [[1, 2, 4, 3, 1, 2], [1, 3, 1, 5, 4, 1], [1, 1, 6, 2, 1, 3], [1, 1, 1, 4, 2, 1]]
        }
      ],
      "expected": [8, 12, 8],
      "solution": [
        "m = mmin(view.left, view.ul, way3)",
        "k = const[value=0]()",
        "g = pass(facts.start, k)",
        "s = mmin(m, g)",
        "a = add(s, facts.cost)",
        "cell <- a"
      ]
    }
  ]
}
