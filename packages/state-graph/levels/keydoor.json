      "id": "keydoor",
      "mode": "circuit",
      "boardOpt": { "minScale": 0.62, "maxScale": 1.15 },
      "noTrace": true,
      "hints": [
        "@level.keydoor.tasks.keydoor.hints.0",
        "@level.keydoor.tasks.keydoor.hints.1"
      ],
      "world": "keys",
      "facts": ["start", "gain", "lose", "shut"],
      "tests": [
        { "R": 3, "C": 4, "key": [1, 0], "doors": [[1, 2]] },
        { "R": 4, "C": 4, "key": [2, 0], "doors": [[1, 1], [3, 2]] },
        { "R": 4, "C": 5, "key": [1, 0], "doors": [[0, 3], [2, 2], [3, 1]] }
      ],
      "expected": [6, 7, 21],
      "solution": [
        "c = counter(view.up, view.left, facts.start)",
        "p = msum(view.upPrev, view.leftPrev)",
        "b1 = block(facts.shut, c)",
        "g = pass(facts.gain, p)",
        "b2 = block(facts.lose, b1)",
        "m = msum(b2, g)",
        "cell <- m"
      ],
      "remember": ["red"]
    }
  ]
