      "expected": [1, 3, 3],
      "solution": [
        "k = const[value=1]()",
        "n = mmin(view.up, view.left, view.ul)",
        "z = const[value=0]()",
        "g1 = pass(facts.same, view.ul)",
        "a = add(n, k)",
        "g0 = pass(facts.start, z)",
        "m = mmin(a, g1, g0)",
        "cell <- m"
      ],
      "border0": false,
      "publishes": [{ "piece": "cost", "variant": "base" }]
    }
  ]
