  "tasks": [
    {
      "id": "twokeys",
      "mode": "circuit",
      "noTrace": true,
      "hints": [
        "@level.twokeys.tasks.twokeys.hints.0"
      ],
      "world": "keys",
      "facts": ["start", "gain", "lose", "shut"],
      "tests": [
        {
          "R": 3,
          "C": 4,
          "keys": { "red": [1, 0], "blue": [0, 2] },
          "doors": [{ "at": [1, 3], "color": "blue" }, { "at": [2, 2], "color": "red" }]
        },
        {
          "R": 4,
          "C": 4,
          "keys": { "red": [0, 1], "blue": [2, 0] },
          "doors": [{ "at": [2, 2], "color": "red" }, { "at": [1, 3], "color": "blue" }, { "at": [3, 1], "color": "blue" }]
        }
      ],
      "expected": [5, 8],
      "solution": [
        "c = counter(view.up, view.left, facts.start)",
        "p = msum(view.upPrev, view.leftPrev)",
        "b1 = block(facts.shut, c)",
        "g = pass(facts.gain, p)",
        "b2 = block(facts.lose, b1)",
        "m = msum(b2, g)",
        "cell <- m"
      ],
      "remember": ["red", "blue"]
    }
  ]
}
