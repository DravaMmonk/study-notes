      "diagnose": [
        {
          "when": { "all": [{ "not": { "uses": "dl" } }, { "uses": "same" }] },
          "say": "@level.lps.tasks.lps.diagnose.0.say"
        }
      ],
      "hints": [
        "@level.lps.tasks.lps.hints.0",
        "@level.lps.tasks.lps.hints.1"
      ],
      "world": "interval",
      "facts": ["same"],
      "tests": [{ "s": "CHARACTER" }, { "s": "AGBDBA" }, { "s": "BBABCBCAB" }],
      "expected": [5, 5, 7],
      "solution": [
        "k = const[value=2]()",
        "a = add(view.dl, k)",
        "g = pass(facts.same, a)",
        "m = mmax(view.down, view.left, g)",
        "cell <- m"
      ],
      "diag": 1,
      "empty0": true
    }
  ]
}
