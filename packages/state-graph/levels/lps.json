      "t": "@level.lps.intro.1.t"
    }
  ],
  "mission": {
    "goal": "@level.lps.mission.goal",
    "how": "@level.lps.mission.how"
  },
  "robot": "ranger",
  "debrief": {
    "title": "@level.lps.debrief.title",
    "body": [
      "@level.lps.debrief.body.0",
