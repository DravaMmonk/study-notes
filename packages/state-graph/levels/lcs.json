    {
      "id": "lcs",
      "play": "state-graph:circuit",
      "trace": "state-graph:trace-lcs",
      "boardOpt": {
        "minScale": 0.66,
        "maxScale": 1.2
      },
      "hints": [
        "@level.lcs.tasks.lcs.hints.0",
        "@level.lcs.tasks.lcs.hints.1",
        "@level.lcs.tasks.lcs.hints.2"
      ],
      "world": "state-graph:world-align",
      "facts": [
        "same"
      ],
      "tests": [
        {
          "top": "CABD",
          "left": "ABCD"
        },
        {
          "top": "ABCBDAB",
          "left": "BDCABA"
        },
        {
          "top": "GATTACA",
          "left": "CATTAG"
        }
      ],
      "expected": [
        3,
        4,
        4
      ],
      "solution": [
        "k = table:const[value=1]()",
        "a = table:add(view.ul, k)",
        "g = table:pass(facts.same, a)",
        "m = table:mmax(view.up, view.left, g)",
        "cell <- m"
      ],
      "border0": true,
      "publishes": [
        {
          "part": "align",
          "variant": "base"
        }
      ],
      "panel": "state-graph:panel-lcs"
    }
  ]
