{
  "title": "@level.value.title",
  "short": "@level.value.short",
  "intro": [
    {
      "t": "@level.value.intro.0.t"
    },
    {
      "t": "@level.value.intro.1.t",
      "fig": {
        "scene": {
          "cells": [
            {
              "id": "v0",
              "x": 0,
              "y": 0,
              "w": 54,
              "h": 54,
              "value": 10,
              "label": "@level.value.intro.1.fig.scene.cells.v0.label",
              "cls": "gold"
            },
            { "id": "v1", "x": 62, "y": 0, "w": 54, "h": 54, "value": 9, "cls": "lit" },
            { "id": "v2", "x": 124, "y": 0, "w": 54, "h": 54, "value": 8.1, "cls": "lit" },
            { "id": "v3", "x": 186, "y": 0, "w": 54, "h": 54, "value": 7.29, "cls": "lit" },
            { "id": "v4", "x": 248, "y": 0, "w": 54, "h": 54, "value": 6.56, "cls": "lit" }
          ],
          "edges": []
        }
      }
    },
    {
      "t": "@level.value.intro.2.t",
      "fig": {
        "circuit": {
          "taps": [{ "id": "m", "label": "@level.value.intro.2.fig.circuit.taps.m.label" }],
          "parts": [
            { "id": "k", "name": "@level.value.intro.2.fig.circuit.parts.k.name", "tag": "= 0.9" },
            { "id": "x", "name": "@level.value.intro.2.fig.circuit.parts.x.name", "tag": "a × b", "row": 1 }
          ],
          "outs": [{ "id": "o", "label": "@level.value.intro.2.fig.circuit.outs.o.label" }],
          "wires": [{ "from": "m", "to": "x" }, { "from": "k", "to": "x" }, { "from": "x", "to": "o" }]
        }
      }
    },
    {
      "t": "@level.value.intro.3.t"
    }
  ],
  "mission": {
    "goal": "@level.value.mission.goal",
    "how": "@level.value.mission.how"
  },
  "robot": "loop",
  "debrief": {
    "title": "@level.value.debrief.title",
    "body": [
      "@level.value.debrief.body.0",
      "@level.value.debrief.body.1"
    ],
    "note": "@level.value.debrief.note"
  },
  "tasks": [
    {
      "id": "value",
      "mode": "circuit",
      "ports": [
        { "way": { "n": 1, "sensor": "up" } },
        { "way": { "n": 2, "sensor": "down" } },
        { "way": { "n": 3, "sensor": "left" } },
        { "way": { "n": 4, "sensor": "right" } }
      ],
      "diagnose": [
        {
          "when": { "not": { "has": "mul" } },
          "say": "@level.value.tasks.value.diagnose.0.say"
        }
      ],
      "boardOpt": { "minScale": 0.62, "maxScale": 1.15 },
      "consts": [0, 0.5, 0.8, 0.9, 1],
      "hints": [
        "@level.value.tasks.value.hints.0",
        "@level.value.tasks.value.hints.1"
      ],
      "world": "vgrid",
      "tests": [
        {
          "R": 5,
          "C": 6,
          "gold": [0, 5],
          "traps": [[1, 4], [3, 2]],
          "walls": [[1, 1], [2, 1], [2, 3], [2, 4], [4, 4]]
        },
        { "R": 4, "C": 5, "gold": [3, 4], "traps": [[2, 3]], "walls": [[1, 1], [1, 2], [3, 2]] }
      ],
      "expected": [5.9049, 4.782969],
      "solution": [
        "a = mmax(view.up, view.down, view.left)",
        "k = const[value=0.9]()",
        "b = mmax(a, view.right)",
        "x = mul(b, k)",
        "cell <- x"
      ],
      "rounds": true,
      "arrows": true
    }
  ]
}
