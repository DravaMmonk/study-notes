{
  "name": "@part.min.name",
  "desc": "@part.min.desc",
  "inside": [
    {
      "id": "base",
      "reference": {
        "mode": "table:circuit",
        "solution": [
          "m = table:mmin(view.left, view.ul, way3)",
          "k = table:const[value=0]()",
          "g = table:pass(facts.start, k)",
          "s = table:mmin(m, g)",
          "a = table:add(s, facts.cost)",
          "cell <- a"
        ],
        "world": "table:world-grid",
        "robot": "table:robot-scout",
        "ports": [
          { "table:port-way": { "n": 1, "sensor": "left" } },
          { "table:port-way": { "n": 2, "sensor": "ul" } },
          { "table:port-start": { "sensor": "start" } },
          { "table:port-named": { "label": "cost", "short": "cost", "sensor": "cost" } },
          { "table:port-way": { "n": 3, "input": "way3" } }
        ],
        "facts": ["start", "cost"]
      }
    }
  ],
  "inputs": [
    { "name": "left", "type": "circuit:number" },
    { "name": "ul", "type": "circuit:number" },
    { "name": "start", "type": "circuit:boolean" },
    { "name": "cost", "type": "circuit:number" },
    { "name": "way3", "type": "circuit:number" }
  ],
  "outputType": "circuit:number"
}
