{
  "extends": "task",
  "play": "image:graph",
  "fields": {
    "optional": {
      "type": "bool",
      "section": "course",
      "about": { "zh": "可跳过的任务", "en": "a skippable task" },
      "optional": true
    },
    "hint": { "type": "text", "optional": true },
    "unlocks": {
      "type": "list",
      "of": { "type": "ref", "kind": "unlock" },
      "section": "course",
      "about": {
        "zh": "这一段搭出的能力：后面的任务马上能用，整关通过时解锁",
        "en": "what this task builds: the tasks after it hold it at once, and passing the level unlocks it"
      },
      "optional": true
    },
    "carries": {
      "type": "bool",
      "about": { "zh": "从上一段的电路开始", "en": "start from the task before’s board" },
      "optional": true
    },
    "inputs": { "type": "list", "of": { "type": "str" }, "optional": true },
    "inputLabels": { "type": "map", "of": { "type": "text" }, "optional": true },
    "inputDescriptions": {
      "type": "map",
      "of": { "type": "text" },
      "about": { "zh": "输入元件的说明，按输入名填写", "en": "descriptions of input parts, keyed by input name" },
      "optional": true
    },
    "outputs": { "type": "list", "of": { "type": "str" }, "optional": true },
    "outputLabels": { "type": "map", "of": { "type": "text" }, "optional": true },
    "views": {
      "type": "obj",
      "fields": {
        "in": { "type": "ref", "kind": "view", "optional": true },
        "out": { "type": "ref", "kind": "view", "optional": true },
        "mid": { "type": "ref", "kind": "view", "optional": true }
      },
      "about": {
        "zh": "输入、输出、中间元件默认的画法",
        "en": "how the inputs, the outputs and the parts between are drawn at first"
      },
      "optional": true
    },
    "check": {
      "type": "obj",
      "fields": {
        "tolerance": { "type": "num", "optional": true },
        "mismatches": { "type": "int", "min": 0, "optional": true }
      },
      "about": {
        "zh": "一格差多少算对（tolerance），最多几格不对（mismatches）",
        "en": "how far a cell may be off (tolerance), how many cells may be wrong (mismatches)"
      },
      "optional": true
    },
    "constraint": { "type": "call", "kind": "constraint", "optional": true },
    "trainRate": {
      "type": "num",
      "about": { "zh": "训练一步走多远", "en": "how far one training step goes" },
      "optional": true
    },
    "trainRates": {
      "type": "list",
      "of": { "type": "num" },
      "about": {
        "zh": "能选的学习率（选了就不再回退步长）",
        "en": "the learning rates to choose from (a step is then taken as it is)"
      },
      "optional": true
    },
    "solution": {
      "type": "board",
      "about": { "zh": "一块电路板的蓝图文本，每行一个字符串", "en": "a board as blueprint text, one string a line" },
      "optional": true
    },
    "naive": {
      "type": "board",
      "about": { "zh": "一块电路板的蓝图文本，每行一个字符串", "en": "a board as blueprint text, one string a line" },
      "optional": true
    },
    "alsoFails": {
      "type": "list",
      "of": {
        "type": "board",
        "about": { "zh": "一块电路板的蓝图文本，每行一个字符串", "en": "a board as blueprint text, one string a line" }
      },
      "about": { "zh": "也必须失败的电路", "en": "boards that must fail too" },
      "optional": true
    }
  },
  "schema": {
    "type": "by",
    "field": "scene",
    "cases": { "image:scene-filter": { "type": "obj", "fields": {} } },
    "fields": {
      "scene": { "type": "oneOf", "values": ["image:scene-filter"] },
      "setup": {
        "type": "obj",
        "fields": {
          "target": {
            "type": "call",
            "kind": "target",
            "about": {
              "zh": "输出怎样由测试的图算出（按关卡输入的顺序）",
              "en": "how the output comes from the test’s pictures (in the order of the level’s inputs)"
            }
          },
          "given": {
            "type": "map",
            "of": { "type": "call", "kind": "picture" },
            "about": {
              "zh": "每组测试都一样的输入（比如频率半径）",
              "en": "inputs every test shares (the frequency radius, say)"
            },
            "optional": true
          }
        }
      },
      "tests": {
        "type": "list",
        "of": {
          "type": "obj",
          "fields": {
            "label": { "type": "text" },
            "train": {
              "type": "bool",
              "about": {
                "zh": "false：不拿来训练，只用来检查训练（新样本）",
                "en": "false: not trained on, only checking the training (a new sample)"
              },
              "optional": true
            },
            "in": { "type": "call", "kind": "picture", "optional": true },
            "inputs": {
              "type": "map",
              "of": { "type": "call", "kind": "picture" },
              "about": { "zh": "有几个输入时，每个输入的图", "en": "the picture of each input, when there are several" },
              "optional": true
            }
          }
        },
        "min": 1,
        "section": "tests"
      },
      "hidden": {
        "type": "list",
        "of": {
          "type": "obj",
          "fields": {
            "label": { "type": "text" },
            "train": {
              "type": "bool",
              "about": {
                "zh": "false：不拿来训练，只用来检查训练（新样本）",
                "en": "false: not trained on, only checking the training (a new sample)"
              },
              "optional": true
            },
            "in": { "type": "call", "kind": "picture", "optional": true },
            "inputs": {
              "type": "map",
              "of": { "type": "call", "kind": "picture" },
              "about": { "zh": "有几个输入时，每个输入的图", "en": "the picture of each input, when there are several" },
              "optional": true
            }
          }
        },
        "section": "tests",
        "optional": true
      }
    }
  },
  "declares": "package",
  "overrides": { "package": ["*"], "game": ["$text"] }
}
