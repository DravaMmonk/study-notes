{
  "extends": "task",
  "play": "image:probe",
  "fields": {
    "optional": {
      "type": "bool",
      "section": "course",
      "about": { "zh": "可跳过的任务", "en": "a skippable task" },
      "optional": true
    },
    "hint": { "type": "text", "optional": true },
    "unlocks": {
      "type": "list",
      "of": { "type": "ref", "kind": "unlock" },
      "section": "course",
      "about": {
        "zh": "这一段搭出的能力：后面的任务马上能用，整关通过时解锁",
        "en": "what this task builds: the tasks after it hold it at once, and passing the level unlocks it"
      },
      "optional": true
    },
    "carries": {
      "type": "bool",
      "about": { "zh": "从上一段的电路开始", "en": "start from the task before’s board" },
      "optional": true
    },
    "part": {
      "type": "ref",
      "kind": "part",
      "reference": "circuit/part",
      "about": { "zh": "台上的黑箱", "en": "the black box on the bench" }
    },
    "question": { "type": "text" },
    "answers": { "type": "list", "of": { "type": "str" } },
    "answer": { "type": "str" },
    "wrong": { "type": "text" },
    "probes": {
      "type": "list",
      "of": {
        "type": "obj",
        "fields": { "label": { "type": "text" }, "picture": { "type": "call", "kind": "picture" } }
      }
    }
  },
  "declares": "package",
  "overrides": { "package": ["*"], "game": ["$text"] }
}
