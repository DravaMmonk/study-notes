{
  "name": "@piece.shift.name",
  "desc": "@piece.shift.desc",
  "icon": "Move",
  "family": "image:family-neighbour",
  "inputs": [{ "name": "in", "label": "", "type": "image:image" }],
  "settings": {
    "dir": {
      "label": "@piece.shift.settings.dir.label",
      "options": [
        { "value": "right", "label": "→" },
        { "value": "left", "label": "←" },
        { "value": "down", "label": "↓" },
        { "value": "up", "label": "↑" }
      ]
    },
    "n": { "label": "@piece.shift.settings.n.label" },
    "border": {
      "label": "@piece.shift.settings.border.label",
      "options": [
        { "value": "zero", "label": "@piece.shift.settings.border.options.0.label" },
        { "value": "edge", "label": "@piece.shift.settings.border.options.1.label" },
        { "value": "wrap", "label": "@piece.shift.settings.border.options.2.label" }
      ]
    }
  },
  "compute": "image:shift(in, $dir, $n, $border)",
  "outputType": "image:image"
}
