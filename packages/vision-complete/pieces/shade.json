{
  "name": "@piece.shade.name",
  "desc": "@piece.shade.desc",
  "icon": "Box",
  "family": "image:family-other",
  "inputs": [
    { "name": "nx", "type": "image:image" },
    { "name": "ny", "type": "image:image" },
    { "name": "nz", "type": "image:image" },
    { "name": "albedo", "type": "image:image" }
  ],
  "settings": {
    "lx": { "label": "@piece.shade.settings.lx.label" },
    "ly": { "label": "@piece.shade.settings.ly.label" },
    "lz": { "label": "@piece.shade.settings.lz.label" }
  },
  "compute": "image:shade(nx, ny, nz, albedo, $lx, $ly, $lz)",
  "outputType": "image:image"
}
