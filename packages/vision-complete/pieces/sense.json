{
  "name": "@piece.sense.name",
  "desc": "@piece.sense.desc",
  "icon": "Box",
  "family": "image:family-other",
  "inputs": [{ "name": "in", "label": "", "type": "image:image" }],
  "settings": {
    "channel": {
      "label": "@piece.sense.settings.channel.label",
      "options": [
        { "value": "R", "label": "R" },
        { "value": "G", "label": "G" },
        { "value": "B", "label": "B" }
      ]
    }
  },
  "compute": "image:sense(in, $channel)",
  "outputType": "image:image"
}
