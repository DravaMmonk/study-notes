{
  "name": "@piece.arith.name",
  "desc": "@piece.arith.desc",
  "icon": "Plus",
  "family": "image:family-pixel",
  "inputs": [
    { "name": "a", "label": "a", "type": "image:image" },
    { "name": "b", "label": "b", "type": "image:image" }
  ],
  "settings": {
    "op": {
      "label": "@piece.arith.settings.op.label",
      "options": [
        { "value": "add", "label": "+" },
        { "value": "sub", "label": "−" },
        { "value": "mul", "label": "×" },
        { "value": "div", "label": "÷" }
      ]
    },
    "constantSide": {
      "label": "@piece.arith.settings.constantSide.label",
      "options": [
        { "value": "none", "label": "@piece.arith.settings.constantSide.options.0.label" },
        { "value": "a", "label": "@piece.arith.settings.constantSide.options.1.label" },
        { "value": "b", "label": "@piece.arith.settings.constantSide.options.2.label" }
      ]
    },
    "constant": {
      "label": "@piece.arith.settings.constant.label",
      "when": "match $constantSide { none: 0, a: 1, b: 1 }"
    }
  },
  "nulls": "pass",
  "compute": "image:arith(a, b, $op, $constantSide, $constant)",
  "outputType": "image:image"
}
