{
  "name": "@piece.fqLowpass.name",
  "desc": "@piece.fqLowpass.desc",
  "icon": "Waves",
  "family": "image:family-frequency",
  "inputs": [{ "name": "in", "label": "", "type": "image:image" }],
  "settings": {
    "shape": {
      "label": "@piece.fqLowpass.settings.shape.label",
      "options": [
        { "value": "disk", "label": "@piece.fqLowpass.settings.shape.options.0.label" },
        { "value": "gauss", "label": "@piece.fqLowpass.settings.shape.options.1.label" }
      ]
    },
    "R": { "label": "@piece.fqLowpass.settings.R.label" }
  },
  "compute": "image:fqLowpass(in, $shape, $R)",
  "outputType": "image:image"
}
