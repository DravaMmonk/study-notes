{
  "name": "@piece.disparity.name",
  "desc": "@piece.disparity.desc",
  "icon": "Search",
  "family": "image:family-search",
  "inputs": [
    { "name": "left", "label": "@piece.disparity.inputs.0.label", "type": "image:image" },
    { "name": "right", "label": "@piece.disparity.inputs.1.label", "type": "image:image" }
  ],
  "settings": {
    "window": {
      "label": "@piece.disparity.settings.window.label",
      "options": [
        { "value": "1", "label": "1×1" },
        { "value": "3", "label": "3×3" },
        { "value": "5", "label": "5×5" },
        { "value": "7", "label": "7×7" }
      ]
    }
  },
  "compute": "image:disparity(left, right, $window)",
  "outputType": "image:image"
}
