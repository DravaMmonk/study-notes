  "tasks": [
    {
      "id": "9-2",
      "kind": "graph",
      "brief": "@level.9-2.tasks.9-2.brief",
      "hint": "@level.9-2.tasks.9-2.hint",
      "inputs": ["img", "m"],
      "inputLabels": {
        "img": "@level.9-2.tasks.9-2.inputLabels.img",
        "m": "@level.9-2.tasks.9-2.inputLabels.m"
      },
      "check": { "tolerance": 0.005 },
      "scene": "kmeans",
      "setup": { "expect": "step" },
      "tests": [
        {
          "label": "@level.9-2.tasks.9-2.tests.0.label",
          "img": { "twoTone": { "seed": 51, "dark": 0.25, "bright": 0.75, "disc": [5, 6, 16] } },
          "m": 0.4
        },
        {
          "label": "@level.9-2.tasks.9-2.tests.1.label",
          "img": { "twoTone": { "seed": 52, "dark": 0.2, "bright": 0.6, "rightOf": 10 } },
          "m": 0.3
        },
        {
          "label": "@level.9-2.tasks.9-2.tests.2.label",
          "img": { "twoTone": { "seed": 53, "dark": 0.4, "bright": 0.9, "stripes": [7, 3] } },
          "m": 0.7
        }
      ],
      "hidden": [
        {
          "label": "@level.9-2.tasks.9-2.hidden.0.label",
          "img": { "twoTone": { "seed": 51, "dark": 0.25, "bright": 0.75, "disc": [5, 6, 16] } },
          "m": 0.28
        }
      ],
      "solution": [
        "k = const[c=0.5]()",
        "d = arith[op=sub](img, m)",
        "L = threshold[t=0](d)",
        "N = invert(L)",
        "hn = arith[op=mul](img, L)",
        "hd = fqMean(L)",
        "hm = fqMean(hn)",
        "ln = arith[op=mul](img, N)",
        "ld = fqMean(N)",
        "hi = arith[op=div](hm, hd)",
        "lm = fqMean(ln)",
        "lo = arith[op=div](lm, ld)",
        "s = arith[op=add](hi, lo)",
        "m2 = arith[op=mul](s, k)",
        "out <- m2"
      ],
      "naive": [
        "k = const[c=0.5]()",
        "s = fqMean(img)",
        "a = arith[op=add](s, m)",
        "h = arith[op=mul](a, k)",
        "out <- h"
      ]
    }
  ]
}
