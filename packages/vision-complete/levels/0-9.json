      ],
      "solution": [
        "avgN = const[c=0.2]()",
        "d = sub(scene, empty)",
        "m = threshold[t=0.2](d)",
        "l = shift[dir=left](m)",
        "r = shift[dir=right](m)",
        "u = shift[dir=up](m)",
        "w = shift[dir=down](m)",
        "a1 = add(l, r)",
        "a2 = add(u, w)",
        "a3 = add(a1, a2)",
        "a4 = add(a3, m)",
        "avg = mul(a4, avgN)",
        "core = threshold[t=0.9](avg)",
        "ring = sub(m, core)",
        "out <- ring"
      ],
      "naive": ["d = sub(scene, empty)", "m = threshold[t=0.2](d)", "out <- m"]
    }
  ]
