      "id": "11-3",
      "kind": "graph",
      "brief": "@level.11-3.tasks.11-3.brief",
      "hint": "@level.11-3.tasks.11-3.hint",
      "inputs": ["in", "w"],
      "inputLabels": {
        "in": "@level.11-3.tasks.11-3.inputLabels.in",
        "w": "@level.11-3.tasks.11-3.inputLabels.w",
        "m": "@level.11-3.tasks.11-3.inputLabels.m"
      },
      "views": { "in": "pixels", "out": "terrain", "mid": "terrain" },
      "scene": "classifier",
      "setup": { "check": "occlusion", "cover": { "v": 0.5, "r": 5 } },
      "tests": [
        { "label": "@level.11-3.tasks.11-3.tests.0.label", "street": { "cx": 5 }, "weights": "car" },
        {
          "label": "@level.11-3.tasks.11-3.tests.1.label",
          "street": { "cx": 5 },
          "weights": "road"
        },
        {
          "label": "@level.11-3.tasks.11-3.tests.2.label",
          "street": { "cx": 3, "house": 11 },
          "weights": "both"
        },
        {
          "label": "@level.11-3.tasks.11-3.tests.3.label",
          "street": { "cx": 6 },
          "weights": "wheels"
        }
      ],
      "hidden": [
        {
          "label": "@level.11-3.tasks.11-3.hidden.0.label",
          "street": { "cx": 1 },
          "weights": "car"
        },
        {
          "label": "@level.11-3.tasks.11-3.hidden.1.label",
          "street": { "cx": 5, "house": 0 },
          "weights": "sky"
        }
      ],
      "solution": [
        "g = const[c=0.5]()",
        "d = arith[op=sub](in, g)",
        "c = arith[op=mul](d, w)",
        "h1 = shift[dir=left](c)",
        "h2 = shift[dir=right](c)",
        "h3 = shift[dir=left, n=2](c)",
        "h4 = shift[dir=right, n=2](c)",
        "hm = merge(c, h1, h2)",
        "hn = merge(hm, h3, h4)",
        "v1 = shift[dir=up](hn)",
        "v2 = shift[dir=down](hn)",
        "v3 = shift[dir=up, n=2](hn)",
        "v4 = shift[dir=down, n=2](hn)",
        "vm = merge(hn, v1, v2)",
        "vn = merge(vm, v3, v4)",
        "out <- vn"
      ],
      "naive": [
        "g = const[c=0.5]()",
        "n = const[c=9]()",
        "d = arith[op=sub](in, g)",
        "c = arith[op=mul](d, w)",
        "b = box3(c)",
        "k = arith[op=mul](b, n)",
        "out <- k"
      ]
    }
  ]
