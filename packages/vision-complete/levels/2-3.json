            "answers": "5"
          },
          {
            "title": "@level.2-3.tasks.2-3.bench.stages.1.title",
            "note": "@level.2-3.tasks.2-3.bench.stages.1.note",
            "win": "@level.2-3.tasks.2-3.bench.stages.1.win",
