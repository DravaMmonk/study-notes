          "k = const[c=4]()",
          "aa = arith[op=mul](a, a)",
          "ab = arith[op=mul](a, b)",
          "ma = fqMean(aa)",
          "mb = fqMean(ab)",
          "sa = arith[op=mul](ma, k)",
          "sb = arith[op=mul](mb, k)",
          "wa = arith[op=mul](sa, a)",
          "wb = arith[op=mul](sb, b)",
          "den = merge(sa, sb)",
          "num = merge(wa, wb)",
          "q = arith[op=div](num, den)",
          "out <- q"
        ]
      ],
