      "hidden": [{ "label": "@level.6-5.tasks.6-5.hidden.0.label", "seed": 34, "which": 2 }],
      "solution": [
        "mp = fqMean(p)",
        "m1 = fqMean(c1)",
        "m2 = fqMean(c2)",
        "m3 = fqMean(c3)",
        "dp = arith[op=sub](p, mp)",
        "d1 = arith[op=sub](c1, m1)",
        "d2 = arith[op=sub](c2, m2)",
        "d3 = arith[op=sub](c3, m3)",
        "e1 = arith[op=sub](dp, d1)",
        "e2 = arith[op=sub](dp, d2)",
        "e3 = arith[op=sub](dp, d3)",
        "q1 = arith[op=mul](e1, e1)",
        "q2 = arith[op=mul](e2, e2)",
        "q3 = arith[op=mul](e3, e3)",
        "s1 = fqMean(q1)",
        "s2 = fqMean(q2)",
        "s3 = fqMean(q3)",
        "m = matcher(s1, s2, s3)",
        "idx <- m"
      ],
      "naive": [
        "mp = fqMean(p)",
        "m1 = fqMean(c1)",
        "e1 = arith[op=sub](p, c1)",
        "m2 = fqMean(c2)",
        "e2 = arith[op=sub](p, c2)",
        "m3 = fqMean(c3)",
        "e3 = arith[op=sub](p, c3)",
        "dp = arith[op=sub](p, mp)",
        "d1 = arith[op=sub](c1, m1)",
        "q1 = arith[op=mul](e1, e1)",
        "d2 = arith[op=sub](c2, m2)",
        "q2 = arith[op=mul](e2, e2)",
        "d3 = arith[op=sub](c3, m3)",
        "q3 = arith[op=mul](e3, e3)",
        "s1 = fqMean(q1)",
        "s2 = fqMean(q2)",
        "s3 = fqMean(q3)",
        "m = matcher(s1, s2, s3)",
        "idx <- m"
      ]
    }
