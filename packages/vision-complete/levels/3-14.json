        "xx = arith[op=mul](gx, gx)",
        "yy = arith[op=mul](gy, gy)",
        "a = arith[op=add](xx, yy)",
        "q = arith[op=div](a, zz)",
        "t = threshold[t=0.09](q)",
        "out <- t"
      ],
