      "solution": [
        "zk = const[c=0]()",
        "ok = const()",
        "hs = homography[k=100](pairs)",
        "z = arith[op=mul](cover, zk)",
        "w = warp(cover, hs, photo)",
        "one = arith[op=add](z, ok)",
        "m = warp(one, hs, photo)",
        "inv = invert(m)",
        "keep = arith[op=mul](photo, inv)",
        "sum = arith[op=add](keep, w)",
        "out <- sum"
      ],
      "naive": [
        "zk = const[c=0]()",
        "ok = const()",
        "hs = homography(pairs)",
        "z = arith[op=mul](cover, zk)",
        "w = warp(cover, hs, photo)",
        "one = arith[op=add](z, ok)",
        "m = warp(one, hs, photo)",
        "inv = invert(m)",
        "keep = arith[op=mul](photo, inv)",
        "sum = arith[op=add](keep, w)",
        "out <- sum"
