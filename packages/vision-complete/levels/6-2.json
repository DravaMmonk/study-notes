      "tests": [
        { "label": "@level.6-2.tasks.6-2.tests.0.label", "bumps": [[3, 4, 0.9], [11, 5, 0.6], [7, 12, 0.8]] },
        { "label": "@level.6-2.tasks.6-2.tests.1.label", "bumps": [[5, 5, 0.9], [8, 6, 0.7], [12, 12, 0.5]] },
        {
          "label": "@level.6-2.tasks.6-2.tests.2.label",
          "bumps": [[4, 11, 0.8], [11, 3, 0.25], [12, 10, 0.6]]
        }
      ],
