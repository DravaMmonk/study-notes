        { "label": "@level.6-2.tasks.6-2.hidden.0.label", "bumps": [[0, 7, 0.7], [9, 9, 0.9]] },
        {
          "label": "@level.6-2.tasks.6-2.hidden.1.label",
          "bumps": [[2, 8, 0.6], [6, 8, 0.8], [10, 8, 0.7], [14, 8, 0.5]]
        }
      ],
      "solution": [
        "l = shift[dir=left](in)",
        "r = shift[dir=right](in)",
        "big = threshold[t=0.3](in)",
        "h1 = max(in, l)",
        "h = max(h1, r)",
        "u = shift[dir=up](h)",
        "d = shift[dir=down](h)",
        "v1 = max(h, u)",
        "v = max(v1, d)",
        "df = arith[op=sub](in, v)",
        "eq = threshold[t=-0.02](df)",
        "m = arith[op=mul](eq, big)",
        "out <- m"
      ],
      "naive": ["big = threshold[t=0.3](in)", "out <- big"]
    }
  ]
}
