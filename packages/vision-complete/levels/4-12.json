        [
          "r3 = learn3[w=[0, -0.25, 0, -0.25, 1, -0.25, 0, -0.25, 0]](photo.r)",
          "g3 = learn3(photo.g)",
          "b3 = learn3[w=[0, 0.25, 0, 0.25, -1, 0.25, 0, 0.25, 0]](photo.b)",
          "s1 = arith[op=add](r3, g3)",
          "s2 = arith[op=add](s1, b3)",
