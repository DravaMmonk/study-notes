        "half = const[c=0.5]()",
        "r0 = arith[op=sub](photo.r, half)",
        "g0 = arith[op=sub](photo.g, half)",
        "b0 = arith[op=sub](photo.b, half)",
        "r3 = learn3[w=[0, -0.25, 0, -0.25, 1, -0.25, 0, -0.25, 0]](r0)",
        "g3 = learn3[w=[0, 0.25, 0, 0.25, -1, 0.25, 0, 0.25, 0]](g0)",
        "b3 = learn3(b0)",
        "s1 = arith[op=add](r3, g3)",
        "s2 = arith[op=add](s1, b3)",
        "out <- s2"
      ],
      "naive": [
        "kN = const[c=0.33]()",
        "s1 = arith[op=add](photo.r, photo.g)",
        "s2 = arith[op=add](s1, photo.b)",
        "k = arith[op=mul](s2, kN)",
        "l = learn3[w=[0, -0.75, 0, -0.75, 3, -0.75, 0, -0.75, 0]](k)",
        "out <- l"
      ],
      "alsoFails": [
        [
