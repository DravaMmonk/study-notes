    "peaks": {
      "name": "@piece.peaks.name",
      "desc": "@piece.peaks.desc",
      "inside": [
        {
          "id": "base",
          "reference": {
            "kind": "image:graph",
            "solution": [
              "l = shift[dir=left](in)",
              "r = shift[dir=right](in)",
              "big = threshold[t=0.3](in)",
              "h1 = max(in, l)",
              "h = max(h1, r)",
              "u = shift[dir=up](h)",
              "d = shift[dir=down](h)",
              "v1 = max(h, u)",
              "v = max(v1, d)",
              "df = arith[op=sub](in, v)",
              "eq = threshold[t=-0.02](df)",
              "m = arith[op=mul](eq, big)",
              "out <- m"
            ],
            "inputs": ["in"],
            "outputs": ["out"]
          }
        }
      ],
      "inputs": [{ "name": "in", "type": "image:image" }],
      "outputType": "image:image"
    },
    "matcher": {
      "name": "@piece.matcher.name",
      "desc": "@piece.matcher.desc",
      "inside": [
        {
          "id": "base",
          "reference": {
            "kind": "image:graph",
            "solution": [
              "k8 = const[c=0.8]()",
              "two = const[c=2]()",
              "three = const[c=3]()",
              "M12 = max(d1, d2)",
              "s12 = arith[op=add](d1, d2)",
              "m12 = arith[op=sub](s12, M12)",
              "M = max(m12, d3)",
              "sm = arith[op=add](m12, d3)",
              "best = arith[op=sub](sm, M)",
              "s2 = arith[op=add](M, M12)",
              "M2 = max(M, M12)",
              "second = arith[op=sub](s2, M2)",
              "e1 = arith[op=sub](best, d1)",
              "e2 = arith[op=sub](best, d2)",
              "e3 = arith[op=sub](best, d3)",
              "r = arith[op=mul](second, k8)",
              "i1 = threshold[t=-0.02](e1)",
              "i2 = threshold[t=-0.02](e2)",
              "i3 = threshold[t=-0.02](e3)",
              "gap = arith[op=sub](r, best)",
              "w2 = arith[op=mul](i2, two)",
              "w3 = arith[op=mul](i3, three)",
              "ok = threshold[t=0](gap)",
              "sum = merge(i1, w2, w3)",
              "out2 = arith[op=mul](sum, ok)",
              "idx <- out2"
            ],
            "inputs": ["d1", "d2", "d3"],
            "outputs": ["idx"]
          }
        }
      ],
      "inputs": [
        { "name": "d1", "type": "image:image" },
        { "name": "d2", "type": "image:image" },
        { "name": "d3", "type": "image:image" }
      ],
      "outputType": "image:image"
    },
    "cross": {
      "name": "@piece.cross.name",
      "desc": "@piece.cross.desc",
      "inside": [
        {
          "id": "base",
          "reference": {
            "kind": "image:graph",
            "solution": [
              "a1 = shift[dir=left, border=wrap](a)",
              "b1 = shift[dir=left, border=wrap](b)",
              "a2 = shift[dir=left, border=wrap](a1)",
              "b2 = shift[dir=left, border=wrap](b1)",
              "p = arith[op=mul](a1, b2)",
              "q = arith[op=mul](a2, b1)",
              "c = arith[op=sub](p, q)",
              "out <- c"
            ],
            "inputs": ["a", "b"]
          }
        }
      ],
      "inputs": [{ "name": "a", "type": "image:image" }, { "name": "b", "type": "image:image" }],
      "outputType": "image:image"
    },
    "epiline": {
      "name": "@piece.epiline.name",
      "desc": "@piece.epiline.desc",
      "inside": [
        {
          "id": "base",
          "reference": {
            "kind": "image:graph",
            "solution": [
              "a = arith[op=mul](c1, px)",
              "b = arith[op=mul](c2, py)",
              "s = merge(a, b, c3)",
              "out <- s"
            ],
            "inputs": ["c1", "c2", "c3", "px", "py"]
          }
        }
      ],
      "inputs": [
        { "name": "c1", "type": "image:image" },
        { "name": "c2", "type": "image:image" },
        { "name": "c3", "type": "image:image" },
        { "name": "px", "type": "image:image" },
        { "name": "py", "type": "image:image" }
      ],
      "outputType": "image:image"
    },
    "addNoise": {
      "name": "@piece.addNoise.name",
      "desc": "@piece.addNoise.desc",
      "inside": [
        {
          "id": "base",
          "reference": {
            "kind": "image:graph",
            "solution": [
              "one = const()",
              "s1 = sqrt(ab)",
              "om = arith[op=sub](one, ab)",
              "s2 = sqrt(om)",
              "a = arith[op=mul](x0, s1)",
              "b = arith[op=mul](eps, s2)",
              "x = arith[op=add](a, b)",
              "out <- x"
            ],
            "inputs": ["x0", "eps", "ab"]
          }
        }
      ],
      "inputs": [
        { "name": "x0", "type": "image:image" },
        { "name": "eps", "type": "image:image" },
        { "name": "ab", "type": "image:image" }
      ],
      "outputType": "image:image"
    },
    "restore": {
      "name": "@piece.restore.name",
      "desc": "@piece.restore.desc",
      "inside": [
        {
          "id": "base",
          "reference": {
            "kind": "image:graph",
            "solution": [
              "one = const()",
              "s1 = sqrt(ab)",
              "om = arith[op=sub](one, ab)",
              "s2 = sqrt(om)",
              "b = arith[op=mul](eps, s2)",
              "d = arith[op=sub](xt, b)",
              "q = arith[op=div](d, s1)",
              "out <- q"
            ],
            "inputs": ["xt", "eps", "ab"]
          }
        }
      ],
      "inputs": [
        { "name": "xt", "type": "image:image" },
        { "name": "eps", "type": "image:image" },
        { "name": "ab", "type": "image:image" }
      ],
      "outputType": "image:image"
    },
    "kmeansStep": {
      "name": "@piece.kmeansStep.name",
      "desc": "@piece.kmeansStep.desc",
      "inside": [
        {
          "id": "base",
          "reference": {
            "kind": "image:graph",
            "solution": [
              "k = const[c=0.5]()",
              "d = arith[op=sub](img, m)",
              "L = threshold[t=0](d)",
              "N = invert(L)",
              "hn = arith[op=mul](img, L)",
              "hd = fqMean(L)",
              "hm = fqMean(hn)",
              "ln = arith[op=mul](img, N)",
              "ld = fqMean(N)",
              "hi = arith[op=div](hm, hd)",
              "lm = fqMean(ln)",
              "lo = arith[op=div](lm, ld)",
              "s = arith[op=add](hi, lo)",
              "m2 = arith[op=mul](s, k)",
              "out <- m2"
            ],
            "inputs": ["img", "m"]
          }
        }
      ],
      "inputs": [{ "name": "img", "type": "image:image" }, { "name": "m", "type": "image:image" }],
      "outputType": "image:image"
    },
    "unpool": {
      "name": "@piece.unpool.name",
      "desc": "@piece.unpool.desc",
      "inside": [
        {
          "id": "base",
          "reference": {
            "kind": "image:graph",
            "solution": [
              "u = tconv(small)",
              "d = arith[op=sub](big, u)",
              "e = threshold[t=-0.02](d)",
              "m = arith[op=mul](u, e)",
              "out <- m"
            ],
            "inputs": ["small", "big"]
          }
        }
      ],
      "inputs": [{ "name": "small", "type": "image:image" }, { "name": "big", "type": "image:image" }],
      "outputType": "image:image"
    },
    "iou": {
      "name": "@piece.iou.name",
      "desc": "@piece.iou.desc",
      "inside": [
        {
          "id": "base",
          "reference": {
            "kind": "image:graph",
            "solution": [
              "i = arith[op=mul](a, b)",
              "ma = fqMean(a)",
              "mb = fqMean(b)",
              "mi = fqMean(i)",
              "s = arith[op=add](ma, mb)",
              "u = arith[op=sub](s, mi)",
              "q = arith[op=div](mi, u)",
              "out <- q"
            ],
            "inputs": ["a", "b"]
          }
        }
      ],
      "inputs": [{ "name": "a", "type": "image:image" }, { "name": "b", "type": "image:image" }],
      "outputType": "image:image"
    },
    "apMeter": {
