{
  "name": "@part.arith.name",
  "desc": "@part.arith.desc",
  "icon": "Plus",
  "family": "image:family-pixel",
  "inputs": [
    {
      "name": "a",
      "label": "a"
    },
    {
      "name": "b",
      "label": "b"
    }
  ],
  "settings": {
    "op": {
      "label": "@part.arith.settings.op.label",
      "options": [
        {
          "value": "add",
          "label": "+"
        },
        {
          "value": "sub",
          "label": "−"
        },
        {
          "value": "mul",
          "label": "×"
        },
        {
          "value": "div",
          "label": "÷"
        }
      ]
    },
    "constantSide": {
      "label": "@part.arith.settings.constantSide.label",
      "options": [
        {
          "value": "none",
          "label": "@part.arith.settings.constantSide.options.0.label"
        },
        {
          "value": "a",
          "label": "@part.arith.settings.constantSide.options.1.label"
        },
        {
          "value": "b",
          "label": "@part.arith.settings.constantSide.options.2.label"
        }
      ]
    },
    "constant": {
      "label": "@part.arith.settings.constant.label",
      "when": "match $constantSide { none: 0, a: 1, b: 1 }"
    }
  },
  "nulls": "pass",
  "op": "image:arith"
}
