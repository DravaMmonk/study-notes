{
  "name": "@part.restore.name",
  "desc": "@part.restore.desc",
  "inside": [
    {
      "id": "base",
      "reference": {
        "kind": "image:graph",
        "solution": [
          "one = const()",
          "s1 = sqrt(ab)",
          "om = arith[op=sub](one, ab)",
          "s2 = sqrt(om)",
          "b = arith[op=mul](eps, s2)",
          "d = arith[op=sub](xt, b)",
          "q = arith[op=div](d, s1)",
          "out <- q"
        ],
        "inputs": ["xt", "eps", "ab"]
      }
    }
  ],
  "inputs": [
    { "name": "xt", "type": "image:image" },
    { "name": "eps", "type": "image:image" },
    { "name": "ab", "type": "image:image" }
  ],
  "outputType": "image:image"
}
